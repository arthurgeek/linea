import std.json

fn main() -> UInt8 {
    var document = json.Value.array()
    json.Value.append(&document, json.Value.boolean(true)).unwrap()
    let child = document.at(0).unwrap()
    json.Value.append(&document, json.Value.null()).unwrap()
    let result = child.as_bool().unwrap()
    document.release()
    if result {
        0
    } else {
        1
    }
}
