// A part that occupies no storage is written by no instruction and read by
// none. The machine has no zero-width store, so an access emitted for one is an
// access at some other width -- and a payload of width zero sits at the offset
// one past the whole value it belongs to, which is where the eight bytes went.
//
// `Opt[()]` is `align 8 { 8 }`: the tag and nothing else. Nothing can annotate
// a binding with the unit type, so the instantiation is reached by inference,
// from an arm that produces nothing.
//
// The values either side are what the write landed on. They are read back after
// the call, so a store past the end of the payload's slot is an answer and not
// a hope about frame layout.
enum Opt[T] {
    None,
    Some(T),
}

fn ident(x: UInt64) -> UInt64 {
    x
}

fn holds(n: UInt64) -> UInt64 {
    let first: UInt64 = ident(n)
    let maybe = if n > 0 {
        Opt.Some(())
    } else {
        Opt.None
    }
    let second: UInt64 = ident(n)
    let carried: UInt64 = match maybe {
        None => 0,
        Some(_) => 0,
    }
    first + second + carried
}

fn main() -> UInt8 {
    let a: UInt64 = ident(7)
    let b: UInt64 = ident(9)
    let c: UInt64 = ident(11)
    let total: UInt64 = holds(25)

    if total != 50 {
        1
    } else {
        if a != 7 {
            2
        } else {
            if b != 9 {
                3
            } else {
                if c != 11 {
                    4
                } else {
                    0
                }
            }
        }
    }
}
