import std.io
import std.session
import std.task

// A simulation runs one task: a second one would be a thread the kernel
// schedules, which no seed could reproduce.
fn main() -> UInt8 {
    var sim = io.Simulation.open(seed: 1).unwrap()
    sim.run(
        |inout _world| {
            let handle = task.start(sink [] |sink me: session.Chan[session.End]| me.close()).unwrap()
            handle.close()
        },
    )
    sim.close()
    0
}
