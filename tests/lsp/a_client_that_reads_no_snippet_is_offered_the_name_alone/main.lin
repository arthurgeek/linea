// A client that did not advertise snippet support reads `${1:a}` as literal
// text, so it is offered the bare name and nothing else. The capability is read
// where every other one is read, at initialize, and what a client without it
// gets is the behaviour that stood before a stop was ever written.
fn add(a: UInt8, b: UInt8) -> UInt8 {
    a + b
}

fn main() -> UInt8 {
    let total: UInt8 = add(1, 2)
    total
}
