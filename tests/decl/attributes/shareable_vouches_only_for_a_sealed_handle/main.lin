// `@shareable` lifts what makes a handle unshareable: a sealed newtype that
// is not copyable names an object C holds. A struct is shareable where its
// fields are, an unsealed or copyable newtype names no C object, and
// `unshareable` says the opposite.
@shareable
struct _Pair {
    first: UInt64,
    second: UInt64,
}

@(linear, shareable)
type _Unsealed = UInt64

@(opaque, copyable, shareable)
type _Copied = UInt64

@(opaque, linear, shareable, unshareable)
type _Both = UInt64

@(opaque, linear, shareable, shareable)
type _Twice = UInt64

fn main() -> UInt8 {
    0
}
