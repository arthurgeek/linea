fn widen(sink item: UInt8) -> UInt64 {
    UInt64(item) * 1000
}

fn select_odd(sink item: UInt8) -> Option[UInt64] {
    if item % 2 == 0 {
        .None
    } else {
        .Some(UInt64(item) * 1000)
    }
}

fn main() -> UInt8 {
    let transform: fn(sink item: UInt8) -> UInt64 = widen
    let select: fn(sink item: UInt8) -> Option[UInt64] = select_odd
    let forwarded = transform
    let mapped = (UInt8(1)..3).map(forwarded)
    let selected = (UInt8(0)..4).filter_map(select)
    let closure = |sink item: UInt8| UInt64(item) * 1000
    let mapped_closure = (UInt8(1)..3).map(closure)
    let all_total = mapped.fold(UInt64(0), |sink accumulator, sink item| accumulator + item)
    let odd_total = selected.fold(UInt64(0), |sink accumulator, sink item| accumulator + item)
    let closure_total = mapped_closure.fold(UInt64(0), |sink accumulator, sink item| accumulator + item)
    if all_total == 3000 && odd_total == 4000 && closure_total == 3000 {
        0
    } else {
        1
    }
}
