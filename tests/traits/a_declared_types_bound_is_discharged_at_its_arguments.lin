// A declared type bounded `Lookup[UInt64]` is settled to a type that
// implements `Lookup` at `UInt64`.
trait Lookup[I] {
    fn at(self: Self, i: I) -> UInt8
}

trait Holds {
    type Elem: Lookup[UInt64]

    fn one(self: Self) -> UInt8
}

struct Board {
    cells: [UInt8; 4],
}

impl Lookup[UInt64] for Board {
    fn at(self: Board, i: UInt64) -> UInt8 {
        self.cells[i]
    }
}

struct Bag {
    n: UInt8,
}

impl Holds for Bag {
    type Elem = Board

    fn one(self: Bag) -> UInt8 {
        self.n
    }
}

fn main() -> UInt8 {
    let g: Bag = .{ n = 5 }
    Holds.one(g)
}
