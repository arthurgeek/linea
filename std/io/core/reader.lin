import std.mem
import std.testing

// A Reader reads into caller-owned storage. A nonempty successful read of zero
// bytes is EOF; an empty request performs no I/O. Errors report no transferred
// bytes.
pub trait Reader {
    type Error

    fn read_some[A: Allocator](inout self: Self, inout buffer: mem.Buffer[A], offset: UInt64, count: UInt64) -> Result[UInt64, Self.Error] where carries(.Err: self)
}

// An InputFailure pairs a reader's error with the stream offset where it
// happened. A buffered stream reports an absolute position; a whole-input
// operation on a generic Reader reports bytes consumed since that operation
// began.
@copyable
pub struct InputFailure[E] {
    reason: E,
    stream_offset: UInt64,
}

derive[E: Debug] Debug for InputFailure[E]

derive[E: Release] Release for InputFailure[E]

impl[E: Display] Display for InputFailure[E] {
    fn fmt[W: Writer](self: Self, inout w: W) -> Result[(), W.Error] {
        &w.write_str("input failed at stream byte ")?
        self.stream_offset.fmt(&w)?
        &w.write_str(": ")?
        self.reason.fmt(&w)
    }
}

test fn an_input_failure_displays_its_position_and_reason() {
    let failure: InputFailure[Str] = .{ reason = "device unplugged", stream_offset = 12 }
    // The 64-byte recorder holds the position and the reason.
    var writer = testing.Recorder.of(64).unwrap()
    let wrote = failure.fmt(&writer).is_ok()
    let equal = writer.holds("input failed at stream byte 12: device unplugged")
    writer.release()
    testing.assert(wrote && equal, "an input failure lost its position or reason")?
    .Ok(())
}
