// [L-Size]. Two types cross the limit on their own, one built of pairs and
// one of trios, and neither holds the other, so each is reported.
struct Pair[A, B] {
    left: A,
    right: B,
}

struct Trio[A, B, C] {
    first: A,
    second: B,
    third: C,
}

