// `cs[i].arr[j].left` reads the `left` field of some element of the inner
// array of some outer element and no `right` field.
struct Box { value: UInt64 }

struct Pair { left: borrow UInt64, right: borrow UInt64 }

fn bump(inout b: Box) {
    b.value = b.value + 1
}

struct Outer { tag: UInt64, arr: [Pair; 2] }

fn main() -> UInt8 {
    var x = Box { value = 1 }
    let y = Box { value = 2 }
    let cs = [Outer { tag = 7, arr = [Pair { left = borrow y.value, right = borrow y.value }, Pair { left = borrow y.value, right = borrow x.value }] }, Outer { tag = 7, arr = [Pair { left = borrow y.value, right = borrow y.value }, Pair { left = borrow y.value, right = borrow y.value }] }]
    bump(&x)
    var i: UInt64 = 1
    i = i - 1
    var j: UInt64 = 1
    j = j - 1
    UInt8(*cs[i].arr[j].left)
}
