// `count` drops each item once it has counted it, so it cannot count items
// that must be settled.
@linear
enum Token {
    One,
}

struct Tokens {
    done: Bool,
}

impl Iterator for Tokens {
    type Item = Token

    fn next(inout self: Tokens) -> Option[Token] {
        if self.done {
            .None
        } else {
            self.done = true
            .Some(.One)
        }
    }
}

fn main() -> UInt8 {
    let tokens: Tokens = .{ done = false }
    UInt8(tokens.count())
}
