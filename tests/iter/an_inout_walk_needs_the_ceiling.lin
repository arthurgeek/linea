// A walk lending its places writably writes through each one, so it asks of
// the implementation exactly what an assignment through a bracket asks: a
// container that declares `read self` grants neither.
struct Fixed {
    cells: [UInt8; 2],
}

impl Index[Int64] for Fixed {
    type Elem = UInt8

    proj at(self: Fixed, i: Int64) -> UInt8 {
        self.cells[i]
    }
}

impl Fixed {
    trav positions = 0..2
}

fn main() -> UInt8 {
    var f: Fixed = .{ cells = [5, 6] }
    for inout c in f {
        c = c + 10
    }
    f.cells[0]
}
