import std.gpu
import std.tensor

fn main() -> UInt8 {
    defer let device = gpu.Device.open().unwrap()
    var arena = gpu.Arena.open(device, 65536).unwrap()
    let handle = arena.handle()
    &arena.reset().unwrap()
    let _value = tensor.matrix_in(handle, [[Float32(1.0)]]).unwrap()
    arena.release()
    0
}
