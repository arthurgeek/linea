fn first[I: Iterator](inout items: I) -> Option[I.Item] where I.Item: Owned, I.Item: Owned {
    &items.next()
}

fn second[I: Iterator](inout items: I) -> Option[I.Item] where I.Item: Owned + Owned {
    &items.next()
}

fn main() -> UInt8 {
    var source = UInt8(4)..7
    let a = first(&source).unwrap()
    a + second(&source).unwrap()
}
