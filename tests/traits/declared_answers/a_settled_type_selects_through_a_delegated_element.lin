// `Mirror.Item` is `Picker[Board.Elem].Out`: `Board.Elem` is `UInt16`, which
// is `Equatable`, so `Picker[UInt16]` implements `Pick`.
trait Counter {
    type Item
}

trait Pick {
    type Out
}

struct Picker[T] {
    t: T,
}

impl[T: Equatable] Pick for Picker[T] {
    type Out = UInt8
}

struct Mirror {}

impl Counter for Mirror {
    type Item = Picker[Board.Elem].Out
}

struct Board {
    values: [UInt16; 2],
}

impl Index[UInt64] for Board via values

fn main() -> UInt8 {
    let item: Mirror.Item = 4
    item
}
