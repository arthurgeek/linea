// The state is lent `inout`, so a function that takes its first parameter by
// `sink` is not one `route` accepts.
import std.http

@derive(Release)
struct Counter {
    count: UInt64,
}

fn consume(sink counter: Counter, request: http.Request, inout _incoming: http.RequestBody) -> Result[http.Response, http.Error] where carries(request), borrows(_incoming), retains(_incoming: _incoming) {
    http.text(request, "{counter.count}")
}

fn main() -> UInt8 {
    var router: http.Router[Counter] = http.Router.new()
    let routed = &router.route("GET /", consume)
    router.release()
    if routed.is_ok() {
        0
    } else {
        1
    }
}
