fn main() -> UInt8 {
    // The decimal lies just above the binary32 halfway point 1 + 2^-24, so
    // rounding it once to binary32 gives the next value above 1.0. Rounding it
    // to Float64 first lands exactly on the halfway point, which then rounds to
    // the even 1.0.
    let annotated: Float32 = 1.0000000596046447753906250000000001
    let converted = Float32(1.0000000596046447753906250000000001)
    let wide: Float64 = 1.0000000596046447753906250000000001
    let twice = Float32(wide)
    if annotated > 1.0 && converted == annotated && twice == 1.0 {
        0
    } else {
        1
    }
}
