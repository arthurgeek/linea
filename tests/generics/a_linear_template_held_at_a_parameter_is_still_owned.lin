// A claim is linear, so a desk holding one is linear too, whatever the
// ledger it is kept for. `pass` never reads a desk's parts: it knows a
// `Desk[L]` must be handed on only from what `Desk` and `Claim` declare.
trait Ledger {
    type Entry
}

struct Shop {
    till: UInt8,
}

impl Ledger for Shop {
    type Entry = UInt8
}

@linear
struct Claim[L: Ledger] {
    entry: L.Entry,
}

struct Desk[L: Ledger] {
    claim: Claim[L],
}

fn drop_desk[L: Ledger](sink _desk: Desk[L]) -> UInt8 {
    0
}

fn main() -> UInt8 {
    drop_desk(Desk[Shop] { claim = Claim[Shop] { entry = 7 } })
}
