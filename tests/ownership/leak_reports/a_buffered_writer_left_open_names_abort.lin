// `abort` takes a buffered writer and hands back the descriptor it wrapped.
// A descriptor owes nothing, so `abort` settles the writer, and the report
// names `_kept.abort()`.
import std.io

fn main() -> UInt8 {
    match io.BufferedWriter.open(capacity: 64, writer: io.stdout()) {
        Ok(output) => {
            let _kept = output
            0
        },
        Err(_) => 1,
    }
}
