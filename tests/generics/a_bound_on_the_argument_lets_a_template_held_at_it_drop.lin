// A crate holds whatever it is packed with, so it can be dropped only where
// its contents can. `ship` bounds its parameter `Discardable` and `stow`
// says the same in a `where` clause; either lets the crate be dropped.
struct Crate[T] {
    contents: T,
}

fn ship[T: Discardable](sink _crate: Crate[T]) -> UInt8 {
    1
}

fn stow[T](sink _crate: Crate[T]) -> UInt8
where T: Discardable {
    2
}

fn main() -> UInt8 {
    ship(Crate[UInt8] { contents = 3 }) + stow(Crate[UInt8] { contents = 4 })
}
