// Both ways out of one function. The early exit leaves through `return` and
// the ordinary one is the body's tail, and a function has one signature for
// the two -- so a return type taken from the body block is right for the tail
// and wrong for what left before it.
//
// Both exits are taken and both answers are read, so a convention right for one
// and wrong for the other shows as one of the two being somebody else's frame.
struct Big {
    a: Int64,
    b: Int64,
    c: Int64,
}

fn pick(early: Bool) -> Big {
    if early {
        return .{ a = 1, b = 2, c = 3 }
    }
    .{ a = 4, b = 5, c = 6 }
}

fn noise() -> UInt8 {
    let p: Big = .{ a = 99, b = 98, c = 97 }
    UInt8(p.a)
}

fn take(b: Big, sink n: UInt8) -> UInt8 {
    let _ = n
    UInt8(b.a)
}

fn main() -> UInt8 {
    let first: UInt8 = take(pick(true), noise())
    let second: UInt8 = take(pick(false), noise())
    first + second
}
