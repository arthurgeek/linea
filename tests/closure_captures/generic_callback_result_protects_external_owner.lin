fn invoke[F: fn() -> borrow UInt8](callback: F) -> borrow UInt8 where carries(callback) {
    callback()
}

fn main() -> UInt8 {
    var number: UInt8 = 7
    let callback = [number] || -> where borrows(number) {
        borrow number
    }
    let observation = invoke(callback)
    number = 8
    *observation + number
}
