// The clause the report on `label` names, applied.
@derive(Release)
struct Station {
    name: String,
}

impl Station {
    fn label(inout self: Self, other: Str, first: Bool) -> Str where borrows(self), carries(other) {
        if first {
            self.name.view()
        } else {
            copy(other)
        }
    }
}

fn main() -> UInt8 {
    var s = Station { name = String.new() }
    defer s.release()
    UInt8(&s.label("x", true).length())
}
