// A desk holds a drawer holding a claim on an entry, so it is dropped only
// where its ledger's entries can be discarded. `tally` says so of the
// entries. `close` says it of the ledger's notes, which no claim holds, so
// the desk `close` is given must still be handed on.
trait Ledger {
    type Entry
    type Note
}

struct Claim[L: Ledger] {
    entry: L.Entry,
}

struct Drawer[L: Ledger] {
    claim: Claim[L],
}

struct Desk[L: Ledger] {
    drawer: Drawer[L],
}

fn _tally[L: Ledger](sink _desk: Desk[L]) -> UInt8
where L.Entry: Discardable {
    1
}

fn _close[K: Ledger](sink _desk: Desk[K]) -> UInt8
where K.Note: Discardable {
    2
}

fn _count[J: Ledger](sink _desk: Desk[J]) -> UInt8
where J.Entry: Discardable {
    3
}

fn main() -> UInt8 {
    0
}
