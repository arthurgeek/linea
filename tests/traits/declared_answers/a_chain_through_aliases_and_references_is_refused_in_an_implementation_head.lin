alias X = S0.Reading
alias Y = X

enum Stored {
    Byte(UInt8),
    Nothing,
}

impl From[Y] for Stored {
    fn from(sink source: UInt8) -> Self {
        .Byte(source)
    }
}

fn main() -> UInt8 {
    let stored: Stored = .Byte(3)
    match stored {
        Byte(value) => value,
        Nothing => 0,
    }
}
