// A trait requiring another at its own parameter is admitted once for each
// argument it is bounded at, so both requirements are carried at once.
trait Lookup[I] {
    fn at(self: Self, i: I) -> UInt8
}

trait Fancy[X]: Lookup[X] {
    fn tag(self: Self) -> UInt8
}

struct Board {
    cells: [UInt8; 4],
}

impl Lookup[UInt64] for Board {
    fn at(self: Board, i: UInt64) -> UInt8 {
        self.cells[i]
    }
}

impl Lookup[Bool] for Board {
    fn at(_self: Board, _i: Bool) -> UInt8 {
        10
    }
}

impl Fancy[UInt64] for Board {
    fn tag(_self: Board) -> UInt8 {
        1
    }
}

impl Fancy[Bool] for Board {
    fn tag(_self: Board) -> UInt8 {
        2
    }
}

fn counted[C: Lookup[UInt64]](c: C) -> UInt8 {
    let i: UInt64 = 2
    Lookup.at(c, i)
}

fn flagged[C: Lookup[Bool]](c: C) -> UInt8 {
    Lookup.at(c, true)
}

fn reach[T: Fancy[UInt64] + Fancy[Bool]](t: T) -> UInt8 {
    counted(t) + flagged(t)
}

fn main() -> UInt8 {
    let b: Board = .{ cells = [1, 2, 3, 4] }
    reach(b)
}
