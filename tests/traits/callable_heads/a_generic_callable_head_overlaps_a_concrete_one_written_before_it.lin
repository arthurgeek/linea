// Two callable heads overlap whichever is written first. The implementation
// for `fn(input: UInt8) -> UInt8` comes first here, and
// `impl[T] Run for fn(input: T) -> T` after it answers for that type too.
trait Run {
    fn run(self: Self) -> UInt8
}

impl Run for fn(input: UInt8) -> UInt8 {
    fn run(self: Self) -> UInt8 {
        self(4)
    }
}

impl[T] Run for fn(input: T) -> T {
    fn run(_self: Self) -> UInt8 {
        7
    }
}

fn main() -> UInt8 {
    0
}
