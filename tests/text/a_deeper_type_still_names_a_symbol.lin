// A type is spelled by its structure, and structure nests without limit, so a
// name spelled out grows past what an assembler will take as an identifier. A
// symbol is bounded instead: it spells as much of the structure as fits and
// says the rest with a digest of the whole of it.
//
// Four carriers is past where the spelled name stopped fitting.
import std.io

use io.IoError
use io.println

fn main() -> Result[UInt8, IoError] {
    let deep: Option[Option[Option[Option[UInt8]]]] = .Some(.Some(.Some(.Some(7))))
    println("{deep}")?
    return .Ok(0)
}
