import std.io
import std.task
import std.time
import std.session

use session.Chan
use session.End

fn main() -> UInt8 {
    let execution = io.Loop.open(carriers: 2).unwrap()
    let seed = if io.current() == io.system() {
        UInt64(91)
    } else {
        UInt64(92)
    }
    var entries = UInt64(0)
    var result = UInt64(0)
    var migrated = false
    let body = sink [seed, inout entries, inout result, inout migrated] |sink me: Chan[End]| {
        entries += 1
        let first = task.current_carrier().unwrap()
        var value = seed
        time.sleep(time.Duration.from_nanoseconds(0))
        let second = task.current_carrier().unwrap()
        if first == second {
            panic("first suspension did not move the continuation")
        }
        value = value * 3 + 7
        time.sleep(time.Duration.from_nanoseconds(0))
        if first != task.current_carrier().unwrap() {
            panic("second suspension did not return to the first carrier")
        }
        migrated = true
        result = value + 11
        me.close()
    }
    task.start(body, on: execution).unwrap().close()
    if migrated && entries == 1 && result == seed * 3 + 18 {
        0
    } else {
        1
    }
}
