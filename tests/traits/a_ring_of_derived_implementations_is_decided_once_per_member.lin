// Each `Stop` derives `Settle` only where the next two stops around the ring
// do, so asking about `Stop0[UInt8]` reaches every stop along more paths than
// a program could walk. Each stop is decided once, and the ring settles.
trait Settle {}

impl Settle for UInt8 {}

template impl Settle where reflect.components: Settle {}

struct Stop0[X] {
    x: X,
}

derive[X: Settle] Settle for Stop0[X] where Stop1[X]: Settle, Stop2[X]: Settle

