extern fn linea_float64_parse(address: UInt64, length: UInt64, inout bits: UInt64, inout offset: UInt64) -> UInt64

// Parse a Float64 from `bytes` through the runtime, which writes the value's
// bits and the offset parsing stopped at. Only the call receives the certified
// byte address; no address escapes to text.
internal fn parse_float64_bits(bytes: Slice[UInt8], inout bits: UInt64, inout offset: UInt64) -> UInt64 where carries() {
    linea_float64_parse(bytes.at, bytes.len, &bits, &offset)
}

extern fn linea_float32_parse(address: UInt64, length: UInt64, inout bits: UInt64, inout offset: UInt64) -> UInt64

// Parse a Float32 the same way, rounding once to the nearest Float32. The
// runtime writes the bits of the Float64 holding that value, which it holds
// exactly.
internal fn parse_float32_bits(bytes: Slice[UInt8], inout bits: UInt64, inout offset: UInt64) -> UInt64 where carries() {
    linea_float32_parse(bytes.at, bytes.len, &bits, &offset)
}

// A float's IEEE 754 bits as the unsigned integer of its width, and back. The
// compiler replaces each call with a reinterpretation that keeps every bit,
// so these are declared here, where the library's trusted primitives live,
// and reached through the `to_bits` and `from_bits` methods.
extern fn linea_float64_to_bits(value: Float64) -> UInt64

extern fn linea_float64_from_bits(bits: UInt64) -> Float64

extern fn linea_float32_to_bits(value: Float32) -> UInt32

extern fn linea_float32_from_bits(bits: UInt32) -> Float32

internal fn float64_to_bits(value: Float64) -> UInt64 {
    linea_float64_to_bits(value)
}

internal fn float64_from_bits(bits: UInt64) -> Float64 {
    linea_float64_from_bits(bits)
}

internal fn float32_to_bits(value: Float32) -> UInt32 {
    linea_float32_to_bits(value)
}

internal fn float32_from_bits(bits: UInt32) -> Float32 {
    linea_float32_from_bits(bits)
}
