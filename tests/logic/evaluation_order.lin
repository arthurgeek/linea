// Short-circuit is as much about sequence as about skipping. Each operand
// appends its own digit to `n`, so an answer of 124 means all three ran in the
// order written: another order writes the digits in another order, and a
// skipped operand leaves its digit out.
fn append(inout n: UInt8, digit: UInt8) -> Bool {
    n = n * 10 + digit
    true
}

fn main() -> UInt8 {
    var n: UInt8 = 0
    let _unused = append(&n, 1) && append(&n, 2) && append(&n, 4)
    n
}
