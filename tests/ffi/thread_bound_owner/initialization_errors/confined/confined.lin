import std.task

use task.Unowned

import std.io

@(opaque, linear)
type Handle = UInt64

extern fn mock_open(mode: UInt8) -> UInt64

extern fn mock_read(read handle: Handle) -> UInt64

extern fn mock_close(inout handle: Handle) -> UInt8

extern fn mock_balanced() -> UInt8

@(opaque, linear)
struct Resource { handle: Handle }

// Move the previous linear option out while installing its replacement.
// carries preserves the old value's dependencies; retains keeps next in slot.
// Even an old None is matched and settled because Option[Resource] is linear.
fn exchange(inout slot: Option[Resource], sink next: Option[Resource]) -> Option[Resource] where carries(slot), retains(slot: next) {
    let previous = slot
    slot = next
    previous
}

fn settle(inout slot: Option[Resource]) -> Bool {
    match exchange(&slot, .None) {
        None => true,
        Some(resource) => {
            var held = resource
            if mock_close(&held.handle) != 0 {
                match exchange(&slot, .Some(held)) {
                    None => false,
                    Some(_) => panic("cleanup overwrote live state"),
                }
            } else {
                let Resource { handle } = held
                let Handle(raw) = handle
                if raw != 0 {
                    panic("native close retained a handle after success")
                }
                true
            }
        },
    }
}

@(opaque, linear)
struct Active { owner: task.Owner[Option[Resource]] }

@(opaque, linear)
struct Closing { owner: task.Owner[Option[Resource]] }

@(opaque, copyable)
struct Client { raw: task.Client[Option[Resource]] }

pub enum OpenError { Preparation, Creation, Initialization }

@linear
pub enum OpenFailure { Empty(OpenError), Closing(OpenError, UInt8, Closing) }

pub fn try_open(mode: UInt8) -> Result[Active, OpenFailure] {
    let empty: Option[Resource] = .None
    let owner = match task.own(empty, on: io.system()) {
        Ok(owner) => owner,
        Err(failure) => {
            let Unowned { state, reason: _ } = failure
            match state { None => (), Some(_) => panic("preparation returned live state") }
            return .Err(.Empty(.Preparation))
        },
    }
    let status = owner.client().call(
        [sink mode] |inout state: Option[Resource]| {
            let raw = mock_open(mode)
            if raw == 0 {
                return UInt8(1)
            }
            match exchange(&state, .Some(Resource { handle = Handle(raw) })) {
                None => (),
                Some(_) => panic("initialization ran twice"),
            }
            if mode == 2 || mode == 3 {
                UInt8(2)
            } else {
                UInt8(0)
            }
        },
    )
    if status == 0 {
        return .Ok(.{ owner })
    }
    let original = if status == 1 {
        OpenError.Creation
    } else {
        OpenError.Initialization
    }
    let closing = Closing { owner }
    match closing.retry() {
        Ok(_) => .Err(.Empty(original)),
        Err(closing) => .Err(.Closing(original, 1, closing)),
    }
}

pub fn open() -> Active {
    try_open(0).unwrap()
}

impl Active {
    pub fn client(self: Self) -> Client where borrows(self) {
        .{ raw = self.owner.client() }
    }

    pub fn shutdown(sink self: Self) -> Result[(), Closing] {
        let Active { owner } = self
        Closing { owner }.retry()
    }
}

impl Client {
    pub fn value(self: Self) -> UInt64 {
        self.raw.call(
            |inout state: Option[Resource]| {
                match read state {
                    Some(resource) => mock_read(resource.handle),
                    None => panic("operation after settlement"),
                }
            },
        )
    }
}

impl Closing {
    pub fn retry(sink self: Self) -> Result[(), Closing] {
        let Closing { owner } = self
        let done = owner.client().call(|inout state: Option[Resource]| settle(&state))
        if !done {
            return .Err(.{ owner })
        }
        match owner.close() {
            None => (),
            Some(_) => panic("closed a nonempty owner"),
        }
        .Ok(())
    }
}

pub fn balanced() -> Bool {
    mock_balanced() != 0
}

extern fn mock_block_first()

extern fn mock_blocked() -> UInt8

extern fn mock_unblock()

pub fn block_first() {
    mock_block_first()
}

pub fn blocked() -> Bool {
    mock_blocked() != 0
}

pub fn unblock() {
    mock_unblock()
}

extern fn mock_operate(read handle: Handle, fail: UInt8) -> Int64

impl Client {
    pub fn try_value(self: Self, fail: Bool) -> Result[UInt64, UInt8] {
        self.raw.call(
            [sink fail] |inout state: Option[Resource]| {
                match read state {
                    None => panic("operation on closed state"),
                    Some(resource) => {
                        let answer = mock_operate(
                            resource.handle,
                            if fail {
                                1
                            } else {
                                0
                            },
                        )
                        if answer < 0 {
                            .Err(UInt8(-answer))
                        } else {
                            .Ok(UInt64(answer))
                        }
                    },
                }
            },
        )
    }
}
