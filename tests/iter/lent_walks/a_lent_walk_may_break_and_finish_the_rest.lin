import std.io
import std.mem

// Lending the drain to the walk keeps it with its owner, so the walk may stop
// early and the owner decides about the payments it did not reach.
@linear
struct Payment {
    cents: UInt64,
}

fn commit(sink payment: Payment) -> UInt64 {
    let Payment { cents } = payment
    cents
}

fn main() -> Result[UInt8, io.IoError] {
    let built: Result[Vec[Payment, mem.SystemAllocator], mem.Oom] = Vec.from_fn(count: 4, initializer: |index| Payment { cents = (index + 1) * 100 })
    var pending = built.unwrap().drain()
    var committed: UInt64 = 0
    for payment in &pending {
        committed += commit(payment)
        if committed >= 300 {
            break
        }
    }
    // `finish` hands back a drain that still holds payments.
    var declined: UInt64 = 0
    match pending.finish() {
        Ok(_) => {},
        Err(returned) => {
            var rest = returned
            for payment in &rest {
                declined += commit(payment)
            }
            rest.finish().unwrap()
        },
    }
    io.println("committed {committed}, declined {declined}")?
    .Ok(0)
}
