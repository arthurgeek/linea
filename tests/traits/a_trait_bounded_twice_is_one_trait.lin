// A trait named twice in a trait's own bound is one trait, on the reading a
// type parameter's duplicate bound gets.
trait Same {
    fn alike(self: Self, other: Self) -> Bool
}

trait Ranked: Same + Same {
    fn under(self: Self, other: Self) -> Bool
}

struct Mark {
    n: UInt8,
}

impl Same for Mark {
    fn alike(self: Mark, other: Mark) -> Bool {
        self.n == other.n
    }
}

impl Ranked for Mark {
    fn under(self: Mark, other: Mark) -> Bool {
        self.n < other.n
    }
}

fn main() -> UInt8 {
    let a: Mark = .{ n = 1 }
    let b: Mark = .{ n = 2 }
    let ordered = Ranked.under(a, b)
    let alike = Same.alike(a, a)
    if ordered && alike {
        7
    } else {
        0
    }
}
