// Declaration order does not change the Discardable requirement on a
// nested wrapper containing a concrete linear field.
@linear
enum Key {
    Forged(UInt8),
}

struct Box[T] {
    v: T,
    k: Key,
}

struct Held[X: Discardable] {
    h: X,
}

@linear
struct Wrap {
    w: Held[Box[UInt8]],
}

fn take(sink w: Wrap) -> UInt8 {
    let Wrap { w: h } = w
    let Held { h: b } = h
    let Box { v: n, k: k } = b
    match k { Forged(m) => m + n }
}

fn main() -> UInt8 {
    take(.{ w = .{ h = .{ v = 2, k = Key.Forged(1) } } })
}
