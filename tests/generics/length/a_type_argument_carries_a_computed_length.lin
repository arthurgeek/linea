// A type argument may itself carry a length, and that length may be any
// constant expression. The brackets before the call hold types, so the
// expression inside them is read as a length and nothing else.
struct Ring[let n: UInt64] {
    items: [UInt8; n],
}

fn keep[T](sink value: T) -> T {
    value
}

fn main() -> UInt8 {
    let ring = keep[Ring[2 + 2]](.{ items = [1, 2, 3, 4] })
    let row = keep[[UInt8; 1 + 2]]([5, 6, 7])
    ring.items[3] + row[2]
}
