import std.testing

// A ReleaseLog records the code of each ReleaseTag released while it is open,
// in release order, so a test can see a release that was skipped, repeated or
// reordered. It is one system buffer of UInt64 words: the number of releases,
// then one code per release. A tag writes the log's words through a `read` of
// the log, so a log is `@unshareable`: two tasks each releasing a tag of one
// log would race on its count.
@(linear, unshareable)
internal struct ReleaseLog {
    buffer: Buffer[SystemAllocator],
}

// A ReleaseTag records its code in the log it came from when it is released.
// It observes the log, so the log outlives every tag it made, a tag is not
// `Owned`, and a tag reaches another task only where the log could be read
// there too, which [O-Cross] refuses.
@linear
internal struct ReleaseTag {
    log: borrow ReleaseLog,
    code: UInt64,
}

// The release count and each code occupy one eight-byte word.
let release_word_bytes: UInt64 = 8

impl ReleaseLog {
    // Open a log with room for `capacity` releases. Allocation zeroes the
    // buffer, so the log starts with no releases.
    internal fn open(capacity: UInt64) -> ReleaseLog {
        ReleaseLog { buffer = system().acquire((capacity + 1) * release_word_bytes).unwrap() }
    }

    test fn a_new_release_log_holds_no_releases() {
        let log = ReleaseLog.open(2)
        let nothing: [UInt64; 0] = []
        let empty = log.holds([UInt64(0)].as_slice())
        let none = log.holds(nothing.as_slice())
        log.release()
        testing.assert(!empty, "a new log recorded a release")?
        testing.assert(none, "a new log did not hold the empty sequence")?
    }

    // Make a tag that records `code` in this log when it is released.
    internal fn tag(self: Self, code: UInt64) -> ReleaseTag where borrows(self) {
        .{ log = borrow self, code }
    }

    test fn a_tag_records_its_code_when_it_is_released() {
        let log = ReleaseLog.open(1)
        let tag = log.tag(42)
        let nothing: [UInt64; 0] = []
        let before = log.holds(nothing.as_slice())
        tag.release()
        let after = log.holds([UInt64(42)].as_slice())
        log.release()
        testing.assert(before, "making a tag recorded a release")?
        testing.assert(after, "releasing a tag did not record its code")?
    }

    // The address and length of the log's words, for a test that hands them
    // to code which reaches the log through nothing else, as an HTTP
    // extractor sees only its request. `record_release` writes through them.
    internal fn words(self: Self) -> (UInt64, UInt64) {
        (self.buffer.at, self.buffer.len)
    }

    // Return whether the log recorded exactly `codes`, in order.
    internal fn holds(self: Self, codes: Slice[UInt64]) -> Bool {
        let count = self.buffer.load(0)
        if count != codes.length() {
            return false
        }
        for index in UInt64(0)..count {
            if self.buffer.load((index + 1) * release_word_bytes) != codes[index] {
                return false
            }
        }
        true
    }

    test fn a_release_log_holds_its_codes_in_release_order() {
        let log = ReleaseLog.open(2)
        let first = log.tag(7)
        let second = log.tag(9)
        second.release()
        first.release()
        let ordered = log.holds([UInt64(9), 7].as_slice())
        let reversed = log.holds([UInt64(7), 9].as_slice())
        let shorter = log.holds([UInt64(9)].as_slice())
        log.release()
        testing.assert(ordered, "the log lost or reordered a release")?
        testing.assert(!reversed, "the log ignored the release order")?
        testing.assert(!shorter, "the log held fewer codes than it recorded")?
    }
}

impl Release for ReleaseLog {
    fn release(sink self: Self) {
        let ReleaseLog { buffer } = self
        buffer.release()
    }
}

// Releasing a tag appends its code after the codes already recorded and counts
// it.
impl Release for ReleaseTag {
    fn release(sink self: Self) {
        let ReleaseTag { log, code } = self
        let (at, extent) = log.words()
        record_release(at, extent, code)
    }
}

// Append `code` to the log whose words are the `extent` bytes at `at`, and
// count it. A log that is full traps on the out-of-bounds store. The address
// observes nothing, so a value holding one in place of a tag writes the log
// without the log being observed, and only a test that starts no task may
// keep one.
internal fn record_release(at: UInt64, extent: UInt64, code: UInt64) {
    let count = linea_raw_load(at, extent, 0)
    linea_raw_store(at, extent, (count + 1) * release_word_bytes, code)
    linea_raw_store(at, extent, 0, count + 1)
}
