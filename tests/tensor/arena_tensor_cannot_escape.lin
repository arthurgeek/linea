import std.mem
import std.tensor

use mem.Lender

fn escape() -> tensor.Tensor[Float32, 2, tensor.Cpu[mem.Handle[mem.SystemAllocator]]] {
    defer let arena = mem.Arena.open(mem.system(), 128)
    tensor.matrix_in(arena.handle(), [[Float32(1.0)]]).unwrap()
}

fn main() -> UInt8 {
    let _escaped = escape()
    0
}
