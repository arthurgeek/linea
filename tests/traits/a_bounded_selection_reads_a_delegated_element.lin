// `Board.Elem` is `UInt16`, which is `Equatable`, so `Picker[Board.Elem]`
// implements `Pick` and `Early.x` holds its `Out`.
trait Pick {
    type Out
}

struct Early {
    x: Picker[Board.Elem].Out,
}

struct Picker[T] {
    t: T,
}

impl[T: Equatable] Pick for Picker[T] {
    type Out = UInt8
}

struct Board {
    values: [UInt16; 2],
}

impl Index[UInt64] for Board via values

fn main() -> UInt8 {
    let early = Early { x = 4 }
    early.x
}
