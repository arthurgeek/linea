import std.mem

fn first_after_release(a: mem.Vec[UInt8], sink b: mem.Vec[UInt8]) -> UInt8 {
    b.release()
    var other: mem.Vec[UInt8] = mem.Vec.new()
    &other.push(77).unwrap()
    let seen = a[0]
    other.release()
    seen
}

fn main() -> UInt8 {
    var v: mem.Vec[UInt8] = mem.Vec.new()
    &v.push(1).unwrap()
    first_after_release(v, v)
}
