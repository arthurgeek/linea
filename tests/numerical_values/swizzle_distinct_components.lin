fn pair(inout first: Int32, second: Int32) -> Int32 {
    first += second
    first
}

fn main() -> UInt8 {
    var values = [Int32(1), 2, 3, 4]
    if pair(&values.x, values[1]) != 3 {
        return 1
    }
    if pair(&values.r, values.z) != 6 {
        return 2
    }
    if values[0] != 6 || values[1] != 2 {
        return 3
    }
    0
}
