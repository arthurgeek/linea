// [L-Size]. Each alias holds the one before it twice, so `Twice40[UInt8]` is
// 2^41 bytes wide. The width crosses the limit at one type, the `Pair`
// holding two halves of 2^31 bytes, and that type is the one report: the
// types that hold it are too wide because it is, and a type still written
// with a parameter has no width to ask about until the parameter is settled.
struct Pair[A, B] {
    left: A,
    right: B,
}

alias Twice0[T] = Pair[T, T]
alias Twice1[T] = Pair[Twice0[T], Twice0[T]]
alias Twice2[T] = Pair[Twice1[T], Twice1[T]]
alias Twice3[T] = Pair[Twice2[T], Twice2[T]]
alias Twice4[T] = Pair[Twice3[T], Twice3[T]]
