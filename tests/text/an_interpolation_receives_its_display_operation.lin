// An interpolated literal is a value, so it can be the receiver of the
// operation its type implements: `fmt` writes the text into a writer.
import std.io
import std.text

use io.IoError
use io.println

fn total[T: Display](label: T) -> UInt64 {
    var out = text.String.new()
    let wrote = "<{label}>".fmt(&out).is_ok()
    let length = out.length()
    out.release()
    return if wrote {
        length
    } else {
        0
    }
}

fn main() -> Result[UInt8, IoError] {
    let name = "Ada"
    let count: UInt8 = 7
    var out = text.String.new()
    "hi {name}, ".fmt(&out).unwrap()
    ("[{count:>4}]").fmt(&out).unwrap()
    let fits = match count {
        7 => "{"x={count}"};".fmt(&out).is_ok(),
        _ => false,
    }
    let printed = println("{out} {fits} {total(name)}")
    out.release()
    printed?
    return .Ok(0)
}
