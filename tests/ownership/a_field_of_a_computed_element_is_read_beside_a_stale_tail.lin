// Reading one field of an element chosen at run time reads that field of
// the array's elements and not the borrow stored after the array, whose
// place has changed.
struct Box { value: UInt64 }

struct Pair { left: borrow UInt64, right: borrow UInt64 }

struct Holder { cells: [Pair; 2], tail: borrow UInt64 }

fn bump(inout b: Box) {
    b.value = b.value + 1
}

fn main() -> UInt8 {
    var x = Box { value = 1 }
    let y = Box { value = 2 }
    let h = Holder { cells = [Pair { left = borrow y.value, right = borrow y.value }, Pair { left = borrow y.value, right = borrow y.value }], tail = borrow x.value }
    bump(&x)
    var i: UInt64 = 1
    i = i - 1
    UInt8(*h.cells[i].right)
}
