import std.testing

// Negative values and target minima fit Int64; nonnegative values and target
// maxima fit UInt64. Check in that domain before converting to the target.
impl[Source: Integer, Target: Integer] TryFrom[Source] for Target {
    fn try_from(x: Source) -> Option[Target] {
        if x < Source(0) {
            if Int64(x) < Int64(Target.min) {
                return .None
            }
        } else if UInt64(x) > UInt64(Target.max) {
            return .None
        }
        .Some(Target(x))
    }
}

// Each source/target pair checks shared endpoints and interior values, plus
// source extremes and adjacent target values where they fall outside the range.
test fn int8_to_int16_preserves_exact_values_and_checks_bounds() {
    let lower = Int16.try_from(Int8(-128))
    testing.assert_eq(lower, Option.Some(Int16(-128)), "lower accepted value changed")?
    let interior = Int16.try_from(Int8(-1))
    testing.assert_eq(interior, Option.Some(Int16(-1)), "interior accepted value changed")?
    let upper = Int16.try_from(Int8(127))
    testing.assert_eq(upper, Option.Some(Int16(127)), "upper accepted value changed")?
    .Ok(())
}

test fn int32_to_int16_preserves_exact_values_and_checks_bounds() {
    let lower = Int16.try_from(Int32(-32768))
    testing.assert_eq(lower, Option.Some(Int16(-32768)), "lower accepted value changed")?
    let interior = Int16.try_from(Int32(-1))
    testing.assert_eq(interior, Option.Some(Int16(-1)), "interior accepted value changed")?
    let upper = Int16.try_from(Int32(32767))
    testing.assert_eq(upper, Option.Some(Int16(32767)), "upper accepted value changed")?
    let below = Int16.try_from(Int32(-32769))
    match below {
        Some(_) => testing.assert(false, "below out-of-range value was accepted")?,
        None => {},
    }
    let source_min = Int16.try_from(Int32(-2147483648))
    match source_min {
        Some(_) => testing.assert(false, "source_min out-of-range value was accepted")?,
        None => {},
    }
    let above = Int16.try_from(Int32(32768))
    match above {
        Some(_) => testing.assert(false, "above out-of-range value was accepted")?,
        None => {},
    }
    let source_max = Int16.try_from(Int32(2147483647))
    match source_max {
        Some(_) => testing.assert(false, "source_max out-of-range value was accepted")?,
        None => {},
    }
    .Ok(())
}

