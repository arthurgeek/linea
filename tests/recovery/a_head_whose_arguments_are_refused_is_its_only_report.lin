// An implementation's head and a derive request's head are written types.
// Where the arguments of one stand past the nesting limit, the head's own
// name is still written: a derive request uses the type it names, and the
// refusal is the file's only report.
trait Marks {}

struct Leaf[T] {
    item: T,
}

struct Layer[T] {
    item: T,
}

