struct Choice { small: UInt8, wide: UInt8 }

impl Index[Int8] for Choice {
    type Elem = UInt8

    proj at(inout self: Choice, _i: Int8) -> UInt8 {
        self.small
    }
}

impl Index[UInt16] for Choice {
    type Elem = UInt8

    proj at(inout self: Choice, _i: UInt16) -> UInt8 {
        self.wide
    }
}

fn main() -> UInt8 {
    let choice = Choice { small = 1, wide = 2 }
    choice[0]
}
