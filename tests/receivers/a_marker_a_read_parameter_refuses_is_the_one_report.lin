// A `&` before a `read` parameter is refused, and that is the one mistake:
// the binding it lends is not reported as `let` as well. A `let` lent to an
// `inout` parameter is reported as `let`.
struct Counter {
    count: UInt8,
}

impl Counter {
    fn total(self: Self) -> UInt8 {
        self.count
    }

    fn bump(inout self: Self) -> () {
        self.count += 1
    }
}

fn read_total(counter: Counter) -> UInt8 {
    counter.count
}

fn add(inout counter: Counter) -> () {
    counter.count += 1
}

fn describe(counter: Counter) -> UInt8 {
    let fixed = Counter { count = 1 }
    &fixed.bump()
    add(&fixed)
    &counter.total() + read_total(&counter) + read_total(&fixed)
}

fn main() -> UInt8 {
    describe(Counter { count = 0 })
}
