import std.json
import std.mem

fn main() -> UInt8 {
    var document = json.Value.object(mem.system())
    json.Value.insert(&document, "key", json.Value.boolean(mem.system(), true)).unwrap().release()
    var members = document.members().unwrap()
    json.Value.remove_member(&document, "key").unwrap().release()
    let found = Iterator.next(&members).is_some()
    members.release()
    document.release()
    if found {
        0
    } else {
        1
    }
}
