// The guest book's storage. This module is the only place in the application
// that writes SQL, so the HTTP handlers in `main.lin` work with `Book` and
// `Entry` rather than statements.
import sqlite
import std.fmt
import std.fs
import std.mem
import std.session
import std.task
import std.testing
import std.time
import std.uuid

use mem.Lender
use session.Chan
use session.End
use session.Send
use sqlite.Database
use sqlite.Statement

// `embed` reads `schema.sql` at compile time and keeps its text in the binary,
// so deploying the program copies one executable and no SQL file beside it.
let schema = embed("../schema.sql")

// Why a guest-book operation failed:
// - `Sqlite` when SQLite or its wrapper refused an operation;
// - `NegativeLimit` when `Book.newest` is called with a negative limit;
// - `InvalidTimestamp` when a stored Unix timestamp is outside Linea's
//   representable range (years 0000..9999);
// - `OutOfMemory` when allocating an entry or growing a collection fails.
@derive(Debug, Release, From[sqlite.Error])
pub enum BookError {
    Sqlite(sqlite.Error),
    NegativeLimit(Int64),
    InvalidTimestamp(Int64),
    OutOfMemory,
}

impl Display for BookError {
    fn fmt[W: Writer](self: Self, inout w: W) -> Result[(), W.Error] {
        match read self {
            Sqlite(error) => error.fmt(&w),
            NegativeLimit(limit) => "the limit {limit} is negative".fmt(&w),
            InvalidTimestamp(seconds) => "the timestamp {seconds} cannot be represented".fmt(&w),
            OutOfMemory => "out of memory".fmt(&w),
        }
    }
}

// One signature read back from the `entries` table.
@derive(Debug, Release)
pub struct Entry {
    name: String,
    message: String,
    signed: time.Timestamp,
}

// An open guest book: one connection to its database. Because `Database` is
// linear, `Book` is linear too: every caller that opens the book must close or
// release it before returning. A `Book` is used by one task at a time, and a
// server opens one for each task that serves requests.
@(opaque, linear)
struct Book {
    database: Database,
}

// Read one row's three columns into an `Entry`. `defer let` releases `name` or
// `message` if reading a later column fails, and skips that release when all
// three move into the returned `Entry`. Out-of-range timestamps return
// `BookError.InvalidTimestamp` rather than fabricating a current time.
fn read_entry(select: Statement) -> Result[Entry, BookError] {
    defer let name = select.text(0)?
    defer let message = select.text(1)?
    let seconds = select.integer(2)?
    let signed = time.Timestamp.from_unix(seconds, 0) else {
        return .Err(.InvalidTimestamp(seconds))
    }
    .Ok(Entry { name, message, signed })
}

// A test's own database file, named by a random UUID, so tests that run at
// once never share one.
fn scratch_path() -> String {
    fmt.render_owned("/tmp/linea-guest-book-{uuid.Uuid.v4()}.db").unwrap()
}

// Remove a test's database at `path`, with the write-ahead log and its index
// that SQLite keeps beside it while a connection is open.
fn remove_database(path: Str) {
    for read suffix in ["", "-wal", "-shm"] {
        defer let name = fmt.render_owned("{path}{suffix}").unwrap()
        let file = fs.Path.from_str(name.view()).unwrap()
        let _ = fs.remove_file(file) else |_| {
            ()
        }
    }
}

// The serving tasks a server starts by default, each with a connection.
let tasks_at_once: UInt64 = 128

// One of `tasks_at_once` tasks: open a connection to the book at `path`, read
// the entries, and answer whether both succeeded.
fn open_alongside_the_others(sink path: String) -> Bool {
    defer let owned = path
    var book = Book.connect(owned.view()) else |error| {
        error.release()
        return false
    }
    let listed = match &book.newest(1) {
        Ok(entries) => {
            entries.release()
            true
        },
        Err(error) => {
            error.release()
            false
        },
    }
    book.close()
    listed
}

// How many signatures each of `tasks_at_once` tasks writes when they all
// sign at once.
let signatures_per_task: UInt64 = 16

// One of `tasks_at_once` tasks: open a connection to the book at `path`, sign
// it `signatures_per_task` times, and answer whether every signature was
// written.
fn sign_alongside_the_others(sink path: String) -> Bool {
    defer let owned = path
    var book = Book.connect(owned.view()) else |error| {
        error.release()
        return false
    }
    var written = true
    for _ in 0..signatures_per_task {
        let _ = &book.sign("Ada", "Signed alongside the others") else |error| {
            error.release()
            written = false
            break
        }
    }
    book.close()
    written
}

impl Book {
    // Prepare the guest book at `path` for every connection a server will
    // open: create its file and `entries` table if neither exists yet, and
    // switch it to the write-ahead log. `journal_mode=WAL` writes changes to a
    // log beside the file instead of into it, so readers keep reading the
    // last committed entries while a signature is written, and no read waits
    // for a write. Both are stored in the file, and changing the journal mode
    // needs the file to itself, so a server calls this once, before it starts
    // the tasks that each `connect`.
    pub fn initialize(path: Str) -> Result[(), BookError] {
        defer var database = Database.open(path)?
        &database.wait_when_busy(2000)?
        &database.execute("PRAGMA journal_mode=WAL")?
        &database.execute(schema)?
        .Ok(())
    }

    test fn initialize_creates_the_entries_table_in_a_file() {
        defer let path = scratch_path()
        defer {
            remove_database(path.view())
        }
        Book.initialize(path.view()).unwrap()
        var book = Book.connect(path.view()).unwrap()
        &book.sign("Ada", "First note").unwrap()
        book.close()
        .Ok(())
    }

    // Open a connection to the guest book at `path`, which `initialize` has
    // prepared. SQLite lets one connection write at a time, so
    // `wait_when_busy` makes a connection that finds another writing wait up
    // to two seconds for it rather than fail with `SQLITE_BUSY`.
    //
    // A connection waits for the disk after every commit unless told
    // otherwise, and holds the write lock while it waits, so 128 tasks
    // signing at once queue behind one disk flush each and a signature can
    // wait past the two seconds. `synchronous=NORMAL` leaves the flush to
    // the write-ahead log's checkpoint, so a commit ends as soon as the log
    // holds it. A signature survives the server crashing; one signed just
    // before the machine loses power may be lost, but the file stays whole.
    // The setting belongs to the connection, not the file, so every
    // connection sets it.
    pub fn connect(path: Str) -> Result[Book, BookError] {
        defer var database = Database.open(path)?
        &database.wait_when_busy(2000)?
        &database.execute("PRAGMA synchronous=NORMAL")?
        .Ok(Book { database })
    }

    test fn a_connection_reads_what_another_signed() {
        defer let path = scratch_path()
        defer {
            remove_database(path.view())
        }
        Book.initialize(path.view()).unwrap()
        defer var signing = Book.connect(path.view()).unwrap()
        defer var reading = Book.connect(path.view()).unwrap()
        &signing.sign("Ada", "First note").unwrap()
        defer let listed = &reading.newest(10).unwrap()
        testing.assert_eq(listed.length(), UInt64(1), "a second connection did not see the signature")?
        .Ok(())
    }

    // As many connections as a server's serving tasks open at once, each on
    // a thread of its own, to one file `initialize` prepared: every one opens
    // and reads.
    test fn every_serving_task_opens_its_connection_at_once() {
        defer let path = scratch_path()
        defer {
            remove_database(path.view())
        }
        Book.initialize(path.view()).unwrap()
        var paths: Vec[String] = Vec.new()
        for _ in 0..tasks_at_once {
            &paths.push(path.view().to_owned().unwrap()).unwrap()
        }
        defer let answered = task.map(.Threads(tasks_at_once), paths, open_alongside_the_others)
        var succeeded: UInt64 = 0
        for read ok in answered.as_slice() {
            if ok {
                succeeded += 1
            }
        }
        testing.assert_eq(succeeded, tasks_at_once, "a connection opened at the same time as the others failed")?
        .Ok(())
    }

    // As many connections as a server's serving tasks, each on a thread of
    // its own, all signing the book at once. SQLite writes one signature at a
    // time, and a connection waits at most two seconds for the others, so
    // each commit must be short for every signature to be written.
    test fn every_serving_task_signs_at_once() {
        defer let path = scratch_path()
        defer {
            remove_database(path.view())
        }
        Book.initialize(path.view()).unwrap()
        var paths: Vec[String] = Vec.new()
        for _ in 0..tasks_at_once {
            &paths.push(path.view().to_owned().unwrap()).unwrap()
        }
        defer let answered = task.map(.Threads(tasks_at_once), paths, sign_alongside_the_others)
        var succeeded: UInt64 = 0
        for read ok in answered.as_slice() {
            if ok {
                succeeded += 1
            }
        }
        testing.assert_eq(succeeded, tasks_at_once, "a signature written at the same time as the others failed")?
        defer var reading = Book.connect(path.view()).unwrap()
        defer var count = reading.database.prepare("SELECT COUNT(*) FROM entries").unwrap()
        testing.assert(&count.step().unwrap(), "COUNT answered no row")?
        testing.assert_eq(count.integer(0).unwrap(), Int64(tasks_at_once * signatures_per_task), "a signature is missing")?
        .Ok(())
    }

    // `synchronous=NORMAL` is 1: a connection commits a signature without
    // waiting for the disk.
    test fn a_connection_commits_without_waiting_for_the_disk() {
        defer let path = scratch_path()
        defer {
            remove_database(path.view())
        }
        Book.initialize(path.view()).unwrap()
        defer var book = Book.connect(path.view()).unwrap()
        defer var synchronous = book.database.prepare("PRAGMA synchronous").unwrap()
        testing.assert(&synchronous.step().unwrap(), "PRAGMA synchronous answered no row")?
        testing.assert_eq(synchronous.integer(0).unwrap(), Int64(1), "the connection waits for the disk on every commit")?
        .Ok(())
    }

    // Two connections to one file, as two serving tasks hold. While `reading`
    // is part way through a query, `other` reads the entries too and signs
    // the book. Without the log `journal_mode=WAL` keeps, that signature
    // would wait for the read to finish and fail with `SQLITE_BUSY` after the
    // two seconds `wait_when_busy` allows. The unfinished query keeps reading
    // the entries as they were when it began.
    test fn a_read_in_progress_lets_another_connection_read_and_sign() {
        defer let path = scratch_path()
        defer {
            remove_database(path.view())
        }
        Book.initialize(path.view()).unwrap()
        defer var reading = Book.connect(path.view()).unwrap()
        defer var other = Book.connect(path.view()).unwrap()
        &other.sign("Ada", "First").unwrap()
        &other.sign("Grace", "Second").unwrap()
        defer var names = reading.database.prepare("SELECT name FROM entries ORDER BY id").unwrap()
        testing.assert(&names.step().unwrap(), "the first entry was not read")?
        defer let listed = &other.newest(10).unwrap()
        testing.assert_eq(listed.length(), UInt64(2), "a second reader did not see both entries")?
        let signed = match &other.sign("Linus", "Third") {
            Ok(_) => true,
            Err(error) => {
                error.release()
                false
            },
        }
        testing.assert(signed, "a signature waited for a read in progress")?
        testing.assert(&names.step().unwrap(), "the second entry was not read")?
        testing.assert(!&names.step().unwrap(), "a query in progress read an entry signed after it began")?
        .Ok(())
    }

    // Two connections on two threads, as two serving tasks hold them. This
    // thread keeps a query part way through on its connection while a task
    // signs through its own, and the task sends back over its session
    // whether the signature was written; the query, still open, reads the
    // entries as they were when it began.
    test fn a_task_signs_while_another_thread_holds_a_read_open() {
        defer let path = scratch_path()
        defer {
            remove_database(path.view())
        }
        Book.initialize(path.view()).unwrap()
        defer var reading = Book.connect(path.view()).unwrap()
        &reading.sign("Ada", "First").unwrap()
        defer var names = reading.database.prepare("SELECT name FROM entries ORDER BY id").unwrap()
        testing.assert(&names.step().unwrap(), "the first entry was not read")?
        let writer_path = path.view()
        let body = sink [writer_path] |sink me: Chan[Send[Bool, End]]| {
            let signed = match Book.connect(writer_path) {
                Ok(connected) => {
                    var book = connected
                    let written = match &book.sign("Grace", "From another thread") {
                        Ok(_) => true,
                        Err(error) => {
                            error.release()
                            false
                        },
                    }
                    book.close()
                    written
                },
                Err(error) => {
                    error.release()
                    false
                },
            }
            me.send(signed).close()
        }
        let (signed, done) = task.start(body).unwrap().recv()
        done.close()
        testing.assert(signed, "a signature on another thread waited for a read in progress")?
        testing.assert(!&names.step().unwrap(), "a query in progress read an entry signed after it began")?
        .Ok(())
    }

    // Open a connection to the guest book kept in the in-memory database
    // `name`, creating its `entries` table if it does not exist yet. Every
    // `Book` opened with the same name reaches the same entries until the
    // last is closed, so a test can open one for each task that serves it.
    pub fn open_in_memory(name: Str) -> Result[Book, BookError] {
        defer var database = Database.open_in_memory(name)?
        &database.execute(schema)?
        .Ok(Book { database })
    }

    test fn open_in_memory_starts_with_no_entries() {
        defer var book = Book.open_in_memory("starts_with_no_entries").unwrap()
        defer let listed = &book.newest(10).unwrap()
        testing.assert_eq(listed.length(), UInt64(0), "a new book was not empty")?
        .Ok(())
    }

    // Record a visitor's signature. `?1` and `?2` bind the name and message as
    // parameters, so quotes or SQL keywords in what a visitor wrote are stored
    // as text and never read as SQL.
    pub fn sign(inout self: Self, name: Str, message: Str) -> Result[(), BookError] {
        defer var insert = self.database.prepare("INSERT INTO entries (name, message) VALUES (?1, ?2)")?
        &insert.bind_text(1, name)?
        &insert.bind_text(2, message)?
        &insert.run()?
        .Ok(())
    }

    test fn sign_stores_text_holding_quotes_and_sql() {
        defer var book = Book.open_in_memory("sign_stores_text_holding_quotes_and_sql").unwrap()
        &book.sign("O'Connor", "'); DROP TABLE entries; --").unwrap()
        defer let listed = &book.newest(10).unwrap()
        testing.assert_eq(listed.length(), UInt64(1), "the entry was not stored")?
        testing.assert_eq(listed[0].name.view(), "O'Connor", "the quote changed")?
        testing.assert_eq(listed[0].message.view(), "'); DROP TABLE entries; --", "the message changed")?
        .Ok(())
    }

    // Read up to `limit` entries, newest first. `defer var select` finishes the
    // statement when `newest` returns, and `defer var entries` releases any
    // entries already read if a later row or push fails; `.Ok(entries)` moves
    // the completed vector to the caller.
    pub fn newest(inout self: Self, limit: Int64) -> Result[Vec[Entry], BookError] {
        if limit < 0 {
            return .Err(.NegativeLimit(limit))
        }
        defer var select = self.database.prepare("SELECT name, message, signed_at FROM entries ORDER BY id DESC LIMIT ?1")?
        &select.bind_integer(1, limit)?
        defer var entries: Vec[Entry] = Vec.new()
        while &select.step()? {
            let entry = read_entry(select)?
            &entries.push(entry).settled().map_err(|sink _| BookError.OutOfMemory)?
        }
        .Ok(entries)
    }

    test fn signing_and_listing_returns_newest_first_up_to_the_limit() {
        defer var book = Book.open_in_memory("signing_and_listing_returns_newest_first_up_to_the_limit").unwrap()
        &book.sign("Ada", "First").unwrap()
        &book.sign("Grace", "Second").unwrap()
        &book.sign("Linus", "Third").unwrap()
        defer let listed = &book.newest(2).unwrap()
        testing.assert_eq(listed.length(), UInt64(2), "limit was not respected")?
        testing.assert_eq(listed[0].name.view(), "Linus", "newest entry was not first")?
        testing.assert_eq(listed[1].name.view(), "Grace", "second newest entry was not second")?
        .Ok(())
    }

    test fn newest_refuses_a_negative_limit() {
        defer var book = Book.open_in_memory("newest_refuses_a_negative_limit").unwrap()
        let refused = match &book.newest(-1) {
            Ok(entries) => {
                entries.release()
                false
            },
            Err(error) => {
                let is_negative = match read error {
                    NegativeLimit(limit) => limit == -1,
                    _ => false,
                }
                error.release()
                is_negative
            },
        }
        testing.assert(refused, "a negative limit was accepted")?
        .Ok(())
    }

    test fn newest_zero_returns_no_entries() {
        defer var book = Book.open_in_memory("newest_zero_returns_no_entries").unwrap()
        &book.sign("Ada", "Hello").unwrap()
        defer let listed = &book.newest(0).unwrap()
        testing.assert_eq(listed.length(), UInt64(0), "newest(0) returned entries")?
        .Ok(())
    }

    test fn invalid_timestamps_are_refused_rather_than_faked() {
        defer var book = Book.open_in_memory("invalid_timestamps_are_refused_rather_than_faked").unwrap()
        // Year 10000+ Unix timestamp is outside Linea's representable range.
        let invalid_stamp: Int64 = 300000000000
        var insert = book.database.prepare("INSERT INTO entries (name, message, signed_at) VALUES ('Eve', 'Time traveler', ?1)").unwrap()
        &insert.bind_integer(1, invalid_stamp).unwrap()
        &insert.run().unwrap()
        insert.finish()

        let refused = match &book.newest(10) {
            Ok(entries) => {
                entries.release()
                false
            },
            Err(error) => {
                let matches_stamp = match read error {
                    InvalidTimestamp(seconds) => seconds == invalid_stamp,
                    _ => false,
                }
                error.release()
                matches_stamp
            },
        }
        testing.assert(refused, "an invalid timestamp was silently accepted")?
        .Ok(())
    }

    test fn a_refused_entry_push_settles_the_rejected_entry_and_earlier_rows() {
        let log = mem.AllocationLog.open(mem.system(), 0).unwrap()
        var entries: Vec[Entry, mem.RefusingAllocator[mem.SystemAllocator]] = Vec.new_in(log.allocator())
        let first = Entry { name = "Ada".to_owned().unwrap(), message = "First".to_owned().unwrap(), signed = time.now() }
        &entries.push(first).settled().unwrap()
        log.refuse_attempt(log.attempts() + 1)
        var exhausted = false
        for _ in 0..16 {
            let next = Entry { name = "Grace".to_owned().unwrap(), message = "Second".to_owned().unwrap(), signed = time.now() }
            if &entries.push(next).settled().is_err() {
                exhausted = true
                break
            }
        }
        entries.release()
        let settled = log.all_disposed()
        log.release()
        testing.assert(exhausted, "the refused growth did not fail push")?
        testing.assert(settled, "a vector growth refusal leaked storage")?
        .Ok(())
    }

    // Close the guest book and its underlying SQLite connection.
    pub fn close(sink self: Self) {
        let Book { database } = self
        database.close()
    }

    test fn close_consumes_the_book() {
        let book = Book.open_in_memory("close_consumes_the_book").unwrap()
        book.close()
        .Ok(())
    }
}

// `Release` closes the underlying connection, so `defer var book` and server
// error paths never leak the SQLite handle.
impl Release for Book {
    fn release(sink self: Self) {
        self.close()
    }
}
