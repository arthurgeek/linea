// A copy of an element chosen at run time holds each field's borrow in that
// field, so a change to the place one `left` borrows leaves `right` usable.
struct Box { value: UInt64 }

@copyable
struct Pair { left: borrow UInt64, right: borrow UInt64 }

fn bump(inout b: Box) {
    b.value = b.value + 1
}

fn main() -> UInt8 {
    var x = Box { value = 1 }
    let y = Box { value = 2 }
    let cells = [Pair { left = borrow x.value, right = borrow y.value }, Pair { left = borrow y.value, right = borrow y.value }]
    var i: UInt64 = 1
    i = i - 1
    let c = copy(cells[i])
    bump(&x)
    UInt8(*c.right)
}
