// An instantiation is a type the program reached without declaring, and it is
// laid out like any other -- so the limit is asked of every type in the pool
// rather than of every declaration. `P[W8]` is what crosses, and it is
// reported at the declaration it was made from, because an instantiation is
// written wherever it is named and each of those places is the same type.
struct P[T] { a: T, b: T, c: T, d: T, e: T, f: T, g: T, h: T }

struct W0 { v: P[UInt64] }

struct W1 { v: P[W0] }

struct W2 { v: P[W1] }

struct W3 { v: P[W2] }

struct W4 { v: P[W3] }

struct W5 { v: P[W4] }

struct W6 { v: P[W5] }

struct W7 { v: P[W6] }

struct W8 { v: P[W7] }

enum Wide {
    Deep(P[W8]),
    Nothing,
}

fn main() -> UInt8 {
    let _w: Wide = .Nothing
    0
}
