// Structural release walks fields in reverse declaration order, so a later
// field is terminal before an earlier field can observe its own release.
import std.io

use io.print

@linear
enum One { Value }

@linear
enum Two { Value }

@linear
enum Three { Value }

impl Release for One {
    fn release(sink self: One) {
        match self { Value => match print("1") { Ok(_) => {}, Err(_) => {} } }
    }
}

impl Release for Two {
    fn release(sink self: Two) {
        match self { Value => match print("2") { Ok(_) => {}, Err(_) => {} } }
    }
}

impl Release for Three {
    fn release(sink self: Three) {
        match self { Value => match print("3") { Ok(_) => {}, Err(_) => {} } }
    }
}

@linear
struct Product {
    one: One,
    two: Two,
    three: Three,
}

derive Release for Product

fn main() -> UInt8 {
    let value: Product = .{ one = .Value, two = .Value, three = .Value }
    Release.release(value)
    0
}
