function ;main
local $0 Outer value storage=bytes
@0:
  %0 = addr_of Outer managed-address $0
  %1 = constant UInt64 value computation=i64 0
  %2 = field_addr Inner managed-address %0, %1
  %3 = constant UInt64 value computation=i64 0
  %4 = field_addr UInt8 managed-address %2, %3
  %5 = constant UInt8 value computation=i64 1
  store_indirect UInt8 %4, %5
  %7 = constant UInt64 value computation=i64 1
  %8 = field_addr UInt8 managed-address %0, %7
  %9 = constant UInt8 value computation=i64 2
  store_indirect UInt8 %8, %9
  %11 = addr_of Outer managed-address $0
  %12 = constant UInt64 value computation=i64 0
  %13 = field_addr Inner managed-address %11, %12
  %14 = constant UInt64 value computation=i64 0
  %15 = field_addr UInt8 managed-address %13, %14
  %16 = call () value computation=i64 @f1(%15)
  %17 = addr_of Outer managed-address $0
  %18 = constant UInt64 value computation=i64 0
  %19 = field_addr Inner managed-address %17, %18
  %20 = call () value computation=i64 @f2(%19)
  %21 = addr_of Outer managed-address $0
  %22 = constant UInt64 value computation=i64 0
  %23 = field_addr Inner managed-address %21, %22
  %24 = constant UInt64 value computation=i64 0
  %25 = field_addr UInt8 managed-address %23, %24
  %26 = load_indirect UInt8 value computation=i64 %25
  %27 = addr_of Outer managed-address $0
  %28 = constant UInt64 value computation=i64 1
  %29 = field_addr UInt8 managed-address %27, %28
  %30 = load_indirect UInt8 value computation=i64 %29
  %31 = add UInt8 value computation=i64 %26, %30
  %32 = check UInt8 value computation=i64 %31 (overflow)
  ret %32
function ;bump
local $0 UInt8 managed-address
@0:
  %0 = load UInt8 managed-address $0
  %1 = load_indirect UInt8 value computation=i64 %0
  %2 = constant UInt8 value computation=i64 1
  %3 = add UInt8 value computation=i64 %1, %2
  %4 = check UInt8 value computation=i64 %3 (overflow)
  %5 = load UInt8 managed-address $0
  store_indirect UInt8 %5, %4
  %7 = constant () value computation=i64 0
  ret %7
function ;shift
local $0 Inner managed-address
@0:
  %0 = load Inner managed-address $0
  %1 = constant UInt64 value computation=i64 0
  %2 = field_addr UInt8 managed-address %0, %1
  %3 = load_indirect UInt8 value computation=i64 %2
  %4 = constant UInt8 value computation=i64 10
  %5 = add UInt8 value computation=i64 %3, %4
  %6 = check UInt8 value computation=i64 %5 (overflow)
  %7 = load Inner managed-address $0
  %8 = constant UInt64 value computation=i64 0
  %9 = field_addr UInt8 managed-address %7, %8
  store_indirect UInt8 %9, %6
  %11 = constant () value computation=i64 0
  ret %11
