// `V.s` exists only if `R` can be discarded, and `R` holds the linear part
// `D.p` through a `W`. `Pad` answers whatever it holds, so the selections
// reaching `D` and `R` first change nothing.
trait Pick {
    type Out
}

@linear
struct Lin {
    v: UInt8,
}

struct Chooser[T] {
    t: T,
}

impl[T: Discardable] Pick for Chooser[T] {
    type Out = UInt8
}

impl Pick for Y {
    type Out = Lin
}

struct Pad[T] {
    t: T,
}

impl[T] Pick for Pad[T] {
    type Out = UInt8
}

struct Zed {
    z: Pad[D].Out,
}

struct D {
    p: Y.Out,
}

struct Y {
    w: W,
    x: X,
    v: V,
}

struct W {
    d: D,
}

struct X {
    q: Pad[R].Out,
}

struct R {
    w: W,
}

struct V {
    s: Chooser[R].Out,
}

fn main() -> UInt8 {
    let _z = Zed { z = 1 }
    0
}
