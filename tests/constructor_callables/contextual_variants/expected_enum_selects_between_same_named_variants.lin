enum ReadError { Allocation(UInt8) }

enum WriteError { Allocation(UInt64) }

fn main() -> UInt8 {
    let read_error: fn(sink code: UInt8) -> ReadError = .Allocation
    let write_error: fn(sink amount: UInt64) -> WriteError = .Allocation
    let first = match read_error(code: 7) { Allocation(value) => value }
    let second = match write_error(amount: 300) { Allocation(value) => value }
    if first == 7 && second == 300 {
        0
    } else {
        1
    }
}
