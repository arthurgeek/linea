// `Iterator.next` hands back an `Option` holding the range's item, and the
// `match` needs only to know it is an `Option`. Adding each item to `total`
// settles the range's literals at `UInt64`, as a `for` over it would.
fn main() -> UInt8 {
    var pending = 0..4
    var total: UInt64 = 0
    loop {
        match Iterator.next(&pending) {
            Some(i) => {
                total += i
            },
            None => {
                break
            },
        }
    }
    UInt8(total)
}
