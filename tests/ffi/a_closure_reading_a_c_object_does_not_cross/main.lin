import std.session
import std.task
import counter

use counter.Counter
use session.Chan
use session.End

// `reader` observes the counter, so a task reading `reader` reads the counter
// through C while `main` may read it too.
fn main() -> UInt8 {
    let tally = Counter.open() else |_| {
        return 1
    }
    let reader = [read tally] |n: Int64| tally.total() + n
    let worker = task.start(
        sink [read reader] |sink me: Chan[End]| {
            let _x = reader(1)
            me.close()
        },
    ).unwrap()
    worker.close()
    tally.close()
    0
}
