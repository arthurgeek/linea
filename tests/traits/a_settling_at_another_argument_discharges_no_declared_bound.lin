// A declared type bounded `Lookup[UInt64]` is not settled to a type that
// implements `Lookup` only at some other argument.
trait Lookup[I] {
    fn at(self: Self, i: I) -> UInt8
}

trait Holds {
    type Elem: Lookup[UInt64]

    fn one(self: Self) -> UInt8
}

struct Board {
    cells: [UInt8; 4],
}

impl Lookup[Bool] for Board {
    fn at(_self: Board, _i: Bool) -> UInt8 {
        1
    }
}

struct Bag {
    n: UInt8,
}

impl Holds for Bag {
    type Elem = Board

    fn one(self: Bag) -> UInt8 {
        self.n
    }
}

fn main() -> UInt8 {
    let g: Bag = .{ n = 5 }
    Holds.one(g)
}
