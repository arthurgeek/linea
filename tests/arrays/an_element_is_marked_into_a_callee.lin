// An element is handed to an `inout` parameter the way a field is, and the call
// site marks it. `&` is not address-of -- there are no references to take -- it
// says which argument the call can change.
fn bump(inout n: UInt8) -> () {
    n = n + 1
}

fn main() -> UInt8 {
    var xs: [UInt8; 3] = [1, 2, 3]
    bump(&xs[1])
    bump(&xs[1])
    xs[1] + 0
}
