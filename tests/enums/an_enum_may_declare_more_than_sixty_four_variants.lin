// An enum declares as many variants as it needs, and a `match` naming every
// one of a hundred variants covers it.
enum Wide {
    V0,
    V1(UInt8),
    V2,
    V3(UInt8),
    V4,
    V5(UInt8),
    V6,
    V7(UInt8),
    V8,
    V9(UInt8),
    V10,
    V11(UInt8),
    V12,
    V13(UInt8),
    V14,
    V15(UInt8),
    V16,
    V17(UInt8),
    V18,
    V19(UInt8),
    V20,
    V21(UInt8),
    V22,
    V23(UInt8),
    V24,
    V25(UInt8),
    V26,
    V27(UInt8),
    V28,
    V29(UInt8),
    V30,
    V31(UInt8),
    V32,
    V33(UInt8),
    V34,
    V35(UInt8),
    V36,
    V37(UInt8),
    V38,
    V39(UInt8),
    V40,
    V41(UInt8),
    V42,
    V43(UInt8),
    V44,
    V45(UInt8),
    V46,
    V47(UInt8),
    V48,
    V49(UInt8),
    V50,
    V51(UInt8),
    V52,
    V53(UInt8),
    V54,
    V55(UInt8),
    V56,
    V57(UInt8),
    V58,
    V59(UInt8),
    V60,
    V61(UInt8),
    V62,
    V63(UInt8),
    V64,
    V65(UInt8),
    V66,
    V67(UInt8),
    V68,
    V69(UInt8),
    V70,
    V71(UInt8),
    V72,
    V73(UInt8),
    V74,
    V75(UInt8),
    V76,
    V77(UInt8),
    V78,
    V79(UInt8),
    V80,
    V81(UInt8),
    V82,
    V83(UInt8),
    V84,
    V85(UInt8),
    V86,
    V87(UInt8),
    V88,
    V89(UInt8),
    V90,
    V91(UInt8),
    V92,
    V93(UInt8),
    V94,
    V95(UInt8),
    V96,
    V97(UInt8),
    V98,
    V99(UInt8),
}

fn number(sink w: Wide) -> UInt8 {
    match w {
        V0 => 0,
        V1(n) => n,
        V2 => 2,
        V3(n) => n,
        V4 => 4,
        V5(n) => n,
        V6 => 6,
        V7(n) => n,
        V8 => 8,
        V9(n) => n,
        V10 => 10,
        V11(n) => n,
        V12 => 12,
        V13(n) => n,
        V14 => 14,
        V15(n) => n,
        V16 => 16,
        V17(n) => n,
        V18 => 18,
        V19(n) => n,
        V20 => 20,
        V21(n) => n,
        V22 => 22,
        V23(n) => n,
        V24 => 24,
        V25(n) => n,
        V26 => 26,
        V27(n) => n,
        V28 => 28,
        V29(n) => n,
        V30 => 30,
        V31(n) => n,
        V32 => 32,
        V33(n) => n,
        V34 => 34,
        V35(n) => n,
        V36 => 36,
        V37(n) => n,
        V38 => 38,
        V39(n) => n,
        V40 => 40,
        V41(n) => n,
        V42 => 42,
        V43(n) => n,
        V44 => 44,
        V45(n) => n,
        V46 => 46,
        V47(n) => n,
        V48 => 48,
        V49(n) => n,
        V50 => 50,
        V51(n) => n,
        V52 => 52,
        V53(n) => n,
        V54 => 54,
        V55(n) => n,
        V56 => 56,
        V57(n) => n,
        V58 => 58,
        V59(n) => n,
        V60 => 60,
        V61(n) => n,
        V62 => 62,
        V63(n) => n,
        V64 => 64,
        V65(n) => n,
        V66 => 66,
        V67(n) => n,
        V68 => 68,
        V69(n) => n,
        V70 => 70,
        V71(n) => n,
        V72 => 72,
        V73(n) => n,
        V74 => 74,
        V75(n) => n,
        V76 => 76,
        V77(n) => n,
        V78 => 78,
        V79(n) => n,
        V80 => 80,
        V81(n) => n,
        V82 => 82,
        V83(n) => n,
        V84 => 84,
        V85(n) => n,
        V86 => 86,
        V87(n) => n,
        V88 => 88,
        V89(n) => n,
        V90 => 90,
        V91(n) => n,
        V92 => 92,
        V93(n) => n,
        V94 => 94,
        V95(n) => n,
        V96 => 96,
        V97(n) => n,
        V98 => 98,
        V99(n) => n,
    }
}

fn main() -> UInt8 {
    number(.V98) + number(.V99(1)) - 99
}
