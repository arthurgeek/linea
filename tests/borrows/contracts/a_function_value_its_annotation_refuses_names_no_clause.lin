// The annotation refuses `second`, whose signature says nothing of `b`, and
// still fixes the signature `second` must have. The escape in its body is
// told what that signature permits, not a clause the annotation refuses.
fn second(_a: String, b: String) -> Str {
    b.view()
}

fn main() -> UInt8 {
    let f: fn(read a: String, read b: String) -> Str where borrows(a) = second
    defer let a = String.new()
    defer let b = String.new()
    UInt8(f(a, b).length())
}
