@linear
struct Key {
    n: UInt8,
}

@linear
struct Grid {
    cells: [Key; 2],
}

impl Index[UInt64] for Grid via cells

fn main() -> UInt8 {
    var g: Grid = .{ cells = [.{ n = 1 }, .{ n = 2 }] }
    g[0] = .{ n = 3 }
    let Grid { cells } = g
    var total: UInt8 = 0
    for key in cells {
        let Key { n } = key
        total += n
    }
    total
}
