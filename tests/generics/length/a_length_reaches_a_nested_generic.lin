// A length parameter passes to another generic function as itself, and each
// instance of the outer function reaches the matching instance of the inner.
fn total[let n: UInt64](values: [UInt8; n]) -> UInt64 {
    var sum: UInt64 = 0
    for read value in values {
        sum = sum + UInt64(value)
    }
    sum
}

fn mean[let n: UInt64](values: [UInt8; n]) -> UInt64 {
    total[n](values) / n
}

fn main() -> UInt8 {
    UInt8(mean([2, 4, 6]) + mean([10, 20]))
}
