import std.io
import std.log
import std.net
import std.mem
import std.testing
import std.time
import std.uuid

// `RequestIds` is a middleware that gives every request an id. The id is the
// one the client or a proxy in front of the server sent in `X-Request-Id`,
// when that is well formed, so a request keeps one id across the services it
// passes through; otherwise it is a new version 7 UUID, such as
// `0190b3e2-7c1a-7d4e-9f21-3a5c8e0b6d17`, which sorts by the millisecond it
// was made. Each serving task makes its ids on its own, so a server that
// serves on many tasks needs no count they share.
//
// An id the client sent is well formed when it is 1 to 128 bytes of visible
// ASCII, from `!` to `~`, with no space or control byte. The first
// `X-Request-Id` header the client sent is the one read.
//
// The request it passes to its handler carries the id in two places:
//
// - a header `X-Request-Id`, which the handler reads with
//   `request.header("X-Request-Id")`, and which is the first header the
//   request's `headers()` walk yields. Every other header the client sent
//   under that name is dropped; the rest keep their arrival order.
// - the request's own id, which `http.logged` prints as `request_id`. It is a
//   field only this middleware sets, so without it a header a client sends is
//   never logged, and with it only a well-formed one is. The logger quotes and
//   escapes a value as it does any other.
//
// The answer the handler gives, a response or a refusal, carries the same
// `X-Request-Id` header, replacing one the handler set itself, so a client can
// quote the id when reporting a problem. An answer the server writes without
// the handler, such as a 413, 408 or 503, has no id, and neither has the 500
// given when the buffers below cannot grow.
//
// To have the id logged, put `RequestIds` outside `http.logged`:
//
//     http.with_request_ids(http.logged(logger, router))
//
// Inside `logged`, the handler and the answer still carry the id, but the line
// has no `request_id` field.
//
// The request it hands on is the original with the id added. Its head and
// header table are rebuilt in buffers the middleware keeps and reuses, valid
// until the next request. The buffers keep the size of the largest head seen.
@opaque
struct RequestIds[H, A: Allocator = mem.SystemAllocator] {
    handler: H,
    // `pending` is where the id of the request the handler is answering or has
    // just answered lies in the buffers' head, until the event that reports
    // its exchange takes it. An event arriving without one belongs to a
    // request the handler never saw.
    pending: Option[Span],
    buffers: Buffers[A],
}

// Releasing a `RequestIds` releases the handler and its buffers.
derive[H: Release, A: Allocator] Release for RequestIds[H, A]

// `Buffers` hold the rebuilt request: `head` is the original head followed by
// the header's name and the id, and `fields` locates the headers in it.
struct Buffers[A: Allocator] {
    head: Vec[UInt8, A],
    fields: Vec[Field, A],
}

derive[A: Allocator] Release for Buffers[A]

// The name of the header that carries the id.
let request_id_header: Str = "X-Request-Id"

// An id a client sends is kept when it has at most this many bytes.
let max_sent_id_bytes: UInt64 = 128

// Visible ASCII runs from `!`, byte 33, to `~`, byte 126.
let first_visible_byte: UInt8 = 33

let last_visible_byte: UInt8 = 126

// `with_request_ids` wraps `handler`, which may be a whole `Router`, so that
// every request it answers has an id. The buffers it keeps come from the
// system allocator; `with_request_ids_in` takes them from another.
pub fn with_request_ids[H](sink handler: H) -> RequestIds[H, mem.SystemAllocator] where carries(handler) {
    with_request_ids_in(mem.system(), handler)
}

// `with_request_ids_in` is `with_request_ids` with the buffers it keeps taken
// from `allocator`.
pub fn with_request_ids_in[H, A: Allocator](allocator: A, sink handler: H) -> RequestIds[H, A] where carries(handler, allocator) {
    .{
        handler,
        pending = .None,
        buffers = .{ head = Vec.new_in(allocator), fields = Vec.new_in(allocator) },
    }
}

// Whether `id`, sent by a client, is kept as the request's id: 1 to 128 bytes,
// each visible ASCII.
fn well_formed(id: Str) -> Bool {
    if id.length() == 0 || id.length() > max_sent_id_bytes {
        return false
    }
    for at in 0..id.length() {
        let byte = id.byte(at).unwrap()
        if byte < first_visible_byte || byte > last_visible_byte {
            return false
        }
    }
    true
}

test fn an_id_is_kept_only_when_it_is_short_visible_ascii() {
    testing.assert(well_formed("0190b3e2-7c1a-7d4e-9f21-3a5c8e0b6d17"), "a UUID was refused")?
    testing.assert(well_formed("a"), "a one-byte id was refused")?
    testing.assert(!well_formed(""), "an empty id was kept")?
    testing.assert(!well_formed("two words"), "an id with a space was kept")?
    testing.assert(!well_formed("tab\tid"), "an id with a control byte was kept")?
    testing.assert(!well_formed("caf\u{e9}"), "an id with a byte past ASCII was kept")?
    defer var long = String.new()
    for _ in 0..max_sent_id_bytes {
        &long.append("a").unwrap()
    }
    testing.assert(well_formed(long.view()), "an id of the longest length was refused")?
    &long.append("a").unwrap()
    testing.assert(!well_formed(long.view()), "an id one byte too long was kept")?
}

// `identify` rebuilds `request` in `buffers` with its id first among its
// headers, and returns where the id lies in the rebuilt head. The id is the
// first `X-Request-Id` the client sent, when that is well formed, or a new
// version 7 UUID. It refuses with `Oom` when the buffers cannot grow.
fn identify[P: Allocator, A: Allocator](inout buffers: Buffers[A], request: Request[P]) -> Result[Span, mem.Oom] where carries() {
    var made = String.new_in(request.allocator())
    // A request that sent no id is read as having sent an empty one, which
    // is not well formed.
    let sent = request.header(request_id_header).unwrap_or("")
    let id = if well_formed(sent) {
        sent
    } else {
        uuid.Uuid.v7().fmt(&made)?
        made.view()
    }
    let held = copy(request.head)
    &buffers.head.clear()
    &buffers.fields.clear()
    &buffers.head.reserve(held.length() + request_id_header.length() + id.length())?
    &buffers.fields.reserve(request.header_fields.length() + 1)?
    &buffers.head.append_slice(held.as_bytes())?
    let name = push_stored(&buffers.head, request_id_header.as_bytes())?
    let value = push_stored(&buffers.head, id.as_bytes())?
    // The id's header comes first; the client's headers follow in arrival
    // order, except any it sent under the id's name.
    match &buffers.fields.push(.{ name, value = copy(value) }) {
        Ok(_) => {},
        Err(_) => return .Err(.Exhausted),
    }
    for field in copy(request.header_fields) {
        if stored_part(held, field.name).equals_ascii_folded(request_id_header) {
            continue
        }
        match &buffers.fields.push(copy(*field)) {
            Ok(_) => {},
            Err(_) => return .Err(.Exhausted),
        }
    }
    .Ok(value)
}

// `identified_view` is `request` as `identify` left it in `buffers`, with its
// id at `id`.
fn identified_view[P: Allocator, A: Allocator](buffers: Buffers[A], request: Request[P], id: Span) -> Request[P] where borrows(buffers), carries(request) {
    let whole = Str.from_bytes(buffers.head.as_slice()).unwrap()
    Request[P] { head = copy(whole), header_fields = buffers.fields.as_slice(), request_id = .Some(stored_part(whole, id)), ..copy(request) }
}

// Append `bytes` to `stored` and return the range they occupy.
fn push_stored[A: Allocator](inout stored: Vec[UInt8, A], bytes: mem.Slice[UInt8]) -> Result[Span, mem.Oom] where carries() {
    let start = stored.length()
    &stored.append_slice(bytes)?
    .Ok(.{ start, end = stored.length() })
}

// `RequestIds` takes the state its handler takes and passes it on. The handler
// is given the identified request, and its answer, a response or a refusal,
// carries the id.
impl[P: Allocator, S, H: Handler[S, P], A: Allocator] Handler[S, P] for RequestIds[H, A] {
    fn serve_http(inout self: Self, inout state: S, request: Request[P]) -> Result[Response[P], Error[P]] {
        self.pending = .None
        let id = identify(&self.buffers, request)?
        self.pending = .Some(copy(id))
        let identified = identified_view(self.buffers, request, id)
        let text = identified.header(request_id_header).unwrap()
        match &self.handler.serve_http(&state, identified) {
            Ok(response) => {
                var answer = response
                &answer.set_header(request_id_header, text)?
                .Ok(answer)
            },
            Err(refusal) => {
                var answer = refusal
                &answer.set_header(identified, request_id_header, text)?
                .Err(answer)
            },
        }
    }
}

// `RequestIds` passes each event on to the handler it holds. The exchange of a
// request the handler answered reaches it with the identified request, as
// `serve_http` left it in the buffers, so a `logged` inside logs the id. An
// exchange the handler never saw reaches it as it is.
impl[H: Observer, A: Allocator] Observer for RequestIds[H, A] {
    fn observe[P: Allocator](inout self: Self, event: Event[P]) {
        match copy(event) {
            Exchanged(exchange) => {
                let waiting = mem.take(&self.pending)
                match copy(exchange.request) {
                    Some(request) => match waiting {
                        Some(id) => {
                            let described: Event[P] = .Exchanged(.{ request = .Some(identified_view(self.buffers, request, id)), ..exchange })
                            &self.handler.observe(described)
                            return
                        },
                        None => {},
                    },
                    None => {},
                }
            },
            _ => {},
        }
        &self.handler.observe(event)
    }
}

@derive(Release)
struct Echoing {
    served: UInt64,
}

// `Echoing` answers with the id its request carries, or "none".
impl[P: Allocator, T] Handler[T, P] for Echoing {
    fn serve_http(inout self: Self, inout _state: T, request: Request[P]) -> Result[Response[P], Error[P]] {
        self.served += 1
        let id = request.header(request_id_header).unwrap_or("none")
        text(request, id)
    }
}

test fn a_malformed_id_the_client_sent_is_replaced() {
    defer let arena = mem.Arena.open(mem.system(), size: 65536)
    defer var identifying = with_request_ids(Echoing { served = 0 })
    var nothing = ()
    var sent = new_request(arena.handle(), "GET", "/a", body: "").unwrap()
    &sent.add_header("X-Request-Id", "1 status=200").unwrap()
    let answered: Result[Response, Error] = &identifying.serve_http(&nothing, sent.request())
    let response = answered.unwrap()
    let id = uuid.Uuid.parse(response.header("X-Request-Id").unwrap())
    testing.assert(id.is_ok(), "the malformed id was not replaced by a UUID")?
    testing.assert_ok_eq(response.text(), response.header("X-Request-Id").unwrap(), "the handler saw another id")?
}

test fn an_identified_request_keeps_the_rest_of_the_request() {
    defer let arena = mem.Arena.open(mem.system(), size: 65536)
    defer var identifying = with_request_ids(Echoing { served = 0 })
    var sent = new_request(arena.handle(), "POST", "/orders?id=7", body: "payload").unwrap()
    &sent.add_header("Accept", "text/plain").unwrap()
    &sent.add_header("X-Request-Id", "order-41").unwrap()
    let id = identify(&identifying.buffers, sent.request()).unwrap()
    let identified = identified_view(identifying.buffers, sent.request(), id)
    testing.assert_eq(identified.header("accept"), Option.Some("text/plain"), "the identified request lost a header")?
    testing.assert_eq(identified.header("X-Request-Id"), Option.Some("order-41"), "the identified request has no id")?
    testing.assert_eq(identified.path(), "/orders", "the path changed")?
    testing.assert_eq(identified.query(), Option.Some("id=7"), "the query changed")?
    testing.assert_eq(identified.method(), Method.Post, "the method changed")?
    testing.assert_ok_eq(identified.text(), "payload", "the body changed")?
}

// Ids given outside `logged` are in the line the exchange logs, and the router
// inside answers as it does alone.
test fn an_identified_exchange_is_logged_with_its_id() {
    let listener = net.listen(net.loopback(0)).unwrap()
    let bound = listener.local_address().unwrap()
    let found = send(bound, "GET /health HTTP/1.1\r\nHost: loopback\r\nX-Request-Id: health-1\r\n\r\n")
    let missing = send(bound, "GET /nowhere HTTP/1.1\r\nHost: loopback\r\nX-Request-Id: missing-2\r\n\r\n")
    let file = log.capture()
    var served = with_request_ids(logged(file.logger(minimum: .Info), health_router()))
    let serving = serve_sequentially(listener, &served, limits: serving(2))
    defer let health = read_to_end(found)
    defer let absent = read_to_end(missing)
    served.release()
    defer let lines = file.finish()
    let expected =
        \\INFO request method=GET path=/health request_id=health-1 status=200 bytes=2 duration=D
        \\WARN request method=GET path=/nowhere request_id=missing-2 status=404 bytes=10 duration=D error="the handler refused the request: not found"
        \\
    testing.assert_ok_eq(serving, (), "serving failed")?
    testing.assert_eq(health.view(), "HTTP/1.1 200 OK\r\nConnection: close\r\nX-Request-Id: health-1\r\nContent-Type: text/plain; charset=utf-8\r\n\r\nok", "the response lacked its id")?
    testing.assert(absent.view().find("X-Request-Id: missing-2").is_some(), "the refusal lacked its id")?
    testing.assert_eq(lines.view(), expected, "the logged lines changed")?
}

// A buffer that cannot grow answers the request 500 and loses nothing.
test fn each_allocation_failure_covers_every_buffer_identifying_grows() -> Result[(), testing.Failure] {
    defer let backing = mem.Arena.open(mem.system(), size: 65536)
    let checked = testing.each_allocation_failure(
        backing.handle(),
        |allocator| -> Result[(), mem.Oom] {
            defer let arena = mem.Arena.open(mem.system(), size: 4096)
            var identifying = with_request_ids_in(allocator, Echoing { served = 0 })
            var sent = new_request(arena.handle(), "GET", "/", body: "").unwrap()
            &sent.add_header("X-Request-Id", "id-12").unwrap()
            let identified = identify(&identifying.buffers, sent.request())
            let carried = match identified {
                Ok(id) => identified_view(identifying.buffers, sent.request(), id).header("X-Request-Id").unwrap_or("") == "id-12",
                Err(oom) => {
                    identifying.release()
                    return .Err(oom)
                },
            }
            identifying.release()
            if !carried {
                return .Err(.Exhausted)
            }
            .Ok(())
        },
        mem.Oom.is_refusal,
    )
    testing.assert(checked.is_ok(), "a refused buffer was not reported as a refusal")?
    .Ok(())
}

// `logged` prints the id from the field only `RequestIds` sets, so a header a
// client sends is never logged without the middleware, and a malformed one is
// never logged with it.
test fn a_malformed_or_unread_client_id_is_never_logged() {
    let listener = net.listen(net.loopback(0)).unwrap()
    let bound = listener.local_address().unwrap()
    let forged = send(bound, "GET /health HTTP/1.1\r\nHost: loopback\r\nX-Request-Id: 1 status=200\r\n\r\n")
    let file = log.capture()
    var plain = logged(file.logger(minimum: .Info), health_router())
    let serving1 = serve_sequentially(listener, &plain, limits: serving(1))
    defer let first = read_to_end(forged)
    plain.release()
    defer let plain_lines = file.finish()
    let listener2 = net.listen(net.loopback(0)).unwrap()
    let bound2 = listener2.local_address().unwrap()
    let wrong = send(bound2, "GET /health HTTP/1.1\r\nHost: loopback\r\nx-request-id: 42\r\n\r\n")
    let file2 = log.capture()
    var misordered = logged(file2.logger(minimum: .Info), with_request_ids(health_router()))
    let serving2 = serve_sequentially(listener2, &misordered, limits: serving(1))
    defer let second = read_to_end(wrong)
    misordered.release()
    defer let misordered_lines = file2.finish()
    testing.assert_ok_eq(serving1, (), "serving a plain logged router failed")?
    testing.assert_ok_eq(serving2, (), "serving a misordered router failed")?
    testing.assert(plain_lines.view().find("request_id").is_none(), "a client's header was logged")?
    testing.assert(misordered_lines.view().find("request_id").is_none(), "a client's header was logged inside the middleware")?
    testing.assert(second.view().find("X-Request-Id: 42").is_some(), "the response lacked its id")?
    let listener3 = net.listen(net.loopback(0)).unwrap()
    let bound3 = listener3.local_address().unwrap()
    let injected = send(bound3, "GET /health HTTP/1.1\r\nHost: loopback\r\nX-Request-Id: 1 status=500\r\n\r\n")
    let file3 = log.capture()
    var outside = with_request_ids(logged(file3.logger(minimum: .Info), health_router()))
    let serving3 = serve_sequentially(listener3, &outside, limits: serving(1))
    defer let third = read_to_end(injected)
    outside.release()
    defer let outside_lines = file3.finish()
    testing.assert_ok_eq(serving3, (), "serving an identified router failed")?
    testing.assert(outside_lines.view().find("status=500").is_none(), "a malformed client id reached the log")?
    testing.assert(third.view().find("X-Request-Id: 1 status").is_none(), "a malformed client id reached the response")?
}

// The headers a handler walks are the client's, in arrival order, with the id
// first in place of every one the client sent under its name.
test fn a_walk_of_the_headers_shows_one_id() {
    defer let arena = mem.Arena.open(mem.system(), size: 65536)
    defer var identifying = with_request_ids(Echoing { served = 0 })
    var sent = new_request(arena.handle(), "GET", "/", body: "").unwrap()
    &sent.add_header("Accept", "text/plain").unwrap()
    &sent.add_header("x-request-id", "first").unwrap()
    &sent.add_header("Host", "a").unwrap()
    &sent.add_header("X-Request-Id", "second").unwrap()
    let id = identify(&identifying.buffers, sent.request()).unwrap()
    let request = identified_view(identifying.buffers, sent.request(), id)
    var walked = String.new_in(arena.handle())
    for header in request.headers() {
        "{header.name}={header.value};".fmt(&walked).unwrap()
    }
    testing.assert_eq(walked.view(), "X-Request-Id=first;Accept=text/plain;Host=a;", "the walk showed a header the client sent under the id's name")?
}

// A handler's own `X-Request-Id` on its answer is replaced by the id.
@derive(Release)
struct SelfIdentifying {
    served: UInt64,
}

impl[P: Allocator, T] Handler[T, P] for SelfIdentifying {
    fn serve_http(inout self: Self, inout _state: T, request: Request[P]) -> Result[Response[P], Error[P]] {
        self.served += 1
        var answer = text(request, "x")?
        &answer.set_header("X-Request-Id", "mine")?
        .Ok(answer)
    }
}

test fn a_handlers_own_id_is_replaced() {
    defer let arena = mem.Arena.open(mem.system(), size: 65536)
    defer var own = with_request_ids(SelfIdentifying { served = 0 })
    var nothing = ()
    let sent = new_request(arena.handle(), "GET", "/", body: "").unwrap()
    let answered: Result[Response, Error] = &own.serve_http(&nothing, sent.request())
    testing.assert(uuid.Uuid.parse(answered.unwrap().header("X-Request-Id").unwrap()).is_ok(), "the handler's id was kept")?
}

// A request the server answers without calling the handler is logged without
// an id, not with the previous request's.
test fn a_request_the_handler_never_saw_is_logged_without_an_id() {
    var listener = net.listen(net.loopback(0)).unwrap()
    let first = send(listener.local_address().unwrap(), "GET /health HTTP/1.1\r\nHost: loopback\r\nX-Request-Id: seen\r\n\r\n")
    var client = net.connect(listener.local_address().unwrap()).unwrap()
    var request = String.new()
    &request.append("POST /health HTTP/1.1\r\nHost: loopback\r\nContent-Length: 8192\r\n").unwrap()
    for index in 0..4 {
        "X-{index}: ".fmt(&request).unwrap()
        for _ in 0..3700 {
            &request.append("a").unwrap()
        }
        &request.append("\r\n").unwrap()
    }
    &request.append("\r\n").unwrap()
    for _ in 0..8192 {
        &request.append("b").unwrap()
    }
    let _sent = io.write_all(&client, request.as_bytes()).unwrap()
    request.release()
    let file = log.capture()
    var served = with_request_ids(logged(file.logger(minimum: .Info), health_router()))
    let limits = Limits { max_body_bytes = 8192, read_timeout_ms = 100, ..serving(1) }
    var refusal = mem.system().acquire(request_buffer_bytes).unwrap()
    let Accepted { connection: c1, address: _ } = &listener.accept().unwrap()
    let arena1 = mem.Arena.open(mem.system(), 53256)
    let _a1 = serve_connection(c1, &served, arena1.handle(), &refusal, limits, time.Instant.now())
    arena1.release()
    let Accepted { connection, address: _ } = &listener.accept().unwrap()
    let arena = mem.Arena.open(mem.system(), 53256)
    let _answered = serve_connection(connection, &served, arena.handle(), &refusal, limits, time.Instant.now())
    refusal.release()
    arena.release()
    served.release()
    listener.close().unwrap()
    defer let got = read_to_end(client)
    defer let got1 = read_to_end(first)
    defer let lines = file.finish()
    testing.assert(lines.view().find("path=/health request_id=seen status=200").is_some(), "the identified request lost its id")?
    testing.assert(lines.view().find("path=/health status=500").is_some(), "the unseen request was logged with an id")?
}

// A buffer that cannot grow answers 500 without calling the handler, and
// nothing is lost.
test fn a_refused_buffer_answers_500_before_the_handler() -> Result[(), testing.Failure] {
    defer let backing = mem.Arena.open(mem.system(), size: 65536)
    let checked = testing.each_allocation_failure(
        backing.handle(),
        |allocator| -> Result[(), mem.Oom] {
            defer let arena = mem.Arena.open(mem.system(), size: 8192)
            var identifying = with_request_ids_in(allocator, Echoing { served = 0 })
            var nothing = ()
            let sent = new_request(arena.handle(), "GET", "/", body: "").unwrap()
            let answered: Result[Response, Error] = &identifying.serve_http(&nothing, sent.request())
            let identified = match read answered {
                Ok(response) => uuid.Uuid.parse(response.header("X-Request-Id").unwrap_or("")).is_ok(),
                Err(error) => error.status() == Status.InternalServerError,
            }
            let refused = answered.is_err()
            let handled = identifying.handler.served
            identifying.release()
            if !identified || (refused && handled != 0) || (!refused && handled != 1) {
                return .Err(.Exhausted)
            }
            if refused {
                return .Err(.Exhausted)
            }
            .Ok(())
        },
        mem.Oom.is_refusal,
    )
    testing.assert(checked.is_ok(), "a refused buffer was not answered 500 before the handler")?
    .Ok(())
}

test fn each_request_gets_a_time_ordered_uuid() {
    defer let arena = mem.Arena.open(mem.system(), size: 65536)
    defer var identifying = with_request_ids(Echoing { served = 0 })
    var nothing = ()
    let sent1 = new_request(arena.handle(), "GET", "/a", body: "").unwrap()
    let first: Result[Response, Error] = &identifying.serve_http(&nothing, sent1.request())
    let first_response = first.unwrap()
    let first_id = uuid.Uuid.parse(first_response.header("X-Request-Id").unwrap()).unwrap()
    testing.assert_eq(first_id.version(), UInt8(7), "the id is not a version 7 UUID")?
    testing.assert_ok_eq(first_response.text(), first_response.header("X-Request-Id").unwrap(), "the handler saw another id")?
    let sent2 = new_request(arena.handle(), "GET", "/b", body: "").unwrap()
    let second: Result[Response, Error] = &identifying.serve_http(&nothing, sent2.request())
    let second_id = uuid.Uuid.parse(second.unwrap().header("X-Request-Id").unwrap()).unwrap()
    testing.assert(first_id != second_id, "two requests got the same id")?
}

test fn a_well_formed_id_the_client_sent_is_kept() {
    defer let arena = mem.Arena.open(mem.system(), size: 65536)
    defer var identifying = with_request_ids(Echoing { served = 0 })
    var nothing = ()
    var sent = new_request(arena.handle(), "GET", "/a", body: "").unwrap()
    &sent.add_header("X-Request-Id", "trace-41.ab@edge").unwrap()
    let answered: Result[Response, Error] = &identifying.serve_http(&nothing, sent.request())
    let response = answered.unwrap()
    testing.assert_eq(response.header("X-Request-Id"), Option.Some("trace-41.ab@edge"), "the client's id was not kept")?
    testing.assert_ok_eq(response.text(), "trace-41.ab@edge", "the handler did not see the client's id")?
}
