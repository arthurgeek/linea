struct Flag { enabled: Bool }

fn accept(flag: Flag) -> Bool {
    flag.enabled
}

fn main() -> UInt8 {
    var score: UInt8 = 0
    if accept(Flag { enabled = true }) {
        score += 1
    }
    while score < 2 {
        score += 1
    }
    for value in [Flag { enabled = true }] {
        if value.enabled {
            score += 1
        }
    }
    if {
        let nested = Flag { enabled = true }
        nested.enabled
    } {
        score += 1
    }
    if score == 4 {
        0
    } else {
        9
    }
}
