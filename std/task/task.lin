import std.mem
import std.io.core
import std.mem.address
import std.release
import std.session
import std.testing
import std.time

use session.Chan
use session.End
use session.Recv
use session.Send
use address.Address

// The stack size `prepare` gives a task, in bytes: two mebibytes. The
// deepest path through the library, parsing and rendering a JSON document as
// deeply nested as the parser accepts while sorting and formatting beside
// it, needs under 96 KiB when optimised and under 768 KiB at `-O 0`, so two
// mebibytes leaves more than twice the unoptimised need. A stack costs
// address space until it is touched, not memory.
pub let default_stack_bytes: UInt64 = 2097152

// PrepareError says which step of preparing a task failed: acquiring the
// bytes the body is kept in, or preparing its execution and stack.
@(copyable, derive(Equatable, Equivalent, Display, Debug, Release))
pub enum PrepareError {
    Allocation,
    Thread,
}

// A Slot is a prepared task: its execution is reserved before running
// anything, the bytes its body will be kept in are acquired, and it holds the
// body. Holding the body, it carries everything the body captured, so a place
// the body reads cannot be written, nor a place it holds lent `inout`
// touched, while the slot lives. It is linear, so every path either starts it
// or cancels it, and since it has one owner the two cannot race.
@(opaque, linear)
struct Slot[phantom P: Protocol, F, A: Allocator = mem.SystemAllocator] {
    task: UInt64,
    storage: mem.Buffer[A],
    body: F,
}

// Unstarted is a preparation that failed: the body it was given, handed
// back, and the reason. Take both with `let Unstarted { body, reason } =
// failure`. Where the body owns nothing that must be settled, `settled()`
// drops it and keeps the reason.
pub struct Unstarted[F] {
    body: F,
    reason: PrepareError,
}

// A failed preparation whose body may be dropped is released by dropping it.
impl[F: Discardable] Release for Unstarted[F] {
    fn release(sink self: Self) {
        let Unstarted { body: _, reason: _ } = self
    }
}

// Settling a failed preparation drops its body and keeps the reason. A body
// that owns something linear is not dropped: its owner takes it back.
impl[F: Discardable] release.Settle for Unstarted[F] {
    type Reason = PrepareError

    fn settle(sink self: Self) -> PrepareError where carries(self) {
        let Unstarted { body: _, reason } = self
        reason
    }
}

test "a failed preparation settles to its reason" {
    let body = sink [] |sink me: Chan[End]| {
        me.close()
    }
    // No address space maps a stack of four exbibytes.
    let reason = match prepare_in(mem.system(), body, stack: 4611686018427387904) {
        Ok(slot) => {
            let _unrun = slot.cancel()
            PrepareError.Allocation
        },
        Err(failure) => release.Settle.settle(failure),
    }
    testing.assert_eq(reason, PrepareError.Thread, "settling lost the reason")?
}

// Reserve execution on `identity` with a stack of `stack_bytes`, and answer
// the task or a negative number when preparation fails.
extern fn linea_task_prepare_on(stack_bytes: UInt64, identity: UInt64) -> Int64

// Release a prepared task with nothing to run.
extern fn linea_task_cancel(task: UInt64)

// Start the prepared task: `entry` receives its session end and the address
// and length of its body. It may run before this call returns. Closing the
// creator's handle waits for the body to finish, then calls `release` with
// `release_at`, the buffer kept after the body, and `len`. No callback remains
// when that close returns. This call answers the creator's endpoint.
extern fn linea_task_start(task: UInt64, entry: fn(endpoint: UInt64, at: UInt64, len: UInt64), release: fn(at: UInt64, len: UInt64), at: UInt64, len: UInt64, release_at: UInt64) -> UInt64

// What a task runs: move the body out of the bytes at `at`, which
// name its type, and call it with the task's end of the session.
fn run_body[P: Protocol, F: sink fn(sink me: Chan[P])](endpoint: UInt64, at: Address[F], _len: UInt64) {
    let body: F = mem.take_kept_body(at)
    body(Chan.opened(endpoint))
}

// Prepare a task whose body is `body`, with a stack of `default_stack_bytes`
// and its bytes from the system allocator. `prepare_in` says what preparing
// does.
pub fn prepare[P: Protocol, F: sink fn(sink me: Chan[P])](sink body: F, on: core.Io = core.inherited) -> Result[Slot[P, F, mem.SystemAllocator], Unstarted[F]] where carries(.Ok: body), carries(.Err: body) {
    prepare_in(mem.system(), body, default_stack_bytes, on)
}

test "a prepared body runs once its task starts" {
    var runs = UInt64(0)
    let body = sink [inout runs] |sink me: Chan[End]| {
        runs += 1
        me.close()
    }
    prepare(body).unwrap().start().close()
    testing.assert_eq(runs, 1, "the started body did not run once")?
}

// Prepare a task whose body is `body`, with a stack of `stack` bytes and the
// bytes its body is kept in from `allocator`. Preparing performs every step
// that can fail, and answers a slot holding the body. A failure hands the
// body back in `Unstarted`, beside the reason. The slot carries the
// allocator, since the task keeps its bytes until it is joined.
pub fn prepare_in[P: Protocol, F: sink fn(sink me: Chan[P]), A: Allocator](allocator: A, sink body: F, stack: UInt64, on: core.Io = core.inherited) -> Result[Slot[P, F, A], Unstarted[F]] where carries(.Ok: body, allocator), carries(.Err: body) {
    let storage = allocator.acquire(mem.kept_bytes(body, allocator)) else |_| {
        return .Err(.{ body, reason = .Allocation })
    }
    let task = linea_task_prepare_on(stack, on.runtime_identity())
    if task < 0 {
        storage.release()
        return .Err(.{ body, reason = .Thread })
    }
    .Ok(.{ task = UInt64(task), storage, body })
}

test "a refused allocation hands the body back" {
    let log = testing.TestAllocator.open(mem.system()).unwrap()
    log.fail_at(.Some(1))
    var runs = UInt64(0)
    let body = sink [inout runs] |sink me: Chan[End]| {
        runs += 1
        me.close()
    }
    let (refused, returned) = match prepare_in(log.handle(), body, stack: default_stack_bytes) {
        Ok(slot) => (false, slot.cancel()),
        Err(failure) => {
            let Unstarted { body, reason } = failure
            (reason == .Allocation, body)
        },
    }
    let settled = log.all_disposed()
    // The body came back from a preparation through the log's allocator, so
    // it is dropped here, before the log; a body handed back runs again in
    // the test below.
    let _returned = returned
    log.release()
    testing.assert(refused, "a refused allocation was not reported as one")?
    testing.assert(settled, "a refused preparation kept an allocation")?
    testing.assert_eq(runs, 0, "a refused body ran")?
}

test "a thread that cannot be made hands the body back" {
    var runs = UInt64(0)
    let body = sink [inout runs] |sink me: Chan[End]| {
        runs += 1
        me.close()
    }
    // No address space maps a stack of four exbibytes.
    let (refused, returned) = match prepare_in(mem.system(), body, stack: 4611686018427387904) {
        Ok(slot) => (false, slot.cancel()),
        Err(failure) => {
            let Unstarted { body, reason } = failure
            (reason == .Thread, body)
        },
    }
    prepare(returned).unwrap().start().close()
    testing.assert(refused, "an impossible stack was not reported as a thread failure")?
    testing.assert_eq(runs, 1, "the body did not run after a failed thread")?
}

// Prepare and start a task in one call, with a stack of `default_stack_bytes`
// and its bytes from the system allocator, and answer its handle.
// `start_in` says what starting does.
pub fn start[P: Protocol, F: Discardable + sink fn(sink me: Chan[P])](sink body: F, on: core.Io = core.inherited) -> Result[Chan[P.Dual, (F, mem.SystemAllocator)], PrepareError] where carries(.Ok: body) {
    start_in(mem.system(), body, default_stack_bytes, on)
}

test "a task started in one call runs its body" {
    let base = UInt64(4)
    let body = sink [read base] |sink me: Chan[Send[UInt64, End]]| {
        me.send(base * 10).close()
    }
    let (answer, done) = start(body).unwrap().recv()
    done.close()
    testing.assert_eq(answer, 40, "the body did not run")?
}

// Prepare and start a task in one call, with a stack of `stack` bytes and the
// bytes its body is kept in from `allocator`. A failure drops the body and
// answers the reason, which is why the body must be Discardable: it owns
// nothing a drop would lose. A body that owns something linear is prepared
// with `prepare_in`, whose failure hands it back.
pub fn start_in[P: Protocol, F: Discardable + sink fn(sink me: Chan[P]), A: Allocator](allocator: A, sink body: F, stack: UInt64, on: core.Io = core.inherited) -> Result[Chan[P.Dual, (F, A)], PrepareError] where carries(.Ok: body, allocator) {
    let slot = prepare_in(allocator, body, stack, on).settled()?
    .Ok(slot.start())
}

test "a task that cannot start answers the reason" {
    let body = sink [] |sink me: Chan[End]| {
        me.close()
    }
    let refused = match start_in(mem.system(), body, stack: 4611686018427387904) {
        Ok(handle) => {
            handle.close()
            false
        },
        Err(reason) => reason == .Thread,
    }
    testing.assert(refused, "an impossible stack was not reported")?
}

impl[P: Protocol, F: sink fn(sink me: Chan[P]), A: Allocator] Slot[P, F, A] {
    // Start the task: move the body into it and let it run. Starting
    // cannot fail. It answers the task's handle, the creator's end of the
    // session whose other end the body receives as `me`. The handle's `(F, A)`
    // makes it carry every dependency the body captured and the allocator its
    // bytes came from, so until `close` joins the task nothing the body reads
    // can be written, nothing it holds lent `inout` can be touched, and the
    // allocator's owner, such as an arena, cannot be released. Every capture
    // must cross the task boundary ([O-Cross]).
    pub fn start(sink self: Self) -> Chan[P.Dual, (F, A)] where carries(self) {
        let Slot { task, storage, body } = self
        let len = storage.length()
        let kept = mem.keep_body(storage, body)
        Chan.opened(linea_task_start(task, run_body[P, F], mem.release_kept_bytes[A], address.raw(kept.body), len, address.raw(kept.buffer)))
    }

    test "a started task answers its handle" {
        let base = UInt64(20)
        let body = sink [read base] |sink me: Chan[Send[UInt64, End]]| {
            me.send(base + 1).close()
        }
        let (answer, done) = prepare(body).unwrap().start().recv()
        done.close()
        testing.assert_eq(answer, 21, "the handle did not receive what the body sent")?
    }

    // Settle a slot that will not be started: release its prepared execution
    // resources and the bytes the body would have been kept in, then answer
    // the body without running it.
    pub fn cancel(sink self: Self) -> F where carries(self.body) {
        let Slot { task, storage, body } = self
        linea_task_cancel(task)
        storage.release()
        body
    }

    test "a cancelled slot runs nothing and gives the body back" {
        let log = testing.TestAllocator.open(mem.system()).unwrap()
        var runs = UInt64(0)
        let body = sink [inout runs] |sink me: Chan[End]| {
            runs += 1
            me.close()
        }
        let returned = match prepare_in(log.handle(), body, stack: default_stack_bytes) {
            Ok(slot) => slot.cancel(),
            Err(failure) => {
                let Unstarted { body, reason: _ } = failure
                body
            },
        }
        let attempts = log.attempts()
        let settled = log.all_disposed()
        let _returned = returned
        log.release()
        testing.assert_eq(attempts, 1, "preparing did not acquire the body's bytes")?
        testing.assert(settled, "cancelling kept the body's bytes")?
        testing.assert_eq(runs, 0, "a cancelled body ran")?
    }
}

// Policy says how much independent work runs at once. `.Sequential` runs
// every job on the caller, one after another, and starts no task.
// `.Threads(max)` runs at most `max` jobs at once, on tasks started on the
// caller's Io (a join runs one of them on the caller itself): each is an
// operating-system thread of its own under `io.system()`, a fiber that can
// change carriers when eligible under a loop, so no more jobs run
// simultaneously than the loop has carriers, and a fiber scheduled from the
// seed inside a simulation. `.Threads(1)` runs the jobs on the caller.
@(copyable, derive(Equatable, Equivalent, Display, Debug))
pub enum Policy {
    Sequential,
    Threads(UInt64),
}

// Order says when a lazy map yields each result. `.Input` yields them in the
// order of the items, so a result that finishes early waits for the items
// before it. `.Completion` yields each result as soon as its job finishes,
// the first to finish first. Jobs run on the caller one after another under
// `.Sequential` and `.Threads(1)`, so there both orders are the items' order.
@(copyable, derive(Equatable, Equivalent, Display, Debug))
pub enum Order {
    Input,
    Completion,
}

// Join two independent calculations according to policy and return both results
// in parameter order once both have finished. Under `.Threads(max)` with `max`
// above 1, `f1` runs on a new task while the caller runs `f2`.
pub fn join[T1: Owned, T2: Owned, F1: Owned + Discardable + sink fn() -> T1, F2: Owned + Discardable + sink fn() -> T2](sink policy: Policy, sink f1: F1, sink f2: F2) -> (T1, T2) {
    join_in(mem.system(), policy, f1, f2)
}

test "join runs sequentially" {
    let (a, b) = join(Policy.Sequential, sink [] || UInt64(10), sink [] || UInt64(20))
    testing.assert_eq(a, 10, "first sequential join result was wrong")?
    testing.assert_eq(b, 20, "second sequential join result was wrong")?
}

test "join runs on threads" {
    let (a, b) = join(Policy.Threads(2), sink [] || UInt64(100), sink [] || UInt64(200))
    testing.assert_eq(a, 100, "first threaded join result was wrong")?
    testing.assert_eq(b, 200, "second threaded join result was wrong")?
}

// Join as `join` does, taking the bytes each started job is kept in from
// `allocator`. Under `.Sequential`, or `.Threads(1)`, nothing is allocated.
pub fn join_in[T1: Owned, T2: Owned, F1: Owned + Discardable + sink fn() -> T1, F2: Owned + Discardable + sink fn() -> T2, A: Allocator](allocator: A, sink policy: Policy, sink f1: F1, sink f2: F2) -> (T1, T2) {
    match policy {
        Sequential => (f1(), f2()),
        Threads(max) => {
            if max == 0 {
                panic("task.join: policy task limit cannot be 0")
            }
            if max == 1 {
                return (f1(), f2())
            }
            let body1 = sink [sink f1] |sink me: Chan[Send[T1, End]]| {
                me.send(f1()).close()
            }
            let h1 = start_in(allocator, body1, default_stack_bytes).unwrap()
            let r2 = f2()
            let (r1, done1) = h1.recv()
            done1.close()
            (r1, r2)
        },
    }
}

test "join_in takes each task from its allocator" {
    let log = testing.TestAllocator.open(mem.system()).unwrap()
    let results = join_in(log.handle(), Policy.Threads(2), sink [] || UInt64(3), sink [] || UInt64(4))
    let attempts = log.attempts()
    let settled = log.all_disposed()
    log.release()
    testing.assert_eq(results, (UInt64(3), UInt64(4)), "the results came back out of order")?
    testing.assert_eq(attempts, 1, "a started job's bytes did not come from the allocator")?
    testing.assert(settled, "joining kept a job's bytes")?
}

test "join_in allocates nothing in sequence" {
    let log = testing.TestAllocator.open(mem.system()).unwrap()
    let results = join_in(log.handle(), Policy.Sequential, sink [] || UInt64(3), sink [] || UInt64(4))
    let attempts = log.attempts()
    log.release()
    testing.assert_eq(results, (UInt64(3), UInt64(4)), "the results came back out of order")?
    testing.assert_eq(attempts, 0, "a sequential join allocated")?
}

// Join three independent calculations according to policy and return all three results
// in parameter order once all three have finished. Under `.Threads(max)` no
// more than `max` of them run at once: the first `max - 1` run on new tasks
// and the caller runs the rest, one after another.
pub fn join3[T1: Owned, T2: Owned, T3: Owned, F1: Owned + Discardable + sink fn() -> T1, F2: Owned + Discardable + sink fn() -> T2, F3: Owned + Discardable + sink fn() -> T3](sink policy: Policy, sink f1: F1, sink f2: F2, sink f3: F3) -> (T1, T2, T3) {
    join3_in(mem.system(), policy, f1, f2, f3)
}

test "join3 runs sequentially and on threads" {
    let (s1, s2, s3) = join3(Policy.Sequential, sink [] || UInt64(1), sink [] || UInt64(2), sink [] || UInt64(3))
    testing.assert_eq(s1, 1, "s1 wrong")?
    testing.assert_eq(s2, 2, "s2 wrong")?
    testing.assert_eq(s3, 3, "s3 wrong")?

    let (t1, t2, t3) = join3(Policy.Threads(3), sink [] || UInt64(10), sink [] || UInt64(20), sink [] || UInt64(30))
    testing.assert_eq(t1, 10, "t1 wrong")?
    testing.assert_eq(t2, 20, "t2 wrong")?
    testing.assert_eq(t3, 30, "t3 wrong")?
}

// Each closure sleeps a tenth of a second, so a join that runs no more than
// `max` of them at once takes at least a tenth of a second for every `max`
// closures, rounded up.
fn napping(value: UInt64) -> UInt64 {
    time.sleep(time.Duration.from_milliseconds(100))
    value
}

test "join3 runs no more closures at once than its bound" {
    let started = time.Instant.now()
    let (a, b, c) = join3(Policy.Threads(2), sink [] || napping(1), sink [] || napping(2), sink [] || napping(3))
    let took = started.elapsed().nanoseconds()
    testing.assert_eq((a, b, c), (UInt64(1), UInt64(2), UInt64(3)), "the results came back out of order")?
    testing.assert(took >= 200000000, "three closures ran at once under a bound of two")?
}

// Join as `join3` does, taking the bytes each started job is kept in from
// `allocator`. Under `.Sequential`, or `.Threads(1)`, nothing is allocated.
pub fn join3_in[T1: Owned, T2: Owned, T3: Owned, F1: Owned + Discardable + sink fn() -> T1, F2: Owned + Discardable + sink fn() -> T2, F3: Owned + Discardable + sink fn() -> T3, A: Allocator](allocator: A, sink policy: Policy, sink f1: F1, sink f2: F2, sink f3: F3) -> (T1, T2, T3) {
    match policy {
        Sequential => (f1(), f2(), f3()),
        Threads(max) => {
            if max == 0 {
                panic("task.join3: policy task limit cannot be 0")
            }
            if max == 1 {
                return (f1(), f2(), f3())
            }
            let body1 = sink [sink f1] |sink me: Chan[Send[T1, End]]| {
                me.send(f1()).close()
            }
            let h1 = start_in(allocator, body1, default_stack_bytes).unwrap()
            if max == 2 {
                let r2 = f2()
                let r3 = f3()
                let (r1, done1) = h1.recv()
                done1.close()
                return (r1, r2, r3)
            }
            let body2 = sink [sink f2] |sink me: Chan[Send[T2, End]]| {
                me.send(f2()).close()
            }
            let h2 = start_in(allocator, body2, default_stack_bytes).unwrap()
            let r3 = f3()
            let (r1, done1) = h1.recv()
            done1.close()
            let (r2, done2) = h2.recv()
            done2.close()
            (r1, r2, r3)
        },
    }
}

test "join3_in takes each task from its allocator" {
    let log = testing.TestAllocator.open(mem.system()).unwrap()
    let results = join3_in(log.handle(), Policy.Threads(3), sink [] || UInt64(3), sink [] || UInt64(4), sink [] || UInt64(5))
    let attempts = log.attempts()
    let settled = log.all_disposed()
    log.release()
    testing.assert_eq(results, (UInt64(3), UInt64(4), UInt64(5)), "the results came back out of order")?
    testing.assert_eq(attempts, 2, "a started job's bytes did not come from the allocator")?
    testing.assert(settled, "joining kept a job's bytes")?
}

test "join3_in allocates nothing in sequence" {
    let log = testing.TestAllocator.open(mem.system()).unwrap()
    let results = join3_in(log.handle(), Policy.Sequential, sink [] || UInt64(3), sink [] || UInt64(4), sink [] || UInt64(5))
    let attempts = log.attempts()
    log.release()
    testing.assert_eq(results, (UInt64(3), UInt64(4), UInt64(5)), "the results came back out of order")?
    testing.assert_eq(attempts, 0, "a sequential join allocated")?
}

// Join four independent calculations according to policy and return all four results
// in parameter order once all four have finished. Under `.Threads(max)` no
// more than `max` of them run at once: the first `max - 1` run on new tasks
// and the caller runs the rest, one after another.
pub fn join4[T1: Owned, T2: Owned, T3: Owned, T4: Owned, F1: Owned + Discardable + sink fn() -> T1, F2: Owned + Discardable + sink fn() -> T2, F3: Owned + Discardable + sink fn() -> T3, F4: Owned + Discardable + sink fn() -> T4](sink policy: Policy, sink f1: F1, sink f2: F2, sink f3: F3, sink f4: F4) -> (T1, T2, T3, T4) {
    join4_in(mem.system(), policy, f1, f2, f3, f4)
}

test "join4 runs sequentially and on threads" {
    let (s1, _, _, s4) = join4(Policy.Sequential, sink [] || UInt64(1), sink [] || UInt64(2), sink [] || UInt64(3), sink [] || UInt64(4))
    testing.assert_eq(s1, 1, "s1 wrong")?
    testing.assert_eq(s4, 4, "s4 wrong")?

    let (t1, _, _, t4) = join4(Policy.Threads(4), sink [] || UInt64(10), sink [] || UInt64(20), sink [] || UInt64(30), sink [] || UInt64(40))
    testing.assert_eq(t1, 10, "t1 wrong")?
    testing.assert_eq(t4, 40, "t4 wrong")?
}

test "join4 runs no more closures at once than its bound" {
    let started = time.Instant.now()
    let (a, _, _, d) = join4(Policy.Threads(3), sink [] || napping(1), sink [] || napping(2), sink [] || napping(3), sink [] || napping(4))
    let took = started.elapsed().nanoseconds()
    testing.assert_eq((a, d), (UInt64(1), UInt64(4)), "the results came back out of order")?
    testing.assert(took >= 200000000, "four closures ran at once under a bound of three")?
}

// Join as `join4` does, taking the bytes each started job is kept in from
// `allocator`. Under `.Sequential`, or `.Threads(1)`, nothing is allocated.
pub fn join4_in[T1: Owned, T2: Owned, T3: Owned, T4: Owned, F1: Owned + Discardable + sink fn() -> T1, F2: Owned + Discardable + sink fn() -> T2, F3: Owned + Discardable + sink fn() -> T3, F4: Owned + Discardable + sink fn() -> T4, A: Allocator](allocator: A, sink policy: Policy, sink f1: F1, sink f2: F2, sink f3: F3, sink f4: F4) -> (T1, T2, T3, T4) {
    match policy {
        Sequential => (f1(), f2(), f3(), f4()),
        Threads(max) => {
            if max == 0 {
                panic("task.join4: policy task limit cannot be 0")
            }
            if max == 1 {
                return (f1(), f2(), f3(), f4())
            }
            let body1 = sink [sink f1] |sink me: Chan[Send[T1, End]]| {
                me.send(f1()).close()
            }
            let h1 = start_in(allocator, body1, default_stack_bytes).unwrap()
            if max == 2 {
                let r2 = f2()
                let r3 = f3()
                let r4 = f4()
                let (r1, done1) = h1.recv()
                done1.close()
                return (r1, r2, r3, r4)
            }
            let body2 = sink [sink f2] |sink me: Chan[Send[T2, End]]| {
                me.send(f2()).close()
            }
            let h2 = start_in(allocator, body2, default_stack_bytes).unwrap()
            if max == 3 {
                let r3 = f3()
                let r4 = f4()
                let (r1, done1) = h1.recv()
                done1.close()
                let (r2, done2) = h2.recv()
                done2.close()
                return (r1, r2, r3, r4)
            }
            let body3 = sink [sink f3] |sink me: Chan[Send[T3, End]]| {
                me.send(f3()).close()
            }
            let h3 = start_in(allocator, body3, default_stack_bytes).unwrap()
            let r4 = f4()
            let (r1, done1) = h1.recv()
            done1.close()
            let (r2, done2) = h2.recv()
            done2.close()
            let (r3, done3) = h3.recv()
            done3.close()
            (r1, r2, r3, r4)
        },
    }
}

test "join4_in takes each task from its allocator" {
    let log = testing.TestAllocator.open(mem.system()).unwrap()
    let results = join4_in(log.handle(), Policy.Threads(4), sink [] || UInt64(3), sink [] || UInt64(4), sink [] || UInt64(5), sink [] || UInt64(6))
    let attempts = log.attempts()
    let settled = log.all_disposed()
    log.release()
    testing.assert_eq(results, (UInt64(3), UInt64(4), UInt64(5), UInt64(6)), "the results came back out of order")?
    testing.assert_eq(attempts, 3, "a started job's bytes did not come from the allocator")?
    testing.assert(settled, "joining kept a job's bytes")?
}

test "join4_in allocates nothing in sequence" {
    let log = testing.TestAllocator.open(mem.system()).unwrap()
    let results = join4_in(log.handle(), Policy.Sequential, sink [] || UInt64(3), sink [] || UInt64(4), sink [] || UInt64(5), sink [] || UInt64(6))
    let attempts = log.attempts()
    log.release()
    testing.assert_eq(results, (UInt64(3), UInt64(4), UInt64(5), UInt64(6)), "the results came back out of order")?
    testing.assert_eq(attempts, 0, "a sequential join allocated")?
}

// A worker's side of its session with the map that started it, after it has
// answered the results of the chunk it started with: it is offered a chunk of
// the items `I` yields and answers their results, and again, until it is told
// to stop. The protocol names the source rather than its item
// type, so the map's own types name no item type through a projection.
struct Assigned[phantom I, phantom R] {}

// The map's side of a worker's session: it chooses to hand the worker a
// chunk and receive its results, or to stop it.
struct Assigning[phantom I, phantom R] {}

impl[I: Iterator, R] Protocol for Assigned[I, R] {
    type Dual = Assigning[I, R]
    type Step = Offer[Recv[mem.Vec[I.Item, mem.SystemAllocator], Send[mem.Vec[R, mem.SystemAllocator], Assigned[I, R]]], End]
}

impl[I: Iterator, R] Protocol for Assigning[I, R] {
    type Dual = Assigned[I, R]
    type Step = Choose[Send[mem.Vec[I.Item, mem.SystemAllocator], Recv[mem.Vec[R, mem.SystemAllocator], Assigning[I, R]]], End]
}

// A chunk's place in a lazy map: a worker still maps it, or its results are
// back and wait to be yielded, in the order of its items.
enum Ahead[R] {
    Running,
    Done(mem.Vec[R, mem.SystemAllocator]),
}

// A worker mapping a chunk: its end of the session, waiting for the results,
// and the chunk's number, counted from the first chunk handed out.
struct Busy[I: Iterator, R, A: Allocator] {
    worker: Chan[Recv[mem.Vec[R, mem.SystemAllocator], Assigning[I, R]], A],
    chunk: UInt64,
}

// A LazyMap applies `transform` to the items of `source` on at most
// `running_at_most` worker tasks and yields the results in the items' order,
// or, when `order` is `.Completion`, in the order their chunks finish.
// A worker is started only when a chunk of items is ready for it and no
// started worker is free, and it holds that chunk from the start, so its
// first chunk costs no handoff; it then maps chunk after chunk until the map
// finishes, so a map starts at most `running_at_most` tasks however many
// items it maps. Items are pulled only while fewer than `ahead_at_most`
// pulled items wait to be yielded, and a free worker takes the next chunk at
// once, so one slow item holds up only the chunk it is in.
//
// A chunk is one item when the source's length is unknown. When it is known,
// each worker's first chunk is `first_chunk` items, its share less an
// eighth, and the eighths left go out in chunks of `chunk` items, an eighth
// of a share, to whichever worker finishes first.
//
// `places` keeps a place for every chunk handed out and not yet yielded, and
// `head` the results of the chunk being yielded. In input order the chunk
// handed out `n`th has its place at `n % places.length()` from when it is
// handed out; in completion order the chunk that finishes `n`th, counted by
// `finished`, takes its place at `n % places.length()` when its results come
// back, so the places are a queue of finished chunks. `busy` holds a worker
// for each chunk being mapped and `idle` the workers waiting for one, `free`
// the busy entries not in use, taken and given back from its end, and
// `stopping` the workers told to stop, from when the source is spent until
// `finish` joins them; each has room for `running_at_most`. A runtime wait set, `set`, watches every busy
// worker from when it takes a chunk until it answers, and `waiting` names the
// busy entry each of the set's slots watches, so handing out a chunk and waiting
// for an answer each cost the same however many workers there are. The set
// watches only session endpoints, so when the map moves to a task on another
// Io the set moves with it the next time it is used. All of these are
// reserved before the first worker starts. `visits` counts the busy entries
// handing out and waiting have looked at: one each per chunk. With
// `running_at_most` 0 every item is mapped on the caller, when it is asked
// for, and nothing is allocated.
//
// It holds tasks and results, and a drop neither joins a task nor settles a
// result, so it is linear: `release()` joins every worker and releases what
// they answered, and `stop()` and `finish()` hand results that have no
// `Release` to their owner.
@(opaque, linear)
struct LazyMap[I: Iterator, R, F, A: Allocator = mem.SystemAllocator] {
    source: I,
    transform: F,
    allocator: A,
    running_at_most: UInt64,
    ahead_at_most: UInt64,
    first_chunk: UInt64,
    chunk: UInt64,
    chunks_at_most: UInt64,
    order: Order,
    places: mem.Vec[Option[Ahead[R]], A],
    head: Option[mem.Drain[R, mem.SystemAllocator]],
    busy: mem.Vec[Option[Busy[I, R, A]], A],
    idle: mem.Vec[Chan[Assigning[I, R], A], A],
    stopping: mem.Vec[Chan[End, A], A],
    free: mem.Vec[UInt64, A],
    set: UInt64,
    waiting: mem.Vec[UInt64, A],
    visits: UInt64,
    opened: Bool,
    workers: UInt64,
    running: UInt64,
    handed_out: UInt64,
    taken: UInt64,
    finished: UInt64,
    pulled: UInt64,
    yielded: UInt64,
    pulling: Bool,
}

// What a new worker starts with: its first chunk and the function it maps
// every chunk through. A worker captures this one value, and a worker that
// cannot be prepared hands it back whole.
struct Handout[T, F] {
    chunk: mem.Vec[T, mem.SystemAllocator],
    transform: F,
}

// Take the value `holder` holds and leave it empty. A loop that consumes a
// value and answers its successor keeps it here, since a binding declared
// outside a loop cannot be moved inside it.
fn taken_out[T](inout holder: Option[T]) -> T where carries(holder) {
    let empty: Option[T] = .None
    match mem.exchange(&holder, empty) {
        Some(value) => value,
        None => panic("a holder was emptied twice"),
    }
}

// Put `value` into the empty `holder`.
fn put_back[T](inout holder: Option[T], sink value: T) where retains(holder: value) {
    match mem.exchange(&holder, .Some(value)) {
        None => {},
        Some(_) => panic("a holder was filled twice"),
    }
}

// Keep `entry` at `place`, which is empty or holds a chunk still being
// mapped.
fn put_place[R, A: Allocator](inout places: mem.Vec[Option[Ahead[R]], A], place: UInt64, sink entry: Ahead[R]) where retains(places: entry) {
    let empty: Option[Ahead[R]] = .None
    match mem.exchange(&places[place], empty) {
        None => put_back(&places[place], entry),
        Some(Running) => put_back(&places[place], entry),
        Some(Done(_)) => panic("a lazy map wrote over results it had not yielded"),
    }
}

// Map every item of `chunk` through `transform`, in order, into a vector
// from the system allocator.
fn mapped_chunk[T, R, F: fn(sink item: T) -> R](sink chunk: mem.Vec[T, mem.SystemAllocator], transform: F) -> mem.Vec[R, mem.SystemAllocator] where carries(chunk, transform) {
    var results: mem.Vec[R, mem.SystemAllocator] = mem.Vec.new()
    &results.reserve(chunk.length()).unwrap()
    var items = chunk.drain()
    for item in &items {
        &results.push(transform(item)).unwrap()
    }
    items.finish().unwrap()
    results
}

// What a worker task runs: map each chunk it is handed through `transform`
// and answer the results, until it is told to stop. A payload is `Owned`,
// so the chunks and results move in vectors from the system allocator.
fn work[I: Iterator, R: Owned, F: fn(sink item: I.Item) -> R](sink session: Chan[Assigned[I, R]], transform: F) where I.Item: Owned {
    var next: Option[Chan[Assigned[I, R]]] = .Some(session)
    loop {
        let current = taken_out(&next)
        match current.enter().offer() {
            Left(handed) => {
                let (chunk, answering) = handed.recv()
                put_back(&next, answering.send(mapped_chunk(chunk, transform)))
            },
            Right(done) => {
                done.close()
                break
            },
        }
    }
    match next {
        None => {},
        Some(_) => panic("a worker kept its session after it stopped"),
    }
}

// Build a lazy map that runs at most `running_at_most` workers and keeps at
// most `ahead_at_most` pulled items waiting to be yielded. `left` is how many
// items the source holds, or 0 when that is unknown, and `order` when each
// result is yielded. A bound below 2 maps every item on the caller, as
// `.Threads(1)` does everywhere.
fn lazy_window[I: Iterator, R: Owned, F: Owned + Copyable + Shareable + fn(sink item: I.Item) -> R, A: Allocator](allocator: A, sink source: I, sink transform: F, running_at_most: UInt64, ahead_at_most: UInt64, left: UInt64, order: Order) -> LazyMap[I, R, F, A] where
    carries(allocator, source, transform),
    I.Item: Owned
{
    let running = if running_at_most < 2 {
        UInt64(0)
    } else {
        running_at_most
    }
    // A map of known length hands each worker a first chunk of its share
    // less an eighth, and the eighths that are left in chunks of an eighth
    // of a share, to whichever worker finishes first. Uniform items then cost
    // one handoff more a worker than equal shares would, and a slow item
    // holds up at most the rest of its own first chunk.
    let tail = if left == 0 || running == 0 {
        UInt64(1)
    } else {
        (left + 8 * running - 1) / (8 * running)
    }
    let first_chunk = if left == 0 || running == 0 || left / running <= tail {
        UInt64(1)
    } else {
        left / running - tail
    }
    // Every chunk holds at least one pulled item, so the window never holds
    // more chunks than items; a source of known length never holds more
    // chunks than its length gives.
    let chunks_at_most = if left == 0 {
        ahead_at_most
    } else {
        let first_items = if first_chunk * running > left {
            left
        } else {
            first_chunk * running
        }
        (first_items + first_chunk - 1) / first_chunk + (left - first_items + tail - 1) / tail
    }
    .{
        source,
        transform,
        allocator = copy(allocator),
        running_at_most = running,
        ahead_at_most,
        first_chunk,
        chunk = tail,
        chunks_at_most = if chunks_at_most == 0 {
            UInt64(1)
        } else {
            chunks_at_most
        },
        order,
        places = mem.Vec.new_in(allocator),
        head = .None,
        busy = mem.Vec.new_in(allocator),
        idle = mem.Vec.new_in(allocator),
        stopping = mem.Vec.new_in(allocator),
        free = mem.Vec.new_in(allocator),
        set = 0,
        waiting = mem.Vec.new_in(allocator),
        visits = 0,
        opened = false,
        workers = 0,
        running = 0,
        handed_out = 0,
        taken = 0,
        finished = 0,
        pulled = 0,
        yielded = 0,
        pulling = true,
    }
}

impl[I: Iterator, R: Owned, F: Owned + Copyable + Shareable + fn(sink item: I.Item) -> R, A: Allocator] LazyMap[I, R, F, A]
where I.Item: Owned {
    // Reserve the places, the room for the workers and the names of the
    // wait set's slots, and open the wait set, before the first worker
    // starts. Where they cannot be had, every item is mapped on the caller
    // instead, so the map yields the same results.
    fn open(inout self: Self) {
        self.opened = true
        let reserved = &self.places.reserve(self.chunks_at_most).is_ok() && &self.busy.reserve(self.running_at_most).is_ok() && &self.idle.reserve(self.running_at_most).is_ok() && &self.stopping.reserve(self.running_at_most).is_ok() && &self.free.reserve(self.running_at_most).is_ok() && &self.waiting.reserve(self.running_at_most).is_ok()
        if !reserved {
            self.running_at_most = 0
            return
        }
        // The reservations above hold every place, so these pushes allocate
        // nothing and cannot fail. The free entries are taken from the end,
        // so the first busy worker takes entry 0.
        for _ in 0..self.chunks_at_most {
            let empty: Option[Ahead[R]] = .None
            &self.places.push(empty).unwrap()
        }
        for at in 0..self.running_at_most {
            let free: Option[Busy[I, R, A]] = .None
            &self.busy.push(free).unwrap()
            &self.free.push(self.running_at_most - 1 - at).unwrap()
        }
        // The set keeps every busy worker registered from when it takes a
        // chunk until it answers, so a wait costs the same however many
        // workers there are. Where the system refuses it, the map waits for
        // the worker mapping the next chunk instead.
        self.set = linea_waitset_open()
    }

    // Pull chunks and hand them to workers while a worker may take one: a
    // free worker waits, or fewer than `running_at_most` have started, and
    // the window has room. Each helper below consumes the map and answers
    // it: a worker's session carries the map's allocator, so it is stored
    // into a map that is rebuilt rather than written through a borrowed one.
    fn filled(sink self: Self) -> Self where carries(self) {
        var holder: Option[Self] = .Some(self)
        loop {
            var me = taken_out(&holder)
            let may_start = me.idle.length() > 0 || me.workers < me.running_at_most
            let room = me.pulled - me.yielded < me.ahead_at_most && me.handed_out - me.taken < me.chunks_at_most
            if !(me.pulling && may_start && room) {
                put_back(&holder, me)
                break
            }
            let space = me.ahead_at_most - (me.pulled - me.yielded)
            let wanted = if me.handed_out < me.running_at_most {
                me.first_chunk
            } else {
                me.chunk
            }
            let size = if wanted > space {
                space
            } else {
                wanted
            }
            var chunk: mem.Vec[I.Item, mem.SystemAllocator] = mem.Vec.new()
            &chunk.reserve(size).unwrap()
            for _ in 0..size {
                match &me.source.next() {
                    Some(item) => &chunk.push(item).unwrap(),
                    None => {
                        me.pulling = false
                        break
                    },
                }
            }
            if chunk.length() == 0 {
                chunk.finish().unwrap()
                put_back(&holder, me)
                break
            }
            let running_before = me.running
            let advanced = me.handed(chunk)
            // A chunk no worker could take was mapped on the caller; the
            // caller pulls nothing more until the next result is asked for,
            // so refused tasks never make the map compute ahead.
            let ran_here = advanced.running == running_before
            put_back(&holder, advanced)
            if ran_here {
                break
            }
        }
        // Once the source is spent, whether it ran out between chunks or
        // partway through one, no free worker will be handed another.
        match holder {
            Some(rest) => if rest.pulling {
                rest
            } else {
                rest.idle_stopped()
            },
            None => panic("a lazy map was lost while it pulled"),
        }
    }

    // Tell every free worker to stop once the source is spent, so each ends
    // while the busy ones finish their chunks rather than when the map is
    // finished. `stopping` has room for every worker.
    fn idle_stopped(sink self: Self) -> Self where carries(self) {
        var me = self
        loop {
            let worker = &me.idle.pop() else {
                break
            }
            &me.stopping.push(worker.enter().choose_right()).unwrap()
        }
        me
    }

    // Give `chunk` to a free worker, or start a new one that holds it from
    // the start, so a worker's first chunk costs no handoff. A worker that
    // cannot be prepared, because its bytes or its stack are refused, leaves
    // the chunk to the caller, which maps it at once and keeps the results in
    // its place.
    fn handed(sink self: Self, sink chunk: mem.Vec[I.Item, mem.SystemAllocator]) -> Self where carries(self, chunk) {
        var me = self
        let number = me.handed_out
        let place = number % me.chunks_at_most
        me.handed_out += 1
        me.pulled += chunk.length()
        let busy: Option[Chan[Recv[mem.Vec[R, mem.SystemAllocator], Assigning[I, R]], A]] = if me.idle.length() > 0 {
            match &me.idle.pop() {
                Some(worker) => .Some(worker.enter().choose_left().send(chunk)),
                None => panic("a lazy map lost a free worker"),
            }
        } else {
            let handout: Handout[I.Item, F] = .{ chunk, transform = copy(me.transform) }
            let body = sink [sink handout] |sink end: Chan[Send[mem.Vec[R, mem.SystemAllocator], Assigned[I, R]]]| {
                let Handout { chunk: first, transform } = handout
                let answered = end.send(mapped_chunk(first, transform))
                work(answered, transform)
            }
            match prepare_in(me.allocator, body, default_stack_bytes) {
                Ok(slot) => {
                    me.workers += 1
                    .Some(slot.start().detach_body())
                },
                Err(failure) => {
                    let Unstarted { body, reason: _ } = failure
                    let { handout } = body.into_captures()
                    let Handout { chunk: first, transform: _ } = handout
                    let results = mapped_chunk(first, me.transform)
                    let at = me.finished_place(number)
                    me.finished += 1
                    put_place(&me.places, at, .Done(results))
                    .None
                },
            }
        }
        match busy {
            Some(waiting) => {
                let spot = match &me.free.pop() {
                    Some(spot) => spot,
                    None => panic("a lazy map started more workers than it has room for"),
                }
                me.visits += 1
                if me.set != 0 {
                    linea_waitset_rehome(me.set)
                    let watched = linea_waitset_reserve(me.set) / slot_shift
                    linea_waitset_received(me.set, watched, waiting.number())
                    // The set numbers a slot below `running_at_most` while it
                    // reuses its slots, and a higher one each time it retires
                    // a slot whose generation would wrap, after four billion
                    // reuses; the names grow to cover it.
                    while me.waiting.length() <= watched {
                        match &me.waiting.push(0) {
                            Ok(_) => {},
                            Err(_) => panic("the names of a lazy map's wait set slots could not grow"),
                        }
                    }
                    let _free = mem.exchange(&me.waiting[watched], spot)
                }
                let entry: Busy[I, R, A] = .{ worker = waiting, chunk = number }
                put_back(&me.busy[spot], entry)
                me.running += 1
                if me.order == Order.Input {
                    put_place(&me.places, place, .Running)
                }
            },
            None => {},
        }
        me
    }

    // Wait for whichever busy worker answers first, keep its results in
    // their place, and keep the worker free for the next chunk. The wait set
    // answers the slot the worker was registered in, and `waiting` names its
    // busy entry. Without a set, the map waits for the worker mapping the
    // next chunk to be yielded in input order, and for the worker mapping the
    // earliest chunk handed out in completion order.
    fn collected_one(sink self: Self) -> Self where carries(self) {
        var me = self
        var spot = UInt64(0)
        if me.set != 0 {
            // The map may have moved to a task on another Io since it last
            // waited; the set follows it there.
            linea_waitset_rehome(me.set)
            let watched = linea_waitset_next(me.set)
            if watched < 0 {
                panic("a lazy map waited with no worker busy")
            }
            spot = mem.exchange(&me.waiting[UInt64(watched)], 0)
            me.visits += 1
        } else {
            var found = false
            var earliest = UInt64(0)
            for at in 0..me.busy.length() {
                me.visits += 1
                let empty: Option[Busy[I, R, A]] = .None
                match mem.exchange(&me.busy[at], empty) {
                    None => {},
                    Some(entry) => {
                        let wanted = match me.order {
                            Input => entry.chunk == me.taken,
                            Completion => !found || entry.chunk < earliest,
                        }
                        if wanted {
                            spot = at
                            earliest = entry.chunk
                            found = true
                        }
                        put_back(&me.busy[at], entry)
                    },
                }
                if found && me.order == Order.Input {
                    break
                }
            }
            if !found {
                panic("a lazy map waited for a chunk no worker holds")
            }
        }
        let empty: Option[Busy[I, R, A]] = .None
        let Busy { worker, chunk } = match mem.exchange(&me.busy[spot], empty) {
            Some(entry) => entry,
            None => panic("a lazy map lost a busy worker"),
        }
        let (results, free) = worker.recv()
        // Once nothing is left to pull, the worker is told to stop at once.
        if me.pulling {
            &me.idle.push(free).unwrap()
        } else {
            &me.stopping.push(free.enter().choose_right()).unwrap()
        }
        &me.free.push(spot).unwrap()
        me.running -= 1
        let at = me.finished_place(chunk)
        me.finished += 1
        put_place(&me.places, at, .Done(results))
        me
    }

    // The place the results of `chunk`, the chunk handed out `chunk`th, are
    // kept in once it is mapped: its own in input order, and the next in the
    // queue of finished chunks in completion order.
    fn finished_place(self: Self, chunk: UInt64) -> UInt64 {
        match self.order {
            Input => chunk % self.chunks_at_most,
            Completion => self.finished % self.chunks_at_most,
        }
    }

    // Answer the next item's result and the map, waiting for the item's
    // chunk when a worker still maps it and handing out the chunks the freed
    // capacity allows.
    fn advanced(sink self: Self) -> (Option[R], Self) where carries(self) {
        var me = self
        if me.running_at_most > 0 && !me.opened && me.pulling {
            &me.open()
        }
        if me.running_at_most == 0 {
            if !me.pulling {
                return (.None, me)
            }
            let result: Option[R] = match &me.source.next() {
                Some(item) => .Some((me.transform)(item)),
                None => {
                    me.pulling = false
                    .None
                },
            }
            return (result, me)
        }
        var holder: Option[Self] = .Some(me.filled())
        var answer: Option[R] = .None
        loop {
            var current = taken_out(&holder)
            let from_head: Option[R] = match mem.exchange(&current.head, .None) {
                None => .None,
                Some(draining) => {
                    var results = draining
                    match &results.next() {
                        Some(result) => {
                            put_back(&current.head, results)
                            .Some(result)
                        },
                        None => {
                            match results.finish() {
                                Ok(_) => {},
                                Err(_) => panic("a lazy map's results were not empty"),
                            }
                            .None
                        },
                    }
                },
            }
            match from_head {
                Some(result) => {
                    current.yielded += 1
                    put_back(&answer, result)
                    put_back(&holder, current.filled())
                    break
                },
                None => {},
            }
            if current.handed_out == current.taken {
                put_back(&holder, current)
                break
            }
            let place = current.taken % current.chunks_at_most
            let empty: Option[Ahead[R]] = .None
            match mem.exchange(&current.places[place], empty) {
                Some(Done(results)) => {
                    current.taken += 1
                    put_back(&current.head, results.drain())
                    put_back(&holder, current)
                },
                Some(Running) => {
                    put_back(&current.places[place], .Running)
                    // The worker that answered is free again, so it takes
                    // the next chunk before the head is waited for again.
                    put_back(&holder, current.collected_one().filled())
                },
                // In completion order an empty place means no chunk has
                // finished since the last was yielded, so the map waits for
                // whichever finishes first.
                None => if current.order == Order.Completion {
                    put_back(&holder, current.collected_one().filled())
                } else {
                    panic("a lazy map lost the place of a chunk it handed out")
                },
            }
        }
        match holder {
            Some(rest) => (answer, rest),
            None => panic("a lazy map was lost while it waited"),
        }
    }

    // Move every result into `out` in the items' order, handing out chunks
    // and waiting for workers as needed, until the source has given every
    // item and every result has moved. `map` and `all` collect through this,
    // so a result moves once and the map itself once per chunk.
    fn drained_into[B: Allocator](sink self: Self, inout out: mem.Vec[R, B]) -> Self where carries(self) {
        var me = self
        if me.running_at_most > 0 && !me.opened && me.pulling {
            &me.open()
        }
        if me.running_at_most == 0 {
            loop {
                match &me.source.next() {
                    Some(item) => &out.push((me.transform)(item)).unwrap(),
                    None => break,
                }
            }
            me.pulling = false
            return me
        }
        var holder: Option[Self] = .Some(me.filled())
        loop {
            var current = taken_out(&holder)
            loop {
                if current.handed_out == current.taken {
                    break
                }
                let place = current.taken % current.chunks_at_most
                let empty: Option[Ahead[R]] = .None
                match mem.exchange(&current.places[place], empty) {
                    Some(Done(results)) => {
                        current.taken += 1
                        current.yielded += results.length()
                        var moving = results.drain()
                        for result in &moving {
                            &out.push(result).unwrap()
                        }
                        moving.finish().unwrap()
                    },
                    Some(Running) => {
                        put_back(&current.places[place], .Running)
                        break
                    },
                    None => if current.order == Order.Completion {
                        break
                    } else {
                        panic("a lazy map lost the place of a chunk it handed out")
                    },
                }
            }
            if current.running == 0 {
                if !current.pulling && current.handed_out == current.taken {
                    put_back(&holder, current)
                    break
                }
                put_back(&holder, current.filled())
            } else {
                put_back(&holder, current.collected_one().filled())
            }
        }
        match holder {
            Some(rest) => rest,
            None => panic("a lazy map was lost while it collected"),
        }
    }

    // Pull no more items. The chunks already handed out are still mapped,
    // and walking the map yields their results in the map's order and then
    // ends, so a result that has no `Release` can be taken before `finish`.
    pub fn stop(inout self: Self) {
        self.pulling = false
    }

    test "a stopped map yields only what it started" {
        let log = testing.TestAllocator.open(mem.system()).unwrap()
        var mapped = lazy_map_in(log.handle(), Policy.Threads(2), UInt64(1)..=100, |sink n| n * 10)
        let first = &mapped.next()
        &mapped.stop()
        var rest = UInt64(0)
        var in_order = true
        for result in &mapped {
            rest += 1
            in_order = in_order && result == 10 * (rest + 1)
        }
        let source = match mapped.finish() {
            Ok(source) => source,
            Err(still) => {
                still.release()
                log.release()
                return testing.assert(false, "a walked stopped map still held results")
            },
        }
        let settled = log.all_disposed()
        let attempts = log.attempts()
        log.release()
        var resumed = source
        let next_item = match &resumed.next() {
            Some(n) => n,
            None => 0,
        }
        testing.assert_eq(first, Option.Some(UInt64(10)), "the first result was wrong")?
        testing.assert(in_order, "a stopped map yielded out of order")?
        testing.assert(rest <= 4, "a stopped map started more than its window holds")?
        testing.assert_eq(next_item, rest + 2, "the source did not resume after the items the map pulled")?
        testing.assert(attempts <= 6 + 2, "a stopped map started more workers than its bound")?
        testing.assert(settled, "a finished map kept an allocation")?
    }

    // Consume the map, stopping every worker it started, and answer its
    // source, as far as it advanced, once every item the map pulled has
    // been yielded. A map with results still to yield comes back as `Err`:
    // `stop()` it, walk it, and finish it again.
    pub fn finish(sink self: Self) -> Result[I, Self] where carries(.Ok: self), carries(.Err: self) {
        if self.pulled != self.yielded {
            return .Err(self)
        }
        let LazyMap { source, transform: _, allocator: _, running_at_most: _, ahead_at_most: _, first_chunk: _, chunk: _, chunks_at_most: _, order: _, places, head, busy, idle, stopping, free: free_spots, set, waiting, visits: _, opened: _, workers: _, running: _, handed_out: _, taken: _, finished: _, pulled: _, yielded: _, pulling: _ } = self
        match head {
            None => {},
            Some(results) => match results.finish() {
                Ok(_) => {},
                Err(_) => panic("a lazy map finished holding a result"),
            },
        }
        // Every worker is told to stop before the first is joined, so they
        // end side by side rather than each waiting for the join before it.
        // `stopping` has room for every worker, so the pushes cannot fail.
        var free = idle
        var told = stopping
        loop {
            let worker = &free.pop() else {
                break
            }
            &told.push(worker.enter().choose_right()).unwrap()
        }
        match free.finish() {
            Ok(_) => {},
            Err(_) => panic("a lazy map kept a worker it stopped"),
        }
        loop {
            let worker = &told.pop() else {
                break
            }
            worker.close()
        }
        match told.finish() {
            Ok(_) => {},
            Err(_) => panic("a lazy map kept a worker it stopped"),
        }
        if set != 0 {
            linea_waitset_rehome(set)
            linea_waitset_close(set)
        }
        var spots = free_spots
        &spots.clear()
        match spots.finish() {
            Ok(_) => {},
            Err(_) => panic("a lazy map's free entries were not empty"),
        }
        var names = waiting
        &names.clear()
        match names.finish() {
            Ok(_) => {},
            Err(_) => panic("a lazy map's wait set names were not empty"),
        }
        var held = busy
        loop {
            let entry = &held.pop() else {
                break
            }
            match entry {
                None => {},
                Some(_) => panic("a lazy map finished with a worker still mapping"),
            }
        }
        match held.finish() {
            Ok(_) => {},
            Err(_) => panic("a lazy map's workers were not empty"),
        }
        var kept = places
        loop {
            let place = &kept.pop() else {
                break
            }
            match place {
                None => {},
                Some(_) => panic("a lazy map finished holding results"),
            }
        }
        match kept.finish() {
            Ok(_) => {},
            Err(_) => panic("a lazy map's places were not empty"),
        }
        .Ok(source)
    }

    test "a map with results to yield does not finish" {
        var mapped = lazy_map(Policy.Threads(2), UInt64(1)..=6, |sink n| n + 1)
        let first = &mapped.next()
        let refused = match mapped.finish() {
            Ok(_) => false,
            Err(still) => {
                still.release()
                true
            },
        }
        testing.assert_eq(first, Option.Some(UInt64(2)), "the first result was wrong")?
        testing.assert(refused, "a map finished with started jobs it had not yielded")?
    }
}

impl[I: Iterator, R: Owned, F: Owned + Copyable + Shareable + fn(sink item: I.Item) -> R, A: Allocator] Iterator for LazyMap[I, R, F, A]
where I.Item: Owned {
    type Item = R

    // Answer the result of the next item, waiting for its worker when it is
    // still mapping it, and hand out the chunks the freed capacity allows.
    fn next(inout self: Self) -> Option[R] where carries(.Some: self) {
        let current = self
        let (result, rest) = current.advanced()
        self = rest
        result
    }
}

impl[I: Iterator + Release, R: Owned + Release, F: Owned + Copyable + Shareable + fn(sink item: I.Item) -> R, A: Allocator] Release for LazyMap[I, R, F, A]
where I.Item: Owned {
    // Pull no more items, wait for every chunk already handed out and
    // release what it answered, release the results still waiting to be
    // yielded, stop every worker, and release the source with the items it
    // has not handed over. Nothing is pulled after the call.
    fn release(sink self: Self) {
        var holder: Option[Self] = .Some(self)
        loop {
            var current = taken_out(&holder)
            current.pulling = false
            match mem.exchange(&current.head, .None) {
                None => {},
                Some(draining) => {
                    var results = draining
                    for result in &results {
                        current.yielded += 1
                        result.release()
                    }
                    match results.finish() {
                        Ok(_) => {},
                        Err(_) => panic("a lazy map's results were not empty"),
                    }
                },
            }
            if current.handed_out == current.taken {
                put_back(&holder, current)
                break
            }
            let place = current.taken % current.chunks_at_most
            let empty: Option[Ahead[R]] = .None
            match mem.exchange(&current.places[place], empty) {
                Some(Done(results)) => {
                    current.taken += 1
                    put_back(&current.head, results.drain())
                    put_back(&holder, current)
                },
                Some(Running) => {
                    put_back(&current.places[place], .Running)
                    put_back(&holder, current.collected_one())
                },
                None => if current.order == Order.Completion {
                    put_back(&holder, current.collected_one())
                } else {
                    panic("a lazy map lost the place of a chunk it handed out")
                },
            }
        }
        let ending = match holder {
            Some(rest) => rest,
            None => panic("a lazy map was lost while it was released"),
        }
        match ending.finish() {
            Ok(source) => source.release(),
            Err(_) => panic("a released lazy map still held results"),
        }
    }
}

// The window a lazy map keeps ahead of its caller for a bound of `max` jobs:
// `max` running and `max` more answered and waiting for an earlier item.
fn ahead_of(max: UInt64) -> UInt64 {
    if max > 9223372036854775807 {
        max
    } else {
        max * 2
    }
}

// Apply `f` to the items of `items` on demand, under `policy`, and answer a
// linear iterator over the results. Building it pulls nothing and starts
// nothing. Under `.Threads(max)` it maps the items on at most `max` worker
// tasks started on the current Io, one item at a time, and pulls an item only
// when a worker may take it: each time a worker finishes its result is kept
// and the worker takes the next item, while at most `2 * max` pulled items,
// being mapped or answered, wait to be yielded. With `order: .Input`, the
// default, results are yielded in the items' order; with
// `order: .Completion` each is yielded as soon as its job finishes, and a
// caller that needs to know which item a result came from has `f` return
// it. `.Sequential` and `.Threads(1)` call `f` on the caller, one item for
// each `next`, and start no task, so both orders are the items' order there.
// A `max` of 0 stops the program. The workers' bytes come from the system
// allocator; `lazy_map_in` says what a refused allocation does.
pub fn lazy_map[S: Sequence, R: Owned, F: Owned + Copyable + Shareable + fn(sink item: S.Iter.Item) -> R](sink policy: Policy, sink items: S, sink f: F, order: Order = .Input) -> LazyMap[S.Iter, R, F, mem.SystemAllocator] where
    carries(items, f),
    S.Iter.Item: Owned
{
    lazy_map_in(mem.system(), policy, items, f, order: order)
}

test "a lazy_map yields every result in input order" {
    defer var squares = lazy_map(Policy.Threads(3), UInt64(1)..=20, |sink n| n * n)
    var expected = UInt64(1)
    for square in &squares {
        testing.assert_eq(square, expected * expected, "a result came back out of order")?
        expected += 1
    }
    testing.assert_eq(expected, 21, "a lazy map lost a result")?
}

// Sum what a lazy map yields after `take` results, release it, and answer the
// sum with how many allocations the map attempted and whether it disposed of
// every one.
fn lazy_test_take(take: UInt64) -> (UInt64, UInt64, Bool) {
    let log = testing.TestAllocator.open(mem.system()).unwrap()
    var mapped = lazy_map_in(log.handle(), Policy.Threads(3), UInt64(1)..=1000, |sink n| n)
    var sum = UInt64(0)
    for _ in 0..take {
        match &mapped.next() {
            Some(n) => {
                sum += n
            },
            None => {},
        }
    }
    mapped.release()
    let attempts = log.attempts()
    let settled = log.all_disposed()
    log.release()
    (sum, attempts, settled)
}

// Walk a lazy map of `count` napping jobs, two at once, and answer the most
// bytes its allocations held at one time, how many allocations it had made
// once the first result came back, the sum of its results, and whether it
// disposed of every allocation.
fn lazy_test_peak(count: UInt64) -> (UInt64, UInt64, UInt64, Bool) {
    let log = testing.TestAllocator.open(mem.system()).unwrap()
    var mapped = lazy_map_in(log.handle(), Policy.Threads(2), UInt64(1)..=count, |sink n| napping(n))
    var total = UInt64(0)
    var after_first = UInt64(0)
    for n in &mapped {
        if total == 0 {
            after_first = log.attempts()
        }
        total += n
    }
    mapped.release()
    let peak = log.peak_bytes()
    let settled = log.all_disposed()
    log.release()
    (peak, after_first, total, settled)
}

// A receipt is linear and has no `Release`, so its owner settles each one by
// taking it apart.
@linear
struct LazyReceipt {
    number: UInt64,
}

// Walk a lazy map whose allocation numbered `refused` is refused, and answer
// the sum of its results with whether every allocation was disposed of.
fn lazy_test_refusing(refused: UInt64) -> (UInt64, Bool) {
    let log = testing.TestAllocator.open(mem.system(), fail_at: .Some(refused)).unwrap()
    var mapped = lazy_map_in(log.handle(), Policy.Threads(2), UInt64(1)..=5, |sink n| n * n)
    var sum = UInt64(0)
    for n in &mapped {
        sum += n
    }
    mapped.release()
    let settled = log.all_disposed()
    log.release()
    (sum, settled)
}

// The tests of how promptly a map refills a worker make items wait for each
// other instead of sleeping and hoping the others ran first. Each item is an
// errand: one end of a session with a relay task, which tells the item its
// number once the items it waits for have run, and then hears from the item
// that it ran. An owning task counts the errands that ran. A function a map
// moves to its workers must be `Owned`, so it cannot hold a client of that
// count; an errand's relay holds the client, and the errand only its end.

// Wait until the count `client` reaches is at least `count`, looking every
// millisecond for at most a minute, and answer whether it was. The minute
// stands in for forever: an item that waits for work its map never starts
// fails its test instead of hanging it.
fn count_reached(client: Client[UInt64], count: UInt64) -> Bool {
    let started = time.Instant.now()
    loop {
        if client.call(|inout ran: UInt64| ran) >= count {
            return true
        }
        if started.elapsed().nanoseconds() >= 60000000000 {
            return false
        }
        time.sleep(time.Duration.from_milliseconds(1))
    }
}

// Hand `run` one errand for each entry of `waits`, in order, and answer what
// it answers once every relay has finished. The relay of errand `i` waits
// until `waits[i]` errands have run, then sends its number, `i + 1`, or 0
// when the minute ran out first, and counts the errand once it replies.
fn with_errands[R: Owned, F: sink fn(sink errands: mem.Vec[Chan[Recv[UInt64, Send[(), End]]], mem.SystemAllocator]) -> R](waits: mem.Slice[UInt64], sink run: F) -> R {
    let counter = own(UInt64(0)).unwrap()
    let answer = relayed(counter.client(), waits, mem.Vec.new(), run)
    let _ran = counter.close()
    answer
}

// Start the relay of the errand after the ones in `errands`, then the rest,
// and run `run` on them all; join each relay once `run` has answered. Each
// call keeps its own relay's handle, so the handles need no vector of a type
// the relay's body cannot be named in.
fn relayed[R: Owned, F: sink fn(sink errands: mem.Vec[Chan[Recv[UInt64, Send[(), End]]], mem.SystemAllocator]) -> R](client: Client[UInt64], waits: mem.Slice[UInt64], sink errands: mem.Vec[Chan[Recv[UInt64, Send[(), End]]], mem.SystemAllocator], sink run: F) -> R {
    let index = errands.length()
    if index == waits.length() {
        return run(errands)
    }
    let waits_for = waits[index]
    let relay = prepare(
        sink [sink client = copy(client), sink waits_for, sink index] |sink me: Chan[Send[Chan[Recv[UInt64, Send[(), End]]], End]]| {
            // The errand's task sends its own end over this relay's session
            // to the caller, so the relay keeps the other end.
            let errand = prepare(
                sink [sink me] |sink end: Chan[Recv[UInt64, Send[(), End]]]| {
                    me.send(end).close()
                },
            ).unwrap().start()
            let number = if count_reached(client, waits_for) {
                index + 1
            } else {
                0
            }
            let (_, done) = errand.send(number).recv()
            done.close()
            client.call(|inout ran: UInt64| ran += 1)
        },
    ).unwrap().start()
    let (errand, joined) = relay.recv()
    var more = errands
    &more.push(errand).unwrap()
    let answer = relayed[R, F](client, waits, more, run)
    joined.close()
    answer
}

// Run an errand: wait for its relay's number, tell the relay the errand ran,
// and answer the number.
fn run_errand(sink errand: Chan[Recv[UInt64, Send[(), End]]]) -> UInt64 {
    let (number, reply) = errand.recv()
    reply.send(()).close()
    number
}

test "an errand answers its number once the errands it waits for have run" {
    let numbers = with_errands(
        [UInt64(0), 1].as_slice(),
        sink [] |sink errands| {
            var answered: mem.Vec[UInt64, mem.SystemAllocator] = mem.Vec.new()
            var pending = errands.drain()
            for errand in &pending {
                &answered.push(run_errand(errand)).unwrap()
            }
            pending.finish().unwrap()
            answered
        },
    )
    let in_order = numbers.as_slice() == [UInt64(1), 2].as_slice()
    numbers.release()
    testing.assert(in_order, "an errand answered before the errand it waits for ran")?
}

// Walk a lazy map of `count` items on `max` workers, and answer how many
// busy entries it visited and how many chunks it handed out.
fn lazy_test_visits(count: UInt64, max: UInt64) -> (UInt64, UInt64) {
    var mapped = lazy_map(Policy.Threads(max), UInt64(1)..=count, |sink n| n)
    var total = UInt64(0)
    for n in &mapped {
        total += n
    }
    let counted = (mapped.visits, mapped.handed_out)
    mapped.release()
    if total != count * (count + 1) / 2 {
        panic("a lazy map lost a result")
    }
    counted
}

// Collect a map of `count` items on `max` workers, and answer how many busy
// entries it visited and how many chunks it handed out.
fn map_test_visits(count: UInt64, max: UInt64) -> (UInt64, UInt64) {
    var items: mem.Vec[UInt64, mem.SystemAllocator] = mem.Vec.new()
    for n in 1..=count {
        &items.push(n).unwrap()
    }
    let running = if max > count {
        count
    } else {
        max
    }
    let window = lazy_window(mem.system(), items.drain(), |sink n: UInt64| n, running, count, count, Order.Input)
    var results: mem.Vec[UInt64, mem.SystemAllocator] = mem.Vec.new()
    let walked = window.drained_into(&results)
    let counted = (walked.visits, walked.handed_out)
    match walked.finish() {
        Ok(drained) => drained.finish().unwrap(),
        Err(_) => panic("a collected map still held results"),
    }
    let length = results.length()
    results.release()
    if length != count {
        panic("a collected map lost a result")
    }
    counted
}

// Map lazily as `lazy_map` does, taking the bytes each worker is kept in,
// the places of the pulled items and the room for the workers from
// `allocator`. Nothing is allocated until the first `next`. Where the places
// are refused every item is mapped on the caller, and where a worker's bytes
// are refused the item it would have taken is mapped on the caller, so a
// refusal changes where the work runs and never which results are yielded.
// The items handed to a worker and the results it answers move between
// tasks in vectors from the system allocator.
pub fn lazy_map_in[S: Sequence, R: Owned, F: Owned + Copyable + Shareable + fn(sink item: S.Iter.Item) -> R, A: Allocator](allocator: A, sink policy: Policy, sink items: S, sink f: F, order: Order = .Input) -> LazyMap[S.Iter, R, F, A] where
    carries(allocator, items, f),
    S.Iter.Item: Owned
{
    let running_at_most = match policy {
        Sequential => UInt64(0),
        Threads(max) => {
            if max == 0 {
                panic("task.lazy_map: policy task limit cannot be 0")
            }
            max
        },
    }
    lazy_window(allocator, items.iterate(), f, running_at_most, ahead_of(running_at_most), 0, order)
}

test "a map visits each worker entry a fixed number of times per chunk" {
    // Handing a chunk out takes a free entry and an answer finds its entry
    // through the wait set, so the entries visited per chunk do not grow
    // with the number of workers.
    for max in [UInt64(2), 64] {
        let (lazy_visits, lazy_chunks) = lazy_test_visits(2000, max)
        testing.assert(lazy_visits <= 2 * lazy_chunks, "a lazy map's work per chunk grew with its workers")?
        let (map_visits, map_chunks) = map_test_visits(2000, max)
        testing.assert(map_visits <= 2 * map_chunks, "a collected map's work per chunk grew with its workers")?
    }
}

test "a slow item fills the window and the places wrap" {
    // Item 1 finishes only once items 2, 3 and 4 have run, so the other
    // worker maps them while item 1 waits, and the window stops pulling with
    // four items waiting; item 5 is pulled once item 1 is yielded. A window
    // that pulled fewer would leave item 1 waiting until its minute ran out.
    let waits = [UInt64(3), 0, 0, 0, 0, 0, 0, 0, 0, 0]
    let (first, after, left) = with_errands(
        waits.as_slice(),
        sink [] |sink errands| {
            var stopped = lazy_map(Policy.Threads(2), errands.drain(), run_errand)
            let first = &stopped.next()
            &stopped.stop()
            var after = UInt64(0)
            for _ in &stopped {
                after += 1
            }
            // The errands the map never pulled run here, so their relays
            // finish.
            var rest = match stopped.finish() {
                Ok(source) => source,
                Err(_) => panic("a walked stopped map still held results"),
            }
            var left = UInt64(0)
            for errand in &rest {
                let _number = run_errand(errand)
                left += 1
            }
            rest.finish().unwrap()
            (first, after, left)
        },
    )
    // A full walk reuses the places the first four items had for items five
    // to ten.
    let (in_order, walked_count) = with_errands(
        waits.as_slice(),
        sink [] |sink errands| {
            var walked = lazy_map(Policy.Threads(2), errands.drain(), run_errand)
            var expected = UInt64(1)
            var in_order = true
            for n in &walked {
                in_order = in_order && n == expected
                expected += 1
            }
            match walked.finish() {
                Ok(drained) => drained.finish().unwrap(),
                Err(_) => panic("a walked map still held results"),
            }
            (in_order, expected - 1)
        },
    )
    testing.assert_eq(first, Option.Some(UInt64(1)), "the slow first item gave up waiting for the three after it")?
    testing.assert_eq(after, UInt64(4), "the window did not fill to twice its bound behind a slow item")?
    testing.assert_eq(left, UInt64(5), "the map pulled past its window")?
    testing.assert(in_order && walked_count == 10, "results came back out of order once the places wrapped")?
}

test "a lazy_map released early settles every job it started" {
    let (none, none_attempts, none_settled) = lazy_test_take(0)
    testing.assert_eq((none, none_attempts), (UInt64(0), UInt64(0)), "a map released before its first result started work")?
    testing.assert(none_settled, "a map released at once kept an allocation")?
    // Six allocations hold the places, the room for the workers, the room
    // for stopping them and the names of the wait set's slots; every other one is a started worker,
    // at most three however many results were taken.
    let (one, one_attempts, one_settled) = lazy_test_take(1)
    testing.assert_eq(one, UInt64(1), "the first result was wrong")?
    testing.assert(one_attempts <= 6 + 3, "a map released after one result started more workers than its bound")?
    testing.assert(one_settled, "a map released after one result kept an allocation")?
    let (some, some_attempts, some_settled) = lazy_test_take(10)
    testing.assert_eq(some, UInt64(55), "the first ten results were wrong")?
    testing.assert(some_attempts <= 6 + 3, "a map released after ten results started more workers than its bound")?
    testing.assert(some_settled, "a map released after ten results kept an allocation")?
}

test "a lazy_map runs no more jobs at once than its bound" {
    let (peak, after_first, total, settled) = lazy_test_peak(12)
    let (two_items, _, _, _) = lazy_test_peak(2)
    testing.assert_eq(total, UInt64(78), "a result was lost")?
    // Six allocations, then one for each worker: two workers map all
    // twelve items, so at most two jobs run at once, and a map of twelve
    // holds no more than a map of two.
    testing.assert(after_first <= 6 + 2, "the map started more workers than its bound")?
    testing.assert(peak <= two_items, "a longer map held more workers than its bound")?
    testing.assert(settled, "a finished map kept an allocation")?
}

test "a sequential lazy_map starts no task and yields the same results" {
    let log = testing.TestAllocator.open(mem.system()).unwrap()
    var sequential = lazy_map_in(log.handle(), Policy.Sequential, UInt64(1)..=8, |sink n| n * 3)
    var threaded = lazy_map_in(log.handle(), Policy.Threads(1), UInt64(1)..=8, |sink n| n * 3)
    var same = true
    var count = UInt64(0)
    for result in &sequential {
        count += 1
        match &threaded.next() {
            Some(other) => {
                same = same && other == result && result == count * 3
            },
            None => {
                same = false
            },
        }
    }
    sequential.release()
    threaded.release()
    let attempts = log.attempts()
    log.release()
    defer var parallel = lazy_map(Policy.Threads(4), UInt64(1)..=8, |sink n| n * 3)
    var position = UInt64(0)
    for result in &parallel {
        position += 1
        same = same && result == position * 3
    }
    testing.assert(same, "the policies yielded different results")?
    testing.assert_eq(count, 8, "a sequential map lost a result")?
    testing.assert_eq(attempts, 0, "a map that runs on the caller allocated")?
}

test "a lazy_map hands linear results to their owner" {
    var receipts = lazy_map(Policy.Threads(2), UInt64(1)..=9, |sink n| LazyReceipt { number = n })
    var seen = UInt64(0)
    for receipt in &receipts {
        let LazyReceipt { number } = receipt
        seen = seen * 10 + number
        if number == 3 {
            break
        }
    }
    &receipts.stop()
    var after = UInt64(0)
    for receipt in &receipts {
        let LazyReceipt { number: _ } = receipt
        after += 1
    }
    match receipts.finish() {
        Ok(_) => {},
        Err(still) => {
            var left = still
            for receipt in &left {
                let LazyReceipt { number: _ } = receipt
            }
            match left.finish() {
                Ok(_) => {},
                Err(_) => panic("a walked stopped map still held receipts"),
            }
            return testing.assert(false, "a walked stopped map did not finish")
        },
    }
    testing.assert_eq(seen, UInt64(123), "the receipts came back out of order")?
    testing.assert(after <= 4, "a stopped map yielded receipts past its window")?
}

test "a lazy_map releases results that own storage" {
    var lists = lazy_map(
        Policy.Threads(2),
        UInt64(1)..=8,
        |sink n| -> mem.Vec[UInt64, mem.SystemAllocator] {
            mem.Vec.filled(n, n).unwrap()
        },
    )
    let first = &lists.next().unwrap()
    let length = first.length()
    first.release()
    lists.release()
    testing.assert_eq(length, 1, "the first list was wrong")?
}

test "a lazy_map keeps every result of a fallible function" {
    defer var checked = lazy_map(
        Policy.Threads(3),
        UInt64(1)..=6,
        |sink n| -> Result[UInt64, UInt64] {
            if n % 2 == 0 {
                .Ok(n * 10)
            } else {
                .Err(n)
            }
        },
    )
    var position = UInt64(0)
    for result in &checked {
        position += 1
        let expected: Result[UInt64, UInt64] = if position % 2 == 0 {
            .Ok(position * 10)
        } else {
            .Err(position)
        }
        testing.assert_eq(result, expected, "a failure dropped or moved another result")?
    }
    testing.assert_eq(position, 6, "a failure ended the map early")?
}

test "a refused allocation moves work to the caller and keeps every result" {
    // The first six allocations are the places, the room for the workers,
    // the room for stopping them and the names of the wait set's slots; the
    // rest are the workers, one each.
    for refused in UInt64(1)..=9 {
        let (sum, settled) = lazy_test_refusing(refused)
        testing.assert_eq(sum, UInt64(55), "a refused allocation changed the results")?
        testing.assert(settled, "a refused allocation left another one undisposed")?
    }
}

// Walk a lazy map in `order` over one errand for each entry of `waits` on two
// workers, and answer the errands' numbers as the digits of one number, in
// the order they were yielded.
fn lazy_test_errand_digits(waits: mem.Slice[UInt64], order: Order) -> UInt64 {
    with_errands(
        waits,
        sink [order] |sink errands| {
            var mapped = lazy_map(Policy.Threads(2), errands.drain(), run_errand, order: order)
            var digits = UInt64(0)
            for n in &mapped {
                digits = digits * 10 + n
            }
            match mapped.finish() {
                Ok(drained) => drained.finish().unwrap(),
                Err(_) => panic("a walked map still held results"),
            }
            digits
        },
    )
}

test "a lazy_map in completion order yields each result as its job finishes" {
    // Item 1 finishes only once the five after it have run, so while item 1
    // waits the other worker maps items 2 to 6, each yielded as it finishes,
    // and item 1 is yielded last. A map that waited for item 1 before
    // yielding the others would leave it waiting until its minute ran out.
    let completed = lazy_test_errand_digits([UInt64(5), 0, 0, 0, 0, 0].as_slice(), Order.Completion)
    // In input order item 1 is yielded first, though it finishes only once
    // the three after it have run.
    let input = lazy_test_errand_digits([UInt64(3), 0, 0, 0, 0, 0].as_slice(), Order.Input)
    testing.assert_eq(completed, UInt64(234561), "the slow job's result was not yielded after the faster ones")?
    testing.assert_eq(input, UInt64(123456), "input order changed")?
}

test "a lazy_map in completion order runs no more jobs at once than its bound" {
    let log = testing.TestAllocator.open(mem.system()).unwrap()
    var mapped = lazy_map_in(log.handle(), Policy.Threads(2), UInt64(1)..=12, |sink n| n, order: .Completion)
    var total = UInt64(0)
    for n in &mapped {
        total += n
    }
    mapped.release()
    let attempts = log.attempts()
    let settled = log.all_disposed()
    log.release()
    testing.assert_eq(total, UInt64(78), "a result was lost")?
    // Six allocations hold the places and the room for the workers; one more
    // for each worker started, at most two.
    testing.assert(attempts <= 6 + 2, "the map started more workers than its bound")?
    testing.assert(settled, "a finished map kept an allocation")?
}

test "a refused allocation leaves a lazy_map in completion order settled" {
    let outer = testing.TestAllocator.open(mem.system()).unwrap()
    let checked = testing.each_allocation_failure(
        outer.handle(),
        |allocator| -> Result[(), testing.Failure] {
            var mapped = lazy_map_in(allocator, Policy.Threads(2), UInt64(1)..=5, |sink n| n * n, order: .Completion)
            var sum = UInt64(0)
            for n in &mapped {
                sum += n
            }
            mapped.release()
            testing.assert_eq(sum, UInt64(55), "a refused allocation changed the results")
        },
        |error| error.is_refusal(),
    )
    let settled = outer.all_disposed()
    outer.release()
    testing.assert(checked.is_ok(), "a refused allocation changed what the map yields")?
    testing.assert(settled, "a refused allocation left another one undisposed")?
}

// Walk a lazy map in completion order of the items 1 to `count` under
// `policy`, and answer the results as the digits of one number, in the
// order they were yielded.
fn lazy_test_digits(sink policy: Policy, count: UInt64) -> UInt64 {
    defer var mapped = lazy_map(policy, UInt64(1)..=count, |sink n| n, order: .Completion)
    var digits = UInt64(0)
    for n in &mapped {
        digits = digits * 10 + n
    }
    digits
}

test "a sequential lazy_map in completion order yields in input order" {
    // On the caller each job finishes before the next starts, so finishing
    // order is input order and nothing is allocated.
    let sequential = lazy_test_digits(Policy.Sequential, 4)
    let one_task = lazy_test_digits(Policy.Threads(1), 4)
    let log = testing.TestAllocator.open(mem.system()).unwrap()
    var mapped = lazy_map_in(log.handle(), Policy.Sequential, UInt64(1)..=8, |sink n| n * 3, order: .Completion)
    var position = UInt64(0)
    var same = true
    for result in &mapped {
        position += 1
        same = same && result == position * 3
    }
    mapped.release()
    let attempts = log.attempts()
    log.release()
    testing.assert_eq(sequential, UInt64(1234), "a sequential map changed the order")?
    testing.assert_eq(one_task, UInt64(1234), "a map on the caller changed the order")?
    testing.assert(same && position == 8, "a sequential map yielded other results")?
    testing.assert_eq(attempts, 0, "a map that runs on the caller allocated")?
}

// Map every item of `items` through a lazy map that runs at most
// `running_at_most` workers and may keep every result ahead, and
// collect the results in the items' order into a vector from `allocator`.
// A result the vector cannot take stops the program.
fn collected[T: Owned, R: Owned, F: Owned + Copyable + Shareable + fn(sink item: T) -> R, A: Allocator, B: Allocator](allocator: A, sink items: mem.Vec[T, B], sink f: F, running_at_most: UInt64) -> mem.Vec[R, A] where carries(allocator) {
    let total = items.length()
    let ahead = if total == 0 {
        UInt64(1)
    } else {
        total
    }
    var results: mem.Vec[R, A] = mem.Vec.new_in(allocator)
    &results.reserve(total).unwrap()
    let running = if running_at_most > total {
        total
    } else {
        running_at_most
    }
    let mapped = lazy_window(allocator, items.drain(), f, running, ahead, total, Order.Input)
    let walked = mapped.drained_into(&results)
    match walked.finish() {
        Ok(drained) => drained.finish().unwrap(),
        Err(_) => panic("a walked map still held results"),
    }
    results
}

// Run every job in `jobs` under `policy` and answer their results in job
// order once all have finished, as `Promise.all` does. Under `.Threads(max)`
// at most `max` worker tasks started on the current Io run the jobs, and a
// worker that finishes takes the next ones at once, as `map` says.
// `.Sequential` and `.Threads(1)` run the jobs in turn on the caller. A `max`
// of 0 stops the program. The results and the workers' bytes come from the
// system allocator; `all_in` names another.
pub fn all[T: Owned, F: Owned + Discardable + fn() -> T](sink policy: Policy, sink jobs: mem.Vec[F, mem.SystemAllocator]) -> mem.Vec[T, mem.SystemAllocator] {
    all_in(mem.system(), policy, jobs)
}

fn job1() -> UInt64 {
    1
}

fn job2() -> UInt64 {
    2
}

fn job3() -> UInt64 {
    3
}

fn job10() -> UInt64 {
    10
}

fn job20() -> UInt64 {
    20
}

fn job30() -> UInt64 {
    30
}

test "all runs sequentially and on threads" {
    var jobs_seq: mem.Vec[fn() -> UInt64, mem.SystemAllocator] = mem.Vec.new()
    &jobs_seq.push(job1).unwrap()
    &jobs_seq.push(job2).unwrap()
    &jobs_seq.push(job3).unwrap()
    var res_seq: mem.Vec[UInt64, mem.SystemAllocator] = all(Policy.Sequential, jobs_seq)
    let seq_len = res_seq.length()
    res_seq.release()
    testing.assert_eq(seq_len, 3, "sequential all length wrong")?

    var jobs_par: mem.Vec[fn() -> UInt64, mem.SystemAllocator] = mem.Vec.new()
    &jobs_par.push(job10).unwrap()
    &jobs_par.push(job20).unwrap()
    &jobs_par.push(job30).unwrap()
    var res_par: mem.Vec[UInt64, mem.SystemAllocator] = all(Policy.Threads(3), jobs_par)
    let par_len = res_par.length()
    res_par.release()
    testing.assert_eq(par_len, 3, "threaded all length wrong")?
}

// Run every job as `all` does, taking the results, the window's places and
// the workers' bytes from `allocator`. Jobs a refused worker would have run
// run on the caller; a result the vector cannot take stops the program.
pub fn all_in[T: Owned, F: Owned + Discardable + fn() -> T, A: Allocator, B: Allocator](allocator: A, sink policy: Policy, sink jobs: mem.Vec[F, B]) -> mem.Vec[T, A] where carries(allocator) {
    let running_at_most = match policy {
        Sequential => UInt64(0),
        Threads(max) => {
            if max == 0 {
                panic("task.all: policy task limit cannot be 0")
            }
            max
        },
    }
    collected(
        allocator,
        jobs,
        |sink job: F| -> T {
            job()
        },
        running_at_most,
    )
}

test "all_in takes its results and tasks from its allocator" {
    let log = testing.TestAllocator.open(mem.system()).unwrap()
    var jobs: mem.Vec[fn() -> UInt64, mem.SystemAllocator] = mem.Vec.new()
    &jobs.push(job10).unwrap()
    &jobs.push(job20).unwrap()
    &jobs.push(job30).unwrap()
    let results: mem.Vec[UInt64, testing.TestHandle[mem.SystemAllocator]] = all_in(log.handle(), Policy.Threads(2), jobs)
    let same = results.as_slice() == [UInt64(10), 20, 30].as_slice()
    let attempts = log.attempts()
    results.release()
    let settled = log.all_disposed()
    log.release()
    testing.assert(same, "the results came back out of order")?
    // The places, the room for two workers, the two workers, and the
    // results.
    testing.assert(attempts >= 6, "a job's bytes did not come from the allocator")?
    testing.assert(settled, "all kept an allocation")?
}

// Apply `f` to every item under `policy` and answer the results in the items'
// order once all have finished. Under `.Threads(max)` at most `max` worker
// tasks started on the current Io map the items, a chunk at a time, and a
// worker that finishes its chunk takes the next at once. Each worker starts
// holding its share of the items less an eighth, and the eighths left go out
// an eighth of a share at a time to whichever worker finishes first, so one
// slow item holds up at most the rest of its first chunk. `.Sequential` and `.Threads(1)` map
// the items in turn on the caller. A `max` of 0 stops the program. `f`
// answering a `Result` gives every item's result, failures included. The
// results and the workers' bytes come from the system allocator; `map_in`
// names another, and `lazy_map` yields the results one at a time instead of
// collecting them.
pub fn map[T: Owned, R: Owned, F: Owned + Copyable + Shareable + fn(sink item: T) -> R](sink policy: Policy, sink items: mem.Vec[T, mem.SystemAllocator], sink f: F) -> mem.Vec[R, mem.SystemAllocator] {
    map_in(mem.system(), policy, items, f)
}

test "map preserves deterministic order" {
    var items: mem.Vec[UInt64, mem.SystemAllocator] = mem.Vec.new()
    for i in 1..=10 {
        &items.push(i).unwrap()
    }
    var squared = map(Policy.Threads(4), items, |sink x| x * x)
    let len_matches = squared.length() == 10
    var i: UInt64 = 1
    var order_matches = true
    var pending = squared.drain()
    for res in &pending {
        if res != i * i {
            order_matches = false
        }
        i += 1
    }
    pending.finish().unwrap()
    testing.assert(len_matches, "mapped length wrong")?
    testing.assert(order_matches, "deterministic order violated")?
}

test "map keeps every result of a fallible function" {
    var items: mem.Vec[UInt64, mem.SystemAllocator] = mem.Vec.new()
    for i in 1..=6 {
        &items.push(i).unwrap()
    }
    var results = map(
        Policy.Threads(3),
        items,
        |sink x| {
            let res: Result[UInt64, UInt64] = if x % 2 == 0 {
                .Ok(x * 10)
            } else {
                .Err(99)
            }
            res
        },
    )
    let len_matches = results.length() == 6
    var count: UInt64 = 1
    var results_match = true
    var pending = results.drain()
    for r in &pending {
        match r {
            Ok(v) => {
                if v != count * 10 {
                    results_match = false
                }
            },
            Err(e) => {
                if e != 99 {
                    results_match = false
                }
            },
        }
        count += 1
    }
    pending.finish().unwrap()
    testing.assert(len_matches, "a failing item dropped another item's result")?
    testing.assert(results_match, "results mismatch")?
}

test "map starts the next item as soon as one finishes" {
    // The first item finishes only once the four after it have run. Two
    // workers map the items, so while the first waits, the other worker
    // takes each of the four in turn. A worker that waited for the first
    // item before taking the next would leave it waiting until its minute
    // ran out.
    let numbers = with_errands(
        [UInt64(4), 0, 0, 0, 0].as_slice(),
        sink [] |sink errands| map(Policy.Threads(2), errands, run_errand),
    )
    let prompt = numbers.as_slice() == [UInt64(1), 2, 3, 4, 5].as_slice()
    numbers.release()
    testing.assert(prompt, "a fast item waited for the slow one")?
}

// Map every item as `map` does, taking the results, the window's places and
// the workers' bytes from `allocator`; `items` keep their own allocator, and
// the chunks move between tasks in vectors from the system allocator. Items
// a refused worker would have mapped are mapped on the caller; a result the
// vector cannot take stops the program.
pub fn map_in[T: Owned, R: Owned, F: Owned + Copyable + Shareable + fn(sink item: T) -> R, A: Allocator, B: Allocator](allocator: A, sink policy: Policy, sink items: mem.Vec[T, B], sink f: F) -> mem.Vec[R, A] where carries(allocator) {
    let running_at_most = match policy {
        Sequential => UInt64(0),
        Threads(max) => {
            if max == 0 {
                panic("task.map: policy task limit cannot be 0")
            }
            max
        },
    }
    collected(allocator, items, f, running_at_most)
}

// Add a hundred to `n`. A named function is passed as a code pointer, which
// a worker that cannot be prepared hands back with its chunk.
fn plus_hundred(sink n: UInt64) -> UInt64 {
    n + 100
}

// Map 1, 2 and 3 through `map_in` over a test allocator that fails its
// allocation numbered `refused`, or none, and answer whether the results were
// right and every allocation was disposed of.
fn map_test_refusing(refused: Option[UInt64], named: Bool) -> (Bool, Bool) {
    let log = testing.TestAllocator.open(mem.system(), fail_at: refused).unwrap()
    var items: mem.Vec[UInt64, mem.SystemAllocator] = mem.Vec.new()
    for n in 1..=3 {
        &items.push(n).unwrap()
    }
    let results = if named {
        map_in(log.handle(), Policy.Threads(2), items, plus_hundred)
    } else {
        map_in(log.handle(), Policy.Threads(2), items, |sink n| n + 100)
    }
    let same = results.as_slice() == [UInt64(101), 102, 103].as_slice()
    results.release()
    let settled = log.all_disposed()
    log.release()
    (same, settled)
}

test "map_in takes its results and tasks from its allocator" {
    // The first allocation is the results' vector, reserved whole, which
    // stops the program when it is refused. The next six are the places,
    // the room for the workers, the room for stopping them and the names of
    // the wait set's slots, and a refusal of one maps every item on the
    // caller; the eighth and ninth are the workers' bytes, and a refusal of
    // one maps that worker's chunk on the caller.
    let walked: [Option[UInt64]; 9] = [.None, .Some(2), .Some(3), .Some(4), .Some(5), .Some(6), .Some(7), .Some(8), .Some(9)]
    for refused in walked {
        let (same, settled) = map_test_refusing(refused, false)
        testing.assert(same, "a refused allocation changed the results")?
        testing.assert(settled, "map_in kept an allocation")?
        let (named_same, named_settled) = map_test_refusing(refused, true)
        testing.assert(named_same, "a refused allocation changed a named function's results")?
        testing.assert(named_settled, "map_in kept an allocation for a named function")?
    }
}
