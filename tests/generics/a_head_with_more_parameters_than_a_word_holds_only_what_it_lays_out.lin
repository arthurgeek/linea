// Which of a declaration's parameters it lays out is read from the
// declaration, so a head takes as many as it is written with: `Wide` holds
// thirty-three, lays out the first thirty-two, and hands the last to
// `Marker`, which lays out nothing at it. An `S[T]` writing itself at that
// last position hands it to a position nothing is laid out at, so the layout
// closes and a value of the type has a size.
//
// A mask a word wide would answer "held" for the position past its last bit,
// and this program -- which has a size -- would be refused for a cycle it
// does not have.
struct Marker[phantom X] {
    v: UInt8,
}

struct Wide[P0, P1, P2, P3, P4, P5, P6, P7, P8, P9, P10, P11, P12, P13, P14, P15, P16, P17, P18, P19, P20, P21, P22, P23, P24, P25, P26, P27, P28, P29, P30, P31, P32] {
    f0: P0,
    f1: P1,
    f2: P2,
    f3: P3,
    f4: P4,
    f5: P5,
    f6: P6,
    f7: P7,
    f8: P8,
    f9: P9,
    f10: P10,
    f11: P11,
    f12: P12,
    f13: P13,
    f14: P14,
    f15: P15,
    f16: P16,
    f17: P17,
    f18: P18,
    f19: P19,
    f20: P20,
    f21: P21,
    f22: P22,
    f23: P23,
    f24: P24,
    f25: P25,
    f26: P26,
    f27: P27,
    f28: P28,
    f29: P29,
    f30: P30,
    f31: P31,
    last: Marker[P32],
}

struct S[T] {
    a: T,
    b: Wide[UInt8, UInt8, UInt8, UInt8, UInt8, UInt8, UInt8, UInt8, UInt8, UInt8, UInt8, UInt8, UInt8, UInt8, UInt8, UInt8, UInt8, UInt8, UInt8, UInt8, UInt8, UInt8, UInt8, UInt8, UInt8, UInt8, UInt8, UInt8, UInt8, UInt8, UInt8, UInt8, S[T]],
}

fn use_it(s: S[UInt8]) -> UInt8 {
    s.a
}

fn main() -> UInt8 {
    let s: S[UInt8] = .{ a = 40, b = .{ f0 = 1, f1 = 2, f2 = 3, f3 = 4, f4 = 5, f5 = 6, f6 = 7, f7 = 8, f8 = 9, f9 = 10, f10 = 11, f11 = 12, f12 = 13, f13 = 14, f14 = 15, f15 = 16, f16 = 17, f17 = 18, f18 = 19, f19 = 20, f20 = 21, f21 = 22, f22 = 23, f23 = 24, f24 = 25, f25 = 26, f26 = 27, f27 = 28, f28 = 29, f29 = 30, f30 = 31, f31 = 32, last = .{ v = 1 } } }
    use_it(s)
}
