// A concrete linear argument remains an obligation through a generic
// wrapper. Copying the wrapper cannot duplicate that argument.
@linear
enum Key {
    Forged(UInt8),
}

struct Pair[A, B] {
    a: A,
    b: B,
}

struct Bad[T] {
    p: Pair[Key, T],
}

fn f[T: Copyable](x: T) -> UInt8 {
    let b: Bad[T] = .{ p = .{ a = Key.Forged(3), b = copy(x) } }
    let c: Bad[T] = copy(b)
    let m: UInt8 = match read b.p.a { Forged(n) => n }
    let q: UInt8 = match read c.p.a { Forged(r) => r }
    m + q
}

fn main() -> UInt8 {
    let n: UInt8 = 1
    f(n)
}
