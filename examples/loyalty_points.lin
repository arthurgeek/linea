// Award loyalty points for café purchases under two reward plans.
import std.io
import std.testing

// A field can hold a function. Each plan stores its own earning rule, so a
// new plan needs a new rule rather than a new type.
struct Plan {
    earn: fn(cents: UInt64) -> UInt64,
    cap: UInt64,
}

impl Plan {
    // `plan.earn(cents)` calls this operation. A call written with a dot
    // always reaches an operation, even when a field has the same name.
    fn earn(self: Self, cents: UInt64) -> UInt64 {
        // `(self.earn)(cents)` reads the field first, then calls the rule it
        // holds. Without the parentheses this would call the operation again.
        let points = (self.earn)(cents)
        if points > self.cap {
            self.cap
        } else {
            points
        }
    }
}

// `per_dollar` matches the `fn(cents: UInt64) -> UInt64` field type, so a Plan
// can store it. Integer division drops the leftover cents: $12.50 earns 12.
fn per_dollar(cents: UInt64) -> UInt64 {
    cents / 100
}

// Award two points per dollar from $20 upwards; `cents / 50` counts half-dollars.
fn double_over_twenty(cents: UInt64) -> UInt64 {
    if cents >= 2000 {
        cents / 50
    } else {
        cents / 100
    }
}

// A function's name is a value of its function type, so `rule` holds either
// earning rule without a written type.
fn plan_for(member: Bool) -> Plan {
    let rule = if member {
        double_over_twenty
    } else {
        per_dollar
    }
    let cap = if member {
        80
    } else {
        30
    }
    Plan { earn = rule, cap }
}

test fn the_plan_caps_what_its_rule_awards() {
    let regular = Plan { earn = per_dollar, cap = 30 }
    testing.assert_eq(regular.earn(1250), 12, "a $12.50 purchase earns 12 points")?
    testing.assert_eq(regular.earn(4800), 30, "the cap limits a large purchase")?
    testing.assert_eq((regular.earn)(4800), 48, "the rule alone ignores the cap")?
}

test fn a_large_purchase_earns_double() {
    let member = Plan { earn = double_over_twenty, cap = 80 }
    testing.assert_eq(member.earn(1999), 19, "below $20 earns one point per dollar")?
    testing.assert_eq(member.earn(2000), 40, "$20 earns two points per dollar")?
}

fn main() -> Result[UInt8, io.IoError] {
    let regular = plan_for(member: false)
    let member = plan_for(member: true)
    for cents in [1205, 4875] {
        let dollars = cents / 100
        let remainder = cents % 100
        // `:02` pads the cents to two digits, so 1205 cents prints as $12.05.
        io.println("${dollars}.{remainder:02}: regular earns {regular.earn(cents)}, member earns {member.earn(cents)}")?
    }
    .Ok(0)
}
