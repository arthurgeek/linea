// `keep` takes a value that owns what it holds, and a view of `s` is refused
// there, once. A `Box[Str]` built directly is a value of its own: its type
// implements `Release` only for an owned item, so `defer let` over it is
// refused too.
struct Box[T] {
    item: T,
}

impl[T: Owned + Release] Release for Box[T] {
    fn release(sink self: Self) {
        let Box { item } = self
        item.release()
    }
}

fn keep[T: Owned](sink value: T) -> Box[T] {
    Box[T] { item = value }
}

fn main() -> UInt8 {
    defer let s = "held".to_owned().unwrap()
    let _kept = keep(s.view())
    defer let b2 = Box[Str] { item = s.view() }
    UInt8(b2.item.length())
}
