// `Tray.held` is a `Board.Elem`, the linear `Ticket`, so `Chooser[Tray]` does
// not implement `Pick`, and `take` is not available for it.
trait Counter {
    type Item
}

trait Pick {
    type Out

    fn take(sink self: Self) -> UInt8
}

@linear
struct Ticket {
    number: UInt8,
}

struct Tray {
    held: Board.Elem,
}

struct Board {
    values: [Ticket; 1],
}

impl Index[UInt64] for Board via values

struct Chooser[T] {
    t: T,
}

impl[T: Discardable] Pick for Chooser[T] {
    type Out = UInt8

    fn take(sink _self: Chooser[T]) -> UInt8 {
        4
    }
}

struct Mirror {}

impl Counter for Mirror {
    type Item = Chooser[Tray].Out
}

fn main() -> UInt8 {
    let item: Mirror.Item = 4
    let chooser = Chooser[Tray] { t = Tray { held = Ticket { number = 9 } } }
    item + chooser.take()
}
