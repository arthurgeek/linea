// `Endpoint` is implemented for a function whose inputs implement `Extract`.
// `Visitor` does not, and no module of this program may implement `Endpoint`
// for a function type, so the help points at the requirement the note names.
import std.http

struct Visitor {
    name: Str,
}

fn greet(visitor: Visitor, request: http.Request) -> Result[http.Response, http.Error] where carries(request) {
    http.text(request, "hello {visitor.name}")
}

fn main() -> UInt8 {
    var router = http.Router.new()
    let routed = &router.route("GET /", greet)
    router.release()
    if routed.is_ok() {
        0
    } else {
        1
    }
}
