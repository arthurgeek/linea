// Assigning a whole structure through an `inout` copies it. The indirect path
// stored at the type's width instead, and a structure's width is its size --
// so a two-byte structure had the low two bytes of the source's *address*
// written into the caller's value. What came back was whatever those bytes
// happened to be.
struct P {
    x: UInt8,
    y: UInt8,
}

fn set(inout p: P) {
    p = .{ x = 3, y = 4 }
}

fn main() -> UInt8 {
    var v: P = .{ x = 1, y = 2 }
    set(&v)
    v.x + v.y
}
