struct Board {
    scores: [UInt8; 2],
}

impl Index[UInt64] for Board {
    type Elem = UInt8

    proj at(self: Self, i: UInt64) -> UInt8 {
        self.scores[i]
    }
}

impl Board {
    trav positions via scores
}

fn main() -> UInt8 {
    var board: Board = .{ scores = [1, 2] }
    for inout score in board {
        score += 1
    }
    board[0]
}
