import std.mem
import std.testing

// `each_allocation_failure` is lent its callbacks, so `&body` and `&refused`
// pass them to the first walk and both are still there for the second.
fn main() -> UInt8 {
    var body = |allocator: mem.RefusingAllocator[mem.SystemAllocator]| -> Result[(), mem.Oom] {
        let held = allocator.acquire(8)?
        held.release()
        .Ok(())
    }
    var refused = |_error: mem.Oom| true
    let first = testing.each_allocation_failure(mem.system(), &body, &refused)
    let second = testing.each_allocation_failure(mem.system(), &body, &refused)
    if first.is_ok() && second.is_ok() {
        0
    } else {
        1
    }
}
