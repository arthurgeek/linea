import std.mem
import std.text
import std.collections
import std.hash
import std.testing

use collections.Map

// EncodeError says why encoding stopped: the writer failed, a codec emitted an
// invalid sequence of values, containers nested past hard_depth, or a number
// was not finite. A writer's own error is an encoding failure of that writer,
// so an encoder propagates a direct write with `?`.
@derive(From[E])
pub enum EncodeError[E] {
    Writer(E),
    InvalidState,
    DepthLimit,
    NonFiniteNumber,
}

derive[E: Release] Release for EncodeError[E]

derive[E: Debug] Debug for EncodeError[E]

test fn encoding_errors_preserve_writer_details_in_debug_output() {
    defer let error: EncodeError[UInt8] = .Writer(7)
    defer var rendered = String.new()
    error.debug(&rendered).unwrap()
    testing.assert_eq(rendered.view(), "Writer(7)", "writer error lost its debug detail")?
}

// Propagate a direct write with `?`, which converts the writer's error.
fn write_newline[W: Writer](inout writer: W) -> Result[(), EncodeError[W.Error]] where carries(.Err: writer) {
    &writer.write_str("\n")?
    .Ok(())
}

test fn a_writer_error_converts_into_an_encoding_failure() {
    defer let error: EncodeError[UInt8] = UInt8(7).into()
    testing.assert(match read error { Writer(code) => code == 7, _ => false }, "the writer error was not kept")?
    defer var output = String.new()
    write_newline(&output).unwrap()
    testing.assert_eq(output.view(), "\n", "the propagated write did not happen")?
}

// An Encode type writes itself as one JSON value through an Encoder.
pub trait Encode {
    fn encode[W: Writer](self: Self, inout encoder: Encoder, inout writer: W) -> Result[(), EncodeError[W.Error]] where carries(.Err: writer)
}

// Derived encoding writes a struct as an object, one member per field in
// declaration order.
template impl Encode where
    reflect.target: struct,
    reflect.components: Encode,
{
    fn encode[W: Writer](self: Self, inout encoder: Encoder, inout writer: W) -> Result[(), EncodeError[W.Error]] {
        Encoder.begin_object(&encoder, &writer)?
        match read self {
            reflect.case => {
                for component in reflect.components {
                    Encoder.key(&encoder, &writer, component.name)?
                    Encoder.value(&encoder, &writer, component.of(self))?
                }
            },
        }
        Encoder.end_object(&encoder, &writer)
    }
}

// EncodeRecord and EncodeEmpty derive Encode, with and without fields.
struct EncodeRecord {
    name: Str,
    retries: UInt8,
    enabled: Option[Bool],
}

derive Encode for EncodeRecord

struct EncodeEmpty {}

derive Encode for EncodeEmpty

test fn derived_record_encoding_uses_field_order_and_null_option_values() {
    let settings: EncodeRecord = .{ name = "tea", retries = 3, enabled = .None }
    defer var output = String.new()
    encode(&output, settings).unwrap()
    testing.assert_eq(output.view(), r#"{"name":"tea","retries":3,"enabled":null}"#, "record encoding changed its fields")?
    defer var empty_output = String.new()
    let empty: EncodeEmpty = .{}
    encode(&empty_output, empty).unwrap()
    testing.assert_eq(empty_output.view(), r"{}", "empty record encoding changed")?
}

// A Frame records where an open container stands: before its first value or
// key, after `count` values, or between a key and its value.
@copyable
enum Frame {
    FirstArrayValue,
    NextArrayValue(UInt64),
    FirstObjectKey,
    NextObjectKey(UInt64),
    ObjectValue(UInt64),
}

// empty_encoder_frames fills the encoder's 128 frame slots, one per nesting
