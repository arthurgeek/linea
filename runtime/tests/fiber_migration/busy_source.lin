import std.env
import std.io
import std.session
import std.task
import std.time

use session.Chan
use session.End

fn main() -> UInt8 {
    let execution = io.Loop.open(carriers: 4).unwrap()
    var worker_entries = UInt64(0)
    var worker_value = UInt64(0)
    var moved = false
    let worker = sink [inout worker_entries, inout worker_value, inout moved] |sink me: Chan[End]| {
        worker_entries += 1
        let original = task.current_carrier().unwrap()
        let began = time.Instant.now()
        var value = UInt64(91)
        while !moved && began.elapsed().nanoseconds() < 10000000000 {
            value += 3
            time.sleep(time.Duration.from_nanoseconds(0))
            moved = original != task.current_carrier().unwrap()
        }
        if !moved {
            panic("queued continuation did not escape its busy carrier")
        }
        worker_value = value
        me.close()
    }
    let running_worker = task.prepare(worker, on: execution).unwrap().start()
    // Reserve and cancel the other placements, so the busy task starts on the
    // worker's original carrier. No other application task runs on the thieves.
    for _index in 0..3 {
        let unused = task.prepare(sink [] |sink me: Chan[End]| {
            me.close()
        }, on: execution).unwrap()
        let _body = unused.cancel()
    }
    var busy_entries = UInt64(0)
    var iterations = UInt64(0)
    let busy = sink [inout busy_entries, inout iterations] |sink me: Chan[End]| {
        busy_entries += 1
        let original = task.current_carrier().unwrap()
        if env.args().count() == 0 {
            panic("process has no argument zero")
        }
        let began = time.Instant.now()
        while began.elapsed().nanoseconds() < 5000000000 {
            iterations += 1
            if iterations == 1 && original != task.current_carrier().unwrap() {
                panic("the busy task moved before entering its CPU loop")
            }
        }
        if original != task.current_carrier().unwrap() {
            panic("the busy native-bound task moved")
        }
        me.close()
    }
    let running_busy = task.prepare(busy, on: execution).unwrap().start()
    running_worker.close()
    running_busy.close()
    if moved && worker_entries == 1 && busy_entries == 1 && worker_value > 91 && iterations > 0 {
        0
    } else {
        1
    }
}
