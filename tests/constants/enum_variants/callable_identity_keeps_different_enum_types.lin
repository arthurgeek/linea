enum First { Preserve }

enum Second { Preserve }

trait Select[phantom F] {}

struct Holder {}

impl Select[fn(read mode: First = .Preserve) -> UInt8] for Holder {}

impl Select[fn(read mode: Second = .Preserve) -> UInt8] for Holder {}

fn require[T: Select[fn(read mode: First = First.Preserve) -> UInt8] + Select[fn(read mode: Second = Second.Preserve) -> UInt8]](_value: T) -> UInt8 {
    0
}

fn main() -> UInt8 {
    require(Holder {})
}
