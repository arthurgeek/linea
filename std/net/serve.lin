import std.io
import std.session
import std.task
import std.testing
import std.time

use io.Close
use task.Unowned
use task.Unstarted

// The first retry of a transient accept failure waits 5 ms; each further
// failure doubles the wait, up to one second.
let first_pause_ms: UInt64 = 5

let longest_pause_ms: UInt64 = 1000

// `serve` stops with `Accept` when accepting a connection fails with an
// error that retrying does not answer, and with `Close` when closing the
// listener fails.
@(copyable, derive(Equatable, Debug))
pub enum ServeError {
    Accept(NetError),
    Close(io.IoError),
}

impl Display for ServeError {
    fn fmt[W: Writer](self: Self, inout w: W) -> Result[(), W.Error] {
        match read self {
            Accept(error) => {
                &w.write_str("accepting a connection failed: ")?
                error.fmt(&w)
            },
            Close(error) => {
                &w.write_str("closing the listener failed: ")?
                error.fmt(&w)
            },
        }
    }
}

test fn a_serve_error_displays_its_cause() {
    let reset = io.IoError { operation = .Accept, category = .ConnectionReset, code = .None, progress = 0 }
    let invalid = io.IoError { operation = .Close, category = .InvalidDescriptor, code = .None, progress = 0 }
    var writer = testing.Recorder.of(256).unwrap()
    var wrote = true
    for error in [ServeError.Accept(.Io(reset)), ServeError.Close(invalid)] {
        wrote = wrote && error.fmt(&writer).is_ok() && &writer.write_str("\n").is_ok()
    }
    let expected =
        \\accepting a connection failed: Accept failed (ConnectionReset) after 0 bytes
        \\closing the listener failed: Close failed (InvalidDescriptor) after 0 bytes
        \\
    let equal = writer.holds(expected)
    writer.release()
    testing.assert(wrote, "display rendering failed")?
    testing.assert(equal, "a serve error displayed the wrong cause")?
    .Ok(())
}

// An `AcceptRetry` says that accepting a connection failed with `error`, in a
// way that waiting may answer, and that serving waits `pause` before trying
// again.
@copyable
pub struct AcceptRetry {
    error: NetError,
    pause: time.Duration,
}

// What one try at accepting a connection came to: a connection, a failure
// that waiting may answer, or a failure that ends serving.
pub enum Attempt {
    Connected(Accepted),
    Retry(AcceptRetry),
    Failed(NetError),
}

// What a test saw of an `Attempt`, after settling it.
@(copyable, derive(Equatable, Debug))
enum Seen {
    Retried(UInt64),
    Connected,
    Failed(NetError),
}

// Settle `attempt` and describe it.
fn seen(sink attempt: Attempt) -> Seen {
    match attempt {
        Connected(Accepted { connection, address: _ }) => {
            connection.close().unwrap()
            .Connected
        },
        Retry(retry) => .Retried(retry.pause.nanoseconds() / 1000000),
        Failed(error) => .Failed(error),
    }
}

// Try once to accept the next connection from `listener`. `pause_ms` is how
// long the last retry waited: it resets to zero when a connection arrives and
// grows through `accept_pause` while a failure that `retryable` repeats. The
// caller waits the retry's pause, so it can report the retry first.
pub fn accept_attempt[L: Acceptor](inout listener: L, inout pause_ms: UInt64) -> Attempt {
    match &listener.accept() {
        Ok(accepted) => {
            pause_ms = 0
            .Connected(accepted)
        },
        Err(error) => {
            if !retryable(error) {
                return .Failed(error)
            }
            pause_ms = accept_pause(pause_ms)
            .Retry(.{ error, pause = time.Duration.from_milliseconds(pause_ms) })
        },
    }
}

test fn an_accept_attempt_retries_failures_with_a_growing_pause_that_a_connection_resets() {
    let listener = listen(loopback(0)).unwrap()
    let client = connect(listener.local_address().unwrap()).unwrap()
    let exhausted = io.IoError { operation = .Accept, category = .ResourceExhausted, code = .None, progress = 0 }
    let invalid = io.IoError { operation = .Accept, category = .InvalidDescriptor, code = .None, progress = 0 }
    var script = scripted(listener, [.Some(.Io(copy(exhausted))), .Some(.Io(exhausted)), .None, .Some(.Io(copy(invalid)))], .None)
    var pause_ms: UInt64 = 0
    let first = seen(accept_attempt(&script, &pause_ms))
    let second = seen(accept_attempt(&script, &pause_ms))
    let third = seen(accept_attempt(&script, &pause_ms))
    let reset = pause_ms
    let fourth = seen(accept_attempt(&script, &pause_ms))
    script.close().unwrap()
    client.close().unwrap()
    testing.assert_eq(first, Seen.Retried(5), "the first retry did not wait 5 ms")?
    testing.assert_eq(second, Seen.Retried(10), "the second retry did not wait 10 ms")?
    testing.assert_eq(third, Seen.Connected, "the connection was not accepted")?
    testing.assert_eq(reset, UInt64(0), "a connection did not reset the pause")?
    testing.assert_eq(fourth, Seen.Failed(.Io(invalid)), "a failure retrying does not answer was retried")?
    .Ok(())
}

// Close `listener` and say how serving ended: the accept failure that stopped
// it, if there was one, else the failure to close the listener, else success.
// The accept failure is the one reported, since the listener is closed
// regardless.
pub fn finish[L: io.Close](sink listener: L, sink stopped: Option[NetError]) -> Result[(), ServeError] where L.CloseError: Into[io.IoError] {
    let closed = listener.close()
    match stopped {
        Some(error) => .Err(.Accept(error)),
        None => match closed {
            Ok(_) => .Ok(()),
            Err(error) => .Err(.Close(error.into())),
        },
    }
}

test fn finish_closes_the_listener_and_reports_the_accept_failure_before_the_close_failure() {
    let invalid = io.IoError { operation = .Accept, category = .InvalidDescriptor, code = .None, progress = 0 }
    let broken = io.IoError { operation = .Close, category = .InvalidDescriptor, code = .None, progress = 0 }
    let healthy = listen(loopback(0)).unwrap()
    let bound = healthy.local_address().unwrap()
    let clean = finish(healthy, .None)
    let refused = match connect(bound) {
        Ok(connection) => {
            connection.close().unwrap()
            false
        },
        Err(_) => true,
    }
    let failing = scripted(listen(loopback(0)).unwrap(), [.None, .None, .None, .None], .Some(copy(broken)))
    let close_failed = finish(failing, .None)
    let failing_too = scripted(listen(loopback(0)).unwrap(), [.None, .None, .None, .None], .Some(copy(broken)))
    let accept_failed = finish(failing_too, .Some(.Io(copy(invalid))))
    testing.assert_eq(clean, .Ok(()), "a clean stop reported a failure")?
    testing.assert(refused, "finish left the listener open")?
    testing.assert_eq(close_failed, .Err(.Close(broken)), "a failed close was not reported")?
    testing.assert_eq(accept_failed, .Err(.Accept(.Io(invalid))), "the close failure replaced the accept failure")?
    .Ok(())
}

// Accept connections from `listener` and hand each to `handler` together with
// the address of the peer that opened it, one connection at a time: `handler`
// finishes with a connection before the next is accepted, so a slow client
// holds up the ones queued behind it. `handler` owns the connection and must
// close or release it. It reports its own failures, and a failed connection
// never stops serving. It is lent `inout`, so a closure keeps state across
// connections and the caller reads it back afterwards, as with
// `for_each_inout`.
//
// A reset connection or running out of descriptors while accepting is retried
// after a pause that grows while the failure repeats; any other accept failure
// ends serving with `Accept`. Serving ends with `Ok` after `connections`
// connections, and never ends when that is `.None`. The listener is closed on
// every exit.
pub fn serve[L: Acceptor + io.Close, H: inout fn(sink connection: Connection, peer: Address)](sink listener: L, inout handler: H, connections: Option[UInt64] = .None) -> Result[(), ServeError] where L.CloseError: Into[io.IoError] {
    var accepting = listener
    var served: UInt64 = 0
    var pause_ms: UInt64 = 0
    var stopped: Option[NetError] = .None
    while stopped.is_none() && !reached(connections, served) {
        match accept_attempt(&accepting, &pause_ms) {
            Connected(Accepted { connection, address }) => {
                &handler(connection, address)
                served += 1
            },
            Retry(retry) => time.sleep(retry.pause),
            Failed(error) => stopped = .Some(error),
        }
    }
    finish(accepting, stopped)
}

// Accept connections from `listener` and hand each to `handler` across
// worker tasks according to `policy`. `policy` defaults to `.Threads(128)`,
// serving connections concurrently. Each worker takes its next connection
// only once it is free, so a client that holds its worker holds up no other.
// `handler` is shared by `read`, so it must satisfy `Shareable`. Every
// started worker task is joined before `serve_workers` returns. When the task
// that keeps the listener cannot be made, this thread serves alone.
pub fn serve_workers[L: Acceptor + io.Close + Owned + Shareable, H: Owned + Shareable + Copyable + fn(sink connection: Connection, peer: Address)](sink listener: L, handler: H, policy: task.Policy = .Threads(128), connections: Option[UInt64] = .None) -> Result[(), ServeError] where L.CloseError: Into[io.IoError] {
    let workers = match copy(policy) {
        Sequential => 1,
        Threads(count) => count,
    }
    if workers == 0 {
        let _closed = listener.close()
        return .Ok(())
    }
    if workers == 1 {
        var alone = copy(handler)
        return serve(listener, &alone, connections)
    }
    let owner = match task.own(Accepting.open(listener, connections)) {
        Ok(owner) => owner,
        Err(Unowned { state, reason: _ }) => {
            var alone = copy(handler)
            return serve(state.close_alone(), &alone, connections)
        },
    }
    on_tasks(workers, owner.client(), handler, serve_connections[L, H])
    owner.close().finish()
}

// One worker of `serve_workers`: hand each connection the listener's owning
// task gives out to `handler`, until it says to stop.
fn serve_connections[L: Acceptor + Owned + Shareable, H: Owned + Shareable + Copyable + fn(sink connection: Connection, peer: Address)](handler: H, acceptor: task.Client[Accepting[L]]) {
    var serving = true
    while serving {
        match acceptor.call(|inout accepting: Accepting[L]| &accepting.next()) {
            Connection(Accepted { connection, address }) => handler(connection, address),
            Retried(retry) => time.sleep(retry.pause),
            Stop => serving = false,
        }
    }
}

// What a listener's owning task holds while tasks serve it: the listener, how
// many connections it has handed out, the most it hands out, the pause after
// a transient accept failure, and the failure that ended accepting.
internal struct Accepting[L] {
    listener: L,
    served: UInt64,
    limit: Option[UInt64],
    pause_ms: UInt64,
    stopped: Option[NetError],
}

// What a serving task is handed when it asks for its next connection.
internal enum Next {
    Connection(Accepted),
    Retried(AcceptRetry),
    Stop,
}

impl[L: Acceptor] Accepting[L] {
    // Keep `listener`, to hand out at most `limit` connections, or any number
    // when that is `.None`.
    internal fn open(sink listener: L, limit: Option[UInt64]) -> Accepting[L] where carries(listener) {
        .{ listener, served = 0, limit = copy(limit), pause_ms = 0, stopped = .None }
    }

    // Accept the next connection, unless accepting has stopped or handed out
    // the most it may.
    internal fn next(inout self: Self) -> Next {
        if self.stopped.is_some() || reached(self.limit, self.served) {
            return .Stop
        }
        match accept_attempt(&self.listener, &self.pause_ms) {
            Connected(accepted) => {
                self.served += 1
                .Connection(accepted)
            },
            Retry(retry) => .Retried(retry),
            Failed(error) => {
                self.stopped = .Some(error)
                .Stop
            },
        }
    }

    // The listener, for a thread that serves it alone because its owning
    // task could not be made.
    internal fn close_alone(sink self: Self) -> L where carries(self.listener) {
        let Accepting { listener, served: _, limit: _, pause_ms: _, stopped: _ } = self
        listener
    }
}

impl[L: Acceptor + io.Close] Accepting[L] {
    // Close the listener and report the accept failure that ended serving,
    // or the failure to close it.
    internal fn finish(sink self: Self) -> Result[(), ServeError] where L.CloseError: Into[io.IoError] {
        let Accepting { listener, served: _, limit: _, pause_ms: _, stopped } = self
        finish(listener, stopped)
    }
}

// Run `work(context, acceptor)` on `count` tasks: half of them are started on
// a new task, which divides them again, and this thread runs the rest, so
// starting them takes a depth of the logarithm of `count`. Every task started
// is joined before this returns. A task that cannot be made leaves its share
// to this thread. It answers what this thread's own `work` answered; what the
// other tasks answer is dropped.
internal fn on_tasks[L: Acceptor + Owned + Shareable, C: Shareable + Copyable, R: Owned + Discardable, W: Shareable + Copyable + fn(context: C, acceptor: task.Client[Accepting[L]]) -> R](count: UInt64, acceptor: task.Client[Accepting[L]], context: C, work: W) -> R {
    if count <= 1 {
        return work(context, acceptor)
    }
    let half = count / 2
    let body = sink [half, sink acceptor = copy(acceptor), sink context = copy(context), sink work = copy(work)] |sink me: session.Chan[session.End]| {
        let _answered = on_tasks[L, C, R, W](half, acceptor, context, work)
        me.close()
    }
    match task.prepare(body) {
        Ok(slot) => {
            let started = slot.start()
            let answered = on_tasks[L, C, R, W](count - half, acceptor, context, work)
            started.close()
            answered
        },
        Err(unstarted) => {
            let Unstarted { body: _, reason: _ } = unstarted
            on_tasks[L, C, R, W](count - half, acceptor, context, work)
        },
    }
}

test fn serve_workers_handles_connections_concurrently() {
    let listener = listen(loopback(0)).unwrap()
    let bound = listener.local_address().unwrap()
    let client1 = connect(bound).unwrap()
    let client2 = connect(bound).unwrap()
    let handler = |sink connection: Connection, _peer: Address| {
        var conn = connection
        match io.write_all(&conn, "pong\n".as_bytes()) {
            Ok(_) => {},
            Err(_) => {},
        }
        let _closed = conn.close()
    }
    let ended = serve_workers(listener, handler, policy: .Threads(2), connections: .Some(2))
    var reader1 = io.BufferedReader.open(capacity: 16, reader: client1) else |_| {
        panic("reader1 failed")
    }
    var reader2 = io.BufferedReader.open(capacity: 16, reader: client2) else |_| {
        panic("reader2 failed")
    }
    let ok1 = match &reader1.read_line_borrowed(max_bytes: 16) {
        Ok(Some(text)) => text == "pong",
        _ => false,
    }
    let ok2 = match &reader2.read_line_borrowed(max_bytes: 16) {
        Ok(Some(text)) => text == "pong",
        _ => false,
    }
    let c1 = reader1.abandon().close().is_ok()
    let c2 = reader2.abandon().close().is_ok()
    testing.assert_eq(ended, .Ok(()), "threaded serving did not end after two connections")?
    testing.assert(ok1, "first client did not get response")?
    testing.assert(ok2, "second client did not get response")?
    testing.assert(c1 && c2, "closing readers failed")?
    .Ok(())
}

// `answer_a_line` waits for its client's line, then answers `ok`. A client
// that sends nothing holds the task serving it until its read times out.
fn answer_a_line(sink connection: Connection, _peer: Address) {
    var waiting = connection
    let _timed = &waiting.set_timeouts(read_ms: 3000, write_ms: 3000)
    var reader = io.BufferedReader.open(capacity: 16, reader: waiting) else |_| {
        panic("the server's reader could not be made")
    }
    let got_line = match &reader.read_line_borrowed(max_bytes: 16) {
        Ok(Some(_)) => true,
        _ => false,
    }
    var answering = reader.abandon()
    if got_line {
        let _answered = io.write_all(&answering, "ok\n".as_bytes())
    }
    let _closed = answering.close()
}

// `asked` sends a line on `connection` and answers whether `ok` came back
// within a second.
fn asked(sink connection: Connection) -> Bool {
    var asking = connection
    let _timed = &asking.set_timeouts(read_ms: 1000, write_ms: 1000)
    if io.write_all(&asking, "x\n".as_bytes()).is_err() {
        let _closed = asking.close()
        return false
    }
    var reader = io.BufferedReader.open(capacity: 16, reader: asking) else |_| {
        panic("the client's reader could not be made")
    }
    let answered = match &reader.read_line_borrowed(max_bytes: 16) {
        Ok(Some(text)) => text == "ok",
        _ => false,
    }
    let _closed = reader.abandon().close()
    answered
}

// The first client sends its line only after the third is answered. Two
// tasks serve: one holds the first client, so the other must serve both the
// second and the third.
test fn a_client_that_holds_its_task_holds_up_no_other() {
    let listener = listen(loopback(0)).unwrap()
    let bound = listener.local_address().unwrap()
    let clients = task.prepare(
        sink [bound] |sink me: session.Chan[session.Send[Bool, session.End]]| {
            let slow = connect(bound).unwrap()
            let quick = connect(bound).unwrap()
            let third = connect(bound).unwrap()
            let quick_answered = asked(quick)
            let third_answered = asked(third)
            let slow_answered = asked(slow)
            me.send(quick_answered && third_answered && slow_answered).close()
        },
    ).unwrap().start()
    let ended = serve_workers(listener, answer_a_line, policy: .Threads(2), connections: .Some(3))
    let (answered, done) = clients.recv()
    done.close()
    testing.assert_ok_eq(ended, (), "serving failed")?
    testing.assert(answered, "a client waited behind one that held its task")?
}

test fn zero_workers_closes_the_listener_and_returns() {
    let listener = listen(loopback(0)).unwrap()
    let bound = listener.local_address().unwrap()
    let handler = |sink connection: Connection, _peer: Address| {
        let _closed = connection.close()
    }
    let res = serve_workers(listener, handler, policy: .Threads(0), connections: .Some(1))
    testing.assert_ok_eq(res, (), "zero workers should succeed immediately")?
    defer let attempt = connect(bound)
    testing.assert(attempt.is_err(), "connecting to closed listener should fail")?
    .Ok(())
}

test fn serve_workers_sequential_policy() {
    let listener = listen(loopback(0)).unwrap()
    let bound = listener.local_address().unwrap()
    let client1 = connect(bound).unwrap()
    let handler = |sink connection: Connection, _peer: Address| {
        var conn = connection
        match io.write_all(&conn, "seq\n".as_bytes()) {
            Ok(_) => {},
            Err(_) => {},
        }
        let _closed = conn.close()
    }
    let ended = serve_workers(listener, handler, policy: .Sequential, connections: .Some(1))
    var reader = io.BufferedReader.open(capacity: 16, reader: client1) else |_| {
        panic("reader failed")
    }
    let ok = match &reader.read_line_borrowed(max_bytes: 16) {
        Ok(Some(text)) => text == "seq",
        _ => false,
    }
    let c = reader.abandon().close().is_ok()
    testing.assert_eq(ended, .Ok(()), "sequential serving did not end after one connection")?
    testing.assert(ok, "client did not get response")?
    testing.assert(c, "closing reader failed")?
    .Ok(())
}

test fn serve_runs_the_handler_once_for_each_connection_and_returns() {
    let listener = listen(loopback(0)).unwrap()
    let bound = listener.local_address().unwrap()
    let first = connect(bound).unwrap()
    let second = connect(bound).unwrap()
    var handler = inout [sink served = UInt64(0)] |sink connection: Connection, _peer: Address| {
        let _closed = connection.close()
        served += 1
    }
    let ended = serve(listener, &handler, connections: .Some(2))
    let { served } = handler.into_captures()
    first.close().unwrap()
    second.close().unwrap()
    testing.assert_eq(ended, .Ok(()), "serving did not end after two connections")?
    testing.assert_eq(served, 2, "the handler did not run once per connection")?
    .Ok(())
}

test fn the_handler_reads_from_each_connection_and_names_its_peer() {
    let listener = listen(loopback(0)).unwrap()
    let bound = listener.local_address().unwrap()
    var client = connect(bound).unwrap()
    let sent = io.write_all(&client, "ping".as_bytes()).is_ok()
    let client_closed = client.close().is_ok()
    var handler = inout [sink received = false, sink from_loopback = false] |sink connection: Connection, peer: Address| {
        from_loopback = peer == loopback(peer.port)
        var reader = io.BufferedReader.open(capacity: 16, reader: connection) else |_| {
            panic("the reader was refused its buffer")
        }
        received = match &reader.read_line_borrowed(max_bytes: 16) {
            Ok(Some(text)) => text == "ping",
            Ok(None) => false,
            Err(_) => false,
        }
        let _closed = reader.abandon().close()
    }
    let ended = serve(listener, &handler, connections: .Some(1))
    let { received, from_loopback } = handler.into_captures()
    testing.assert(sent && client_closed, "the client could not send")?
    testing.assert_eq(ended, .Ok(()), "serving did not end")?
    testing.assert(received, "the handler did not receive the bytes sent")?
    testing.assert(from_loopback, "the peer address was not the loopback address")?
    .Ok(())
}

test fn serving_no_connections_returns_at_once_and_closes_the_listener() {
    let listener = listen(loopback(0)).unwrap()
    let bound = listener.local_address().unwrap()
    var handler = inout [sink served = UInt64(0)] |sink connection: Connection, _peer: Address| {
        let _closed = connection.close()
        served += 1
    }
    let ended = serve(listener, &handler, connections: .Some(0))
    let { served } = handler.into_captures()
    let refused = match connect(bound) {
        Ok(connection) => {
            connection.close().unwrap()
            false
        },
        Err(_) => true,
    }
    testing.assert_eq(ended, .Ok(()), "serving no connections failed")?
    testing.assert_eq(served, 0, "the handler ran with no connection to serve")?
    testing.assert(refused, "the listener was left open")?
    .Ok(())
}

test fn transient_accept_failures_are_retried_until_a_connection_is_served() {
    let listener = listen(loopback(0)).unwrap()
    let client = connect(listener.local_address().unwrap()).unwrap()
    let exhausted = io.IoError { operation = .Accept, category = .ResourceExhausted, code = .None, progress = 0 }
    let reset = io.IoError { operation = .Accept, category = .ConnectionReset, code = .None, progress = 0 }
    let scripted = scripted(listener, [.Some(.Io(exhausted)), .Some(.Io(reset)), .None, .None], .None)
    var handler = inout [sink served = UInt64(0)] |sink connection: Connection, _peer: Address| {
        let _closed = connection.close()
        served += 1
    }
    let ended = serve(scripted, &handler, connections: .Some(1))
    let { served } = handler.into_captures()
    client.close().unwrap()
    testing.assert_eq(ended, .Ok(()), "serving did not retry")?
    testing.assert_eq(served, 1, "the connection after the failures was not served")?
    .Ok(())
}

test fn a_fatal_accept_failure_ends_serving_and_closes_the_listener() {
    let listener = listen(loopback(0)).unwrap()
    let bound = listener.local_address().unwrap()
    let invalid = io.IoError { operation = .Accept, category = .InvalidDescriptor, code = .None, progress = 0 }
    let scripted = scripted(listener, [.Some(.Io(copy(invalid))), .None, .None, .None], .None)
    var handler = |sink connection: Connection, _peer: Address| {
        let _closed = connection.close()
    }
    let ended = serve(scripted, &handler, connections: .Some(1))
    let refused = match connect(bound) {
        Ok(connection) => {
            connection.close().unwrap()
            false
        },
        Err(_) => true,
    }
    testing.assert_eq(ended, .Err(.Accept(.Io(invalid))), "a fatal accept failure did not end serving")?
    testing.assert(refused, "the listener was left open")?
    .Ok(())
}

test fn a_failed_listener_close_ends_serving_with_close() {
    let listener = listen(loopback(0)).unwrap()
    let failure = io.IoError { operation = .Close, category = .InvalidDescriptor, code = .None, progress = 0 }
    let scripted = scripted(listener, [.None, .None, .None, .None], .Some(copy(failure)))
    var handler = |sink connection: Connection, _peer: Address| {
        let _closed = connection.close()
    }
    let ended = serve(scripted, &handler, connections: .Some(0))
    testing.assert_eq(ended, .Err(.Close(failure)), "a failed close was not reported")?
    .Ok(())
}

// `reached` says whether `served` connections reach the limit `connections`.
// `http.serve` counts its connections the same way.
pub fn reached(connections: Option[UInt64], served: UInt64) -> Bool {
    match read connections {
        Some(limit) => served >= limit,
        None => false,
    }
}

test fn a_limit_is_reached_at_its_count_and_none_is_never_reached() {
    testing.assert_eq(reached(.Some(2), 1), false, "a limit was reached early")?
    testing.assert_eq(reached(.Some(2), 2), true, "a limit was not reached at its count")?
    testing.assert_eq(reached(.None, 1000), false, "no limit was reached")?
    .Ok(())
}

// `retryable` says whether retrying answers an accept failure: a queued
// connection the peer reset before it was accepted, or the process running out
// of descriptors or memory, which closing other connections relieves.
// `http.serve` retries the same failures.
pub fn retryable(error: NetError) -> Bool {
    match read error {
        Io(reason) => match read reason.category {
            ConnectionReset => true,
            ResourceExhausted => true,
            _ => false,
        },
        _ => false,
    }
}

test fn a_reset_or_exhausted_accept_is_retried() {
    let reset = io.IoError { operation = .Accept, category = .ConnectionReset, code = .None, progress = 0 }
    let exhausted = io.IoError { operation = .Accept, category = .ResourceExhausted, code = .None, progress = 0 }
    let invalid = io.IoError { operation = .Accept, category = .InvalidDescriptor, code = .None, progress = 0 }
    testing.assert_eq(retryable(.Io(reset)), true, "a reset connection was not retried")?
    testing.assert_eq(retryable(.Io(exhausted)), true, "running out of descriptors was not retried")?
    testing.assert_eq(retryable(.Io(invalid)), false, "an invalid listener was retried")?
    testing.assert_eq(retryable(.InvalidAddress), false, "an invalid address was retried")?
    .Ok(())
}

// `accept_pause` returns the wait in milliseconds before the next retry, after
// waiting `previous`. `http.serve` shares the schedule.
pub fn accept_pause(previous: UInt64) -> UInt64 {
    if previous == 0 {
        return first_pause_ms
    }
    if previous >= longest_pause_ms / 2 {
        return longest_pause_ms
    }
    previous * 2
}

test fn the_accept_pause_doubles_to_one_second() {
    testing.assert_eq(accept_pause(0), 5, "the first pause changed")?
    testing.assert_eq(accept_pause(5), 10, "the pause did not double")?
    testing.assert_eq(accept_pause(640), 1000, "the pause passed one second")?
    testing.assert_eq(accept_pause(1000), 1000, "the longest pause grew")?
    .Ok(())
}
