// A re-export is an alias, never a fresh identity: what it binds is the source
// declaration itself. So a value built through the re-exported spelling is
// accepted by a function whose signature was written against the original, and
// no later pass can tell which spelling reached it.
//
// A re-export is also never unused. It exists for another module to reach
// rather than for use where it is written.
import inner

pub use inner.Maybe

fn main() -> UInt8 {
    let three: UInt8 = 3
    let built_here: Maybe[UInt8] = Maybe.Some(three)
    inner.unwrap(built_here)
}
