import std.io
import std.mem
import std.net
import std.session
import std.task
import std.time

use io.Reader
use net.Acceptor
use net.Accepted
use session.Chan
use session.End

fn main() -> UInt8 {
    var listener = net.listen(net.loopback(0), backlog: net.Backlog(1)).unwrap()
    let address = listener.local_address().unwrap()
    // Linux admits one connection beyond the backlog before reporting a full
    // accept queue. Keep both queued so the next handshake must wait.
    let occupied_first = net.connect(address, within_ms: 1000).unwrap()
    let occupied_second = net.connect(address, within_ms: 1000).unwrap()
    let execution = io.Loop.open(carriers: 2).unwrap()
    var passed = false
    let body = sink [address, inout passed] |sink me: Chan[End]| {
        let first = task.current_carrier().unwrap()
        var stream = net.connect(address, within_ms: 10000).unwrap()
        if first == task.current_carrier().unwrap() {
            panic("the completed connect did not migrate its continuation")
        }
        time.sleep(time.Duration.from_nanoseconds(0))
        if first != task.current_carrier().unwrap() {
            panic("the connect continuation did not return to its first carrier")
        }
        let _sent = io.write_all(&stream, "x".as_bytes()).unwrap()
        stream.release()
        passed = true
        me.close()
    }
    let running = task.prepare(body, on: execution).unwrap().start()
    let Accepted { connection: first, address: _ } = &listener.accept().unwrap()
    first.release()
    occupied_first.release()
    let Accepted { connection: second, address: _ } = &listener.accept().unwrap()
    second.release()
    occupied_second.release()
    let Accepted { connection, address: _ } = &listener.accept().unwrap()
    listener.release()
    var stream = connection
    var buffer = mem.system().acquire(1).unwrap()
    let received = &stream.read_some(&buffer, offset: 0, count: 1).unwrap()
    let correct = received == 1 && buffer.as_slice()[0] == 120
    buffer.release()
    stream.release()
    running.close()
    if passed && correct {
        0
    } else {
        1
    }
}
