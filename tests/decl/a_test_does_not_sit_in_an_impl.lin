import std.io

use io.IoError

struct Box {
    x: UInt8,
}

// An impl's braces hold what its type or its trait declares, and a test is
// neither: the compiler calls a test, and an impl member is reached through the
// type that names it.
impl Box {
    test fn a_thing_holds() -> Result[(), IoError] {
        return .Ok({})
    }
}

fn main() -> UInt8 {
    0
}
