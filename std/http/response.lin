import std.io
import std.json as json_format
import std.mem
import std.net
import std.testing

use io.ByteWriter
use io.FinishFailure
use io.WriteFailure
use net.Accepted
use net.Acceptor

// A response collects up to 4 KiB before writing to its connection.
let response_buffer_bytes: UInt64 = 4096

// The server sends this content type when the headers name none.
let default_content_type: Str = "text/plain; charset=utf-8"

// A handler answers with a `Response`: a status, headers, and a body that is
// either held in the request's arena or streamed by a closure once the head is
// sent. Every response ends where its connection closes, so the server sends
// `Connection: close` and no length, and a response sets neither. With no
// `Content-Type`, the server sends `text/plain; charset=utf-8`. A HEAD request
// is answered with the head alone.
@opaque
struct Response[P: Allocator = mem.SystemAllocator] {
    answer: Status,
    headers: ResponseHeaders[mem.Handle[P]],
    content: Body[P],
}

// A body is held in the request's arena, or streamed by a closure once the head
// is sent.
enum Body[P: Allocator] {
    Held(Vec[UInt8, mem.Handle[P]]),
    Streamed(Stream[P]),
}

// A streamed body is written by `produce` after the head is sent. The closure
// answers `request`, and it lives in the request's arena with what it
// captured, so it is dropped with the arena like the rest of the response.
struct Stream[P: Allocator] {
    request: Request[P],
    produce: Closure[Produce[P], mem.Handle[P]],
}

// A `Produce` writes a streamed body once the head is sent, and may change
// what it captured each time it runs.
alias Produce[P: Allocator = mem.SystemAllocator] = inout fn(inout body: BodyWriter[P]) -> Result[(), Error[P]]

// `text` answers 200 with `body` rendered as text in the request's arena. `body`
// is any `Display` value, so an interpolated literal builds the text in place.
pub fn text[P: Allocator, T: Display](request: Request[P], body: T) -> Result[Response[P], Error[P]] {
    var rendered = String.new_in(request.allocator())
    body.fmt(&rendered)?
    .Ok(held(request, rendered.into_bytes()))
}

test fn a_text_response_holds_its_rendered_body() {
    defer let arena = mem.Arena.open(mem.system(), size: 4096)
    let sent = new_request(arena.handle(), "GET", "/", body: "").unwrap()
    let count = 3
    let response = text(sent.request(), "{count} items").unwrap()
    testing.assert_eq(response.status(), Status.Ok, "the status changed")?
    testing.assert_eq(response.header("Content-Type"), .None, "a content type was set")?
    testing.assert_eq(held_text(response), Option.Some("3 items"), "the body changed")?
    .Ok(())
}

// A body larger than the arena answers 500.
test fn a_text_response_past_the_arena_is_refused() {
    defer let arena = mem.Arena.open(mem.system(), size: 64)
    let sent = new_request(arena.handle(), "GET", "/", body: "").unwrap()
    defer let long = Vec.filled(512, UInt8(120)).unwrap()
    let refused = match text(sent.request(), Str.from_bytes(long.as_slice()).unwrap()) {
        Ok(_) => Option.None,
        Err(error) => Option.Some(error.status()),
    }
    testing.assert_eq(refused, Option.Some(Status.InternalServerError), "a body past the arena was accepted")?
    .Ok(())
}

// A test encodes a `Greeting` as JSON.
@derive(json_format.Encode)
struct Greeting {
    hello: Str,
}

// `json` answers 200 with `value` encoded as JSON in the request's arena, and
// sets `Content-Type: application/json`.
pub fn json[P: Allocator, T: json_format.Encode](request: Request[P], value: T) -> Result[Response[P], Error[P]] {
    var encoded = String.new_in(request.allocator())
    json_format.encode(&encoded, value)?
    var response = held(request, encoded.into_bytes())
    &response.set_header("Content-Type", "application/json")?
    .Ok(response)
}

test fn a_json_response_holds_its_encoded_value() {
    defer let arena = mem.Arena.open(mem.system(), size: 4096)
    let sent = new_request(arena.handle(), "GET", "/", body: "").unwrap()
    let response = json(sent.request(), Greeting { hello = r#"say "hi""# }).unwrap()
    testing.assert_eq(response.status(), Status.Ok, "the status changed")?
    testing.assert_eq(response.header("content-type"), Option.Some("application/json"), "the content type changed")?
    testing.assert_eq(held_text(response), Option.Some(r#"{"hello":"say \"hi\""}"#), "the body changed")?
    .Ok(())
}

// `status` answers `status` with an empty body.
pub fn status[P: Allocator](request: Request[P], status: Status) -> Response[P] {
    let empty: Vec[UInt8, mem.Handle[P]] = Vec.new_in(request.allocator())
    held(request, empty).with_status(status)
}

test fn a_status_response_has_no_body() {
    defer let arena = mem.Arena.open(mem.system(), size: 4096)
    let sent = new_request(arena.handle(), "DELETE", "/items/1", body: "").unwrap()
    let response = status(sent.request(), .NoContent)
    testing.assert_eq(response.status(), Status.NoContent, "the status changed")?
    testing.assert_eq(held_text(response), Option.Some(""), "an empty response had a body")?
    .Ok(())
}

// `stream` answers 200 with a body that `produce` writes to the connection
// after the head is sent. `produce` is any closure or function with that
// signature: it may capture what its handler computed, such as a checked year,
// and it reads the request through `body.request()`. `stream` keeps it in the
// request's arena, which it cannot outgrow, so a full arena answers 500. The
// arena is dropped whole after the exchange, so `produce` may capture nothing
// that must be released (`Discardable`). Nothing `produce` writes is held in
// the arena past the 4 KiB the server buffers, so the body may be larger than
// the arena. The status and headers are settled before it runs: an error it
// returns, or a failed write, resets the connection so the client sees the
// body was cut short, and is logged. A HEAD request does not run it.
pub fn stream[P: Allocator, F: Produce[P] + Release + Discardable](request: Request[P], sink produce: F) -> Result[Response[P], Error[P]] where carries(request, produce) {
    let kept = Closure.open_in(request.allocator(), produce)?
    .Ok(.{ answer = .Ok, headers = ResponseHeaders.open(request.allocator()), content = .Streamed(.{ request = copy(request), produce = kept }) })
}

test fn a_streamed_response_has_no_held_body() {
    defer let arena = mem.Arena.open(mem.system(), size: 4096)
    let sent = new_request(arena.handle(), "GET", "/count", body: "").unwrap()
    let response = stream(sent.request(), count_to_three).unwrap()
    testing.assert_eq(response.status(), Status.Ok, "the status changed")?
    testing.assert(response.body().is_none(), "a streamed body was held")?
    .Ok(())
}

// A streamed body owns what its closure captured, such as the last number
// its handler checked.
test fn a_streamed_body_uses_what_its_handler_captured() {
    defer let received = exchanged(.Get, counted_to_four)
    testing.assert_eq(received.view(), "HTTP/1.1 200 OK\r\nConnection: close\r\nContent-Type: text/plain; charset=utf-8\r\n\r\n1\n2\n3\n4\n", "the captured number did not reach the body")?
    .Ok(())
}

// A streamed body's closure is kept in the request's arena, so an arena too
// full to hold it answers 500 before anything is sent.
test fn a_stream_the_arena_cannot_hold_is_refused() {
    defer let arena = mem.Arena.open(mem.system(), size: 4096)
    let sent = new_request(arena.handle(), "GET", "/count", body: "").unwrap()
    // Fill the arena eight bytes at a time until it refuses.
    while Vec.filled_in(sent.request().allocator(), 1, UInt8(0)).is_ok() {}
    let last: UInt64 = 4
    let refused: Option[Status] = match stream(sent.request(), inout [sink last] |inout body| count_to(last, &body)) {
        Ok(_) => Option.None,
        Err(error) => Option.Some(error.status()),
    }
    testing.assert_eq(refused, Option.Some(Status.InternalServerError), "a stream past the arena was accepted")?
    .Ok(())
}

// `bytes` answers 200 with `body`, bytes already built in the request's arena,
// without copying them.
pub fn bytes[P: Allocator](request: Request[P], sink body: Vec[UInt8, mem.Handle[P]]) -> Response[P] where carries(request, body) {
    held(request, body)
}

test fn a_bytes_response_holds_its_body_as_built() {
    defer let arena = mem.Arena.open(mem.system(), size: 4096)
    let sent = new_request(arena.handle(), "GET", "/", body: "").unwrap()
    var built = String.new_in(sent.request().allocator())
    &built.append("built once").unwrap()
    let response = bytes(sent.request(), built.into_bytes())
    testing.assert_eq(held_text(response), Option.Some("built once"), "the body changed")?
    .Ok(())
}

// `held` builds a 200 response whose body is `body`.
fn held[P: Allocator](request: Request[P], sink body: Vec[UInt8, mem.Handle[P]]) -> Response[P] where carries(request, body) {
    .{ answer = .Ok, headers = ResponseHeaders.open(request.allocator()), content = .Held(body) }
}

impl[P: Allocator] Response[P] {
    // `with_status` returns this response with `status` in place of its own.
    pub fn with_status(sink self: Self, status: Status) -> Response[P] where carries(self) {
        Self { answer = copy(status), ..self }
    }
}

test fn a_response_takes_another_status() {
    defer let arena = mem.Arena.open(mem.system(), size: 4096)
    let sent = new_request(arena.handle(), "POST", "/items", body: "").unwrap()
    let response = text(sent.request(), "made").unwrap().with_status(.Created)
    testing.assert_eq(response.status(), Status.Created, "the status did not change")?
    testing.assert_eq(held_text(response), Option.Some("made"), "changing the status changed the body")?
    .Ok(())
}

impl[P: Allocator] Response[P] {
    // Replace every value of `name`, compared under ASCII case folding. A
    // handler that propagates a refusal with `?` answers 500.
    pub fn set_header(inout self: Self, name: Str, value: Str) -> Result[(), HeaderError] where carries() {
        &self.headers.set(name, value)
    }
}

test fn set_header_replaces_every_value_of_a_name() {
    defer let arena = mem.Arena.open(mem.system(), size: 4096)
    let sent = new_request(arena.handle(), "GET", "/", body: "").unwrap()
    var response = text(sent.request(), "ok").unwrap()
    let set = &response.set_header("Cache-Control", "no-store")
    let replaced = &response.set_header("cache-control", "max-age=60")
    let framing = &response.set_header("Content-Length", "2")
    testing.assert_ok_eq(set, (), "setting failed")?
    testing.assert_ok_eq(replaced, (), "replacing failed")?
    testing.assert_eq(framing, .Err(HeaderError.Framing), "a framing header was accepted")?
    testing.assert_eq(response.header("Cache-Control"), Option.Some("max-age=60"), "the header kept an old value")?
    .Ok(())
}

impl[P: Allocator] Response[P] {
    // Append a value, keeping any the name already has.
    pub fn add_header(inout self: Self, name: Str, value: Str) -> Result[(), HeaderError] where carries() {
        &self.headers.add(name, value)
    }
}

test fn add_header_keeps_the_values_a_name_already_has() {
    defer let arena = mem.Arena.open(mem.system(), size: 4096)
    let sent = new_request(arena.handle(), "GET", "/", body: "").unwrap()
    var response = text(sent.request(), "ok").unwrap()
    let first = &response.add_header("Vary", "Accept")
    let second = &response.add_header("vary", "Origin")
    testing.assert_ok_eq(first, (), "adding failed")?
    testing.assert_ok_eq(second, (), "adding a second value failed")?
    testing.assert_eq(response.header("Vary"), Option.Some("Accept"), "the first value was replaced")?
    .Ok(())
}

impl[P: Allocator] Response[P] {
    // Drop every value of `name`, compared under ASCII case folding.
    pub fn remove_header(inout self: Self, name: Str) -> () {
        &self.headers.remove(name)
    }
}

test fn remove_header_drops_every_value_of_a_name() {
    defer let arena = mem.Arena.open(mem.system(), size: 4096)
    let sent = new_request(arena.handle(), "GET", "/", body: "").unwrap()
    var response = text(sent.request(), "ok").unwrap()
    &response.add_header("Vary", "Accept").unwrap()
    &response.add_header("vary", "Origin").unwrap()
    &response.add_header("Allow", "GET").unwrap()
    &response.remove_header("VARY")
    testing.assert_eq(response.header("Vary"), .None, "a removed header survived")?
    testing.assert_eq(response.header("Allow"), Option.Some("GET"), "another header was removed")?
    .Ok(())
}

impl[P: Allocator] Response[P] {
    // `header` returns the first value of `name`, compared under ASCII case
    // folding.
    pub fn header(self: Self, name: Str) -> Option[Str] where borrows(.Some: self) {
        self.headers.get(name)
    }
}

test fn header_reads_the_first_value_under_ascii_case_folding() {
    defer let arena = mem.Arena.open(mem.system(), size: 4096)
    let sent = new_request(arena.handle(), "GET", "/", body: "").unwrap()
    let response = json(sent.request(), Greeting { hello = "hi" }).unwrap()
    testing.assert_eq(response.header("CONTENT-TYPE"), Option.Some("application/json"), "a header name matched only in its own case")?
    testing.assert_eq(response.header("Cache-Control"), .None, "an absent header was found")?
    .Ok(())
}

impl[P: Allocator] Response[P] {
    // `status` returns the status this response answers with.
    pub fn status(self: Self) -> Status {
        copy(self.answer)
    }
}

test fn a_response_reads_its_status() {
    defer let arena = mem.Arena.open(mem.system(), size: 4096)
    let sent = new_request(arena.handle(), "GET", "/", body: "").unwrap()
    let held = text(sent.request(), "abc").unwrap().with_status(.Accepted)
    testing.assert_eq(held.status(), Status.Accepted, "the status changed")?
    .Ok(())
}

impl[P: Allocator] Response[P] {
    // `body` returns the body held in the arena, or `None` for a streamed body,
    // which exists only as it is written.
    pub fn body(self: Self) -> Option[mem.Slice[UInt8]] where borrows(.Some: self) {
        match read self.content {
            Held(bytes) => .Some(bytes.as_slice()),
            Streamed(_) => .None,
        }
    }
}

test fn a_response_reads_its_held_body_and_no_streamed_one() {
    defer let arena = mem.Arena.open(mem.system(), size: 4096)
    let sent = new_request(arena.handle(), "GET", "/", body: "").unwrap()
    let held = text(sent.request(), "abc").unwrap()
    let streamed = stream(sent.request(), count_to_three).unwrap()
    testing.assert_eq(held_text(held), Option.Some("abc"), "the held body changed")?
    testing.assert(streamed.body().is_none(), "a streamed body was held")?
    .Ok(())
}

impl[P: Allocator] Response[P] {
    // `recorded_body` produces the whole body in the request's arena and
    // returns it, running a streamed body's closure into memory, so a test
    // reads what a client would receive after the head. An error the closure
    // returns is returned.
    pub fn recorded_body(sink self: Self) -> Result[Vec[UInt8, mem.Handle[P]], Error[P]] where carries(self) {
        let Response { answer: _, headers: _, content } = self
        let stream = match content {
            Held(bytes) => return .Ok(bytes),
            Streamed(stream) => stream,
        }
        let recorded: Vec[UInt8, mem.Handle[P]] = Vec.new_in(stream.request.allocator())
        var body: BodyWriter[P] = .{ output = .Recorded(recorded), answering = copy(stream.request), failure = .None, in_body = true, body_bytes = 0 }
        let produced = produce_into(&body, stream)
        let BodyWriter { output, answering: _, failure: _, in_body: _, body_bytes: _ } = body
        let bytes = match output {
            Recorded(bytes) => bytes,
            Connection(writer) => {
                let _closed = writer.abort().close()
                panic("a recording wrote to a connection")
            },
            Taken => panic("a body's output was not put back"),
        }
        produced?
        .Ok(bytes)
    }
}

test fn a_recorded_body_is_what_a_client_would_read() {
    defer let arena = mem.Arena.open(mem.system(), size: 4096)
    let sent = new_request(arena.handle(), "GET", "/count?to=2", body: "").unwrap()
    let streamed = stream(sent.request(), count_to_query).unwrap().recorded_body().unwrap()
    let last: UInt64 = 3
    let captured = stream(sent.request(), inout [sink last] |inout body| count_to(last, &body)).unwrap().recorded_body().unwrap()
    let held = text(sent.request(), "held").unwrap().recorded_body().unwrap()
    let failed = stream(sent.request(), fail_after_one).unwrap().recorded_body()
    testing.assert_ok_eq(Str.from_bytes(streamed.as_slice()), "1\n2\n", "the streamed body changed")?
    testing.assert_ok_eq(Str.from_bytes(captured.as_slice()), "1\n2\n3\n", "the captured number did not reach the body")?
    testing.assert_ok_eq(Str.from_bytes(held.as_slice()), "held", "the held body changed")?
    testing.assert(match read failed { Ok(_) => false, Err(error) => error.status() == Status.InternalServerError }, "a failed stream was recorded as whole")?
    .Ok(())
}

// A `BodyWriter` writes a response to its connection through a buffer in the
// exchange's arena. A streamed body is written through it, with `Writer` for
// text, interpolation and `json_format.write`; the first write that fails is
// reported by every later one. Once `in_body` is set, after the head, it counts
// the bytes it accepts in `body_bytes`.
@(opaque, linear)
struct BodyWriter[P: Allocator = mem.SystemAllocator] {
    output: Output[P],
    answering: Request[P],
    failure: Option[io.IoError],
    in_body: Bool,
    body_bytes: UInt64,
}

// A body goes to its connection through a buffer, or, when a test records it,
// into bytes in the request's arena. A write takes the output out, leaving
// `Taken` in its place, and puts it back through `put_output`.
enum Output[P: Allocator] {
    Connection(io.BufferedWriter[net.Connection, mem.Handle[P]]),
    Recorded(Vec[UInt8, mem.Handle[P]]),
    Taken,
}

// `put_output` puts `next` back in `slot`, which must hold `Taken`. Nothing
// else can be there, since every write takes the output out and puts it back
// before returning, and a panic says so if that is ever broken.
fn put_output[P: Allocator](inout slot: Output[P], sink next: Output[P]) -> () where retains(slot: next) {
    match mem.exchange(&slot, next) {
        Taken => {},
        Connection(writer) => {
            let _closed = writer.abort().close()
            panic("a body's output was put back twice")
        },
        Recorded(_) => panic("a body's output was put back twice"),
    }
}

impl[P: Allocator] BodyWriter[P] {
    // `request` returns the request the streamed body answers.
    pub fn request(self: Self) -> Request[P] where carries(self) {
        copy(self.answering)
    }
}

test fn a_streamed_body_reads_its_request() {
    defer let received = exchanged(.Get, stream_of("/count?to=2", count_to_query))
    testing.assert_eq(received.view(), "HTTP/1.1 200 OK\r\nConnection: close\r\nContent-Type: text/plain; charset=utf-8\r\n\r\n1\n2\n", "the body did not read its request")?
    .Ok(())
}

impl[P: Allocator] BodyWriter[P] {
    // Buffer the writing of a response to `connection`, which answers
    // `request`, in the request's arena. A refused buffer returns the
    // connection.
    fn open(sink connection: net.Connection, request: Request[P]) -> Result[BodyWriter[P], io.BufferOpenFailure[net.Connection]] where carries(.Ok: request), carries(.Err.resource: connection) {
        let output = io.BufferedWriter.open_in(request.allocator(), capacity: response_buffer_bytes, writer: connection)?
        .Ok(.{ output = .Connection(output), answering = copy(request), failure = .None, in_body = false, body_bytes = 0 })
    }

    // Send what is buffered and return the connection, which the caller
    // closes. A write that failed earlier is reported rather than repeated.
    fn finish(sink self: Self) -> Result[net.Connection, ResponseFailure] {
        let BodyWriter { output: target, answering: _, failure, in_body: _, body_bytes: _ } = self
        let output = connection_of(target)
        match failure {
            Some(error) => .Err(.{ connection = output.abort(), error }),
            None => match output.finish() {
                Ok(connection) => .Ok(connection),
                Err(failed) => {
                    let FinishFailure { writer, failure } = failed
                    return .Err(.{ connection = writer.abort(), error = failure.into() })
                },
            },
        }
    }

    // Drop what is buffered and return the connection, which the caller
    // resets so the client sees the body was cut short.
    fn abandon(sink self: Self) -> net.Connection {
        let BodyWriter { output, answering: _, failure: _, in_body: _, body_bytes: _ } = self
        connection_of(output).abort()
    }

    // Record a failed write; every later write reports the same error.
    fn fail(inout self: Self, failure: WriteFailure[io.IoError]) -> () {
        self.failure = .Some(io.IoError.from(copy(failure)))
    }
}

// `connection_of` returns the buffered connection a body is written to; only
// `serve` finishes or abandons a body, and its bodies write to a connection.
fn connection_of[P: Allocator](sink output: Output[P]) -> io.BufferedWriter[net.Connection, mem.Handle[P]] where carries(output) {
    match output {
        Connection(writer) => writer,
        Recorded(_) => panic("a recorded body has no connection"),
        Taken => panic("a body's output was not put back"),
    }
}

// `record` appends `bytes` to a recorded body. Running out of arena fails the
// write as running out of any resource does.
fn record[P: Allocator](inout recorded: Vec[UInt8, mem.Handle[P]], bytes: mem.Slice[UInt8]) -> Result[UInt64, WriteFailure[io.IoError]] where carries() {
    let exhausted: io.IoError = .{ operation = .Write, category = .ResourceExhausted, code = .None, progress = 0 }
    if &recorded.reserve(bytes.length()).is_err() {
        return .Err(.{ kind = .Underlying, reason = .Some(exhausted), written = 0 })
    }
    for byte in copy(bytes) {
        let _pushed = &recorded.push(*byte)
    }
    .Ok(bytes.length())
}

// A `ResponseFailure` hands back a connection whose response could not be
// delivered, which is still owed a close.
@linear
struct ResponseFailure {
    connection: net.Connection,
    error: io.IoError,
}

impl[P: Allocator] io.ByteWriter for BodyWriter[P] {
    type Error = io.IoError

    fn pending_bytes(self: Self) -> UInt64 {
        match read self.output {
            Connection(writer) => writer.pending_bytes(),
            Recorded(_) => 0,
            Taken => 0,
        }
    }

    fn write_some(inout self: Self, bytes: mem.Slice[UInt8]) -> Result[UInt64, WriteFailure[io.IoError]] where carries() {
        match read self.failure {
            Some(error) => return .Err(.{ kind = .Underlying, reason = .Some(copy(error)), written = 0 }),
            None => {},
        }
        let written = match mem.exchange(&self.output, .Taken) {
            Connection(buffered) => {
                var writer = buffered
                let written = &writer.write_some(bytes)
                put_output(&self.output, .Connection(writer))
                written
            },
            Recorded(recorded) => {
                var kept = recorded
                let written = record(&kept, bytes)
                put_output(&self.output, .Recorded(kept))
                written
            },
            Taken => panic("a body's output was not put back"),
        }
        match written {
            Ok(count) => {
                if self.in_body {
                    self.body_bytes += count
                }
                return .Ok(count)
            },
            Err(failure) => {
                &self.fail(failure)
                return .Err(failure)
            },
        }
    }

    fn flush(inout self: Self) -> Result[UInt64, WriteFailure[io.IoError]] where carries() {
        match read self.failure {
            Some(error) => return .Err(.{ kind = .Underlying, reason = .Some(copy(error)), written = 0 }),
            None => {},
        }
        let flushed = match mem.exchange(&self.output, .Taken) {
            Connection(buffered) => {
                var writer = buffered
                let flushed = &writer.flush()
                put_output(&self.output, .Connection(writer))
                flushed
            },
            Recorded(recorded) => {
                put_output(&self.output, .Recorded(recorded))
                Result.Ok(UInt64(0))
            },
            Taken => panic("a body's output was not put back"),
        }
        match flushed {
            Ok(count) => .Ok(count),
            Err(failure) => {
                &self.fail(failure)
                return .Err(failure)
            },
        }
    }
}

// Text written to a body goes to the connection, so interpolation, `fmt` and
// `json_format.write` stream the body. A failed write is an `io.IoError`, which
// `?` converts into a 500 `Error`.
impl[P: Allocator] Writer for BodyWriter[P] {
    type Error = io.IoError

    fn write_str(inout self: Self, s: Str) -> Result[(), io.IoError] where carries() {
        let _written = io.write_all(&self, s.as_bytes())?
        .Ok(())
    }
}

test fn a_failed_write_is_reported_by_every_later_write() {
    var listener = net.listen(net.loopback(0)).unwrap()
    let client = net.connect(listener.local_address().unwrap()).unwrap()
    let Accepted { connection, address: _ } = &listener.accept().unwrap()
    // A connection shut down for writing refuses every write to it.
    var server = connection
    &server.shutdown_write().unwrap()
    defer let arena = mem.Arena.open(mem.system(), size: 16384)
    let sent = new_request(arena.handle(), "GET", "/", body: "").unwrap()
    var body = BodyWriter.open(server, sent.request()).unwrap()
    // A chunk larger than the buffer is sent before the write returns.
    defer let chunk = Vec.filled(response_buffer_bytes + 1, UInt8(120)).unwrap()
    let failed = &body.write_str(Str.from_bytes(chunk.as_slice()).unwrap())
    let later = &body.write_str("y")
    let reported: Option[io.IoError] = match body.finish() {
        Ok(connection) => {
            connection.close().unwrap()
            Option.None
        },
        Err(failure) => {
            let ResponseFailure { connection, error } = failure
            let _closed = connection.close()
            Option.Some(error)
        },
    }
    client.close().unwrap()
    listener.close().unwrap()
    // EPIPE is 32 on Linux and macOS alike. The first write filled the
    // 4 KiB buffer before sending failed, so it reports that progress; the
    // failing send itself accepted no bytes, which is what is recorded.
    let broken_pipe = io.IoError { operation = .Write, category = .BrokenPipe, code = .Some(32), progress = 0 }
    let filled = io.IoError { operation = .Write, category = .BrokenPipe, code = .Some(32), progress = response_buffer_bytes }
    testing.assert_eq(failed, .Err(filled), "a refused write succeeded")?
    testing.assert_eq(later, .Err(copy(broken_pipe)), "a write after the failure succeeded")?
    testing.assert_eq(reported, Option.Some(broken_pipe), "finishing did not report the failure")?
    .Ok(())
}

// A response is not written whole when the connection fails (`Io`) or when the
// closure streaming its body returns an error after the head was sent
// (`Stream`).
enum WriteError[P: Allocator] {
    Io(io.IoError),
    Stream(Error[P]),
}

// Write a handler's `response` to `body`: the status line, `Connection:
// close`, the headers in order, a plain-text `Content-Type` when they name
// none, and the body. For a HEAD request the head is written alone.
fn write_response[P: Allocator](inout body: BodyWriter[P], sink response: Response[P], head_only: Bool) -> Result[(), WriteError[P]] where carries(.Err: body, response), retains(body: response) {
    let Response { answer, headers, content } = response
    let _written = write_head(&body, answer, headers) else |failure| {
        return .Err(.Io(failure.into()))
    }
    body.in_body = true
    if head_only {
        return .Ok(())
    }
    match content {
        Held(bytes) => match io.write_all(&body, bytes.as_slice()) {
            Ok(_) => .Ok(()),
            Err(failure) => .Err(.Io(failure.into())),
        },
        Streamed(stream) => match produce_into(&body, stream) {
            Ok(_) => .Ok(()),
            Err(error) => match read body.failure {
                Some(failed) => .Err(.Io(copy(failed))),
                None => .Err(.Stream(error)),
            },
        },
    }
}

// Run a streamed body's closure into `body`, then release what it captured.
// The closure reads the request its handler answered, which holds the path
// values a router matched.
fn produce_into[P: Allocator](inout body: BodyWriter[P], sink stream: Stream[P]) -> Result[(), Error[P]] where carries(.Err: body, stream), retains(body: stream) {
    let Stream { request, produce } = stream
    body.answering = request
    var write = produce
    let produced = &write(&body)
    write.release()
    produced
}

test fn a_held_body_follows_the_head() {
    defer let received = exchanged(.Get, text_of("hi"))
    testing.assert_eq(received.view(), "HTTP/1.1 200 OK\r\nConnection: close\r\nContent-Type: text/plain; charset=utf-8\r\n\r\nhi", "the response changed")?
    .Ok(())
}

test fn headers_go_out_in_order_before_the_default_content_type() {
    defer let received = exchanged(.Get, headed)
    testing.assert_eq(received.view(), "HTTP/1.1 201 Created\r\nConnection: close\r\nVary: Accept\r\nX-Kind: test\r\nVary: Origin\r\nContent-Type: text/plain; charset=utf-8\r\n\r\nmade", "the headers changed")?
    .Ok(())
}

test fn a_head_request_is_answered_with_the_head_alone() {
    defer let held = exchanged(.Head, text_of("hidden"))
    defer let streamed = exchanged(.Head, stream_of("/count", count_to_three))
    testing.assert_eq(held.view(), "HTTP/1.1 200 OK\r\nConnection: close\r\nContent-Type: text/plain; charset=utf-8\r\n\r\n", "a HEAD response sent a held body")?
    testing.assert_eq(streamed.view(), "HTTP/1.1 200 OK\r\nConnection: close\r\nContent-Type: text/plain; charset=utf-8\r\n\r\n", "a HEAD response streamed a body")?
    .Ok(())
}

test fn a_streamed_body_follows_the_head() {
    defer let received = exchanged(.Get, stream_of("/count", count_to_three))
    testing.assert_eq(received.view(), "HTTP/1.1 200 OK\r\nConnection: close\r\nContent-Type: text/plain; charset=utf-8\r\n\r\n1\n2\n3\n", "the streamed body changed")?
    .Ok(())
}

// A body larger than the arena streams through the 4 KiB buffer.
test fn a_streamed_body_may_exceed_the_arena() {
    let listener = net.listen(net.loopback(0)).unwrap()
    let client = net.connect(listener.local_address().unwrap()).unwrap()
    var accepting = listener
    let Accepted { connection, address: _ } = &accepting.accept().unwrap()
    // The message and the 4 KiB buffer fill most of this 8 KiB arena.
    let arena = mem.Arena.open(mem.system(), size: 8192)
    let sent = new_request(arena.handle(), "GET", "/", body: "").unwrap()
    var body = BodyWriter.open(connection, sent.request()).unwrap()
    let streamed = write_response(&body, stream(sent.request(), a_thousand_lines).unwrap(), head_only: false).is_ok()
    let server = body.finish().unwrap()
    server.close().unwrap()
    arena.release()
    var reader = client
    let bytes = io.read_all(&reader, max_bytes: 65536).unwrap()
    let length = bytes.length()
    bytes.release()
    reader.close().unwrap()
    accepting.close().unwrap()
    let head = "HTTP/1.1 200 OK\r\nConnection: close\r\nContent-Type: text/plain; charset=utf-8\r\n\r\n"
    testing.assert(streamed, "the stream failed")?
    // Each of the thousand lines is 20 bytes: nineteen letters and a newline.
    testing.assert_eq(length, head.length() + 20000, "the streamed body was cut short")?
    .Ok(())
}

test fn an_error_is_answered_with_its_message() {
    defer let messaged = exchanged(.Get, refused_with_message)
    defer let bare = exchanged(.Get, refused)
    defer let head = exchanged(.Head, refused_with_message)
    testing.assert_eq(messaged.view(), "HTTP/1.1 400 Bad Request\r\nConnection: close\r\nContent-Type: text/plain; charset=utf-8\r\n\r\nthe body is not JSON\n", "the message was not sent")?
    testing.assert_eq(bare.view(), "HTTP/1.1 422 Unprocessable Content\r\nConnection: close\r\nContent-Type: text/plain; charset=utf-8\r\n\r\nUnprocessable Content\n", "the reason phrase was not sent")?
    testing.assert_eq(head.view(), "HTTP/1.1 400 Bad Request\r\nConnection: close\r\nContent-Type: text/plain; charset=utf-8\r\n\r\n", "a HEAD error sent a body")?
    .Ok(())
}

test fn an_error_is_answered_with_its_headers() {
    defer let challenge = exchanged(.Get, challenged)
    testing.assert_eq(challenge.view(), "HTTP/1.1 401 Unauthorized\r\nConnection: close\r\nWWW-Authenticate: Bearer\r\nContent-Type: text/plain; charset=utf-8\r\n\r\nsign in first\n", "the error's header was not sent")?
    .Ok(())
}

// An error the stream returns after the head leaves the body as it stands.
test fn a_stream_that_fails_stops_where_it_stands() {
    defer let received = exchanged(.Get, stream_of("/count", fail_after_one))
    testing.assert_eq(received.view(), "HTTP/1.1 200 OK\r\nConnection: close\r\nContent-Type: text/plain; charset=utf-8\r\n\r\n1\n", "a failed stream wrote past its failure")?
    .Ok(())
}

// Answer a handler's `error`: its status, and its message or reason phrase
// with a newline as a plain-text body. For a HEAD request the head is written
// alone.
fn write_error[P: Allocator](inout body: BodyWriter[P], error: Error[P], head_only: Bool) -> Result[(), WriteError[P]] where carries() {
    let head = match read error.headers {
        Some(headers) => write_head(&body, error.status(), headers),
        None => {
            let empty: ResponseHeaders[mem.Handle[P]] = ResponseHeaders.open(body.answering.allocator())
            write_head(&body, error.status(), empty)
        },
    }
    let _written = head else |failure| {
        return .Err(.Io(failure.into()))
    }
    body.in_body = true
    if head_only {
        return .Ok(())
    }
    let message = error.message().unwrap_or(error.status().reason())
    // A failed write is recorded in `body`, which reports it below.
    let _wrote = io.write_all(&body, message.as_bytes()).is_ok() && io.write_all(&body, "\n".as_bytes()).is_ok()
    match read body.failure {
        Some(failed) => .Err(.Io(copy(failed))),
        None => .Ok(()),
    }
}

// Write the status line and headers, ending with the empty line, and answer
// how many bytes that was. A failure counts every byte the head accepted.
fn write_head[W: io.ByteWriter, A: Allocator](inout writer: W, status: Status, headers: ResponseHeaders[A]) -> Result[UInt64, WriteFailure[W.Error]] where carries(.Err: writer) {
    var written: UInt64 = 0
    put(&writer, &written, "HTTP/1.1 ")?
    let code = status.code()
    put(&writer, &written, digit(code / 100))?
    put(&writer, &written, digit(code / 10 % 10))?
    put(&writer, &written, digit(code % 10))?
    put(&writer, &written, " ")?
    put(&writer, &written, status.reason())?
    put(&writer, &written, "\r\nConnection: close\r\n")?
    for header in headers.fields.as_slice() {
        put(&writer, &written, header.name.view())?
        put(&writer, &written, ": ")?
        put(&writer, &written, header.value.view())?
        put(&writer, &written, "\r\n")?
    }
    if headers.get("Content-Type").is_none() {
        put(&writer, &written, "Content-Type: ")?
        put(&writer, &written, default_content_type)?
        put(&writer, &written, "\r\n")?
    }
    put(&writer, &written, "\r\n")?
    .Ok(written)
}

// Write `piece` and add its length to `written`; a failure counts what came
// before it as well.
fn put[W: io.ByteWriter](inout writer: W, inout written: UInt64, piece: Str) -> Result[(), WriteFailure[W.Error]] where carries(.Err: writer) {
    match io.write_all(&writer, piece.as_bytes()) {
        Ok(count) => {
            written += count
            return .Ok(())
        },
        Err(failure) => .Err(progressed(failure, written)),
    }
}

// Add `before` to the bytes a write failure reports as written, so it counts
// what the earlier pieces of the head wrote.
fn progressed[E](sink failure: WriteFailure[E], before: UInt64) -> WriteFailure[E] where carries(failure) {
    let WriteFailure { kind, reason, written } = failure
    .{ kind, reason, written = before + written }
}

// `digit` spells `value`, which is below 10, as one decimal digit.
fn digit(value: UInt16) -> Str {
    "0123456789".slice(UInt64(value), UInt64(value) + 1).unwrap()
}

// `held_text` reads the body `response` holds as text.
fn held_text[P: Allocator](response: Response[P]) -> Option[Str] where borrows(.Some: response) {
    match response.body() {
        Some(bytes) => match Str.from_bytes(bytes) {
            Ok(text) => .Some(text),
            Err(_) => .None,
        },
        None => .None,
    }
}

// `text_of` describes a test answer with a text body.
fn text_of(body: Str) -> Reply {
    .{ target = "/", body = copy(body), produce = .None }
}

// `stream_of` describes a test answer whose body `produce` streams.
fn stream_of(target: Str, produce: fn(inout body: BodyWriter) -> Result[(), Error]) -> Reply {
    .{ target = copy(target), body = "", produce = .Some(copy(produce)) }
}

// A `Reply` gives a test's request target, and either a text body or a
// function streaming one.
@copyable
struct Reply {
    target: Str,
    body: Str,
    produce: Option[fn(inout body: BodyWriter) -> Result[(), Error]],
}

// `headed` answers 201 with headers in the order they were added.
let headed: Reply = .{ target = "/headed", body = "made", produce = .None }

// `refused_with_message` refuses with 400 and a message, and `refused` with
// 422 and its reason phrase.
let refused_with_message: Reply = .{ target = "/refused-with-message", body = "", produce = .None }

let refused: Reply = .{ target = "/refused", body = "", produce = .None }

// `challenged` refuses with 401 and the scheme to authenticate with.
let challenged: Reply = .{ target = "/challenged", body = "", produce = .None }

// `counted_to_four` streams the numbers 1 to 4, the 4 captured by the body's
// closure.
let counted_to_four: Reply = .{ target = "/count-to-four", body = "", produce = .None }

// Stream the numbers 1 to 3, one per line.
fn count_to_three[P: Allocator](inout body: BodyWriter[P]) -> Result[(), Error[P]] {
    for number in 1..=3 {
        "{number}\n".fmt(&body)?
    }
    .Ok(())
}

// Count to `last`, which the handler captured.
fn count_to[P: Allocator](last: UInt64, inout body: BodyWriter[P]) -> Result[(), Error[P]] {
    for number in 1..=last {
        "{number}\n".fmt(&body)?
    }
    .Ok(())
}

// Count to the number the query's `to=` names.
fn count_to_query[P: Allocator](inout body: BodyWriter[P]) -> Result[(), Error[P]] {
    let query = body.request().query().unwrap_or("to=0")
    let sliced = query.slice(3, query.length()).unwrap_or("0")
    let parsed = sliced.parse[UInt64]()
    let last = parsed.unwrap_or(0)
    for number in 1..=last {
        "{number}\n".fmt(&body)?
    }
    .Ok(())
}

// Stream a thousand lines of 20 bytes each.
fn a_thousand_lines[P: Allocator](inout body: BodyWriter[P]) -> Result[(), Error[P]] {
    for _ in 0..1000 {
        &body.write_str("abcdefghijklmnopqrs\n")?
    }
    .Ok(())
}

// Write one line, then fail the stream with 500.
fn fail_after_one[P: Allocator](inout body: BodyWriter[P]) -> Result[(), Error[P]] {
    &body.write_str("1\n")?
    .Err(Error.new(.InternalServerError))
}

// `answered` builds the response `answer` describes for a request to its
// target.
fn answered(request: Request, answer: Reply) -> Result[Response, Error] where carries(request, answer) {
    match copy(answer.produce) {
        Some(produce) => return stream(request, produce),
        None => {},
    }
    if answer.target == "/headed" {
        var response = text(request, answer.body)?.with_status(.Created)
        &response.add_header("Vary", "Accept")?
        &response.add_header("X-Kind", "test")?
        &response.add_header("Vary", "Origin")?
        return .Ok(response)
    }
    if answer.target == "/refused-with-message" {
        return .Err(error(request, .BadRequest, "the body is not JSON"))
    }
    if answer.target == "/count-to-four" {
        let last: UInt64 = 4
        return stream(request, inout [sink last] |inout body| count_to(last, &body))
    }
    if answer.target == "/refused" {
        return .Err(Error.new(.Other(Code(422))))
    }
    if answer.target == "/challenged" {
        var refusal = error(request, .Unauthorized, "sign in first")
        &refusal.set_header(request, "WWW-Authenticate", "Bearer")?
        return .Err(refusal)
    }
    text(request, answer.body)
}

// Answer a request of `method` as `answer` describes, over a self-connected
// pair, and return every byte the client received.
fn exchanged(method: Method, answer: Reply) -> String {
    var listener = net.listen(net.loopback(0)).unwrap()
    // The backlog queues the connection before accept is called.
    let client = net.connect(listener.local_address().unwrap()).unwrap()
    let Accepted { connection, address: _ } = &listener.accept().unwrap()
    let arena = mem.Arena.open(mem.system(), size: 65536)
    let token = if method == Method.Head {
        "HEAD"
    } else {
        "GET"
    }
    let sent = new_request(arena.handle(), token, answer.target, body: "").unwrap()
    var body = BodyWriter.open(connection, sent.request()).unwrap()
    let head_only = method == Method.Head
    let _wrote = match answered(sent.request(), answer) {
        Ok(response) => write_response(&body, response, head_only),
        Err(error) => write_error(&body, error, head_only),
    }
    let server = body.finish().unwrap()
    server.close().unwrap()
    arena.release()
    let received = read_to_end(client)
    listener.close().unwrap()
    received
}

// Read a connection until its peer closes it, then close it.
fn read_to_end(sink connection: net.Connection) -> String {
    var reader = connection
    // Every response a test sends is under 4 KiB.
    let text = io.read_text(&reader, max_bytes: 4096).unwrap()
    reader.close().unwrap()
    text
}

// Read a connection until its peer closes or resets it, then close it. A
// reset answers "reset", so a test can tell a body cut short from a whole one.
fn read_or_reset(sink connection: net.Connection) -> String {
    var reader = connection
    let outcome = io.read_text(&reader, max_bytes: 4096)
    let _closed = reader.close()
    match outcome {
        Ok(text) => text,
        Err(_) => "reset".to_owned().unwrap(),
    }
}
