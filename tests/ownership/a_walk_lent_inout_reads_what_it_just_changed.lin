// `for inout` lends each element through `list`, which stays the element's one
// path while the body changes it, as an `inout` parameter does. Reading the
// element after `push` reads what is there now; a slice taken before the
// `push` would not survive it.
fn main() -> UInt8 {
    var held: [Vec[UInt8]; 2] = [Vec.new(), Vec.new()]
    var total: UInt64 = 0
    for inout list in held {
        // A push that fails leaves the list as it was, which the sum shows.
        let _pushed = &list.push(1)
        total += list.as_slice().length()
    }
    for list in held {
        list.release()
    }
    UInt8(total) - 2
}
