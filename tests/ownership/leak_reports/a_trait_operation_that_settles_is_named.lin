// `Release` is in scope and `Crate` implements it, so `crate.release()` is
// named as what settles the crate.
@linear
struct Crate {
    kilograms: UInt8,
}

impl Release for Crate {
    fn release(sink self: Self) {
        let Crate { kilograms: _ } = self
    }
}

fn weigh(crate: Crate) -> UInt8 {
    crate.kilograms
}

fn main() -> UInt8 {
    let crate = Crate { kilograms = 40 }
    weigh(crate)
}
