import std.mem

// `any_inout` borrows the predicate, so `main` recovers the vector it owns
// and releases it.
fn main() -> UInt8 {
    let seen = mem.Vec.filled(mem.system(), 2, UInt64(7)) else |_| {
        return 1
    }
    var heavy = [sink seen] |sink weight: UInt64| weight > seen.length()
    let found = (UInt64(1)..10).any_inout(&heavy)
    let { seen } = heavy.into_captures()
    seen.release()
    if found {
        0
    } else {
        3
    }
}
