// Every iterator is a sequence whose `iterate` hands the same iterator back,
// so the walk's help names `release`, the operation that settles a
// `Countdown`.
@linear
struct Countdown { left: UInt64 }

impl Release for Countdown {
    fn release(sink self: Self) {
        let Countdown { left: _ } = self
    }
}

impl Iterator for Countdown {
    type Item = UInt64

    fn next(inout self: Self) -> Option[UInt64] {
        if self.left == 0 {
            return .None
        }
        self.left -= 1
        .Some(self.left)
    }
}

fn main() -> UInt8 {
    let countdown = Countdown { left = 3 }
    var total: UInt64 = 0
    for x in countdown {
        total += x
    }
    UInt8(total)
}
