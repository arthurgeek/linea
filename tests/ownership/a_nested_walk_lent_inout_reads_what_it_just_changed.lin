// The inner walk lends each list through `row`, which the outer walk lends
// through `grid`. Changing a list keeps both lends: each stays the one path to
// what it names, so the list is read again right after the push.
fn main() -> UInt8 {
    var grid: [[Vec[UInt8]; 2]; 2] = [[Vec.new(), Vec.new()], [Vec.new(), Vec.new()]]
    var total: UInt64 = 0
    for inout row in grid {
        for inout list in row {
            let _p = &list.push(1)
            total += list.as_slice().length()
        }
    }
    for row in grid {
        for list in row {
            list.release()
        }
    }
    UInt8(total) - 4
}
