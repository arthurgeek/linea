struct Wrapper[C] {
    inner: C,
}

impl[Wrapper: Index[UInt64]] Index[UInt64] for Wrapper[Wrapper] {
    type Elem = Wrapper.Elem

    proj at(inout self: Wrapper[Wrapper], i: UInt64) -> Wrapper.Elem {
        self.inner[i]
    }
}

fn main() -> UInt8 {
    var wrapped: Wrapper[[UInt8; 2]] = .{ inner = [2, 3] }
    wrapped[0] += 1
    return wrapped[0] + wrapped[1] - 6
}
