// `arr[0 + 1]` and `arr[^(0 + 1)]` fold to element 1, the borrow of `y`, so
// changing `x` leaves what they read good to use.
struct Box { value: UInt64 }

fn bump(inout b: Box) {
    b.value = b.value + 1
}

fn main() -> UInt8 {
    var x = Box { value = 1 }
    var y = Box { value = 2 }
    let arr = [borrow x.value, borrow y.value]
    bump(&x)
    UInt8(*arr[0 + 1]) + UInt8(*arr[^(0 + 1)])
}
