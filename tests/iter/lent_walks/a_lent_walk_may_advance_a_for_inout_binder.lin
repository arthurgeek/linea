// Each grower is lent to the outer walk, and the inner walk advances that
// same lent place, as `&g.next()` would.
import std.io
import std.mem

struct Grower {
    values: Vec[UInt64, mem.SystemAllocator],
    left: UInt64,
}

impl Iterator for Grower {
    type Item = UInt64

    fn next(inout self: Self) -> Option[UInt64] {
        if self.left == 0 {
            return .None
        }
        self.left -= 1
        var i: UInt64 = 0
        while i < 64 {
            &self.values.push(i).unwrap()
            i += 1
        }
        .Some(self.left)
    }
}

fn start() -> Grower {
    var values: Vec[UInt64, mem.SystemAllocator] = Vec.new()
    &values.push(41).unwrap()
    Grower { values = values, left = 4 }
}

fn stop(sink g: Grower) -> () {
    let Grower { values: rest, left: _ } = g
    rest.release()
}

fn main() -> Result[UInt8, io.IoError] {
    var gs = [start(), start()]
    var total: UInt64 = 0
    for inout g in gs {
        for x in &g {
            total += x
        }
    }
    for g in gs {
        stop(g)
    }
    io.println("{total}")?
    .Ok(0)
}
