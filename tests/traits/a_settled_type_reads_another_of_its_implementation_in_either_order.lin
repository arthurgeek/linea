// A settled type may be written off another of its own implementation through
// `Self`, whichever of the two the trait declares first: `Self.Other` is the
// `UInt8` this implementation settles `Other` to.
struct Coins {
    count: UInt8,
}

struct Notes {
    count: UInt8,
}

trait Held {
    type Item
    type Other

    fn of(x: Self) -> Self.Item
}

trait Kept {
    type Other
    type Item

    fn of(x: Self) -> Self.Item
}

impl Held for Coins {
    type Item = Self.Other
    type Other = UInt8

    fn of(x: Self) -> Self.Item {
        x.count
    }
}

impl Kept for Notes {
    type Item = Self.Other
    type Other = UInt8

    fn of(x: Self) -> Self.Item {
        x.count
    }
}

fn main() -> UInt8 {
    let c: Coins = .{ count = 3 }
    let n: Notes = .{ count = 4 }
    Held.of(c) + Kept.of(n)
}
