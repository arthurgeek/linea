import std.testing

// `Limits` bounds what one request may make a server hold or wait for. A line
// counts its bytes including the CRLF or LF that ends it, and the body counts
// bytes. `max_query_pairs` bounds how many `name=value` pairs a query may
// hold, and `max_form_pairs` how many a body sent as
// `application/x-www-form-urlencoded` may, since the server decodes each into
// the arena. Timeouts are milliseconds, and zero waits forever.
// `first_byte_timeout_ms` bounds how long the server waits for the first byte
// after accepting a connection, so an idle speculative connection is closed
// without occupying a serving task. The dispatcher registers its buffered
// reader and a timer in the same wait set; readiness takes the connection
// out of that first-byte wait, and an expired timer closes it if its reader
// is still registered.
// `read_timeout_ms` bounds each request, head and body together, counted from
// when the dispatcher observes its reader ready, before queuing it for a
// serving task. This is an observed readiness time, not the arrival timestamp
// of a byte. A client that sends a byte at a time cannot restart the deadline.
// `write_timeout_ms` bounds each write separately.
// `idle_timeout_ms` bounds the longest a connection may stay idle between
// requests. `open_connections` bounds the most connections held at once,
// serving and idle together. `request_arena_bytes` is the size of the arena
// requests are served from: it holds the request head, server reservations,
// the handler's response and any body cache the handler requests. Incremental
// body reads need not collect the body there. The arena is rewound once the
// response is written and its body views have been settled.
// `connections` ends serving after that many connections; `.None` serves until
// the process ends.
@copyable
pub struct Limits {
    max_line_bytes: UInt64,
    max_headers: UInt64,
    max_query_pairs: UInt64,
    max_form_pairs: UInt64,
    max_body_bytes: UInt64,
    request_arena_bytes: UInt64,
    first_byte_timeout_ms: UInt64,
    read_timeout_ms: UInt64,
    write_timeout_ms: UInt64,
    idle_timeout_ms: UInt64,
    open_connections: UInt64,
    connections: Option[UInt64],
}

// The default limits allow 8 KiB lines, 100 headers, 100 query pairs, 100 form
// pairs, a 1 MiB body, a 48 MiB arena, a 500 ms wait for the first byte and
// five-second read and write timeouts, 15 seconds idle between requests and
// at most 1024 open connections. The arena holds the request's metadata and
// whatever its handler materializes, decodes or builds:
//
// - Startup admission conservatively budgets the bounded head, header and
//   query fields, and server reservations. It does not reserve the body or
//   decoded form fields: a streamed body may exceed the arena's size.
// - Materializing a body reserves its remaining bytes. A form also needs
//   decoded text and field storage. These optional allocations can fail even
//   when startup admission succeeds.
// - Decoding a JSON body with `http.Json` reserves up to 31 MiB for the
//   100,000 values `json.decode` admits, about 316 bytes a value, since an
//   array's storage doubles as it grows and keeps what it outgrew, and about
//   3 MiB for the text of a body a megabyte long. Both fit in 200 KiB and
//   1 MiB, so the body limit does not bound them.
// - The response shares the arena with that metadata, cache and decoded
//   data. The 48 MiB default leaves room for common full-body handlers;
//   `max_body_bytes` alone cannot bound what a handler allocates.
//
// The arena's size is a limit, not memory taken up front: it takes a 64 KiB
// first chunk from the parent when it opens and further chunks, each at least
// twice the last, only as a request needs them. Rewinding it once the response
// is written zeroes only what the request used and gives every chunk but the
// first back to the parent, so a serving task between requests holds 64 KiB
// whatever the largest request it answered. `serve` uses these limits when its
// caller gives none.
let standard_limits: Limits = .{
    max_line_bytes = 8192,
    max_headers = 100,
    max_query_pairs = 100,
    max_form_pairs = 100,
    max_body_bytes = 1048576,
    request_arena_bytes = 50331648,
    first_byte_timeout_ms = 500,
    read_timeout_ms = 5000,
    write_timeout_ms = 5000,
    idle_timeout_ms = 15000,
    open_connections = 1024,
    connections = .None,
}

// `Limits.default()` gives the standard limits described above. Write only the
// limits a server changes and take the rest from the default:
// `Limits { connections = .Some(1), ..Limits.default() }`.
impl Default for Limits {
    fn default() -> Limits {
        standard_limits
    }
}

test fn the_default_limits_bound_lines_headers_and_bodies() {
    let limits = Limits.default()
    testing.assert_eq(limits.max_line_bytes, UInt64(8192), "the line bound changed")?
    testing.assert_eq(limits.max_headers, UInt64(100), "the header bound changed")?
    testing.assert_eq(limits.max_query_pairs, UInt64(100), "the query bound changed")?
    testing.assert_eq(limits.max_form_pairs, UInt64(100), "the form bound changed")?
    testing.assert_eq(limits.max_body_bytes, UInt64(1048576), "the body bound changed")?
    testing.assert_eq(limits.first_byte_timeout_ms, UInt64(500), "the first-byte timeout changed")?
    testing.assert_eq(limits.read_timeout_ms, UInt64(5000), "the read timeout changed")?
    testing.assert_eq(limits.write_timeout_ms, UInt64(5000), "the write timeout changed")?
    testing.assert_eq(limits.idle_timeout_ms, UInt64(15000), "the idle timeout changed")?
    testing.assert_eq(limits.open_connections, UInt64(1024), "the open-connections bound changed")?
    testing.assert(limits.connections.is_none(), "the default limits end serving")?
}
