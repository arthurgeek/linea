// A place is mutated two ways -- passed `&`, and assigned to -- and a block is
// an expression, so an assignment sits inside an argument as readily as a mark
// does. The check looked for marks alone, so `pair(p, { p.x = 9  0 })` passed,
// and what `pair` received for its first argument was decided by the order the
// two arguments happened to be evaluated in.
//
// Both shapes are here because the answer used to differ between them. A
// scalar argument is read where it sits and an aggregate is reached through
// the caller's storage, so the aggregate saw the write and the scalar did not
// -- one source shape, one convention, one order, and the answer decided by
// the layout table. That difference is exactly what this rule exists to keep
// unobservable.
struct P {
    x: UInt8,
    y: UInt8,
}

fn pair(a: P, b: UInt8) -> UInt8 {
    a.x + b
}

fn scalars(a: UInt8, b: UInt8) -> UInt8 {
    a + b
}

fn main() -> UInt8 {
    var p: P = .{ x = 1, y = 2 }
    var n: UInt8 = 1

    pair(
        p,
        {
            p.x = 9
            0
        },
    ) + scalars(
        n,
        {
            n = 9
            0
        },
    )
}
