// A run's type is the array its bounds name, so assigning an array of another
// length is a mismatch, and what fixed the expected length is the pair of
// bounds written in the bracket.
fn main() -> UInt8 {
    var a: [UInt8; 4] = [1, 2, 3, 4]
    let three: [UInt8; 3] = [7, 8, 9]
    a[0..2] = three
    a[0]
}
