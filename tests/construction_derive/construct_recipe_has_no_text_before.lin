trait Labelled {
    fn labelled() -> Self
}

template impl Labelled where reflect.target: struct {
    fn labelled() -> Self {
        reflect.construct(
            reflect.product,
            |component| {
                let value: Str = component.text_before
                value
            },
            {},
        )
    }
}

struct Pair {
    left: Str,
    right: Str,
}

derive Labelled for Pair

fn main() -> UInt8 {
    let _pair: Pair = Labelled.labelled()
    0
}
