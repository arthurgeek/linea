// [S-Bracket]. A bracket delimits three things -- an array type `[T; N]`, a
// literal `[a, b, c]`, and an index `a[i]` -- and one rule covers all three,
// because what a reader has got wrong is the same in each: where it should
// have closed. A type needs a `;` between its element and its length as well.
//
// All three here, so a rule that caught two would be found by the third.
fn typed() -> UInt8 {
    let xs: [UInt8 3] = [1, 2, 3]
    xs[0]
}

fn built() -> UInt8 {
    let xs: [UInt8; 3] = [1, 2, 3
    xs[0]
}

fn indexed() -> UInt8 {
    let xs: [UInt8; 3] = [1, 2, 3]
    xs[0)
}

fn main() -> UInt8 {
    typed() + built() + indexed()
}
