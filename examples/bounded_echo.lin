// An echo server that a misbehaving client cannot hold up, and the client that
// talks to it. `bounded_echo serve` accepts connections one at a time and sends
// every line back to whoever sent it; `bounded_echo send` connects, sends each
// argument as a line, and prints what comes back.
//
// It adds three limits to the basic `tcp_echo` program: a timeout on every read
// and write, a deadline on the whole session, and a cap on how much text one
// connection may send. A server that answers one connection at a time needs
// them, because a client that stays silent, sends a byte at a time, or never
// stops would otherwise hold every client queued behind it. The server logs
// what happens to standard error.
import std.cli
import std.env
import std.io
import std.log
import std.mem
import std.net
import std.testing
import std.time

use net.Accepted
use net.Acceptor

// A server answers one connection at a time, so each connection is bounded:
// `session_ms` is how long the whole session may take, and `max_echo_bytes`
// is how much text it may send to be echoed.
@copyable
struct Bounds {
    session_ms: UInt64,
    max_echo_bytes: UInt64,
}

struct ServeOptions {
    port: UInt16,
    connections: Option[UInt64],
}

// Build the command schema. Each `?` hands back a refused allocation, and
// `defer var` releases a command that was not yet registered when that
// happens.
fn build_cli() -> Result[cli.Command, mem.Oom] {
    defer var cmd = cli.Command.new("bounded_echo", "Bounded echo server and client")
    defer var serve_cmd = cli.Command.new("serve", "run the bounded echo server")
    &serve_cmd.option("port", "--port", "port to listen on", required: true)?
    &serve_cmd.option("connections", "--connections", "maximum connections to accept")?
    &cmd.subcommand(serve_cmd)?

    defer var send_cmd = cli.Command.new("send", "send lines to an echo server")
    &send_cmd.option("port", "--port", "server port to connect to", required: true)?
    &send_cmd.positional("message", "messages to send", required: true, variadic: true)?
    &cmd.subcommand(send_cmd)?
    .Ok(cmd)
}

// Print the usage to standard error and return 64, the conventional exit
// status for a usage mistake.
fn usage_error(cmd: cli.Command) -> UInt8 {
    match cmd.usage() {
        Ok(text) => {
            io.eprintln(text.view())
            text.release()
        },
        Err(_) => io.eprintln("out of memory"),
    }
    64
}

fn main() -> UInt8 {
    defer var cmd = build_cli() else |_| {
        io.eprintln("out of memory")
        return 1
    }
    var cursor = cli.ArgCursor.new(env.args())
    defer let matches = cmd.parse(&cursor) else |error| {
        io.eprintln("error: {error}")
        return usage_error(cmd)
    }
    if matches.is_help() {
        return usage_error(cmd)
    }
    let sub = matches.subcommand() else {
        return usage_error(cmd)
    }
    if sub.name == "serve" {
        let port: UInt16 = sub.matches.get("port") else |error| {
            io.eprintln("error: {error}")
            return usage_error(cmd)
        }
        let connections: Option[UInt64] = sub.matches.get_optional("connections") else |error| {
            io.eprintln("error: {error}")
            return usage_error(cmd)
        }
        return run_serve(.{ port, connections })
    }
    if sub.name == "send" {
        let port: UInt16 = sub.matches.get("port") else |error| {
            io.eprintln("error: {error}")
            return usage_error(cmd)
        }
        defer let messages = sub.matches.positionals_all("message") else |_| {
            io.eprintln("out of memory")
            return 1
        }
        return run_send(port, messages)
    }
    usage_error(cmd)
}

fn run_serve(options: ServeOptions) -> UInt8 {
    // The server's logger writes lines at `Info` and above to standard error.
    let logger = log.to_stderr(minimum: .Info)
    let address = net.loopback(options.port)
    // A port another program holds makes `listen` fail; the error is logged
    // with the address and the server stops.
    var listener = net.listen(address) else |error| {
        logger.error("cannot listen", log.field("address", address).and("error", error))
        return 1
    }
    let bound = listener.local_address() else |error| {
        logger.error("cannot read the bound address", log.field("error", error))
        // `close` consumes the listener and returns a Result; binding it to
        // `_closed` ignores that result deliberately while a failure is reported.
        let _closed = listener.close()
        return 1
    }
    // Standard error is an unbuffered descriptor and the logger writes each
    // line whole, so this line is visible as soon as the socket is bound.
    logger.info("listening", log.field("address", bound))
    // `net.serve` hands each accepted connection to the handler, one at a
    // time, and closes the listener when it returns. With no `--connections`
    // limit it serves until the program is stopped.
    var handler = [sink logger = copy(logger)] |sink connection: net.Connection, peer: net.Address| {
        echo_connection(connection, peer, logger, standard_bounds)
    }
    match net.serve(listener, &handler, connections: options.connections) {
        Ok(_) => 0,
        Err(error) => {
            logger.error("serving stopped", log.field("error", error))
            1
        },
    }
}

// The client stops writing and shuts down its side before it starts reading
// (`run_send` below), so this reads every line to end of input before
// writing any of it back: once a `BufferedReader` owns the connection, only
// it can read from that connection until reading finishes. Each connection
// logs one line: how many lines it echoed to `peer`, or why it failed.
fn echo_connection(sink connection: net.Connection, peer: net.Address, logger: log.Logger[io.Descriptor], bounds: Bounds) {
    // `set_timeouts` bounds each read and each write, and `set_deadline` bounds
    // all the reads together, so a client that stays silent, or sends a
    // byte at a time, cannot hold the server past `session_ms`.
    var bounded = connection
    let _ = &bounded.set_timeouts(read_ms: bounds.session_ms, write_ms: bounds.session_ms) else |error| {
        logger.error("cannot bound a connection", log.field("peer", peer).and("error", error))
        let _closed = bounded.close()
        return
    }
    &bounded.set_deadline(time.Instant.now(), within_ms: bounds.session_ms)
    // A refused buffer hands the connection back. `settled()` closes it and
    // keeps why the buffer was refused, together with a failed close, so the
    // log line reports both.
    var reader = io.BufferedReader.open(capacity: read_capacity, reader: bounded).settled() else |reason| {
        logger.error("cannot buffer a connection", log.field("peer", peer).and("error", reason))
        return
    }
    defer var echoed = String.new()
    var lines: UInt64 = 0
    var failed = false
    loop {
        match &reader.read_line_borrowed(max_bytes: max_line_bytes) {
            Ok(None) => break,
            Ok(Some(received)) => match io.line(received, &echoed) {
                Ok(_) => {
                    lines += 1
                    // Text past the limit is refused, and nothing is echoed.
                    if echoed.length() > bounds.max_echo_bytes {
                        logger.warn("a connection sent too much", log.field("peer", peer).and("limit", bounds.max_echo_bytes))
                        failed = true
                        break
                    }
                },
                Err(_) => {
                    logger.error("cannot hold an echoed line", log.field("peer", peer))
                    failed = true
                    break
                },
            },
            Err(error) => {
                logger.warn("a connection failed", log.field("peer", peer).and("error", error))
                failed = true
                break
            },
        }
    }
    var conn = reader.abandon()
    if !failed {
        match &conn.write_str(echoed.view()) {
            Ok(_) => logger.info("echoed", log.field("peer", peer).and("lines", lines)),
            Err(error) => logger.warn("cannot write an echo", log.field("peer", peer).and("error", error)),
        }
    }
    let _closed = conn.close()
}

fn run_send(port: UInt16, messages: Vec[Str]) -> UInt8 {
    let target = net.loopback(port)
    var connection = net.connect(target) else |error| {
        io.eprintln("bounded_echo: cannot connect to {target}: {error}")
        return 1
    }
    // `&connection` lends the connection to `send_messages`, so it is still
    // here to close whether or not every message went out.
    if !send_messages(messages, &connection) {
        let _closed = connection.close()
        return 1
    }
    // shutdown_write tells the server no more lines are coming, so its read
    // ends and it closes this connection.
    let _ = &connection.shutdown_write() else |error| {
        io.eprintln("bounded_echo: cannot shut down writes: {error}")
        let _closed = connection.close()
        return 1
    }
    var reader = io.BufferedReader.open(capacity: read_capacity, reader: connection).settled() else |reason| {
        io.eprintln("bounded_echo: cannot buffer the connection: {reason}")
        return 1
    }
    let printed = print_echo(&reader)
    match reader.abandon().close() {
        Ok(_) => if printed {
            0
        } else {
            1
        },
        Err(error) => {
            io.eprintln("bounded_echo: cannot close the connection: {error}")
            1
        },
    }
}

// Send each message as a line. Report the first message that cannot be sent
// and answer whether every one was.
fn send_messages(messages: Vec[Str], inout connection: net.Connection) -> Bool {
    for read message in messages {
        let _ = io.line(message, &connection) else |error| {
            io.eprintln("bounded_echo: cannot send a message: {error}")
            return false
        }
    }
    true
}

// Print each line the server sends back until it closes its side. Report a
// failed read and answer whether the whole echo arrived.
fn print_echo(inout reader: io.BufferedReader[net.Connection]) -> Bool {
    loop {
        match &reader.read_line_borrowed(max_bytes: max_line_bytes) {
            Ok(None) => return true,
            Ok(Some(received)) => {
                let _printed = io.println(received)
            },
            Err(error) => {
                io.eprintln("bounded_echo: reading the echo failed: {error}")
                return false
            },
        }
    }
}

// A module-level constant may follow the functions that use it.
// `read_capacity` sets how many bytes a BufferedReader takes from a
// connection in one read.
let read_capacity: UInt64 = 1024

// Refuse a line longer than this many bytes.
let max_line_bytes: UInt64 = 4096

// A connection may take ten seconds and send 64 KiB of text.
let standard_bounds: Bounds = .{ session_ms = 10000, max_echo_bytes = 65536 }

// `serve_one` connects a client to a fresh listener, sends `lines`, serves the
// accepted connection with `echo_connection` under `bounds`, and returns what
// the client reads back once the server has closed the connection. A client
// that is `silent` never stops writing, so the server waits for it.
fn serve_one(bounds: Bounds, lines: Str, silent: Bool) -> String {
    var listener = net.listen(net.loopback(0)).unwrap()
    var client = net.connect(listener.local_address().unwrap()).unwrap()
    let _sent = io.write_all(&client, lines.as_bytes()).unwrap()
    if !silent {
        &client.shutdown_write().unwrap()
    }
    let Accepted { connection, address } = &listener.accept().unwrap()
    echo_connection(connection, address, log.to_stderr(minimum: .Error), bounds)
    let text = io.read_text(&client, max_bytes: 4096).unwrap()
    client.close().unwrap()
    listener.close().unwrap()
    text
}

test fn a_connection_gets_its_lines_back() {
    defer let echoed = serve_one(Bounds { session_ms = 5000, max_echo_bytes = 1024 }, "one\ntwo\n", silent: false)
    testing.assert_eq(echoed.view(), "one\ntwo\n", "the lines were not echoed")?
}

test fn a_client_that_sends_nothing_is_dropped_when_its_session_ends() {
    let start = time.Instant.now()
    defer let echoed = serve_one(Bounds { session_ms = 100, max_echo_bytes = 1024 }, "partial", silent: true)
    testing.assert_eq(echoed.view(), "", "a connection that never finished a line was echoed")?
    testing.assert(start.elapsed() >= time.Duration.from_milliseconds(100), "the server gave up before the session ended")?
}

test fn a_client_that_sends_more_than_the_limit_is_dropped_unanswered() {
    let lines = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\n"
    defer var many = String.new()
    for _ in 0..4 {
        &many.append(lines).unwrap()
    }
    defer let echoed = serve_one(Bounds { session_ms = 5000, max_echo_bytes = 200 }, many.view(), silent: false)
    testing.assert_eq(echoed.view(), "", "more than the limit was echoed")?
}
