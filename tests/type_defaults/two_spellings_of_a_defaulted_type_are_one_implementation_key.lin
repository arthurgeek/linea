import std.mem

use mem.Allocator
use mem.SystemAllocator

struct Shelf[T, A: Allocator = SystemAllocator] {
    items: Vec[T, A],
}

trait Takes[phantom T] {
    fn takes(_self: Self) -> UInt8
}

struct Counter {}

impl Takes[Shelf[UInt8]] for Counter {
    fn takes(_self: Self) -> UInt8 {
        1
    }
}

impl Takes[Shelf[UInt8, SystemAllocator]] for Counter {
    fn takes(_self: Self) -> UInt8 {
        2
    }
}

fn main() -> UInt8 {
    0
}
