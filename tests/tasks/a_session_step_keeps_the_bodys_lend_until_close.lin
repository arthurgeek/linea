import std.session
import std.task

use session.Chan
use session.End
use session.Send

// Advancing a task handle through session steps (`recv`) preserves the body's
// `inout` lend in the continuation handle until `close` joins the task.
fn main() -> UInt8 {
    var count = UInt64(0)
    let body = sink [inout count] |sink me: Chan[Send[UInt64, End]]| {
        count += 1
        me.send(count).close()
    }
    let slot = task.prepare(body).unwrap()
    let (first, done) = slot.start().recv()
    let premature = count
    done.close()
    UInt8(first + premature)
}
