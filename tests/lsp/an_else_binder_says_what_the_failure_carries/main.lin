// The name an `else` binds holds what the failure carried: hover says so where
// it is declared and where it is read, and a hint writes the type beside it.
enum Fault {
    Missing,
}

fn lookup(key: UInt8) -> Result[UInt8, Fault] {
    if key == 3 {
        Result.Ok(40)
    } else {
        Result.Err(Fault.Missing)
    }
}

fn code(sink fault: Fault) -> UInt8 {
    match fault {
        Missing => 2,
    }
}

fn main() -> UInt8 {
    let found = lookup(3) else |error| {
        return code(error)
    }
    found
}
