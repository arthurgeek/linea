// A trait declaring no members is supplied nothing, and a member written for
// one is a member the trait does not declare.
trait Same {
    fn alike(self: Self, other: Self) -> Bool
}

trait Settled: Same {}

struct Mark {
    n: UInt8,
}

impl Same for Mark {
    fn alike(self: Mark, other: Mark) -> Bool {
        self.n == other.n
    }
}

impl Settled for Mark {
    fn alike(self: Mark, other: Mark) -> Bool {
        self.n == other.n
    }
}

fn used[T: Settled](a: T, b: T) -> Bool {
    Same.alike(a, b)
}

fn main() -> UInt8 {
    let a: Mark = .{ n = 3 }
    let b: Mark = .{ n = 3 }
    if used(a, b) {
        5
    } else {
        0
    }
}
