import std.testing
import std.mem

// Process arguments borrow immutable process-lifetime storage. Reading raw
// bytes or validated text allocates nothing and transfers no ownership.

// Args is a copyable handle holding the process argument count. Its
// representation is private, so callers cannot build a handle with an invalid
// count. Copying or discarding it does not affect the argument storage.
@(opaque, copyable)
struct Args {
    n: UInt64,
}

// Return a handle to the arguments this process was started with.
pub fn args() -> Args {
    .{ n = mem.argument_count() }
}

test fn args_start_with_the_executable_path() {
    let arguments = args()
    testing.assert(arguments.bytes_at(0).is_some(), "the executable's own path is not an argument")?
}

impl Args {
    // The count includes the executable path at index zero.
    pub fn count(self: Self) -> UInt64 {
        self.n
    }
}

// Check boundaries against the runtime count, independent of runner arguments.
test fn a_count_says_where_the_arguments_stop() {
    let a = args()

    testing.assert(Args.count(self: a) >= 1, "a process was started with no arguments at all")?

    match a.at(0) {
        Some(_) => {},
        None => testing.assert(false, "the executable's own path is not an argument")?,
    }

    // The count is the first index beyond the arguments.
    match a.at(a.count()) {
        Some(_) => testing.assert(false, "an offset at the count describes an argument")?,
        None => {},
    }

    match a.at(a.count() + 1000) {
        Some(_) => testing.assert(false, "an offset far past the count describes an argument")?,
        None => {},
    }

    .Ok(())
}

impl Args {
    // Return None for a missing argument or invalid UTF-8.
    // An index below count identifies an existing argument, so None there means
    // the argument is not valid UTF-8.
    pub fn at(_self: Self, i: UInt64) -> Option[Str] {
        Str.argument(i)
    }
}

test fn at_reads_an_argument_as_text_and_refuses_an_index_past_the_end() {
    let arguments = args()
    match arguments.at(0) {
        None => {},
        Some(argument) => {
            testing.assert_eq(argument.as_bytes(), arguments.bytes_at(0).unwrap(), "text and raw argument views disagree")?
        },
    }
    testing.assert(arguments.at(UInt64.max).is_none(), "an out-of-range argument index wrapped")?
}

impl Args {
    // Preserve every POSIX argument byte, including invalid UTF-8. Only a
    // missing index returns None; an empty argument is an empty byte span.
    pub fn bytes_at(_self: Self, i: UInt64) -> Option[mem.Slice[UInt8]] {
        mem.argument_bytes(i)
    }
}

test fn raw_arguments_preserve_existing_storage_and_missing_indices() {
    let arguments = args()
    let first = arguments.bytes_at(0).unwrap()
    testing.assert(first.length() != 0, "the executable argument lost its bytes")?
    match arguments.at(0) {
        None => {},
        Some(argument) => {
            testing.assert_eq(first, argument.as_bytes(), "text and raw argument views disagree")?
        },
    }
    testing.assert(arguments.bytes_at(arguments.count()).is_none(), "an index at the count named raw argument bytes")?
    testing.assert(arguments.bytes_at(UInt64.max).is_none(), "an out-of-range byte argument wrapped")?
    .Ok(())
}

// The environment views the variables the process was started with. The
// runtime records them before `main` runs, and Linea has no operation that
// changes them, so a name or value read from the environment lives until the
// process exits and allocates nothing. Each variable is held as `NAME=value`;
// the name ends at the first `=`.

// A `Variable` is one environment variable, viewed in process storage.
@(copyable, derive(Equatable, Debug))
pub struct Variable {
    name: Str,
    value: Str,
}

// Return the value of the environment variable `name`, or None when the
// process was started without it or its value is not UTF-8. When a name
// appears more than once, the first is the one read, as C's `getenv` reads
// it, even when that one's value is not UTF-8. Each call walks the
// environment once, so its cost is the environment's size in bytes.
pub fn variable(name: Str) -> Option[Str] {
    for entry in entries() {
        if entry.name == name.as_bytes() {
            return match Str.from_bytes(entry.value) {
                Ok(value) => .Some(value),
                Err(_) => .None,
            }
        }
    }
    .None
}

test fn a_variable_is_read_by_its_exact_name() {
    var walk = variables()
    let first = &walk.next() else {
        return testing.assert(false, "the test process has no environment")
    }
    testing.assert(variable(first.name).is_some(), "a variable the environment holds was not found")?
    testing.assert(variable("LINEA_NO_SUCH_VARIABLE_IS_EVER_SET").is_none(), "an unset variable was found")?
    testing.assert(variable("").is_none(), "an empty name was found")?
    testing.assert(variable("PATH=").is_none(), "a name holding = was found")?
    .Ok(())
}

// `Variables` walks the environment in the order the process received it.
@opaque
struct Variables {
    entries: Entries,
}

// Return a walk over the environment's variables. A variable whose name or
// value is not UTF-8, or which has no `=` or an empty name, is skipped.
pub fn variables() -> Variables {
    .{ entries = entries() }
}

test fn every_variable_has_a_name_and_no_equals_sign_in_it() {
    var count: UInt64 = 0
    for entry in variables() {
        count += 1
        testing.assert(entry.name.length() > 0, "a variable had an empty name")?
        testing.assert(entry.name.find("=").is_none(), "a name held =")?
    }
    testing.assert(count > 0, "the test process has no environment")?
    .Ok(())
}

impl Iterator for Variables {
    type Item = Variable

    fn next(inout self: Self) -> Option[Variable] where carries(.Some: self) {
        loop {
            let entry = &self.entries.next()?
            match text_of(entry) {
                Some(found) => return .Some(found),
                None => {},
            }
        }
    }
}

// Return the variable `entry` holds, or None when its name or value is not
// UTF-8.
fn text_of(entry: Entry) -> Option[Variable] where carries(.Some: entry) {
    let name = Str.from_bytes(entry.name) else |_| {
        return .None
    }
    let value = Str.from_bytes(entry.value) else |_| {
        return .None
    }
    .Some(.{ name, value })
}

// An `Entry` is one environment variable as the bytes the process was
// started with: the name before the first `=` and the value after it.
// Neither is checked to be UTF-8, so a program that must see every variable,
// such as one answering a CGI request, reads them this way.
@(copyable, derive(Equatable, Debug))
internal struct Entry {
    name: mem.Slice[UInt8],
    value: mem.Slice[UInt8],
}

// `Entries` walks the environment's entries in the order the process
// received them.
internal struct Entries {
    index: UInt64,
}

// Return a walk over the environment's entries. An entry with no `=` or an
// empty name is skipped.
internal fn entries() -> Entries {
    .{ index = 0 }
}

// The ASCII code of `=`, which ends a variable's name.
let ascii_equals: UInt8 = 61

impl Iterator for Entries {
    type Item = Entry

    fn next(inout self: Self) -> Option[Entry] where carries(.Some: self) {
        loop {
            let bytes = mem.environment_bytes(self.index)?
            self.index += 1
            match split_entry(bytes) {
                Some(found) => return .Some(found),
                None => {},
            }
        }
    }
}

test fn every_entry_has_a_name() {
    var count: UInt64 = 0
    for entry in entries() {
        count += 1
        testing.assert(entry.name.length() > 0, "an entry had an empty name")?
    }
    let texts = variables().count()
    testing.assert(count >= texts, "a variable is not an entry")?
    .Ok(())
}

// Split one `NAME=value` entry at its first `=`. An entry with no `=` or an
// empty name answers None.
fn split_entry(bytes: mem.Slice[UInt8]) -> Option[Entry] where carries(.Some: bytes) {
    var at: UInt64 = 0
    while at < bytes.length() && bytes[at] != ascii_equals {
        at += 1
    }
    if at == 0 || at == bytes.length() {
        return .None
    }
    let name = bytes.subspan(start: 0, count: at).unwrap()
    let value = bytes.subspan(start: at + 1, count: bytes.length() - at - 1).unwrap()
    .Some(.{ name, value })
}

test fn an_entry_splits_at_its_first_equals_sign() {
    let plain = split_entry("PATH=/bin:/usr/bin".as_bytes()).unwrap()
    testing.assert_eq(plain.name, "PATH".as_bytes(), "a plain name changed")?
    testing.assert_eq(plain.value, "/bin:/usr/bin".as_bytes(), "a plain value changed")?
    testing.assert_eq(split_entry("QUERY=a=1".as_bytes()).unwrap().value, "a=1".as_bytes(), "a value holding = was cut")?
    testing.assert_eq(split_entry("EMPTY=".as_bytes()).unwrap().value, "".as_bytes(), "an empty value was refused")?
    testing.assert_eq(split_entry("=value".as_bytes()), .None, "an empty name was accepted")?
    testing.assert_eq(split_entry("NOVALUE".as_bytes()), .None, "an entry without = was accepted")?
    // A byte that is not UTF-8 is kept: 233 is `é` in Latin-1.
    let latin = [UInt8(80), 61, 99, 97, 102, 233]
    let kept = split_entry(latin.as_slice()).unwrap()
    testing.assert_eq(kept.value, latin.as_slice().subspan(start: 2, count: 4).unwrap(), "a byte that is not UTF-8 was lost")?
    testing.assert_eq(text_of(kept), .None, "a value that is not UTF-8 was read as text")?
    testing.assert_eq(text_of(plain), Option.Some(Variable { name = "PATH", value = "/bin:/usr/bin" }), "a plain entry was not read as text")?
    .Ok(())
}
