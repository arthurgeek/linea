@linear
enum Token {
    One,
}

struct Tokens {
    marker: UInt8,
}

impl Iterator for Tokens {
    type Item = Token

    fn next(inout _self: Tokens) -> Option[Token] {
        .None
    }
}

struct Selected[I] {
    iterator: I,
}

impl[I: Iterator] Iterator for Selected[I]
where I.Item: Discardable {
    type Item = I.Item

    fn next(inout self: Selected[I]) -> Option[I.Item] where carries(.Some: self) {
        Iterator.next(&self.iterator)
    }
}

fn main() -> UInt8 {
    let tokens: Tokens = .{ marker = 0 }
    var selected: Selected[Tokens] = .{ iterator = tokens }
    match Iterator.next(&selected) {
        Some(item) => match item { One => {} },
        None => {},
    }
    0
}
