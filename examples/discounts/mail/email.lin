// Check email addresses before the discount receipt is sent.
// `@opaque` hides that an Email is a `Str`, so code outside `mail` must build
// one through `Email.of`. A numeric range fits in a `where` clause, but a text
// check is ordinary code in the constructor. This one only requires the text
// to contain `@`; it is not a complete email address validator.
import std.testing

@(opaque, derive(Equatable, Debug))
type Email = Str

impl Email {
    // Return `Some(Email)` when the check passes and `None` otherwise.
    // Inside this module, `Email(...)` wraps a `Str` without further checks.
    // `copy(raw)` gives the email its own `Str`, which points at the same text.
    pub fn of(raw: Str) -> Option[Email] {
        if raw.find("@").is_some() {
            .Some(Email(copy(raw)))
        } else {
            .None
        }
    }

    // Return the validated address and keep the email. `let read` names the
    // `Str` inside `self` without taking it out.
    pub fn address(self: Self) -> Str {
        let read Email(raw) = self
        copy(raw)
    }
}

// Code inside `mail` may call `Email(...)` directly: the opaque seal applies
// only outside the module.
test fn a_parse_is_the_only_way_to_an_address() {
    testing.assert_eq(Email.of("someone@example.test"), .Some(Email("someone@example.test")), "keep the supplied address")?
    let email = Email("someone@example.test")
    testing.assert_eq(email.address(), "someone@example.test", "read back the validated address")?
    testing.assert_eq(Email.of("someone.example.test"), .None, "reject an address without @")?
    testing.assert_eq(Email.of(""), .None, "reject an empty address")?
    // Even `"@"` passes this deliberately small check.
    testing.assert_eq(Email.of("@"), .Some(Email("@")), "this example only requires an @")?
}
