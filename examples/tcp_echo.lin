// Echo text over TCP. `tcp_echo serve PORT` waits for a client, sends back
// everything the client sends, closes that connection, and waits for the next
// client. Add a number, as in `tcp_echo serve PORT 3`, to stop after that many
// clients. `tcp_echo send PORT MESSAGE...` connects, sends each message as a
// line, and prints what comes back.
import std.cli
import std.env
import std.io
import std.mem
import std.net
import std.testing

use mem.Lender
use net.Accepted
use net.Acceptor

// Build the command schema. Each `?` hands back a refused allocation, and
// `defer var` releases a command that was not yet registered when that
// happens.
fn build_cli() -> Result[cli.Command, mem.Oom] {
    defer var cmd = cli.Command.new("tcp_echo", "Echo text over TCP")
    defer var serve_cmd = cli.Command.new("serve", "listen for and echo connections")
    &serve_cmd.positional("port", "port to listen on", required: true)?
    &serve_cmd.positional("clients", "number of clients to serve", required: false)?
    &cmd.subcommand(serve_cmd)?

    defer var send_cmd = cli.Command.new("send", "send messages to an echo server")
    &send_cmd.positional("port", "server port to connect to", required: true)?
    &send_cmd.positional("message", "messages to send", required: true, variadic: true)?
    &cmd.subcommand(send_cmd)?
    .Ok(cmd)
}

// Print the usage to standard error and return 64, the conventional exit
// status for a usage mistake.
fn usage_error(cmd: cli.Command) -> UInt8 {
    match cmd.usage() {
        Ok(text) => {
            io.eprintln(text.view())
            text.release()
        },
        Err(_) => io.eprintln("out of memory"),
    }
    64
}

fn main() -> UInt8 {
    defer var cmd = build_cli() else |_| {
        io.eprintln("out of memory")
        return 1
    }
    var cursor = cli.ArgCursor.new(env.args())
    defer let matches = cmd.parse(&cursor) else |error| {
        io.eprintln("error: {error}")
        return usage_error(cmd)
    }
    if matches.is_help() {
        return usage_error(cmd)
    }
    let sub = matches.subcommand() else {
        return usage_error(cmd)
    }
    if sub.name == "serve" {
        let port: UInt16 = sub.matches.get_positional("port") else |error| {
            io.eprintln("error: {error}")
            return usage_error(cmd)
        }
        // `clients` is optional: without it the server serves for ever.
        let clients: UInt64 = if sub.matches.positional("clients").is_some() {
            let count: UInt64 = sub.matches.get_positional("clients") else |error| {
                io.eprintln("error: {error}")
                return usage_error(cmd)
            }
            count
        } else {
            UInt64.max
        }
        return serve(port, clients)
    }
    if sub.name == "send" {
        let port: UInt16 = sub.matches.get_positional("port") else |error| {
            io.eprintln("error: {error}")
            return usage_error(cmd)
        }
        defer let messages = sub.matches.positionals_all("message") else |_| {
            io.eprintln("out of memory")
            return 1
        }
        return send(port, messages)
    }
    usage_error(cmd)
}

fn serve(port: UInt16, clients: UInt64) -> UInt8 {
    // Each fallible step has one `let ... else`: report the failure and leave.
    // The listener is linear, so every way out of `serve` closes it.
    var listener = net.listen(net.loopback(port)) else |error| {
        io.eprintln("cannot listen on port {port}: {error}")
        return 1
    }
    let address = listener.local_address() else |error| {
        io.eprintln("cannot read the listening address: {error}")
        let _closed = listener.close()
        return 1
    }
    io.eprintln("listening on {address}")
    let accepted = accept_clients(&listener, clients)
    // The listener is closed here, once, whether or not accepting worked.
    let closed = listener.close()
    if closed.is_err() {
        io.eprintln("cannot close the listener")
        return 1
    }
    if accepted {
        0
    } else {
        1
    }
}

// Echo clients one at a time until `clients` have been served, and answer
// whether accepting never failed.
fn accept_clients(inout listener: net.Listener, clients: UInt64) -> Bool {
    var served: UInt64 = 0
    while served < clients {
        // `Accepted` holds the connection and the address of the client, and
        // the pattern takes both out of it as soon as `accept` succeeds.
        let Accepted { connection, address } = &listener.accept() else |error| {
            io.eprintln("cannot accept a client: {error}")
            return false
        }
        var open = connection
        echo(&open, address)
        // The connection is closed here, once, whether or not the echo worked.
        let _closed = open.close()
        served += 1
    }
    true
}

// Send everything the client sent back to it. A client shuts down its side
// when it has sent everything, which is what ends `read_all`.
fn echo(inout connection: net.Connection, client: net.Address) {
    defer let arena = mem.Arena.open(mem.system(), size: 8192)
    let received = io.read_all_in(arena.handle(), &connection, max_bytes: 4096) else |failure| {
        io.eprintln("cannot read from {client}: {failure}")
        // The failure owns any bytes read before it, so it is released.
        failure.release()
        return
    }
    let _written = io.write_all(&connection, received.as_slice()) else |error| {
        io.eprintln("cannot echo to {client}: {error}")
        return
    }
    io.eprintln("echoed {received.length()} bytes to {client}")
}

fn send(port: UInt16, messages: Vec[Str]) -> UInt8 {
    var connection = net.connect(net.loopback(port)) else |error| {
        io.eprintln("cannot connect to port {port}: {error}")
        return 1
    }
    let echoed = exchange(&connection, messages)
    // The connection is closed here, once, whether or not the exchange worked.
    let closed = connection.close()
    if closed.is_err() {
        io.eprintln("cannot close the connection")
        return 1
    }
    if echoed {
        0
    } else {
        1
    }
}

// Send the messages, one per line, and print what the server sends back. Report
// the first step that fails and answer whether every step worked.
fn exchange(inout connection: net.Connection, messages: Vec[Str]) -> Bool {
    defer var text = String.new()
    for read message in messages {
        let _line = io.line(message, &text) else |_| {
            io.eprintln("a message is too long to send")
            return false
        }
    }
    let _written = io.write_all(&connection, text.view().as_bytes()) else |error| {
        io.eprintln("cannot send: {error}")
        return false
    }
    // Shutting down writes tells the server nothing more is coming.
    let _shut = &connection.shutdown_write() else |error| {
        io.eprintln("cannot finish sending: {error}")
        return false
    }
    // `read_text` reads until the server stops writing and checks that the
    // bytes are UTF-8; its error says which of the two failed.
    defer let echoed = io.read_text(&connection, max_bytes: 4096) else |error| {
        io.eprintln("cannot read the echo: {error}")
        return false
    }
    io.print(echoed.view()).is_ok()
}

// `echo_text` connects a client to a fresh listener, sends `text`, echoes it
// with `echo`, and returns what the client reads back.
fn echo_text(text: Str) -> String {
    var listener = net.listen(net.loopback(0)).unwrap()
    var client = net.connect(listener.local_address().unwrap()).unwrap()
    let _sent = io.write_all(&client, text.as_bytes()).unwrap()
    &client.shutdown_write().unwrap()
    let Accepted { connection, address } = &listener.accept().unwrap()
    var server = connection
    echo(&server, address)
    server.close().unwrap()
    let text = io.read_text(&client, max_bytes: 4096).unwrap()
    client.close().unwrap()
    listener.close().unwrap()
    text
}

test fn a_client_gets_its_lines_back() {
    defer let echoed = echo_text("one\ntwo\n")
    testing.assert_eq(echoed.view(), "one\ntwo\n", "the lines were not echoed")?
}

test fn a_client_that_sends_nothing_gets_nothing_back() {
    defer let echoed = echo_text("")
    testing.assert_eq(echoed.view(), "", "an empty message was answered")?
}
