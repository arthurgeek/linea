// What a bound on a declared type buys: the projection answers the bound's
// operations. Its identity stays unknown -- nothing here may assume `H.Iter`
// is `Thing`.
trait Elem {
    fn one(sink self: Self) -> UInt8
}

trait Holder {
    type Iter: Elem

    fn get(self: Self) -> Self.Iter
}

struct Thing { n: UInt8 }

struct Box { _n: UInt8 }

impl Elem for Thing {
    fn one(sink self: Thing) -> UInt8 {
        self.n
    }
}

impl Holder for Box {
    type Iter = Thing

    fn get(_self: Box) -> Self.Iter {
        .{ n = 7 }
    }
}

fn use_it[H: Holder](h: H) -> UInt8 {
    Elem.one(Holder.get(h))
}

fn main() -> UInt8 {
    let b: Box = .{ _n = 1 }
    use_it(b)
}
