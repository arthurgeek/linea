import std.io
import c

// `c.Named` is sealed in a module `c`'s manifest trusts with C, so it is a
// handle wherever an `extern` takes it, this program's included: resetting
// it ends what `c` read from the object.
extern fn n_reset(h: c.Named)

fn main() -> Result[UInt8, io.IoError] {
    var h = c.open()
    let later = c.first_byte_later(h) else |_| {
        return .Ok(1)
    }
    n_reset(h)
    let first = later()
    later.release()
    io.println("first byte after reset: {first}")?
    .Ok(0)
}
