// A materialized body's bytes observe its cache. Another mutable body read
// is refused until the last use of that observation.
import std.http
import std.io

use io.Reader

fn reread[P: Allocator](inout _: (), request: http.Request[P], inout incoming: http.RequestBody[P]) -> Result[http.Response[P], http.Error[P]] where carries(request), borrows(incoming), retains(incoming: incoming) {
    let cached = &incoming.read_all(request)?
    var buffer = request.allocator().acquire(8)?
    let _received = &incoming.read_some(&buffer, offset: 0, count: 8)?
    http.text(request, Str.from_bytes(cached)?)
}

fn main() -> UInt8 {
    defer var router = http.Router.new()
    &router.route_raw("POST /", reread).unwrap()
    defer let exchange = http.TestExchange.open()
    defer var sent = exchange.request("POST", "/", body: "hello").unwrap()
    var nothing = {}
    let response = &sent.send_to(&router, &nothing).unwrap()
    io.println(response.text().unwrap()).unwrap()
    0
}
