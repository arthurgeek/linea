// [T-Impl]. `Lab.Unit` is `Kelvin`, so this is `Into[Kelvin]` for `Celsius`,
// which the bridge from `From` already answers.
struct Celsius {
    degrees: Int64,
}

struct Kelvin {
    degrees: Int64,
}

trait Measure {
    type Unit
}

struct Lab {}

impl Measure for Lab {
    type Unit = Kelvin
}

impl Into[Lab.Unit] for Celsius {
    fn into(sink self: Celsius) -> Kelvin where carries(self) {
        .{ degrees = self.degrees + 273 }
    }
}

fn main() -> UInt8 {
    let boiling = Celsius { degrees = 100 }
    let kelvin: Kelvin = boiling.into()
    UInt8(kelvin.degrees - 373)
}
