fn invoke[F: fn() -> borrow UInt8](callback: F) -> borrow UInt8 where carries(callback) {
    callback()
}

fn main() -> UInt8 {
    let number: UInt8 = 7
    let observation = {
        let callback = [number] || -> where borrows(number) borrow number
        invoke(callback)
    }
    *observation
}
