// A module names each of its tests once, wherever in the module each is
// written, so tests in two implementations of one module have two names.
import std.testing

struct Inbox {
    unread: UInt32,
}

struct Outbox {
    queued: UInt32,
}

impl Inbox {
    pub fn new() -> Inbox {
        Inbox { unread = 0 }
    }

    test "starts empty" {
        testing.assert_eq(Inbox.new().unread, 0, "nothing is unread")?
    }
}

impl Outbox {
    pub fn new() -> Outbox {
        Outbox { queued = 0 }
    }

    test "starts empty" {
        testing.assert_eq(Outbox.new().queued, 0, "nothing is queued")?
    }
}

fn main() -> UInt8 {
    if Inbox.new().unread + Outbox.new().queued == 0 {
        0
    } else {
        1
    }
}
