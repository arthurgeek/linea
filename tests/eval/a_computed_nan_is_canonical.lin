fn quotient(left: Float64, right: Float64) -> Float64 {
    left / right
}

fn sum(left: Float64, right: Float64) -> Float64 {
    left + right
}

fn narrow(value: Float64) -> Float32 {
    Float32(value)
}

fn widen(value: Float32) -> Float64 {
    Float64(value)
}

fn main() -> UInt8 {
    let positive_quiet_nan: UInt64 = 9221120237041090560
    let negative_quiet_nan: UInt64 = 18444492273895866368
    let nan = quotient(0.0, 0.0)
    // A NaN arithmetic produces is the positive quiet NaN on every target,
    // whichever NaN went in; negation flips only its sign.
    let computed = nan.to_bits() == positive_quiet_nan
    let negated = (-nan).to_bits() == negative_quiet_nan
    let propagated = sum(-nan, 1.0).to_bits() == positive_quiet_nan
    let infinite = sum(1.0 / 0.0, -1.0 / 0.0).to_bits() == positive_quiet_nan
    let root = Float64.sqrt(-1.0).to_bits() == positive_quiet_nan
    let narrowed = narrow(-nan).to_bits() == UInt32(2143289344)
    let widened = widen(narrow(-nan)).to_bits() == positive_quiet_nan
    // A NaN built from bits reaches each operation as written, negative and
    // with a payload, and comes out as the positive quiet NaN.
    let negative_payload: UInt64 = 18444492273895866369
    let built = Float64.from_bits(negative_payload)
    let built_sum = sum(built, 1.0).to_bits() == positive_quiet_nan
    let built_narrowed = narrow(built).to_bits() == UInt32(2143289344)
    let built_root = Float64.sqrt(built).to_bits() == positive_quiet_nan
    let negative_payload32: UInt32 = 4290772993
    let built_widened = widen(Float32.from_bits(negative_payload32)).to_bits() == positive_quiet_nan
    let built_canonical = built_sum && built_narrowed && built_root && built_widened
    // `from_bits` keeps every bit, a NaN's payload included.
    let payload: UInt64 = 18442240474082181121
    let kept = Float64.from_bits(payload).to_bits() == payload
    if computed && negated && propagated && infinite && root && narrowed && widened && built_canonical && kept {
        0
    } else {
        1
    }
}
