// A pattern names each binder once. The first spelling keeps the name, and
// `_` is not a name, so any number of them may stand in one pattern.
struct Pair { left: UInt8, right: UInt8 }

enum Shape { Rect(UInt8, UInt8), Dot }

fn main() -> UInt8 {
    let Pair { left: side, right: side } = Pair { left = 1, right = 2 }
    let (width, width) = (3, 4)
    let (_, _, ignored) = (5, 6, 7)
    let shape = Shape.Rect(1, 2)
    let area = match shape {
        Rect(w, w) => w,
        Dot => 0,
    }
    let pair: (UInt8, UInt8) = (8, 9)
    let total = match pair {
        (v, v) => v,
    }
    let items = [(1, 2)]
    var sum = 0
    for (n, n) in items {
        sum = sum + n
    }
    side + width + ignored + area + total + sum
}
