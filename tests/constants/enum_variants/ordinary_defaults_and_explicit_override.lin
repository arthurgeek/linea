enum Mode { Preserve, Exact(UInt64) }

fn select(mode: Mode = .Preserve) -> UInt64 {
    match read mode { Preserve => 7, Exact(bits) => bits }
}

fn main() -> UInt8 {
    if select() == 7 && select() == 7 && select(.Preserve) == 7 && select(.Exact(384)) == 384 {
        0
    } else {
        1
    }
}
