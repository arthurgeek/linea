import std.mem
import std.release
import std.session
import std.testing

use mem.SystemAllocator
use session.Chan
use session.End
use session.Recv
use session.Send

// The stack size `prepare` gives a task, in bytes: two mebibytes. The
// deepest path through the library, parsing and rendering a JSON document as
// deeply nested as the parser accepts while sorting and formatting beside
// it, needs under 96 KiB when optimised and under 768 KiB at `-O 0`, so two
// mebibytes leaves more than twice the unoptimised need. A stack costs
// address space until it is touched, not memory.
pub let default_stack_bytes: UInt64 = 2097152

// PrepareError says which step of preparing a task failed: acquiring the
// bytes the body is kept in, or creating the task's thread.
@(copyable, derive(Equatable, Equivalent, Display, Debug, Release))
pub enum PrepareError {
    Allocation,
    Thread,
}

// A Slot is a prepared task: its thread exists, parked before running
// anything, the bytes its body will be kept in are acquired, and it holds the
// body. Holding the body, it carries everything the body captured, so a place
// the body reads cannot be written, nor a place it holds lent `inout`
// touched, while the slot lives. It is linear, so every path either starts it
// or cancels it, and since it has one owner the two cannot race.
@(opaque, linear)
struct Slot[phantom P: Protocol, F, A: Allocator = mem.SystemAllocator] {
    task: UInt64,
    storage: mem.Buffer[A],
    body: F,
}

// Unstarted is a preparation that failed: the body it was given, handed
// back, and the reason. Take both with `let Unstarted { body, reason } =
// failure`. Where the body owns nothing that must be settled, `settled()`
// drops it and keeps the reason.
pub struct Unstarted[F] {
    body: F,
    reason: PrepareError,
}

// A failed preparation whose body may be dropped is released by dropping it.
impl[F: Discardable] Release for Unstarted[F] {
    fn release(sink self: Self) {
        let Unstarted { body: _, reason: _ } = self
    }
}

// Settling a failed preparation drops its body and keeps the reason. A body
// that owns something linear is not dropped: its owner takes it back.
impl[F: Discardable] release.Settle for Unstarted[F] {
    type Reason = PrepareError

    fn settle(sink self: Self) -> PrepareError where carries(self) {
        let Unstarted { body: _, reason } = self
        reason
    }
}

test fn a_failed_preparation_settles_to_its_reason() {
    let body = sink [] |sink me: Chan[End]| {
        me.close()
    }
    // No address space maps a stack of four exbibytes.
    let reason = match prepare_in(mem.system(), body, stack: 4611686018427387904) {
        Ok(slot) => {
            let _unrun = slot.cancel()
            PrepareError.Allocation
        },
        Err(failure) => release.Settle.settle(failure),
    }
    testing.assert_eq(reason, PrepareError.Thread, "settling lost the reason")?
}

// Create a thread parked with a stack of `stack_bytes`, and answer the task,
// or a negative number when the thread could not be created.
extern fn linea_task_prepare(stack_bytes: UInt64) -> Int64

// Release a parked thread with nothing to run, and join it.
extern fn linea_task_cancel(task: UInt64)

// Let the parked thread of `task` run: it calls `entry` with the task's end
// of the session and the address and length of the bytes its body is kept
// in, and the thread that closes the handle calls `release` with the same
// address and length once the task has been joined. The runtime calls both
// after this call returns, and neither after the join. It answers the
// creator's endpoint.
extern fn linea_task_start(task: UInt64, entry: fn(endpoint: UInt64, at: UInt64, len: UInt64), release: fn(at: UInt64, len: UInt64), at: UInt64, len: UInt64) -> UInt64

extern fn linea_chan_close(endpoint: UInt64)

extern fn linea_task_dispatch_worker(worker: fn(ctx: UInt64), ctx: UInt64, max_workers: UInt64)

extern fn linea_task_drain_workers()

extern fn linea_task_worker_id() -> UInt64

extern fn linea_task_set_worker_id(wid: UInt64)

extern fn linea_task_worker_slot() -> UInt64

extern fn linea_task_set_worker_slot(slot: UInt64)

extern fn linea_conn_queue_open() -> UInt64

extern fn linea_conn_queue_push(handle: UInt64, fd: Int32)

extern fn linea_conn_queue_pop(handle: UInt64) -> Int32

extern fn linea_conn_queue_close(handle: UInt64)

extern fn linea_conn_queue_free(handle: UInt64)

extern fn linea_handler_lock()

extern fn linea_handler_unlock()

extern fn linea_latch_open(count: UInt64) -> UInt64

extern fn linea_latch_count_down(handle: UInt64)

extern fn linea_latch_wait(handle: UInt64)

extern fn linea_latch_arrive_and_wait(handle: UInt64) -> UInt8

extern fn linea_latch_arrive_and_wait_timeout(handle: UInt64, timeout_ms: UInt64) -> UInt8

extern fn linea_latch_free(handle: UInt64)

fn run_worker_body[_F: sink fn()](ctx: UInt64) {
    let body: _F = mem.take_kept_body(ctx)
    mem.release_kept_bytes[_F, SystemAllocator](ctx, 0)
    body()
}

pub fn dispatch_worker[F: sink fn()](sink body: F, max_workers: UInt64) {
    let bytes = mem.kept_bytes(body, mem.system())
    let storage = mem.system().acquire(bytes).unwrap()
    let at = mem.keep_body(storage, body)
    linea_task_dispatch_worker(run_worker_body[F], at, max_workers)
}

pub fn drain_workers() {
    linea_task_drain_workers()
}

pub fn worker_id() -> UInt64 {
    linea_task_worker_id()
}

pub fn set_worker_id(wid: UInt64) {
    linea_task_set_worker_id(wid)
}

pub fn worker_slot() -> UInt64 {
    linea_task_worker_slot()
}

pub fn set_worker_slot(slot: UInt64) {
    linea_task_set_worker_slot(slot)
}

@(opaque, linear)
struct ConnectionQueue {
    handle: UInt64,
}

@(opaque, copyable)
struct QueueHandle {
    handle: UInt64,
}

impl ConnectionQueue {
    pub fn open() -> Option[Self] {
        let handle = linea_conn_queue_open()
        if handle == 0 {
            .None
        } else {
            .Some(ConnectionQueue { handle })
        }
    }

    pub fn handle(self: Self) -> QueueHandle {
        QueueHandle { handle = self.handle }
    }

    pub fn close(self: Self) {
        linea_conn_queue_close(self.handle)
    }
}

impl Release for ConnectionQueue {
    fn release(sink self: Self) {
        let ConnectionQueue { handle } = self
        linea_conn_queue_close(handle)
        linea_conn_queue_free(handle)
    }
}

impl QueueHandle {
    pub fn push(self: Self, fd: Int32) {
        linea_conn_queue_push(self.handle, fd)
    }

    pub fn pop(self: Self) -> Int32 {
        linea_conn_queue_pop(self.handle)
    }
}

@(opaque, linear)
struct WorkerTask {
    endpoint: UInt64,
}

impl WorkerTask {
    pub fn close(sink self: Self) {
        let WorkerTask { endpoint } = self
        linea_chan_close(endpoint)
    }
}

@(opaque, linear)
struct Latch {
    handle: UInt64,
}

@(opaque, copyable)
struct LatchHandle {
    handle: UInt64,
}

impl Latch {
    pub fn open(count: UInt64) -> Option[Self] {
        let handle = linea_latch_open(count)
        if handle == 0 {
            .None
        } else {
            .Some(Latch { handle })
        }
    }

    pub fn handle(self: Self) -> LatchHandle {
        LatchHandle { handle = self.handle }
    }

    pub fn count_down(self: Self) {
        linea_latch_count_down(self.handle)
    }

    pub fn wait(self: Self) {
        linea_latch_wait(self.handle)
    }

    pub fn arrive_and_wait(self: Self) -> Bool {
        linea_latch_arrive_and_wait(self.handle) != 0
    }

    pub fn arrive_and_wait_timeout(self: Self, timeout_ms: UInt64) -> Bool {
        linea_latch_arrive_and_wait_timeout(self.handle, timeout_ms) != 0
    }
}

impl Release for Latch {
    fn release(sink self: Self) {
        let Latch { handle } = self
        linea_latch_free(handle)
    }
}

impl Release for LatchHandle {
    fn release(sink _self: Self) {}
}

impl LatchHandle {
    pub fn count_down(self: Self) {
        linea_latch_count_down(self.handle)
    }

    pub fn wait(self: Self) {
        linea_latch_wait(self.handle)
    }

    pub fn arrive_and_wait(self: Self) -> Bool {
        linea_latch_arrive_and_wait(self.handle) != 0
    }

    pub fn arrive_and_wait_timeout(self: Self, timeout_ms: UInt64) -> Bool {
        linea_latch_arrive_and_wait_timeout(self.handle, timeout_ms) != 0
    }
}

test fn latch_synchronizes_tasks_and_times_out() {
    defer let latch = Latch.open(2).unwrap()
    let handle = latch.handle()
    let t = start(
        sink [handle] |sink me: Chan[End]| {
            let entered = handle.arrive_and_wait_timeout(2000)
            match testing.assert(entered, "worker should have entered latch") {
                Ok(_) => {},
                Err(_) => {},
            }
            me.close()
        },
    ).unwrap()
    let arrived = latch.arrive_and_wait_timeout(2000)
    t.close()
    testing.assert(arrived, "main thread should have arrived")?

    // Test timeout when nobody arrives
    defer let lone_latch = Latch.open(2).unwrap()
    let timed_out = lone_latch.arrive_and_wait_timeout(20)
    testing.assert(!timed_out, "single arrival on count 2 should time out")?

    // Zero timeout on count 2 times out immediately
    defer let zero_latch = Latch.open(2).unwrap()
    let zero_timed_out = zero_latch.arrive_and_wait_timeout(0)
    testing.assert(!zero_timed_out, "zero timeout on count 2 must time out")?

    // Zero timeout on count 1 completes immediately
    defer let one_latch = Latch.open(1).unwrap()
    let one_ok = one_latch.arrive_and_wait_timeout(0)
    testing.assert(one_ok, "zero timeout on count 1 must succeed")?

    // Boundary timeout values
    let max_signed_ms: UInt64 = 9223372036854775807
    let past_signed_ms: UInt64 = max_signed_ms + 1
    let max_unsigned_ms: UInt64 = max_signed_ms * 2 + 1

    defer let l_signed = Latch.open(2).unwrap()
    let h_signed = l_signed.handle()
    let t_signed = start(
        sink [h_signed, max_signed_ms] |sink me: Chan[End]| {
            let _ = h_signed.arrive_and_wait_timeout(max_signed_ms)
            me.close()
        },
    ).unwrap()
    let ok_signed = l_signed.arrive_and_wait_timeout(max_signed_ms)
    t_signed.close()
    testing.assert(ok_signed, "latch at INT64_MAX timeout should succeed")?

    defer let l_past = Latch.open(2).unwrap()
    let h_past = l_past.handle()
    let t_past = start(
        sink [h_past, past_signed_ms] |sink me: Chan[End]| {
            let _ = h_past.arrive_and_wait_timeout(past_signed_ms)
            me.close()
        },
    ).unwrap()
    let ok_past = l_past.arrive_and_wait_timeout(past_signed_ms)
    t_past.close()
    testing.assert(ok_past, "latch at INT64_MAX + 1 timeout should succeed")?

    defer let l_max = Latch.open(2).unwrap()
    let h_max = l_max.handle()
    let t_max = start(
        sink [h_max, max_unsigned_ms] |sink me: Chan[End]| {
            let _ = h_max.arrive_and_wait_timeout(max_unsigned_ms)
            me.close()
        },
    ).unwrap()
    let ok_max = l_max.arrive_and_wait_timeout(max_unsigned_ms)
    t_max.close()
    testing.assert(ok_max, "latch at UINT64_MAX timeout should succeed")?
    .Ok(())
}

pub fn handler_lock() {
    linea_handler_lock()
}

pub fn handler_unlock() {
    linea_handler_unlock()
}

// What a task's thread runs: move the body, of type `_F`, out of the bytes it
// is kept in and call it with the task's end of the session. The runtime
// calls it with the bytes' address alone, so no parameter names `_F`;
// `start` names it.
fn run_body[P: Protocol, _F: sink fn(sink me: Chan[P])](endpoint: UInt64, at: UInt64, _len: UInt64) {
    let body: _F = mem.take_kept_body(at)
    body(Chan.opened(endpoint))
}

// Prepare a task whose body is `body`, with a stack of `default_stack_bytes`
// and its bytes from the system allocator. `prepare_in` says what preparing
// does.
pub fn prepare[P: Protocol, F: sink fn(sink me: Chan[P])](sink body: F) -> Result[Slot[P, F, mem.SystemAllocator], Unstarted[F]] where carries(.Ok: body), carries(.Err: body) {
    prepare_in(mem.system(), body, stack: default_stack_bytes)
}

test fn a_prepared_body_runs_once_its_task_starts() {
    var runs = UInt64(0)
    let body = sink [inout runs] |sink me: Chan[End]| {
        runs += 1
        me.close()
    }
    prepare(body).unwrap().start().close()
    testing.assert_eq(runs, 1, "the started body did not run once")?
}

// Prepare a task whose body is `body`, with a stack of `stack` bytes and the
// bytes its body is kept in from `allocator`. Preparing performs every step
// that can fail, and answers a slot holding the body. A failure hands the
// body back in `Unstarted`, beside the reason. The slot carries the
// allocator, since the task keeps its bytes until it is joined.
pub fn prepare_in[P: Protocol, F: sink fn(sink me: Chan[P]), A: Allocator](allocator: A, sink body: F, stack: UInt64) -> Result[Slot[P, F, A], Unstarted[F]] where carries(.Ok: body, allocator), carries(.Err: body) {
    let storage = allocator.acquire(mem.kept_bytes(body, allocator)) else |_| {
        return .Err(.{ body, reason = .Allocation })
    }
    let task = linea_task_prepare(stack)
    if task < 0 {
        storage.release()
        return .Err(.{ body, reason = .Thread })
    }
    .Ok(.{ task = UInt64(task), storage, body })
}

test fn a_refused_allocation_hands_the_body_back() {
    let log = mem.AllocationLog.open(mem.system(), 0).unwrap()
    log.refuse_attempt(1)
    var runs = UInt64(0)
    let body = sink [inout runs] |sink me: Chan[End]| {
        runs += 1
        me.close()
    }
    let (refused, returned) = match prepare_in(log.allocator(), body, stack: default_stack_bytes) {
        Ok(slot) => (false, slot.cancel()),
        Err(failure) => {
            let Unstarted { body, reason } = failure
            (reason == .Allocation, body)
        },
    }
    let settled = log.all_disposed()
    // The body came back from a preparation through the log's allocator, so
    // it is dropped here, before the log; a body handed back runs again in
    // the test below.
    let _returned = returned
    log.release()
    testing.assert(refused, "a refused allocation was not reported as one")?
    testing.assert(settled, "a refused preparation kept an allocation")?
    testing.assert_eq(runs, 0, "a refused body ran")?
}

test fn a_thread_that_cannot_be_made_hands_the_body_back() {
    var runs = UInt64(0)
    let body = sink [inout runs] |sink me: Chan[End]| {
        runs += 1
        me.close()
    }
    // No address space maps a stack of four exbibytes.
    let (refused, returned) = match prepare_in(mem.system(), body, stack: 4611686018427387904) {
        Ok(slot) => (false, slot.cancel()),
        Err(failure) => {
            let Unstarted { body, reason } = failure
            (reason == .Thread, body)
        },
    }
    prepare(returned).unwrap().start().close()
    testing.assert(refused, "an impossible stack was not reported as a thread failure")?
    testing.assert_eq(runs, 1, "the body did not run after a failed thread")?
}

// Prepare and start a task in one call, with a stack of `default_stack_bytes`
// and its bytes from the system allocator, and answer its handle.
// `start_in` says what starting does.
pub fn start[P: Protocol, F: Discardable + sink fn(sink me: Chan[P])](sink body: F) -> Result[Chan[P.Dual, (F, mem.SystemAllocator)], PrepareError] where carries(.Ok: body) {
    start_in(mem.system(), body, stack: default_stack_bytes)
}

test fn a_task_started_in_one_call_runs_its_body() {
    let base = UInt64(4)
    let body = sink [read base] |sink me: Chan[Send[UInt64, End]]| {
        me.send(base * 10).close()
    }
    let (answer, done) = start(body).unwrap().recv()
    done.close()
    testing.assert_eq(answer, 40, "the body did not run")?
}

// Prepare and start a task in one call, with a stack of `stack` bytes and the
// bytes its body is kept in from `allocator`. A failure drops the body and
// answers the reason, which is why the body must be Discardable: it owns
// nothing a drop would lose. A body that owns something linear is prepared
// with `prepare_in`, whose failure hands it back.
pub fn start_in[P: Protocol, F: Discardable + sink fn(sink me: Chan[P]), A: Allocator](allocator: A, sink body: F, stack: UInt64) -> Result[Chan[P.Dual, (F, A)], PrepareError] where carries(.Ok: body, allocator) {
    let slot = prepare_in(allocator, body, stack).settled()?
    .Ok(slot.start())
}

test fn a_task_that_cannot_start_answers_the_reason() {
    let body = sink [] |sink me: Chan[End]| {
        me.close()
    }
    let refused = match start_in(mem.system(), body, stack: 4611686018427387904) {
        Ok(handle) => {
            handle.close()
            false
        },
        Err(reason) => reason == .Thread,
    }
    testing.assert(refused, "an impossible stack was not reported")?
}

impl[P: Protocol, F: sink fn(sink me: Chan[P]), A: Allocator] Slot[P, F, A] {
    // Start the task: move the body into it and let its thread run. Starting
    // cannot fail. It answers the task's handle, the creator's end of the
    // session whose other end the body receives as `me`. The handle's `(F, A)`
    // makes it carry every dependency the body captured and the allocator its
    // bytes came from, so until `close` joins the task nothing the body reads
    // can be written, nothing it holds lent `inout` can be touched, and the
    // allocator's owner, such as an arena, cannot be released. Every capture
    // must cross the task boundary ([O-Cross]).
    pub fn start(sink self: Self) -> Chan[P.Dual, (F, A)] where carries(self) {
        let Slot { task, storage, body } = self
        let len = storage.length()
        let at = mem.keep_body(storage, body)
        Chan.opened(linea_task_start(task, run_body[P, F], mem.release_kept_bytes[F, A], at, len))
    }

    // Start a worker task: move the body into it and let its thread run,
    // answering a linear `WorkerTask` handle that joins the worker when closed.
    // The handle carries what the body captured, so lends and captures
    // remain reserved until the worker is joined.
    pub fn start_worker(sink self: Self) -> WorkerTask where carries(self) {
        let Slot { task, storage, body } = self
        let len = storage.length()
        let at = mem.keep_body(storage, body)
        let endpoint = linea_task_start(task, run_body[P, F], mem.release_kept_bytes[F, A], at, len)
        WorkerTask { endpoint }
    }

    test fn a_started_task_answers_its_handle() {
        let base = UInt64(20)
        let body = sink [read base] |sink me: Chan[Send[UInt64, End]]| {
            me.send(base + 1).close()
        }
        let (answer, done) = prepare(body).unwrap().start().recv()
        done.close()
        testing.assert_eq(answer, 21, "the handle did not receive what the body sent")?
    }

    // Settle a slot that will not be started: release its parked thread with
    // nothing to run, join it, release the bytes the body would have been
    // kept in, and answer the body.
    pub fn cancel(sink self: Self) -> F where carries(self.body) {
        let Slot { task, storage, body } = self
        linea_task_cancel(task)
        storage.release()
        body
    }

    test fn a_cancelled_slot_runs_nothing_and_gives_the_body_back() {
        let log = mem.AllocationLog.open(mem.system(), 0).unwrap()
        var runs = UInt64(0)
        let body = sink [inout runs] |sink me: Chan[End]| {
            runs += 1
            me.close()
        }
        let returned = match prepare_in(log.allocator(), body, stack: default_stack_bytes) {
            Ok(slot) => slot.cancel(),
            Err(failure) => {
                let Unstarted { body, reason: _ } = failure
                body
            },
        }
        let attempts = log.attempts()
        let settled = log.all_disposed()
        let _returned = returned
        log.release()
        testing.assert_eq(attempts, 1, "preparing did not acquire the body's bytes")?
        testing.assert(settled, "cancelling kept the body's bytes")?
        testing.assert_eq(runs, 0, "a cancelled body ran")?
    }
}

// Policy selects the execution strategy for independent value-producing computations.
// `.Sequential` executes inline on the caller's stack with zero thread overhead and
// complete determinism; `.Threads(max)` executes across dedicated worker threads
// bounded by `max`.
@(copyable, derive(Equatable, Equivalent, Display, Debug))
pub enum Policy {
    Sequential,
    Threads(UInt64),
}

// Join two independent calculations according to policy and return both results
// in parameter order once both have finished.
pub fn join[T1: Owned, T2: Owned, F1: Owned + Discardable + sink fn() -> T1, F2: Owned + Discardable + sink fn() -> T2](sink policy: Policy, sink f1: F1, sink f2: F2) -> (T1, T2) {
    match policy {
        Sequential => (f1(), f2()),
        Threads(max) => {
            if max == 0 {
                panic("task.join: policy thread limit cannot be 0")
            }
            if max == 1 {
                return (f1(), f2())
            }
            let body1 = sink [sink f1] |sink me: Chan[Send[T1, End]]| {
                me.send(f1()).close()
            }
            let body2 = sink [sink f2] |sink me: Chan[Send[T2, End]]| {
                me.send(f2()).close()
            }
            let h1 = start(body1).unwrap()
            let h2 = start(body2).unwrap()
            let (r1, done1) = h1.recv()
            done1.close()
            let (r2, done2) = h2.recv()
            done2.close()
            (r1, r2)
        },
    }
}

test fn join_runs_sequentially() {
    let (a, b) = join(Policy.Sequential, sink [] || UInt64(10), sink [] || UInt64(20))
    testing.assert_eq(a, 10, "first sequential join result was wrong")?
    testing.assert_eq(b, 20, "second sequential join result was wrong")?
}

test fn join_runs_on_threads() {
    let (a, b) = join(Policy.Threads(2), sink [] || UInt64(100), sink [] || UInt64(200))
    testing.assert_eq(a, 100, "first threaded join result was wrong")?
    testing.assert_eq(b, 200, "second threaded join result was wrong")?
}

// Join three independent calculations according to policy and return all three results
// in parameter order once all three have finished.
pub fn join3[T1: Owned, T2: Owned, T3: Owned, F1: Owned + Discardable + sink fn() -> T1, F2: Owned + Discardable + sink fn() -> T2, F3: Owned + Discardable + sink fn() -> T3](sink policy: Policy, sink f1: F1, sink f2: F2, sink f3: F3) -> (T1, T2, T3) {
    match policy {
        Sequential => (f1(), f2(), f3()),
        Threads(max) => {
            if max == 0 {
                panic("task.join3: policy thread limit cannot be 0")
            }
            if max == 1 {
                return (f1(), f2(), f3())
            }
            let body1 = sink [sink f1] |sink me: Chan[Send[T1, End]]| {
                me.send(f1()).close()
            }
            let body2 = sink [sink f2] |sink me: Chan[Send[T2, End]]| {
                me.send(f2()).close()
            }
            let body3 = sink [sink f3] |sink me: Chan[Send[T3, End]]| {
                me.send(f3()).close()
            }
            let h1 = start(body1).unwrap()
            let h2 = start(body2).unwrap()
            let h3 = start(body3).unwrap()
            let (r1, done1) = h1.recv()
            done1.close()
            let (r2, done2) = h2.recv()
            done2.close()
            let (r3, done3) = h3.recv()
            done3.close()
            (r1, r2, r3)
        },
    }
}

test fn join3_runs_sequentially_and_on_threads() {
    let (s1, s2, s3) = join3(Policy.Sequential, sink [] || UInt64(1), sink [] || UInt64(2), sink [] || UInt64(3))
    testing.assert_eq(s1, 1, "s1 wrong")?
    testing.assert_eq(s2, 2, "s2 wrong")?
    testing.assert_eq(s3, 3, "s3 wrong")?

    let (t1, t2, t3) = join3(Policy.Threads(3), sink [] || UInt64(10), sink [] || UInt64(20), sink [] || UInt64(30))
    testing.assert_eq(t1, 10, "t1 wrong")?
    testing.assert_eq(t2, 20, "t2 wrong")?
    testing.assert_eq(t3, 30, "t3 wrong")?
}

// Join four independent calculations according to policy and return all four results
// in parameter order once all four have finished.
pub fn join4[T1: Owned, T2: Owned, T3: Owned, T4: Owned, F1: Owned + Discardable + sink fn() -> T1, F2: Owned + Discardable + sink fn() -> T2, F3: Owned + Discardable + sink fn() -> T3, F4: Owned + Discardable + sink fn() -> T4](sink policy: Policy, sink f1: F1, sink f2: F2, sink f3: F3, sink f4: F4) -> (T1, T2, T3, T4) {
    match policy {
        Sequential => (f1(), f2(), f3(), f4()),
        Threads(max) => {
            if max == 0 {
                panic("task.join4: policy thread limit cannot be 0")
            }
            if max == 1 {
                return (f1(), f2(), f3(), f4())
            }
            let body1 = sink [sink f1] |sink me: Chan[Send[T1, End]]| {
                me.send(f1()).close()
            }
            let body2 = sink [sink f2] |sink me: Chan[Send[T2, End]]| {
                me.send(f2()).close()
            }
            let body3 = sink [sink f3] |sink me: Chan[Send[T3, End]]| {
                me.send(f3()).close()
            }
            let body4 = sink [sink f4] |sink me: Chan[Send[T4, End]]| {
                me.send(f4()).close()
            }
            let h1 = start(body1).unwrap()
            let h2 = start(body2).unwrap()
            let h3 = start(body3).unwrap()
            let h4 = start(body4).unwrap()
            let (r1, done1) = h1.recv()
            done1.close()
            let (r2, done2) = h2.recv()
            done2.close()
            let (r3, done3) = h3.recv()
            done3.close()
            let (r4, done4) = h4.recv()
            done4.close()
            (r1, r2, r3, r4)
        },
    }
}

test fn join4_runs_sequentially_and_on_threads() {
    let (s1, _, _, s4) = join4(Policy.Sequential, sink [] || UInt64(1), sink [] || UInt64(2), sink [] || UInt64(3), sink [] || UInt64(4))
    testing.assert_eq(s1, 1, "s1 wrong")?
    testing.assert_eq(s4, 4, "s4 wrong")?

    let (t1, _, _, t4) = join4(Policy.Threads(4), sink [] || UInt64(10), sink [] || UInt64(20), sink [] || UInt64(30), sink [] || UInt64(40))
    testing.assert_eq(t1, 10, "t1 wrong")?
    testing.assert_eq(t4, 40, "t4 wrong")?
}

// all executes a collection of homogeneous independent jobs according to policy,
// awaiting their completion and returning results in job order (like Promise.all).
pub fn all[T: Owned, F: Owned + Discardable + fn() -> T](sink policy: Policy, sink jobs: mem.Vec[F, mem.SystemAllocator]) -> mem.Vec[T, mem.SystemAllocator] {
    match policy {
        Sequential => {
            var results: mem.Vec[T, mem.SystemAllocator] = mem.Vec.new()
            var pending = jobs.drain()
            for job in &pending {
                &results.push(job()).unwrap()
            }
            pending.finish().unwrap()
            results
        },
        Threads(max) => {
            if max == 0 {
                panic("task.all: policy thread limit cannot be 0")
            }
            if max == 1 {
                var results: mem.Vec[T, mem.SystemAllocator] = mem.Vec.new()
                var pending = jobs.drain()
                for job in &pending {
                    &results.push(job()).unwrap()
                }
                pending.finish().unwrap()
                return results
            }
            let total = jobs.length()
            if total == 0 {
                jobs.finish().unwrap()
                return mem.Vec.new()
            }
            var results: mem.Vec[T, mem.SystemAllocator] = mem.Vec.new()
            var pending_jobs = jobs.drain()
            var running = true
            while running {
                var handles: mem.Vec[Chan[Recv[T, End]], mem.SystemAllocator] = mem.Vec.new()
                for _ in 0..max {
                    match &pending_jobs.next() {
                        Some(job) => {
                            let body = sink [sink job] |sink me: Chan[Send[T, End]]| {
                                me.send(job()).close()
                            }
                            let handle = prepare(body).unwrap().start()
                            &handles.push(session.detach(handle)).unwrap()
                        },
                        None => {
                            running = false
                            break
                        },
                    }
                }
                var pending_handles = handles.drain()
                for handle in &pending_handles {
                    let (val, done) = handle.recv()
                    done.close()
                    &results.push(val).unwrap()
                }
                pending_handles.finish().unwrap()
            }
            pending_jobs.finish().unwrap()
            results
        },
    }
}

fn job1() -> UInt64 {
    1
}

fn job2() -> UInt64 {
    2
}

fn job3() -> UInt64 {
    3
}

fn job10() -> UInt64 {
    10
}

fn job20() -> UInt64 {
    20
}

fn job30() -> UInt64 {
    30
}

test fn all_runs_sequentially_and_on_threads() {
    var jobs_seq: mem.Vec[fn() -> UInt64, mem.SystemAllocator] = mem.Vec.new()
    &jobs_seq.push(job1).unwrap()
    &jobs_seq.push(job2).unwrap()
    &jobs_seq.push(job3).unwrap()
    var res_seq: mem.Vec[UInt64, mem.SystemAllocator] = all(Policy.Sequential, jobs_seq)
    let seq_len = res_seq.length()
    res_seq.release()
    testing.assert_eq(seq_len, 3, "sequential all length wrong")?

    var jobs_par: mem.Vec[fn() -> UInt64, mem.SystemAllocator] = mem.Vec.new()
    &jobs_par.push(job10).unwrap()
    &jobs_par.push(job20).unwrap()
    &jobs_par.push(job30).unwrap()
    var res_par: mem.Vec[UInt64, mem.SystemAllocator] = all(Policy.Threads(3), jobs_par)
    let par_len = res_par.length()
    res_par.release()
    testing.assert_eq(par_len, 3, "threaded all length wrong")?
}

// map transforms items according to policy across worker threads bounded by max.
pub fn map[T: Owned, R: Owned, F: Owned + Copyable + Shareable + fn(sink item: T) -> R](sink policy: Policy, sink items: mem.Vec[T, mem.SystemAllocator], sink f: F) -> mem.Vec[R, mem.SystemAllocator] {
    match policy {
        Sequential => {
            var results: mem.Vec[R, mem.SystemAllocator] = mem.Vec.new()
            var pending = items.drain()
            for item in &pending {
                &results.push(f(item)).unwrap()
            }
            pending.finish().unwrap()
            results
        },
        Threads(max) => {
            if max == 0 {
                panic("task.map: policy thread limit cannot be 0")
            }
            if max == 1 {
                var results: mem.Vec[R, mem.SystemAllocator] = mem.Vec.new()
                var pending = items.drain()
                for item in &pending {
                    &results.push(f(item)).unwrap()
                }
                pending.finish().unwrap()
                return results
            }
            let total = items.length()
            if total == 0 {
                items.finish().unwrap()
                return mem.Vec.new()
            }
            let workers = if max > total {
                total
            } else {
                max
            }
            let base_chunk = total / workers
            let remainder = total % workers

            var handles: mem.Vec[Chan[Recv[mem.Vec[R, mem.SystemAllocator], End]], mem.SystemAllocator] = mem.Vec.new()
            var drained = items.drain()
            for worker_idx in 0..workers {
                let chunk_len = base_chunk + (if worker_idx < remainder {
                    UInt64(1)
                } else {
                    UInt64(0)
                })
                var chunk: mem.Vec[T, mem.SystemAllocator] = mem.Vec.new()
                for _ in 0..chunk_len {
                    match &drained.next() {
                        Some(item) => {
                            &chunk.push(item).unwrap()
                        },
                        None => break,
                    }
                }
                let body = sink [sink chunk, sink f = copy(f)] |sink me: Chan[Send[mem.Vec[R, mem.SystemAllocator], End]]| {
                    var chunk_res: mem.Vec[R, mem.SystemAllocator] = mem.Vec.new()
                    var pending_chunk = chunk.drain()
                    for item in &pending_chunk {
                        &chunk_res.push(f(item)).unwrap()
                    }
                    pending_chunk.finish().unwrap()
                    me.send(chunk_res).close()
                }
                let handle = prepare(body).unwrap().start()
                &handles.push(session.detach(handle)).unwrap()
            }
            drained.finish().unwrap()

            var results: mem.Vec[R, mem.SystemAllocator] = mem.Vec.new()
            var pending_handles = handles.drain()
            for handle in &pending_handles {
                let (chunk_res, done) = handle.recv()
                done.close()
                var pending_chunk_res = chunk_res.drain()
                for res in &pending_chunk_res {
                    &results.push(res).unwrap()
                }
                pending_chunk_res.finish().unwrap()
            }
            pending_handles.finish().unwrap()
            results
        },
    }
}

test fn map_preserves_deterministic_order() {
    var items: mem.Vec[UInt64, mem.SystemAllocator] = mem.Vec.new()
    for i in 1..=10 {
        &items.push(i).unwrap()
    }
    var squared = map(Policy.Threads(4), items, |sink x| x * x)
    let len_matches = squared.length() == 10
    var i: UInt64 = 1
    var order_matches = true
    var pending = squared.drain()
    for res in &pending {
        if res != i * i {
            order_matches = false
        }
        i += 1
    }
    pending.finish().unwrap()
    testing.assert(len_matches, "mapped length wrong")?
    testing.assert(order_matches, "deterministic order violated")?
}

test fn map_results_preserves_all_slots() {
    var items: mem.Vec[UInt64, mem.SystemAllocator] = mem.Vec.new()
    for i in 1..=6 {
        &items.push(i).unwrap()
    }
    var results = map_results(
        Policy.Threads(3),
        items,
        |sink x| {
            let res: Result[UInt64, UInt64] = if x % 2 == 0 {
                .Ok(x * 10)
            } else {
                .Err(99)
            }
            res
        },
    )
    let len_matches = results.length() == 6
    var count: UInt64 = 1
    var results_match = true
    var pending = results.drain()
    for r in &pending {
        match r {
            Ok(v) => {
                if v != count * 10 {
                    results_match = false
                }
            },
            Err(e) => {
                if e != 99 {
                    results_match = false
                }
            },
        }
        count += 1
    }
    pending.finish().unwrap()
    testing.assert(len_matches, "map_results lost elements")?
    testing.assert(results_match, "results mismatch")?
}

// map_results transforms items with full error accounting: every element occupies an explicit slot.
pub fn map_results[T: Owned, R: Owned, E: Owned, F: Owned + Copyable + Shareable + fn(sink item: T) -> Result[R, E]](sink policy: Policy, sink items: mem.Vec[T, mem.SystemAllocator], sink f: F) -> mem.Vec[Result[R, E], mem.SystemAllocator] {
    match policy {
        Sequential => {
            var results: mem.Vec[Result[R, E], mem.SystemAllocator] = mem.Vec.new()
            var pending = items.drain()
            for item in &pending {
                &results.push(f(item)).unwrap()
            }
            pending.finish().unwrap()
            results
        },
        Threads(max) => {
            if max == 0 {
                panic("task.map: policy thread limit cannot be 0")
            }
            if max == 1 {
                var results: mem.Vec[Result[R, E], mem.SystemAllocator] = mem.Vec.new()
                var pending = items.drain()
                for item in &pending {
                    &results.push(f(item)).unwrap()
                }
                pending.finish().unwrap()
                return results
            }
            let total = items.length()
            if total == 0 {
                items.finish().unwrap()
                return mem.Vec.new()
            }
            let workers = if max > total {
                total
            } else {
                max
            }
            let base_chunk = total / workers
            let remainder = total % workers

            var handles: mem.Vec[Chan[Recv[mem.Vec[Result[R, E], mem.SystemAllocator], End]], mem.SystemAllocator] = mem.Vec.new()
            var drained = items.drain()
            for worker_idx in 0..workers {
                let chunk_len = base_chunk + (if worker_idx < remainder {
                    UInt64(1)
                } else {
                    UInt64(0)
                })
                var chunk: mem.Vec[T, mem.SystemAllocator] = mem.Vec.new()
                for _ in 0..chunk_len {
                    match &drained.next() {
                        Some(item) => {
                            &chunk.push(item).unwrap()
                        },
                        None => break,
                    }
                }
                let body = sink [sink chunk, sink f = copy(f)] |sink me: Chan[Send[mem.Vec[Result[R, E], mem.SystemAllocator], End]]| {
                    var chunk_res: mem.Vec[Result[R, E], mem.SystemAllocator] = mem.Vec.new()
                    var pending_chunk = chunk.drain()
                    for item in &pending_chunk {
                        &chunk_res.push(f(item)).unwrap()
                    }
                    pending_chunk.finish().unwrap()
                    me.send(chunk_res).close()
                }
                let handle = prepare(body).unwrap().start()
                &handles.push(session.detach(handle)).unwrap()
            }
            drained.finish().unwrap()

            var results: mem.Vec[Result[R, E], mem.SystemAllocator] = mem.Vec.new()
            var pending_handles = handles.drain()
            for handle in &pending_handles {
                let (chunk_res, done) = handle.recv()
                done.close()
                var pending_chunk_res = chunk_res.drain()
                for res in &pending_chunk_res {
                    &results.push(res).unwrap()
                }
                pending_chunk_res.finish().unwrap()
            }
            pending_handles.finish().unwrap()
            results
        },
    }
}

// ThreadPool manages a pool of worker threads as an explicit linear resource.
@(opaque, linear)
struct ThreadPool {
    workers: UInt64,
    max_queued: UInt64,
}

impl ThreadPool {
    pub fn open(workers: UInt64, max_queued: UInt64) -> Result[ThreadPool, PrepareError] {
        if workers == 0 {
            return .Err(PrepareError.Thread)
        }
        .Ok(.{ workers, max_queued })
    }

    pub fn close(sink self: Self) {
        let ThreadPool { workers: _, max_queued: _ } = self
    }

    pub fn all[T: Owned, F: Owned + Discardable + fn() -> T](self: Self, sink jobs: mem.Vec[F, mem.SystemAllocator]) -> mem.Vec[T, mem.SystemAllocator] {
        all(Policy.Threads(self.workers), jobs)
    }

    pub fn join[T1: Owned, T2: Owned, F1: Owned + Discardable + sink fn() -> T1, F2: Owned + Discardable + sink fn() -> T2](self: Self, sink f1: F1, sink f2: F2) -> (T1, T2) {
        join(Policy.Threads(self.workers), f1, f2)
    }

    pub fn join3[T1: Owned, T2: Owned, T3: Owned, F1: Owned + Discardable + sink fn() -> T1, F2: Owned + Discardable + sink fn() -> T2, F3: Owned + Discardable + sink fn() -> T3](self: Self, sink f1: F1, sink f2: F2, sink f3: F3) -> (T1, T2, T3) {
        join3(Policy.Threads(self.workers), f1, f2, f3)
    }

    pub fn join4[T1: Owned, T2: Owned, T3: Owned, T4: Owned, F1: Owned + Discardable + sink fn() -> T1, F2: Owned + Discardable + sink fn() -> T2, F3: Owned + Discardable + sink fn() -> T3, F4: Owned + Discardable + sink fn() -> T4](self: Self, sink f1: F1, sink f2: F2, sink f3: F3, sink f4: F4) -> (T1, T2, T3, T4) {
        join4(Policy.Threads(self.workers), f1, f2, f3, f4)
    }

    pub fn map[T: Owned, R: Owned, F: Owned + Copyable + Shareable + fn(sink item: T) -> R](self: Self, sink items: mem.Vec[T, mem.SystemAllocator], sink f: F) -> mem.Vec[R, mem.SystemAllocator] {
        map(Policy.Threads(self.workers), items, f)
    }
}

test fn thread_pool_executes_work_and_closes() {
    let pool = ThreadPool.open(workers: 2, max_queued: 10).unwrap()
    let (a, b) = pool.join(sink [] || UInt64(5), sink [] || UInt64(15))
    let a_matches = a == 5
    let b_matches = b == 15
    pool.close()
    testing.assert(a_matches, "pool join first result wrong")?
    testing.assert(b_matches, "pool join second result wrong")?
}

test fn mailbox_owning_task_counts_concurrent_increments() {
    let env = UInt64(0)
    var mb: session.Mailbox[UInt64, UInt64] = session.Mailbox.open(env)
    let s1 = &mb.sender()
    let s2 = s1.clone()
    let slot1 = prepare(
        sink [sink s1] |sink me: session.Chan[session.End]| {
            s1.send(10).close()
            me.close()
        },
    ).unwrap()
    let handle1 = slot1.start()
    let slot2 = prepare(
        sink [sink s2] |sink me: session.Chan[session.End]| {
            s2.send(20).close()
            me.close()
        },
    ).unwrap()
    let handle2 = slot2.start()
    let total = count_messages_test(mb, 0)
    handle1.close()
    handle2.close()
    testing.assert_eq(total, 30, "counter total mismatch")?
}

fn count_messages_test(sink mb: session.Mailbox[UInt64, UInt64], total: UInt64) -> UInt64 {
    match mb.recv() {
        Message(n, next_mb) => count_messages_test(next_mb, total + n),
        Closed => total,
    }
}

test fn worker_slots_are_thread_local() {
    set_worker_slot(12345)
    testing.assert_eq(worker_slot(), 12345, "main thread worker slot mismatch")?
    let body = sink [] |sink me: session.Chan[session.Send[UInt64, session.End]]| {
        let initial = worker_slot()
        set_worker_slot(9999)
        let changed = worker_slot()
        me.send(initial + changed).close()
    }
    let slot = prepare(body).unwrap()
    let (res, done) = slot.start().recv()
    done.close()
    testing.assert_eq(res, 9999, "new task did not have zero initial slot or failed to update")?
    testing.assert_eq(worker_slot(), 12345, "child task modified main thread's worker slot")?
    set_worker_slot(0)
    testing.assert_eq(worker_slot(), 0, "failed to reset worker slot")?
}

test fn background_workers_dispatch_and_drain() {
    let env = UInt64(0)
    var mb: session.Mailbox[UInt64, UInt64] = session.Mailbox.open(env)
    let sender1 = &mb.sender()
    let s1 = sender1.clone()
    let s2 = sender1.clone()
    sender1.close()

    dispatch_worker(
        sink [sink s1] || {
            s1.send(50).close()
        },
        2,
    )
    dispatch_worker(
        sink [sink s2] || {
            s2.send(50).close()
        },
        2,
    )

    drain_workers()
    let total = count_messages_test(mb, 0)
    testing.assert_eq(total, 100, "dispatched workers total mismatch")?
}

test fn worker_identity_is_separate_from_worker_slot() {
    testing.assert_eq(worker_id(), 0, "main thread must have zero worker_id")?
    var mb: session.Mailbox[(UInt64, UInt64), UInt64] = session.Mailbox.open(0)
    let s = &mb.sender()
    dispatch_worker(
        sink [sink s] || {
            s.send((worker_id(), worker_slot())).close()
        },
        1,
    )
    drain_workers()
    let (id, slot) = match mb.recv() {
        Message(pair, rest) => {
            rest.close()
            pair
        },
        Closed => (0, 999),
    }
    testing.assert(id >= 1, "pool worker must have non-zero worker_id")?
    testing.assert_eq(slot, 0, "pool worker must start with zero worker_slot")?
}

test fn a_task_can_set_and_read_its_worker_id() {
    testing.assert_eq(worker_id(), 0, "main thread worker_id should be 0")?
    set_worker_id(123)
    testing.assert_eq(worker_id(), 123, "worker_id mismatch after setting")?
    let body = sink [] |sink me: session.Chan[session.Send[UInt64, session.End]]| {
        let initial = worker_id()
        set_worker_id(456)
        let changed = worker_id()
        me.send(initial + changed).close()
    }
    let slot = prepare(body).unwrap()
    let (res, done) = slot.start().recv()
    done.close()
    testing.assert_eq(res, 456, "child task did not start at 0 or update correctly")?
    testing.assert_eq(worker_id(), 123, "child task modified caller worker_id")?
    set_worker_id(0)
    testing.assert_eq(worker_id(), 0, "failed to reset worker_id")?
}

test fn a_connection_queue_buffers_and_hands_over_descriptors() {
    defer let q = ConnectionQueue.open().unwrap()
    let handle = q.handle()
    handle.push(10)
    handle.push(20)
    let fd1 = handle.pop()
    let fd2 = handle.pop()
    testing.assert_eq(fd1, 10, "first descriptor was not 10")?
    testing.assert_eq(fd2, 20, "second descriptor was not 20")?
    q.close()
    let closed_fd = handle.pop()
    testing.assert_eq(closed_fd, -1, "pop on closed queue must return -1")?
    .Ok(())
}

test fn a_connection_queue_passes_descriptors_between_tasks() {
    defer let q = ConnectionQueue.open().unwrap()
    let handle = q.handle()
    let worker = sink [handle] |sink me: session.Chan[session.Send[Int32, session.End]]| {
        let fd = handle.pop()
        me.send(fd).close()
    }
    let slot = prepare(worker).unwrap()
    let task_handle = slot.start()
    handle.push(88)
    let (received_fd, done) = task_handle.recv()
    done.close()
    testing.assert_eq(received_fd, 88, "worker did not receive pushed descriptor")?
    .Ok(())
}
