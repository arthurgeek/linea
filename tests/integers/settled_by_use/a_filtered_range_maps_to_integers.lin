// `filter` keeps the even numbers below 6 and `map` adds one to each, so every
// walk sees 1, 3 and 5. The chain, the same calls written through `Sequence`,
// and a `for` over the adapter all read the literals as `Int64`; a `map` whose
// lambda says it returns `UInt32` makes the items `UInt32`.
fn main() -> UInt8 {
    let chained = (0..6).filter(|i| i % 2 == 0).map(|sink i| i + 1).fold(0, |sink sum, sink i| sum + i)
    let nested = Sequence.fold(Sequence.map(Sequence.filter(0..6, |i| i % 2 == 0), |sink i| i + 1), 0, |sink sum, sink i| sum + i)
    var walked = 0
    for item in (0..6).filter(|i| i % 2 == 0).map(|sink i| i + 1) {
        walked += item
    }
    let found = (0..6).filter(|i| i % 2 == 0).map(|sink i| -> UInt32 where carries() i + 1).any(|sink i| i == 5)
    let _: Int64 = chained
    if found {
        UInt8(chained + nested + walked)
    } else {
        0
    }
}
