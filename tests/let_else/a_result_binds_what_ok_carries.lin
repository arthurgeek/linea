// `let … else` binds what a successful `Result` carries and runs the `else`
// block only when the result failed.
enum Fault {
    Missing,
}

fn lookup(key: UInt8) -> Result[UInt8, Fault] {
    if key == 3 {
        Result.Ok(40)
    } else {
        Result.Err(Fault.Missing)
    }
}

fn main() -> UInt8 {
    let found = lookup(3) else |_| {
        return 1
    }
    found + 2
}
