import std.io
import std.mem
import std.net
import std.session
import std.task
import std.time

use io.Reader
use net.Acceptor
use net.Accepted
use session.Chan
use session.End

fn main() -> UInt8 {
    let listening = net.listen(net.loopback(0)).unwrap()
    let address = listening.local_address().unwrap()
    let execution = io.Loop.open(carriers: 2).unwrap()
    var passed = false
    let body = sink [sink listening, inout passed] |sink me: Chan[End]| {
        var listener = listening
        let first = task.current_carrier().unwrap()
        let Accepted { connection, address: _ } = &listener.accept_by(time.Deadline.after(time.Duration.from_milliseconds(500))).unwrap()
        if first == task.current_carrier().unwrap() {
            panic("the completed accept did not migrate its continuation")
        }
        time.sleep(time.Duration.from_nanoseconds(0))
        if first != task.current_carrier().unwrap() {
            panic("the accept continuation did not return to its first carrier")
        }
        listener.release()
        var stream = connection
        var buffer = mem.system().acquire(1).unwrap()
        let received = &stream.read_some(&buffer, offset: 0, count: 1).unwrap()
        if received != 1 || buffer.as_slice()[0] != 120 {
            panic("the accepted descriptor did not retain its connection")
        }
        buffer.release()
        stream.release()
        passed = true
        me.close()
    }
    let running = task.prepare(body, on: execution).unwrap().start()
    var peer = net.connect(address).unwrap()
    let _sent = io.write_all(&peer, "x".as_bytes()).unwrap()
    running.close()
    peer.release()
    if passed {
        0
    } else {
        1
    }
}
