import std.mem
import std.task
import std.testing

// `Stated` holds the application's state and the handler that answers with
// it. It is the top of a stack: `serve` lends it `()`, and it lends its own
// state to the handler it holds, which passes it down to every middleware
// and route. Releasing it releases the state, so the state may own what must
// be released, such as a connection.
@opaque
struct Stated[S, H] {
    state: S,
    handler: H,
}

// Releasing a `Stated` releases the state and the handler it holds.
derive[S: Release, H: Release] Release for Stated[S, H]

// `with_state` makes a handler that owns `state` and lends it to `handler`,
// which may be a router or a whole stack of middleware around one, on every
// request.
pub fn with_state[S, H](sink state: S, sink handler: H) -> Stated[S, H] where carries(state, handler) {
    .{ state, handler }
}

test fn with_state_lends_its_state_to_every_request() {
    var router: Router[Visits] = Router.new()
    &router.route_raw("GET /visit", visit).unwrap()
    defer var server = with_state(Visits { count = 0 }, router)
    defer let arena = mem.Arena.open(mem.system(), size: 65536)
    // `serve` lends a `Stated` nothing, `()`, as this test does.
    var nothing = ()
    let first = new_request(arena.handle(), "GET", "/visit", body: "").unwrap()
    let _first = &server.serve_http(&nothing, first.request()).unwrap()
    let second = new_request(arena.handle(), "GET", "/visit", body: "").unwrap()
    let answered = &server.serve_http(&nothing, second.request()).unwrap()
    testing.assert_ok_eq(answered.text(), "visit 2", "the state was not kept between requests")?
    .Ok(())
}

impl[S, H] Stated[S, H] {
    // `state` reads the state, such as a count the routes kept, once serving
    // has stopped or between requests in a test.
    pub fn state(self: Self) -> borrow S where borrows(self) {
        borrow self.state
    }

    test fn a_stated_handler_reads_its_state() {
        var router: Router[Visits] = Router.new()
        &router.route_raw("GET /visit", visit).unwrap()
        defer var server = with_state(Visits { count = 0 }, router)
        let before = server.state().count
        defer let arena = mem.Arena.open(mem.system(), size: 65536)
        var nothing = ()
        let sent = new_request(arena.handle(), "GET", "/visit", body: "").unwrap()
        let _answered = &server.serve_http(&nothing, sent.request()).unwrap()
        testing.assert_eq(before, UInt64(0), "a new state changed")?
        testing.assert_eq(server.state().count, UInt64(1), "the state did not show the visit")?
        .Ok(())
    }
}

impl[S, H: Release] Stated[S, H] {
    // `into_state` releases the handler and returns the state, so a program
    // that served the `Stated` reads what its routes changed and releases it.
    pub fn into_state(sink self: Self) -> S {
        let Stated { state, handler } = self
        handler.release()
        state
    }

    test fn into_state_returns_the_state_and_releases_the_handler() {
        let router: Router[Visits] = Router.new()
        var server = with_state(Visits { count = 3 }, router)
        defer let arena = mem.Arena.open(mem.system(), size: 65536)
        var nothing = ()
        let sent = new_request(arena.handle(), "GET", "/nowhere", body: "").unwrap()
        let _missing = &server.serve_http(&nothing, sent.request())
        let visits = server.into_state()
        testing.assert_eq(visits.count, UInt64(3), "the state changed")?
        visits.release()
        .Ok(())
    }
}

// A `Stated` answers a request by lending its state to the handler it holds.
// It takes `()` itself, which is what `serve` lends.
impl[P: Allocator, S, H: Handler[S, P]] Handler[(), P] for Stated[S, H] {
    fn serve_http(inout self: Self, inout _state: (), request: Request[P]) -> Result[Response[P], Error[P]] {
        &self.handler.serve_http(&self.state, request)
    }
}

// A `Stated` passes every event on to the handler it holds.
impl[S, H: Observer] Observer for Stated[S, H] {
    fn observe[P: Allocator](inout self: Self, event: Event[P]) {
        &self.handler.observe(event)
    }
}

// `WithClient` holds a handler and a client of the owning task that keeps the
// routes' shared state, and lends the client to the handler on every request.
// Each serving task holds its own, so no handler is reached by two tasks.
struct WithClient[S: Owned, H] {
    client: task.Client[S],
    handler: H,
}

// `with_client` makes a handler that lends `client` to `handler`, which may be
// a router or a whole stack of middleware around one, on every request.
fn with_client[S: Owned, H](sink handler: H, sink client: task.Client[S]) -> WithClient[S, H] where carries(handler, client) {
    .{ client, handler }
}

// Releasing a `WithClient` releases the handler; the client borrows its owning
// task and holds nothing to release.
impl[S: Owned, H: Release] Release for WithClient[S, H] {
    fn release(sink self: Self) {
        let WithClient { client: _, handler } = self
        handler.release()
    }
}

// A `WithClient` answers a request by lending its client to the handler it
// holds. It takes `()` itself, which is what serving lends.
impl[P: Allocator, S: Owned, H: Handler[task.Client[S], P]] Handler[(), P] for WithClient[S, H] {
    fn serve_http(inout self: Self, inout _state: (), request: Request[P]) -> Result[Response[P], Error[P]] {
        &self.handler.serve_http(&self.client, request)
    }
}

// A `WithClient` passes every event on to the handler it holds.
impl[S: Owned, H: Observer] Observer for WithClient[S, H] {
    fn observe[P: Allocator](inout self: Self, event: Event[P]) {
        &self.handler.observe(event)
    }
}
