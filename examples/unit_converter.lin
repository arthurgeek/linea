// Convert a measurement from one unit to another. `unit_converter length 5 km mi`
// converts five kilometres to miles, `weight` converts masses, and
// `temperature` converts between Celsius, Fahrenheit and kelvin.
// `unit_converter units` lists the units each kind of measurement knows.
import std.cli
import std.env
import std.io
import std.testing

// Return how many metres one `unit` of length holds, or `.None` for a name
// that is not a length unit.
fn metres_in(unit: Str) -> Option[Float64] {
    if unit == "mm" {
        return .Some(0.001)
    }
    if unit == "cm" {
        return .Some(0.01)
    }
    if unit == "m" {
        return .Some(1.0)
    }
    if unit == "km" {
        return .Some(1000.0)
    }
    if unit == "in" {
        return .Some(0.0254)
    }
    if unit == "ft" {
        return .Some(0.3048)
    }
    if unit == "mi" {
        return .Some(1609.344)
    }
    .None
}

// Return how many grams one `unit` of weight holds, or `.None` for a name
// that is not a weight unit.
fn grams_in(unit: Str) -> Option[Float64] {
    if unit == "g" {
        return .Some(1.0)
    }
    if unit == "kg" {
        return .Some(1000.0)
    }
    if unit == "oz" {
        return .Some(28.349523125)
    }
    if unit == "lb" {
        return .Some(453.59237)
    }
    .None
}

// A conversion the parse accepted but the units cannot make. `message` is
// what the program reports for it.
@(copyable, derive(Debug, Equatable))
enum Mistake {
    NegativeLength,
    NegativeWeight,
    BelowAbsoluteZero,
    LengthUnit,
    WeightUnit,
    TemperatureUnit,
}

impl Mistake {
    fn message(self: Self) -> Str {
        match self {
            NegativeLength => "a length cannot be negative",
            NegativeWeight => "a weight cannot be negative",
            BelowAbsoluteZero => "no temperature is below absolute zero",
            LengthUnit => "length units are mm, cm, m, km, in, ft and mi",
            WeightUnit => "weight units are g, kg, oz and lb",
            TemperatureUnit => "temperature units are C, F and K",
        }
    }
}

// Convert a temperature to kelvin, or `.None` for a name that is not a
// temperature unit.
fn to_kelvin(value: Float64, unit: Str) -> Option[Float64] {
    if unit == "C" {
        return .Some(value + 273.15)
    }
    if unit == "F" {
        return .Some((value - 32.0) * 5.0 / 9.0 + 273.15)
    }
    if unit == "K" {
        return .Some(value)
    }
    .None
}

// Convert a temperature in kelvin to `unit`, which `to_kelvin` accepted.
fn from_kelvin(kelvin: Float64, unit: Str) -> Float64 {
    if unit == "C" {
        return kelvin - 273.15
    }
    if unit == "F" {
        return (kelvin - 273.15) * 9.0 / 5.0 + 32.0
    }
    kelvin
}

// Convert `value` from the unit `from` to the unit `to` for the kind of
// measurement the command `kind` names: a length through metres, a weight
// through grams, and a temperature through kelvin.
fn convert(kind: Str, value: Float64, from: Str, to: Str) -> Result[Float64, Mistake] {
    if kind == "length" {
        if value < 0.0 {
            return .Err(.NegativeLength)
        }
        let from_metres = metres_in(from) else {
            return .Err(.LengthUnit)
        }
        let to_metres = metres_in(to) else {
            return .Err(.LengthUnit)
        }
        return .Ok(value * from_metres / to_metres)
    }
    if kind == "weight" {
        if value < 0.0 {
            return .Err(.NegativeWeight)
        }
        let from_grams = grams_in(from) else {
            return .Err(.WeightUnit)
        }
        let to_grams = grams_in(to) else {
            return .Err(.WeightUnit)
        }
        return .Ok(value * from_grams / to_grams)
    }
    let kelvin = to_kelvin(value, from) else {
        return .Err(.TemperatureUnit)
    }
    if to_kelvin(0.0, to).is_none() {
        return .Err(.TemperatureUnit)
    }
    if kelvin < 0.0 {
        return .Err(.BelowAbsoluteZero)
    }
    .Ok(from_kelvin(kelvin, to))
}

test "a length converts through metres" {
    let miles = convert("length", 5.0, "km", "mi").unwrap()
    testing.assert(miles > 3.106 && miles < 3.107, "five kilometres are not 3.107 miles")?
}

test "a weight converts through grams" {
    let ounces = convert("weight", 1.0, "lb", "oz").unwrap()
    testing.assert(ounces > 15.999 && ounces < 16.001, "a pound is not sixteen ounces")?
}

test "a temperature converts through kelvin" {
    let boiling = convert("temperature", 100.0, "C", "F").unwrap()
    testing.assert(boiling > 211.999 && boiling < 212.001, "water does not boil at 212 F")?
}

test "a conversion refuses what the parse accepted but the units cannot hold" {
    testing.assert_eq(convert("length", -2.0, "m", "ft"), .Err(Mistake.NegativeLength), "a negative length was converted")?
    testing.assert_eq(convert("weight", 3.0, "kg", "ft"), .Err(Mistake.WeightUnit), "a length unit was taken as a weight")?
    testing.assert_eq(convert("temperature", -300.0, "C", "K"), .Err(Mistake.BelowAbsoluteZero), "a temperature below absolute zero was converted")?
}

// Declare a conversion command: the value and the two units it converts
// between, all required.
fn conversion(name: Str, about: Str) -> cli.Command where carries(name, about) {
    var command = cli.Command.new(name, about)
    &command.positional("value", "the amount to convert")
    &command.positional("from", "the unit the amount is in")
    &command.positional("to", "the unit to convert to")
    command
}

// Build the command schema. A refused allocation is kept on the command and
// reported when it parses or writes its help.
fn build_cli() -> cli.Command {
    var cmd = cli.Command.new("unit_converter", "Convert a measurement from one unit to another")
    &cmd.subcommand(conversion("length", "convert mm, cm, m, km, in, ft or mi"))
    &cmd.subcommand(conversion("weight", "convert g, kg, oz or lb"))
    &cmd.subcommand(conversion("temperature", "convert C, F or K"))
    &cmd.subcommand(cli.Command.new("units", "list the units of each kind"))
    cmd
}

test "the schema names every command" {
    defer let cmd = build_cli()
    defer let help = cmd.usage().unwrap()
    for name in ["length", "weight", "temperature", "units"] {
        testing.assert(help.view().find(name).is_some(), "the help does not name a command")?
    }
}

fn main() -> UInt8 {
    defer var cmd = build_cli()
    // `cmd.report` writes a refused argument with the help of the command it
    // belongs to, and answers 64, the exit status for a program called
    // wrongly.
    defer let matches = cmd.parse_args(env.args()) else |error| {
        return cmd.report(env.args(), error)
    }
    // `cmd.print_help` answers `--help` with the help the schema declares.
    if matches.is_help() {
        return cmd.print_help(borrow matches)
    }
    // `cmd.usage_error` reports a mistake the parse accepted, here a missing
    // command, the same way as `cmd.report`.
    let sub = matches.subcommand() else {
        return cmd.usage_error(env.args(), "no command given")
    }
    if sub.name == "units" {
        if io.println("length: mm cm m km in ft mi\nweight: g kg oz lb\ntemperature: C F K").is_err() {
            return 1
        }
        return 0
    }
    let value: Float64 = sub.matches.get_positional("value") else |error| {
        return cmd.report(env.args(), error)
    }
    let from = sub.matches.required_positional("from") else |error| {
        return cmd.report(env.args(), error)
    }
    let to = sub.matches.required_positional("to") else |error| {
        return cmd.report(env.args(), error)
    }
    // A negative length parses as a number, and an unknown unit as text, so
    // the program refuses them itself with `cmd.usage_error`.
    let converted = convert(sub.name, value, from, to) else |mistake| {
        return cmd.usage_error(env.args(), mistake.message())
    }
    if io.println("{value} {from} = {converted:.2} {to}").is_err() {
        return 1
    }
    0
}
