// Every handler is already what its factory makes, through the library's
// `http.MadeHandler` for each `Handler`, so a second implementation for one
// is refused.
import std.http

use http.Handler
use http.MadeHandler

@derive(Release)
struct Greeter {}

impl[P: Allocator] Handler[(), P] for Greeter {
    fn serve_http(inout _self: Self, inout _state: (), request: http.Request[P], inout _body: http.RequestBody[P]) -> Result[http.Response[P], http.Error[P]] {
        http.text(request, "hello")
    }
}

impl[P: Allocator] MadeHandler[P] for Greeter {
    type Handler = Greeter
    type Error = Never

    fn made(sink self: Self) -> Result[Greeter, Never] {
        .Ok(self)
    }
}

fn main() -> UInt8 {
    0
}
