trait Tagged {}

template impl Tagged {}

@derive(Tagged)
struct Cell[T] { value: T }

derive[T: Equatable] Equatable for Cell[T]

fn tagged[T: Tagged](_value: T) -> Bool {
    true
}

fn main() -> UInt8 {
    let first = Cell[UInt8] { value = 3 }
    let second = Cell[UInt8] { value = 3 }
    if tagged(first) && first == second {
        0
    } else {
        1
    }
}
