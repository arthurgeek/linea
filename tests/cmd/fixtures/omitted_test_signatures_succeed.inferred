import std.testing
import std.io

fn main() -> UInt8 {
    0
}

test "fallthrough succeeds" {
    testing.assert(true, "fallthrough")?
}

test "bare return succeeds" {
    testing.assert(true, "bare return")?
    return
}

test "deferred cleanup runs before success" {
    defer mark_cleanup()
    return
}

fn mark_cleanup() {
    io.eprintln[Str]("cleanup")
}

test "explicit custom signature is preserved" -> Result[(), Str] {
    return .Ok({})
}

test trap "an explicit trap remains expected" -> Result[(), Str] {
    panic("expected")
}

test "trailing match succeeds" {
    let value: Option[UInt8] = .None
    match value {
        Some(_) => testing.assert(false, "unexpected payload")?,
        None => {},
    }
}

test "trailing integer match succeeds" {
    let value: UInt8 = 3
    match value {
        0 => testing.assert(false, "unexpected zero")?,
        _ => {},
    }
}

test "trailing conditional succeeds" {
    if true {
        testing.assert(true, "taken branch")?
    } else {
        testing.assert(false, "untaken branch")?
    }
}

test "trailing match with returning first arm succeeds" {
    let value: Option[UInt8] = .None
    match value {
        Some(_) => {
            testing.assert(false, "unexpected returning branch")?
            return
        },
        None => {},
    }
}
