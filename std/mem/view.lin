import std.mem

// A View observes a mutable contiguous extent of elements without owning its storage.
// It is neither Copyable nor Owned, so it cannot be sent across tasks or escaped.
@(opaque)
struct View[T] {
    at: UInt64,
    len: UInt64,
    carried: mem.Carried[T],
}

impl[T] View[T] {
    pub fn length(self: Self) -> UInt64 {
        self.len
    }

    pub fn is_empty(self: Self) -> Bool {
        self.len == 0
    }
}
