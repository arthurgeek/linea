// This module is the only one the manifest trusts to call C. Its `extern`
// declarations are private, so the rest of the program calls the ordinary
// function `size_of` instead, and C's conventions end here.
import std.ffi
import std.io

use io.IoCategory

// An open file descriptor. `@opaque` means only this module can make one from
// the integer `open` answers, and `@linear` means every path that opens one
// must close it: forgetting to is a compile error.
@(opaque, linear)
type Descriptor = Int32

// Each of these answers -1 and sets `errno` when it fails. Declaring the result
// as `ffi.Errno[...]` keeps the `errno` of that call beside the value C
// returned, read before any other code can change it.
//
// C declares `open` variadic, `int open(const char *, int, ...)`, taking a
// mode only when it creates a file. Calling it with the two fixed arguments
// alone is what C does too, so this declaration names only those.
extern fn open(path: ffi.CText, flags: Int32) -> ffi.Errno[Int32]

// `lseek` moves the descriptor's position, so it takes the descriptor without
// `read`, and the descriptor is passed from a place that may change: a field
// of `inout self`.
extern fn lseek(descriptor: Descriptor, offset: Int64, whence: Int32) -> ffi.Errno[Int64]

// `sink` hands the descriptor to C, which closes it whatever it answers.
extern fn close(sink descriptor: Descriptor) -> ffi.Errno[Int32]

// `strerror` answers C's own sentence for an `errno` code, in storage the C
// library owns rather than any value here, which `carries()` states. The next
// call to `strerror` may overwrite that storage, so the sentence is copied
// into a `String` straight away.
extern fn strerror(code: Int32) -> ffi.CText where carries()

// Why a file could not be measured.
@derive(Debug, Release)
pub enum Failure {
    // The path holds a NUL byte at this offset, which would end it early in C.
    InteriorNul(UInt64),
    // There was no memory to copy the path for C.
    OutOfMemory,
    // C refused: a category that is the same on every platform, and the C
    // library's sentence for the failure.
    System(IoCategory, String),
}

// The `Failure` for an `errno` code. `io.IoError.from_os` sorts the code
// into a portable category, and `to_owned` copies the sentence `strerror`
// lends into a `String` this program owns.
fn system_failure(code: Int32) -> Failure {
    let category = io.IoError.from_os(.Metadata, code).category
    // `strerror` never answers a null pointer; a sentence that is not UTF-8 is
    // left empty.
    let message = match strerror(code).to_owned() {
        Ok(text) => text,
        Err(reason) => {
            reason.release()
            String.new()
        },
    }
    .System(category, message)
}

// `O_RDONLY` opens for reading, and is 0 on Linux and macOS.
fn read_only() -> Int32 {
    0
}

// `SEEK_END` measures an offset from the end of the file, and is 2 on Linux
// and macOS.
fn from_end() -> Int32 {
    2
}

impl Descriptor {
    // Open the file at `path` for reading.
    fn open(path: Str) -> Result[Descriptor, Failure] {
        let named = ffi.CString.open(path) else |failure| {
            return .Err(match failure {
                InteriorNul(offset) => .InteriorNul(offset),
                Allocation(_) => .OutOfMemory,
            })
        }
        let opened = open(named.text(), read_only())
        // Releasing the copy frees memory, which may change `errno`; `opened`
        // already holds the `errno` that `open` left.
        named.release()
        match opened.failed_at(-1) {
            Ok(descriptor) => .Ok(Descriptor(descriptor)),
            Err(code) => .Err(system_failure(code)),
        }
    }

    // How many bytes the file holds: the offset of its end.
    fn size(inout self: Self) -> Result[Int64, Failure] {
        match lseek(self, 0, from_end()).failed_at(-1) {
            Ok(offset) => .Ok(offset),
            Err(code) => .Err(system_failure(code)),
        }
    }

    // Close the descriptor.
    fn close(sink self: Self) -> Result[Int32, Failure] {
        match close(self).failed_at(-1) {
            Ok(answer) => .Ok(answer),
            Err(code) => .Err(system_failure(code)),
        }
    }
}

// How many bytes the file at `path` holds. The descriptor is closed on every
// path out: after a size, and after a failure to find one.
pub fn size_of(path: Str) -> Result[Int64, Failure] {
    var descriptor = Descriptor.open(path)?
    let measured = &descriptor.size() else |failure| {
        // The size's failure is the one reported, so closing's own answer is
        // released unread.
        descriptor.close().release()
        return .Err(failure)
    }
    let _closed = descriptor.close()?
    .Ok(measured)
}
