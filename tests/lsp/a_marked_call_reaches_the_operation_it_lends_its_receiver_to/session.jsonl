{"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"main.lin","languageId":"linea","version":1,"text":"// `&counter.bump()` reaches the operation `bump` and lends it `counter`.\nstruct Counter {\n    count: UInt8,\n}\n\nimpl Counter {\n    fn bump(inout self: Self) {\n        self.count += 1\n    }\n}\n\nfn main() -> UInt8 {\n    var counter = Counter { count = 0 }\n    &counter.bump()\n    counter.count\n}\n"}}}
