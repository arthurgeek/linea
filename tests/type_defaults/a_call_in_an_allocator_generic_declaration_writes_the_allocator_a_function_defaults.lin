import std.mem

use mem.Allocator

fn with[A: Allocator = mem.SystemAllocator](size: UInt64, allocator: A = .System) -> UInt64 where carries(allocator) {
    let items: Vec[UInt8, A] = Vec.new_in(allocator)
    let held = items.length() + size
    items.release()
    held
}

fn _inside[B: Allocator](_allocator: B) -> UInt64 {
    with(8)
}

fn main() -> UInt8 {
    UInt8(with(4))
}
