// `zip` is left-biased: only the first sequence's items must be Discardable.
// Putting the linear `Jobs` second is accepted, because `zip` never drops one of
// the second sequence's items; each pair is taken apart and the job is released.
@linear
struct Job {
    id: UInt8,
}

impl Release for Job {
    fn release(sink self: Job) {
        let Job { id: _ } = self
    }
}

struct Jobs {
    next_id: UInt8,
}

impl Iterator for Jobs {
    type Item = Job

    fn next(inout self: Jobs) -> Option[Job] {
        if self.next_id == 3 {
            return .None
        }
        self.next_id += 1
        .Some(.{ id = self.next_id })
    }
}

fn main() -> UInt8 {
    let jobs = Jobs { next_id = 0 }
    var total: UInt8 = 0
    for (n, job) in (UInt8(1)..3).zip(jobs) {
        total += n + job.id
        job.release()
    }
    total - 6
}
