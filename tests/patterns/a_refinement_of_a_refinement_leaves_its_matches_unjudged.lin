// Only an integer type may be refined, so a refinement of a refinement is
// refused. Which arms a match on it needs is not judged, at the top or inside
// a variant.
type Digit = UInt8 where it in 0..=9

type Small = Digit where it in 1..=3

fn small_score(sink small: Small) -> UInt8 {
    match small {
        Small(Digit(1..=3)) => 1,
    }
}

fn maybe_score(sink maybe: Option[Small]) -> UInt8 {
    match maybe {
        Some(Small(Digit(1..=3))) => 1,
        None => 0,
    }
}

fn main() -> UInt8 {
    small_score(Small(Digit(2))) + maybe_score(.None) - 1
}
