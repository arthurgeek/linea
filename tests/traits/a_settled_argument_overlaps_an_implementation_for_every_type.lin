// [T-Impl]. `Probe.Reading` is `UInt8`, so the implementation for `Scale` is
// `Weighs[UInt8]`, which the implementation for every type already answers.
trait Sensor {
    type Reading
}

struct Probe {}

impl Sensor for Probe {
    type Reading = UInt8
}

trait Weighs[U] {
    fn weigh(self: Self, value: U) -> UInt8
}

struct Scale {}

impl[T] Weighs[UInt8] for T {
    fn weigh(_self: Self, _value: UInt8) -> UInt8 {
        1
    }
}

impl Weighs[Probe.Reading] for Scale {
    fn weigh(_self: Self, _value: UInt8) -> UInt8 {
        2
    }
}

fn main() -> UInt8 {
    let scale = Scale {}
    scale.weigh(4)
}
