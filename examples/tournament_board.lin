// Update tournament scores and print the standings after the final round.
import std.testing
import std.io
import std.mem

use io.IoError
use io.println

// Each team keeps its registration index into `scores`; `standings` sorts
// those indexes and never reorders the scores themselves.
struct Board {
    scores: [UInt8; 4],
}

// `via scores` forwards indexing to the stored array, including updates.
// FromEnd is enabled separately so board[^1] reaches its last score.
impl Index[UInt64] for Board via scores

impl Index[FromEnd] for Board via scores

// List the team indexes from the highest score down. A fixed array has no
// `sort`, so `Vec.from_fn` builds a vector of the indexes to sort, and the
// vector's allocation can fail. `sort_by` reorders the vector in place with a
// comparison that says whether `left` belongs before `right`, and `[board]`
// lets that comparison read the scores. The sort is stable, so tied teams keep
// their registration order.
fn standings(board: Board) -> Result[Vec[UInt64], mem.Oom] {
    var order = Vec.from_fn(count: board.scores.length(), initializer: |team| team)?
    &order.sort_by([board] |left, right| board[left] > board[right])
    .Ok(order)
}

test fn final_round_points_change_the_standings() {
    var board = Board { scores = [3, 5, 8, 13] }
    board[0] += 1
    board[1] += 10
    board[^1] += 3

    let scores: [UInt8; _] = [4, 15, 8, 16]
    let ranked: [UInt64; _] = [3, 1, 2, 0]
    testing.assert_eq(board.scores, scores, "final-round points were not added to the scores")?
    defer let order = standings(board).unwrap()
    testing.assert_eq(order.as_slice(), ranked.as_slice(), "the highest score should lead the standings")?
}

test fn tied_teams_keep_registration_order() {
    let board = Board { scores = [8, 12, 8, 12] }
    let ranked: [UInt64; _] = [1, 3, 0, 2]
    defer let order = standings(board).unwrap()
    testing.assert_eq(order.as_slice(), ranked.as_slice(), "tied teams changed registration order")?
}

fn main() -> Result[UInt8, IoError] {
    let teams = ["Comets", "Falcons", "Otters", "Ravens"]
    var board = Board { scores = [3, 5, 8, 13] }
    board[0] += 1
    board[1] += 10
    // ^1 selects the last registered team's score.
    board[^1] += 3

    defer let order = standings(board) else |reason| {
        io.eprintln("could not rank the teams: {reason:?}")
        return .Ok(1)
    }
    println("Final standings")?
    // `enumerate` pairs each team index with its position, counting from
    // zero. The pattern `(rank, team)` takes the pair apart, and `*team`
    // reads the borrowed index.
    for (rank, team) in order.as_slice().enumerate() {
        println("{rank + 1}. {teams[*team]}: {board[*team]} points")?
    }
    .Ok(0)
}
