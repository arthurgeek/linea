import std.testing
import std.io

fn main() -> UInt8 {
    0
}

fn mark_cleanup() {
    io.eprintln[Str]("cleanup")
}

test "assertion failure propagates" {
    defer mark_cleanup()
    testing.assert(false, "assertion failure")?
}

test "explicit failure is returned" {
    defer mark_cleanup()
    let failure: Failure = match testing.assert(false, "explicit failure") {
        Err(error) => error,
        Ok(_) => panic("an assertion returned success"),
    }
    return .Err(failure)
}

test "trailing match propagates failure" {
    let value: Option[UInt8] = .Some(1)
    match value {
        Some(_) => testing.assert(false, "match failure")?,
        None => {},
    }
}

test "trailing match returns explicit failure" {
    let failure: Failure = match testing.assert(false, "returned match failure") {
        Err(error) => error,
        Ok(_) => panic("an assertion returned success"),
    }
    let value: Option[UInt8] = .Some(1)
    match value {
        Some(_) => return .Err(failure),
        None => {},
    }
}
