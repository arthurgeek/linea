// An implementation covers what its trait declares, and a declared type named
// bare by a signature is no exception: `-> Item` is a signature reaching a
// binding, so an implementation supplying none leaves the hole a missing
// member leaves. What is reported is that hole and not the reading of the
// name, because the name is declared and it is the answer that is absent.
trait Holder {
    type Item

    fn get(self: Self) -> Item
}

struct Box {
    n: UInt8,
}

impl Holder for Box {
    fn get(self: Box) -> UInt8 {
        self.n
    }
}

fn main() -> UInt8 {
    0
}
