// `peek` lends the ticket the peekable holds. Taking the ticket apart through
// that view would settle it while the peekable still owns it.
@linear
struct Ticket { seat: UInt8 }

struct Tickets { next_seat: UInt8 }

impl Iterator for Tickets {
    type Item = Ticket

    fn next(inout self: Self) -> Option[Ticket] {
        if self.next_seat == 3 {
            return .None
        }
        self.next_seat += 1
        .Some(Ticket { seat = self.next_seat })
    }
}

fn main() -> UInt8 {
    var line = (Tickets { next_seat = 0 }).peekable()
    let seat = match &line.peek() {
        Some(ticket) => {
            let Ticket { seat } = *ticket
            seat
        },
        None => 0,
    }
    let (rest, held) = line.into_parts()
    match held {
        Some(ticket) => {
            let Ticket { seat: _ } = ticket
        },
        None => {},
    }
    for ticket in rest {
        let Ticket { seat: _ } = ticket
    }
    seat
}
