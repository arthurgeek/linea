// Generic structures may hold one another in their fields, in a ring as long
// as a program writes. Each structure here holds the next two through a
// container that stores none of them, so a `Ring0[UInt8]` is one byte wide,
// and a generic function reads a field of one at its own parameter.
struct Many[phantom T] {}

struct Ring0[X] { x: X, next: Many[Ring1[X]], skip: Many[Ring2[X]] }

