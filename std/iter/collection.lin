import std.mem
import std.release
import std.testing

use mem.Owner
use release.Settle

// Append every item of `iterator` to `values`, in source order. On refusal, the
// vector keeps its accepted prefix and the error owns the next item; the
// iterator has advanced past that item.
pub fn extend[I: Iterator, A: Allocator](
    inout values: Vec[I.Item, A],
    inout iterator: I,
) -> Result[(), mem.PushFailure[I.Item]] where retains(values: iterator), carries(.Err.value: iterator) {
    while true {
        match &iterator.next() {
            None => break,
            Some(value) => &values.push(value)?,
        }
    }
    .Ok(())
}

test fn extend_appends_items_in_source_order() {
    defer var values = Vec.filled(count: 1, value: UInt64(9)).unwrap()
    var source = UInt64(1)..4
    match extend(&values, &source) {
        Ok(_) => {},
        Err(_) => return testing.assert(false, "extending the vector failed"),
    }
    testing.assert_eq(values.length(), UInt64(4), "extension lost the existing prefix")?
    testing.assert_eq(values[0], UInt64(9), "extension replaced the existing item")?
    for index in UInt64(1)..4 {
        testing.assert_eq(values[index], index, "extension changed source order")?
    }
    testing.assert(&source.next().is_none(), "extension left an item unread")?
}

test fn extend_at_exact_capacity_does_not_allocate_after_exhaustion() {
    // Eight cursor bytes and four UInt64 slots leave no room for another allocation.
    defer let arena = mem.Arena.open(mem.system(), size: 40)
    var values = Vec.filled_in(arena.handle(), count: 4, value: UInt64(7)).unwrap()
    var source = UInt64(0)..0
    testing.assert(extend(&values, &source).is_ok(), "empty extension attempted growth")?
    testing.assert_eq(values.length(), UInt64(4), "empty extension changed the prefix")?
}

test fn extend_fills_exact_remaining_capacity_before_exhaustion() {
    defer let arena = mem.Arena.open(mem.system(), size: 40)
    var values: Vec[UInt64, mem.Handle] = Vec.new_in(arena.handle())
    &values.reserve(4).unwrap()
    &values.push(UInt64(0)).unwrap()
    &values.push(UInt64(1)).unwrap()
    var source = UInt64(2)..4
    testing.assert(extend(&values, &source).is_ok(), "exact-capacity extension attempted growth")?
    testing.assert_eq(values.length(), UInt64(4), "extension did not fill remaining capacity")?
    for index in UInt64(0)..4 {
        testing.assert_eq(values[index], index, "extension changed the prefix or appended order")?
    }
    testing.assert(&source.next().is_none(), "extension left its final item unread")?
}

test fn extend_returns_the_rejected_item_and_resumes_without_recomputing() {
    // The cursor and four UInt64 slots consume all 40 bytes.
    defer let arena = mem.Arena.open(mem.system(), size: 40)
    var values: Vec[UInt64, mem.Handle] = Vec.new_in(arena.handle())
    var source = (UInt64(0)..7).map(
        inout [sink produced = UInt64(0)] |sink item| {
            produced += 1
            item
        },
    )
    let rejected = match extend(&values, &source) {
        Ok(_) => return testing.assert(false, "bounded vector unexpectedly grew"),
        Err(failure) => failure.value,
    }
    testing.assert_eq(rejected, UInt64(4), "extension returned the wrong rejected item")?
    testing.assert_eq(values.length(), UInt64(4), "refused insertion changed the prefix")?
    for index in UInt64(0)..4 {
        testing.assert_eq(values[index], index, "refused insertion changed a stored item")?
    }
    // Process the oldest item, then retry the already-produced value in its freed slot.
    testing.assert_eq(&values.remove(0).unwrap(), UInt64(0), "removal changed source order")?
    &values.push(rejected).unwrap()
    testing.assert_eq(&values.remove(0).unwrap(), UInt64(1), "removal changed the second item")?
    testing.assert_eq(&values.remove(0).unwrap(), UInt64(2), "removal changed the third item")?
    testing.assert(extend(&values, &source).is_ok(), "resuming the unread suffix attempted growth")?
    let (_remaining, callback) = source.into_parts()
    let { produced } = callback.into_captures()
    testing.assert_eq(produced, UInt64(7), "retry recomputed or skipped an item")?
    for index in UInt64(0)..4 {
        testing.assert_eq(values[index], index + 3, "retry lost or duplicated an item")?
    }
}

test fn each_allocation_failure_covers_every_growth_step_of_an_extension() -> Result[(), testing.Failure] {
    let checked = testing.each_allocation_failure(
        mem.system(),
        |allocator| -> Result[(), mem.PushFailure[UInt64]] {
            defer var values: Vec[UInt64, mem.RefusingAllocator[mem.SystemAllocator]] = Vec.new_in(allocator)
            var source = UInt64(0)..40
            extend(&values, &source)?
            return .Ok(())
        },
        mem.PushFailure.is_refusal,
    )
    testing.assert(checked.is_ok(), "a growing extension was reported as failing")?
    .Ok(())
}

// A Collected holds the collected values and the iterator they came from,
// which may still hold state the caller must settle. `T` is the iterator's
// item type: `collect` always builds a
// `Collected[I, A, I.Item]`, and no other instantiation is produced. Naming
// it as its own parameter, rather than as `I.Item`, lets a release of the
// collected values stay within the finite instantiations [T-PolyRec] admits.
pub struct Collected[I: Iterator, A: Allocator, T] {
    values: Vec[T, A],
    iterator: I,
}

// CollectionTicket is a linear item with no Release implementation.
@linear
struct CollectionTicket { number: UInt64 }

// A CollectFailure holds what was collected before an item was refused, and
// the refusal, which owns that item.
pub struct CollectFailure[I: Iterator, A: Allocator, T] {
    collected: Collected[I, A, T],
    failure: mem.PushFailure[T],
}

// Display renders the refused insertion and borrows the collected prefix.
impl[I: Iterator, A: Allocator, T: Display] Display for CollectFailure[I, A, T] {
    fn fmt[W: Writer](self: Self, inout w: W) -> Result[(), W.Error] {
        self.failure.fmt(&w)
    }
}

// Releasing a failed collection settles it, then releases the allocation
// reason.
impl[I: Iterator + Release, A: Allocator, T: Release] Release for CollectFailure[I, A, T] {
    fn release(sink self: Self) -> () {
        self.settle().release()
    }
}

test fn a_failed_collection_can_be_released_whole() {
    // The arena's cursor fills all eight bytes, so the first item is refused.
    defer let arena = mem.Arena.open(mem.system(), size: 8)
    let released = match (UInt64(0)..3).collect(arena.handle()) {
        Ok(collected) => {
            let Collected { values, iterator: _ } = collected
            values.release()
            false
        },
        Err(failure) => {
            failure.release()
            true
        },
    }
    testing.assert(released, "an exhausted arena accepted an item")?
}

// Settling a failed collection releases the collected prefix, the iterator
// and the refused item, and keeps the allocation reason.
impl[I: Iterator + Release, A: Allocator, T: Release] release.Settle for CollectFailure[I, A, T] {
    type Reason = mem.Oom

    fn settle(sink self: Self) -> mem.Oom where carries(self) {
        let CollectFailure { collected, failure } = self
        let Collected { values, iterator } = collected
        let reason = failure.settle()
        iterator.release()
        values.release()
        reason
    }
}

test fn settling_a_failed_collection_keeps_the_allocation_reason() {
    // The arena's cursor fills all eight bytes, so the first item is refused.
    defer let arena = mem.Arena.open(mem.system(), size: 8)
    let settled = (UInt64(0)..3).collect(arena.handle()).settled()
    let refused = match settled {
        Ok(collected) => {
            let Collected { values, iterator: _ } = collected
            values.release()
            false
        },
        Err(reason) => reason == mem.Oom.Exhausted,
    }
    testing.assert(refused, "settling a failed collection lost its reason")?
}

test fn collect_preserves_result_items_and_returns_exhausted_state() {
    let source = (UInt8(0)..3).map(
        inout [sink calls = UInt64(0)] |sink item| -> Result[UInt64, UInt8] {
            calls += 1
            if item == 1 {
                Result.Err(item)
            } else {
                Result.Ok(UInt64(item))
            }
        },
    )
    let { values, iterator } = source.collect(mem.system()).unwrap()
    defer values.release()
    let (_remaining, callback) = iterator.into_parts()
    let { calls } = callback.into_captures()
    testing.assert_eq(calls, UInt64(3), "collection stopped on an Err element")?
    let expected: [Result[UInt64, UInt8]; 3] = [.Ok(0), .Err(1), .Ok(2)]
    testing.assert_eq(values.as_slice(), expected.as_slice(), "collection lost or changed a Result element")?
}

test fn collect_empty_input_succeeds_with_an_exhausted_allocator() {
    defer let arena = mem.Arena.open(mem.system(), size: 8)
    let { values, iterator } = (UInt64(0)..0).collect(arena.handle()).unwrap()
    var iterator = iterator
    testing.assert_eq(values.length(), UInt64(0), "empty collection produced an item")?
    testing.assert(&iterator.next().is_none(), "empty source gained an item")?
    testing.assert(arena.handle().acquire(1).is_err(), "the allocator had room for an item")?
}

test fn collect_first_push_refusal_returns_the_item_and_advanced_linear_captures() {
    // The cursor occupies the entire arena, leaving no room for the first item.
    defer let arena = mem.Arena.open(mem.system(), size: 8)
    let ledger = CollectionTicket { number = 0 }
    let source = (UInt64(0)..3).map(
        inout [sink ledger] |sink item| {
            ledger.number += 1
            item
        },
    )
    let refused = match source.collect(arena.handle()) {
        Err(refused) => refused,
        Ok(_) => panic("an exhausted arena accepted an item"),
    }
    // Display borrows the failure before its parts are recovered below.
    // The 64-byte recorder holds the growth refusal.
    var writer = testing.Recorder.of(64).unwrap()
    let explained = refused.fmt(&writer).is_ok() && writer.holds("could not grow the vector: Exhausted")
    writer.release()
    let { collected, failure } = refused
    let { values, iterator } = collected
    let { reason, value } = failure
    let (remaining, callback) = iterator.into_parts()
    let { ledger } = callback.into_captures()
    let { number: calls } = ledger
    var remaining = remaining
    testing.assert(explained, "a collection failure lost its reason")?
    testing.assert_eq(reason, mem.Oom.Exhausted, "first insertion returned another allocation error")?
    testing.assert_eq(values.length(), UInt64(0), "first insertion refusal changed the empty prefix")?
    testing.assert_eq(value, UInt64(0), "first insertion lost its rejected item")?
    testing.assert_eq(calls, UInt64(1), "first insertion did not invoke the callback exactly once")?
    testing.assert_eq(&remaining.next(), Option.Some(UInt64(1)), "first insertion consumed the unread suffix")?
}

test fn collect_returns_linear_elements_and_captures_after_success_or_refusal() {
    // These runs cover empty success, nonempty success, and refusal at item five.
    for count in [UInt64(0), 3, 7] {
        // The cursor and four eight-byte tickets fit exactly.
        defer let arena = mem.Arena.open(mem.system(), size: 40)
        let ledger = CollectionTicket { number = 0 }
        let source = (0..count).map(
            inout [sink ledger] |sink item| {
                ledger.number += 1
                let ticket = CollectionTicket { number = item }
                ticket
            },
        )
        var total: UInt64 = 0
        var refused = false
        let completed = match source.collect(arena.handle()) {
            Ok(completed) => completed,
            Err(failed) => {
                refused = true
                let { collected, failure } = failed
                let { reason: _reason, value } = failure
                let { number } = value
                total += number
                collected
            },
        }
        let { values, iterator } = completed
        var pending = values.drain()
        for value in &pending {
            let { number } = value
            total += number
        }
        pending.finish().unwrap()
        let (remaining, callback) = iterator.into_parts()
        let { ledger } = callback.into_captures()
        let { number: calls } = ledger
        let completed_count = if refused {
            UInt64(5)
        } else {
            count
        }
        var remaining = remaining
        let expected_next: Option[UInt64] = if refused {
            .Some(5)
        } else {
            .None
        }
        testing.assert_eq(&remaining.next(), expected_next, "collection consumed the remaining suffix")?
        testing.assert_eq(calls, completed_count, "collection lost captured state")?
        testing.assert_eq(refused, count == 7, "collection refused at the wrong capacity")?
        let expected = if completed_count == 0 {
            0
        } else {
            completed_count * (completed_count - 1) / 2
        }
        testing.assert_eq(total, expected, "collection lost or duplicated a linear ticket")?
    }
}

test fn each_allocation_failure_covers_every_growth_step_of_a_collection() -> Result[(), testing.Failure] {
    let checked = testing.each_allocation_failure(
        mem.system(),
        |allocator| -> Result[(), mem.Oom] {
            let collected = (UInt64(0)..40).collect(allocator).settled()?
            let Collected { values, iterator: _ } = collected
            values.release()
            return .Ok(())
        },
        mem.Oom.is_refusal,
    )
    testing.assert(checked.is_ok(), "a growing collection was reported as failing")?
    .Ok(())
}
