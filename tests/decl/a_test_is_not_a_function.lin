// A test is named by a string after `test`, not declared as a function.
import std.testing

fn double(n: UInt32) -> UInt32 {
    n * 2
}

test fn doubling_two_gives_four() {
    testing.assert_eq(double(2), 4, "two doubled is four")?
}

fn main() -> UInt8 {
    if double(1) == 2 { 0 } else { 1 }
}
