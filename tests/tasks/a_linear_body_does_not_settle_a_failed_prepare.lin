import std.session
import std.task

use session.Chan
use session.End

@linear
struct Token {
    number: UInt64,
}

// Settling would drop the token the body owns, so a failure holding it does
// not settle.
fn start_with(sink token: Token) -> Result[UInt64, task.PrepareError] {
    let body = sink [sink token] |sink me: Chan[End]| {
        let Token { number: _ } = token
        me.close()
    }
    let slot = task.prepare(body).settled()?
    slot.start().close()
    .Ok(1)
}

fn main() -> UInt8 {
    match start_with(.{ number = 1 }) {
        Ok(_) => 0,
        Err(_) => 1,
    }
}
