// A desk holds a drawer holding a claim on its ledger and on one of its
// entries, so it is dropped only where both can be discarded. `tally` and
// `count` say the entries can be, and bound their ledgers `Discardable`, so
// each may drop its desk. `close` says the same of the entries alone, so
// the desk `close` is given must still be handed on.
trait Ledger {
    type Entry
}

struct Claim[L: Ledger] {
    ledger: L,
    entry: L.Entry,
}

struct Drawer[L: Ledger] {
    claim: Claim[L],
}

struct Desk[L: Ledger] {
    drawer: Drawer[L],
}

fn _tally[L: Ledger + Discardable](sink _desk: Desk[L]) -> UInt8
where L.Entry: Discardable {
    1
}

fn _close[K: Ledger](sink _desk: Desk[K]) -> UInt8
where K.Entry: Discardable {
    2
}

fn _count[J: Ledger + Discardable](sink _desk: Desk[J]) -> UInt8
where J.Entry: Discardable {
    3
}

fn main() -> UInt8 {
    0
}
