// An arm's binder owns what it was handed, so discharging it is the arm's own
// business and every arm answers for itself. Here one arm binds a key and
// burns it while the other binds nothing, which is the pair that makes the
// obligation per path rather than per program.
//
// The direction a case cannot show is the one where the disposal is gone: this
// program compiles, and only a program that stops burning the key can say
// whether the compiler noticed.
@linear
enum Key {
    Forged(UInt8),
}

@linear
enum Holder {
    Empty,
    Full(Key),
}

fn burn(sink k: Key) -> UInt8 {
    match k {
        Forged(n) => n,
    }
}

fn main() -> UInt8 {
    let held: Holder = .Full(Key.Forged(5))
    match held {
        Empty => 0,
        Full(k) => {
            let _spent = burn(k)
            1
        },
    }
}
