// Serve a guest book stored in SQLite on a TCP port.
//
// `guest-book PORT` serves the guest book on loopback.
//
// `GET /` renders the page and the 50 newest signatures. `POST /sign` checks
// that the form came from the same origin and fits the length limits, stores
// the signature, remembers the visitor's name in a cookie, and redirects back
// to the page with `303 See Other`.
import book
import page
import std.env
import std.http
import std.io
import std.iter
import std.log
import std.mem
import std.net
import std.testing

use book.Book
use book.BookError
use http.Handler
use iter.Iterator
use mem.Lender
use page.Page

let longest_name: UInt64 = 60

let longest_message: UInt64 = 500

// A form writes each byte of a non-ASCII scalar as `%XX`, and a scalar is at
// most four bytes of UTF-8, so one scalar takes at most 12 bytes of a body.
let encoded_scalar_bytes: UInt64 = 12

let newest_shown: Int64 = 50

// The server refuses a body longer than the largest form `sign` accepts, a
// name and a message at their longest with every scalar four bytes long. A
// form the page's `maxlength` attributes admit always fits.
fn limits() -> http.Limits {
    let longest_form = "name=&message=".length() + (longest_name + longest_message) * encoded_scalar_bytes
    http.Limits { max_body_bytes = longest_form, ..http.Limits.default() }
}

// Whether `text` holds a character that does not belong in a signature. A
// name is one line, so it holds no control character. A message comes from a
// `<textarea>`, whose tabs and line breaks are kept: `\t` and `\n` are allowed
// there, after `with_lf_line_breaks` has turned every CR into LF. Refused in
// both are the C0 controls below U+0020, DEL (U+007F), the C1 controls U+0080
// to U+009F, the line and paragraph separators U+2028 and U+2029, the
// bidirectional controls U+200E, U+200F, U+202A to U+202E and U+2066 to U+2069,
// which can make a name display reversed, and the byte order mark U+FEFF.
fn holds_disallowed_character(text: Str, keeps_line_breaks: Bool) -> Bool {
    for scalar in text.scalars() {
        let value = scalar.value
        if value < 32 {
            if !(keeps_line_breaks && (value == 9 || value == 10)) {
                return true
            }
        } else if value >= 127 && value <= 159 {
            return true
        } else if value == 8206 || value == 8207 || (value >= 8232 && value <= 8238) || (value >= 8294 && value <= 8297) || value == 65279 {
            return true
        }
    }
    false
}

// A browser sends each line break in a `<textarea>` as CRLF, and the form's
// `maxlength` counts it as one character. `with_lf_line_breaks` writes every
// CRLF, and every lone CR, as LF, so a message is counted and stored with one
// character per line break.
fn with_lf_line_breaks[A: Allocator](allocator: A, text: Str) -> Result[String[A], mem.Oom] where carries(.Ok: allocator) {
    defer var written = String.new_in(allocator)
    var start: UInt64 = 0
    var at: UInt64 = 0
    while at < text.length() {
        if text.byte(at).unwrap() == 13 {
            &written.append(text.slice(start, at).unwrap())?
            &written.append("\n")?
            at += 1
            if at < text.length() && text.byte(at).unwrap() == 10 {
                at += 1
            }
            start = at
        } else {
            at += 1
        }
    }
    &written.append(text.slice(start, text.length()).unwrap())?
    .Ok(written)
}

// Read the database file's path from `GUEST_BOOK_DATABASE`, without the spaces
// around it, or use `guest-book.db` when the variable is unset or blank.
fn database_path() -> Str {
    database_path_from(env.variable("GUEST_BOOK_DATABASE"))
}

fn database_path_from(variable: Option[Str]) -> Str {
    match read variable {
        Some(path) => {
            let trimmed = path.trim_ascii()
            if trimmed.length() == 0 {
                "guest-book.db"
            } else {
                trimmed
            }
        },
        None => "guest-book.db",
    }
}

test fn the_database_path_drops_surrounding_spaces() {
    testing.assert_eq(database_path_from(.Some("  guests.db\n")), "guests.db", "the spaces around the path were kept")?
    testing.assert_eq(database_path_from(.Some(" \t ")), "guest-book.db", "a blank path was used")?
    testing.assert_eq(database_path_from(.None), "guest-book.db", "the default path changed")?
    .Ok(())
}

fn proxy_trust() -> http.ProxyTrust {
    match env.variable("TRUST_PROXY") {
        Some(val) => {
            if val == "1" || val.equals_ascii_folded("true") || val.equals_ascii_folded("all") {
                .All
            } else if val.equals_ascii_folded("forwarded") {
                .Forwarded
            } else if val.equals_ascii_folded("x-forwarded-proto") {
                .XForwardedProto
            } else {
                .None
            }
        },
        None => .None,
    }
}

// Log the storage error to standard error, which the terminal running the
// server shows, and answer the visitor with a generic 500 message.
fn unavailable(request: http.Request, sink error: BookError) -> http.Error {
    io.eprintln("guest-book: {error}")
    error.release()
    http.error(request, .InternalServerError, "the guest book is unavailable")
}

// The application state `http.Router[App]` lends to `home` and `sign`:
// `App.open` opens `Book` once before accepting connections; because
// `http.listen_and_serve` answers one connection at a time, every request shares
// that single connection and `app.close()` closes it on shutdown.
@(linear, derive(Release))
struct App {
    book: Book,
    proxy_trust: http.ProxyTrust,
}

impl App {
    fn open(path: Str) -> Result[App, BookError] where carries(path) {
        .Ok(App { book = Book.open(path)?, proxy_trust = proxy_trust() })
    }

    fn in_memory() -> Result[App, BookError] {
        .Ok(App { book = Book.open_in_memory()?, proxy_trust = .None })
    }

    fn in_memory_with_trust(trust: http.ProxyTrust) -> Result[App, BookError] {
        .Ok(App { book = Book.open_in_memory()?, proxy_trust = trust })
    }

    fn close(sink self: Self) {
        let App { book, proxy_trust: _ } = self
        book.close()
    }

    test fn app_close_settles_database() {
        let app = App.in_memory().unwrap()
        app.close()
        .Ok(())
    }
}

fn home(inout app: App, request: http.Request) -> Result[http.Response, http.Error] {
    defer let entries = match &app.book.newest(newest_shown) {
        Ok(entries) => entries,
        Err(error) => return .Err(unavailable(request, error)),
    }
    defer let remembered = request.cookie("name")?
    let name = match read remembered {
        Some(text) => text.view(),
        None => "",
    }
    http.html(request, Page { action = "/sign", name, entries = entries.as_slice() })
}

fn favicon(inout _app: App, request: http.Request) -> Result[http.Response, http.Error] {
    .Ok(http.no_content(request))
}

@derive(http.Params, Release)
struct Signature {
    name: Str,
    message: Str,
}

fn sign(inout app: App, form: http.Form[Signature], request: http.Request) -> Result[http.Response, http.Error] {
    if !http.same_origin(request, trust: app.proxy_trust) {
        return .Err(http.error(request, .Forbidden, "a signature is accepted only from this guest book's own page"))
    }
    let name = form.value.name.trim_ascii()
    let message_text = with_lf_line_breaks(request.allocator(), form.value.message.trim_ascii())?
    let message = message_text.view()
    if name.length() == 0 || message.length() == 0 {
        return .Err(http.error(request, .UnprocessableContent, "a signature needs a name and a message"))
    }
    if name.scalars().count() > longest_name || message.scalars().count() > longest_message {
        return .Err(http.error(request, .UnprocessableContent, "a name holds at most {longest_name} characters and a message {longest_message}"))
    }
    if holds_disallowed_character(name, keeps_line_breaks: false) || holds_disallowed_character(message, keeps_line_breaks: true) {
        return .Err(http.error(request, .UnprocessableContent, "a name holds no control characters, and a message only line breaks and tabs"))
    }
    let _ = &app.book.sign(name, message) else |error| {
        return .Err(unavailable(request, error))
    }
    // `303 See Other` tells the browser to load the page with `GET /`, so
    // refreshing the page afterwards does not post the signature a second time.
    var answer = http.redirect(request, .SeeOther, "/")?
    &answer.set_cookie("name", name, path: "/", max_age: .Some(31536000), http_only: true, same_site: .Some(.Lax))?
    .Ok(answer)
}

fn routes(inout router: http.Router[App]) -> Result[(), http.RouteError] {
    &router.route("GET /", home)?
    &router.route("GET /favicon.ico", favicon)?
    &router.route("POST /sign", sign)
}

fn main() -> UInt8 {
    let port_arg = env.args().at(1) else {
        io.eprintln("usage: guest-book PORT")
        return 64
    }
    if env.args().count() > 2 {
        io.eprintln("usage: guest-book PORT")
        return 64
    }
    let port = port_arg.parse[UInt16]() else |_| {
        io.eprintln("usage: guest-book PORT")
        return 64
    }
    let logger = log.to_stderr(minimum: .Info)
    var router: http.Router[App] = http.Router.new()
    let _ = routes(&router) else |error| {
        logger.error("cannot register a route", log.field("error", error))
        router.release()
        return 2
    }
    let app = App.open(database_path()) else |error| {
        router.release()
        io.eprintln("guest-book: {error}")
        error.release()
        return 1
    }
    let app = http.listen_and_serve(net.loopback(port), http.logged(logger, router), state: app, limits: limits()) else |error| {
        io.eprintln("guest-book: {error}")
        return 1
    }
    app.close()
    0
}

test fn signing_redirects_sets_a_cookie_and_renders_on_the_home_page() {
    defer var router: http.Router[App] = http.Router.new()
    routes(&router).unwrap()
    defer var app = App.in_memory().unwrap()
    defer let arena = mem.Arena.open(mem.system(), size: 131072)

    var post = http.new_request(
        arena.handle(),
        "POST",
        "/sign",
        body: "name=Ren%C3%A9+%3Cscript%3E&message=Hello+%26+welcome",
        content_type: "application/x-www-form-urlencoded",
    ).unwrap()
    &post.add_header("Host", "example.test").unwrap()
    &post.add_header("Origin", "http://example.test").unwrap()
    &post.add_header("Sec-Fetch-Site", "same-origin").unwrap()
    let redirect = &router.serve_http(&app, post.request()).unwrap()
    testing.assert_eq(redirect.status(), http.Status.SeeOther, "POST /sign did not answer 303")?
    testing.assert_eq(redirect.header("Location"), Option.Some("/"), "Location header changed")?
    let set_cookie = redirect.header("Set-Cookie").unwrap()
    let (cookie_pair, _) = set_cookie.split_once(";").unwrap()

    var get = http.new_request(arena.handle(), "GET", "/", body: "").unwrap()
    &get.add_header("Cookie", cookie_pair).unwrap()
    let home_page = &router.serve_http(&app, get.request()).unwrap()
    testing.assert_eq(home_page.status(), http.Status.Ok, "GET / did not answer 200")?
    testing.assert_eq(home_page.header("Content-Type"), Option.Some("text/html; charset=utf-8"), "Content-Type was not HTML")?
    let html_body = home_page.text().unwrap()
    testing.assert(html_body.find("value=\"René &lt;script&gt;\"").is_some(), "the cookie did not round-trip into the escaped input")?
    testing.assert(html_body.find("<li><b>René &lt;script&gt;</b>").is_some(), "the signed name was not rendered")?
    testing.assert(html_body.find("<p>Hello &amp; welcome</p>").is_some(), "the signed message was not rendered")?
    .Ok(())
}

test fn exact_length_boundaries_are_accepted_and_one_scalar_past_is_refused() {
    defer var router: http.Router[App] = http.Router.new()
    routes(&router).unwrap()
    defer var app = App.in_memory().unwrap()
    defer let arena = mem.Arena.open(mem.system(), size: 131072)

    // 60 scalars (including a two-byte UTF-8 `é`) and 500 scalars are accepted.
    defer var ok_name = String.new()
    &ok_name.append("é").unwrap()
    for _ in 0..59 {
        &ok_name.append("a").unwrap()
    }
    defer var ok_msg = String.new()
    for _ in 0..500 {
        &ok_msg.append("m").unwrap()
    }
    defer var ok_body = String.new()
    "name={http.percent_encoded(ok_name.view())}&message={ok_msg.view()}".fmt(&ok_body).unwrap()
    var at_limit = http.new_request(arena.handle(), "POST", "/sign", body: ok_body.view(), content_type: "application/x-www-form-urlencoded").unwrap()
    &at_limit.add_header("Host", "example.test").unwrap()
    &at_limit.add_header("Origin", "http://example.test").unwrap()
    let accepted = &router.serve_http(&app, at_limit.request()).unwrap()
    testing.assert_eq(accepted.status(), http.Status.SeeOther, "exact scalar limits were refused")?

    // 61 scalars for name and 501 for message: refused with 422.
    defer var over_name = String.new()
    "name={http.percent_encoded(ok_name.view())}a&message=hello".fmt(&over_name).unwrap()
    defer var over_msg = String.new()
    "name=Ada&message={ok_msg.view()}m".fmt(&over_msg).unwrap()
    var empty_name = http.new_request(arena.handle(), "POST", "/sign", body: "name=+++&message=hi", content_type: "application/x-www-form-urlencoded").unwrap()
    &empty_name.add_header("Host", "example.test").unwrap()
    var empty_message = http.new_request(arena.handle(), "POST", "/sign", body: "name=Ada&message=+++", content_type: "application/x-www-form-urlencoded").unwrap()
    &empty_message.add_header("Host", "example.test").unwrap()
    var long_name = http.new_request(arena.handle(), "POST", "/sign", body: over_name.view(), content_type: "application/x-www-form-urlencoded").unwrap()
    &long_name.add_header("Host", "example.test").unwrap()
    var long_message = http.new_request(arena.handle(), "POST", "/sign", body: over_msg.view(), content_type: "application/x-www-form-urlencoded").unwrap()
    &long_message.add_header("Host", "example.test").unwrap()
    for sent in [empty_name, empty_message, long_name, long_message] {
        let refused = match &router.serve_http(&app, sent.request()) {
            Ok(_) => return testing.assert(false, "an invalid signature was accepted"),
            Err(error) => error,
        }
        testing.assert_eq(refused.status(), http.Status.UnprocessableContent, "the status was not 422")?
    }
    .Ok(())
}

test fn the_longest_non_ascii_signature_fits_the_body_limit() {
    defer var router: http.Router[App] = http.Router.new()
    routes(&router).unwrap()
    defer var app = App.in_memory().unwrap()
    defer let arena = mem.Arena.open(mem.system(), size: 131072)

    // `😀` is four bytes of UTF-8, and a form writes each byte as `%XX`, so a
    // name of 60 and a message of 500 of them is the longest body a form sends.
    defer var name = String.new()
    for _ in 0..longest_name {
        &name.append("😀").unwrap()
    }
    defer var message = String.new()
    for _ in 0..longest_message {
        &message.append("😀").unwrap()
    }
    defer var body = String.new()
    "name={http.percent_encoded(name.view())}&message={http.percent_encoded(message.view())}".fmt(&body).unwrap()
    testing.assert_eq(body.length(), limits().max_body_bytes, "the longest signature does not fill the body limit")?
    var longest = http.new_request(arena.handle(), "POST", "/sign", body: body.view(), content_type: "application/x-www-form-urlencoded").unwrap()
    &longest.add_header("Host", "example.test").unwrap()
    let accepted = &router.serve_http(&app, longest.request()).unwrap()
    testing.assert_eq(accepted.status(), http.Status.SeeOther, "the longest non-ASCII signature was refused")?
    .Ok(())
}

test fn control_and_format_characters_are_refused_and_line_breaks_in_a_message_are_kept() {
    defer var router: http.Router[App] = http.Router.new()
    routes(&router).unwrap()
    defer var app = App.in_memory().unwrap()
    defer let arena = mem.Arena.open(mem.system(), size: 131072)

    let refused_bodies = [
        "name=a%00b&message=hi",
        "name=a%0D%0ASet-Cookie:+x=1&message=hi",
        "name=a%09b&message=hi",
        "name=a%7Fb&message=hi",
        "name=Ada&message=a%00b",
        "name=Ada&message=a%1Bb",
        "name=Ada&message=a%7Fb",
        "name=a%C2%85b&message=hi",
        "name=Ada&message=a%C2%9Fb",
        "name=Ada&message=a%C2%80b",
        "name=a%E2%80%AEb&message=hi",
        "name=a%E2%80%8Fb&message=hi",
        "name=a%E2%81%A6b&message=hi",
        "name=a%EF%BB%BFb&message=hi",
        "name=a%E2%80%A8b&message=hi",
        "name=Ada&message=a%E2%80%A9b",
        "name=Ada&message=a%E2%80%AAb",
        "name=Ada&message=a%E2%80%8Eb",
    ]
    for read body in refused_bodies {
        var sent = http.new_request(arena.handle(), "POST", "/sign", body: body, content_type: "application/x-www-form-urlencoded").unwrap()
        &sent.add_header("Host", "example.test").unwrap()
        let refused = match &router.serve_http(&app, sent.request()) {
            Ok(_) => return testing.assert(false, "a control character was accepted"),
            Err(error) => error,
        }
        testing.assert_eq(refused.status(), http.Status.UnprocessableContent, "the status was not 422")?
    }

    // A browser sends a line break as CRLF; the message stores it as LF, as
    // it stores a lone CR.
    var lines = http.new_request(arena.handle(), "POST", "/sign", body: "name=Ada&message=one%0D%0Atwo%09three%0Dfour", content_type: "application/x-www-form-urlencoded").unwrap()
    &lines.add_header("Host", "example.test").unwrap()
    let accepted = &router.serve_http(&app, lines.request()).unwrap()
    testing.assert_eq(accepted.status(), http.Status.SeeOther, "a message with line breaks and a tab was refused")?
    var get = http.new_request(arena.handle(), "GET", "/", body: "").unwrap()
    let home_page = &router.serve_http(&app, get.request()).unwrap()
    let html_body = home_page.text().unwrap()
    testing.assert(html_body.find("<p>one\ntwo\tthree\nfour</p>").is_some(), "the message did not keep its line breaks as LF and its tab")?
    .Ok(())
}

test fn a_line_break_counts_once_towards_the_message_limit() {
    defer var router: http.Router[App] = http.Router.new()
    routes(&router).unwrap()
    defer var app = App.in_memory().unwrap()
    defer let arena = mem.Arena.open(mem.system(), size: 131072)

    // 250 lines of `a`, each ended by the CRLF a browser sends, are 500
    // characters as the form's `maxlength` counts them.
    defer var body = String.new()
    &body.append("name=Ada&message=").unwrap()
    for _ in 0..250 {
        &body.append("a%0D%0A").unwrap()
    }
    var lines = http.new_request(arena.handle(), "POST", "/sign", body: body.view(), content_type: "application/x-www-form-urlencoded").unwrap()
    &lines.add_header("Host", "example.test").unwrap()
    let accepted = &router.serve_http(&app, lines.request()).unwrap()
    testing.assert_eq(accepted.status(), http.Status.SeeOther, "a message of 500 characters with CRLF line breaks was refused")?
    .Ok(())
}

test fn origin_and_fetch_site_spoofing_attempts_answer_403() {
    defer var router: http.Router[App] = http.Router.new()
    routes(&router).unwrap()
    defer var app = App.in_memory().unwrap()
    defer let arena = mem.Arena.open(mem.system(), size: 131072)

    var cross_site = http.new_request(arena.handle(), "POST", "/sign", body: "name=Ada&message=hi", content_type: "application/x-www-form-urlencoded").unwrap()
    &cross_site.add_header("Host", "example.test").unwrap()
    &cross_site.add_header("Origin", "http://evil.test").unwrap()
    &cross_site.add_header("Sec-Fetch-Site", "cross-site").unwrap()

    var same_site_subdomain = http.new_request(arena.handle(), "POST", "/sign", body: "name=Ada&message=hi", content_type: "application/x-www-form-urlencoded").unwrap()
    &same_site_subdomain.add_header("Host", "example.test").unwrap()
    &same_site_subdomain.add_header("Origin", "http://sub.example.test").unwrap()
    &same_site_subdomain.add_header("Sec-Fetch-Site", "same-site").unwrap()

    // `Sec-Fetch-Site` alone refuses a post, with no `Origin` to compare and
    // beside an `Origin` that matches `Host`.
    var cross_site_fetch_only = http.new_request(arena.handle(), "POST", "/sign", body: "name=Ada&message=hi", content_type: "application/x-www-form-urlencoded").unwrap()
    &cross_site_fetch_only.add_header("Host", "example.test").unwrap()
    &cross_site_fetch_only.add_header("Sec-Fetch-Site", "cross-site").unwrap()

    var same_site_fetch_only = http.new_request(arena.handle(), "POST", "/sign", body: "name=Ada&message=hi", content_type: "application/x-www-form-urlencoded").unwrap()
    &same_site_fetch_only.add_header("Host", "example.test").unwrap()
    &same_site_fetch_only.add_header("Sec-Fetch-Site", "same-site").unwrap()

    var cross_site_matching_origin = http.new_request(arena.handle(), "POST", "/sign", body: "name=Ada&message=hi", content_type: "application/x-www-form-urlencoded").unwrap()
    &cross_site_matching_origin.add_header("Host", "example.test").unwrap()
    &cross_site_matching_origin.add_header("Origin", "http://example.test").unwrap()
    &cross_site_matching_origin.add_header("Sec-Fetch-Site", "cross-site").unwrap()

    var null_origin = http.new_request(arena.handle(), "POST", "/sign", body: "name=Ada&message=hi", content_type: "application/x-www-form-urlencoded").unwrap()
    &null_origin.add_header("Host", "example.test").unwrap()
    &null_origin.add_header("Origin", "null").unwrap()

    var suffix_spoof = http.new_request(arena.handle(), "POST", "/sign", body: "name=Ada&message=hi", content_type: "application/x-www-form-urlencoded").unwrap()
    &suffix_spoof.add_header("Host", "example.test").unwrap()
    &suffix_spoof.add_header("Origin", "http://evil-example.test").unwrap()

    var path_spoof = http.new_request(arena.handle(), "POST", "/sign", body: "name=Ada&message=hi", content_type: "application/x-www-form-urlencoded").unwrap()
    &path_spoof.add_header("Host", "example.test").unwrap()
    &path_spoof.add_header("Origin", "http://evil.test/example.test").unwrap()

    var port_mismatch = http.new_request(arena.handle(), "POST", "/sign", body: "name=Ada&message=hi", content_type: "application/x-www-form-urlencoded").unwrap()
    &port_mismatch.add_header("Host", "example.test:8080").unwrap()
    &port_mismatch.add_header("Origin", "http://example.test:8081").unwrap()

    var scheme_mismatch = http.new_request(arena.handle(), "POST", "/sign", body: "name=Ada&message=hi", content_type: "application/x-www-form-urlencoded").unwrap()
    &scheme_mismatch.add_header("Host", "example.test").unwrap()
    &scheme_mismatch.add_header("Origin", "https://example.test").unwrap()

    for sent in [cross_site, same_site_subdomain, cross_site_fetch_only, same_site_fetch_only, cross_site_matching_origin, null_origin, suffix_spoof, path_spoof, port_mismatch, scheme_mismatch] {
        let refused = match &router.serve_http(&app, sent.request()) {
            Ok(_) => return testing.assert(false, "a forged origin was accepted"),
            Err(error) => error,
        }
        testing.assert_eq(refused.status(), http.Status.Forbidden, "the status was not 403")?
    }

    // Matching origin with default port `:80` and uppercase host is accepted.
    var matching_origin = http.new_request(arena.handle(), "POST", "/sign", body: "name=Ada&message=hi", content_type: "application/x-www-form-urlencoded").unwrap()
    &matching_origin.add_header("Host", "example.test").unwrap()
    &matching_origin.add_header("Origin", "HTTP://EXAMPLE.TEST:80").unwrap()
    let allowed = &router.serve_http(&app, matching_origin.request()).unwrap()
    testing.assert_eq(allowed.status(), http.Status.SeeOther, "a matching origin with default port was refused")?
    .Ok(())
}

test fn favicon_answers_204_no_content() {
    defer var router: http.Router[App] = http.Router.new()
    routes(&router).unwrap()
    defer var app = App.in_memory().unwrap()
    defer let arena = mem.Arena.open(mem.system(), size: 16384)
    var req = http.new_request(arena.handle(), "GET", "/favicon.ico", body: "").unwrap()
    &req.add_header("Host", "example.test").unwrap()
    let response = &router.serve_http(&app, req.request()).unwrap()
    testing.assert_eq(response.status(), http.Status.NoContent, "favicon status was not 204")?
    testing.assert_ok_eq(response.text(), "", "favicon had a body")?
    .Ok(())
}

test fn forwarded_proto_https_is_recognised_for_same_origin() {
    defer var router: http.Router[App] = http.Router.new()
    routes(&router).unwrap()
    defer var app_untrusted = App.in_memory().unwrap()
    defer var app_trusted = App.in_memory_with_trust(.All).unwrap()
    defer let arena = mem.Arena.open(mem.system(), size: 65536)
    var post = http.new_request(
        arena.handle(),
        "POST",
        "/sign",
        body: "name=Grace&message=Hello",
        content_type: "application/x-www-form-urlencoded",
    ).unwrap()
    &post.add_header("Host", "example.test").unwrap()
    &post.add_header("Origin", "https://example.test").unwrap()
    &post.add_header("X-Forwarded-Proto", "https").unwrap()
    &post.add_header("Sec-Fetch-Site", "same-origin").unwrap()

    // Without proxy trust, client-supplied proxy headers are not trusted and 403 is answered.
    let refused = match &router.serve_http(&app_untrusted, post.request()) {
        Ok(_) => return testing.assert(false, "untrusted forwarded proto was accepted"),
        Err(err) => err,
    }
    testing.assert_eq(refused.status(), http.Status.Forbidden, "untrusted forwarded proto was not refused 403")?

    // With explicit proxy trust configured, forwarded https is recognized and 303 is answered.
    let response = &router.serve_http(&app_trusted, post.request()).unwrap()
    testing.assert_eq(response.status(), http.Status.SeeOther, "forwarded https was refused when trusted")?
    .Ok(())
}
