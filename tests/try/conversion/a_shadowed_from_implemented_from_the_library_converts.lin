// The report on a program that declares its own `From` names the library's
// through `std.convert`, which declares it. Implementing that one, as the report
// says, makes `?` convert.
import std.convert

trait From[T] {
    fn from(sink source: T) -> Self
}

enum Parse {
    Malformed,
}

enum Io {
    Refused,
}

impl convert.From[Parse] for Io {
    fn from(sink _source: Parse) -> Io {
        return .Refused
    }
}

// The program's own `From`, which `?` never uses.
impl From[Io] for Parse {
    fn from(sink _source: Io) -> Parse {
        return .Malformed
    }
}

fn parsed() -> Result[UInt8, Parse] {
    return .Err(.Malformed)
}

fn go() -> Result[UInt8, Io] {
    let n = parsed()?
    return .Ok(n)
}

fn main() -> UInt8 {
    match go() {
        Ok(n) => n,
        Err(_) => 6,
    }
}
