// `lazy_map` takes a callback that owns what it holds. A closure lending
// `label` is refused there, once: the iterator the call builds would be
// released and walked through implementations that ask the same of the
// callback, and those are not reported again.
@linear
struct Lazy[F] {
    f: F,
    at: UInt64,
}

impl[F: Owned + fn(sink k: UInt64) -> UInt64] Iterator for Lazy[F] {
    type Item = UInt64

    fn next(inout self: Self) -> Option[UInt64] {
        if self.at == 3 {
            return .None
        }
        self.at += 1
        .Some((self.f)(self.at))
    }
}

impl[F: Owned + Discardable + fn(sink k: UInt64) -> UInt64] Release for Lazy[F] {
    fn release(sink self: Self) {
        let Lazy { f: _, at: _ } = self
    }
}

fn lazy_map[F: Owned + fn(sink k: UInt64) -> UInt64](sink f: F) -> Lazy[F] {
    Lazy[F] { f = f, at = 0 }
}

fn main() -> UInt8 {
    defer let label = "scale".to_owned().unwrap()
    defer var results = lazy_map([read label] |sink k| k * label.view().length())
    var total: UInt64 = 0
    for r in &results {
        total += r
    }
    UInt8(total)
}
