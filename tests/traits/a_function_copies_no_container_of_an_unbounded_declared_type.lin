// An ordinary generic function cannot copy a conditional wrapper whose
// associated-type payload has no Copyable guarantee.
@linear
enum Key {
    Forged(UInt8),
}

struct Counter {
    at: UInt8,
}

trait Measure {
    type Item

    fn of(sink x: Self) -> Self.Item
}

impl Measure for Counter {
    type Item = Key

    fn of(sink x: Self) -> Self.Item {
        Key.Forged(x.at)
    }
}

@copyable
enum Wrap[W: Measure] {
    Holds(W.Item),
}

fn twin[W: Measure](w: Wrap[W]) -> Wrap[W] {
    copy(w)
}

fn eat(sink k: Key) -> UInt8 {
    match k {
        Forged(n) => n,
    }
}

fn main() -> UInt8 {
    let c: Counter = .{ at = 3 }
    let w: Wrap[Counter] = .Holds(Measure.of(c))
    let g: Wrap[Counter] = twin(w)
    let a = match w {
        Holds(k) => eat(k),
    }
    let b = match g {
        Holds(k) => eat(k),
    }
    a + b
}
