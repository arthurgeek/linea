// An interpolated literal implements `Display`, so it can itself be the value
// of another interpolation, with or without a layout.
import std.io

use io.IoError
use io.println

fn main() -> Result[UInt8, IoError] {
    let x: UInt8 = 7
    println("[{"{x}"}]")?
    println("[{"x={x}":>6}]")?
    return .Ok(0)
}
