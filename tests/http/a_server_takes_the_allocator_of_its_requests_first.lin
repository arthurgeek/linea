import std.http
import std.mem
import std.net

fn routes() -> http.Router[()] {
    http.Router.new()
}

// `listen_and_serve_in` takes the allocator each request's memory is carved
// from first, before the address and the function that builds each serving
// task's handler. This server is told to serve no connection, so it returns as
// soon as it is listening.
fn main() -> UInt8 {
    let limits = http.Limits { connections = .Some(0), ..http.Limits.default() }
    match http.listen_and_serve_in(mem.system(), net.loopback(0), routes, limits: limits) {
        Ok(_) => 0,
        Err(_) => 1,
    }
}
