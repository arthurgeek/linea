// After `peek`, the peekable holds a linear ticket. Letting the peekable go
// would drop that ticket unsettled.
@linear
struct Ticket { seat: UInt8 }

struct Tickets { next_seat: UInt8 }

impl Iterator for Tickets {
    type Item = Ticket

    fn next(inout self: Self) -> Option[Ticket] {
        if self.next_seat == 3 {
            return .None
        }
        self.next_seat += 1
        .Some(Ticket { seat = self.next_seat })
    }
}

fn main() -> UInt8 {
    var line = (Tickets { next_seat = 0 }).peekable()
    match &line.peek() {
        Some(ticket) => ticket.seat,
        None => 0,
    }
}
