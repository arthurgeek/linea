// Materialization after incremental reads caches the remaining bytes, without
// replaying the prefix or consuming the cache on subsequent calls.
import std.http
import std.io
import std.mem

use io.Reader
use mem.Lender

fn main() -> UInt8 {
    defer let arena = mem.Arena.open(mem.system(), size: 65536)
    let sent = http.new_request(arena.handle(), "POST", "/", body: "").unwrap()
    defer var incoming = http.RequestBody.from_slice("hello".as_bytes(), arena.handle())
    defer var buffer = mem.system().acquire(2).unwrap()
    let prefix_count = &incoming.read_some(&buffer, offset: 0, count: 2).unwrap()
    let prefix = Str.from_bytes(buffer.as_slice()).unwrap()
    let first_length = &incoming.materialize(sent.request()).unwrap().body().length()
    let second = &incoming.materialize(sent.request()).unwrap().text().unwrap()
    io.println("{prefix} / {first_length} / {second}").unwrap()
    if prefix_count == 2 && prefix == "he" && first_length == 3 && second == "llo" {
        0
    } else {
        1
    }
}
