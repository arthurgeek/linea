import std.num

fn main() -> UInt8 {
    let left = [Int32(2), 3, 4]
    let right = [Int32(5), 6, 7]
    if num.dot(left, right) != 56 {
        return 1
    }
    let a = num.matrix([[Int32(1), 2], [3, 4]])
    let b = num.matrix([[Int32(5), 6], [7, 8]])
    let product = num.hadamard(a, b)
    if product[0, 0] != 5 || product[0, 1] != 12 || product[1, 0] != 21 || product[1, 1] != 32 {
        return 2
    }
    0
}
