import std.io
import std.net
import std.session
import std.task
import std.time

use net.Acceptor
use net.Accepted
use session.Chan
use session.End

fn main() -> UInt8 {
    let listening = net.listen(net.loopback(0)).unwrap()
    let address = listening.local_address().unwrap()
    let execution = io.Loop.open(carriers: 2).unwrap()
    var passed = false
    let body = sink [sink listening, inout passed] |sink me: Chan[End]| {
        var listener = listening
        let first = task.current_carrier().unwrap()
        let refused = match &listener.accept() {
            Ok(accepted) => {
                let Accepted { connection, address: _ } = accepted
                connection.release()
                false
            },
            Err(Io(error)) => error.category == .PermissionDenied,
            Err(_) => false,
        }
        if !refused || first == task.current_carrier().unwrap() {
            panic("accepted-descriptor failure did not retire before migration")
        }
        time.sleep(time.Duration.from_nanoseconds(0))
        if first != task.current_carrier().unwrap() {
            panic("failed accept lost its continuation")
        }
        listener.release()
        passed = true
        me.close()
    }
    let running = task.prepare(body, on: execution).unwrap().start()
    let peer = net.connect(address).unwrap()
    running.close()
    peer.release()
    if passed {
        0
    } else {
        1
    }
}
