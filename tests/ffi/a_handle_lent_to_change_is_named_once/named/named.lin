import std.ffi

@(opaque, linear)
type Name = UInt64

extern fn named_open() -> Name

extern fn named_close(sink handle: Name)

// For two objects, the answer lives in `a` and survives the reset of `b`. One
// handle passed as both would answer freed text, so a handle lent to change
// is the only argument naming its place.
extern fn named_name_then_reset(read a: Name, b: Name) -> ffi.CText where borrows(a)

pub fn first_length() -> UInt64 {
    var handle = named_open()
    let length = named_name_then_reset(handle, handle).length()
    named_close(handle)
    length
}
