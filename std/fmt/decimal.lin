test fn int64_renderers_preserve_decimal_boundaries() {
    let least = -9223372036854775808
    testing.assert(display_text_equals(least, "-9223372036854775808"), "Int64.display changed least")?
    testing.assert(debug_text_equals(least, "-9223372036854775808"), "Int64.debug changed least")?
    let zero = 0
    testing.assert(display_text_equals(zero, "0"), "Int64.display changed zero")?
    testing.assert(debug_text_equals(zero, "0"), "Int64.debug changed zero")?
    let greatest = 9223372036854775807
    testing.assert(display_text_equals(greatest, "9223372036854775807"), "Int64.display changed greatest")?
    testing.assert(debug_text_equals(greatest, "9223372036854775807"), "Int64.debug changed greatest")?
    testing.assert(display_preserves_writer_failure(least), "Int64.Display lost a writer failure")?
    testing.assert(debug_preserves_writer_failure(greatest), "Int64.Debug lost a writer failure")?
    .Ok(())
}

test fn uint64_renderers_preserve_decimal_boundaries() {
    let least: UInt64 = 0
    testing.assert(display_text_equals(least, "0"), "UInt64.display changed least")?
    testing.assert(debug_text_equals(least, "0"), "UInt64.debug changed least")?
    let greatest: UInt64 = 18446744073709551615
    testing.assert(display_text_equals(greatest, "18446744073709551615"), "UInt64.display changed greatest")?
    testing.assert(debug_text_equals(greatest, "18446744073709551615"), "UInt64.debug changed greatest")?
    testing.assert(display_preserves_writer_failure(least), "UInt64.Display lost a writer failure")?
    testing.assert(debug_preserves_writer_failure(greatest), "UInt64.Debug lost a writer failure")?
    .Ok(())
}

// Count the decimal digits of `n`; zero has one.
fn decimal_digits(n: UInt64) -> UInt64 {
    var count: UInt64 = 1
    var rest = n / 10
    while rest > 0 {
        count += 1
        rest /= 10
    }
    count
}

test fn decimal_digits_count_every_place() {
    testing.assert_eq(decimal_digits(0), UInt64(1), "zero has one digit")?
    testing.assert_eq(decimal_digits(9), UInt64(1), "nine has one digit")?
    testing.assert_eq(decimal_digits(10), UInt64(2), "ten has two digits")?
    testing.assert_eq(decimal_digits(18446744073709551615), UInt64(20), "UInt64.max has twenty digits")?
    .Ok(())
}

// Return 10^n for n from 0 through 19, the powers of ten a UInt64 holds.
fn power_of_ten(n: UInt64) -> UInt64 {
    var result: UInt64 = 1
    var left = n
    while left > 0 {
        result *= 10
        left -= 1
    }
    result
}

test fn power_of_ten_multiplies_by_ten_each_step() {
    testing.assert_eq(power_of_ten(0), UInt64(1), "10^0 is not one")?
    testing.assert_eq(power_of_ten(3), UInt64(1000), "10^3 changed")?
    let largest: UInt64 = 10000000000000000000
    testing.assert_eq(power_of_ten(19), largest, "10^19 changed")?
    .Ok(())
}
