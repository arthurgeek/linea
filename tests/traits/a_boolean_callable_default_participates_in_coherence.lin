trait Give[U] {
    fn give(_self: Self, _value: U) -> UInt8
}

struct Holder {
    value: UInt8,
}

impl Give[fn(read flag: Bool = true) -> Bool] for Holder {
    fn give(_self: Holder, _value: fn(read flag: Bool = true) -> Bool) -> UInt8 {
        0
    }
}

impl Give[fn(read flag: Bool = true) -> Bool] for Holder {
    fn give(_self: Holder, _value: fn(read flag: Bool = true) -> Bool) -> UInt8 {
        1
    }
}

fn main() -> UInt8 {
    let _holder: Holder = .{ value = 0 }
    0
}
