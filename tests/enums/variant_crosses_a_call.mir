function ;main
local $0 Colour value storage=i64
@0:
  %0 = constant Colour value computation=i64 1
  %1 = call Colour value computation=i64 @f1(%0)
  store Colour $0 %1
  %3 = constant UInt8 value computation=i64 0
  ret %3
function ;same
local $0 Colour value storage=i64
@0:
  %0 = load Colour value computation=i64 $0
  ret %0
