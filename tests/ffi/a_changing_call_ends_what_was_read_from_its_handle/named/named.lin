import std.ffi

@(opaque, linear)
type Name = UInt64

extern fn named_open() -> Name

// C only reads the object here, which `read` says.
extern fn named_name(read handle: Name) -> ffi.CText where borrows(handle)

// Without `read`, C may change the object: this one frees the name it held.
extern fn named_reset(handle: Name)

extern fn named_close(sink handle: Name)

@(opaque, linear)
struct Named { handle: Name }

impl Named {
    pub fn open() -> Named {
        .{ handle = named_open() }
    }

    // The reset frees the text `name` points into, so reading it after is
    // refused.
    pub fn first_byte_after_reset(inout self: Self) -> UInt8 {
        let name = named_name(self.handle)
        named_reset(self.handle)
        let held = name.copy_bytes(length: 1).unwrap()
        let first = held[0]
        held.release()
        first
    }

    pub fn close(sink self: Self) {
        let Named { handle: handle } = self
        named_close(handle)
    }
}
