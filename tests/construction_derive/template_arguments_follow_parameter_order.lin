trait Measure[A, B] {
    fn measure(_self: Self, _first: A, _second: B) -> UInt64
}

template impl[A, B] Measure[B, A] {
    fn measure(_self: Self, _first: B, _second: A) -> UInt64 {
        0
    }
}

struct Product {}

derive Measure[UInt8, Bool] for Product

fn main() -> UInt8 {
    let _product: Product = .{}
    0
}
