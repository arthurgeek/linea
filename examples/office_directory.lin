// Keep an office contact directory, update an extension, and look up a name.
// `Index[UInt64]` selects a card from the start; `Index[FromEnd]` supports
// `^1` for the last card. Both projections reach the stored contact, so an
// assignment through either spelling updates the directory.
import std.io
import std.testing

use io.IoError
use io.println

struct Contact {
    name: Str,
    extension: UInt16,
}

struct Rolodex {
    cards: [Contact; 4],
}

// `via cards` names the stored array that receives each index.
impl Index[UInt64] for Rolodex via cards

impl Index[FromEnd] for Rolodex via cards

// `trav positions via cards` lets `for` visit the cards in array order;
// implementing `Index` alone does not make a type traversable.
impl Rolodex {
    trav positions via cards
}

// `break card.extension` gives the `for` loop the value `Some(extension)`; a
// loop that ends without breaking gives `None`.
fn extension_for(directory: Rolodex, name: Str) -> Option[UInt16] {
    for read card in directory {
        if card.name == name {
            break card.extension
        }
    }
}

test fn an_updated_contact_is_found_by_name() {
    var directory = Rolodex { cards = [
        .{ name = "Reception", extension = 100 },
        .{ name = "Facilities", extension = 210 },
        .{ name = "Accounts", extension = 320 },
        .{ name = "Support", extension = 400 },
    ] }

    directory[1].extension = 218
    directory[^1].extension = 405

    testing.assert_eq(extension_for(directory, "Facilities"), .Some(218), "Facilities must use its updated extension")?
    testing.assert_eq(extension_for(directory, "Support"), .Some(405), "Support must use its updated extension")?
    testing.assert_eq(extension_for(directory, "Reception"), .Some(100), "updating other contacts must preserve Reception")?
    testing.assert_eq(extension_for(directory, "Shipping"), .None, "Shipping has no card in this directory")?
}

fn main() -> Result[UInt8, IoError] {
    var directory = Rolodex { cards = [
        .{ name = "Reception", extension = 100 },
        .{ name = "Facilities", extension = 210 },
        .{ name = "Accounts", extension = 320 },
        .{ name = "Support", extension = 400 },
    ] }

    // `directory[1]` and `directory[^1]` name stored cards, so assigning to a
    // field through them updates the directory itself.
    directory[1].extension = 218
    directory[^1].extension = 405

    println("office directory")?
    // `enumerate` pairs each card with its position, and the pattern
    // `(n, card)` takes the pair apart. Positions start at zero.
    for (n, card) in directory.cards.as_slice().enumerate() {
        println("{n + 1}. {card.name}: extension {card.extension}")?
    }

    match extension_for(directory, "Facilities") {
        Some(extension) => println("for building repairs, call extension {extension}")?,
        None => println("Facilities is missing from the directory")?,
    }

    .Ok(0)
}
