// `copy(p)` produces a value independent of `p` -- one such that no later
// operation on either is observable through the other. For a value that lives
// in memory that means storage of its own, and it is owed at the copy rather
// than left to whoever consumes the value: a consumer runs later, and for a
// call argument it is the callee's prologue, which runs after every argument
// in the list has been evaluated.
//
// The `.ssa` beside this case is what it asserts. `copy(p)` allocates a slot
// and blits into it, so the address the call receives is one the source cannot
// reach; handing the source's own address along would have made the copy a
// second name for it until something else got round to duplicating the bytes.
@copyable
struct P {
    x: UInt8,
    y: UInt8,
}

fn take(sink a: P) -> UInt8 {
    a.x
}

fn main() -> UInt8 {
    var p: P = .{ x = 1, y = 2 }
    let n: UInt8 = take(copy(p))
    p.x = 9
    n + p.x
}
