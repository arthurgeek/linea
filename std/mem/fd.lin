import std.mem.address
import std.testing

// The runtime reads or writes a descriptor at a raw address and returns the
// byte count, or a negated errno.
extern fn linea_read_some(fd: Int32, at: UInt64, len: UInt64) -> Int64

extern fn linea_write_some(fd: Int32, at: UInt64, len: UInt64) -> Int64

// The runtime reads or writes a socket at a raw address with a deadline on the
// monotonic clock, in nanoseconds, or 0 for none. It returns the byte count, or
// a negated errno, -ETIMEDOUT once the deadline has passed.
extern fn linea_net_read(fd: Int32, at: UInt64, len: UInt64, deadline_ns: UInt64) -> Int64

extern fn linea_net_write(fd: Int32, at: UInt64, len: UInt64, deadline_ns: UInt64) -> Int64

extern fn linea_read_at(fd: Int32, at: UInt64, len: UInt64, offset: UInt64) -> Int64

extern fn linea_write_at(fd: Int32, at: UInt64, len: UInt64, offset: UInt64) -> Int64

// Read up to `count` bytes from `fd` into `buffer` at `offset`, checking the
// range first, and return the runtime's count or negated errno. Transport holds
// the owner for the complete call. The runtime is handed the number in an
// `Address[UInt8]` made from the buffer, never a number computed beside it.
internal fn read_fd[A: Allocator](inout buffer: Buffer[A], fd: Int32, offset: UInt64, count: UInt64) -> Int64 {
    if offset > buffer.length() || count > buffer.length() - offset {
        panic("buffer I/O range is out of bounds")
    }
    linea_read_some(fd, address.raw(bytes_in(buffer, offset)), count)
}

test trap "fd reads reject an offset past the buffer" -> Result[(), testing.Failure] {
    // Offset two exceeds a one-byte extent, even for an empty request.
    // The invalid descriptor -1 must never reach the runtime.
    let allocator = system()
    var bytes = allocator.acquire(1) else |_| {
        return testing.assert(false, "test buffer allocation failed")
    }
    let _result = read_fd(&bytes, -1, 2, 0)
    bytes.release()
    .Ok(())
}

test trap "fd reads reject a count past the remaining buffer" -> Result[(), testing.Failure] {
    // Offset one leaves no bytes; UInt64.max also exposes unchecked offset+count.
    // The invalid descriptor -1 must never reach the runtime.
    let allocator = system()
    var bytes = allocator.acquire(1) else |_| {
        return testing.assert(false, "test buffer allocation failed")
    }
    let _result = read_fd(&bytes, -1, 1, UInt64.max)
    bytes.release()
    .Ok(())
}

// The address of the bytes `offset` into `buffer`, which may be its end.
fn bytes_in[A: Allocator](buffer: Buffer[A], offset: UInt64) -> Address[UInt8] where borrows(buffer) {
    address_in(buffer, offset)
}

// Write `bytes` to `fd` and return the count written or a negated errno.
internal fn write_slice_fd(bytes: Slice[UInt8], fd: Int32) -> Int64 {
    linea_write_some(fd, address.raw(slice_address(bytes)), bytes.length())
}

// Read up to `count` bytes from the socket `fd` into `buffer` at `offset`, by
// the deadline, and return the runtime's count or negated errno.
internal fn read_socket[A: Allocator](inout buffer: Buffer[A], fd: Int32, offset: UInt64, count: UInt64, deadline_ns: UInt64) -> Int64 {
    if offset > buffer.length() || count > buffer.length() - offset {
        panic("buffer I/O range is out of bounds")
    }
    linea_net_read(fd, address.raw(bytes_in(buffer, offset)), count, deadline_ns)
}

test trap "socket reads reject a range past the buffer" -> Result[(), testing.Failure] {
    // The invalid descriptor -1 must never reach the runtime.
    let allocator = system()
    var bytes = allocator.acquire(1) else |_| {
        return testing.assert(false, "test buffer allocation failed")
    }
    let _result = read_socket(&bytes, -1, 1, UInt64.max, 0)
    bytes.release()
    .Ok(())
}

// Write `bytes` to the socket `fd` by the deadline and return the count written
// or a negated errno.
internal fn write_slice_socket(bytes: Slice[UInt8], fd: Int32, deadline_ns: UInt64) -> Int64 {
    linea_net_write(fd, address.raw(slice_address(bytes)), bytes.length(), deadline_ns)
}

// Read up to `count` bytes from `fd` into `buffer` at `buffer_offset` starting at
// `file_offset` in the file.
internal fn read_fd_at[A: Allocator](inout buffer: Buffer[A], fd: Int32, buffer_offset: UInt64, count: UInt64, file_offset: UInt64) -> Int64 {
    if buffer_offset > buffer.length() || count > buffer.length() - buffer_offset {
        panic("buffer I/O range is out of bounds")
    }
    linea_read_at(fd, address.raw(bytes_in(buffer, buffer_offset)), count, file_offset)
}

// Write `bytes` to `fd` starting at `file_offset` in the file.
internal fn write_slice_fd_at(bytes: Slice[UInt8], fd: Int32, file_offset: UInt64) -> Int64 {
    linea_write_at(fd, address.raw(slice_address(bytes)), bytes.length(), file_offset)
}

test "empty fd requests do not access a descriptor" {
    // -1 is invalid, so success proves that a zero-byte request bypasses I/O.
    let allocator = system()
    defer var bytes = allocator.acquire(1) else |_| {
        return testing.assert(false, "test buffer allocation failed")
    }
    testing.assert_eq(read_fd(&bytes, -1, 1, 0), 0, "an empty read reached the descriptor")?
    testing.assert_eq(read_fd_at(&bytes, -1, 1, 0, 0), 0, "an empty positional read reached the descriptor")?
    let empty = bytes.as_slice().subspan(start: 1, count: 0).unwrap()
    testing.assert_eq(write_slice_fd(empty, -1), 0, "an empty write reached the descriptor")?
    testing.assert_eq(write_slice_fd_at(empty, -1, 0), 0, "an empty positional write reached the descriptor")?
    testing.assert_eq(write_slice_socket(empty, -1, 0), 0, "an empty socket write reached the descriptor")?
    testing.assert_eq(read_socket(&bytes, -1, 1, 0, 0), 0, "an empty socket read reached the descriptor")?
    .Ok(())
}

// The runtime's random and filesystem calls take raw addresses and extents,
// and return a count, a descriptor, a mode, zero, or a negated errno.
extern fn linea_random_bytes(at: UInt64, len: UInt64) -> Int64

// The runtime writes two random words to `high` and `low` and answers 0, or
// leaves both and answers a negated errno.
extern fn linea_random_words(inout high: UInt64, inout low: UInt64) -> Int64

extern fn linea_open_parent(at: UInt64, extent: UInt64) -> Int64

extern fn linea_open_at(parent: Int32, at: UInt64, extent: UInt64, policy: UInt8, mode: UInt64) -> Int64

extern fn linea_mode_at(parent: Int32, at: UInt64, extent: UInt64) -> Int64

extern fn linea_publish_at(parent: Int32, from: UInt64, from_extent: UInt64, to: UInt64, to_extent: UInt64, replace: UInt8) -> Int64

extern fn linea_unlink_at(parent: Int32, at: UInt64, extent: UInt64) -> Int64

// Fill `count` bytes of `buffer` from `offset` with random bytes. This hook and
// the filesystem hooks below are needed only by programs importing std.fs.
internal fn _random_bytes[A: Allocator](inout buffer: Buffer[A], offset: UInt64, count: UInt64) -> Int64 {
    if offset > buffer.length() || count > buffer.length() - offset {
        panic("random byte range is out of bounds")
    }
    linea_random_bytes(address.raw(bytes_in(buffer, offset)), count)
}

// Write 128 random bits to `high` and `low`, from the operating system's
// random source, and answer 0, or leave both and answer a negated errno.
internal fn random_words(inout high: UInt64, inout low: UInt64) -> Int64 {
    linea_random_words(&high, &low)
}

test "random_words differ between reads" {
    var first_high: UInt64 = 0
    var first_low: UInt64 = 0
    var second_high: UInt64 = 0
    var second_low: UInt64 = 0
    testing.assert_eq(random_words(&first_high, &first_low), Int64(0), "the first read failed")?
    testing.assert_eq(random_words(&second_high, &second_low), Int64(0), "the second read failed")?
    // Two reads of 128 random bits agree with probability 2^-128.
    testing.assert(first_high != second_high || first_low != second_low, "two reads gave the same bits")?
}

// Open the directory named by the NUL-terminated `path`.
internal fn _open_parent_fd[A: Allocator](path: Buffer[A]) -> Int64 {
    linea_open_parent(address.raw(bytes_in(path, 0)), path.length())
}

// An OpenPolicy says how `_open_at_fd` opens a name: read an existing file,
// create a new file exclusively, or create a file or truncate an existing one.
@copyable
internal enum OpenPolicy {
    ReadExisting,
    CreateNew,
    CreateOrTruncate,
}

// The runtime takes an open policy as a code: 0 reads an existing file, 1
// creates a new file exclusively, and 2 creates or truncates one.
fn open_policy_code(policy: OpenPolicy) -> UInt8 {
    match read policy {
        ReadExisting => 0,
        CreateNew => 1,
        CreateOrTruncate => 2,
    }
}

test "open policies have the runtime's codes" {
    testing.assert_eq(open_policy_code(.ReadExisting), UInt8(0), "reading an existing file changed its code")?
    testing.assert_eq(open_policy_code(.CreateNew), UInt8(1), "exclusive creation changed its code")?
    testing.assert_eq(open_policy_code(.CreateOrTruncate), UInt8(2), "truncating creation changed its code")?
}

// Open `name` in the directory `parent` under `policy`, giving a created file
// `mode`; a policy that creates nothing ignores the mode.
internal fn _open_at_fd[A: Allocator](name: Buffer[A], parent: Int32, policy: OpenPolicy, mode: UInt64) -> Int64 {
    linea_open_at(parent, address.raw(bytes_in(name, 0)), name.length(), open_policy_code(policy), mode)
}

// Return the permission bits of `name` in the directory `parent`.
internal fn _mode_at_fd[A: Allocator](name: Buffer[A], parent: Int32) -> Int64 {
    linea_mode_at(parent, address.raw(bytes_in(name, 0)), name.length())
}

// Rename `from` to `to` within `parent`, replacing an existing `to` only when
// `replace` is set.
internal fn _publish_at_fd[A: Allocator, B: Allocator](from: Buffer[A], to: Buffer[B], parent: Int32, replace: UInt8) -> Int64 {
    linea_publish_at(parent, address.raw(bytes_in(from, 0)), from.length(), address.raw(bytes_in(to, 0)), to.length(), replace)
}

// Remove `name` from the directory `parent`.
internal fn _unlink_at_fd[A: Allocator](name: Buffer[A], parent: Int32) -> Int64 {
    linea_unlink_at(parent, address.raw(bytes_in(name, 0)), name.length())
}

extern fn linea_make_dir_at(parent: Int32, at: UInt64, extent: UInt64, mode: UInt64) -> Int64

extern fn linea_remove_dir_at(parent: Int32, at: UInt64, extent: UInt64) -> Int64

extern fn linea_symlink_at(parent: Int32, at: UInt64, extent: UInt64, target: UInt64, target_extent: UInt64) -> Int64

// Create the directory `name` in the directory `parent` with permission bits
// `mode`, which the process umask narrows.
internal fn _make_dir_at[A: Allocator](name: Buffer[A], parent: Int32, mode: UInt64) -> Int64 {
    linea_make_dir_at(parent, address.raw(bytes_in(name, 0)), name.length(), mode)
}

// Remove the empty directory `name` from the directory `parent`.
internal fn _remove_dir_at[A: Allocator](name: Buffer[A], parent: Int32) -> Int64 {
    linea_remove_dir_at(parent, address.raw(bytes_in(name, 0)), name.length())
}

// Create the symbolic link `name` in the directory `parent`, naming the
// NUL-terminated `target`.
internal fn _symlink_at[A: Allocator, B: Allocator](name: Buffer[A], target: Buffer[B], parent: Int32) -> Int64 {
    linea_symlink_at(parent, address.raw(bytes_in(name, 0)), name.length(), address.raw(bytes_in(target, 0)), target.length())
}

// The runtime opens, reads and closes directory streams. An open writes the
// stream's handle to `stream`; every call answers zero, a count, or a negated
// errno.
extern fn linea_dir_open(at: UInt64, extent: UInt64, follow: UInt8, inout stream: UInt64) -> Int64

extern fn linea_dir_open_at(parent: UInt64, at: UInt64, extent: UInt64, follow: UInt8, inout stream: UInt64) -> Int64

extern fn linea_dir_next(stream: UInt64, at: UInt64, len: UInt64, follow: UInt8) -> Int64

extern fn linea_dir_reopen(anchor: UInt64, names_at: UInt64, names_extent: UInt64, identities_at: UInt64, identities_extent: UInt64, follow: UInt8, inout failed: UInt64, inout stream: UInt64) -> Int64

extern fn linea_dir_open_up(stream: UInt64, inout parent: UInt64) -> Int64

extern fn linea_dir_identity(stream: UInt64, inout device: UInt64, inout inode: UInt64, inout birth_seconds: UInt64, inout birth_nanoseconds: UInt64) -> Int64

extern fn linea_dir_close(stream: UInt64) -> Int64

// A directory record is six 64-bit words of metadata followed by the entry's
// name, for which it leaves 1024 bytes, more than a name on any supported
// system takes.
internal let dir_record_header: UInt64 = 48

internal let dir_record_bytes: UInt64 = 1072

// The runtime takes "follow a final symbolic link" as 1 and "do not" as 0.
fn follow_code(follow: Bool) -> UInt8 {
    if follow {
        1
    } else {
        0
    }
}

// A DirStream owns one directory the runtime holds open for reading. Its
// handle is valid from the open that made it to the close that consumes it.
// The runtime trusts the handle, so only `mem` builds one or reads its field;
// every module of the standard library is trusted to keep to that.
@linear
internal struct DirStream {
    handle: UInt64,
}

// Open the directory at the NUL-terminated `path`, following a final symbolic
// link only when `follow` is set, and answer the stream or the errno.
internal fn _open_dir[A: Allocator](path: Buffer[A], follow: Bool) -> Result[DirStream, Int32] {
    var handle: UInt64 = 0
    let answer = linea_dir_open(address.raw(bytes_in(path, 0)), path.length(), follow_code(follow), &handle)
    if answer < 0 {
        return .Err(Int32(-answer))
    }
    .Ok(.{ handle })
}

// Open the directory `name`, one NUL-terminated component, inside the
// directory `parent` reads.
internal fn _open_dir_at[A: Allocator](parent: DirStream, name: Buffer[A], follow: Bool) -> Result[DirStream, Int32] {
    var handle: UInt64 = 0
    let answer = linea_dir_open_at(parent.handle, address.raw(bytes_in(name, 0)), name.length(), follow_code(follow), &handle)
    if answer < 0 {
        return .Err(Int32(-answer))
    }
    .Ok(.{ handle })
}

// Write the next entry of `stream` to `record` and answer the length of its
// name, 0 once the directory is exhausted, or a negated errno. A record
// smaller than `dir_record_bytes` could not hold every name, so it traps.
internal fn _read_dir[A: Allocator](stream: DirStream, inout record: Buffer[A], follow: Bool) -> Int64 {
    if record.length() < dir_record_bytes {
        panic("a directory record buffer is smaller than a record")
    }
    linea_dir_next(stream.handle, address.raw(bytes_in(record, 0)), record.length(), follow_code(follow))
}

// Open each directory `names` names in turn, the first inside the one
// `anchor` reads and each later one inside the one before, and answer a stream
// over the last. `names` holds the names one after another, each ending in a
// zero byte, and `identities` a device and an inode number, two words at byte
// offsets 16 * i and 16 * i + 8, that the directory under name `i` must have,
// for every name but the last. A failure answers the errno and the index of
// the name that failed, or errno 0 and the index of a directory that has
// another identity.
internal fn _reopen_dir[A: Allocator, B: Allocator](anchor: DirStream, names: Buffer[A], identities: Buffer[B], follow: Bool) -> Result[DirStream, (Int32, UInt64)] {
    var failed: UInt64 = 0
    var handle: UInt64 = 0
    let answer = linea_dir_reopen(anchor.handle, address.raw(bytes_in(names, 0)), names.length(), address.raw(bytes_in(identities, 0)), identities.length(), follow_code(follow), &failed, &handle)
    if answer < 0 {
        return .Err((Int32(-answer), failed))
    }
    if answer > 0 {
        return .Err((0, failed))
    }
    .Ok(.{ handle })
}

// Open the parent of the directory `stream` reads, which ".." names and no
// link can stand in for, and answer the stream or the errno.
internal fn _open_dir_up(stream: DirStream) -> Result[DirStream, Int32] {
    var handle: UInt64 = 0
    let answer = linea_dir_open_up(stream.handle, &handle)
    if answer < 0 {
        return .Err(Int32(-answer))
    }
    .Ok(.{ handle })
}

impl DirStream {
    // Open the directory `name`, one NUL-terminated component, inside the
    // directory this stream reads.
    internal fn open_at[A: Allocator](self: Self, name: Buffer[A], follow: Bool) -> Result[DirStream, Int32] {
        _open_dir_at(self, name, follow)
    }

    // Write the next entry's record to `record` and answer its name's length,
    // 0 once the directory is exhausted, or a negated errno. A record smaller
    // than `dir_record_bytes` could not hold every name, so it traps.
    internal fn next[A: Allocator](self: Self, inout record: Buffer[A], follow: Bool) -> Int64 {
        _read_dir(self, &record, follow)
    }

    // Answer the device and inode numbers of the directory and its birth time,
    // as the seconds word and the nanoseconds word, or None for a file system
    // that keeps no birth time; or the errno. A device and an inode name a
    // directory only while something holds it open, since a directory made
    // after it is removed may be given its inode; the birth time tells the two
    // apart.
    internal fn lasting_identity(self: Self) -> Result[(UInt64, UInt64, Option[(UInt64, UInt64)]), Int32] {
        var device: UInt64 = 0
        var inode: UInt64 = 0
        var seconds: UInt64 = 0
        var nanoseconds: UInt64 = 0
        let answer = linea_dir_identity(self.handle, &device, &inode, &seconds, &nanoseconds)
        if answer < 0 {
            return .Err(Int32(-answer))
        }
        if answer == 1 {
            return .Ok((device, inode, .None))
        }
        .Ok((device, inode, .Some((seconds, nanoseconds))))
    }

    test "a directory's lasting identity is the same through two streams" {
        let path = _terminated(system(), "/".as_bytes()).unwrap()
        let first = _open_dir(path, follow: true).unwrap()
        let second = _open_dir(path, follow: true).unwrap()
        path.release()
        let one = first.lasting_identity().unwrap()
        let other = second.lasting_identity().unwrap()
        let first_closed = first.close()
        let second_closed = second.close()
        testing.assert(first_closed == 0 && second_closed == 0, "closing a stream failed")?
        let (device, inode, born) = one
        let (other_device, other_inode, other_born) = other
        testing.assert(device == other_device && inode == other_inode, "one directory had two device and inode numbers")?
        let same_birth = match born {
            Some((seconds, nanoseconds)) => match other_born {
                Some((other_seconds, other_nanoseconds)) => seconds == other_seconds && nanoseconds == other_nanoseconds,
                None => false,
            },
            None => other_born.is_none(),
        }
        testing.assert(same_birth, "one directory had two birth times")?
    }

    // Close the stream and answer zero or a negated errno.
    internal fn close(sink self: Self) -> Int64 {
        let DirStream { handle } = self
        linea_dir_close(handle)
    }
}

impl Release for DirStream {
    fn release(sink self: Self) {
        let _closed = self.close()
    }
}

test "a directory stream lists what a directory holds" {
    let root = _terminated(system(), "/".as_bytes()).unwrap()
    let opened = _open_dir(root, follow: true)
    root.release()
    let stream = opened.unwrap()
    defer var record = system().acquire(dir_record_bytes).unwrap()
    let first = stream.next(&record, follow: false)
    let identified = stream.lasting_identity().is_ok()
    testing.assert_eq(stream.close(), Int64(0), "closing a directory stream failed")?
    // The root directory of every supported system holds at least one entry,
    // and no name in it holds a slash (ASCII 47) or a NUL.
    testing.assert(first > 0, "the root directory listed nothing")?
    testing.assert(identified, "the root directory had no identity")?
    let name = record.as_slice().subspan(start: dir_record_header, count: UInt64(first)).unwrap()
    for index in 0..name.length() {
        testing.assert(name[index] != 47 && name[index] != 0, "a listed name held a slash or a NUL")?
    }
}

test "a directory stream opens a directory inside the one it reads" {
    let root = _terminated(system(), "/".as_bytes()).unwrap()
    let opened = _open_dir(root, follow: true)
    root.release()
    let stream = opened.unwrap()
    // Both supported systems keep `/usr` as a directory of its own.
    let name = _terminated(system(), "usr".as_bytes()).unwrap()
    let inner = stream.open_at(name, follow: false)
    name.release()
    let closed = stream.close()
    let child = inner.unwrap()
    testing.assert_eq(child.close(), Int64(0), "closing the inner stream failed")?
    testing.assert_eq(closed, Int64(0), "closing the outer stream failed")?
}

test "opening a missing directory answers its errno" {
    let path = _terminated(system(), "/no/such/linea/directory".as_bytes()).unwrap()
    let opened = _open_dir(path, follow: false)
    path.release()
    match opened {
        Ok(stream) => {
            stream.release()
            return testing.assert(false, "a missing directory opened")
        },
        Err(code) => testing.assert(code > 0, "a missing directory answered no errno")?,
    }
}

// The runtime starts a child process and answers its process ID or a negated
// errno, writing the parent's end of each piped stream to `stdin_fd`,
// `stdout_fd` and `stderr_fd`, or -1 for a stream that is no pipe. The
// argument and environment blocks are NUL-terminated strings; the runtime
// writes the pointer arrays the system takes into `table`.
extern fn linea_process_spawn(arguments_at: UInt64, arguments_extent: UInt64, argument_count: UInt64, environment_at: UInt64, environment_extent: UInt64, environment_count: UInt64, directory_at: UInt64, directory_extent: UInt64, table_at: UInt64, table_extent: UInt64, setup: UInt8, inout stdin_fd: Int32, inout stdout_fd: Int32, inout stderr_fd: Int32) -> Int64

// The runtime reads or writes the parent's nonblocking end of a child's pipe,
// waiting until it is ready, and returns the byte count or a negated errno.
extern fn linea_pipe_read(fd: Int32, at: UInt64, len: UInt64) -> Int64

extern fn linea_pipe_write(fd: Int32, at: UInt64, len: UInt64) -> Int64

// SpawnedPipes holds the parent's end of each of a new child's piped
// standard streams, or -1 for a stream that is no pipe.
@copyable
internal struct SpawnedPipes {
    stdin: Int32,
    stdout: Int32,
    stderr: Int32,
}

// Start a child process from the NUL-terminated strings in `arguments`, the
// program first, and in `environment` when `setup` says it replaces this
// process's environment, in the NUL-terminated `directory` or this process's
// own when it is empty, writing the system's pointer arrays into `table`.
// Answer the child's process ID or a negated errno, and the pipes' ends.
internal fn _spawn[A: Allocator](arguments: Slice[UInt8], argument_count: UInt64, environment: Slice[UInt8], environment_count: UInt64, directory: Slice[UInt8], inout table: Buffer[A], setup: UInt8) -> (Int64, SpawnedPipes) {
    var stdin: Int32 = -1
    var stdout: Int32 = -1
    var stderr: Int32 = -1
    let answer = linea_process_spawn(
        address.raw(slice_address(arguments)),
        arguments.length(),
        argument_count,
        address.raw(slice_address(environment)),
        environment.length(),
        environment_count,
        address.raw(slice_address(directory)),
        directory.length(),
        address.raw(bytes_in(table, 0)),
        table.length(),
        setup,
        &stdin,
        &stdout,
        &stderr,
    )
    (answer, .{ stdin, stdout, stderr })
}

// Read up to `count` bytes from the pipe `fd` into `buffer` at `offset`,
// checking the range first, and return the runtime's count or negated errno.
internal fn read_pipe[A: Allocator](inout buffer: Buffer[A], fd: Int32, offset: UInt64, count: UInt64) -> Int64 {
    if offset > buffer.length() || count > buffer.length() - offset {
        panic("buffer I/O range is out of bounds")
    }
    linea_pipe_read(fd, address.raw(bytes_in(buffer, offset)), count)
}

test trap "pipe reads reject a range past the buffer" -> Result[(), testing.Failure] {
    // The invalid descriptor -1 must never reach the runtime.
    let allocator = system()
    var bytes = allocator.acquire(1) else |_| {
        return testing.assert(false, "test buffer allocation failed")
    }
    let _result = read_pipe(&bytes, -1, 1, UInt64.max)
    bytes.release()
    .Ok(())
}

// Write `bytes` to the pipe `fd` and return the count written or a negated
// errno.
internal fn write_slice_pipe(bytes: Slice[UInt8], fd: Int32) -> Int64 {
    linea_pipe_write(fd, address.raw(slice_address(bytes)), bytes.length())
}

test "empty pipe requests do not access a descriptor" {
    // -1 is invalid, so success proves that a zero-byte request bypasses I/O.
    defer var bytes = system().acquire(1) else |_| {
        return testing.assert(false, "test buffer allocation failed")
    }
    testing.assert_eq(read_pipe(&bytes, -1, 1, 0), 0, "an empty pipe read reached the descriptor")?
    let empty = bytes.as_slice().subspan(start: 1, count: 0).unwrap()
    testing.assert_eq(write_slice_pipe(empty, -1), 0, "an empty pipe write reached the descriptor")?
    .Ok(())
}

// The runtime closes a descriptor and returns zero or a negated errno.
extern fn linea_close(fd: Int32) -> Int64

// Close `fd` and return zero or a negated errno.
internal fn _close_fd(fd: Int32) -> Int64 {
    linea_close(fd)
}

test "closing a descriptor the process lacks reports an error" {
    // -1 is never an open descriptor.
    testing.assert(_close_fd(-1) < 0, "closing an invalid descriptor succeeded")?
}

// Copy `bytes` into a buffer from `allocator` followed by one zero byte, the
// NUL-terminated form the runtime's path calls take.
internal fn _terminated[A: Allocator](allocator: A, bytes: Slice[UInt8]) -> Result[Buffer[A], Oom] where carries(.Ok: allocator) {
    if bytes.length() == UInt64.max {
        return .Err(.Exhausted)
    }
    var buffer = allocator.acquire(bytes.length() + 1)?
    for index in 0..bytes.length() {
        &buffer.store_byte(index, bytes[index])
    }
    &buffer.store_byte(bytes.length(), 0)
    .Ok(buffer)
}

test "a terminated copy ends with one zero byte" {
    defer let copied = _terminated(system(), "tea".as_bytes()).unwrap()
    testing.assert_eq(copied.length(), UInt64(4), "the copy did not add one byte")?
    testing.assert_eq(copied.load_byte(0), UInt8(116), "the copy changed the first byte, ASCII t")?
    testing.assert_eq(copied.load_byte(3), UInt8(0), "the copy did not end with a zero byte")?
}
