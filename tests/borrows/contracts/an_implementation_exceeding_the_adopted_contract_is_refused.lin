// An implementation without a clause is held to its trait's contract, so
// returning its own text breaks the promise that the greeting depends only on
// the request.
struct Request {
    name: Str,
}

trait Handler {
    fn handle(self: Self, request: Request) -> Str where carries(request)
}

struct Greeter {
    motd: Str,
}

impl Handler for Greeter {
    fn handle(self: Self, _request: Request) -> Str {
        copy(self.motd)
    }
}

fn main() -> UInt8 {
    let greeter = Greeter { motd = "hi" }
    let _greeting = greeter.handle(Request { name = "world" })
    0
}
