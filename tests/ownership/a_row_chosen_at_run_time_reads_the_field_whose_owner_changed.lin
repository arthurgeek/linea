// `cs[i][j].right` names the `right` field of some element, and one of
// them borrows the place `bump` changed.
struct Box { value: UInt64 }

struct Pair { left: borrow UInt64, right: borrow UInt64 }

fn bump(inout b: Box) {
    b.value = b.value + 1
}

fn main() -> UInt8 {
    var x = Box { value = 1 }
    let y = Box { value = 2 }
    let cs = [[Pair { left = borrow y.value, right = borrow y.value }, Pair { left = borrow y.value, right = borrow x.value }], [Pair { left = borrow y.value, right = borrow y.value }, Pair { left = borrow y.value, right = borrow y.value }]]
    bump(&x)
    var i: UInt64 = 1
    i = i - 1
    var j: UInt64 = 1
    j = j - 1
    UInt8(*cs[i][j].right)
}
