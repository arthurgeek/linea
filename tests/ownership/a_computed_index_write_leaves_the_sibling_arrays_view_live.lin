// Writing an element of `t.b` at an index computed at run time changes only
// `t.b`, so a view of the sibling array `t.a` is still good to use.
struct Two { a: [UInt8; 2], b: [UInt8; 2] }

fn main() -> UInt8 {
    var t = Two { a = [UInt8(1), 2], b = [UInt8(3), 4] }
    let s = t.a.as_slice()
    var i: UInt64 = 1
    i = i - 1
    t.b[i] = 9
    UInt8(s.length())
}
