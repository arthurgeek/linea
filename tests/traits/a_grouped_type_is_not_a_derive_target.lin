// The application `for` names is a type name or a tuple, as an
// implementation head is. `(UInt8)` groups a type and names none, so it is
// refused where it is written, and the refusal is the only report.
trait Marker {}

template impl Marker {}

@derive(Marker for (UInt8))
struct Box[T] { value: T }

fn main() -> UInt8 {
    let box: Box[UInt8] = .{ value = 0 }
    box.value
}
