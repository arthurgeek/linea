// `T: Fancy + Lookup[UInt8]` holds `Lookup` at `UInt64` through `Fancy` and
// at `UInt8` as written, and each implementation settles its own `Elem`. The
// order the bounds are written in, and whether a `where` writes one of them,
// changes nothing, and neither does reading the name as `Self.Elem` inside a
// trait whose supertraits require `Lookup` twice.
trait Lookup[I] {
    type Elem

    fn at(self: Self, i: I) -> Self.Elem where carries()
}

trait Fancy: Lookup[UInt64] {
    fn tag(self: Self) -> UInt8
}

trait _Both: Lookup[UInt8] + Fancy {
    fn pick(self: Self) -> Self.Elem
}

fn _either[T: Fancy + Lookup[UInt8]](sink v: T.Elem) -> T.Elem {
    v
}

fn _reversed[T: Lookup[UInt8] + Fancy](sink v: T.Elem) -> T.Elem {
    v
}

fn _written_apart[T](sink v: T.Elem) -> T.Elem where T: Lookup[UInt8], T: Fancy {
    v
}

fn main() -> UInt8 {
    0
}
