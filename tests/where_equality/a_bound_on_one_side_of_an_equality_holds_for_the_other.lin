// `A.Item: Discardable` is written on one side of the equality, and the body
// drops a `B.Item`: the two are one type, so the bound covers both.
fn skip_one[A: Iterator, B: Iterator](inout _first: A, inout second: B) where B.Item == A.Item, A.Item: Discardable {
    let _skipped = &second.next()
}

fn main() -> UInt8 {
    var first = UInt8(1)..3
    var second = UInt8(5)..9
    skip_one(&first, &second)
    var total: UInt8 = 0
    for x in second {
        total += x
    }
    total
}
