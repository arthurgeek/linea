// A count greater than the length names a place before the first element, and
// the difference is not a number the array has a place for. The clause is
// asked where the count is written, so nothing below it ever forms the
// address.
struct Grid {
    cells: [UInt8; 4],
}

impl Index[UInt64] for Grid {
    type Elem = UInt8

    proj at(inout self: Grid, i: UInt64) -> UInt8 {
        self.cells[^i]
    }
}

fn main() -> UInt8 {
    let g: Grid = .{ cells = [1, 2, 3, 4] }
    g[9]
}
