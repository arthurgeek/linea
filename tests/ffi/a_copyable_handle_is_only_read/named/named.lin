// A copy of a copyable handle names the same object, so C may only read it:
// closing or replacing the object through one copy would leave text read
// through another dangling.
@(opaque, copyable)
type Name = UInt64

extern fn named_open() -> Name

extern fn named_close(sink handle: Name)

extern fn named_replace(inout handle: Name)

pub fn first_length() -> UInt64 {
    var handle = named_open()
    let twin = copy(handle)
    named_replace(&handle)
    named_close(twin)
    0
}
