// A response lives in its request's arena, so a handler that fails after
// building one simply returns the error: the response is dropped with the
// arena, and nothing has to be released.
import std.http
import std.io

fn cached[P: Allocator](inout _: (), request: http.Request[P], inout _incoming: http.RequestBody[P]) -> Result[http.Response[P], http.Error[P]] where carries(request), borrows(_incoming), retains(_incoming: _incoming) {
    var response = http.text(request, "hello")?
    &response.set_header("Cache-Control", "no-store")?
    &response.add_header("Vary", "Accept")?
    return .Ok(response)
}

fn main() -> UInt8 {
    var router = http.Router.new()
    &router.route_raw("GET /", cached).unwrap()
    let exchange = http.TestExchange.open()
    var sent = exchange.request("GET", "/").unwrap()
    var nothing = {}
    let answered = match &sent.send_to(&router, &nothing) {
        Ok(response) => {
            let _printed = io.println("{response.status().code()} {response.header("Vary").unwrap_or("")}")
            0
        },
        Err(_) => 1,
    }
    sent.release()
    exchange.release()
    router.release()
    answered
}
