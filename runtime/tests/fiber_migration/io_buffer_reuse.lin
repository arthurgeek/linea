import std.io
import std.mem
import std.net
import std.session
import std.task
import std.time

use io.Reader
use net.Acceptor
use net.Accepted
use session.Chan
use session.End
use session.Recv
use session.Send

fn main() -> UInt8 {
    var listener = net.listen(net.loopback(0)).unwrap()
    var peer = net.connect(listener.local_address().unwrap()).unwrap()
    let Accepted { connection, address: _ } = &listener.accept().unwrap()
    listener.release()
    let execution = io.Loop.open(carriers: 2).unwrap()
    var passed = false
    let body = sink [sink connection, inout passed] |sink me: Chan[Send[Bool, Recv[UInt8, End]]]| {
        var stream = connection
        var original = mem.system().acquire(1).unwrap()
        &stream.set_deadline(time.Deadline.after(time.Duration.from_milliseconds(5000)))
        let first = task.current_carrier().unwrap()
        let expired = match &stream.read_some(&original, offset: 0, count: 1) {
            Ok(_) => false,
            Err(error) => error.category == .TimedOut,
        }
        if !expired || first == task.current_carrier().unwrap() {
            panic("the timed-out kernel read did not retire before migration")
        }
        time.sleep(time.Duration.from_nanoseconds(0))
        if first != task.current_carrier().unwrap() {
            panic("the retired read did not preserve its return continuation")
        }
        original.release()
        var replacement = mem.system().acquire(1).unwrap()
        &replacement.store_byte(0, 73)
        let ready = me.send(true)
        let (ack, done) = ready.recv()
        if ack != 1 || replacement.as_slice()[0] != 73 {
            panic("a retired read changed replacement storage")
        }
        &stream.set_timeouts(read_ms: 1000, write_ms: 0)
        let received = &stream.read_some(&replacement, offset: 0, count: 1).unwrap()
        if received != 1 || replacement.as_slice()[0] != 120 {
            panic("the retired read consumed the next operation's byte")
        }
        replacement.release()
        stream.release()
        passed = true
        done.close()
    }
    let running = task.prepare(body, on: execution).unwrap().start()
    let (ready, done) = running.recv()
    if !ready {
        panic("the read never relinquished its borrowed buffer")
    }
    let _sent = io.write_all(&peer, "x".as_bytes()).unwrap()
    done.send(UInt8(1)).close()
    peer.release()
    if passed {
        0
    } else {
        1
    }
}
