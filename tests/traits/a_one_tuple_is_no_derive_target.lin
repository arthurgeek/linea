// The application `for` names follows the rule an implementation head
// follows: `(UInt8,)` is refused where it is written, and the refusal is the
// only report.
trait Marker {}

template impl Marker {}

@derive(Marker for (UInt8,))
struct Box[T] { value: T }

fn main() -> UInt8 {
    let box: Box[UInt8] = .{ value = 0 }
    box.value
}
