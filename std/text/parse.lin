    fn parse(text: Str) -> Result[Int64, ParseError] where carries() {
        let value = decimal(text, true, UInt64(Int64.max), UInt64(Int64.max) + 1)?
        if value.negative {
            // The minimum's magnitude cannot be represented as a positive Int64.
            if value.magnitude == UInt64(Int64.max) + 1 {
                .Ok(Int64.min)
            } else {
                .Ok(0 - Int64(value.magnitude))
