// Phantom identity parameters beyond the first 32 positions impose no
// storage or cleanup obligation, even when their argument is linear.
struct Wide[P0, P1, P2, P3, P4, P5, P6, P7, P8, P9, P10, P11, P12, P13, P14, P15, P16, P17, P18, P19, P20, P21, P22, P23, P24, P25, P26, P27, P28, P29, P30, P31, phantom Tag] {
    f0: P0,
    f1: P1,
    f2: P2,
    f3: P3,
    f4: P4,
    f5: P5,
    f6: P6,
    f7: P7,
    f8: P8,
    f9: P9,
    f10: P10,
    f11: P11,
    f12: P12,
    f13: P13,
    f14: P14,
    f15: P15,
    f16: P16,
    f17: P17,
    f18: P18,
    f19: P19,
    f20: P20,
    f21: P21,
    f22: P22,
    f23: P23,
    f24: P24,
    f25: P25,
    f26: P26,
    f27: P27,
    f28: P28,
    f29: P29,
    f30: P30,
    f31: P31,
}

@linear
enum Tag { Live }

fn main() -> UInt8 {
    let wide: Wide[UInt8, UInt8, UInt8, UInt8, UInt8, UInt8, UInt8, UInt8, UInt8, UInt8, UInt8, UInt8, UInt8, UInt8, UInt8, UInt8, UInt8, UInt8, UInt8, UInt8, UInt8, UInt8, UInt8, UInt8, UInt8, UInt8, UInt8, UInt8, UInt8, UInt8, UInt8, UInt8, Tag] = .{
        f0 = 0,
        f1 = 1,
        f2 = 2,
        f3 = 3,
        f4 = 4,
        f5 = 5,
        f6 = 6,
        f7 = 7,
        f8 = 8,
        f9 = 9,
        f10 = 10,
        f11 = 11,
        f12 = 12,
        f13 = 13,
        f14 = 14,
        f15 = 15,
        f16 = 16,
        f17 = 17,
        f18 = 18,
        f19 = 19,
        f20 = 20,
        f21 = 21,
        f22 = 22,
        f23 = 23,
        f24 = 24,
        f25 = 25,
        f26 = 26,
        f27 = 27,
        f28 = 28,
        f29 = 29,
        f30 = 30,
        f31 = 31,
    }
    if wide.f31 == 31 {
        0
    } else {
        1
    }
}
