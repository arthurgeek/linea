// A derive attached to a generic type is one request for every application
// of it, so a derive `for Mark[UInt8]` would give that type a
// second implementation.
trait Score {
    fn score(self: Self) -> UInt8
}

template impl Score {
    fn score(_self: Self) -> UInt8 {
        1
    }
}

@derive(Score)
@derive(Score for Mark[UInt8])
struct Mark[T] {
    value: T,
}

fn main() -> UInt8 {
    let byte: Mark[UInt8] = .{ value = 3 }
    byte.score()
}
