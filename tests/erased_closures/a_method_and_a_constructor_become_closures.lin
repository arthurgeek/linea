import std.mem

struct Meter {}

impl Meter {
    fn doubled(value: UInt64) -> UInt64 {
        value * 2
    }
}

enum Reading {
    Value(UInt64),
}

// A member of an implementation and an enum constructor are functions too,
// so each becomes a closure where its signature fits.
fn main() -> Result[UInt8, mem.Oom] {
    let doubling: mem.Closure[fn(value: UInt64) -> UInt64, mem.SystemAllocator] = mem.Closure.open(Meter.doubled)?
    let four = doubling(2)
    doubling.release()
    let reading: mem.Closure[fn(sink value: UInt64) -> Reading, mem.SystemAllocator] = mem.Closure.open(Reading.Value)?
    let seven = match reading(7) {
        Value(value) => value,
    }
    reading.release()
    return .Ok(UInt8(four + seven))
}
