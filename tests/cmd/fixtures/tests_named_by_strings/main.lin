// Each test is named by a string, which `linea test` prints and `--filter`
// matches. A test leaves the module's names alone, so one may read like the
// function it tests.
import std.testing

struct Account {
    balance: UInt32,
}

fn withdraw(account: Account, amount: UInt32, fee: UInt32) -> Account {
    Account { balance = account.balance - amount - fee }
}

test "withdrawal deducts amount and fee" {
    let after = withdraw(Account { balance = 100 }, 30, 2)
    testing.assert_eq(after.balance, 68, "thirty and a fee of two leave sixty-eight")?
}

test "withdraw" {
    testing.assert_eq(withdraw(Account { balance = 5 }, 5, 0).balance, 0, "all of it leaves nothing")?
}

test "a fee is charged on every withdrawal" {
    let after = withdraw(Account { balance = 10 }, 0, 1)
    testing.assert_eq(after.balance, 9, "a withdrawal of nothing still costs the fee")?
}

fn main() -> UInt8 {
    if withdraw(Account { balance = 3 }, 1, 1).balance == 1 {
        0
    } else {
        1
    }
}
