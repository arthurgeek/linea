@linear
enum Token {
    One,
}

struct Tokens {
    marker: UInt8,
}

impl Iterator for Tokens {
    type Item = Token

    fn next(inout _self: Tokens) -> Option[Token] {
        .None
    }
}

fn discard_item[I: Iterator](_iterator: I, sink _item: I.Item)
where I.Item: Discardable {}

fn main() -> UInt8 {
    let tokens: Tokens = .{ marker = 0 }
    discard_item(tokens, .One)
    0
}
