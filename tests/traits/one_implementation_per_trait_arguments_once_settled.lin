// [T-Impl]. `Probe.Reading` is `UInt8`, so both implementations are
// `Weighs[UInt8]` for `Scale`. Writing the argument as the settled type's
// name does not make it another implementation.
trait Sensor {
    type Reading
}

struct Probe {}

impl Sensor for Probe {
    type Reading = UInt8
}

trait Weighs[U] {
    fn weigh(self: Self, value: U) -> UInt8
}

struct Scale {}

impl Weighs[Probe.Reading] for Scale {
    fn weigh(_self: Self, value: Probe.Reading) -> UInt8 {
        value
    }
}

impl Weighs[UInt8] for Scale {
    fn weigh(_self: Self, value: UInt8) -> UInt8 {
        value + 1
    }
}

fn main() -> UInt8 {
    let scale = Scale {}
    scale.weigh(3)
}
