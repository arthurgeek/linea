import std.io

pub fn print_str(value: Str) {
    match io.println(value) {
        Ok(_) => {},
        Err(_) => {},
    }
}

// Each line shows one piece of fixed text between brackets, so the spaces a
// piece carries stay visible.
pub fn print_piece(value: Str) {
    match io.println("[{value}]") {
        Ok(_) => {},
        Err(_) => {},
    }
}

trait Spelling {
    fn spell(value: Self)
}

template impl Spelling {
    fn spell(value: Self) {
        match read value {
            reflect.case => {
                print_str(reflect.case.name)
                for component in reflect.components {
                    print_piece(component.text_before)
                }
                print_piece(reflect.case.text_after)
            },
        }
    }
}

struct Point {
    x: UInt8,
    y: UInt8,
}

struct Origin {}

enum Shape {
    Dot,
    Circle(UInt8),
    Box(UInt8, UInt8),
}

type Count = UInt8

derive Spelling for Point

derive Spelling for Origin

derive Spelling for Shape

derive Spelling for Count

fn main() -> UInt8 {
    let point: Point = .{ x = 1, y = 2 }
    Spelling.spell(point)
    let origin: Origin = .{}
    Spelling.spell(origin)
    Spelling.spell(Shape.Dot)
    Spelling.spell(Shape.Circle(3))
    Spelling.spell(Shape.Box(4, 5))
    Spelling.spell(Count(6))
    0
}
