// A trait is implemented once for a type. Two implementations whose heads
// name the same application are one implementation written twice.
struct Crate[T] {
    item: T,
}

trait Weigh {
    fn weigh(self: Self) -> UInt8
}

impl Weigh for Crate[UInt8] {
    fn weigh(self: Self) -> UInt8 {
        self.item
    }
}

impl Weigh for Crate[UInt8] {
    fn weigh(self: Self) -> UInt8 {
        self.item + 1
    }
}

fn main() -> UInt8 {
    let small: Crate[UInt8] = .{ item = 4 }
    small.weigh()
}
