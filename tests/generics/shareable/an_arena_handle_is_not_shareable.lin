import std.mem

use mem.Lender

fn share[T: Shareable](_value: T) -> UInt64 {
    1
}

// A desk hands out storage through the handle it holds.
struct Desk {
    handle: mem.Handle,
    seats: UInt64,
}

fn main() -> UInt8 {
    let arena = mem.Arena.open(mem.system(), 64)
    let handle = arena.handle()
    let empty: Vec[UInt8, mem.Handle] = Vec.new_in(arena.handle())
    let desk = Desk { handle = arena.handle(), seats = 4 }
    let counted = share(handle) + share(empty) + share(desk) + share(borrow arena)
    arena.release()
    UInt8(counted)
}
