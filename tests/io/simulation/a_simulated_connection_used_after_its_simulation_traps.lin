import std.io
import std.net

// A connection made inside a simulation names an entry of the simulation's
// own table. Returned from `run`, it names nothing the system knows, so a
// write to it traps.
fn main() -> UInt8 {
    var sim = io.Simulation.open(seed: 1).unwrap()
    let made = sim.run(
        |inout _world| {
            let listener = net.listen(net.loopback(80)).unwrap()
            let client = net.connect(net.loopback(80)).unwrap()
            listener.close().unwrap()
            client
        },
    )
    sim.close()
    var client = made
    let _sent = io.write_all(&client, "hello".as_bytes())
    client.close().unwrap()
    0
}
