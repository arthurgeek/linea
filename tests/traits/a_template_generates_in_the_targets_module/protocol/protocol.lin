pub trait Label {
    fn label(self: Self) -> UInt8
}

pub fn seven() -> UInt8 {
    7
}

template impl Label {
    fn label(self: Self) -> UInt8 {
        match read self {
            reflect.case => {
                var total: UInt8 = seven()
                for component in reflect.components {
                    total = total + component.of(self)
                }
                total
            },
        }
    }
}
