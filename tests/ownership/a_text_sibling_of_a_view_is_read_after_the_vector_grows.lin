import std.mem

// A `Str` beside a view of a vector depends on no vector: growing the vector
// ends the view and the text is still read.
struct Holder { view: mem.Slice[UInt64], name: Str }

fn main() -> UInt8 {
    var a = Vec.filled(2, UInt64(7)) else |_| {
        return 1
    }
    let h = Holder { view = a.as_slice(), name = "abc" }
    let n = h.view.length()
    Vec.push(&a, 1).unwrap()
    let m = h.name.length()
    a.release()
    UInt8(n + m)
}
