// An equality in a `where` clause is printed with one space either side of
// `==`, beside the bounds and contracts the clause also holds.
fn last_second[L, R: Discardable, S: Sequence](sink pairs: S) -> Option[R] where S.Iter.Item==(L, R),L: Copyable,S.Iter: Discardable {
    var last: Option[R] = .None
    for pair in pairs {
        let (_first, second) = pair
        last = .Some(second)
    }
    last
}

fn main() -> UInt8 {
    match last_second((UInt16(1)..4).zip(UInt8(10)..13)) {
        Some(second) => second,
        None => 0,
    }
}
