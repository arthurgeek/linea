// `continue` asks the walk for its next element rather than leaving it, so the
// elements after the one it skipped are still yielded.
fn main() -> UInt8 {
    let xs: Range[UInt8] = 0..6
    var total: UInt8 = 0
    for x in xs {
        if x == 3 {
            continue
        }
        total += x
    }
    total
}
