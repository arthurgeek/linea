test fn uint64_to_int64_preserves_exact_values_and_checks_bounds() {
    let lower = Int64.try_from(UInt64(0))
    testing.assert_eq(lower, Option.Some(Int64(0)), "lower accepted value changed")?
    let interior = Int64.try_from(UInt64(1))
    testing.assert_eq(interior, Option.Some(Int64(1)), "interior accepted value changed")?
    let upper = Int64.try_from(UInt64(9223372036854775807))
    testing.assert_eq(upper, Option.Some(Int64(9223372036854775807)), "upper accepted value changed")?
    let above_input: UInt64 = 9223372036854775808
    let above = Int64.try_from(above_input)
    match above {
        Some(_) => testing.assert(false, "above out-of-range value was accepted")?,
        None => {},
    }
    let source_max = Int64.try_from(UInt64.max)
    match source_max {
        Some(_) => testing.assert(false, "source_max out-of-range value was accepted")?,
        None => {},
    }
    .Ok(())
}

