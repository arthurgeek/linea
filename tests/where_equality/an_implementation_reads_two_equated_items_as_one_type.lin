// `where B.Item == A.Item` makes the two sequences' items one type inside the
// implementation, so the second half's items are returned as the first's.
struct Chain[A, B] {
    first: A,
    second: B,
    first_done: Bool,
}

impl[A: Iterator, B: Iterator] Iterator for Chain[A, B] where B.Item == A.Item {
    type Item = A.Item

    fn next(inout self: Self) -> Option[A.Item] where carries(.Some: self) {
        if !self.first_done {
            match &self.first.next() {
                Some(x) => return .Some(x),
                None => self.first_done = true,
            }
        }
        &self.second.next()
    }
}

fn main() -> UInt8 {
    let joined: Chain[Range[UInt8], Range[UInt8]] = .{ first = UInt8(1)..3, second = UInt8(5)..7, first_done = false }
    var total: UInt8 = 0
    for x in joined {
        total += x
    }
    total
}
