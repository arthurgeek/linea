// A pattern's head names a type, and a name is unique only within a module.
// This file declares its own `Point` with one field; `a` declares another with
// two, and `a.make()` returns that one.
//
// Compared by spelling, the head `Point` here matched a value of `a.Point`,
// so the arm took apart a type this module never named -- and the `let` form
// of the same two modules was refused, because that path resolves the head
// instead. One construct, two answers about one program.
import a

struct Point {
    z: UInt8,
}

fn local() -> Point {
    .{ z = 7 }
}

fn main() -> UInt8 {
    let _p = local()
    match a.make() {
        Point { x: c, y: d } => c + d,
    }
}
