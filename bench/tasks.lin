// Time `task.map` and `task.all` over cheap items against fixed chunks, the
// items cut into eight equal shares and each share mapped by a task of its
// own started with `task.start`, and time a lazy map that hands each item to
// a worker and takes its result back. Every round times the three designs in
// a rotating order, so a change in the machine's load reaches all three. The
// figures are medians over the rounds, and the ratios are of the medians, in
// thousandths. Each measurement runs twice: on the system Io, where every
// task is a thread of its own, and inside a task on a loop of eight carriers,
// and of as many carriers as the machine has processors where that differs,
// where every task is a fiber of that loop. A last measurement times session
// round trips: two tasks pass a number back and forth, so each round trip is
// two handoffs. On a loop the two tasks may share a carrier or not, and a
// round trip between carriers waits for the kernel to wake one, so its
// minimum and median can lie far apart.
import std.bench
import std.env
import std.io
import std.mem
import std.session
import std.task
import std.time

use io.println
use session.Chan
use session.Choose
use session.End
use session.Offer
use session.Recv
use session.Send

// The cheap item: the work is so small that a design's cost is what it
// spends starting, feeding and joining its tasks.
fn plus_one(sink n: UInt64) -> UInt64 {
    n + 1
}

// The numbers below `count`, in order.
fn numbers(count: UInt64) -> mem.Vec[UInt64] {
    var items: mem.Vec[UInt64] = mem.Vec.new()
    &items.reserve(count).unwrap()
    for n in 0..count {
        &items.push(n).unwrap()
    }
    items
}

// Map `items` through `plus_one` on `workers` tasks, each holding an equal
// share from its start, and collect the shares in order.
fn fixed_chunks(sink items: mem.Vec[UInt64], workers: UInt64) -> mem.Vec[UInt64] {
    let total = items.length()
    let base = total / workers
    let remainder = total % workers
    var handles: mem.Vec[Chan[session.Recv[mem.Vec[UInt64], End]]] = mem.Vec.new()
    var drained = items.drain()
    for at in 0..workers {
        let length = base + (if at < remainder {
            UInt64(1)
        } else {
            UInt64(0)
        })
        var chunk: mem.Vec[UInt64] = mem.Vec.new()
        &chunk.reserve(length).unwrap()
        for _ in 0..length {
            match &drained.next() {
                Some(item) => &chunk.push(item).unwrap(),
                None => break,
            }
        }
        let body = sink [sink chunk] |sink me: Chan[Send[mem.Vec[UInt64], End]]| {
            var results: mem.Vec[UInt64] = mem.Vec.new()
            &results.reserve(chunk.length()).unwrap()
            var pending = chunk.drain()
            for item in &pending {
                &results.push(plus_one(item)).unwrap()
            }
            pending.finish().unwrap()
            me.send(results).close()
        }
        &handles.push(task.prepare(body).unwrap().start().detach()).unwrap()
    }
    drained.finish().unwrap()
    var results: mem.Vec[UInt64] = mem.Vec.new()
    &results.reserve(total).unwrap()
    var pending = handles.drain()
    for handle in &pending {
        let (part, done) = handle.recv()
        done.close()
        var moving = part.drain()
        for result in &moving {
            &results.push(result).unwrap()
        }
        moving.finish().unwrap()
    }
    pending.finish().unwrap()
    results
}

// `count` jobs that each answer 1, for `task.all`.
fn jobs(count: UInt64) -> mem.Vec[fn() -> UInt64] {
    var all: mem.Vec[fn() -> UInt64] = mem.Vec.new()
    &all.reserve(count).unwrap()
    for _ in 0..count {
        &all.push(one).unwrap()
    }
    all
}

// The cheap job.
fn one() -> UInt64 {
    1
}

@derive(Display, Release, From[io.IoError], From[mem.Oom])
enum BenchError {
    Output(io.IoError),
    Allocation(mem.Oom),
}

// Print the raw samples before sorting their storage for order statistics.
fn summary(name: Str, inout samples: mem.Vec[UInt64]) -> Result[UInt64, BenchError] {
    for round in UInt64(0)..samples.length() {
        println("{name},{round},{samples[round]} ns")?
    }
    let stats = bench.summarize(&samples).unwrap()
    println("  {name}: min {stats.minimum} ns, median {stats.median} ns, p90 {stats.p90} ns, max {stats.maximum} ns")?
    .Ok(stats.median)
}

// Time the three designs over `count` items, `rounds` times each.
fn measure(count: UInt64, rounds: UInt64) -> Result[(), BenchError] {
    defer var fixed: mem.Vec[UInt64] = mem.Vec.new()
    defer var mapped: mem.Vec[UInt64] = mem.Vec.new()
    defer var gathered: mem.Vec[UInt64] = mem.Vec.new()
    var check = UInt64(0)
    let schedule = bench.Schedule.new(warmups: 0, repetitions: 1, samples: rounds, cases: 3).unwrap()
    for round in 0..schedule.rounds() {
        for turn in 0..schedule.cases() {
            let which = schedule.case_at(round, turn).unwrap()
            let items = numbers(count)
            if which == 0 {
                let (elapsed, results) = bench.measure_once(sink [sink items] || fixed_chunks(items, 8))
                check += results[count - 1]
                results.release()
                &fixed.push(elapsed).settled()?
            } else if which == 1 {
                let (elapsed, results) = bench.measure_once(sink [sink items] || task.map(.Threads(8), items, plus_one))
                check += results[count - 1]
                results.release()
                &mapped.push(elapsed).settled()?
            } else {
                items.release()
                let all_jobs = jobs(count)
                let (elapsed, results) = bench.measure_once(sink [sink all_jobs] || -> mem.Vec[UInt64] task.all(.Threads(8), all_jobs))
                check += results[count - 1]
                results.release()
                &gathered.push(elapsed).settled()?
            }
        }
    }
    println("{count} items, {rounds} rounds (check {check}):")?
    let base = summary("fixed chunks", &fixed)?
    let map = summary("task.map", &mapped)?
    let all = summary("task.all", &gathered)?
    println("  ratio of medians: map {map * 1000 / base} / 1000, all {all * 1000 / base} / 1000")?
    .Ok(())
}

// Walk a lazy map over `count` items on two workers: every item is one
// handoff to a worker and one answer back.
fn handoffs(count: UInt64, rounds: UInt64) -> Result[(), BenchError] {
    defer var times: mem.Vec[UInt64] = mem.Vec.new()
    var total = UInt64(0)
    for _ in 0..rounds {
        let started = time.Instant.now()
        defer var walked = task.lazy_map(.Threads(2), UInt64(0)..count, plus_one)
        for result in &walked {
            total += result
        }
        &times.push((time.Instant.now().since(started).nanoseconds()) / count).settled()?
    }
    println("lazy_map at max 2, {count} items (check {total}), ns per item:")?
    let _median = summary("lazy_map", &times)?
    .Ok(())
}

// An echo receives a number and sends it back one larger, as often as its
// peer asks, until the peer stops.
struct Echo {}

impl Protocol for Echo {
    type Dual = Pinger
    type Step = Offer[Recv[UInt64, Send[UInt64, Echo]], End]
}

// The peer of an echo: it either sends a number and receives the answer, or
// stops.
struct Pinger {}

impl Protocol for Pinger {
    type Dual = Echo
    type Step = Choose[Send[UInt64, Recv[UInt64, Pinger]], End]
}

// Answer every number the peer of `me` sends, one larger, until it stops.
fn echo[H](sink me: Chan[Echo, H]) {
    match me.enter().offer() {
        Left(asked) => {
            let (n, answering) = asked.recv()
            echo(answering.send(n + 1))
        },
        Right(done) => done.close(),
    }
}

// Send `left` numbers to the echo at `peer`, each once the one before has
// been answered, and answer the session to go on with.
fn ping[H](sink peer: Chan[Pinger, H], left: UInt64) -> Chan[Pinger, H] {
    if left == 0 {
        return peer
    }
    let (n, next) = peer.enter().choose_left().send(left).recv()
    if n != left + 1 {
        panic("the echo answered another number")
    }
    ping(next, left - 1)
}

// Time `count` round trips between a task and an echo it starts: every round
// trip is two handoffs, one each way.
fn round_trips(count: UInt64, rounds: UInt64) -> Result[(), BenchError] {
    defer var times: mem.Vec[UInt64] = mem.Vec.new()
    for _ in 0..rounds {
        let body = sink [] |sink me: Chan[Echo]| echo(me)
        let peer = task.start(body).unwrap()
        let started = time.Instant.now()
        let after = ping(peer, count)
        let elapsed = time.Instant.now().since(started).nanoseconds() / count
        after.enter().choose_right().close()
        &times.push(elapsed).settled()?
    }
    println("session round trip, {count} in a row, ns per round trip:")?
    let _median = summary("round trip", &times)?
    .Ok(())
}

// Every measurement, on whatever Io the caller runs on.
fn measure_all() -> Result[(), BenchError] {
    measure(10000, 200)?
    measure(100000, 60)?
    handoffs(20000, 7)?
    round_trips(20000, 7)
}

// Every measurement inside a task started on a loop of `carriers` carriers,
// so the tasks each design starts are fibers of that loop.
fn measure_on_loop(carriers: UInt64) -> Result[(), BenchError] {
    let looped = io.Loop.open(carriers: carriers)?
    println("on a loop of {carriers} carriers:")?
    let body = sink [] |sink me: Chan[Send[Result[(), BenchError], End]]| me.send(measure_all()).close()
    let (measured, done) = task.start(body, on: looped).unwrap().recv()
    done.close()
    measured
}

fn main() -> Result[UInt8, BenchError] {
    println("on the system Io, a thread per task:")?
    measure_all()?
    measure_on_loop(8)?
    let processors = env.available_parallelism()
    if processors != 8 {
        measure_on_loop(processors)?
    }
    .Ok(0)
}
