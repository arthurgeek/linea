import std.mem

fn main() -> UInt8 {
    var values: Vec[UInt64, mem.SystemAllocator] = Vec.new()
    match Vec.push(&values, 7) { Ok(_) => {}, Err(_) => panic("push failed") }
    for read value in values {
        match Vec.push(&values, 8) { Ok(_) => {}, Err(_) => panic("push failed") }
        if value != 7 {
            panic("changed value")
        }
    }
    values.release()
    0
}
