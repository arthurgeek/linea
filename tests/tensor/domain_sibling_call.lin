import std.mem
import std.tensor

use tensor.AllocationDomain

struct Local {}

impl tensor.AllocationDomain for Local {
    type Store = tensor.Cpu[mem.SystemAllocator]

    fn copy_slice(_self: Self, values: mem.Slice[Float32]) -> Result[tensor.Cpu[mem.SystemAllocator], tensor.CpuError] where carries() {
        mem.system().copy_slice(values)
    }

    fn copy_rows[let rows: UInt64, let columns: UInt64](self: Self, values: [[Float32; columns]; rows]) -> Result[tensor.Cpu[mem.SystemAllocator], tensor.CpuError] where carries() {
        if rows == 1 {
            return self.copy_slice(values[0].as_slice())
        }
        mem.system().copy_rows(values)
    }
}

fn main() -> UInt8 {
    let local: Local = .{}
    defer let matrix = tensor.matrix_in(local, [[Float32(4.0), 8.0]]).unwrap()
    if matrix.values()[0] == 4.0 && matrix.values()[1] == 8.0 {
        0
    } else {
        1
    }
}
