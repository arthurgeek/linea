// A generic function named with its type argument is one function type, and
// reaches the implementation written for that type: `low[UInt8]` the first
// and `low[UInt16]` the second.
trait Run {
    fn run(self: Self) -> UInt8
}

impl Run for fn(input: UInt8) -> UInt8 {
    fn run(self: Self) -> UInt8 {
        self(4)
    }
}

impl Run for fn(input: UInt16) -> UInt8 {
    fn run(self: Self) -> UInt8 {
        self(304)
    }
}

fn low[T: Integer](input: T) -> UInt8 {
    UInt8(input % 10)
}

fn go[H: Run](handler: H) -> UInt8 {
    handler.run()
}

fn main() -> UInt8 {
    go(low[UInt8]) * 10 + go(low[UInt16])
}
