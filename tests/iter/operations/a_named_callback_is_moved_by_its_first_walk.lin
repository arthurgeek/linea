import std.io

// `any` consumes its predicate, so the first walk moves `heavy` and a second
// walk cannot pass it again.
fn main() -> Result[UInt8, io.IoError] {
    let limit: UInt64 = 4
    let heavy = [limit] |sink weight: UInt64| weight > limit
    let first = (UInt64(1)..10).any(heavy)
    let second = (UInt64(1)..3).any(heavy)
    io.println("{first} {second}")?
    .Ok(0)
}
