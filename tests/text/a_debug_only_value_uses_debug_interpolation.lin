// `:?` needs only Debug from the held value. The interpolation itself supplies
// Display to println, so the value does not need a second representation.
import std.io

use io.IoError
use io.println

@copyable
struct DebugOnly {}

impl Debug for DebugOnly {
    fn debug[W: Writer](_self: DebugOnly, inout w: W) -> Result[(), W.Error] where carries(.Err: w) {
        Writer.write_str(&w, "debug-only")
    }
}

fn main() -> Result[UInt8, IoError] {
    let value: DebugOnly = .{}
    println("{value:?}")?
    return .Ok(0)
}
