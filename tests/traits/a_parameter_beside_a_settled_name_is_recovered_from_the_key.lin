// `Probe.Reading` is `UInt8`, so the trait argument is `Two[T, UInt8]`, and
// `T` is its first argument: every parameter of the implementation is
// recovered from the key. A settled name written beside a parameter does not
// hide the parameter.
trait Sensor {
    type Reading
}

struct Probe {}

impl Sensor for Probe {
    type Reading = UInt8
}

struct Two[A, B] {
    first: A,
    second: B,
}

trait Weighs[U] {
    fn weigh(self: Self, value: U) -> UInt8
}

struct Scale {}

impl[T] Weighs[Two[T, Probe.Reading]] for Scale {
    fn weigh(_self: Self, value: Two[T, Probe.Reading]) -> UInt8 {
        value.second + 2
    }
}

fn main() -> UInt8 {
    let scale = Scale {}
    let pair: Two[Bool, UInt8] = .{ first = true, second = 5 }
    scale.weigh(pair)
}
