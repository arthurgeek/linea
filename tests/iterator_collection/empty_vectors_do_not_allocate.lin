import std.mem

use mem.Owner

fn main() -> UInt8 {
    let arena = mem.Arena.open(mem.system(), 0)
    defer arena.release()
    var values: Vec[UInt64, mem.Handle[mem.SystemAllocator]] = Vec.new_in(arena.handle())
    let empty = values.length() == 0 && values.as_slice().length() == 0
    let unchanged = Vec.reserve(&values, 0).is_ok()
    values.release()
    if empty && unchanged {
        0
    } else {
        1
    }
}
