// Each `Holder[Tk+1].Item` is the linear `Ticket` only when `Tk+1` can be
// discarded, down a chain of eighty types. `T80` can, so `T79` holds a
// `Ticket`, so `Holder[T79]` has no `Item`, so `T78` holds poison and can be
// discarded, and so on: every other link is refused, in either order.
trait Counter {
    type Item
}

@linear
struct Ticket {
    number: UInt8,
}

struct Holder[T] {
    t: T,
}

impl[T: Discardable] Counter for Holder[T] {
    type Item = Ticket
}

