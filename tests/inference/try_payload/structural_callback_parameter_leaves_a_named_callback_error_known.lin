enum Failure { Code(UInt8) }

enum Other { Code(UInt8) }

fn other(sink code: UInt8) -> Other {
    .Code(code)
}

fn attempt[A: Discardable](make: fn(sink code: UInt8) -> A) -> Result[UInt8, A] {
    .Err(make(3))
}

fn run() -> Result[UInt8, Failure] {
    let value = attempt(other)?
    return .Ok(value)
}

fn main() -> UInt8 {
    match run() { Ok(value) => value, Err(_) => 1 }
}
