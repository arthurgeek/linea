// One implementation per trait, trait arguments and head. A family written
// twice is refused where the second is written, not where a call reaches it,
// and the report names the head.
trait Show {
    fn show(self: Self) -> UInt8
}

struct Holder[T] {
    v: T,
}

impl[T] Show for Holder[T] {
    fn show(self: Holder[T]) -> UInt8 {
        1
    }
}

impl[T] Show for Holder[T] {
    fn show(self: Holder[T]) -> UInt8 {
        2
    }
}

fn main() -> UInt8 {
    0
}
