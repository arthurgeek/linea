fn main() -> UInt8 {
    var number: UInt64 = 41
    var repeated = Vec.filled(count: 3, value: borrow number).unwrap()
    number = 9
    let answer = *repeated[1]
    for _index in UInt64(0)..3 {
        let _observation = Vec.remove(&repeated, 0).unwrap()
    }
    match repeated.finish() {
        Ok(_) => {},
        Err(_returned) => panic("repeated observations remain"),
    }
    return UInt8(answer)
}
