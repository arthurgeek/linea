test fn uint64_parse_checks_limits() {
    let minimum = "0".parse[UInt64]()
    match minimum { Ok(value) => testing.assert_eq(value, UInt64.min, "minimum changed")?, Err(_) => testing.assert(false, "minimum was rejected")? }
    let maximum = "+18446744073709551615".parse[UInt64]()
    match maximum { Ok(value) => testing.assert_eq(value, UInt64.max, "maximum changed")?, Err(_) => testing.assert(false, "maximum was rejected")? }
    let over = "18446744073709551616".parse[UInt64]()
    testing.assert_eq(over, .Err(.Overflow(19)), "overflow did not report its digit")?
    .Ok(())
}

// A Point is a grid coordinate spelled "x,y" in decimal text. Implementing
// Parse lets a program's own type join every built-in numeric type behind one
// `.parse()`.
@(copyable, derive(Equatable, Debug))
struct Point {
    x: Int32,
    y: Int32,
}

impl Parse for Point {
    fn parse(text: Str) -> Result[Point, ParseError] where carries() {
        let (left, right) = text.split_once(",") else {
            return .Err(.Syntax(text.length()))
        }
        let x: Int32 = left.parse()?
        let y: Int32 = right.parse()?
        .Ok(.{ x, y })
    }
}

test fn a_user_type_implements_parse_by_splitting_once() {
    let origin: Point = "0,0".parse().unwrap()
    testing.assert_eq(origin, Point { x = 0, y = 0 }, "the coordinate's own Parse implementation lost its fields")?
    let east: Point = "12,-7".parse().unwrap()
    testing.assert_eq(east, Point { x = 12, y = -7 }, "the coordinate's own Parse implementation misread its fields")?
    let missing_comma = "12".parse[Point]()
    testing.assert(missing_comma.is_err(), "a coordinate without a comma was accepted")?
    .Ok(())
}
