import std.json
import std.mem

use mem.Owner

fn main() -> UInt8 {
    let first = mem.Arena.open(mem.system(), 4096)
    let second = mem.Arena.open(mem.system(), 4096)
    var document = json.Value.array(first.handle())
    let child = json.Value.string(second.handle(), "tea").unwrap()
    json.Value.append(&document, child).unwrap()
    let removed = json.Value.remove_element(&document, 0).unwrap().unwrap()
    let found = removed.as_str().unwrap() == "tea"
    removed.release()
    document.release()
    second.release()
    first.release()
    if found {
        0
    } else {
        1
    }
}
