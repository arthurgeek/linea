trait Measure[T] {
    fn count_as(self: Self, _x: T) -> UInt8
}

struct Wrap[I] { value: I, stamp: UInt8 }

impl[I: Iterator] Measure[UInt8] for Wrap[I] where I.Item == UInt8 {
    fn count_as(self: Self, _x: UInt8) -> UInt8 {
        self.stamp
    }
}

impl[I: Iterator] Measure[UInt16] for Wrap[I] where I.Item == UInt16 {
    fn count_as(self: Self, _x: UInt16) -> UInt8 {
        self.stamp
    }
}

fn count_wide[I: Iterator](wrap: Wrap[I]) -> UInt8 where I.Item == UInt16 {
    let operation: fn(self: Wrap[I], _x: UInt16) -> UInt8 = Measure.count_as
    operation(wrap, UInt16(1))
}

fn main() -> UInt8 {
    let small: Wrap[Range[UInt8]] = .{ value = UInt8(1)..3, stamp = 3 }
    let wide: Wrap[Range[UInt16]] = .{ value = UInt16(1)..3, stamp = 4 }
    small.count_as(UInt8(1)) + wide.count_as(UInt16(1)) + count_wide(wide)
}
