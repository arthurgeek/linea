// Fill a letter template for every order in a JSON order list.
import std.fmt
import std.io
import std.json
import std.mem
import std.testing

// The letter is a multi-line literal: each `\\` line holds the rest of its
// line exactly as written, and the lines are joined with line breaks. An empty
// `\\` line is an empty line of the letter. Its `{name}` placeholders are for
// this program to fill, not Linea interpolations.
let letter_form =
    \\Dear {name},
    \\
    \\Your {count} {item} will ship to {city} on Monday.
    \\
    \\Kind regards,
    \\The stationery shop

// Quotes are text in a `\\` line too, so the JSON reads as it would in a file.
let orders =
    \\[
    \\  {"name": "Ada", "count": 3, "item": "notebooks", "city": "London"},
    \\  {"name": "Grace", "count": 1, "item": "stapler", "city": "Arlington"}
    \\]

// `Order` is one order in the list. `json.Decode[A]` builds each order in
// the list and refuses one with a field missing, a field of the wrong kind,
// or a field `Order` does not have. Its text is allocated with `A`, and
// `Release` frees it.
@derive(Release, json.Decode[A])
struct Order[A: Allocator = mem.SystemAllocator] {
    name: String[A],
    count: UInt64,
    item: String[A],
    city: String[A],
}

// Orders decode into memory from `mem.system()`.
alias OrderList = Vec[Order]

// Release frees the path a decode error owns. `?` wraps another function's
// error in a `LetterError` through the derived `From` implementations: a decode
// error in `Orders`, a refused allocation in `Allocation`, and a failed print in
// `Output`.
@derive(Release, From[json.DecodeError[mem.SystemAllocator]], From[mem.Oom], From[io.IoError])
enum LetterError {
    // `Orders` holds why the order list did not decode, such as
    // `wrong kind of value at $[1]["count"]`.
    Orders(json.DecodeError),
    Unclosed,
    // `Missing(field)` reports a placeholder that names no field of an order.
    Missing(Str),
    Allocation(mem.Oom),
    Output(io.IoError),
}

// Display writes the error as a sentence, which is how `main` reports it. A
// decode error owns its path, so `{error}` borrows it while the sentence is
// written rather than copying it.
impl Display for LetterError {
    fn fmt[W: Writer](self: Self, inout w: W) -> Result[(), W.Error] {
        match read self {
            Orders(error) => "the orders are not a list of orders: {error}".fmt(&w),
            Unclosed => "a placeholder in the form has no closing brace".fmt(&w),
            Missing(field) => "the form names `{field}`, which an order does not have".fmt(&w),
            Allocation(_) => "out of memory".fmt(&w),
            Output(error) => "cannot print a letter: {error}".fmt(&w),
        }
    }
}

// Copy the form into a new letter from the system allocator, replacing each
// `{field}` with that field of the order. `carries(.Err: form)` states that an
// error's field name borrows from the form.
fn fill[A: Allocator](form: Str, order: Order[A]) -> Result[String[mem.SystemAllocator], LetterError] where carries(.Err: form) {
    // `defer var` frees the partial letter when an error returns early.
    // Returning the finished letter hands it to the caller, so it is not freed
    // then.
    defer var letter: String[mem.SystemAllocator] = String.new()
    // `split_once` cuts the rest of the form at its next `{`, and then that
    // placeholder at its `}`, so each pass copies the text before a
    // placeholder and fills it in.
    var rest = copy(form)
    loop {
        let (before, opened) = rest.split_once(r"{") else {
            break
        }
        let (field, after) = opened.split_once(r"}") else {
            return .Err(.Unclosed)
        }
        &letter.append(before)?
        write_field(&letter, order, field)?
        rest = after
    }
    &letter.append(rest)?
    .Ok(letter)
}

// Write the field of the order that a placeholder names: text as it reads,
// and the count as its digits. `sink field` lets an error keep the name.
fn write_field[A: Allocator, B: Allocator](inout letter: String[B], order: Order[A], sink field: Str) -> Result[(), LetterError] where carries(.Err: field) {
    if field == "name" {
        &letter.append(order.name.view())?
    } else if field == "item" {
        &letter.append(order.item.view())?
    } else if field == "city" {
        &letter.append(order.city.view())?
    } else if field == "count" {
        order.count.fmt(&letter)?
    } else {
        return .Err(.Missing(field))
    }
    .Ok(())
}

// Each test decodes its order from a raw literal, `r#"…"#`, which holds one
// line as written: it ends only at a `"` followed by `#`, so the quotes
// inside are text. The annotation tells `json.decode` to build an `Order`,
// and `unwrap` hands it over.
test fn a_template_keeps_its_backslashes_and_fills_its_fields() {
    defer let order: Order = json.decode(r#"{"name":"Ada","count":3,"item":"notebooks","city":"London"}"#).unwrap()
    // In a raw literal a backslash is an ordinary byte, so a Windows path
    // needs no escaping.
    defer let path = fill(r"C:\letters\{name}-{count}.txt", order).unwrap()
    testing.assert_eq(path.view(), r"C:\letters\Ada-3.txt", "the path lost a backslash")?
}

test fn a_field_the_order_lacks_is_refused() {
    defer let order: Order = json.decode(r#"{"name":"Ada","count":3,"item":"notebooks","city":"London"}"#).unwrap()
    let refused = match fill(r"Hello {nickname}", order) {
        Err(error) => {
            let named = match read error { Missing(field) => field == "nickname", _ => false }
            error.release()
            named
        },
        Ok(letter) => {
            letter.release()
            false
        },
    }
    testing.assert(refused, "a missing field was filled")?
}

test fn an_order_with_a_count_in_words_is_refused() {
    let decoded: Result[OrderList, json.DecodeError] = json.decode(r#"[{"name":"Ada","count":"three","item":"notebooks","city":"London"}]"#)
    defer let refused = match decoded {
        Err(error) => {
            let shown = fmt.render_owned(error).unwrap()
            error.release()
            shown
        },
        Ok(list) => {
            list.release()
            return testing.assert(false, "a count in words was accepted")
        },
    }
    testing.assert_eq(refused.view(), r#"wrong kind of value at $[0]["count"]"#, "the refusal changed")?
}

fn write_letters() -> Result[(), LetterError] {
    // The annotation tells `json.decode` to build a list of orders.
    defer let list: OrderList = json.decode(orders)?
    var first = true
    for read order in list {
        defer let letter = fill(letter_form, order)?
        // A blank line separates each letter from the one before it.
        if !first {
            io.println("")?
        }
        first = false
        io.println(letter.view())?
    }
    .Ok(())
}

// `main` answers `LetterError` rather than `io.IoError`, so every step's
// failure reaches the user through `?` without a message written per step.
// When `main` returns an error, the program prints it with Display and exits
// with a failure status.
fn main() -> Result[UInt8, LetterError] {
    write_letters()?
    .Ok(0)
}
