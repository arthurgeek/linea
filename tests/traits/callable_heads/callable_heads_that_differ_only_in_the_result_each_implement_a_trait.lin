// A callable type's result is part of the type, so `fn(input: UInt8) -> UInt8`
// and `fn(input: UInt8) -> UInt16` are two types and each may implement `Run`.
trait Run {
    fn run(self: Self) -> UInt8
}

impl Run for fn(input: UInt8) -> UInt8 {
    fn run(self: Self) -> UInt8 {
        self(4)
    }
}

impl Run for fn(input: UInt8) -> UInt16 {
    fn run(self: Self) -> UInt8 {
        UInt8(self(3) / 100)
    }
}

fn twice(input: UInt8) -> UInt8 {
    input * 2
}

fn hundreds(input: UInt8) -> UInt16 {
    UInt16(input) * 100
}

fn go[H: Run](handler: H) -> UInt8 {
    handler.run()
}

fn main() -> UInt8 {
    go(twice) * 10 + go(hundreds)
}
