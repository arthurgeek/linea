// [O-Escapes]. A view returned from a function may come only from a source
// its `where` clause names. Every return that reaches another source is
// shown, however many there are.
fn pick(_a: String, b0: String, b1: String, b2: String, b3: String, b4: String, b5: String, b6: String, b7: String, b8: String, b9: String, b10: String, flag: UInt8) -> Str where borrows(_a) {
    if flag == 0 {
        b0.view()
    } else if flag == 1 {
        b1.view()
    } else if flag == 2 {
        b2.view()
    } else if flag == 3 {
        b3.view()
    } else if flag == 4 {
        b4.view()
    } else if flag == 5 {
        b5.view()
    } else if flag == 6 {
        b6.view()
    } else if flag == 7 {
        b7.view()
    } else if flag == 8 {
        b8.view()
    } else if flag == 9 {
        b9.view()
    } else {
        b10.view()
    }
}

fn main() -> UInt8 {
    defer let a = String.new()
    defer let b = String.new()
    UInt8(pick(a, b, b, b, b, b, b, b, b, b, b, b, 0).length())
}
