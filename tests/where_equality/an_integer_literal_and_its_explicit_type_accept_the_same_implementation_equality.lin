trait Measure[T] {
    fn count_as(self: Self, _x: T) -> UInt8
}

struct Wrap[I] { value: I, stamp: UInt8 }

impl[I: Iterator] Measure[Int64] for Wrap[I] where I.Item == Int64 {
    fn count_as(self: Self, _x: Int64) -> UInt8 {
        self.stamp
    }
}

impl[I: Iterator] Measure[UInt64] for Wrap[I] where I.Item == UInt64 {
    fn count_as(self: Self, _x: UInt64) -> UInt8 {
        self.stamp
    }
}

fn main() -> UInt8 {
    let wrap: Wrap[Range[Int64]] = .{ value = Int64(1)..3, stamp = 3 }
    let a = wrap.count_as(Int64(1))
    a + wrap.count_as(1)
}
