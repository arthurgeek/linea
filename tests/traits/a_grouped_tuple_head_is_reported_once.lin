// `((A, B))` groups a tuple and names no type, so it is refused as a head
// where it is written, for an implementation and a derive's application
// alike. The refusal is the only report: a head that names nothing is not
// also held to applying its own parameters.
trait Show {}

trait Marker {}

template impl Marker {}

impl[A, B] Show for ((A, B)) {
}

@derive(Marker for ((UInt8, Bool)))
struct Pair[A, B] { first: A, second: B }

fn main() -> UInt8 {
    let pair: Pair[UInt8, Bool] = .{ first = 0, second = true }
    if pair.second { pair.first } else { 1 }
}
