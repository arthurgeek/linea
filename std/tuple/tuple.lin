// Display writes the components between parentheses, separated by commas.
impl[A: Display, B: Display, C: Display, D: Display, E: Display, F: Display] Display for Tuple6[A, B, C, D, E, F] {
    fn fmt[W: Writer](self: Self, inout w: W) -> Result[(), W.Error] {
        &w.write_str("(")?
        self._0.fmt(&w)?
        &w.write_str(", ")?
        self._1.fmt(&w)?
        &w.write_str(", ")?
        self._2.fmt(&w)?
        &w.write_str(", ")?
        self._3.fmt(&w)?
        &w.write_str(", ")?
        self._4.fmt(&w)?
        &w.write_str(", ")?
        self._5.fmt(&w)?
        &w.write_str(")")
    }
}

// Debug writes the components as Display does, formatting each with Debug.
impl[A: Debug, B: Debug, C: Debug, D: Debug, E: Debug, F: Debug] Debug for Tuple6[A, B, C, D, E, F] {
    fn debug[W: Writer](self: Self, inout w: W) -> Result[(), W.Error] {
        &w.write_str("(")?
        self._0.debug(&w)?
        &w.write_str(", ")?
        self._1.debug(&w)?
        &w.write_str(", ")?
        self._2.debug(&w)?
        &w.write_str(", ")?
        self._3.debug(&w)?
        &w.write_str(", ")?
        self._4.debug(&w)?
        &w.write_str(", ")?
        self._5.debug(&w)?
        &w.write_str(")")
    }
}

test fn a_six_tuple_prints_its_components_in_parentheses() {
    let tuple = Tuple6[UInt8, UInt8, UInt8, UInt8, UInt8, Str] { _0 = 1, _1 = 2, _2 = 3, _3 = 4, _4 = 5, _5 = "a" }
    var writer = testing.Recorder.of(mem.system(), 64).unwrap()
    let wrote = tuple.fmt(&writer).is_ok() && &writer.write_str(" ").is_ok() && tuple.debug(&writer).is_ok()
    let rendered = writer.holds("(1, 2, 3, 4, 5, a) (1, 2, 3, 4, 5, \"a\")")
    writer.release()
    testing.assert(wrote && rendered, "Display writes the components bare; Debug quotes a text component")?
    .Ok(())
}

test fn six_tuple_compares_and_hashes_by_every_component() {
    let base = Tuple6[UInt8, UInt8, UInt8, UInt8, UInt8, UInt8] { _0 = 1, _1 = 2, _2 = 3, _3 = 4, _4 = 5, _5 = 6 }
    let same = Tuple6[UInt8, UInt8, UInt8, UInt8, UInt8, UInt8] { _0 = 1, _1 = 2, _2 = 3, _3 = 4, _4 = 5, _5 = 6 }
    testing.assert(base == same, "a six-tuple compared unequal to its copy")?
    let at_0 = Tuple6[UInt8, UInt8, UInt8, UInt8, UInt8, UInt8] { _0 = 2, _1 = 2, _2 = 3, _3 = 4, _4 = 5, _5 = 6 }
    let at_1 = Tuple6[UInt8, UInt8, UInt8, UInt8, UInt8, UInt8] { _0 = 1, _1 = 3, _2 = 3, _3 = 4, _4 = 5, _5 = 6 }
    let at_2 = Tuple6[UInt8, UInt8, UInt8, UInt8, UInt8, UInt8] { _0 = 1, _1 = 2, _2 = 4, _3 = 4, _4 = 5, _5 = 6 }
    let at_3 = Tuple6[UInt8, UInt8, UInt8, UInt8, UInt8, UInt8] { _0 = 1, _1 = 2, _2 = 3, _3 = 5, _4 = 5, _5 = 6 }
    let at_4 = Tuple6[UInt8, UInt8, UInt8, UInt8, UInt8, UInt8] { _0 = 1, _1 = 2, _2 = 3, _3 = 4, _4 = 6, _5 = 6 }
    let at_5 = Tuple6[UInt8, UInt8, UInt8, UInt8, UInt8, UInt8] { _0 = 1, _1 = 2, _2 = 3, _3 = 4, _4 = 5, _5 = 7 }
    testing.assert(base != at_0, "a six-tuple ignored its first component in equality")?
    testing.assert(base < at_0, "a six-tuple ignored its first component in ordering")?
    testing.assert(hash.Hash.hash(base) != hash.Hash.hash(at_0), "a six-tuple ignored its first component in hashing")?
    testing.assert(base != at_1, "a six-tuple ignored its second component in equality")?
    testing.assert(base < at_1, "a six-tuple ignored its second component in ordering")?
    testing.assert(hash.Hash.hash(base) != hash.Hash.hash(at_1), "a six-tuple ignored its second component in hashing")?
    testing.assert(base != at_2, "a six-tuple ignored its third component in equality")?
    testing.assert(base < at_2, "a six-tuple ignored its third component in ordering")?
    testing.assert(hash.Hash.hash(base) != hash.Hash.hash(at_2), "a six-tuple ignored its third component in hashing")?
    testing.assert(base != at_3, "a six-tuple ignored its fourth component in equality")?
    testing.assert(base < at_3, "a six-tuple ignored its fourth component in ordering")?
    testing.assert(hash.Hash.hash(base) != hash.Hash.hash(at_3), "a six-tuple ignored its fourth component in hashing")?
    testing.assert(base != at_4, "a six-tuple ignored its fifth component in equality")?
    testing.assert(base < at_4, "a six-tuple ignored its fifth component in ordering")?
    testing.assert(hash.Hash.hash(base) != hash.Hash.hash(at_4), "a six-tuple ignored its fifth component in hashing")?
    testing.assert(base != at_5, "a six-tuple ignored its sixth component in equality")?
    testing.assert(base < at_5, "a six-tuple ignored its sixth component in ordering")?
    testing.assert(hash.Hash.hash(base) != hash.Hash.hash(at_5), "a six-tuple ignored its sixth component in hashing")?
    let low_0 = Tuple6[UInt8, UInt8, UInt8, UInt8, UInt8, UInt8] { _0 = 1, _1 = 200, _2 = 200, _3 = 200, _4 = 200, _5 = 200 }
    let high_0 = Tuple6[UInt8, UInt8, UInt8, UInt8, UInt8, UInt8] { _0 = 2, _1 = 0, _2 = 0, _3 = 0, _4 = 0, _5 = 0 }
    testing.assert(low_0 < high_0, "a six-tuple did not order by its first component before the ones after it")?
    let low_1 = Tuple6[UInt8, UInt8, UInt8, UInt8, UInt8, UInt8] { _0 = 0, _1 = 1, _2 = 200, _3 = 200, _4 = 200, _5 = 200 }
    let high_1 = Tuple6[UInt8, UInt8, UInt8, UInt8, UInt8, UInt8] { _0 = 0, _1 = 2, _2 = 0, _3 = 0, _4 = 0, _5 = 0 }
    testing.assert(low_1 < high_1, "a six-tuple did not order by its second component before the ones after it")?
    let low_2 = Tuple6[UInt8, UInt8, UInt8, UInt8, UInt8, UInt8] { _0 = 0, _1 = 0, _2 = 1, _3 = 200, _4 = 200, _5 = 200 }
    let high_2 = Tuple6[UInt8, UInt8, UInt8, UInt8, UInt8, UInt8] { _0 = 0, _1 = 0, _2 = 2, _3 = 0, _4 = 0, _5 = 0 }
    testing.assert(low_2 < high_2, "a six-tuple did not order by its third component before the ones after it")?
    let low_3 = Tuple6[UInt8, UInt8, UInt8, UInt8, UInt8, UInt8] { _0 = 0, _1 = 0, _2 = 0, _3 = 1, _4 = 200, _5 = 200 }
    let high_3 = Tuple6[UInt8, UInt8, UInt8, UInt8, UInt8, UInt8] { _0 = 0, _1 = 0, _2 = 0, _3 = 2, _4 = 0, _5 = 0 }
    testing.assert(low_3 < high_3, "a six-tuple did not order by its fourth component before the ones after it")?
    let low_4 = Tuple6[UInt8, UInt8, UInt8, UInt8, UInt8, UInt8] { _0 = 0, _1 = 0, _2 = 0, _3 = 0, _4 = 1, _5 = 200 }
    let high_4 = Tuple6[UInt8, UInt8, UInt8, UInt8, UInt8, UInt8] { _0 = 0, _1 = 0, _2 = 0, _3 = 0, _4 = 2, _5 = 0 }
    testing.assert(low_4 < high_4, "a six-tuple did not order by its fifth component before the ones after it")?
    let low_5 = Tuple6[UInt8, UInt8, UInt8, UInt8, UInt8, UInt8] { _0 = 0, _1 = 0, _2 = 0, _3 = 0, _4 = 0, _5 = 1 }
    let high_5 = Tuple6[UInt8, UInt8, UInt8, UInt8, UInt8, UInt8] { _0 = 0, _1 = 0, _2 = 0, _3 = 0, _4 = 0, _5 = 2 }
    testing.assert(low_5 < high_5, "a six-tuple did not order by its sixth component before the ones after it")?
    .Ok(())
}

