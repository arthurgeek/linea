// `{}` is an empty block. It computes nothing, so its value is `()`: an arm
// or a function body that does nothing is written as one.
enum Signal { Stop, Go(UInt8) }

fn ignore(sink _signal: Signal) -> () {}

fn react(sink signal: Signal) -> UInt8 {
    var seen: UInt8 = 0
    match signal {
        Stop => {},
        Go(n) => {
            seen = n
        },
    }
    seen
}

fn main() -> UInt8 {
    ignore(.Stop)
    let done: () = {}
    let _same = done
    react(.Go(3)) - react(.Stop) - 3
}
