// A result typed as a borrow of a parameter names its own provenance, so a
// carrier among the other parameters does not settle the choice.
@carrier
struct Session {
    user: Str,
}

fn pick(session: Session, name: Str) -> borrow Str {
    if session.user.length() > 0 {
        borrow name
    } else {
        borrow name
    }
}

fn main() -> UInt8 {
    let session = Session { user = "ada" }
    let name = "grace"
    let _picked = pick(session, name)
    0
}
