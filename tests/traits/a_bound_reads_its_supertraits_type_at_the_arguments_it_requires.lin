// `Fancy` requires `Lookup` at `UInt64`, so `T.Elem` under `T: Fancy` is the
// `Elem` that `Lookup[UInt64]` settles for the argument.
trait Lookup[I] {
    type Elem

    fn at(self: Self, i: I) -> Self.Elem where carries()
}

trait Fancy: Lookup[UInt64] {
    fn tag(self: Self) -> UInt8
}

struct Board {
    cells: [UInt8; 4],
}

impl Lookup[UInt64] for Board {
    type Elem = UInt8

    fn at(self: Board, i: UInt64) -> UInt8 {
        self.cells[i]
    }
}

impl Fancy for Board {
    fn tag(_self: Board) -> UInt8 {
        7
    }
}

fn third[T: Fancy](t: T) -> T.Elem {
    let i: UInt64 = 2
    Lookup.at(t, i)
}

fn main() -> UInt8 {
    let b: Board = .{ cells = [1, 2, 3, 4] }
    let tag = b.tag()
    third(b) + tag
}
