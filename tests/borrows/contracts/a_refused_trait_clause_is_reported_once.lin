// A trait signature whose clause names no parameter is refused at the trait.
// Its implementation adopts no contract from it and adds no error of its own.
struct Request {
    name: Str,
}

trait Handler {
    fn handle(self: Self, request: Request) -> Str where carries(_request)
}

struct Echo {}

impl Handler for Echo {
    fn handle(_self: Self, request: Request) -> Str {
        copy(request.name)
    }
}

fn main() -> UInt8 {
    let _echoed = Echo {}.handle(Request { name = "world" })
    0
}
