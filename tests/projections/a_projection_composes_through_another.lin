struct Inner {
    cells: [UInt8; 3],
}

struct Outer {
    inner: Inner,
}

impl Index[UInt64] for Inner {
    type Elem = UInt8

    proj at(inout self: Inner, i: UInt64) -> UInt8 {
        self.cells[i]
    }
}

impl Index[UInt64] for Outer {
    type Elem = UInt8

    proj at(inout self: Outer, i: UInt64) -> UInt8 {
        self.inner[i]
    }
}

fn main() -> UInt8 {
    let o: Outer = .{ inner = .{ cells = [1, 2, 3] } }
    o[1]
}
