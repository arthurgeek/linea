@derive(Structural)
struct Mark {}

enum Bad { Broken }

fn parse() -> Result[UInt8, Bad] {
    .Ok(1)
}

trait Structural {
    fn value(self: Self) -> UInt8
}

template impl Structural {
    fn value(_self: Self) -> UInt8 {
        let n = parse()?
        n
    }
}

fn main() -> UInt8 {
    let mark: Mark = .{}
    mark.value()
}
