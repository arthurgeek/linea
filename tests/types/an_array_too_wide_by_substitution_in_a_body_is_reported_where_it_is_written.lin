// [L-Size]. `probe` writes an array of three of its parameter, which is too
// wide once the parameter is an array of 2000000000 bytes. No declared type
// holds that array, so it is reported where the body writes it.
fn probe[T: Discardable](sink _given: Option[T]) -> UInt8 {
    let _lent: Option[borrow [T; 3]] = .None
    0
}

fn main() -> UInt8 {
    let none: Option[[UInt8; 2000000000]] = .None
    probe(none)
}
