enum Mode { Preserve, Exact(UInt64) }

let chosen = later

let later: Mode = .Preserve

fn select(mode: Mode = chosen) -> UInt8 {
    match read mode { Preserve => 0, Exact(_) => 1 }
}

fn invoke[F: fn(read mode: Mode = Mode.Preserve) -> UInt8](callback: F) -> UInt8 {
    callback()
}

fn main() -> UInt8 {
    invoke(select) + select() + select(later)
}
