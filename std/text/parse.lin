test fn int64_parse_checks_limits() {
    let minimum = "-9223372036854775808".parse[Int64]()
    match minimum { Ok(value) => testing.assert_eq(value, Int64.min, "minimum changed")?, Err(_) => testing.assert(false, "minimum was rejected")? }
    let maximum = "+9223372036854775807".parse[Int64]()
    match maximum { Ok(value) => testing.assert_eq(value, Int64.max, "maximum changed")?, Err(_) => testing.assert(false, "maximum was rejected")? }
    let over = "9223372036854775808".parse[Int64]()
    testing.assert_eq(over, .Err(.Overflow(18)), "overflow did not report its digit")?
    let under = "-9223372036854775809".parse[Int64]()
    testing.assert_eq(under, .Err(.Overflow(19)), "negative overflow did not report its digit")?
    .Ok(())
}

impl Parse for UInt8 {
    fn parse(text: Str) -> Result[UInt8, ParseError] where carries() {
        let value = decimal(text, false, UInt64(UInt8.max), 0)?
        .Ok(UInt8(value.magnitude))
    }
}

test fn uint8_parse_checks_limits() {
    let minimum = "0".parse[UInt8]()
    match minimum { Ok(value) => testing.assert_eq(value, UInt8.min, "minimum changed")?, Err(_) => testing.assert(false, "minimum was rejected")? }
    let maximum = "+255".parse[UInt8]()
    match maximum { Ok(value) => testing.assert_eq(value, UInt8.max, "maximum changed")?, Err(_) => testing.assert(false, "maximum was rejected")? }
    let over = "256".parse[UInt8]()
    testing.assert_eq(over, .Err(.Overflow(2)), "overflow did not report its digit")?
    .Ok(())
}

