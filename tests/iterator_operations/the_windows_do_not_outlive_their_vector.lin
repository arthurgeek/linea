// The windows not yet yielded view the vector's storage too, so the walk
// cannot go on after the vector is released.
fn main() -> UInt8 {
    var readings: Vec[UInt8] = Vec.new()
    &readings.push(3).unwrap()
    &readings.push(5).unwrap()
    var pairs = readings.as_slice().windows(2)
    readings.release()
    let first = &pairs.next().unwrap()
    first[1] - first[0]
}
