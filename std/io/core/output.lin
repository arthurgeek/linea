import std.mem
import std.testing

// The bytes a value renders to, gathered so they reach `target` in one write
// once the value has rendered, repeated only for what a short write leaves.
// No lock is held while the value's `fmt` runs, so a `fmt` that prints
// writes its own output first, before the value's. A write is not interleaved
// with another task's when it reaches a pipe in at most `PIPE_BUF` bytes (512
// or more on every POSIX system); a longer line two tasks print at once may
// be. When the bytes cannot be gathered, those gathered so far are written
// and the rest goes straight to `target`.
struct Gathered {
    bytes: mem.Vec[UInt8, mem.SystemAllocator],
    target: Descriptor,
}

impl Gathered {
    fn into(sink target: Descriptor) -> Gathered {
        .{ bytes = mem.Vec.new(), target }
    }

    // Write what was gathered to the target in one write, and empty it.
    fn flush(inout self: Self) -> Result[(), IoError] {
        let written = write_all(&self.target, self.bytes.as_slice())
        &self.bytes.clear()
        let _ = written else |failure| {
            return .Err(failure.into())
        }
        .Ok(())
    }

    // Write what is left and release the buffer.
    fn finish(sink self: Self) -> Result[(), IoError] {
        var gathered = self
        let flushed = &gathered.flush()
        let Gathered { bytes, target: _ } = gathered
        bytes.release()
        flushed
    }
}

impl Writer for Gathered {
    type Error = IoError

    fn write_str(inout self: Self, s: Str) -> Result[(), IoError] where carries() {
        match &self.bytes.append_slice(s.as_bytes()) {
            Ok(_) => .Ok(()),
            Err(_) => {
                &self.flush()?
                &self.target.write_str(s)
            },
        }
    }
}

test fn gathered_bytes_reach_the_target_once_rendering_ends() {
    var out = Gathered.into(stdout())
    let rendered = "ready".fmt(&out).is_ok()
    let gathered = out.bytes.length()
    let written = out.finish().is_ok()
    testing.assert(rendered, "gathering text failed")?
    testing.assert_eq(gathered, UInt64(5), "the text was not gathered")?
    testing.assert(written, "writing what was gathered failed")?
    .Ok(())
}

// Render `x` to standard output and report a failed write.
pub fn print[T: Display](x: T) -> Result[(), IoError] {
    var w = Gathered.into(stdout())
    let rendered = x.fmt(&w)
    let written = w.finish()
    rendered?
    written
}

test fn print_renders_a_value_to_standard_output() {
    // The test runner discards what a test writes to standard output.
    testing.assert(print("ready").is_ok(), "writing text to standard output failed")?
    testing.assert(print(1250).is_ok(), "writing a number to standard output failed")?
    .Ok(())
}

// Render a value and append a line ending to the supplied writer.
pub fn line[T: Display, W: Writer](x: T, inout w: W) -> Result[(), W.Error] where carries(.Err: w) {
    x.fmt(&w)?
    &w.write_str("\n")
}

test fn a_line_is_the_value_and_the_ending_after_it() {
    var w = testing.Recorder.of(64) else |_| {
        return testing.assert(false, "a recorder was refused")
    }
    let wrote = line("hello", &w).is_ok()
    let said = w.holds("hello\n")
    w.release()

    testing.assert(wrote, "writing a line into a recorder failed")?
    testing.assert(said, "a line is not the value and the ending after it")?

    var w = testing.Recorder.of(64) else |_| {
        return testing.assert(false, "a recorder was refused")
    }
    let wrote = line(1250, &w).is_ok()
    let said = w.holds("1250\n")
    w.release()

    testing.assert(wrote, "writing a number into a recorder failed")?
    testing.assert(said, "a rendered number is not followed by the ending")?

    .Ok(())
}

// Render `x` and a line ending to standard output, and report a failed write.
pub fn println[T: Display](x: T) -> Result[(), IoError] {
    var w = Gathered.into(stdout())
    let rendered = line(x, &w)
    let written = w.finish()
    rendered?
    written
}

test fn println_ends_the_value_with_a_line_on_standard_output() {
    testing.assert(println("ready").is_ok(), "writing a line to standard output failed")?
    .Ok(())
}

// Render `x` to `w` and ignore a failed write. `eprint` writes to standard
// error this way.
fn eprint_to[T: Display, W: Writer](x: T, inout w: W) where W.Error: Discardable {
    match x.fmt(&w) {
        _ => {},
    }
}

// Render `x` to standard error and ignore a failed write: standard-error
// output is best-effort debugging output.
pub fn eprint[T: Display](x: T) {
    var w = Gathered.into(stderr())
    eprint_to(x, &w)
    let _ = w.finish() else |_| {
        return
    }
}

test fn eprint_renders_a_value_and_ignores_a_refused_write() {
    // The test runner shows what a test wrote to standard error only when it
    // fails.
    eprint("checked")
    var recorder = testing.Recorder.of(16).unwrap()
    eprint_to(1250, &recorder)
    let rendered = recorder.holds("1250")
    recorder.release()
    testing.assert(rendered, "eprint did not render its value")?
    // No process has descriptor -1, so every write to it is refused.
    var refusing = descriptor(-1)
    eprint_to("lost", &refusing)
    .Ok(())
}

// Render `x` and a line ending to `w`, and ignore a failed write. `eprintln`
// writes to standard error this way.
fn eprintln_to[T: Display, W: Writer](x: T, inout w: W) where W.Error: Discardable {
    match line(x, &w) {
        _ => {},
    }
}

// Render `x` and a line ending to standard error, and ignore a failed write.
pub fn eprintln[T: Display](x: T) {
    var w = Gathered.into(stderr())
    eprintln_to(x, &w)
    let _ = w.finish() else |_| {
        return
    }
}

// `Noisy` prints a note while it is rendered.
struct Noisy {}

impl Display for Noisy {
    fn fmt[W: Writer](_self: Self, inout w: W) -> Result[(), W.Error] where carries(.Err: w) {
        eprintln("rendering a noisy value")
        "noisy".fmt(&w)
    }
}

test fn a_value_that_prints_while_it_is_printed_is_printed() {
    testing.assert(println(Noisy {}).is_ok(), "printing a value that prints failed")?
    .Ok(())
}

test fn eprintln_renders_a_line_and_ignores_a_refused_write() {
    eprintln("checked")
    var recorder = testing.Recorder.of(16).unwrap()
    eprintln_to("ready", &recorder)
    let rendered = recorder.holds("ready\n")
    recorder.release()
    testing.assert(rendered, "eprintln did not end its value with a line")?
    // No process has descriptor -1, so every write to it is refused.
    var refusing = descriptor(-1)
    eprintln_to("lost", &refusing)
    .Ok(())
}

// Generated entry-point code calls `report` with the error `main` returned: it
// writes the error to standard error and gives the process exit status 1.
fn report[E: Display](e: E) -> UInt8 {
    eprint("error: ")
    eprintln(e)
    1
}

// Generated test-entry code calls `ran` to turn a test's result into its exit
// status: 0 when it passed, and 1 after reporting its error.
fn ran[E: Display](r: Result[(), E]) -> UInt8 {
    match read r {
        Ok(_) => 0,
        Err(e) => report(e),
    }
}
