import std.io

use io.IoError
use io.println

@copyable
struct Empty {}

@copyable
enum Uninhabited {}

derive (Display, Debug) for Empty

derive (Display, Debug) for Uninhabited

fn _render_uninhabited(value: Uninhabited) -> () {
    let _display = "{value}"
    let _debug = "{value:?}"
}

fn main() -> Result[UInt8, IoError] {
    let empty: Empty = .{}
    println("{empty}")?
    println("{empty:?}")?
    return .Ok(0)
}
