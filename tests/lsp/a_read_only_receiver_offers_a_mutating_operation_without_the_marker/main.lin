struct List { n: UInt8 }

impl List {
    fn push(inout self: Self, value: UInt8) -> () {
        self.n += value
    }

    fn clear(inout self: Self) -> () {
        self.n = 0
    }

    fn truncate(inout self: Self, count: UInt8) -> () {
        self.n = count
    }

    fn length(self: Self) -> UInt8 {
        self.n
    }
}

fn main() -> UInt8 {
    let list: List = .{ n = 0 }
    list.length()
}
