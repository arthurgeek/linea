// A response is built in its request's arena and may view the request, so it
// is read before the request and its exchange are released; reading it
// afterwards is refused.
import std.http
import std.io

fn greet[P: Allocator](inout _: (), request: http.Request[P], inout _incoming: http.RequestBody[P]) -> Result[http.Response[P], http.Error[P]] where carries(request), borrows(_incoming), retains(_incoming: _incoming) {
    let name = request.query().unwrap_or("stranger")
    http.text(request, "hello, {name}")
}

fn main() -> UInt8 {
    defer var router = http.Router.new()
    &router.route_raw("GET /greet", greet).unwrap()
    let exchange = http.TestExchange.open()
    var sent = exchange.request("GET", "/greet?ada").unwrap()
    var nothing = {}
    let answered = &sent.send_to(&router, &nothing)
    sent.release()
    exchange.release()
    match answered {
        Ok(response) => {
            let _printed = io.println("{response.status().code()}")
            0
        },
        Err(_) => 1,
    }
}
