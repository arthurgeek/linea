    let lower = UInt8.try_from(UInt64(0))
    testing.assert_eq(lower, Option.Some(UInt8(0)), "lower accepted value changed")?
    let interior = UInt8.try_from(UInt64(1))
    testing.assert_eq(interior, Option.Some(UInt8(1)), "interior accepted value changed")?
    let upper = UInt8.try_from(UInt64(255))
    testing.assert_eq(upper, Option.Some(UInt8(255)), "upper accepted value changed")?
    let above = UInt8.try_from(UInt64(256))
    match above {
        Some(_) => testing.assert(false, "above out-of-range value was accepted")?,
        None => {},
    }
    let source_max = UInt8.try_from(UInt64.max)
    match source_max {
        Some(_) => testing.assert(false, "source_max out-of-range value was accepted")?,
        None => {},
    }
    .Ok(())
}

test fn int8_identity_conversion_preserves_its_range() {
    let lower = Int8.try_from(Int8.min)
    testing.assert_eq(lower, Option.Some(Int8.min), "identity conversion changed the minimum")?
    let zero = Int8.try_from(Int8(0))
    testing.assert_eq(zero, Option.Some(Int8(0)), "identity conversion changed zero")?
    let upper = Int8.try_from(Int8.max)
    testing.assert_eq(upper, Option.Some(Int8.max), "identity conversion changed the maximum")?
    .Ok(())
}

