@derive(Settle where X: Settle, Stop0[X]: Settle, Stop1[X]: Settle)
struct Stop39[X] {
    x: X,
}

fn settled[T: Settle](_value: T) {}

fn main() -> UInt8 {
    let stop: Stop0[UInt8] = .{ x = 0 }
    settled(stop)
    0
}
