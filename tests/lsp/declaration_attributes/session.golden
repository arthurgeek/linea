{"jsonrpc":"2.0","id":18,"result":[{"range":{"start":{"line":0,"character":0},"end":{"line":44,"character":0}},"newText":"import traits\n\nuse traits.Score\n\n@(\n    copyable,\n    // Keep this request grouped with its policy.\n    derive(traits.Score),\n)\nstruct Point {\n    value: UInt8,\n}\n\n@copyable\n// This comment stays between separate attributes.\n@derive(Score)\nstruct Sample[T: Copyable] {\n    value: T,\n}\n\n@derive(traits.Score)\nenum Choice { Value(UInt8) }\n\n@derive(Score)\ntype Count = UInt8\n\nstruct Cell[T] { value: T }\n\nderive[T: Copyable] Score for Cell[T]\n\nfn main() -> UInt8 {\n    let point = Point { value = 3 }\n    let duplicate = copy(point)\n    let sample = Sample[UInt8] { value = 5 }\n    let choice = Choice.Value(7)\n    let count = Count(11)\n    let cell = Cell[UInt8] { value = 13 }\n    let total = Score.score(point) + Score.score(duplicate) + Score.score(sample) + Score.score(choice) + Score.score(count) + Score.score(cell)\n    if total == 42 {\n        0\n    } else {\n        1\n    }\n}\n"}]}
