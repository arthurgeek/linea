import std.io
import std.session
import std.task
import std.time

use session.Chan
use session.End
use session.Send

fn main() -> UInt8 {
    let execution = io.Loop.open(carriers: 2).unwrap()
    let body = sink [execution] |sink me: Chan[End]| {
        let first = task.current_carrier().unwrap()
        if io.current() != execution || execution.is_simulated() {
            panic("a fiber lost its inherited execution context")
        }
        let reserved = task.prepare(sink [] |sink child: Chan[End]| child.close()).unwrap()
        let _unrun = reserved.cancel()
        let child = task.start(sink [] |sink child: Chan[Send[UInt64, End]]| {
            child.send(42).close()
        }).unwrap()
        let (answer, done) = child.recv()
        done.close()
        if answer != 42 {
            panic("starting a nested task lost its result")
        }
        var attempts = UInt64(0)
        while attempts < 65536 && first == task.current_carrier().unwrap() {
            time.sleep(time.Duration.from_nanoseconds(0))
            attempts += 1
        }
        if first == task.current_carrier().unwrap() {
            panic("ordinary task operations pinned their calling continuation")
        }
        if io.current() != execution {
            panic("a migrated task changed its inherited loop")
        }
        me.close()
    }
    task.start(body, on: execution).unwrap().close()
    0
}
