import std.io
import std.net
import std.session
import std.task
import std.time

use net.Acceptor
use net.Accepted
use session.Chan
use session.End

fn main() -> UInt8 {
    var listener = net.listen(net.loopback(0), backlog: net.Backlog(1)).unwrap()
    let address = listener.local_address().unwrap()
    let occupied_first = net.connect(address, deadline: time.Deadline.after(time.Duration.from_milliseconds(1000))).unwrap()
    let occupied_second = net.connect(address, deadline: time.Deadline.after(time.Duration.from_milliseconds(1000))).unwrap()
    let execution = io.Loop.open(carriers: 2).unwrap()
    var passed = false
    let body = sink [address, inout passed] |sink me: Chan[End]| {
        passed = match net.connect(address, deadline: time.Deadline.after(time.Duration.from_milliseconds(500))) {
            Ok(connection) => {
                connection.release()
                false
            },
            Err(Io(error)) => error.category == .TimedOut,
            Err(_) => false,
        }
        time.sleep(time.Duration.from_nanoseconds(0))
        me.close()
    }
    task.start(body, on: execution).unwrap().close()
    let Accepted { connection: first, address: _ } = &listener.accept().unwrap()
    first.release()
    occupied_first.release()
    let Accepted { connection: second, address: _ } = &listener.accept().unwrap()
    second.release()
    occupied_second.release()
    listener.release()
    if passed {
        0
    } else {
        1
    }
}
