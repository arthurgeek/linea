// Outside `box_office` a `Ticket` is sold and refunded through `Refund`, and
// its seat is sealed.
@opaque
struct Ticket {
    seat: UInt8,
}

pub trait Refund {
    fn refund(self: Self) -> UInt8
}

impl Refund for Ticket {
    fn refund(self: Self) -> UInt8 {
        self.seat
    }
}

impl Ticket {
    pub fn sell(seat: UInt8) -> Ticket {
        .{ seat = seat }
    }
}
