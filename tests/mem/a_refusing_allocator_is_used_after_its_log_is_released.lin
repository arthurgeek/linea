import std.mem
import std.testing

use testing.TestAllocator

fn main() -> UInt8 {
    let log = TestAllocator.open(mem.system()).unwrap()
    let allocator = log.handle()
    // Releasing the test allocator frees what the handle counts into.
    log.release()
    match allocator.acquire(64) {
        Ok(buffer) => {
            buffer.release()
            1
        },
        Err(_) => 2,
    }
}
