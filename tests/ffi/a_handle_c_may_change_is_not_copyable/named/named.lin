import std.ffi

// A copy of a copyable handle names the same object, so changing the object
// through one copy would leave text read through the other dangling.
@(opaque, copyable)
type Name = UInt64

extern fn named_open() -> Name

extern fn named_name(read handle: Name) -> ffi.CText where borrows(handle)

extern fn named_reset(handle: Name)

@(opaque, copyable)
struct Named { handle: Name }

impl Named {
    pub fn open() -> Named {
        .{ handle = named_open() }
    }

    pub fn length(self: Self) -> UInt64 {
        named_name(self.handle).length()
    }

    pub fn reset(inout self: Self) {
        named_reset(self.handle)
    }
}
