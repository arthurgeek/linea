// A parameter written in a bound's argument is written, so the declaration
// that names it uses it.
trait Lookup[I] {
    type Elem

    fn at(self: Self, i: I) -> Elem where carries(self, i)
}

struct Board {
    cells: [UInt8; 4],
}

impl Lookup[UInt64] for Board {
    type Elem = UInt8

    fn at(self: Board, i: UInt64) -> UInt8 {
        self.cells[i]
    }
}

fn reach[I, C: Lookup[I]](c: C, i: I) -> C.Elem where carries(c, i) {
    Lookup.at(c, i)
}

fn main() -> UInt8 {
    let b: Board = .{ cells = [1, 2, 3, 4] }
    let i: UInt64 = 2
    reach(b, i)
}
