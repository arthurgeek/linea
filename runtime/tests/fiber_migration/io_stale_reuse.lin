import std.io
import std.mem
import std.net
import std.session
import std.task
import std.time

use io.Reader
use net.Acceptor
use net.Accepted
use session.Chan
use session.End
use session.Send

fn pair(inout listener: net.Listener) -> (net.Connection, net.Connection) where carries() {
    let peer = net.connect(listener.local_address().unwrap()).unwrap()
    let Accepted { connection, address: _ } = &listener.accept().unwrap()
    (peer, connection)
}

fn read_byte(inout stream: net.Connection) {
    var buffer = mem.system().acquire(1).unwrap()
    let count = &stream.read_some(&buffer, offset: 0, count: 1).unwrap()
    if count != 1 || buffer.as_slice()[0] != 120 {
        panic("a stale completion replaced the current operation's result")
    }
    time.sleep(time.Duration.from_nanoseconds(0))
    buffer.release()
}

fn main() -> UInt8 {
    var listener = net.listen(net.loopback(0)).unwrap()
    let (first_peer, first_connection) = pair(&listener)
    let (second_peer, second_connection) = pair(&listener)
    listener.release()
    let execution = io.Loop.open(carriers: 2).unwrap()
    var first_passed = false
    var second_passed = false
    let first = task.prepare(
        sink [sink first_connection, inout first_passed] |sink me: Chan[Send[UInt8, End]]| {
            var stream = first_connection
            read_byte(&stream)
            stream.release()
            first_passed = true
            me.send(UInt8(1)).close()
        },
        on: execution,
    ).unwrap().start()
    var peer = first_peer
    let _sent = io.write_all(&peer, "x".as_bytes()).unwrap()
    peer.release()
    let (ready, first_end) = first.recv()
    if ready != 1 {
        panic("the first kernel operation did not complete")
    }
    // Keep the next real operation on the original carrier and ring.
    let unused = task.prepare(
        sink [] |sink me: Chan[End]| {
            me.close()
        },
        on: execution,
    ).unwrap()
    let _unrun = unused.cancel()
    let second = task.prepare(
        sink [sink second_connection, inout second_passed] |sink me: Chan[End]| {
            var stream = second_connection
            read_byte(&stream)
            stream.release()
            second_passed = true
            me.close()
        },
        on: execution,
    ).unwrap().start()
    // Reclaim the first task while the second request still awaits its byte.
    first_end.close()
    var second_writer = second_peer
    let _sent_second = io.write_all(&second_writer, "x".as_bytes()).unwrap()
    second_writer.release()
    second.close()
    if first_passed && second_passed {
        0
    } else {
        1
    }
}
