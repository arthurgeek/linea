import std.mem
import std.testing
import std.time

// The runtime answers the identity of the loop the calling thread runs on, 0
// for the system; makes a loop the thread's and answers the one it replaced;
// and says whether a loop is a simulation. A loop that has ended traps.
extern fn linea_loop_open(carriers: UInt64) -> Int64

extern fn linea_io_current() -> UInt64

extern fn linea_io_switch(identity: UInt64) -> UInt64

extern fn linea_io_is_simulated(identity: UInt64) -> UInt8

// The runtime opens a simulation from a seed and the bounds of its network,
// answering its identity or 0 when it cannot; advances its clock; reports
// the digest of its trace; and ends it.
extern fn linea_sim_open(seed: UInt64, latency_ns: UInt64, jitter_ns: UInt64, chunk_bytes: UInt64, buffer_bytes: UInt64, short_writes: UInt8, reset_one_in: UInt64) -> UInt64

extern fn linea_sim_advance(identity: UInt64, nanoseconds: UInt64)

extern fn linea_sim_fingerprint(identity: UInt64) -> UInt64

extern fn linea_sim_close(identity: UInt64)

// The runtime signals every wait-set registration for `signal` made inside
// the running simulation `loop`, as a delivery of the signal would.
extern fn linea_signal_deliver_simulated(home: UInt64, signal: UInt8)

let nanoseconds_per_millisecond: UInt64 = 1000000

// An Io names what a task's waits run on: the system, where each operation
// waits on the kernel, a fiber loop, or a simulation with a virtual
// clock and network. It is a number naming a loop, so it can be copied
// anywhere, and every use checks that the loop it names has not ended.
@(opaque, copyable, derive(Equatable, Debug))
struct Io {
    identity: UInt64,
}

// Select the starting task's Io when execution is prepared. Unlike current(),
// which captures a concrete loop now, this constant resolves when it is used.
// It is the default for task and server execution arguments.
pub let inherited = Io { identity = UInt64.max }

// Open a process-lifetime loop with an explicit positive carrier count.
@opaque
struct Loop {}

impl Loop {
    // Each task keeps its stack while its carrier runs another ready task.
    // The loop keeps its resources until the process exits.
    pub fn open(carriers: UInt64) -> Result[Io, IoError] {
        let identity = linea_loop_open(carriers)
        if identity < 0 {
            return .Err(IoError.from_os(.Open, Int32(-identity)))
        }
        .Ok(Io { identity = UInt64(identity) })
    }

    test fn a_loop_requires_a_positive_carrier_count() {
        let refused = match Loop.open(carriers: 0) {
            Ok(_) => false,
            Err(error) => error.category == IoCategory.InvalidInput,
        }
        testing.assert(refused, "a loop accepted zero carriers")?
    }
}

// The system: the Io of every task that is a thread of its own.
pub fn system() -> Io {
    Io { identity = 0 }
}

test fn the_system_is_not_simulated() {
    testing.assert(!system().is_simulated(), "the system was a simulation")?
}

// The Io the calling task runs on: the simulation inside `Simulation.run`,
// the loop inside a fiber, and the system for a task on its own thread.
pub fn current() -> Io {
    Io { identity = linea_io_current() }
}

test fn a_task_runs_on_the_system_outside_a_simulation() {
    testing.assert_eq(current(), system(), "a task outside a simulation did not run on the system")?
}

impl Io {
    // Resolve an inherited selection and answer the stable runtime identity.
    internal fn runtime_identity(self: Self) -> UInt64 {
        if self.identity == UInt64.max {
            linea_io_current()
        } else {
            self.identity
        }
    }

    test fn the_system_runtime_identity_is_zero() {
        testing.assert_eq(system().runtime_identity(), UInt64(0), "the system identity changed")?
    }

    test fn inherited_resolves_in_the_task_that_uses_it() {
        var sim = Simulation.open(seed: 1).unwrap()
        let captured = current()
        let (selected, simulated) = &sim.run(|inout _world| (inherited.runtime_identity(), inherited.is_simulated()))
        sim.close()
        testing.assert_eq(captured, system(), "capturing the current Io changed it later")?
        testing.assert(selected != captured.runtime_identity(), "inherited captured the caller's earlier Io")?
        testing.assert(simulated, "inherited did not resolve the simulation")?
    }

    // Whether this Io is a simulation. Asking about the Io of a simulation
    // that has been closed traps.
    pub fn is_simulated(self: Self) -> Bool {
        linea_io_is_simulated(self.runtime_identity()) != 0
    }

    test fn the_io_inside_a_run_is_its_simulation() {
        var sim = Simulation.open(seed: 1).unwrap()
        let (inside, simulated) = &sim.run(|inout _world| (current(), current().is_simulated()))
        sim.close()
        testing.assert(inside != system(), "the Io inside a run was the system")?
        testing.assert(simulated, "the Io inside a run was not a simulation")?
    }
}

// A Network bounds the choices a simulation's network makes from its seed.
// Each chunk of bytes arrives `latency_ms` plus a chosen 0 to `jitter_ms`
// milliseconds after it is sent, and chunks arrive in the order they were
// sent. `chunk_bytes`, when not 0, cuts every write into chunks of a chosen 1
// to that many bytes, so reads come back short. `buffer_bytes` bounds the
// bytes one direction holds in flight and unread; a write that finds it full
// waits for the reader. `short_writes` lets a write accept a chosen part of
// its bytes. `reset_one_in`, when not 0, resets the connection in place of
// delivering one chunk in that many, as a failing network would.
@(copyable, derive(Equatable, Debug))
pub struct Network {
    latency_ms: UInt64,
    jitter_ms: UInt64,
    chunk_bytes: UInt64,
    buffer_bytes: UInt64,
    short_writes: Bool,
    reset_one_in: UInt64,
}

// One millisecond of latency, writes delivered whole, 64 KiB each way, and no
// faults.
let default_network = Network { latency_ms = 1, jitter_ms = 0, chunk_bytes = 0, buffer_bytes = 65536, short_writes = false, reset_one_in = 0 }

impl Default for Network {
    fn default() -> Network {
        default_network
    }
}

test fn the_default_network_delivers_whole_writes_after_a_millisecond() {
    let network = Network.default()
    testing.assert_eq(network.latency_ms, UInt64(1), "the default latency changed")?
    testing.assert_eq(network.chunk_bytes, UInt64(0), "the default network cut writes into chunks")?
    testing.assert_eq(network.reset_one_in, UInt64(0), "the default network reset connections")?
}

// A Simulation runs a test against a virtual clock and an in-memory network,
// so a test of a deadline waits for nothing and a race between bytes
// arriving and a deadline passing happens the same way every time. Every
// choice the network makes is drawn from `seed`: two simulations opened with
// one seed that run one program see the same events at the same virtual
// instants. `close` ends it, and it must be closed.
@(opaque, linear)
struct Simulation {
    identity: UInt64,
}

// What a simulation's body controls while it runs: its virtual clock and the
// signals delivered to it. A body receives it from `Simulation.run`.
@opaque
struct World {
    identity: UInt64,
}

// A sum of milliseconds as nanoseconds, the largest number for one too long
// to count.
fn as_nanoseconds(ms: UInt64) -> UInt64 {
    if ms > UInt64.max / nanoseconds_per_millisecond {
        return UInt64.max
    }
    ms * nanoseconds_per_millisecond
}

test fn milliseconds_too_many_to_count_saturate() {
    testing.assert_eq(as_nanoseconds(3), UInt64(3000000), "3 ms changed")?
    testing.assert_eq(as_nanoseconds(UInt64.max), UInt64.max, "an overflowing length did not saturate")?
}

impl Simulation {
    // Open a simulation whose network makes its choices from `seed` within
    // the bounds `network` sets. Its monotonic clock starts at one second and
    // its wall clock at 2026-01-01T00:00:00Z. The runtime keeps the
    // simulation's state, so a process whose memory or loop table is
    // exhausted cannot open one.
    pub fn open(seed: UInt64, network: Network = default_network) -> Result[Simulation, mem.Oom] {
        let short_writes: UInt8 = if network.short_writes {
            1
        } else {
            0
        }
        let identity = linea_sim_open(seed, as_nanoseconds(network.latency_ms), as_nanoseconds(network.jitter_ms), network.chunk_bytes, network.buffer_bytes, short_writes, network.reset_one_in)
        if identity == 0 {
            return .Err(.Exhausted)
        }
        .Ok(Simulation { identity })
    }

    test fn a_simulation_opens_with_the_default_network_or_the_one_given() {
        var plain = Simulation.open(seed: 1).unwrap()
        var slow = Simulation.open(seed: 1, network: Network { latency_ms = 250, ..Network.default() }).unwrap()
        let plain_ms = &plain.run(|inout _world| time.Instant.now().monotonic_nanoseconds())
        let slow_ms = &slow.run(|inout _world| time.Instant.now().monotonic_nanoseconds())
        plain.close()
        slow.close()
        testing.assert_eq(plain_ms, slow_ms, "two simulations started their clocks at different instants")?
    }

    // Run `body` on the simulation's calling thread and answer what it answers.
    // The simulation is lent to the run, so no other task runs it meanwhile.
    // While it runs, `io.current()` is the simulation, `time.Instant.now()`
    // reads the virtual clock, tasks started here inherit the simulation, and
    // `net.listen` and
    // `net.connect` make simulated descriptors, on which no system call is
    // made. Runnable tasks run before a wait moves the clock to its next event,
    // so a deadline
    // a minute away passes at once. A simulated descriptor used outside a run
    // of its simulation, a real socket used inside one, and a wait with no deadline that
    // nothing can end all trap, since none could be repeated from the seed.
    // A simulated descriptor closed between runs is closed at the next
    // operation of its simulation. An instant read inside a run is on the
    // virtual clock and one read outside on the real clock, so neither means
    // anything to the other.
    pub fn run[R, F: inout fn(inout world: World) -> R](inout self: Self, sink body: F) -> R where carries(body), F: Discardable {
        let outer = linea_io_switch(self.identity)
        var world = World { identity = self.identity }
        var running = body
        let answer = &running(&world)
        let _restored = linea_io_switch(outer)
        answer
    }

    test fn a_long_sleep_inside_a_run_waits_for_nothing() {
        var sim = Simulation.open(seed: 1).unwrap()
        let started = time.Instant.now()
        let slept = &sim.run(
            |inout _world| {
                let before = time.Instant.now()
                time.sleep(time.Duration.from_seconds(3600))
                before.elapsed()
            },
        )
        sim.close()
        testing.assert_eq(slept, time.Duration.from_seconds(3600), "an hour of virtual sleep was not an hour")?
        testing.assert(started.elapsed() < time.Duration.from_seconds(60), "a virtual sleep waited in real time")?
    }

    // A digest of every event the simulation has run, in order: what was
    // delivered, when, and what each operation answered. Two simulations
    // opened with one seed that run one program report the same, so a test
    // can show that a run is repeatable.
    pub fn fingerprint(self: Self) -> UInt64 {
        linea_sim_fingerprint(self.identity)
    }

    test fn a_simulation_that_has_done_nothing_has_a_fixed_fingerprint() {
        let first = Simulation.open(seed: 3).unwrap()
        let second = Simulation.open(seed: 4).unwrap()
        let same = first.fingerprint() == second.fingerprint()
        first.close()
        second.close()
        testing.assert(same, "two simulations that did nothing differed")?
    }

    // End the simulation. What its network held is freed, and its Io names a
    // loop that has ended. A simulated descriptor kept past this point names
    // nothing: using it traps, and closing it only forgets it.
    pub fn close(sink self: Self) {
        let Simulation { identity } = self
        linea_sim_close(identity)
    }

    test fn a_closed_simulation_leaves_the_system_current() {
        var sim = Simulation.open(seed: 1).unwrap()
        &sim.run(|inout _world| {})
        sim.close()
        testing.assert_eq(current(), system(), "a closed simulation stayed current")?
    }
}

impl Release for Simulation {
    fn release(sink self: Self) {
        self.close()
    }
}

impl World {
    // Move the virtual clock `duration` forward, delivering what arrives
    // meanwhile. Nothing waits in real time.
    pub fn advance(inout self: Self, duration: time.Duration) {
        linea_sim_advance(self.identity, duration.nanoseconds())
    }

    test fn advancing_the_world_moves_the_virtual_clock_by_exactly_that_much() {
        var sim = Simulation.open(seed: 1).unwrap()
        let moved = &sim.run(
            |inout world| {
                let before = time.Instant.now()
                &world.advance(time.Duration.from_milliseconds(199))
                before.elapsed()
            },
        )
        sim.close()
        testing.assert_eq(moved, time.Duration.from_milliseconds(199), "the clock did not move by the advance")?
    }

    // Deliver `signal` to the simulation: every wait set inside it that
    // waits for the signal is woken, as a real delivery wakes them, and no
    // signal is sent to the process.
    pub fn deliver(inout self: Self, signal: Signal) {
        linea_signal_deliver_simulated(self.identity, signal.number())
    }

    test fn a_delivery_with_nothing_waiting_for_it_changes_nothing() {
        var sim = Simulation.open(seed: 2).unwrap()
        let moved = &sim.run(
            |inout world| {
                let before = time.Instant.now()
                &world.deliver(.Hangup)
                before.elapsed()
            },
        )
        sim.close()
        testing.assert_eq(moved, time.Duration.from_milliseconds(0), "delivering a signal moved the clock")?
    }
}
