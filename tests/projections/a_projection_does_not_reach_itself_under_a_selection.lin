// The chain is read off every bracket a path holds, not off the node the path
// ends at: a bracket standing under a field selection routes as surely as one
// written last, and an implementation reached only that way is on the chain.
struct Cell {
    w: UInt64,
}

struct Board {
    cells: [Cell; 2],
}

impl Index[UInt64] for Board {
    type Elem = UInt64

    proj at(inout self: Board, i: UInt64) -> UInt64 {
        self[^i].w
    }
}

impl Index[FromEnd] for Board {
    type Elem = Cell

    proj at(inout self: Board, _i: FromEnd) -> Cell {
        self.cells[self[0]]
    }
}

fn main() -> UInt8 {
    let b: Board = .{ cells = [.{ w = 0 }, .{ w = 1 }] }
    let v: UInt64 = b[1]
    let _ = v
    0
}
