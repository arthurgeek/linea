    let scaled = [self] |m: UInt8| {
        let step = [self] |k: UInt8| self.weight() + k
        twice(step, m) + step(m)
    }
    ;twice[closure0[Bool]$3aimpl[]$3aCrate](scaled, n) + closure.0[Bool][Crate](n)
}

fn ;twice[closure0[Bool]$3aimpl[]$3aCrate](f: closure0[Bool]:impl[]:Crate, n: UInt8) -> UInt8 {
    closure.0[Bool][Crate](n) + closure.0[Bool][Crate](n)
