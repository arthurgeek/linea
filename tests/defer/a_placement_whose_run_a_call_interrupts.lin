// A schedule is cancelled only where every place it takes is already gone,
// however the places are written.
//
// `take2` takes two, and the first reaches it through `hand`, which yields a
// value no place names between the two the placement takes. By the end of the
// scope `a` has been given to `take1` and `b` has been given to nobody, so the
// schedule can neither run nor be skipped: running it takes `a` twice, skipping
// it loses `b`. [O-Move] names the value that was already taken.
//
// Whether the schedule is spent is a question about the placement, so it is
// asked about every operation the placement makes. An unnamed value yielded
// between two of them is still part of the same placement.
@linear
struct Key {
    n: UInt8,
}

fn hand(sink k: Key) -> Key {
    k
}

fn take2(sink a: Key, sink b: Key, inout freed: UInt8) {
    let Key { n: _x } = a
    let Key { n: _y } = b
    freed = freed + 2
}

fn take1(sink k: Key, inout freed: UInt8) {
    let Key { n: _n } = k
    freed = freed + 1
}

fn maybe(c: Bool) -> Option[UInt8] {
    if c {
        Option.Some(1)
    } else {
        Option.None
    }
}

fn go(c: Bool, inout freed: UInt8) -> Option[UInt8] {
    let a: Key = .{ n = 1 }
    let b: Key = .{ n = 2 }
    defer take2(hand(a), b, &freed)
    let n = maybe(c)?
    take1(a, &freed)
    Option.Some(n)
}

fn main() -> UInt8 {
    var f: UInt8 = 0
    match go(true, &f) {
        Some(_n) => f,
        None => 0,
    }
}
