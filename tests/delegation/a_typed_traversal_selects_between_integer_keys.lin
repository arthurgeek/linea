struct Board { values: [UInt8; 2] }

impl Index[UInt64] for Board via values

impl Index[Int64] for Board via values

impl Board {
    trav positions = UInt64(0)..UInt64(2)
}

fn main() -> UInt8 {
    var board: Board = .{ values = [2, 3] }
    for inout value in board {
        value += 1
    }
    var total: UInt8 = 0
    for read value in board {
        total += value
    }
    return total - 7
}
