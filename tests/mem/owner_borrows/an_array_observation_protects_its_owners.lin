import std.mem

use mem.Arena
use mem.Lender
use mem.system

fn main() -> UInt8 {
    let first = Arena.open(system(), 64)
    let second = Arena.open(system(), 64)
    let handles = [first.handle(), second.handle()]
    first.release()
    var total: UInt64 = 0
    for handle in handles {
        let bytes = handle.acquire(8).unwrap()
        total += bytes.length()
        bytes.release()
    }
    second.release()
    UInt8(total)
}
