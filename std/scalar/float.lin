import std.mem
import std.testing

// The Float64 math methods `sqrt`, `floor`, `ceil`, `trunc`, `round`, `pow`,
// `sin`, `cos`, `ln` and `exp` take and return Float64 values. They allocate
// nothing, release nothing, return IEEE values for every input, and are not
// constant expressions. `sqrt` rounds the real square root to nearest, ties to
// even; `floor` rounds toward negative infinity, `ceil` toward positive
// infinity, `trunc` toward zero, and `round` to the nearest integer with halfway
// values choosing the even integer, and integral results remain Float64. These
// operations are exact subject to that rounding, preserve signed zero and
// infinity, propagate NaN, and do not flush subnormal inputs or outputs to zero.
// The square root of any value below zero, negative infinity included, is NaN.
// `abs` returns positive zero for either zero.
//
// `sin` and `cos` take radians, `ln` is the natural logarithm and `exp` the
// natural exponential. The precision of finite `pow`, `sin`, `cos`, `ln` and
// `exp` follows the target's platform math library and may vary with its version
// or configuration: there is no universal ULP bound or bitwise cross-platform
// identity, and no exact classification guarantee at finite transcendental
// overflow and underflow rounding boundaries. These special values hold
// regardless:
//
//   sin(+-0), cos(+-0)        the same signed zero; 1
//   sin(+-inf), cos(+-inf)    NaN
//   ln(+-0), ln(1), ln(+inf)  -inf; 0; +inf
//   ln(negative)              NaN
//   exp(+-0), exp(-inf), exp(+inf)   1; 0; +inf
//   any other NaN input       NaN, subject to the power identities below
//
// Power identities take priority over NaN propagation: `x.pow(+-0)` is 1,
// `1.pow(y)` is 1 and `(-1).pow(+-inf)` is 1. Otherwise a NaN operand yields
// NaN. A negative finite nonzero base with a finite nonintegral exponent yields
// NaN. For a signed zero or infinite base, positive exponents give respectively
// zero or infinity and negative exponents respectively infinity or zero; the
// sign is negative exactly when the base is negative and the exponent is an odd
// integer. Exponent integrality and parity are read from the binary64 value
// without a trapping integer conversion. For an infinite exponent, a base
// magnitude above one grows toward +inf for +inf and toward 0 for -inf, and a
// magnitude below one reverses these results; this also decides zero and
// infinite bases with infinite exponents.
//
// The runtime evaluates math under nearest-even rounding with gradual underflow
// and restores ambient foreign floating-point state and errno.

// The runtime computes these through the platform math library.
extern fn linea_math_sqrt(value: Float64) -> Float64

extern fn linea_math_floor(value: Float64) -> Float64

extern fn linea_math_ceil(value: Float64) -> Float64

extern fn linea_math_trunc(value: Float64) -> Float64

extern fn linea_math_round(value: Float64) -> Float64

extern fn linea_math_pow(value: Float64, exponent: Float64) -> Float64

extern fn linea_math_sin(value: Float64) -> Float64

extern fn linea_math_cos(value: Float64) -> Float64

extern fn linea_math_ln(value: Float64) -> Float64

extern fn linea_math_exp(value: Float64) -> Float64

impl Float64 {
    // Return the square root, correctly rounded to nearest even. A negative
    // input produces NaN, and -0.0 stays -0.0.
    pub fn sqrt(self: Self) -> Float64 {
        linea_math_sqrt(self)
    }

    test fn square_roots_preserve_zero_and_infinite_limits() {
        let infinity = 1.0 / 0.0
        testing.assert_eq(Float64.sqrt(9.0), 3.0, "square root of nine")?
        testing.assert_eq(Float64.sqrt(0.0), 0.0, "square root of zero")?
        testing.assert(1.0 / Float64.sqrt(-0.0) < 0.0, "square root preserves negative zero")?
        testing.assert_eq(infinity.sqrt(), infinity, "square root of infinity")?
        testing.assert(Float64.sqrt(-1.0).is_nan(), "negative square root is NaN")?
        testing.assert((0.0 / 0.0).sqrt().is_nan(), "square root preserves NaN")?
        testing.assert(Float64.sqrt(5e-324) > 0.0, "a subnormal square root stays positive")?
        .Ok(())
    }

    // Return the largest integral Float64 no greater than self.
    pub fn floor(self: Self) -> Float64 {
        linea_math_floor(self)
    }

    test fn floor_rounds_down_and_keeps_zero_infinity_and_nan() {
        let infinity = 1.0 / 0.0
        testing.assert_eq(Float64.floor(-2.5), -3.0, "floor goes down")?
        testing.assert_eq(Float64.floor(5e-324), 0.0, "floor a positive subnormal")?
        testing.assert_eq(infinity.floor(), infinity, "floor preserves infinity")?
        testing.assert(1.0 / Float64.floor(-0.0) < 0.0, "floor preserves negative zero")?
        testing.assert((0.0 / 0.0).floor().is_nan(), "floor preserves NaN")?
        .Ok(())
    }

    // Return the smallest integral Float64 no less than self. A negative value
    // above -1.0 rounds to -0.0.
    pub fn ceil(self: Self) -> Float64 {
        linea_math_ceil(self)
    }

    test fn ceil_rounds_up_and_keeps_the_sign_of_a_negative_fraction() {
        let infinity = 1.0 / 0.0
        testing.assert_eq(Float64.ceil(-2.5), -2.0, "ceil goes up")?
        testing.assert(1.0 / Float64.ceil(-5e-324) < 0.0, "ceil keeps subnormal sign")?
        testing.assert_eq(infinity.ceil(), infinity, "ceil preserves infinity")?
        testing.assert((0.0 / 0.0).ceil().is_nan(), "ceil preserves NaN")?
        .Ok(())
    }

    // Drop the fractional part, rounding toward zero and preserving the sign of
    // a zero result.
    pub fn trunc(self: Self) -> Float64 {
        linea_math_trunc(self)
    }

    test fn trunc_rounds_toward_zero_and_keeps_the_sign() {
        let infinity = 1.0 / 0.0
        testing.assert_eq(Float64.trunc(-2.5), -2.0, "trunc goes toward zero")?
        testing.assert(1.0 / Float64.trunc(-5e-324) < 0.0, "trunc keeps subnormal sign")?
        testing.assert_eq(infinity.trunc(), infinity, "trunc preserves infinity")?
        testing.assert((0.0 / 0.0).trunc().is_nan(), "trunc preserves NaN")?
        .Ok(())
    }

    // Return the nearest integral Float64, with halfway values rounded to even.
    pub fn round(self: Self) -> Float64 {
        linea_math_round(self)
    }

    test fn round_takes_halfway_values_to_even() {
        let infinity = 1.0 / 0.0
        testing.assert_eq(Float64.round(2.5), 2.0, "positive tie to lower even")?
        testing.assert_eq(Float64.round(3.5), 4.0, "positive tie to upper even")?
        testing.assert_eq(Float64.round(-2.5), -2.0, "negative tie to upper even")?
        testing.assert_eq(Float64.round(-3.5), -4.0, "negative tie to lower even")?
        testing.assert(1.0 / Float64.round(-0.5) < 0.0, "round keeps negative zero")?
        testing.assert_eq(infinity.round(), infinity, "round preserves infinity")?
        testing.assert((0.0 / 0.0).round().is_nan(), "round preserves NaN")?
        .Ok(())
    }

    // Raise self to `exponent`. A negative finite base needs an integral
    // exponent, or the result is NaN; a zero exponent or a base of one gives
    // 1.0 even with a NaN operand.
    pub fn pow(self: Self, exponent: Float64) -> Float64 {
        linea_math_pow(self, exponent)
    }

    test fn powers_prioritize_identities_and_preserve_odd_signs() {
        let infinity = 1.0 / 0.0
        let nan = 0.0 / 0.0
        testing.assert_eq(Float64.pow(2.0, exponent: 10.0), 1024.0, "an integral power")?
        testing.assert_eq(nan.pow(0.0), 1.0, "zero exponent precedes NaN")?
        testing.assert_eq(Float64.pow(1.0, nan), 1.0, "unit base precedes NaN")?
        testing.assert_eq(Float64.pow(-1.0, infinity), 1.0, "negative unit at infinite exponent")?
        testing.assert_eq(Float64.pow(-2.0, 3.0), -8.0, "negative base odd exponent")?
        testing.assert(Float64.pow(-2.0, 0.5).is_nan(), "negative base fractional exponent")?
        testing.assert(1.0 / Float64.pow(-0.0, 3.0) < 0.0, "negative zero odd power")?
        testing.assert_eq(Float64.pow(-0.0, -3.0), -infinity, "negative zero odd reciprocal")?
        testing.assert_eq((-infinity).pow(3.0), -infinity, "negative infinity odd power")?
        testing.assert(1.0 / (-infinity).pow(-3.0) < 0.0, "negative infinity odd reciprocal")?
        testing.assert_eq(Float64.pow(2.0, -infinity), 0.0, "large base with negative infinite exponent")?
        testing.assert_eq(Float64.pow(0.5, infinity), 0.0, "small base with positive infinite exponent")?
        testing.assert(nan.pow(2.0).is_nan(), "nonidentity NaN base")?
        testing.assert_eq(Float64.pow(0.0, -1.0), infinity, "positive zero to a negative power")?
        testing.assert(1.0 / Float64.pow(-0.0, 2.0) > 0.0, "negative zero even power is positive zero")?
        testing.assert_eq(Float64.pow(10.0, 400.0), infinity, "a power far past the largest finite value")?
        .Ok(())
    }

    // Return the sine of an angle in radians. Finite precision follows the
    // platform math library; an infinite angle produces NaN.
    pub fn sin(self: Self) -> Float64 {
        linea_math_sin(self)
    }

    test fn sine_uses_radians_and_preserves_special_values() {
        let pi = 3.141592653589793
        testing.assert((Float64.sin(pi / 2.0) - 1.0).abs() < 1e-12, "sine at a quarter turn")?
        testing.assert_eq(Float64.sin(0.0), 0.0, "sine at zero")?
        testing.assert(1.0 / Float64.sin(-0.0) < 0.0, "sine preserves negative zero")?
        testing.assert((1.0 / 0.0).sin().is_nan(), "an infinite angle has no sine")?
        testing.assert((0.0 / 0.0).sin().is_nan(), "sine preserves NaN")?
        .Ok(())
    }

    // Return the cosine of an angle in radians. Finite precision follows the
    // platform math library; an infinite angle produces NaN.
    pub fn cos(self: Self) -> Float64 {
        linea_math_cos(self)
    }

    test fn cosine_uses_radians_and_preserves_special_values() {
        let pi = 3.141592653589793
        testing.assert((pi.cos() + 1.0).abs() < 1e-12, "cosine at a half turn")?
        testing.assert_eq(Float64.cos(-0.0), 1.0, "cosine at negative zero")?
        testing.assert((1.0 / 0.0).cos().is_nan(), "an infinite angle has no cosine")?
        testing.assert((0.0 / 0.0).cos().is_nan(), "cosine preserves NaN")?
        .Ok(())
    }

    // Return the natural logarithm. Zero produces negative infinity; negative
    // inputs produce NaN.
    pub fn ln(self: Self) -> Float64 {
        linea_math_ln(self)
    }

    test fn a_logarithm_has_defined_limits() {
        let infinity = 1.0 / 0.0
        testing.assert_eq(Float64.ln(1.0), 0.0, "logarithm at one")?
        testing.assert_eq(Float64.ln(0.0), -infinity, "logarithm at zero limit")?
        testing.assert_eq(Float64.ln(-0.0), -infinity, "logarithm at negative zero limit")?
        testing.assert_eq(infinity.ln(), infinity, "logarithm at infinity")?
        testing.assert(Float64.ln(-1.0).is_nan(), "negative logarithm is NaN")?
        testing.assert((0.0 / 0.0).ln().is_nan(), "logarithm preserves NaN")?
        .Ok(())
    }

    // Return e raised to self. Finite precision follows the platform math
    // library; a result past the largest finite value is infinity.
    pub fn exp(self: Self) -> Float64 {
        linea_math_exp(self)
    }

    test fn an_exponential_has_defined_limits() {
        let infinity = 1.0 / 0.0
        testing.assert_eq(Float64.exp(0.0), 1.0, "exponential at zero")?
        testing.assert_eq(Float64.exp(-0.0), 1.0, "exponential at negative zero")?
        testing.assert_eq(infinity.exp(), infinity, "exponential at infinity")?
        testing.assert_eq(Float64.exp(1000.0), infinity, "an exponential far past the largest finite value")?
        testing.assert_eq((-infinity).exp(), 0.0, "exponential at negative infinity")?
        testing.assert((Float64.ln(2.0).exp() - 2.0).abs() < 1e-12, "logarithm and exponential round trip")?
        testing.assert((0.0 / 0.0).exp().is_nan(), "exponential preserves NaN")?
        .Ok(())
    }

    // Return whether self is NaN. NaN is the only floating-point value unequal
    // to itself.
    pub fn is_nan(self: Self) -> Bool {
        self != self
    }

    test fn a_nan_is_equal_to_nothing_including_itself() {
        let nan = 0.0 / 0.0

        testing.assert(nan.is_nan(), "a NaN does not say it is one")?

        testing.assert(nan != nan, "a NaN equals itself")?

        testing.assert(!Float64.is_nan(0.0), "zero says it is a NaN")?
        testing.assert(!Float64.is_nan(-1.5), "a negative says it is a NaN")?

        .Ok(())
    }

    // Negate negative values and return positive zero for either zero, so
    // the result never carries a sign. A NaN stays a NaN with its payload,
    // and its sign bit is cleared, as IEEE 754's `abs` and Rust's
    // `f64::abs` clear it.
    pub fn abs(self: Self) -> Float64 {
        if self.is_nan() {
            let sign_bit: UInt64 = 9223372036854775808
            Float64.from_bits(self.to_bits() % sign_bit)
        } else if self < 0.0 {
            -self
        } else if self == 0.0 {
            0.0
        } else {
            self
        }
    }

    test fn an_absolute_value_drops_the_sign_and_keeps_everything_else() {
        testing.assert_eq(Float64.abs(-2.5), 2.5, "absolute value of a negative float")?
        testing.assert_eq(Float64.abs(2.5), 2.5, "absolute value of a positive float")?

        testing.assert_eq(Float64.abs(0.0), 0.0, "absolute value of zero")?
        testing.assert(1.0 / Float64.abs(-0.0) > 0.0, "absolute value of negative zero keeps its sign")?

        let nan = 0.0 / 0.0
        testing.assert(nan.abs().is_nan(), "the magnitude of a NaN is not a NaN")?
        // A negative quiet NaN with a payload loses its sign and keeps the rest.
        let negative_nan: UInt64 = 18444492273895866369
        let positive_nan: UInt64 = 9221120237041090561
        testing.assert_eq(Float64.from_bits(negative_nan).abs().to_bits(), positive_nan, "the magnitude of a NaN kept its sign")?
        testing.assert_eq(Float64.from_bits(positive_nan).abs().to_bits(), positive_nan, "the magnitude of a positive NaN changed")?

        .Ok(())
    }

    // Return the value's IEEE 754 bits: the sign in bit 63, the exponent
    // biased by 1023 in bits 62 to 52, and the fraction below them. Every bit
    // is kept, a NaN's sign and payload included.
    pub fn to_bits(self: Self) -> UInt64 {
        mem.float64_to_bits(self)
    }

    test fn float64_bits_are_its_ieee_encoding() {
        testing.assert_eq(Float64.to_bits(1.0), UInt64(4607182418800017408), "one is not 0x3FF0000000000000")?
        let sign_bit: UInt64 = 9223372036854775808
        testing.assert_eq(Float64.to_bits(-0.0), sign_bit, "negative zero is not its sign bit")?
        testing.assert_eq(Float64.to_bits(5e-324), UInt64(1), "the smallest subnormal is not 1")?
        testing.assert_eq(Float64.to_bits(1.0 / 0.0), UInt64(9218868437227405312), "infinity changed")?
        .Ok(())
    }

    // Return the Float64 whose IEEE 754 bits are `bits`, every bit kept: any
    // NaN, sign and payload included, can be built this way.
    pub fn from_bits(bits: UInt64) -> Float64 {
        mem.float64_from_bits(bits)
    }

    test fn float64_from_bits_keeps_every_bit() {
        testing.assert_eq(Float64.from_bits(4607182418800017408), 1.0, "0x3FF0000000000000 is not one")?
        // A negative signalling NaN with a payload: exponent all ones, top
        // fraction bit clear, lowest fraction bit set.
        let signalling: UInt64 = 18442240474082181121
        testing.assert(Float64.from_bits(signalling).is_nan(), "the pattern is not a NaN")?
        testing.assert_eq(Float64.from_bits(signalling).to_bits(), signalling, "the NaN's payload changed")?
        .Ok(())
    }

    // Return whether self comes before `other` in IEEE 754's total order:
    // -NaN < -infinity < negative numbers < -0.0 < 0.0 < positive numbers <
    // infinity < NaN, with NaNs of one sign ordered by payload. It is a strict
    // total order on bit patterns, so `-0.0` comes before `0.0` and two values
    // tie only when their bits are equal; it is Rust's `f64::total_cmp`.
    // `values.sort_by(Float64.total_less)` sorts floats with every NaN the
    // program computes last. `<` is unchanged: it stays IEEE's partial order.
    pub fn total_less(self: Self, other: Self) -> Bool {
        self.total_key() < other.total_key()
    }

    // Map the value's bits to an unsigned key that orders as `total_less` does.
    // A set sign bit reverses the order of the negative patterns and puts them
    // below every positive one; a clear one lifts the positive patterns above
    // them. Neither branch can overflow.
    fn total_key(self: Self) -> UInt64 {
        let bits = self.to_bits()
        let sign_bit: UInt64 = 9223372036854775808
        if bits >= sign_bit {
            18446744073709551615 - bits
        } else {
            bits + sign_bit
        }
    }

    test fn float64_total_order_ranks_every_class() {
        // Each value comes strictly before the next: -NaN with the largest
        // payload, the negative quiet NaN, a negative signalling NaN, -infinity,
        // -max, -1, -min normal, -max subnormal, -min subnormal, -0, +0, then the
        // same magnitudes positive, then a positive signalling NaN, +qNaN and
        // +NaN with the largest payload.
        let ladder: [UInt64; _] = [
            18446744073709551615,
            18444492273895866368,
            18442240474082181121,
            18442240474082181120,
            18442240474082181119,
            13830554455654793216,
            9227875636482146304,
            9227875636482146303,
            9223372036854775809,
            9223372036854775808,
            0,
            1,
            4503599627370495,
            4503599627370496,
            4607182418800017408,
            9218868437227405311,
            9218868437227405312,
            9218868437227405313,
            9221120237041090560,
            9223372036854775807,
        ]
        for i in 0..ladder.length() {
            let left = Float64.from_bits(ladder[i])
            testing.assert(!left.total_less(left), "a value came before itself")?
            for j in i + 1..ladder.length() {
                let right = Float64.from_bits(ladder[j])
                testing.assert(left.total_less(right) && !right.total_less(left), "the total order misplaced a pair")?
            }
        }
        testing.assert(Float64.total_less(-0.0, 0.0) && -0.0 == 0.0, "signed zeros are equal yet not ordered")?
        // Away from the signed zeros the total order is `<`: infinities, the
        // largest finite values, normals, the smallest normals, subnormals and
        // positive zero.
        let infinity = 1.0 / 0.0
        let numbers = [-infinity, -1.7976931348623157e308, -3.5, -1.0, -2.2250738585072014e-308, -5e-324, 0.0, 5e-324, 2.2250738585072014e-308, 0.5, 2.0, 1e300, 1.7976931348623157e308, infinity]
        for i in 0..numbers.length() {
            for j in 0..numbers.length() {
                let left = numbers[i]
                let right = numbers[j]
                testing.assert_eq(left.total_less(right), left < right, "the total order disagrees with < on numbers")?
            }
        }
        .Ok(())
    }
}

impl Float32 {
    // Return whether self is NaN. NaN is the only floating-point value unequal
    // to itself.
    pub fn is_nan(self: Self) -> Bool {
        self != self
    }
}

test fn a_float32_nan_is_equal_to_nothing_including_itself() {
    let zero: Float32 = 0.0
    let nan = zero / zero
    testing.assert(nan.is_nan(), "a NaN does not say it is one")?
    testing.assert(!Float32.is_nan(-1.5), "a negative says it is a NaN")?
    .Ok(())
}

impl Float32 {
    // Negate negative values and return positive zero for either zero, so
    // the result never carries a sign. A NaN stays a NaN with its payload,
    // and its sign bit is cleared, as IEEE 754's `abs` and Rust's
    // `f32::abs` clear it.
    pub fn abs(self: Self) -> Float32 {
        if self.is_nan() {
            let sign_bit: UInt32 = 2147483648
            Float32.from_bits(self.to_bits() % sign_bit)
        } else if self < 0.0 {
            -self
        } else if self == 0.0 {
            0.0
        } else {
            self
        }
    }
}

test fn a_float32_absolute_value_drops_the_sign_and_keeps_everything_else() {
    testing.assert_eq(Float32.abs(-2.5), 2.5, "absolute value of a negative float")?
    testing.assert_eq(Float32.abs(2.5), 2.5, "absolute value of a positive float")?
    let zero: Float32 = 0.0
    testing.assert(1.0 / Float32.abs(-zero) > 0.0, "absolute value of negative zero keeps its sign")?
    testing.assert((zero / zero).abs().is_nan(), "the magnitude of a NaN is not a NaN")?
    let negative_nan: UInt32 = 4290772993
    let positive_nan: UInt32 = 2143289345
    testing.assert_eq(Float32.from_bits(negative_nan).abs().to_bits(), positive_nan, "the magnitude of a NaN kept its sign")?
    testing.assert_eq(Float32.from_bits(positive_nan).abs().to_bits(), positive_nan, "the magnitude of a positive NaN changed")?
    .Ok(())
}

impl Float32 {
    // Return the value's IEEE 754 bits: the sign in bit 31, the exponent
    // biased by 127 in bits 30 to 23, and the fraction below them. Every bit
    // is kept, a NaN's sign and payload included.
    pub fn to_bits(self: Self) -> UInt32 {
        mem.float32_to_bits(self)
    }

    test fn float32_bits_are_its_ieee_encoding() {
        testing.assert_eq(Float32.to_bits(1.0), UInt32(1065353216), "one is not 0x3F800000")?
        testing.assert_eq(Float32.to_bits(-0.0), UInt32(2147483648), "negative zero is not its sign bit")?
        testing.assert_eq(Float32.to_bits(1e-45), UInt32(1), "the smallest subnormal is not 1")?
        .Ok(())
    }

    // Return the Float32 whose IEEE 754 bits are `bits`, every bit kept.
    pub fn from_bits(bits: UInt32) -> Float32 {
        mem.float32_from_bits(bits)
    }

    test fn float32_from_bits_keeps_every_bit() {
        testing.assert_eq(Float32.from_bits(1065353216), 1.0, "0x3F800000 is not one")?
        let signalling: UInt32 = 4286578689
        testing.assert(Float32.from_bits(signalling).is_nan(), "the pattern is not a NaN")?
        testing.assert_eq(Float32.from_bits(signalling).to_bits(), signalling, "the NaN's payload changed")?
        .Ok(())
    }

    // Return whether self comes before `other` in IEEE 754's total order, as
    // `Float64.total_less` orders a Float64; it is Rust's `f32::total_cmp`.
    pub fn total_less(self: Self, other: Self) -> Bool {
        self.total_key() < other.total_key()
    }

    // Map the value's bits to an unsigned key that orders as `total_less`
    // does, as `Float64.total_key` does at 64 bits.
    fn total_key(self: Self) -> UInt32 {
        let bits = self.to_bits()
        let sign_bit: UInt32 = 2147483648
        if bits >= sign_bit {
            4294967295 - bits
        } else {
            bits + sign_bit
        }
    }

    test fn float32_total_order_ranks_every_class() {
        // The Float32 forms of the Float64 ladder above, in the same order.
        let ladder: [UInt32; _] = [
            4294967295,
            4290772992,
            4286578689,
            4286578688,
            4286578687,
            3212836864,
            2155872256,
            2155872255,
            2147483649,
            2147483648,
            0,
            1,
            8388607,
            8388608,
            1065353216,
            2139095039,
            2139095040,
            2139095041,
            2143289344,
            2147483647,
        ]
        for i in 0..ladder.length() {
            let left = Float32.from_bits(ladder[i])
            testing.assert(!left.total_less(left), "a value came before itself")?
            for j in i + 1..ladder.length() {
                let right = Float32.from_bits(ladder[j])
                testing.assert(left.total_less(right) && !right.total_less(left), "the total order misplaced a pair")?
            }
        }
        let nan_bits: UInt32 = 2143289345
        let nan = Float32.from_bits(nan_bits)
        let same_nan = Float32.from_bits(nan_bits)
        testing.assert(!nan.total_less(same_nan) && !same_nan.total_less(nan), "two NaNs with equal bits did not tie")?
        let zero: Float32 = 0.0
        testing.assert(Float32.total_less(-0.0, 0.0) && -zero == zero, "signed zeros are equal yet not ordered")?
        // Away from the signed zeros the total order is `<`, as for Float64.
        let infinity = 1.0 / zero
        let numbers: [Float32; _] = [-infinity, -3.4028235e38, -3.5, -1.0, -1.1754944e-38, -1e-45, 0.0, 1e-45, 1.1754944e-38, 0.5, 2.0, 3e38, 3.4028235e38, infinity]
        for i in 0..numbers.length() {
            for j in 0..numbers.length() {
                let left = numbers[i]
                let right = numbers[j]
                testing.assert_eq(left.total_less(right), left < right, "the total order disagrees with < on numbers")?
            }
        }
        .Ok(())
    }
}
