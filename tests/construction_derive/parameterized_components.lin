trait Count[A] {
    fn count(self: Self, _context: A) -> UInt64 where carries()
}

impl[A] Count[A] for UInt64 {
    fn count(self: UInt64, _context: A) -> UInt64 where carries() {
        self
    }
}

template impl[A] Count[A] where reflect.components: Count[A] {
    fn count(self: Self, _context: A) -> UInt64 where carries() {
        var total: UInt64 = 0
        match read self {
            reflect.case => {
                for component in reflect.components {
                    total += Count.count(component.of(self), _context)
                }
            },
        }
        total
    }
}

// `[A]` after `derive` binds a parameter only the trait's argument names, so
// `Plain` counts under every context `A`, and `Holder` under every context
// its value counts under.
@derive[A](Count[A])
struct Plain {
    value: UInt64,
}

@derive[A](Count[A] where T: Count[A])
struct Holder[T] {
    value: T,
}

fn main() -> UInt8 {
    let plain: Plain = .{ value = 3 }
    let holder: Holder[UInt64] = .{ value = 4 }
    let total = Count.count(plain, UInt8(1)) + Count.count(plain, true) + Count.count(holder, false)
    if total == 10 {
        0
    } else {
        1
    }
}
