import std.io

// `values` holds borrowed weights, and nothing in a vector of borrowed
// numbers can change `inspected`, so `main` may read the count while the
// vector is still in use.
fn main() -> Result[UInt8, io.IoError] {
    let weights = [UInt64(1200), 3500, 6400, 5000, 900]
    let limit: UInt64 = 5000
    var inspected: UInt64 = 0
    let accepted = weights.as_slice().filter(
        inout [limit, inout inspected] |parcel| {
            inspected += 1
            *parcel <= limit
        },
    )
    let { values, iterator: _ } = accepted.collect().settled() else |_| {
        io.println("Unable to allocate the manifest")?
        return .Ok(1)
    }
    let printed = io.println("{inspected} inspected, {values.length()} accepted")
    values.release()
    printed?
    .Ok(0)
}
