import std.mem

fn blank[let n: UInt64]() -> [UInt8; n] {
    mem.filled(0)
}

fn width[let n: UInt64, let m: UInt64, let depth: UInt64](_grid: [[[UInt8; n]; m]; depth]) -> UInt64 {
    n
}

fn width_of[T, let n: UInt64, let m: UInt64, let depth: UInt64](_grid: [[[T; n]; m]; depth]) -> UInt64 {
    n
}

fn main() -> UInt8 {
    let known_element = width([[blank()], [[1, 2]]])
    let inferred_element = width_of([[copy(blank())], [[1, 2, 3]]])
    UInt8(known_element + inferred_element)
}
