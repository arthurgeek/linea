import std.collections
import std.mem

// `merge` is lent its combine and may change it. `add` is a variable of
// `main`'s, so it is passed as `&add`.
fn main() -> UInt8 {
    var totals: collections.Map[UInt64, UInt64, mem.SystemAllocator] = collections.Map.new()
    var add = |sink current: UInt64, sink incoming: UInt64| current + incoming
    &totals.merge(7, 5, add).unwrap()
    &totals.merge(7, 3, add).unwrap()
    let total = *totals.get(7).unwrap()
    totals.release()
    UInt8(total)
}
