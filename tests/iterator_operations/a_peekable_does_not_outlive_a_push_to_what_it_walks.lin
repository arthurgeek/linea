// A peekable over a slice holds views of the vector's storage, in its source
// and in the item `peek` took. A push may move that storage, so the peekable
// cannot be used after it.
fn main() -> UInt8 {
    var readings: Vec[UInt8] = Vec.new()
    &readings.push(3).unwrap()
    &readings.push(5).unwrap()
    var upcoming = readings.as_slice().peekable()
    let first = **&upcoming.peek().unwrap()
    &readings.push(8).unwrap()
    let again = *&upcoming.next().unwrap()
    readings.release()
    first + again
}
