import std.fmt
import std.fs
import std.io
import std.log
import std.mem
import std.net
import std.task
import std.testing
import std.time

use io.BufferOpenFailure
use io.Reader
use task.Unowned

// A request buffer holds 4 KiB of input at a time.
let request_buffer_bytes: UInt64 = 4096

// Closing a socket whose input is unread resets the connection, and a peer
// that receives the reset may discard the response before reading it. After
// answering a request it did not read whole, whether refused or timed out, the
// server stops writing, then reads and discards input until the client
// closes, waiting for each read no longer than 500 ms or the read timeout,
// whichever is shorter, and reading at most 16 times 4 KiB.
let longest_linger_read_ms: UInt64 = 500

let linger_reads: UInt64 = 16

// `serve` stops with `Accept` when accepting a connection fails with an
// error that retrying does not answer, with `Close` when closing the listener
// fails, and, before accepting anything, with `ArenaTooSmall` when
// `limits.request_arena_bytes` cannot hold every request the limits admit,
// with `Memory` when `parent` refuses the buffer a 503 discards input into,
// with `NoWorkers` when the policy is `.Threads(0)`, which would answer
// nothing, with `Task` when the task that keeps a shared state cannot be
// started, and with `Handler` carrying why a serving task's handler could not
// be made, when its factory returns `Result[H, E]` and answers `.Err`. `E` is
// `Never` for a factory that cannot fail, so `http.ServeError` alone names
// the failures of serving with one.
@(copyable, derive(Equatable, Debug, Release))
pub enum ServeError[E = Never] {
    Accept(net.NetError),
    Close(io.IoError),
    ArenaTooSmall,
    Memory(mem.Oom),
    NoWorkers,
    NoConnections,
    Task(task.PrepareError),
    Handler(E),
}

impl[E: Display] Display for ServeError[E] {
    fn fmt[W: Writer](self: Self, inout w: W) -> Result[(), W.Error] {
        match read self {
            Handler(reason) => {
                &w.write_str("a serving task's handler could not be made: ")?
                reason.fmt(&w)
            },
            Accept(error) => net.ServeError.Accept(copy(error)).fmt(&w),
            Close(error) => net.ServeError.Close(copy(error)).fmt(&w),
            ArenaTooSmall => &w.write_str("the request arena cannot hold every request the limits admit"),
            NoWorkers => &w.write_str("a policy of no threads answers no request"),
            NoConnections => &w.write_str("the open-connections bound must allow a connection"),
            Task(reason) => {
                &w.write_str("the task that keeps the shared state could not be started: ")?
                reason.fmt(&w)
            },
            Memory(reason) => {
                &w.write_str("the parent refused the buffer a refused request is discarded into: ")?
                reason.fmt(&w)
            },
        }
    }
}

test fn a_serve_error_displays_its_cause() {
    let invalid = io.IoError { operation = .Accept, category = .InvalidDescriptor, code = .None, progress = 0 }
    let closing = io.IoError { operation = .Close, category = .InvalidDescriptor, code = .None, progress = 0 }
    let accept_error: ServeError = .Accept(.Io(invalid))
    defer let accept = fmt.render_owned(accept_error).unwrap()
    let close_error: ServeError = .Close(closing)
    defer let close = fmt.render_owned(close_error).unwrap()
    testing.assert_eq(accept.view(), "accepting a connection failed: Accept failed (InvalidDescriptor) after 0 bytes", "the accept failure changed")?
    testing.assert_eq(close.view(), "closing the listener failed: Close failed (InvalidDescriptor) after 0 bytes", "the close failure changed")?
    let small_error: ServeError = .ArenaTooSmall
    defer let small = fmt.render_owned(small_error).unwrap()
    testing.assert_eq(small.view(), "the request arena cannot hold every request the limits admit", "the arena refusal changed")?
    let memory_error: ServeError = .Memory(.Exhausted)
    defer let memory = fmt.render_owned(memory_error).unwrap()
    testing.assert_eq(memory.view(), "the parent refused the buffer a refused request is discarded into: Exhausted", "the memory refusal changed")?
    let none_error: ServeError = .NoWorkers
    defer let none = fmt.render_owned(none_error).unwrap()
    testing.assert_eq(none.view(), "a policy of no threads answers no request", "the empty policy's refusal changed")?
    let unstarted_error: ServeError = .Task(.Thread)
    defer let unstarted = fmt.render_owned(unstarted_error).unwrap()
    testing.assert_eq(unstarted.view(), "the task that keeps the shared state could not be started: Thread", "the task refusal changed")?
    let unopened: ServeError[Str] = .Handler("no such database")
    defer let unmade = fmt.render_owned(unopened).unwrap()
    testing.assert_eq(unmade.view(), "a serving task's handler could not be made: no such database", "the handler failure changed")?
    .Ok(())
}

// Accept connections on `listener` and answer the requests on each through a
// handler, on as many tasks as `policy` allows: `.Threads(n)` serves up to `n`
// connections at once, and `.Sequential` one at a time. Each task builds its
// own handler with `make_handler` and keeps it for every connection it serves,
// so no handler is reached by two tasks and none needs a lock, and releases it
// once serving ends. A handler may own what its task alone uses, such as a
// database connection, which is closed when the handler is released. Nothing
// is accepted until every task has made its handler. A factory that can fail
// returns `Result[H, E]`, and when it answers `.Err` on any task, serving
// ends with `Handler` carrying that `E` before anything is accepted. A
// program whose handlers share state serves through `listen_and_serve_with`,
// which keeps that state in an owning task. Each task keeps one arena of
// `limits.request_arena_bytes` carved from the system allocator, or from the
// `parent` `serve_in` takes: each request is read into it, the handler builds
// its response in it, and once the response is written the arena is rewound.
// The arena takes a 64 KiB first chunk from the parent when it opens and
// further chunks only as a request needs them, and rewinding zeroes only the
// bytes that exchange used and gives every chunk but the first back to the
// parent, so a task between requests holds 64 KiB however large the arena
// is. When `parent` refuses the arena's first chunk, the request is answered
// 503 and the arena is opened again for the next; a parent that refuses a
// later chunk refuses the reservation that needed it, which answers 500. The 503
// discards the unread request into a 4 KiB buffer each task takes from
// `parent` once, before it serves anything, so a parent that refuses every
// arena still has each client read its 503 rather than a reset. Once each
// exchange has ended, serving tells that task's handler how through
// `observe`, failures included, and continues; it writes nothing to standard
// error of its own. A reset connection or running out of descriptors while
// accepting is reported the same way and retried after a pause that grows
// while the failure repeats; any other accept failure ends serving with
// `Accept`. Serving ends with `Ok` after `limits.connections` connections, and
// never ends when that is `.None`. Every task is joined and the listener is
// closed on every exit.
pub fn serve[L: net.Acceptor + io.Close + io.Pollable + Owned + Shareable + Isolated, R: MadeHandler[mem.SystemAllocator], M: Shareable + Copyable + fn() -> R](sink listener: L, make_handler: M, limits: Limits = standard_limits, policy: task.Policy = .Threads(128), shutdown: Shutdown = .OnSignals, on: io.Io = io.inherited) -> Result[(), ServeError[R.Error]] where L.CloseError: Into[io.IoError], R.Handler: Handler[(), mem.SystemAllocator] + Observer + Release, R.Error: Owned + Shareable + Release {
    serve_made(listener, mem.system(), make_handler, limits, policy, .None, shutdown, on)
}

test fn serving_answers_each_client_on_its_own_task() {
    let listener = net.listen(net.loopback(0)).unwrap()
    let bound = listener.local_address().unwrap()
    let client1 = send(bound, health_request)
    let client2 = send(bound, health_request)
    let served = serve(listener, health_router, limits: serving(2), policy: .Threads(2))
    defer let r1 = read_to_end(client1)
    defer let r2 = read_to_end(client2)
    testing.assert_ok_eq(served, (), "serving on two tasks failed")?
    testing.assert_eq(r1.view(), health_answer, "the first client was not answered")?
    testing.assert_eq(r2.view(), health_answer, "the second client was not answered")?
    .Ok(())
}

test fn a_policy_of_no_threads_is_refused_and_closes_the_listener() {
    let listener = net.listen(net.loopback(0)).unwrap()
    let bound = listener.local_address().unwrap()
    let served = serve(listener, health_router, limits: standard_limits, policy: .Threads(0))
    let refused = match net.connect(bound) {
        Ok(connection) => {
            connection.close().unwrap()
            false
        },
        Err(_) => true,
    }
    testing.assert_eq(served, .Err(.NoWorkers), "a policy of no threads was not refused")?
    testing.assert(refused, "the listener was left open")?
    .Ok(())
}

test fn a_handler_a_sequential_server_cannot_make_closes_the_listener() {
    let listener = net.listen(net.loopback(0)).unwrap()
    let bound = listener.local_address().unwrap()
    let served = serve(listener, no_database, policy: .Sequential)
    let refused = match net.connect(bound) {
        Ok(connection) => {
            connection.close().unwrap()
            false
        },
        Err(_) => true,
    }
    testing.assert_eq(served, .Err(.Handler(.NoDatabase)), "a handler that could not be made did not end serving")?
    testing.assert(refused, "the listener was left open")?
    .Ok(())
}

test fn serving_by_default_answers_two_requests_at_once() {
    let listener = net.listen(net.loopback(0)).unwrap()
    let bound = listener.local_address().unwrap()
    let client1 = send(bound, health_request)
    let client2 = send(bound, health_request)
    let owner = task.own(Tally { visits = 0 }).unwrap()
    let counter = owner.client()
    let made = [sink counter] || -> Stated[task.Client[Tally], Router[task.Client[Tally]]] where carries(counter) with_state(copy(counter), meeting_router())
    let served = serve(listener, made, limits: serving(2))
    let tally = owner.close()
    defer let r1 = read_to_end(client1)
    defer let r2 = read_to_end(client2)
    testing.assert_ok_eq(served, (), "serving failed")?
    testing.assert_eq(tally.visits, UInt64(2), "a request was not counted")?
    testing.assert_eq(r1.view(), health_answer, "the first request did not meet the second")?
    testing.assert_eq(r2.view(), health_answer, "the second request did not meet the first")?
    .Ok(())
}

test fn sequential_routing_with_path_parameters() {
    let listener = net.listen(net.loopback(0)).unwrap()
    let bound = listener.local_address().unwrap()
    let client1 = send(bound, "GET /items/alpha HTTP/1.1\r\nHost: loopback\r\n\r\n")
    let client2 = send(bound, "GET /items/beta HTTP/1.1\r\nHost: loopback\r\n\r\n")
    let served = serve(listener, items_router, limits: serving(2), policy: .Sequential)
    defer let r1 = read_to_end(client1)
    defer let r2 = read_to_end(client2)
    testing.assert_ok_eq(served, (), "sequential serving failed")?
    testing.assert(r1.view().find("alpha").is_some(), "first request did not get its path value")?
    testing.assert(r2.view().find("beta").is_some(), "second request did not get its path value")?
    .Ok(())
}

test fn each_task_routes_path_parameters_through_its_own_router() {
    let listener = net.listen(net.loopback(0)).unwrap()
    let bound = listener.local_address().unwrap()
    let client1 = send(bound, "GET /items/alpha HTTP/1.1\r\nHost: loopback\r\n\r\n")
    let client2 = send(bound, "GET /items/beta HTTP/1.1\r\nHost: loopback\r\n\r\n")
    let served = serve(listener, items_router, limits: serving(2), policy: .Threads(2))
    defer let r1 = read_to_end(client1)
    defer let r2 = read_to_end(client2)
    testing.assert_ok_eq(served, (), "serving on two tasks failed")?
    testing.assert(r1.view().find("alpha").is_some(), "first request did not get its path value")?
    testing.assert(r2.view().find("beta").is_some(), "second request did not get its path value")?
    .Ok(())
}

test fn one_connection_is_served_and_serve_returns() {
    let listener = net.listen(net.loopback(0)).unwrap()
    // The backlog queues the connection before serve accepts it.
    let client = send(listener.local_address().unwrap(), health_request)
    let served = serve(listener, health_router, limits: serving(1), policy: .Sequential)
    defer let received = read_to_end(client)
    testing.assert_ok_eq(served, (), "serving failed")?
    testing.assert_eq(received.view(), health_answer, "the request was not answered")?
    .Ok(())
}

test fn a_malformed_request_is_answered_and_serving_continues() {
    let listener = net.listen(net.loopback(0)).unwrap()
    let bound = listener.local_address().unwrap()
    let malformed = send(bound, "garbage\r\n\r\n")
    let valid = send(bound, health_request)
    let served = serve(listener, health_router, limits: serving(2), policy: .Sequential)
    defer let refused = read_to_end(malformed)
    defer let answered = read_to_end(valid)
    testing.assert_ok_eq(served, (), "serving failed")?
    testing.assert_eq(refused.view(), "HTTP/1.1 400 Bad Request\r\nConnection: close\r\nContent-Type: text/plain; charset=utf-8\r\n\r\n", "the malformed request was not refused")?
    testing.assert_eq(answered.view(), health_answer, "the next request was not answered")?
    .Ok(())
}

test fn a_silent_client_times_out_and_the_next_is_served() {
    let listener = net.listen(net.loopback(0)).unwrap()
    let bound = listener.local_address().unwrap()
    net.connect(bound).unwrap().close().unwrap()
    let silent = net.connect(bound).unwrap()
    let partial = send(bound, "GET /health ")
    let valid = send(bound, health_request)
    let limits = Limits { first_byte_timeout_ms = 50, read_timeout_ms = 100, ..serving(4) }
    let served = serve(listener, health_router, limits: limits, policy: .Sequential)
    defer let idle = read_to_end(silent)
    defer let timed_out = read_to_end(partial)
    defer let answered = read_to_end(valid)
    testing.assert_ok_eq(served, (), "serving failed")?
    testing.assert_eq(idle.view(), "", "an idle client that sent no byte was answered")?
    testing.assert_eq(timed_out.view(), "HTTP/1.1 408 Request Timeout\r\nConnection: close\r\nContent-Type: text/plain; charset=utf-8\r\n\r\n", "a partial request that timed out was not answered 408")?
    testing.assert_eq(answered.view(), health_answer, "the next request was not answered")?
    .Ok(())
}

test fn a_client_reset_before_accept_never_stops_serving_and_the_next_is_served() {
    let listener = net.listen(net.loopback(0)).unwrap()
    let bound = listener.local_address().unwrap()
    send(bound, "GET /health HTTP/1.1\r\nHost: a\r\n").reset().unwrap()
    let valid = send(bound, health_request)
    // The reset reaches the listener before or after serve accepts the
    // connection. Unaccepted, the accept failure is retried and not counted;
    // accepted, its failed read is logged and it counts as served. `extra`
    // gives serve a second connection to count in the first case, so serving
    // ends either way, and only `valid`'s answer is asserted.
    let extra = send(bound, health_request)
    let served = serve(listener, health_router, limits: serving(2), policy: .Sequential)
    defer let answered = read_to_end(valid)
    let _extra_closed = extra.close()
    testing.assert_ok_eq(served, (), "serving failed")?
    testing.assert_eq(answered.view(), health_answer, "the next request was not answered")?
    .Ok(())
}

test fn a_refused_body_left_unread_does_not_lose_the_answer() {
    let listener = net.listen(net.loopback(0)).unwrap()
    var client = send(listener.local_address().unwrap(), "POST /health HTTP/1.1\r\nHost: loopback\r\nContent-Length: 20000\r\n\r\n")
    // 200 writes of 100 bytes send the whole 20000-byte body.
    let chunk = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    for _ in 0..200 {
        let _sent = io.write_all(&client, chunk.as_bytes()).unwrap()
    }
    let limits = Limits { max_body_bytes = 16, ..serving(1) }
    let served = serve(listener, health_router, limits: limits, policy: .Sequential)
    defer let received = read_to_end(client)
    testing.assert_ok_eq(served, (), "serving failed")?
    testing.assert_eq(received.view(), "HTTP/1.1 413 Content Too Large\r\nConnection: close\r\nContent-Type: text/plain; charset=utf-8\r\n\r\n", "the refusal was lost")?
    .Ok(())
}

test fn a_handler_error_before_headers_answers_its_status() {
    let listener = net.listen(net.loopback(0)).unwrap()
    let client = send(listener.local_address().unwrap(), health_request)
    let served = serve(listener, unprocessable, limits: serving(1), policy: .Sequential)
    defer let received = read_to_end(client)
    testing.assert_ok_eq(served, (), "serving failed")?
    testing.assert_eq(received.view(), "HTTP/1.1 422 Unprocessable Content\r\nConnection: close\r\nContent-Type: text/plain; charset=utf-8\r\n\r\nUnprocessable Content\n", "the handler's status was not answered")?
    .Ok(())
}

test fn a_streamed_answer_goes_out_as_it_is_written() {
    let listener = net.listen(net.loopback(0)).unwrap()
    let bound = listener.local_address().unwrap()
    let counted = send(bound, "GET /count HTTP/1.1\r\nHost: loopback\r\n\r\n")
    let broken = send(bound, "GET /broken HTTP/1.1\r\nHost: loopback\r\n\r\n")
    let served = serve(listener, system_exchanges_router, limits: serving(2), policy: .Sequential)
    defer let full = read_to_end(counted)
    defer let cut = read_or_reset(broken)
    testing.assert_ok_eq(served, (), "serving failed")?
    testing.assert_eq(full.view(), "HTTP/1.1 200 OK\r\nConnection: close\r\nContent-Type: text/plain; charset=utf-8\r\n\r\n1\n2\n3\n", "the stream changed")?
    // A stream that fails resets its connection, so the client does not
    // mistake the part it received for the whole body.
    testing.assert_eq(cut.view(), "reset", "a failed stream ended as if whole")?
    .Ok(())
}

test fn transient_accept_failures_are_retried_until_a_connection_is_served() {
    let listener = net.listen(net.loopback(0)).unwrap()
    let client = send(listener.local_address().unwrap(), health_request)
    let exhausted = io.IoError { operation = .Accept, category = .ResourceExhausted, code = .None, progress = 0 }
    let reset = io.IoError { operation = .Accept, category = .ConnectionReset, code = .None, progress = 0 }
    let scripted = net.scripted(listener, [.Some(.Io(exhausted)), .Some(.Io(reset)), .None, .None], .None)
    let served = serve(scripted, health_router, limits: serving(1), policy: .Sequential)
    defer let received = read_to_end(client)
    testing.assert_eq(served, .Ok(()), "serving did not retry")?
    testing.assert_eq(received.view(), health_answer, "the connection after the failures was not answered")?
    .Ok(())
}

// Each retried accept failure is reported to the observer with the pause
// before the retry, which doubles while failures repeat and starts again at 5
// ms once a connection has been accepted.
test fn each_accept_retry_is_observed_with_its_pause() {
    let listener = net.listen(net.loopback(0)).unwrap()
    let bound = listener.local_address().unwrap()
    let first = send(bound, health_request)
    let second = send(bound, health_request)
    let exhausted = io.IoError { operation = .Accept, category = .ResourceExhausted, code = .None, progress = 0 }
    let reset = io.IoError { operation = .Accept, category = .ConnectionReset, code = .None, progress = 0 }
    let scripted = net.scripted(listener, [.Some(.Io(copy(exhausted))), .Some(.Io(reset)), .None, .Some(.Io(exhausted))], .None)
    let owner = task.own(Recorded.new()).unwrap()
    let recorder = owner.client()
    let made = [sink recorder] || -> Reporter where carries(recorder) Reporter { recorded = copy(recorder) }
    let served = serve(scripted, made, limits: serving(2), policy: .Sequential)
    let recorded = owner.close()
    defer let answered = read_to_end(first)
    defer let also_answered = read_to_end(second)
    testing.assert_ok_eq(served, (), "serving failed")?
    testing.assert_eq(recorded.exchanges, UInt64(2), "an exchange was not reported")?
    testing.assert_eq(recorded.retries, UInt64(3), "an accept retry was not reported")?
    testing.assert_eq(recorded.pauses_ms, [UInt64(5), 10, 5, 0], "the pauses before the retries changed")?
    .Ok(())
}

test fn a_fatal_accept_failure_ends_serving_and_closes_the_listener() {
    let listener = net.listen(net.loopback(0)).unwrap()
    let bound = listener.local_address().unwrap()
    let invalid = io.IoError { operation = .Accept, category = .InvalidDescriptor, code = .None, progress = 0 }
    let scripted = net.scripted(listener, [.Some(.Io(copy(invalid))), .None, .None, .None], .None)
    let served = serve(scripted, health_router, limits: serving(1), policy: .Sequential)
    let refused = match net.connect(bound) {
        Ok(connection) => {
            connection.close().unwrap()
            false
        },
        Err(_) => true,
    }
    testing.assert_eq(served, .Err(.Accept(.Io(invalid))), "a fatal accept failure did not end serving")?
    testing.assert(refused, "the listener was left open")?
    .Ok(())
}

test fn a_failed_listener_close_ends_serving_with_close() {
    let listener = net.listen(net.loopback(0)).unwrap()
    let failure = io.IoError { operation = .Close, category = .InvalidDescriptor, code = .None, progress = 0 }
    let scripted = net.scripted(listener, [.None, .None, .None, .None], .Some(copy(failure)))
    let served = serve(scripted, health_router, limits: serving(0), policy: .Sequential)
    testing.assert_eq(served, .Err(.Close(failure)), "a failed close was not reported")?
    .Ok(())
}

test fn an_arena_below_the_metadata_requirement_is_refused_before_serving() {
    let listener = net.listen(net.loopback(0)).unwrap()
    let bound = listener.local_address().unwrap()
    let limits = serving(1)
    // The field reads `limits` before the base takes it.
    let refused = serve(listener, health_router, limits: Limits { request_arena_bytes = smallest_arena(limits) - 1, ..limits })
    let closed = match net.connect(bound) {
        Ok(connection) => {
            connection.close().unwrap()
            false
        },
        Err(_) => true,
    }
    testing.assert_eq(refused, .Err(.ArenaTooSmall), "a small arena was accepted")?
    testing.assert(closed, "the listener was left open")?
    .Ok(())
}

// Limits too large for any arena to hold are refused as an arena too small,
// whichever limit is large and however large the arena asked for is.
test fn limits_beyond_every_arena_are_refused_without_overflowing() {
    let huge = UInt64.max
    let candidates = [
        Limits { max_line_bytes = 9000000000000000000, ..serving(0) },
        Limits { max_headers = huge, ..serving(0) },
        Limits { max_query_pairs = huge, ..serving(0) },
        Limits { max_line_bytes = huge, max_headers = huge, max_body_bytes = huge, max_query_pairs = huge, max_form_pairs = huge, request_arena_bytes = huge, ..serving(0) },
    ]
    var refused = true
    for limits in candidates {
        let listener = net.listen(net.loopback(0)).unwrap()
        let answer = serve(listener, health_router, limits: limits)
        refused = refused && answer == .Err(.ArenaTooSmall)
    }
    testing.assert(refused, "limits beyond every arena were not refused with ArenaTooSmall")?
    .Ok(())
}

// `serve_in` serves as `serve` does, carving each task's arenas, and the
// buffer a refused request is discarded into, from `parent`, which every task
// reads, so it must be `Shareable`.
pub fn serve_in[P: Allocator + Shareable, L: net.Acceptor + io.Close + io.Pollable + Owned + Shareable + Isolated, R: MadeHandler[P], M: Shareable + Copyable + fn() -> R](parent: P, sink listener: L, make_handler: M, limits: Limits = standard_limits, policy: task.Policy = .Threads(128), shutdown: Shutdown = .OnSignals, on: io.Io = io.inherited) -> Result[(), ServeError[R.Error]] where L.CloseError: Into[io.IoError], R.Handler: Handler[(), P] + Observer + Release, R.Error: Owned + Shareable + Release {
    serve_made(listener, parent, make_handler, limits, policy, .None, shutdown, on)
}

test fn serving_in_the_system_allocator_answers_a_request() {
    let listener = net.listen(net.loopback(0)).unwrap()
    let client = send(listener.local_address().unwrap(), health_request)
    let served = serve_in(mem.system(), listener, health_router, limits: serving(1))
    defer let received = read_to_end(client)
    testing.assert_ok_eq(served, (), "serving in the system allocator failed")?
    testing.assert_eq(received.view(), health_answer, "the request was not answered")?
    .Ok(())
}

// Four tasks each ask the factory for a handler, and the third it is asked
// for cannot be made. No client is answered, serving ends with `Handler`
// although no connection limit would end it, and the handlers that were made,
// with every arena, are released.
test fn a_handler_one_task_cannot_make_ends_serving_before_anything_is_accepted() {
    let listener = net.listen(net.loopback(0)).unwrap()
    let client = send(listener.local_address().unwrap(), health_request)
    defer let tables = testing.SharedAllocationLog.open(mem.system(), 0).unwrap()
    let owner = task.own(Tally { visits = 0 }).unwrap()
    let counter = owner.client()
    let routes = tables.allocator()
    let made = [sink counter, sink routes] || -> Result[LoggedRouter, Unopened] where carries(counter, routes) {
        if counted(counter) == 3 {
            .Err(.NoDatabase)
        } else {
            .Ok(exchanges_router(routes))
        }
    }
    let served = serve_in(tables.allocator(), listener, made, policy: .Threads(4))
    let tally = owner.close()
    defer let answer = read_or_reset(client)
    testing.assert_eq(served, .Err(.Handler(.NoDatabase)), "a handler that could not be made did not end serving")?
    testing.assert(tally.visits >= 3, "a task did not ask the factory for its handler")?
    testing.assert(answer.view() == "" || answer.view() == "reset", "a client was answered before every handler was made")?
    testing.assert(tables.all_disposed(), "a handler that was made was not released")?
    .Ok(())
}

// Two of four tasks fail to make their handlers, each with an error that
// owns its text. Serving ends with one of them as `Handler`, the other one
// is released when the two tasks' answers are joined, and every handler that
// was made is released.
test fn two_tasks_failing_with_owned_reasons_report_one_and_release_the_other() {
    let listener = net.listen(net.loopback(0)).unwrap()
    defer let tables = testing.SharedAllocationLog.open(mem.system(), 0).unwrap()
    let owner = task.own(Tally { visits = 0 }).unwrap()
    let counter = owner.client()
    let routes = tables.allocator()
    let made = [sink counter, sink routes] || -> Result[LoggedRouter, Unreadable] where carries(counter, routes) {
        if counted(counter) % 2 == 0 {
            .Err(Unreadable { reason = "the routes could not be read".to_owned().unwrap() })
        } else {
            .Ok(exchanges_router(routes))
        }
    }
    let served = serve_in(tables.allocator(), listener, made, policy: .Threads(4))
    let tally = owner.close()
    let reported = match served {
        Err(Handler(error)) => {
            let worded = error.reason.view() == "the routes could not be read"
            error.release()
            worded
        },
        Err(other) => {
            other.release()
            false
        },
        Ok(_) => false,
    }
    testing.assert(reported, "a handler that could not be made did not end serving with its reason")?
    testing.assert(tally.visits >= 2, "a task did not ask the factory for its handler")?
    testing.assert(tables.all_disposed(), "a handler that was made was not released")?
    .Ok(())
}

// Serving opens one arena over the parent for every kind of exchange and gives
// back everything it took: an answer, a streamed answer, a stream that fails,
// an error, a path value, a HEAD request, a refused request, a silent client
// and a handler that fills the arena. The arena's first chunk and the discard
// buffer are acquired once each, and the chunks the filling handler grows the
// arena by are given back when it is rewound. Each exchange starts from a
// rewound arena.
test fn every_exchange_returns_its_arena_to_the_parent() {
    let listener = net.listen(net.loopback(0)).unwrap()
    let bound = listener.local_address().unwrap()
    let requests = [
        health_request,
        "GET /count HTTP/1.1\r\nHost: loopback\r\n\r\n",
        "GET /broken HTTP/1.1\r\nHost: loopback\r\n\r\n",
        "GET /nowhere HTTP/1.1\r\nHost: loopback\r\n\r\n",
        "GET /echo/a%20b HTTP/1.1\r\nHost: loopback\r\n\r\n",
        "HEAD /count HTTP/1.1\r\nHost: loopback\r\n\r\n",
        "garbage\r\n\r\n",
        "",
        "GET /health ",
        "GET /fill HTTP/1.1\r\nHost: loopback\r\n\r\n",
    ]
    var clients: Vec[net.Connection] = Vec.new()
    for request in requests {
        &clients.push(send(bound, request)).unwrap()
    }
    let parent = testing.SharedAllocationLog.open(mem.system(), 0).unwrap()
    let tables = testing.SharedAllocationLog.open(mem.system(), 0).unwrap()
    let limits = Limits {
        first_byte_timeout_ms = 50,
        read_timeout_ms = 100,
        max_line_bytes = 1024,
        max_headers = 4,
        max_body_bytes = 16384,
        request_arena_bytes = 98304,
        ..serving(10),
    }
    let routes = tables.allocator()
    let made = [sink routes] || -> LoggedRouter where carries(routes) exchanges_router(routes)
    let served = serve_in(parent.allocator(), listener, made, limits, policy: .Sequential)
    let settled = parent.all_disposed()
    let acquired = parent.acquired()
    let tables_settled = tables.all_disposed()
    parent.release()
    tables.release()
    var answers: Vec[String] = Vec.new()
    var pending = clients.drain()
    for client in &pending {
        &answers.push(read_or_reset(client)).unwrap()
    }
    pending.finish().unwrap()
    defer let first_lines = status_lines(answers)
    answers.release()
    testing.assert_ok_eq(served, (), "serving failed")?
    testing.assert(settled, "an exchange kept an allocation from the parent")?
    // Beside the arena's first chunk and the discard buffer, the handler that
    // fills the arena grows it by at least one chunk.
    testing.assert(acquired > 2, "a handler filling the arena did not grow it past its first chunk")?
    testing.assert(tables_settled, "the router kept an allocation after its release")?
    testing.assert_eq(first_lines.view(), "200 OK|200 OK|reset|404 Not Found|200 OK|200 OK|400 Bad Request||408 Request Timeout|500 Internal Server Error|", "an exchange was answered wrongly")?
    .Ok(())
}

// A parent that refuses the arena is answered 503, and serving opens the arena
// again for the next connection.
test fn a_refused_arena_is_answered_503() {
    let listener = net.listen(net.loopback(0)).unwrap()
    let bound = listener.local_address().unwrap()
    let refused = send(bound, health_request)
    let valid = send(bound, health_request)
    let parent = testing.SharedAllocationLog.open(mem.system(), 0).unwrap()
    let limits = serving(2)
    parent.refuse_size_attempt(mem.arena_first_chunk_bytes, 1)
    let routes = parent.allocator()
    let made = [sink routes] || -> LoggedRouter where carries(routes) exchanges_router(routes)
    let served = serve_in(parent.allocator(), listener, made, limits, policy: .Sequential)
    let settled = parent.all_disposed()
    parent.release()
    defer let unavailable = read_to_end(refused)
    defer let answered = read_to_end(valid)
    testing.assert_ok_eq(served, (), "serving failed")?
    testing.assert(settled, "an exchange kept an allocation from the parent")?
    testing.assert_eq(unavailable.view(), "HTTP/1.1 503 Service Unavailable\r\nConnection: close\r\nContent-Type: text/plain; charset=utf-8\r\n\r\n", "a refused arena was not answered 503")?
    testing.assert_eq(answered.view(), health_answer, "the next request was not answered")?
    .Ok(())
}

// A parent that can never hold a request arena still has every connection
// answered 503, so the client reads the answer the observer reports rather
// than a reset.
test fn every_connection_is_answered_503_while_the_parent_refuses_the_arena() {
    let listener = net.listen(net.loopback(0)).unwrap()
    let bound = listener.local_address().unwrap()
    let first = send(bound, health_request)
    let second = send(bound, health_request)
    defer let parent = testing.SharedAllocationLog.open(mem.system(), 0).unwrap()
    let limits = Limits {
        read_timeout_ms = 100,
        max_line_bytes = 1024,
        max_headers = 4,
        max_body_bytes = 16384,
        request_arena_bytes = 98304,
        ..serving(2),
    }
    parent.refuse_size_from(mem.arena_first_chunk_bytes, 1)
    let routes = parent.allocator()
    let made = [sink routes] || -> LoggedRouter where carries(routes) exchanges_router(routes)
    let served = serve_in(parent.allocator(), listener, made, limits, policy: .Threads(2))
    let settled = parent.all_disposed()
    defer let answered_first = read_or_reset(first)
    defer let answered_second = read_or_reset(second)
    testing.assert_ok_eq(served, (), "serving failed")?
    testing.assert_eq(answered_first.view(), unavailable_answer, "the first refused connection was not answered 503")?
    testing.assert_eq(answered_second.view(), unavailable_answer, "the second refused connection was not answered 503")?
    testing.assert(settled, "serving kept an allocation from the parent")?
    .Ok(())
}

test fn a_parent_that_refuses_the_discard_buffer_ends_serving_before_accepting() {
    let listener = net.listen(net.loopback(0)).unwrap()
    defer let parent = testing.SharedAllocationLog.open(mem.system(), 0).unwrap()
    parent.refuse_size_from(request_buffer_bytes, 1)
    let routes = parent.allocator()
    let made = [sink routes] || -> LoggedRouter where carries(routes) exchanges_router(routes)
    let served = serve_in(parent.allocator(), listener, made, serving(1), policy: .Sequential)
    testing.assert_eq(served, .Err(.Memory(.Exhausted)), "serving began without a buffer to discard refused input into")?
    .Ok(())
}

// The caller owns the dispatcher; idle connections occupy registrations, not tasks.
fn serve_made[L: net.Acceptor + io.Close + io.Pollable + Owned + Shareable + Isolated, P: Allocator + Shareable, R: MadeHandler[P], M: Shareable + Copyable + fn() -> R](sink listener: L, parent: P, make_handler: M, limits: Limits, policy: task.Policy, announce: Option[net.Address], shutdown: Shutdown = .OnSignals, on: io.Io = io.inherited) -> Result[(), ServeError[R.Error]] where L.CloseError: Into[io.IoError], R.Handler: Handler[(), P] + Observer + Release, R.Error: Owned + Shareable + Release {
    if limits.open_connections == 0 {
        let _closed = listener.close()
        return .Err(.NoConnections)
    }
    let needed = smallest_arena(limits)
    if needed == UInt64.max || limits.request_arena_bytes < needed {
        let _closed = listener.close()
        return .Err(.ArenaTooSmall)
    }
    dispatch_serve(listener, parent, make_handler, limits, policy, announce, shutdown, on)
}

// Each serving task takes its discard buffer from the parent before it serves
// anything, and the eight tasks race to ask. Serving ends with `Memory`
// whichever of them was refused, when the first to ask is refused and the
// other seven are granted theirs and when only the first is granted it, and
// every buffer serving took is given back either way.
test fn a_serving_task_refused_its_discard_buffer_ends_serving_with_memory() {
    served_refusing_discard_buffers(first: 1, from: 0)?
    served_refusing_discard_buffers(first: 0, from: 2)?
}

// Serve one request on eight tasks through a parent that refuses the discard
// buffer numbered `first` and every one from the one numbered `from` on,
// counting the buffers in the order the tasks asked, and check that serving
// ended with `Memory` and gave back everything it took.
fn served_refusing_discard_buffers(first: UInt64, from: UInt64) -> Result[(), testing.Failure] {
    let listener = net.listen(net.loopback(0)).unwrap()
    let client = send(listener.local_address().unwrap(), health_request)
    defer let parent = testing.SharedAllocationLog.open(mem.system(), 0).unwrap()
    defer let tables = testing.SharedAllocationLog.open(mem.system(), 0).unwrap()
    if first != 0 {
        parent.refuse_size_attempt(request_buffer_bytes, first)
    } else {
        parent.refuse_size_from(request_buffer_bytes, from)
    }
    let routes = tables.allocator()
    let made = [sink routes] || -> LoggedRouter where carries(routes) exchanges_router(routes)
    let served = serve_in(parent.allocator(), listener, made, limits: serving(1), policy: .Threads(8))
    defer let _answer = read_or_reset(client)
    testing.assert_eq(served, .Err(.Memory(.Exhausted)), "a serving task's refused discard buffer did not end serving")?
    testing.assert(parent.all_disposed(), "serving kept an allocation from the parent")?
    testing.assert(tables.all_disposed(), "a handler kept an allocation after its release")?
    .Ok(())
}

// Count a factory call in `tally` and answer how many there have been.
fn counted(tally: task.Client[Tally]) -> UInt64 {
    tally.call(
        |inout t: Tally| {
            t.visits += 1
            t.visits
        },
    )
}

// Why a test's handler could not be made, in text the error owns, so it is
// neither copyable nor discardable.
@derive(Release)
struct Unreadable {
    reason: String[mem.SystemAllocator],
}

fn no_database() -> Result[Router[()], Unopened] {
    .Err(.NoDatabase)
}

// `meet` counts its request in the shared tally, then waits until the other
// request has been counted too: two requests are answered only when they are
// served at once.
fn meet[P: Allocator](inout tally: task.Client[Tally], request: Request[P], inout _body: RequestBody[P]) -> Result[Response[P], Error[P]] where carries(request), borrows(_body), retains(_body: _body) {
    tally.call(|inout t: Tally| t.visits += 1)
    var waited: UInt64 = 0
    while tally.call(|inout t: Tally| t.visits) < 2 && waited < 5000 {
        time.sleep(time.Duration.from_milliseconds(1))
        waited += 1
    }
    if waited < 5000 {
        text(request, "ok")
    } else {
        .Err(Error.new(.ServiceUnavailable))
    }
}

fn meeting_router() -> Router[task.Client[Tally]] {
    var router: Router[task.Client[Tally]] = Router.new()
    &router.route_raw("GET /health", meet).unwrap()
    router
}

fn item_route[P: Allocator](inout _: (), request: Request[P], inout _body: RequestBody[P]) -> Result[Response[P], Error[P]] where carries(request), borrows(_body), retains(_body: _body) {
    let id = request.path_value("id").unwrap_or("none")
    text(request, id)
}

fn items_router() -> Router[()] {
    var router = Router.new()
    &router.route_raw(r"GET /items/{id}", item_route).unwrap()
    router
}

// A parent that refuses the first chunk of every request arena has serving
// take the 4096-byte buffer a 503 discards input into, be refused the arena,
// answer 503 and open the arena again. The walk then refuses each of those acquisitions in turn: a
// refused discard buffer ends serving before it accepts, and every other run
// answers 503. Every run gives back everything it took.
test fn each_allocation_failure_covers_every_acquisition_from_the_parent() {
    let attempts = served_refusing_arenas(0)?
    testing.assert_eq(attempts, UInt64(3), "serving took more from the parent than its discard buffer and two arenas")?
    for refused in UInt64(1)..attempts + 1 {
        let _attempted = served_refusing_arenas(refused)?
    }
}

// Serve one request through a parent that refuses every request arena and
// the acquisition numbered `refuse_at`, check what the client read, and
// return how many acquisitions serving attempted from the parent.
fn served_refusing_arenas(refuse_at: UInt64) -> Result[UInt64, testing.Failure] {
    let listener = net.listen(net.loopback(0)).unwrap()
    let client = send(listener.local_address().unwrap(), health_request)
    defer let parent = testing.SharedAllocationLog.open(mem.system(), refuse_at).unwrap()
    // The router's tables come from a log of their own, so only the parent's
    // acquisitions are refused.
    defer let tables = testing.SharedAllocationLog.open(mem.system(), 0).unwrap()
    let limits = Limits {
        read_timeout_ms = 100,
        max_line_bytes = 1024,
        max_headers = 4,
        max_body_bytes = 16384,
        request_arena_bytes = 98304,
        ..serving(1),
    }
    parent.refuse_size_from(mem.arena_first_chunk_bytes, 1)
    let routes = tables.allocator()
    let made = [sink routes] || -> LoggedRouter where carries(routes) exchanges_router(routes)
    let served = serve_in(parent.allocator(), listener, made, limits, policy: .Sequential)
    defer let answer = read_or_reset(client)
    testing.assert(parent.all_disposed(), "serving kept an allocation from the parent")?
    if served == .Err(.Memory(.Exhausted)) {
        testing.assert_eq(refuse_at, UInt64(1), "serving ended when an arena was refused")?
    } else {
        testing.assert_ok_eq(served, (), "serving failed")?
        testing.assert_eq(answer.view(), unavailable_answer, "a parent that refused the arena was not answered 503")?
    }
    .Ok(parent.attempts())
}

// `status_lines` joins the status phrase of each answer's first line, or the
// whole line when it is too short to be a status line, such as `reset`, each
// followed by `|`.
fn status_lines(answers: Vec[String]) -> String {
    var lines = String.new()
    for answer in answers.as_slice() {
        // A status line holds the phrase after its 9-byte `HTTP/1.1 ` prefix.
        let (line, _) = answer.split_once("\r\n") else {
            (answer.view(), "")
        }
        let first = line.slice(9, line.length()).unwrap_or(line)
        &lines.append(first).unwrap()
        &lines.append("|").unwrap()
    }
    lines
}

// The arena bound is checked before serving, so this fixture answers one
// ready connection through the production exchange step with a smaller
// arena. Six 3000-byte header lines exceed it, and the 8 KiB body left unread
// is discarded so the client still reads the refusal.
test fn a_request_larger_than_the_arena_is_answered_500() {
    defer let received = exchanged_in_small_arena(headers: 6, length: 3000, arena_bytes: 8192)
    testing.assert_eq(received.view(), "HTTP/1.1 500 Internal Server Error\r\nConnection: close\r\nContent-Type: text/plain; charset=utf-8\r\n\r\n", "a request past the arena was not answered 500")?
    .Ok(())
}

// Exhaust the arena after parsing the head, before reserving the response
// buffer. The exchange refuses before calling the handler and drains the
// unread body without materializing it.
test fn a_request_that_leaves_no_room_for_the_response_is_answered_500() {
    defer let received = exchanged_in_small_arena(headers: 4, length: 3700, exhaust_after_head: true)
    testing.assert_eq(received.view(), "HTTP/1.1 500 Internal Server Error\r\nConnection: close\r\nContent-Type: text/plain; charset=utf-8\r\n\r\n", "a request leaving no room for the response was not answered 500")?
    .Ok(())
}

// `exchanged_in_small_arena` sends `POST /health` with an 8 KiB body and
// `headers` header lines holding `length` bytes each, answers it in an
// arena bounded by `arena_bytes`, and returns what the client read.
fn exchanged_in_small_arena(headers: UInt64, length: UInt64, arena_bytes: UInt64 = 53256, exhaust_after_head: Bool = false) -> String {
    var listener = net.listen(net.loopback(0)).unwrap()
    var client = net.connect(listener.local_address().unwrap()).unwrap()
    var request = String.new()
    &request.append("POST /health HTTP/1.1\r\nHost: loopback\r\nContent-Length: 8192\r\n").unwrap()
    for index in 0..headers {
        "X-{index}: ".fmt(&request).unwrap()
        for _ in 0..length {
            &request.append("a").unwrap()
        }
        &request.append("\r\n").unwrap()
    }
    &request.append("\r\n").unwrap()
    for _ in 0..8192 {
        &request.append("b").unwrap()
    }
    let _sent = io.write_all(&client, request.as_bytes()).unwrap()
    request.release()
    let Accepted { connection, address: _ } = &listener.accept().unwrap()
    var router = exchanges_router(mem.system())
    // The two seconds bound only a broken read: these tests are about the
    // arena, and under a sanitizer reading the request can take longer than
    // the 100 ms the timeout tests use.
    let limits = Limits { max_body_bytes = 8192, read_timeout_ms = 2000, ..serving(1) }
    let arena = mem.Arena.open(mem.system(), arena_bytes)
    var refusal = mem.system().acquire(request_buffer_bytes).unwrap()
    answer_one(connection, &router, arena.handle(), &refusal, limits, exhaust_after_head)
    refusal.release()
    arena.release()
    router.release()
    listener.close().unwrap()
    read_to_end(client)
}

// `listen_and_serve` fails with `Listen` when the listener cannot be opened at
// `address` or its bound address cannot be read, and with `Serve` carrying the
// failure `serve` ended with otherwise. When serving ends with an accept
// failure and closing the listener fails too, `Serve` carries the accept
// failure, as `serve` reports it. `E` is why a handler factory that can fail
// did not make a handler, and `Never` for one that cannot.
@(copyable, derive(Equatable, Debug, Release))
pub enum ListenAndServeError[E = Never] {
    Listen(net.NetError),
    Serve(ServeError[E]),
}

impl[E: Display] Display for ListenAndServeError[E] {
    fn fmt[W: Writer](self: Self, inout w: W) -> Result[(), W.Error] {
        match read self {
            Listen(error) => {
                &w.write_str("listening failed: ")?
                error.fmt(&w)
            },
            Serve(error) => error.fmt(&w),
        }
    }
}

test fn a_listen_and_serve_error_displays_its_cause() {
    let invalid = io.IoError { operation = .Listen, category = .InvalidDescriptor, code = .None, progress = 0 }
    let listening_error: ListenAndServeError = .Listen(.Io(invalid))
    defer let listening = fmt.render_owned(listening_error).unwrap()
    let arena_error: ListenAndServeError = .Serve(.ArenaTooSmall)
    defer let arena = fmt.render_owned(arena_error).unwrap()
    testing.assert_eq(listening.view(), "listening failed: Listen failed (InvalidDescriptor) after 0 bytes", "the listen failure changed")?
    testing.assert_eq(arena.view(), "the request arena cannot hold every request the limits admit", "the arena refusal changed")?
    .Ok(())
}

// Open a listener at `address` and serve on it as `serve` does, so this
// function owns the listener, with a handler `make_handler` builds for each
// serving task. Each exchange's memory comes from the system allocator;
// `listen_and_serve_in` takes the allocator it comes from first. A program
// whose routes share state serves through `listen_and_serve_with`, and one
// that serves one connection at a time passes `policy: .Sequential`.
//
// The listener is closed on every exit. Once the limits and the parent have
// been accepted, and before anything is accepted, a handler `make_handler`
// builds for the purpose is told the address the listener is bound to as
// `Event.Listening`, which is how a program that asked for port 0 learns its
// port. That handler is made before any serving
// task starts, so a factory that cannot make one is asked once and serving
// ends with `Serve(.Handler(E))`. A program that opens its own listener calls
// `serve`.
pub fn listen_and_serve[R: MadeHandler[mem.SystemAllocator], M: Shareable + Copyable + fn() -> R](address: net.Address, make_handler: M, limits: Limits = standard_limits, policy: task.Policy = .Threads(128), shutdown: Shutdown = .OnSignals, on: io.Io = io.inherited) -> Result[(), ListenAndServeError[R.Error]] where R.Handler: Handler[(), mem.SystemAllocator] + Observer + Release, R.Error: Owned + Shareable + Release {
    listen_and_serve_in(mem.system(), address, make_handler, limits, policy, shutdown, on)
}

test fn a_listening_server_answers_on_every_task_it_serves_with() {
    let served = listen_and_serve(net.loopback(0), health_router, limits: serving(0))
    testing.assert_ok_eq(served, (), "listening without serving failed")?
    .Ok(())
}

// `listen_and_serve` makes the handler that announces the bound address
// before it starts a serving task, so a factory that always fails is asked
// once.
test fn a_listening_server_whose_handler_cannot_be_made_asks_its_factory_once() {
    let owner = task.own(Tally { visits = 0 }).unwrap()
    let counter = owner.client()
    let made = [sink counter] || -> Result[Router[()], Unopened] where carries(counter) {
        let _asked = counted(counter)
        .Err(.NoDatabase)
    }
    let served = listen_and_serve(net.loopback(0), made)
    let tally = owner.close()
    testing.assert_eq(served, .Err(.Serve(.Handler(.NoDatabase))), "a handler that could not be made did not end serving")?
    testing.assert_eq(tally.visits, UInt64(1), "the factory was asked again after it failed")?
    .Ok(())
}

test fn a_listening_server_announces_the_port_it_bound_before_accepting() {
    let file = log.capture()
    let announcer = [file] || -> Announcer Announcer { report = file.logger(minimum: .Info) }
    let served = listen_and_serve(net.loopback(0), announcer, limits: serving(0), policy: .Sequential)
    defer let lines = file.finish()
    testing.assert_ok_eq(served, (), "serving nothing failed")?
    testing.assert_eq(lines.view(), "INFO announced bound=true\n", "the bound address was not announced")?
    .Ok(())
}

test fn a_port_that_is_taken_is_a_listen_failure() {
    let held = net.listen(net.loopback(0)).unwrap()
    let taken = held.local_address().unwrap()
    let served = listen_and_serve(taken, health_router, limits: serving(1))
    held.close().unwrap()
    let refused = match read served {
        Err(Listen(_)) => true,
        Err(_) => false,
        Ok(_) => false,
    }
    testing.assert(refused, "a taken port was not reported as a listen failure")?
    .Ok(())
}

test fn serving_that_cannot_begin_announces_nothing() {
    let file = log.capture()
    // The capture exists even when validation refuses to create a handler.
    let primed = file.logger(minimum: .Info)
    primed.release()
    let announcer = [file] || -> Announcer Announcer { report = file.logger(minimum: .Info) }
    let small = Limits { request_arena_bytes = 1, ..serving(1) }
    let served = listen_and_serve(net.loopback(0), announcer, limits: small, policy: .Sequential)
    defer let lines = file.finish()
    testing.assert_eq(served, .Err(.Serve(.ArenaTooSmall)), "an arena too small for the limits did not end serving")?
    testing.assert_eq(lines.view(), "", "a server that never accepted announced its address")?
    .Ok(())
}

// `listen_and_serve_in` listens and serves as `listen_and_serve` does, carving
// each task's memory from `parent`, which every task reads, so it must be
// `Shareable`.
pub fn listen_and_serve_in[P: Allocator + Shareable, R: MadeHandler[P], M: Shareable + Copyable + fn() -> R](parent: P, address: net.Address, make_handler: M, limits: Limits = standard_limits, policy: task.Policy = .Threads(128), shutdown: Shutdown = .OnSignals, on: io.Io = io.inherited) -> Result[(), ListenAndServeError[R.Error]] where R.Handler: Handler[(), P] + Observer + Release, R.Error: Owned + Shareable + Release {
    let listener = net.listen(address, backlog: net.Backlog(1024)) else |error| {
        return .Err(.Listen(error))
    }
    let bound = listener.local_address()
    serve_opened(listener, bound, parent, make_handler, limits, policy, shutdown, on)
}

test fn listening_in_the_system_allocator_serves_nothing_when_told_to() {
    let served = listen_and_serve_in(mem.system(), net.loopback(0), health_router, limits: serving(0))
    testing.assert_ok_eq(served, (), "listening without serving failed")?
    .Ok(())
}

// Listen and serve as `listen_and_serve` does, keeping `state` in an owning
// task for the routes to share. `make_handler` is given a client of that task
// for each serving task, and builds that task's handler around it, often
// `http.with_state` lending the routes a context that holds the client. A
// route reaches the state through the client's `call`, which runs on the
// owning task one call at a time, so no request changes the state while
// another reads it and no lock guards it. Once every serving task has been
// joined, the owning task is closed and the state is returned, so a program
// reads what its routes changed and releases it. The state is released on
// every failure.
pub fn listen_and_serve_with[S: Owned + Isolated + Release, R: MadeHandler[mem.SystemAllocator], M: Shareable + Copyable + fn(client: task.Client[S]) -> R where carries(client)](address: net.Address, make_handler: M, sink state: S, limits: Limits = standard_limits, policy: task.Policy = .Threads(128), shutdown: Shutdown = .OnSignals, on: io.Io = io.inherited) -> Result[S, ListenAndServeError[R.Error]] where R.Handler: Handler[(), mem.SystemAllocator] + Observer + Release, R.Error: Owned + Shareable + Release {
    listen_and_serve_with_in(mem.system(), address, make_handler, state, limits, policy, shutdown, on)
}

// `listen_and_serve_with_in` listens and serves as `listen_and_serve_with`
// does, carving each task's memory from `parent`.
pub fn listen_and_serve_with_in[P: Allocator + Shareable, S: Owned + Isolated + Release, R: MadeHandler[P], M: Shareable + Copyable + fn(client: task.Client[S]) -> R where carries(client)](parent: P, address: net.Address, make_handler: M, sink state: S, limits: Limits = standard_limits, policy: task.Policy = .Threads(128), shutdown: Shutdown = .OnSignals, on: io.Io = io.inherited) -> Result[S, ListenAndServeError[R.Error]] where R.Handler: Handler[(), P] + Observer + Release, R.Error: Owned + Shareable + Release {
    let owner = match task.own(state, on) {
        Ok(owner) => owner,
        Err(Unowned { state: kept, reason }) => {
            kept.release()
            return .Err(.Serve(.Task(reason)))
        },
    }
    let client = owner.client()
    let made = [sink make_handler = copy(make_handler), sink client] || -> R where carries(client, make_handler) make_handler(client)
    let served = listen_and_serve_in(parent, address, made, limits, policy, shutdown, on)
    let state = owner.close()
    match served {
        Ok(_) => .Ok(state),
        Err(error) => {
            state.release()
            .Err(error)
        },
    }
}

test fn the_state_comes_back_when_serving_with_it_ends() {
    let served = listen_and_serve_with_in(mem.system(), net.loopback(0), visited, Tally { visits = 7 }, limits: serving(0))
    let kept = match served {
        Ok(tally) => tally.visits,
        Err(_) => 0,
    }
    testing.assert_eq(kept, UInt64(7), "the state was not returned")?
    .Ok(())
}

// Serve on `listener` after its bound address `bound` was read, for
// `listen_and_serve`, with handlers `make_handler` builds. A bound address
// that could not be read is a `Listen` failure; the listener is closed, and a
// failure to close it is dropped in favour of the reported one.
fn serve_opened[L: net.Acceptor + io.Close + io.Pollable + Owned + Shareable + Isolated, P: Allocator + Shareable, R: MadeHandler[P], M: Shareable + Copyable + fn() -> R](sink listener: L, sink bound: Result[net.Address, net.NetError], parent: P, make_handler: M, limits: Limits, policy: task.Policy = .Threads(128), shutdown: Shutdown = .OnSignals, on: io.Io = io.inherited) -> Result[(), ListenAndServeError[R.Error]] where L.CloseError: Into[io.IoError], R.Handler: Handler[(), P] + Observer + Release, R.Error: Owned + Shareable + Release {
    let address = bound else |error| {
        let _closed = listener.close()
        return .Err(.Listen(error))
    }
    match serve_made(listener, parent, make_handler, limits, policy, .Some(address), shutdown, on) {
        Ok(_) => .Ok(()),
        Err(error) => .Err(.Serve(error)),
    }
}

test fn a_bound_address_that_cannot_be_read_closes_the_listener() {
    let listener = net.listen(net.loopback(0)).unwrap()
    let address = listener.local_address().unwrap()
    let invalid = io.IoError { operation = .Listen, category = .InvalidDescriptor, code = .None, progress = 0 }
    let scripted = net.scripted(listener, [.None, .None, .None, .None], .None)
    let served = serve_opened(scripted, .Err(.Io(copy(invalid))), mem.system(), health_router, serving(1), policy: .Sequential)
    let refused = match net.connect(address) {
        Ok(connection) => {
            connection.close().unwrap()
            false
        },
        Err(_) => true,
    }
    testing.assert_eq(served, .Err(.Listen(.Io(invalid))), "an unreadable bound address was not a listen failure")?
    testing.assert(refused, "the listener was left open")?
    .Ok(())
}

test fn serving_reports_an_accept_failure_when_closing_the_listener_fails_too() {
    let listener = net.listen(net.loopback(0)).unwrap()
    let address = listener.local_address().unwrap()
    let invalid = io.IoError { operation = .Accept, category = .InvalidDescriptor, code = .None, progress = 0 }
    let broken = io.IoError { operation = .Close, category = .InvalidDescriptor, code = .None, progress = 0 }
    let scripted = net.scripted(listener, [.Some(.Io(copy(invalid))), .None, .None, .None], .Some(broken))
    let served = serve_opened(scripted, .Ok(address), mem.system(), health_router, serving(1), policy: .Sequential)
    testing.assert_eq(served, .Err(.Serve(.Accept(.Io(invalid)))), "the close failure replaced the accept failure")?
    .Ok(())
}

test fn an_announced_server_answers_the_connection_queued_for_it() {
    let listener = net.listen(net.loopback(0)).unwrap()
    let address = listener.local_address().unwrap()
    let client = send(address, health_request)
    let file = log.capture()
    let announcer = [file] || -> Announcer Announcer { report = file.logger(minimum: .Info) }
    let served = serve_opened(listener, .Ok(address), mem.system(), announcer, serving(1), policy: .Sequential)
    defer let answer = read_to_end(client)
    defer let lines = file.finish()
    testing.assert_ok_eq(served, (), "serving failed")?
    testing.assert_eq(answer.view(), "HTTP/1.1 200 OK\r\nConnection: close\r\nContent-Type: text/plain; charset=utf-8\r\n\r\nok", "the queued request was not answered")?
    testing.assert_eq(lines.view(), "INFO announced bound=true\nINFO exchanged\n", "the announcement did not precede the exchange")?
    .Ok(())
}

test fn the_shared_state_counts_every_request_from_every_task() {
    let listener = net.listen(net.loopback(0)).unwrap()
    let bound = listener.local_address().unwrap()
    let clients = [send(bound, health_request), send(bound, health_request), send(bound, health_request), send(bound, health_request)]
    let owner = task.own(Tally { visits = 0 }).unwrap()
    let counter = owner.client()
    let made = [sink counter] || -> Stated[task.Client[Tally], Router[task.Client[Tally]]] where carries(counter) with_state(copy(counter), visits_router())
    let served = serve_opened(listener, .Ok(bound), mem.system(), made, serving(4), policy: .Threads(4))
    let tally = owner.close()
    var answered: UInt64 = 0
    for client in clients {
        defer let answer = read_to_end(client)
        if answer.view() == health_answer {
            answered += 1
        }
    }
    testing.assert_ok_eq(served, (), "serving failed")?
    testing.assert_eq(answered, UInt64(4), "a request was not answered")?
    testing.assert_eq(tally.visits, UInt64(4), "a visit was lost")?
    .Ok(())
}

test fn serve_opened_defaults_to_concurrent_worker_execution() {
    let listener = net.listen(net.loopback(0)).unwrap()
    let bound = listener.local_address().unwrap()
    let client1 = send(bound, health_request)
    let client2 = send(bound, health_request)
    let served = serve_opened(listener, .Ok(bound), mem.system(), health_router, serving(2))
    let ok = served.is_ok()
    defer let r1 = read_to_end(client1)
    defer let r2 = read_to_end(client2)
    testing.assert(ok, "default serve_opened failed")?
    testing.assert_eq(r1.view(), health_answer, "first request failed")?
    testing.assert_eq(r2.view(), health_answer, "second request failed")?
    .Ok(())
}

// Reserve conservative transport headroom for three 4 KiB buffers and the
// arena cursor, even when persistent input and refusal buffers live outside it.
let exchange_buffer_bytes: UInt64 = 3 * 4096 + 8

// A header's name and value are two spans of two `UInt64`s each, 32 bytes.
let field_bytes: UInt64 = 32

// Every arena reservation is rounded up to 8 bytes, and the head's text is
// reserved at most 64 times, since each reservation at least doubles it.
let rounding_bytes: UInt64 = 8 * 64

// `smallest_arena` bounds request metadata and exchange buffers. Body bytes
// are streamed, and a handler that materializes them may need additional
// arena space. Each metadata term is an upper bound:
//
// - A conservative allowance for line collection, bounded by twice its
//   limit. Persistent readers keep their actual record outside this arena.
// - The head's text, the method, target and header names and values, is at
//   most one line limit per line. It grows by doubling, or straight to what an
//   append needs, so its last reservation is at most twice the text and all
//   of its reservations together at most twice the last: four times the text.
// - The table of header ranges doubles from 4 entries, so it reserves at most
//   four times `max_headers + 2` entries in all.
// - The decoded query is reserved once at the query's length, at most one
//   line, and its ranges once at its pair count, at most `max_query_pairs`.
//
// A smaller arena would answer 500 to a request the limits accept. Limits
// that need more than `UInt64.max` bytes answer `UInt64.max`, which no arena
// reaches.
fn smallest_arena(limits: Limits) -> UInt64 {
    let line = limits.max_line_bytes
    let lines = added(limits.max_headers, 1)
    let record = added(multiplied(2, added(line, 1)), 8)
    let head = added(multiplied(multiplied(4, lines), line), rounding_bytes)
    let fields = multiplied(multiplied(4, added(limits.max_headers, 2)), field_bytes)
    let query = added(added(added(line, 8), multiplied(limits.max_query_pairs, field_bytes)), 8)
    var total = exchange_buffer_bytes
    for part in [record, head, fields, query] {
        total = added(total, part)
    }
    total
}

test fn the_default_arena_holds_every_request_the_default_limits_admit() {
    let limits = Limits.default()
    testing.assert(limits.request_arena_bytes >= smallest_arena(limits), "the default arena is smaller than the default limits need")?
    .Ok(())
}

// A request at every limit is answered in the smallest arena `serve` accepts
// for those limits: a request line and six header lines at the line limit,
// two short headers that bring the count to the limit of eight, and a body at
// the body limit.
test fn a_request_at_every_limit_is_answered_in_the_smallest_arena() {
    let limits = Limits { max_line_bytes = 256, max_headers = 8, max_body_bytes = 1024, ..serving(1) }
    defer let received = served_at_limits(limits, header_lines: 6, line_length: 256)
    testing.assert_eq(received.view(), "HTTP/1.1 200 OK\r\nContent-Length: 2\r\nContent-Type: text/plain; charset=utf-8\r\n\r\nok", "a request at every limit was refused")?
    .Ok(())
}

// A request line at the line limit whose query holds `max_query_pairs`
// pairs is decoded within the smallest arena, so a route that never reads it
// still answers. Each pair is 81 letters and `&`, 82 bytes, and the query's
// 8169 bytes hold 99 of them and a 100th of 51 letters.
test fn a_query_of_the_most_pairs_is_answered_in_the_smallest_arena() {
    let limits = Limits { max_body_bytes = 8, ..serving(1) }
    defer let received = served_at_limits(limits, header_lines: 0, line_length: 8192, query_part: query_pair(81))
    testing.assert_eq(received.view(), "HTTP/1.1 200 OK\r\nContent-Length: 2\r\nContent-Type: text/plain; charset=utf-8\r\n\r\nok", "a query of the most pairs was refused")?
    .Ok(())
}

// A `POST /health` body sent as a form and decoded within the smallest
// arena, whether or not the route reads it, holds `max_form_pairs` pairs:
// each pair is 81 letters and `&`, 82 bytes, and the body's 8169 bytes hold
// 99 of them and a 100th of 51 letters, exactly as a query's pairs are
// counted.
test fn a_form_of_the_most_pairs_is_answered_in_the_smallest_arena() {
    let limits = Limits { max_body_bytes = 8169, ..serving(1) }
    defer let received = served_form_at_limits(limits, query_pair(81))
    testing.assert_eq(received.view(), health_answer, "a form of the most pairs was refused")?
    .Ok(())
}

// A header after a line at the limit makes the head's text grow past it, and
// the request is still answered in the smallest arena.
test fn a_short_header_after_a_long_line_is_answered_in_the_smallest_arena() {
    let limits = Limits { max_body_bytes = 8192, ..serving(1) }
    defer let received = served_at_limits(limits, header_lines: 1, line_length: 8192)
    testing.assert_eq(received.view(), "HTTP/1.1 200 OK\r\nContent-Length: 2\r\nContent-Type: text/plain; charset=utf-8\r\n\r\nok", "a short header after a long line was refused")?
    .Ok(())
}

// `added` and `multiplied` stop at `UInt64.max` instead of overflowing, so
// `smallest_arena` answers `UInt64.max` for limits no arena could hold.
fn added(left: UInt64, right: UInt64) -> UInt64 {
    if right > UInt64.max - left {
        return UInt64.max
    }
    left + right
}

fn multiplied(left: UInt64, right: UInt64) -> UInt64 {
    if left != 0 && right > UInt64.max / left {
        return UInt64.max
    }
    left * right
}

test fn arena_arithmetic_stops_at_the_largest_integer() {
    testing.assert_eq(added(2, 3), UInt64(5), "a sum changed")?
    testing.assert_eq(added(UInt64.max, 1), UInt64.max, "a sum past the largest integer wrapped")?
    testing.assert_eq(multiplied(4, 8), UInt64(32), "a product changed")?
    testing.assert_eq(multiplied(0, UInt64.max), UInt64(0), "a product with zero changed")?
    testing.assert_eq(multiplied(UInt64.max / 2 + 1, 2), UInt64.max, "a product past the largest integer wrapped")?
    .Ok(())
}

// One pair past `max_query_pairs` is refused with 414 before it is decoded:
// pairs of 80 letters and `&` fit 100 in the query and a 101st of 69 letters.
test fn a_query_of_one_pair_too_many_is_refused_with_414() {
    let limits = Limits { max_body_bytes = 8, ..serving(1) }
    defer let received = served_at_limits(limits, header_lines: 0, line_length: 8192, query_part: query_pair(80))
    testing.assert(received.starts_with("HTTP/1.1 414 URI Too Long\r\n"), "a query of too many pairs was answered")?
    .Ok(())
}

// `query_pair` returns `letters` letters and an `&`, one pair of a query.
fn query_pair(letters: UInt64) -> Str {
    let pair = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa&"
    pair.slice(pair.length() - letters - 1, pair.length()).unwrap()
}

// One pair past `max_form_pairs` is refused with 413 before it is decoded:
// pairs of 80 letters and `&` fit 100 in the body and a 101st of 69 letters.
test fn a_form_of_one_pair_too_many_is_refused_with_413() {
    let limits = Limits { max_body_bytes = 8169, ..serving(1) }
    defer let received = served_form_at_limits(limits, query_pair(80))
    testing.assert(received.starts_with("HTTP/1.1 413 Content Too Large\r\n"), "a form of too many pairs was answered")?
    .Ok(())
}

// `served_form_at_limits` sends `POST /health` with a body of `pair_part`
// repeated to `limits.max_body_bytes` and sent as
// `application/x-www-form-urlencoded`, serves it in `smallest_arena(limits)`,
// and returns what the client read.
fn served_form_at_limits(sink limits: Limits, pair_part: Str) -> String {
    let listener = net.listen(net.loopback(0)).unwrap()
    var client = net.connect(listener.local_address().unwrap()).unwrap()
    var body = String.new()
    var written: UInt64 = 0
    while written < limits.max_body_bytes {
        let left = limits.max_body_bytes - written
        let part = if pair_part.length() > left {
            pair_part.slice(0, left).unwrap()
        } else {
            copy(pair_part)
        }
        &body.append(part).unwrap()
        written += part.length()
    }
    var request = String.new()
    let length = body.length()
    "POST /health HTTP/1.1\r\nHost: loopback\r\nContent-Type: application/x-www-form-urlencoded\r\nConnection: close\r\nContent-Length: {length}\r\n\r\n".fmt(&request).unwrap()
    &request.append(body.view()).unwrap()
    body.release()
    let _sent = io.write_all(&client, request.as_bytes()).unwrap()
    request.release()
    let smallest = smallest_arena(limits)
    serve(listener, form_health_router, limits: Limits { request_arena_bytes = smallest, ..limits }, policy: .Sequential).unwrap()
    read_to_end(client)
}

// `served_at_limits` sends `GET /health` with a request line of
// `line_length` bytes, whose query is `query_part` repeated, `header_lines`
// header lines of `line_length` bytes, a short `Host: loopback` header,
// `Content-Length` and a body at the body limit, serves it in
// `smallest_arena(limits)`, and returns what the client read. Each line
// counts its CRLF.
fn served_at_limits(sink limits: Limits, header_lines: UInt64, line_length: UInt64, query_part: Str = "q") -> String {
    let listener = net.listen(net.loopback(0)).unwrap()
    var client = net.connect(listener.local_address().unwrap()).unwrap()
    var request = String.new()
    // `GET /health?` and ` HTTP/1.1` with CRLF take 23 bytes around the query.
    &request.append("GET /health?").unwrap()
    let query_length = line_length - 23
    var written: UInt64 = 0
    while written < query_length {
        let left = query_length - written
        let part = if query_part.length() > left {
            query_part.slice(0, left).unwrap()
        } else {
            copy(query_part)
        }
        &request.append(part).unwrap()
        written += part.length()
    }
    &request.append(" HTTP/1.1\r\n").unwrap()
    for index in 0..header_lines {
        // `X-{index}: ` takes 5 bytes and CRLF 2 around the value.
        "X-{index}: ".fmt(&request).unwrap()
        for _ in 0..line_length - 7 {
            &request.append("a").unwrap()
        }
        &request.append("\r\n").unwrap()
    }
    let body = limits.max_body_bytes
    "Host: loopback\r\nContent-Length: {body}\r\n\r\n".fmt(&request).unwrap()
    for _ in 0..body {
        &request.append("b").unwrap()
    }
    let _sent = io.write_all(&client, request.as_bytes()).unwrap()
    request.release()
    let smallest = smallest_arena(limits)
    serve(listener, system_exchanges_router, limits: Limits { request_arena_bytes = smallest, ..limits }, policy: .Sequential).unwrap()
    read_to_end(client)
}

// Answer one already-queued request in an exchange test through the same
// parser, body reader and response path the dispatcher uses. Forcing close
// lets the fixture collect the complete response without running a dispatcher.
fn answer_one[H: Handler[(), P] + Observer, P: Allocator](sink connection: net.Connection, inout handler: H, memory: mem.Handle[P], inout refusal: mem.Buffer[P], limits: Limits, exhaust_after_head: Bool = false) {
    var configured = connection
    &configured.set_timeouts(limits.read_timeout_ms, limits.write_timeout_ms)
    &configured.set_deadline(time.Instant.now(), limits.read_timeout_ms)
    let reader = io.BufferedReader.open(capacity: request_buffer_bytes, reader: configured) else |failure| {
        let BufferOpenFailure { resource, reason: _ } = failure
        close_connection(resource)
        panic("an exchange test could not allocate its connection buffer")
    }
    let answered = if exhaust_after_head {
        var input = reader
        let ParsedHead { head, line, header_fields, length } = read_request_head(&input, memory, limits).unwrap()
        let message = assembled(memory, head, line, header_fields, empty_payload(memory), limits).unwrap()
        loop {
            let byte = memory.acquire(1) else |_| {
                break
            }
            byte.release()
        }
        answer_message(input, &handler, memory, &refusal, limits, true, .None, message, length.unwrap_or(0))
    } else {
        answer_reading(reader, &handler, memory, &refusal, limits, closing: true)
    }
    match answered {
        Idle(returned) => close_connection(returned.abandon()),
        Closed => {},
        Unavailable => {},
    }
}

// An exchange whose handler fills a 1 MiB arena grows it chunk by chunk from
// the parent, and rewinding the arena once the answer is written gives the
// parent back every chunk but the first.
test fn a_rewound_request_arena_keeps_only_its_first_chunk() {
    var listener = net.listen(net.loopback(0)).unwrap()
    let client = send(listener.local_address().unwrap(), "GET /fill HTTP/1.1\r\nHost: loopback\r\n\r\n")
    let Accepted { connection, address: _ } = &listener.accept().unwrap()
    defer let log = testing.AllocationLog.open(mem.system(), 0).unwrap()
    var router = exchanges_router(log.allocator())
    var refusal = log.allocator().acquire(request_buffer_bytes).unwrap()
    let before = log.live_bytes()
    var arena = mem.Arena.open(log.allocator(), 1048576)
    let opened = log.live_bytes() - before
    answer_one(connection, &router, arena.handle(), &refusal, Limits { read_timeout_ms = 2000, ..serving(1) })
    let peak = log.peak_bytes()
    &arena.rewind()
    let rewound = log.live_bytes() - before
    let grown = log.acquired()
    // A small request is answered in the first chunk alone.
    let small = send(listener.local_address().unwrap(), health_request)
    let Accepted { connection: next, address: _ } = &listener.accept().unwrap()
    answer_one(next, &router, arena.handle(), &refusal, Limits { read_timeout_ms = 2000, ..serving(1) })
    &arena.rewind()
    let unchanged = log.acquired() == grown
    refusal.release()
    arena.release()
    router.release()
    listener.close().unwrap()
    defer let received = read_to_end(client)
    defer let answered = read_to_end(small)
    testing.assert(received.starts_with("HTTP/1.1 500 Internal Server Error\r\n"), "a handler that filled the arena was not answered 500")?
    testing.assert_eq(opened, mem.arena_first_chunk_bytes, "opening the arena took more than its first chunk")?
    testing.assert(peak > 524288, "filling the arena did not grow it past half its size")?
    testing.assert_eq(rewound, opened, "rewinding the arena kept chunks past its first")?
    testing.assert_eq(answered.view(), health_answer, "a request after a rewound full arena was not answered")?
    testing.assert(unchanged, "a small request grew the arena past its first chunk")?
    testing.assert(log.all_disposed(), "releasing the arena kept a chunk")?
    .Ok(())
}

// `answer_failure` says what went wrong with an answer, quoting a message
// copied into `note`, or `None` when the handler's response was written
// whole.
fn answer_failure[A: Allocator](answered: Answered, note: String[A]) -> Option[Failure] where borrows(.Some: note) {
    match read answered.sent.delivery {
        Whole => if answered.refused {
            .Some(.Refused(noted_text(note, answered.noted)))
        } else {
            .None
        },
        Memory => .Some(.Memory),
        Write(error) => .Some(.Write(copy(error))),
        Stream(status, noted) => .Some(.Stream(copy(status), noted_text(note, noted))),
    }
}

// `Answered` is how the handler answered: the status, whether it refused the
// request with an error, whether its message was copied into the note, and
// how sending the answer went.
struct Answered {
    status: Status,
    refused: Bool,
    noted: Noted,
    sent: Sent,
}

// A failure's message is `Copied` into the note, or `Absent` because there
// was none or the arena could not hold it.
@copyable
enum Noted {
    Copied,
    Absent,
}

// `copy_message` appends `message` to `note` and says whether it is there.
fn copy_message[A: Allocator](inout note: String[A], message: Option[Str]) -> Noted {
    let copied = match read message {
        Some(text) => &note.append(text).is_ok(),
        None => false,
    }
    if copied {
        return .Copied
    }
    .Absent
}

// `Sent` says how writing an answer ended, and how many body bytes the
// connection accepted.
@copyable
struct Sent {
    delivery: Delivery,
    body_bytes: UInt64,
}

// An answer is delivered whole, or writing it failed, or the function
// streaming its body failed with a status after the head was sent, and its
// message may have been copied into the note.
@copyable
enum Delivery {
    Whole,
    Memory,
    Write(io.IoError),
    Stream(Status, Noted),
}

// `noted_text` returns the note when a message was copied into it.
fn noted_text[A: Allocator](note: String[A], noted: Noted) -> Option[Str] where borrows(.Some: note) {
    match read noted {
        Copied => .Some(note.view()),
        Absent => .None,
    }
}

// Answer 503 when the parent refused the arena its storage: the server is out
// of memory for the moment. The answer allocates nothing, and the unread input
// is discarded into `refusal`, the buffer `serve` holds for this, so the client
// reads the 503 the event reports unless writing it failed, which the event
// then reports instead.
fn refuse_for_want_of_arena[H: Handler[(), P] + Observer, P: Allocator](sink connection: net.Connection, inout handler: H, memory: mem.Handle[P], inout refusal: mem.Buffer[P], limits: Limits) {
    var refused = connection
    // The answer's headers are empty, so the refused arena's handle allocates
    // nothing for them.
    let answered = refuse(&refused, .ServiceUnavailable, memory)
    linger(&refused, &refusal, limits.read_timeout_ms)
    close_connection(refused)
    let failure: Failure = match answered {
        Ok(_) => .Memory,
        Err(reason) => .Write(reason),
    }
    let event: Event[P] = .Exchanged(.{ request = .None, status = .Some(.ServiceUnavailable), body_bytes = 0, duration = .None, failure = .Some(failure) })
    &handler.observe(event)
}

// Answer a request that was not read with `status` alone.
fn refuse[A: Allocator](inout connection: net.Connection, status: Status, allocator: A) -> Result[(), io.IoError] {
    let headers = ResponseHeaders.new_in(allocator)
    let wrote = write_head(&connection, status, headers, .Http)
    headers.release()
    let _written = wrote?
    .Ok(())
}

// Stop writing to `connection` and discard what the client still sends into
// `discarded`, so closing it does not reset the connection before the client
// reads the answer.
fn linger[A: Allocator](inout connection: net.Connection, inout discarded: mem.Buffer[A], read_timeout_ms: UInt64) {
    if !&connection.shutdown_write().is_ok() {
        return
    }
    &connection.set_timeouts(linger_wait(read_timeout_ms), 0)
    var reads: UInt64 = 0
    while reads < linger_reads {
        reads += 1
        match &connection.read_some(&discarded, offset: 0, count: request_buffer_bytes) {
            Ok(count) => if count == 0 {
                reads = linger_reads
            },
            Err(_) => reads = linger_reads,
        }
    }
}

// `linger_wait` returns how long one linger read waits, given the read timeout,
// where 0 means none.
fn linger_wait(read_timeout_ms: UInt64) -> UInt64 {
    if read_timeout_ms == 0 || read_timeout_ms > longest_linger_read_ms {
        return longest_linger_read_ms
    }
    read_timeout_ms
}

test fn a_linger_read_waits_no_longer_than_the_read_timeout() {
    testing.assert_eq(linger_wait(100), 100, "a shorter read timeout was exceeded")?
    testing.assert_eq(linger_wait(5000), 500, "the linger waited past 500 ms")?
    testing.assert_eq(linger_wait(0), 500, "no read timeout let the linger wait forever")?
    .Ok(())
}

// Close `connection` and ignore a failure: the descriptor is released either
// way, and the response has already been delivered or lost, so a server has
// nothing to do about it.
fn close_connection(sink connection: net.Connection) {
    let _closed = connection.close()
}

// Reset `connection`, so the client reads an error rather than the end of a
// response, and ignore a failure: the descriptor is released either way.
fn reset_connection(sink connection: net.Connection) {
    let _reset = connection.reset()
}

// A test sends this GET of `/health` and nothing else.
let health_request: Str = "GET /health HTTP/1.1\r\nHost: loopback\r\nConnection: close\r\n\r\n"

// A client reads this answer to `health_request`.
let health_answer: Str = "HTTP/1.1 200 OK\r\nConnection: close\r\nContent-Type: text/plain; charset=utf-8\r\n\r\nok"

// `unavailable_answer` is what a client reads when its request is refused 503.
let unavailable_answer: Str = "HTTP/1.1 503 Service Unavailable\r\nConnection: close\r\nContent-Type: text/plain; charset=utf-8\r\n\r\n"

// Answer every request with "ok".
fn health[P: Allocator](inout _: (), request: Request[P], inout _body: RequestBody[P]) -> Result[Response[P], Error[P]] where carries(request), borrows(_body), retains(_body: _body) {
    text(request, "ok")
}

// `health_router` builds a router that answers `GET /health` with "ok".
fn health_router() -> Router[()] {
    var router = Router.new()
    &router.route_raw("GET /health", health).unwrap()
    router
}

// `visit` counts a visit in the state an owning task keeps, and answers "ok".
fn count_visit[P: Allocator](inout tally: task.Client[Tally], request: Request[P], inout _body: RequestBody[P]) -> Result[Response[P], Error[P]] where carries(request), borrows(_body), retains(_body: _body) {
    tally.call(|inout t: Tally| t.visits += 1)
    text(request, "ok")
}

// `visited` builds a serving task's handler: a visits router lent `tally`.
fn visited(tally: task.Client[Tally]) -> Stated[task.Client[Tally], Router[task.Client[Tally]]] where carries(tally) {
    with_state(copy(tally), visits_router())
}

// `visits_router` builds a router that counts every `GET /health`.
fn visits_router() -> Router[task.Client[Tally]] {
    var router: Router[task.Client[Tally]] = Router.new()
    &router.route_raw("GET /health", count_visit).unwrap()
    router
}

// `serving` returns the default limits, ending after `count` connections.
fn serving(count: UInt64) -> Limits {
    Limits { connections = .Some(count), idle_timeout_ms = 250, ..Limits.default() }
}

// Connect to `address` and send `request`, leaving the connection open.
fn send(address: net.Address, request: Str) -> net.Connection {
    var client = net.connect(address).unwrap()
    let _sent = io.write_all(&client, request.as_bytes()).unwrap()
    client
}

// `Unprocessable` refuses every request with 422.
@derive(Release)
struct Unprocessable {}

impl[P: Allocator] Handler[(), P] for Unprocessable {
    fn serve_http(inout _self: Self, inout _state: (), _request: Request[P], inout _body: RequestBody[P]) -> Result[Response[P], Error[P]] {
        .Err(Error.new(.Other(Code(422))))
    }
}

// `unprocessable` builds a serving task's `Unprocessable` handler.
fn unprocessable() -> Unprocessable {
    Unprocessable {}
}

// Fill the arena eight bytes at a time until it refuses, which answers 500.
fn fill_the_arena[P: Allocator](inout _: (), request: Request[P], inout _body: RequestBody[P]) -> Result[Response[P], Error[P]] where carries(request), borrows(_body), retains(_body: _body) {
    var filled = String.new_in(request.allocator())
    loop {
        &filled.append("abcdefgh")?
    }
}

// Stream the numbers 1 to 3, one per line.
fn count[P: Allocator](inout _: (), request: Request[P], inout _body: RequestBody[P]) -> Result[Response[P], Error[P]] where carries(request), borrows(_body), retains(_body: _body) {
    stream(request, count_to_three)
}

// Stream one line, then fail.
fn broken_stream[P: Allocator](inout _: (), request: Request[P], inout _body: RequestBody[P]) -> Result[Response[P], Error[P]] where carries(request), borrows(_body), retains(_body: _body) {
    stream(request, fail_after_one)
}

// `exchanges_router` builds a router that answers `GET /health` with "ok",
// `/count` with a stream of three lines, `/broken` with a stream that fails after
// one line, `/fill` by filling the arena, and `/echo/{name}` with the name.
fn exchanges_router[A: Allocator](allocator: A) -> Router[(), A] where carries(allocator) {
    var router = Router.new_in(allocator)
    &router.route_raw("GET /health", health).unwrap()
    &router.route_raw("GET /count", count).unwrap()
    &router.route_raw("GET /broken", broken_stream).unwrap()
    &router.route_raw("GET /fill", fill_the_arena).unwrap()
    &router.route_raw(r"GET /echo/{name}", named_value).unwrap()
    router
}

// A `LoggedRouter` is an `exchanges_router` whose tables, and the responses
// it builds, come from a shared allocation log, so a test can count or refuse
// what serving takes from its parent.
alias LoggedRouter = Router[(), testing.SharedRefusingAllocator[mem.SystemAllocator]]

// `system_exchanges_router` builds an `exchanges_router` whose tables come
// from the system allocator.
fn system_exchanges_router() -> Router[()] {
    exchanges_router(mem.system())
}

// `Recorded` answers every request with "ok" and records what `serve` tells
// it: how many exchanges ended, how many of them failed to read the request
// because it timed out, and how many accept retries it was told of, with the
// first four pauses in milliseconds.
struct Recorded {
    exchanges: UInt64,
    timed_out: UInt64,
    retries: UInt64,
    pauses_ms: [UInt64; 4],
}

impl Recorded {
    fn new() -> Recorded {
        Recorded { exchanges = 0, timed_out = 0, retries = 0, pauses_ms = [0, 0, 0, 0] }
    }

    // Count an exchange that ended, and whether reading its request timed out.
    fn exchanged(inout self: Self, timed_out: Bool) {
        self.exchanges += 1
        if timed_out {
            self.timed_out += 1
        }
    }

    // Count an accept retry, keeping the pause of each of the first four.
    fn retried(inout self: Self, pause_ms: UInt64) {
        if self.retries < 4 {
            self.pauses_ms[self.retries] = pause_ms
        }
        self.retries += 1
    }
}

// Whether reading the request of `exchange` timed out.
fn timed_out_reading[P: Allocator](exchange: Exchange[P]) -> Bool {
    match read exchange.failure {
        Some(Unread(Io(reason))) => match read reason.category {
            TimedOut => true,
            _ => false,
        },
        _ => false,
    }
}

impl[P: Allocator] Handler[(), P] for Recorded {
    fn serve_http(inout _self: Self, inout _state: (), request: Request[P], inout _body: RequestBody[P]) -> Result[Response[P], Error[P]] where carries(request), borrows(_body), retains(_body: _body) {
        text(request, "ok")
    }
}

impl Observer for Recorded {
    fn observe[P: Allocator](inout self: Self, event: Event[P]) {
        match read event {
            Exchanged(exchange) => &self.exchanged(timed_out_reading(exchange)),
            Listening(_) => {},
            AcceptRetried(retry) => &self.retried(retry.pause.nanoseconds() / 1000000),
        }
    }
}

// `Reporter` answers every request with "ok" and records what `serve` tells
// it in the `Recorded` an owning task keeps, so a test reads what every
// handler was told after serving has released them.
@derive(Release)
struct Reporter {
    recorded: task.Client[Recorded],
}

impl[P: Allocator] Handler[(), P] for Reporter {
    fn serve_http(inout _self: Self, inout _state: (), request: Request[P], inout _body: RequestBody[P]) -> Result[Response[P], Error[P]] where carries(request), borrows(_body), retains(_body: _body) {
        text(request, "ok")
    }
}

impl Observer for Reporter {
    fn observe[P: Allocator](inout self: Self, event: Event[P]) {
        match read event {
            Exchanged(exchange) => {
                let timed_out = timed_out_reading(exchange)
                self.recorded.call([sink timed_out] |inout recorded: Recorded| &recorded.exchanged(timed_out))
            },
            Listening(_) => {},
            AcceptRetried(retry) => {
                let pause_ms = retry.pause.nanoseconds() / 1000000
                self.recorded.call([sink pause_ms] |inout recorded: Recorded| &recorded.retried(pause_ms))
            },
        }
    }
}

// `Announcer` answers every request with "ok" and reports to `report` that it
// was told the address `listen_and_serve` bound, with whether its port is
// known, and that an exchange ended.
@derive(Release)
struct Announcer {
    report: log.Logger[fs.File],
}

impl[P: Allocator] Handler[(), P] for Announcer {
    fn serve_http(inout _self: Self, inout _state: (), request: Request[P], inout _body: RequestBody[P]) -> Result[Response[P], Error[P]] where carries(request), borrows(_body), retains(_body: _body) {
        text(request, "ok")
    }
}

impl Observer for Announcer {
    fn observe[P: Allocator](inout self: Self, event: Event[P]) {
        match read event {
            Listening(address) => self.report.info("announced", log.field("bound", address.port != 0)),
            Exchanged(_) => self.report.info("exchanged", ()),
            AcceptRetried(_) => {},
        }
    }
}

// `Tally` is the state a route shares in a test.
@derive(Release)
struct Tally {
    visits: UInt64,
}

// One exchange retains its connection and buffered next-request bytes until
// every response view has been written and the unread body has been drained.
fn answer_reading[H: Handler[(), P] + Observer, P: Allocator](sink reading: Reading, inout handler: H, memory: mem.Handle[P], inout refusal: mem.Buffer[P], limits: Limits, closing: Bool, stopping: Option[task.Client[Bool]] = .None) -> ExchangeRead where carries() {
    var reader = reading
    let probe = memory.acquire(0) else |_| {
        refuse_for_want_of_arena(reader.abandon(), &handler, memory, &refusal, limits)
        return .Unavailable
    }
    probe.release()
    let parsed = read_request_head(&reader, memory, limits)
    let ParsedHead { head, line, header_fields, length } = parsed else |reason| {
        return refuse_reading(reader, &handler, memory, &refusal, limits, reason)
    }
    let message = assembled(memory, head, line, header_fields, empty_payload(memory), limits) else |reason| {
        return refuse_reading(reader, &handler, memory, &refusal, limits, reason)
    }
    answer_message(reader, &handler, memory, &refusal, limits, closing, stopping, message, length.unwrap_or(0))
}

// Settle the parsed message, response and body before returning the connection.
fn answer_message[H: Handler[(), P] + Observer, P: Allocator](sink reader: Reading, inout handler: H, memory: mem.Handle[P], inout refusal: mem.Buffer[P], limits: Limits, closing: Bool, stopping: Option[task.Client[Bool]], sink message: Message[P], length: UInt64) -> ExchangeRead where carries() {
    let request = message.request()
    var incoming: RequestBody[P] = RequestBody.from_reader(reader, length, limits, memory)
    var note = String.new_in(memory)
    let start = time.Instant.now()
    let (answered, kept) = answer_body(&handler, request, &incoming, &note, closing, stopping)
    let duration = start.elapsed()
    let aborted = match read answered.sent.delivery { Whole => false, Memory => false, _ => true }
    let event: Event[P] = .Exchanged(.{ request = .Some(request), status = .Some(copy(answered.status)), body_bytes = answered.sent.body_bytes, duration = .Some(duration), failure = answer_failure(answered, note) })
    &handler.observe(event)
    let drained = if aborted {
        false
    } else {
        &incoming.drain(&refusal).is_ok()
    }
    let recovered = incoming.into_reader().unwrap()
    if aborted {
        reset_connection(recovered.abandon())
        return .Closed
    }
    if kept && drained && !closing {
        return .Idle(recovered)
    }
    close_connection(recovered.abandon())
    .Closed
}

// The response may observe the handler and cached input; this call settles
// both the response and its output view before the caller drains the input.
fn answer_body[H: Handler[(), P], P: Allocator](inout handler: H, request: Request[P], inout incoming: RequestBody[P], inout note: String[mem.Handle[P]], closing: Bool, stopping: Option[task.Client[Bool]]) -> (Answered, Bool) where carries(), retains(incoming: incoming) {
    let bytes = request.allocator().acquire(response_buffer_bytes) else |_| {
        var writer = incoming.writer()
        let delivery: Delivery = match refuse_writer(&writer, .InternalServerError, request.allocator()) {
            Ok(_) => .Memory,
            Err(error) => .Write(error),
        }
        return (Answered { status = .InternalServerError, refused = false, noted = .Absent, sent = .{ delivery, body_bytes = 0 } }, false)
    }
    var nothing = ()
    let routed = &handler.serve_http(&nothing, request, &incoming)
    let stopping_now = match read stopping {
        Some(flag) => flag.call(|inout state: Bool| state),
        None => false,
    }
    let persistent = !closing && !stopping_now && !request.closes_connection() && !incoming.failed()
    var output = BodyWriter.open_borrowed(bytes, incoming.writer(), request, persistent)
    let writing: Writing[P] = match routed {
        Ok(response) => {
            let status = response.status()
            Writing[P] { status, refused = false, noted = .Absent, written = write_response(&output, response, request.method() == .Head) }
        },
        Err(error) => {
            let status = error.status()
            let noted = copy_message(&note, error.message())
            Writing[P] { status, refused = true, noted, written = write_error(&output, error, request.method() == .Head) }
        },
    }
    let Writing { status, refused, noted, written } = writing
    let kept = output.keeps_alive()
    let sent = settle_borrowed(output, written, &note)
    let whole = match read sent.delivery { Whole => true, _ => false }
    (Answered { status, refused, noted, sent }, kept && whole)
}

fn settle_borrowed[P: Allocator](sink body: BodyWriter[P], sink written: Result[(), WriteError[P]], inout note: String[mem.Handle[P]]) -> Sent {
    let body_bytes = body.body_bytes
    match written {
        Ok(_) => match body.finish_borrowed() {
            Ok(_) => .{ delivery = .Whole, body_bytes },
            Err(error) => .{ delivery = .Write(error), body_bytes },
        },
        Err(error) => {
            body.abandon_borrowed()
            match error {
                Io(reason) => .{ delivery = .Write(reason), body_bytes },
                Stream(stopped) => {
                    let noted = copy_message(&note, stopped.message())
                    Sent { delivery = .Stream(stopped.status(), noted), body_bytes }
                },
            }
        },
    }
}

fn refuse_writer[A: Allocator](inout writer: net.ConnectionWriter, status: Status, allocator: A) -> Result[(), io.IoError] where carries() {
    let headers: ResponseHeaders[A] = ResponseHeaders.new_in(allocator)
    let written = write_head(&writer, status, headers, .Http)
    headers.release()
    match written {
        Ok(_) => .Ok(()),
        Err(failure) => .Err(io.IoError.from(failure)),
    }
}

struct Writing[P: Allocator] {
    status: Status,
    refused: Bool,
    noted: Noted,
    written: Result[(), WriteError[P]],
}

fn empty_payload[P: Allocator](memory: mem.Handle[P]) -> Vec[UInt8, mem.Handle[P]] where carries(memory) {
    Vec.new_in(memory)
}

fn form_health[P: Allocator](inout _: (), request: Request[P], inout body: RequestBody[P]) -> Result[Response[P], Error[P]] where carries(request), borrows(body), retains(body: body) {
    let materialized = &body.materialize(request)?
    text(materialized, "ok")
}

fn form_health_router() -> Router[()] {
    var router: Router[()] = Router.new()
    &router.route_raw("POST /health", form_health).unwrap()
    router
}

// A refusal must reach the client before input left in the kernel is closed.
fn refuse_reading[H: Observer, P: Allocator](sink reader: Reading, inout handler: H, memory: mem.Handle[P], inout scratch: mem.Buffer[P], limits: Limits, sink reason: RequestError) -> ExchangeRead where carries() {
    let status = reason.status()
    let refused: Result[(), io.IoError] = {
        var writer = reader.inspect_reader(|connection: net.Connection| -> net.ConnectionWriter where borrows(connection) connection.writer())
        match read status {
            Some(answer) => refuse_writer(&writer, answer, memory),
            None => .Ok(()),
        }
    }
    var connection = reader.abandon()
    if status.is_some() {
        linger(&connection, &scratch, limits.read_timeout_ms)
    }
    close_connection(connection)
    if reason != RequestError.Closed {
        let failure: Failure = match refused {
            Ok(_) => .Unread(reason),
            Err(error) => .Write(error),
        }
        let event: Event[P] = .Exchanged(.{ request = .None, status, body_bytes = 0, duration = .None, failure = .Some(failure) })
        &handler.observe(event)
    }
    .Closed
}

test fn streaming_body_limits_do_not_reserve_the_body_in_the_arena() {
    let limits = Limits { max_body_bytes = UInt64.max, max_form_pairs = UInt64.max, ..serving(0) }
    testing.assert_eq(smallest_arena(limits), smallest_arena(serving(0)), "streaming limits changed metadata storage")?
    let listener = net.listen(net.loopback(0)).unwrap()
    testing.assert_ok_eq(serve(listener, health_router, limits: limits, policy: .Sequential, shutdown: .Manual), (), "a streamed body was reserved before serving")
}
