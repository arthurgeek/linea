@linear
struct Token { id: UInt8 }

fn take(sink token: Token) -> UInt8 {
    let Token { id } = token
    id
}

// On the early path the inner `defer` finds `token` already taken, so it does
// not run at all: its write does not refill `token`, and the outer `defer`,
// finding `token` gone as well, does not run either. On the other path both
// run, the inner one taking the first token and putting a new one in its
// place for the outer one to take.
fn run(early: Bool) -> UInt8 {
    var token: Token = .{ id = 1 }
    defer {
        let _last = take(token)
    }
    {
        defer {
            let _inner = take(token)
            token = .{ id = 5 }
        }
        if early {
            let _first = take(token)
            return 1
        }
    }
    2
}

fn main() -> UInt8 {
    run(true) + run(false)
}
