impl[R: Reader, A: Allocator] BufferedReader[R, A] {
    // Resume a failed raw line and return its bytes as an owned vector.
    pub fn resume_raw_line(inout self: Self, max_bytes: UInt64) -> Result[Option[Vec[UInt8, A]], LineError[R.Error]] where carries(.Ok: self.record, self.allocator), carries(.Err.Input.reason: self.reader), retains(self.record: self.allocator) {
        if !self.can_resume(true) {
            return .Err(.ResumeUnavailable)
        }
        let filled = &self.fill(max_bytes)?
        if !filled {
            return .Ok(.None)
        }
        let length = self.length
        .Ok(.Some(&self.take_bytes(length)))
    }
}

test fn raw_resume_preserves_invalid_utf8_and_the_terminator() {
    defer var bytes = mem.system().acquire(2).unwrap()
    // FF is invalid UTF-8; the following line-ending bytes test record framing.
    &bytes.store_byte(0, 255)
    &bytes.store_byte(1, 10)
    let source = FragmentReader { bytes = bytes.as_slice(), position = 0, step = 1, fail_at = UInt64.max }
    var reader = BufferedReader.open(capacity: 1, reader: source) else |_| {
        return testing.assert(false, "reader allocation failed")
    }
    let limited = match &reader.read_raw_line(max_bytes: 0) {
        Err(Limit) => true,
        Err(_) => false,
        Ok(line) => {
            line.release()
            false
        },
    }
    let resumed = match &reader.resume_raw_line(max_bytes: 2) {
        Err(_) => false,
        Ok(None) => false,
        Ok(Some(line)) => {
            let intact = line.length() == 2 && line[0] == 255 && line[1] == 10
            line.release()
            intact
        },
    }
    let _source = reader.abandon()
    testing.assert(limited && resumed, "raw recovery validated or changed input bytes")?
    .Ok(())
}

