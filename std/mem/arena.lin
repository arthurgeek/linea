import std.testing

// An Arena hands out pieces of one backing buffer, and they are released
// together with the arena.
@opaque
struct Arena[H: Allocator] {
    /// None if allocation failed; subsequent acquire calls then return Oom.
    slab: Option[Buffer[H]],
}

// A Handle allocates from an arena it borrows. Live handles prevent the
// arena's move or release; copying a handle preserves that borrow. Each
// `Buffer[A]` retains its concrete allocator `A`, and a nested arena owns its
// backing buffer. Moving, replacing or releasing an arena conflicts with live
// handles and allocations observing it; moving an unobserved arena into or out
// of a generic function is an ordinary move.
@(opaque, copyable)
struct Handle[H: Allocator = SystemAllocator] {
    owner: borrow Arena[H],
}

impl[H: Allocator] Arena[H] {
    // Reserve size bytes from h. If that fails, acquire calls return Oom.
    pub fn open(h: H, size: UInt64) -> Arena[H] where carries(.slab.Some: h) {
        match h.acquire(size) {
            Err(_) => .{ slab = .None },
            Ok(b) => .{ slab = .Some(b) },
        }
    }

    // Release resources before assertions: a failing assertion returns early.
    test fn an_arena_hands_out_storage_and_gives_the_slab_back() {
        let arena = Arena.open(system(), 4096)
        let a = arena.handle()

        var refused = true
        var fresh: UInt64 = 1
        var one: UInt64 = 0
        var two: UInt64 = 0
        var length: UInt64 = 0

        match a.acquire(64) {
            Err(_) => {},
            Ok(first_buffer) => {
                var first = first_buffer
                match a.acquire(32) {
                    Err(_) => first.release(),
                    Ok(second_buffer) => {
                        var second = second_buffer
                        refused = false
                        fresh = first.load(0)
                        &first.store(0, 111)
                        &second.store(0, 222)
                        one = first.load(0)
                        two = second.load(0)
                        length = first.length()
                        second.release()
                        first.release()
                    },
                }
            },
        }

        arena.release()

        testing.assert(!refused, "an arena of four thousand bytes refused ninety-six")?
        testing.assert_eq(fresh, 0, "an arena hands out storage holding something")?
        testing.assert_eq(one, 111, "an allocation lost what was stored in it")?
        testing.assert_eq(two, 222, "two allocations out of one arena overlap")?
        testing.assert_eq(length, 64, "an allocation is not as long as it was asked for")?

        .Ok(())
    }

    test fn a_handle_written_without_a_parent_is_a_handle_over_the_system() {
        let arena = Arena.open(system(), 64)
        let short: Handle = arena.handle()
        let long: Handle[SystemAllocator] = short
        var acquired = false
        match long.acquire(8) {
            Err(_) => {},
            Ok(buffer) => {
                var held = buffer
                acquired = true
                held.release()
            },
        }
        arena.release()
        testing.assert(acquired, "a handle over the system allocator refused eight bytes")?
    }

    // Release the inner arena before the outer arena that owns its storage.
    test fn an_arena_backs_another_arena() {
        let outer = Arena.open(system(), 4096)
        let a = outer.handle()

        let inner = Arena.open(a, 1024)
        let b = inner.handle()

        var refused = true
        var fresh: UInt64 = 1
        var kept: UInt64 = 0

        match b.acquire(128) {
            Err(_) => {},
            Ok(buffer) => {
                var held = buffer
                refused = false
                fresh = held.load(8)
                &held.store(8, 999)
                kept = held.load(8)
                held.release()
            },
        }

        inner.release()
        outer.release()

        testing.assert(!refused, "an arena over an arena refused what its slab holds")?
        testing.assert_eq(fresh, 0, "an arena over an arena hands out storage holding something")?
        testing.assert_eq(kept, 999, "an allocation out of a nested arena lost what was stored in it")?

        .Ok(())
    }

    test fn an_arena_the_backing_refused_refuses_everything() {
        // The largest byte count cannot be reserved as one addressable allocation.
        let arena = Arena.open(system(), UInt64.max)
        let a = arena.handle()

        var handed = false

        match a.acquire(8) {
            Err(_) => {},
            Ok(b) => {
                handed = true
                b.release()
            },
        }

        arena.release()

        testing.assert(!handed, "an arena holding no slab handed out storage")?

        .Ok(())
    }
}

impl[H: Allocator] Release for Arena[H] {
    // Return the backing buffer after dependent allocations have been disposed.
    fn release(sink self: Self) {
        let Arena { slab: slab } = self
        match slab {
            None => {},
            Some(buffer) => buffer.release(),
        }
    }
}

// The shared UInt64 cursor occupies the first eight bytes, outside every
// allocation. Reservations use the same eight-byte alignment as Buffer.
let arena_header: UInt64 = 8

impl[H: Allocator] Lender for Arena[H] {
    type Handle = Handle[H]

    fn handle(self: Self) -> Handle[H] {
        .{ owner = borrow self }
    }
}

// An ArenaReservation is where a reservation starts and how many bytes it
// occupies after rounding.
struct ArenaReservation {
    at: UInt64,
    allocated: UInt64,
}

// Reserve `size` bytes, rounded up to eight, by advancing the cursor, or
// answer None when the arena cannot hold them. Only the private cursor is
// mutable through a handle. Allocated bytes are disjoint from the header and
// remain untouched by subsequent reservations.
fn arena_reserve[H: Allocator](owner: Arena[H], size: UInt64) -> Option[ArenaReservation] where carries() {
    match read owner.slab {
        None => .None,
        Some(buffer) => {
            if buffer.len < arena_header || size > buffer.len || size > UInt64.max - (arena_header - 1) {
                return .None
            }
            // Empty reservations still occupy one aligned slot. Other sizes
            // round up to a multiple of eight without advancing on overflow.
            let want = if size == 0 {
                arena_header
            } else {
                (size + arena_header - 1) / arena_header * arena_header
            }
            let used = linea_raw_load(buffer.at, buffer.len, 0)
            let available = buffer.len - arena_header
            if used > available || want > available - used {
                return .None
            }
            let at = buffer.at + arena_header + used
            linea_raw_store(buffer.at, buffer.len, 0, used + want)
            return .Some(.{ at = at, allocated = want })
        },
    }
}

impl[H: Allocator] Allocator for Handle[H] {
    type Obligation = ()

    // A reservation owns disjoint zeroed bytes and retains this handle's owner.
    fn acquire(self: Self, size: UInt64) -> Result[Buffer[Handle[H]], Oom] {
        match arena_reserve(*self.owner, size) {
            None => .Err(Oom.Exhausted),
            Some(ArenaReservation { at: at, allocated: allocated }) => {
                return .Ok(.{
                    at = at,
                    len = size,
                    allocated = allocated,
                    allocator = copy(self),
                    obligation = (),
                })
            },
        }
    }

    // The buffer supplies its allocator, so callers cannot select another arena.
    // Keep extent checks before discarding a reservation; reclamation is collective.
    fn dispose(sink b: Buffer[Handle[H]]) {
        let Buffer { at: at, len: length, allocated: allocated, allocator: allocator, obligation: _ } = b
        match read allocator.owner.slab {
            None => panic("an allocation has no backing arena"),
            Some(buffer) => {
                let offset = at - buffer.at
                if offset < arena_header || offset > buffer.len || allocated > buffer.len - offset || length > allocated {
                    panic("an allocation lies outside its backing arena")
                }
            },
        }
    }
}

test fn an_arena_refuses_what_it_cannot_hold() {
    let arena = Arena.open(system(), 256)
    let a = arena.handle()

    var handed = false
    var refused = true
    var length: UInt64 = 0

    match a.acquire(4096) {
        Err(_) => {},
        Ok(b) => {
            handed = true
            b.release()
        },
    }

    match a.acquire(16) {
        Err(_) => {},
        Ok(b) => {
            refused = false
            length = b.length()
            b.release()
        },
    }

    arena.release()

    testing.assert(!handed, "an arena answered with more storage than it holds")?
    testing.assert(!refused, "an arena refused sixteen bytes it holds")?
    testing.assert_eq(length, 16, "an allocation is not as long as it was asked for")?

    .Ok(())
}

test fn allocating_again_preserves_a_live_buffer_view() {
    defer let arena = Arena.open(system(), 64)
    let handle = arena.handle()
    defer var first = handle.acquire(8).unwrap()
    &first.store_byte(0, 91)
    let view = first.as_slice()
    defer let second = handle.acquire(8).unwrap()
    testing.assert_eq(view[0], UInt8(91), "allocation bookkeeping changed observed bytes")?
    .Ok(())
}

test fn a_refused_overflowing_reservation_keeps_the_cursor() {
    // The eight-byte cursor leaves exactly 24 bytes available in this slab.
    defer let arena = Arena.open(system(), 32)
    let handle = arena.handle()
    let refused = match handle.acquire(UInt64.max) {
        Err(_) => true,
        Ok(buffer) => {
            buffer.release()
            false
        },
    }
    defer let buffer = handle.acquire(24).unwrap()
    testing.assert(refused, "an overflowing reservation was accepted")?
    testing.assert_eq(buffer.length(), UInt64(24), "refusal advanced the allocation cursor")?
    .Ok(())
}

impl[H: Allocator] Arena[H] {
    // Take back everything the arena handed out so its whole slab can be
    // handed out again. Reservations are zeroed when handed out only because
    // the unused part of the slab is kept zeroed, so rewinding zeroes the
    // bytes that were used and no others: its cost is what was used, not the
    // slab's size. It takes the arena `inout`, so no handle or allocation
    // from it can still be live.
    pub fn rewind(inout self: Self) {
        match read self.slab {
            None => {},
            Some(buffer) => {
                let used = linea_raw_load(buffer.at, buffer.len, 0)
                var offset: UInt64 = 0
                while offset < used {
                    linea_raw_store(buffer.at, buffer.len, arena_header + offset, 0)
                    offset += arena_header
                }
                linea_raw_store(buffer.at, buffer.len, 0, 0)
            },
        }
    }

    test fn a_rewound_arena_hands_out_its_slab_again_zeroed() {
        // The eight-byte cursor leaves 56 bytes to hand out.
        defer var arena = Arena.open(system(), 64)
        var first = arena.handle().acquire(56).unwrap()
        &first.store(0, 7)
        &first.store(48, 9)
        first.release()
        let full = arena.handle().acquire(8).is_err()
        &arena.rewind()
        let again = arena.handle().acquire(56).unwrap()
        let zeroed = again.load(0) == 0 && again.load(48) == 0
        again.release()
        &arena.rewind()
        &arena.rewind()
        let twice = arena.handle().acquire(56).is_ok()
        testing.assert(full, "a full arena handed out more")?
        testing.assert(zeroed, "a rewound arena handed out bytes it had not zeroed")?
        testing.assert(twice, "rewinding an empty arena lost its slab")?
        .Ok(())
    }
}
