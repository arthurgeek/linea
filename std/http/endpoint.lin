fn greedy_after_a_probe(inout _calls: CallCount, _first: First, _greedy: Greedy, _third: Third, request: ProbeRequest) -> ProbeAnswer {
    text(request, "called")
}

// An arena too small for what an extractor allocates fails the request with
// 500, as every refused allocation does, and what was already read is released
// once while the extractor after it is never read.
test fn an_extractor_the_arena_cannot_hold_answers_500_and_releases_what_was_read() {
    defer var router: Router[CallCount] = Router.new()
    testing.assert_ok_eq(&router.route("GET /greedy", greedy_after_a_probe), (), "registering failed")?
    let log = mem.ReleaseLog.open(4)
    log.tag(0).release()
    let (at, extent) = log.words()
    var calls = CallCount { calls = 0 }
    let at_text = fmt.render_owned("{at}").unwrap()
    let extent_text = fmt.render_owned("{extent}").unwrap()
    let described = served_headed(&router, &calls, "/greedy", ["X-Log-At", at_text.view(), "X-Log-Extent", extent_text.view()].as_slice(), arena_bytes: 4096)
    let held = log.holds([UInt64(0), 1].as_slice())
    let status = described.starts_with("500")
    at_text.release()
    extent_text.release()
    described.release()
    log.release()
    testing.assert(status, "an extractor the arena could not hold did not answer 500")?
    testing.assert(held, "the extractor read before the failure was not released exactly once")?
    .Ok(())
}

// `Pick` is a page of an order list, read from the query `?page=2`, and
// `Order` is a JSON body that reads itself, so the function that asks for one
// names the type and sees no wrapper.
@derive(Params, Release)
struct Pick {
    page: UInt32,
}

@derive(Release, json_format.Decode[mem.Handle[mem.SystemAllocator]])
struct Order {
    quantity: UInt64,
}

impl Extract[mem.SystemAllocator] for Order {
    fn extract(request: ProbeRequest) -> Result[Order, Error] {
        request.extract[Json[Order]]()
    }
}

fn show(id: Path[UInt64], pick: Query[Pick], order: Order, request: ProbeRequest) -> ProbeAnswer {
    text(request, "order {id.value} page {pick.value.page} of {order.quantity}")
}

test fn the_library_extractors_and_a_type_that_reads_itself_are_arguments() {
    defer var router = Router.new()
    testing.assert_ok_eq(&router.route(r"POST /orders/{id}", show), (), "registering failed")?
    let arena = mem.Arena.open(mem.system(), size: 65536)
    var sent = new_request(arena.handle(), "POST", "/orders/7?page=2", body: r#"{"quantity":3}"#).unwrap()
    &sent.add_header("Content-Type", "application/json").unwrap()
    var nothing = ()
    let described = match &router.serve_http(&nothing, sent.request()) {
        Ok(response) => response.text().unwrap() == "order 7 page 2 of 3",
        Err(_) => false,
    }
    arena.release()
    testing.assert(described, "a path, a query and a body were not read into the arguments")?
    .Ok(())
}
