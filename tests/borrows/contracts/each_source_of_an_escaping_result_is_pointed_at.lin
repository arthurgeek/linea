// One arm returns a view of `local`, the other a view of `b`: both are
// pointed at, each with what it is.
fn pick(_a: String, b: String, flag: Bool) -> Str where borrows(_a) {
    let local = String.new()
    defer local.release()
    if flag {
        local.view()
    } else {
        b.view()
    }
}

fn main() -> UInt8 {
    defer let a = String.new()
    defer let b = String.new()
    UInt8(pick(a, b, true).length())
}
