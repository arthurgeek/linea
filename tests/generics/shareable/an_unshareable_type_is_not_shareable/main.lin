// A cursor declared `unshareable` may not be read by two tasks at once, and
// neither may anything that holds one.
@unshareable
struct Cursor {
    at: UInt64,
}

struct Reader {
    cursor: Cursor,
}

fn share[T: Shareable](_value: T) -> UInt64 {
    1
}

fn main() -> UInt8 {
    let cursor = Cursor { at = 2 }
    let reader = Reader { cursor = Cursor { at = 3 } }
    let at = reader.cursor.at
    UInt8(share(cursor) + share(reader) + share(at))
}
