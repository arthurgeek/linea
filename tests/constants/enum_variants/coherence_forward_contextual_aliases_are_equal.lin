enum Mode { Preserve, Replace }

let chosen = later

let later: Mode = .Preserve

trait Select[phantom F] {}

struct Holder {}

impl Select[fn(read mode: Mode = chosen) -> UInt8] for Holder {}

impl Select[fn(read mode: Mode = Mode.Preserve) -> UInt8] for Holder {}

fn main() -> UInt8 {
    let _holder = Holder {}
    0
}
