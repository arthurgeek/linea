// A conditional copyable struct cannot duplicate an unbounded associated
// type. The generic body must reject copying its linear payload.
@linear
enum Key {
    Forged(UInt8),
}

struct Counter {
    at: UInt8,
}

trait Measure {
    type Item

    fn of(sink x: Self) -> Self.Item
}

impl Measure for Counter {
    type Item = Key

    fn of(sink x: Self) -> Self.Item {
        Key.Forged(x.at)
    }
}

@copyable
struct Box[W: Measure] {
    held: W.Item,
}

trait Twin {
    fn twin(self: Self) -> Self
}

impl[W: Measure] Twin for Box[W] {
    fn twin(self: Self) -> Self {
        copy(self)
    }
}

fn eat(sink k: Key) -> UInt8 {
    match k {
        Forged(n) => n,
    }
}

fn main() -> UInt8 {
    let c: Counter = .{ at = 3 }
    let b: Box[Counter] = .{ held = Measure.of(c) }
    let g: Box[Counter] = Twin.twin(b)
    let Box { held: k } = b
    let Box { held: j } = g
    eat(k) + eat(j)
}
