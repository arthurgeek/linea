// A generic trait's whole-result contract is adopted by a generic
// implementation, with the trait's parameters read as the implementation's.
import std.io

struct Request[T] {
    tag: T,
    name: Str,
}

trait Handler[T] {
    fn handle(self: Self, request: Request[T]) -> Option[Str] where carries(request)
}

struct Greeter {
    motd: Str,
}

impl[T] Handler[T] for Greeter {
    fn handle(_self: Self, request: Request[T]) -> Option[Str] {
        .Some(copy(request.name))
    }
}

fn serve[T, H: Handler[T]](handler: H, request: Request[T]) -> Option[Str] where carries(request) {
    handler.handle(request)
}

fn main() -> UInt8 {
    let motd = "welcome".to_owned().unwrap()
    let greeter = Greeter { motd = motd.view() }
    let numbered: Request[Int64] = .{ tag = 1, name = "numbered" }
    let flagged: Request[Bool] = .{ tag = true, name = "flagged" }
    let first = serve(greeter, numbered)
    let second = serve(greeter, flagged)
    motd.release()
    let _first = io.println(first.unwrap_or("none"))
    let _second = io.println(second.unwrap_or("none"))
    0
}
