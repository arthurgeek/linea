// An array compares through its slice view, and an operation it answers
// that way is a value like any other, at a known length and in a generic
// body instantiated at an array.
fn same_twice[T: Equatable](first: T, second: T) -> Bool {
    let equal = Equatable.equals
    equal(first, second)
}

fn main() -> UInt8 {
    let equal = Equatable.equals
    let before = Comparable.less
    let pair: [UInt8; 2] = [1, 2]
    let other: [UInt8; 2] = [1, 3]
    let triple: [UInt16; 3] = [4, 5, 6]
    var score: UInt8 = 0
    if equal(pair, pair) {
        score += 1
    }
    if before(pair, other) {
        score += 2
    }
    if same_twice(pair, pair) {
        score += 4
    }
    if !same_twice(triple, [4, 5, 7]) {
        score += 8
    }
    score
}
