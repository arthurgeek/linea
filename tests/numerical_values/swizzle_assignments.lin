fn main() -> UInt8 {
    var v = [Int32(1), 2, 3, 4]
    v.xy = v.yx
    if v[0] != 2 || v[1] != 1 {
        return 1
    }
    v.zw = [Int32(8), 9]
    v.x = 5
    v.a = 7
    v.yz += [Int32(2), 3]
    v.wx *= 2
    if v[0] != 10 || v[1] != 3 || v[2] != 11 || v[3] != 14 {
        return 2
    }
    v.xyz = v.yxx
    if v[0] != 3 || v[1] != 10 || v[2] != 10 || v[3] != 14 {
        return 3
    }
    0
}
