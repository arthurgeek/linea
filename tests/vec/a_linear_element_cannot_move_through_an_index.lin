import std.mem

@linear
struct Token { number: UInt64 }

impl Release for Token {
    fn release(sink self: Self) -> () {
        let Token { number: _ } = self
    }
}

fn main() -> UInt8 {
    var values: Vec[Token, mem.SystemAllocator] = Vec.new()
    let token: Token = .{ number = 7 }
    match Vec.push(&values, token) { Ok(_) => {}, Err(_) => panic("push failed") }
    let stolen = values[0]
    stolen.release()
    values.release()
    0
}
