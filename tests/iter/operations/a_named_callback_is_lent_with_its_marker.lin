import std.io

// `any` is lent its predicate and may change it. `heavy` is a variable of
// `main`'s, so it is passed as `&heavy`.
fn main() -> Result[UInt8, io.IoError] {
    let limit: UInt64 = 4
    var heavy = [limit] |sink weight: UInt64| weight > limit
    let first = (UInt64(1)..10).any(heavy)
    let second = (UInt64(1)..3).any(heavy)
    io.println("{first} {second}")?
    .Ok(0)
}
