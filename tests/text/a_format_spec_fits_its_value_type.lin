// A sign and zero padding lay out numbers, a precision counts the digits
// after a Float64's point, and hexadecimal digits write an integer, so each
// is refused on a value of another type. A generic value is not known to be a
// number, so it takes only fill, alignment and width.
import std.io

use io.IoError
use io.println

fn column[T: Copyable + Display](value: T) -> Result[(), IoError] {
    println("{value:>6}")?
    println("{value:06}")?
    println("{value:x}")
}

fn main() -> Result[UInt8, IoError] {
    let name = "Ada"
    let count = 42
    let ready = true
    println("{name:.2}")?
    println("{count:.2}")?
    println("{name:05}")?
    println("{ready:+}")?
    println("{name:>+6?}")?
    let price = 2.5
    println("{price:x}")?
    println("{name:X}")?
    column(count)?
    return .Ok(0)
}
