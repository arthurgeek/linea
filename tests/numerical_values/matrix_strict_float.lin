import std.num

fn ordered_product(magnitude: Float32) -> Float32 {
    let row = num.matrix([[magnitude, 1.0, -magnitude]])
    let column = num.matrix([[Float32(1.0)], [1.0], [1.0]])
    let product = row * column
    product[0, 0]
}

fn overflowing_product(magnitude: Float32) -> Float32 {
    let row = num.matrix([[magnitude, magnitude]])
    let column = num.matrix([[Float32(2.0)], [-2.0]])
    let product = row * column
    product[0, 0]
}

fn single_product(left: Float32, right: Float32) -> Float32 {
    let product = num.matrix([[left]]) * num.matrix([[right]])
    product[0, 0]
}

fn main() -> UInt8 {
    let a = num.matrix([[Float32.from_bits(1065353217), Float32.from_bits(3212836864)]])
    let b = num.matrix([[Float32.from_bits(1065353215)], [1.0]])
    let product = a * b
    if product[0, 0].to_bits() != 0 {
        return 1
    }
    let payload = Float32.from_bits(2141266757)
    let original = num.matrix([[payload, Float32.from_bits(2147483648)]])
    let negative = -original
    if negative[0, 0].to_bits() != 4288750405 || negative[0, 1].to_bits() != 0 {
        return 2
    }
    let computed = original * 1.0
    if computed[0, 0].to_bits() != 2143289344 || computed[0, 1].to_bits() != 2147483648 {
        return 3
    }
    let small = num.matrix([[Float32.from_bits(2)]]) * 0.5
    if small[0, 0].to_bits() != 1 {
        return 4
    }
    // At 2^24 the first addition rounds back to 2^24. The last lane cancels it.
    if ordered_product(16777216.0).to_bits() != 0 {
        return 5
    }
    // Opposite finite products overflow separately and their infinities sum to NaN.
    if overflowing_product(Float32.from_bits(2139095039)).to_bits() != 2143289344 {
        return 6
    }
    let inputs = [Float32.from_bits(2), Float32.from_bits(3), Float32.from_bits(2147483648), payload, Float32.from_bits(2139095040)]
    let factors: [Float32; 5] = [0.5, 0.5, 1.0, 1.0, 0.0]
    let expected: [UInt32; 5] = [1, 2, 0, 2143289344, 2143289344]
    for i in UInt64(0)..5 {
        if single_product(inputs[i], factors[i]).to_bits() != expected[i] {
            return 7
        }
    }
    0
}
