// The wrap builds `R.Count(value)` before anything says what `lifted` is,
// because the variant belongs to the derive's target, `R`.
trait Lift[T] {
    fn lift(sink value: T) -> Self
}

template impl[S] Lift[S] where reflect.target: enum {
    fn lift(sink value: S) -> Self {
        let lifted = reflect.wrap(value)
        lifted
    }
}

@derive(Lift[UInt8])
enum R {
    Count(UInt8),
}

fn main() -> UInt8 {
    match R.lift(UInt8(7)) {
        Count(v) => v,
    }
}
