@linear
pub enum Key { Forged(UInt8) }

pub fn mint(id: UInt8) -> Key {
    Key.Forged(id)
}

// `sink` takes ownership, so the obligation arrives with the argument and
// this is where it has to end. Nothing here ends it.
//
// The name is `_k`, which exempts it from [N-Unused] and from nothing else:
// saying the value will not be used is not the same claim as saying it may be
// discarded, and only the second would make this legal.
pub fn swallow(sink _k: Key) -> UInt8 {
    1
}
