// Monomorphisation is where a generic call stops being generic, so a cursor
// on one says what it instantiated to. Two calls on one declaration reach two
// instantiations, and the answer is each call's own.
fn ident[T: Copyable](a: T) -> T {
    copy(a)
}

fn main() -> UInt8 {
    let n: UInt8 = 3
    let same: UInt8 = ident(n)
    let flag: Bool = ident(true)

    if flag {
        same
    } else {
        0
    }
}
