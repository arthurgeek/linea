// Both binders of a walk's tuple pattern name the same place, so writing `b`
// while `a` is still in use overlaps the lend even though the components are
// disjoint.
fn main() -> UInt8 {
    var pairs: [(UInt8, UInt8); 2] = [(1, 2), (3, 4)]
    var total: UInt8 = 0
    for inout (a, b) in pairs {
        b = 1
        total += a
    }
    total
}
