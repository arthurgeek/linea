test fn int8_to_uint16_preserves_exact_values_and_checks_bounds() {
    let lower = UInt16.try_from(Int8(0))
    testing.assert_eq(lower, Option.Some(UInt16(0)), "lower accepted value changed")?
    let interior = UInt16.try_from(Int8(1))
    testing.assert_eq(interior, Option.Some(UInt16(1)), "interior accepted value changed")?
    let upper = UInt16.try_from(Int8(127))
    testing.assert_eq(upper, Option.Some(UInt16(127)), "upper accepted value changed")?
    let below = UInt16.try_from(Int8(-1))
    match below {
