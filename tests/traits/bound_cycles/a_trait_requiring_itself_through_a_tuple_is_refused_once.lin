// `G[T]` requires `G[(T, T)]`, a longer argument at every step round the
// cycle. The cycle is reported once and its requirements are walked one step
// round, wherever the trait is declared.
trait G[T]: G[(T, T)] {
    fn g(self: Self, by: T) -> UInt8
}

fn _grow[S: G[UInt8]](s: S) -> UInt8 {
    s.g(1)
}

fn main() -> UInt8 {
    0
}
