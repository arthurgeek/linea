// [O-DeferDead]. Both branches give the value away, so the `defer` that would
// consume it is skipped on every path out.
struct Key {
    n: UInt8,
}

fn open(sink k: Key) -> UInt8 {
    let Key { n } = k
    n
}

fn lock(sink k: Key) -> () {
    let Key { n: _n } = k
}

fn go(flag: Bool) -> UInt8 {
    let k: Key = .{ n = 7 }
    defer lock(k)
    if flag {
        open(k)
    } else {
        open(k) + 1
    }
}

fn main() -> UInt8 {
    go(true)
}
