struct Celsius { value: Float64 }

fn main() -> UInt8 {
    let value = 20.0
    let named = Celsius { value }
    let commented = Celsius {
        // Comments do not change how a bare field label is read.
        value = 20.0,
    }
    let contextual: Celsius = .{ value = 20.0 }
    if named.value == contextual.value && commented.value == contextual.value {
        0
    } else {
        1
    }
}
