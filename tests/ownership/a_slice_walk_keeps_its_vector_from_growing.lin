import std.mem

// The walk reads the vector's storage through its slice on every pass, so the
// body cannot push: growing the vector may move that storage.
fn main() -> UInt8 {
    var values = mem.Vec.filled(2, UInt64(7)) else |_| {
        return 1
    }
    var walked: UInt64 = 0
    for _ in values.as_slice() {
        walked += 1
        if walked < 4 {
            match &values.push(walked) {
                Ok(_) => {},
                Err(_) => {
                    walked += 100
                },
            }
        }
    }
    let length = values.length()
    values.release()
    UInt8(walked * 10 + length)
}
