// Compare strict scalar contraction orders over row and column storage.
// Construction and transposition precede the timed resident computations.
import std.bench
import std.env
import std.io
import std.mem
import std.num

fn fixture[let rows: UInt64, let columns: UInt64](seed: UInt64) -> [[Float32; columns]; rows] {
    var values: [[Float32; columns]; rows] = mem.filled(mem.filled[Float32, columns](0.0))
    for row in 0..values.length() {
        for column in 0..values[row].length() {
            values[row][column] = Float32(Int32((row * 7 + column * 3 + seed % 23) % 23) - 11) / 16.0
        }
    }
    values
}

fn transpose[let rows: UInt64, let columns: UInt64](values: [[Float32; columns]; rows]) -> [[Float32; rows]; columns] {
    var result: [[Float32; rows]; columns] = mem.filled(mem.filled[Float32, rows](0.0))
    for row in 0..values.length() {
        for column in 0..values[row].length() {
            result[column][row] = values[row][column]
        }
    }
    result
}

fn matvec_row[let rows: UInt64, let columns: UInt64](matrix: [[Float32; columns]; rows], vector: [Float32; columns]) -> [Float32; rows] {
    var result: [Float32; rows] = mem.filled(0.0)
    for row in 0..result.length() {
        for column in 0..vector.length() {
            result[row] += matrix[row][column] * vector[column]
        }
    }
    result
}

fn matvec_column[let rows: UInt64, let columns: UInt64](matrix: [[Float32; rows]; columns], vector: [Float32; columns]) -> [Float32; rows] {
    var result: [Float32; rows] = mem.filled(0.0)
    for column in 0..vector.length() {
        for row in 0..result.length() {
            result[row] += matrix[column][row] * vector[column]
        }
    }
    result
}

fn vecmat_row[let rows: UInt64, let columns: UInt64](vector: [Float32; rows], matrix: [[Float32; columns]; rows]) -> [Float32; columns] {
    var result: [Float32; columns] = mem.filled(0.0)
    for row in 0..vector.length() {
        for column in 0..result.length() {
            result[column] += vector[row] * matrix[row][column]
        }
    }
    result
}

fn vecmat_column[let rows: UInt64, let columns: UInt64](vector: [Float32; rows], matrix: [[Float32; rows]; columns]) -> [Float32; columns] {
    var result: [Float32; columns] = mem.filled(0.0)
    for column in 0..result.length() {
        for row in 0..vector.length() {
            result[column] += vector[row] * matrix[column][row]
        }
    }
    result
}

fn matmul_row[let rows: UInt64, let inner: UInt64, let columns: UInt64](left: [[Float32; inner]; rows], right: [[Float32; columns]; inner]) -> [[Float32; columns]; rows] {
    var result: [[Float32; columns]; rows] = mem.filled(mem.filled[Float32, columns](0.0))
    for row in 0..result.length() {
        for k in 0..right.length() {
            for column in 0..result[row].length() {
                result[row][column] += left[row][k] * right[k][column]
            }
        }
    }
    result
}

fn matmul_column[let rows: UInt64, let inner: UInt64, let columns: UInt64](left: [[Float32; rows]; inner], right: [[Float32; inner]; columns]) -> [[Float32; rows]; columns] {
    var result: [[Float32; rows]; columns] = mem.filled(mem.filled[Float32, rows](0.0))
    for column in 0..result.length() {
        for k in 0..left.length() {
            for row in 0..result[column].length() {
                result[column][row] += left[k][row] * right[column][k]
            }
        }
    }
    result
}

fn shifted[let rows: UInt64, let columns: UInt64](matrix: [[Float32; columns]; rows], delta: Float32) -> [[Float32; columns]; rows] {
    var result = copy(matrix)
    for row in 0..result.length() {
        result[row] += delta
    }
    result
}

fn hash_matrix[let rows: UInt64, let columns: UInt64](matrix: [[Float32; columns]; rows]) -> UInt64 {
    var total = UInt64(0)
    for row in 0..matrix.length() {
        total += hash(matrix[row])
    }
    total
}

fn input[let count: UInt64](iteration: UInt64) -> [Float32; count] {
    var values: [Float32; count] = mem.filled(0.0)
    for lane in 0..values.length() {
        values[lane] = Float32((iteration % 17 + (lane % 17) * 3) % 17 + 1) / 16.0
    }
    values
}

fn hash[let count: UInt64](values: [Float32; count]) -> UInt64 {
    var result = UInt64(0)
    for read value in values {
        result += UInt64(value.to_bits())
    }
    result
}

fn compare[F: fn(iteration: UInt64) -> UInt64, G: fn(iteration: UInt64) -> UInt64](name: Str, row: F, column: G, repetitions: UInt64) -> Result[UInt8, io.IoError] {
    let schedule = bench.Schedule.new(warmups: 0, repetitions: repetitions, samples: 9, cases: 2).unwrap()
    io.println("config,{name},warmups,{schedule.warmups()},samples,{schedule.samples()},cases,{schedule.cases()},repetitions,{schedule.repetitions()}")?
    for round in 0..schedule.rounds() {
        var times: [UInt64; 2] = [0, 0]
        var checks: [UInt64; 2] = [0, 0]
        for turn in 0..schedule.cases() {
            let which = schedule.case_at(round, turn).unwrap()
            var checksum = UInt64(0)
            times[which] = if which == 0 {
                schedule.measure(
                    inout [row, inout checksum] |i| {
                        checksum += bench.black_box(row(i))
                    },
                )
            } else {
                schedule.measure(
                    inout [column, inout checksum] |i| {
                        checksum += bench.black_box(column(i))
                    },
                )
            }
            checks[which] = checksum
        }
        if checks[0] != checks[1] {
            return .Ok(2)
        }
        io.println("{name},{round},{repetitions},{times[0]},{times[1]},{checks[0]}")?
    }
    .Ok(0)
}

// An independent cell-at-a-time oracle retains increasing contraction order.
fn reference_product[let rows: UInt64, let inner: UInt64, let columns: UInt64](left: [[Float32; inner]; rows], right: [[Float32; columns]; inner]) -> [[Float32; columns]; rows] {
    var result: [[Float32; columns]; rows] = mem.filled(mem.filled[Float32, columns](0.0))
    for row in 0..result.length() {
        for column in 0..result[row].length() {
            for k in 0..right.length() {
                result[row][column] += left[row][k] * right[k][column]
            }
        }
    }
    result
}

fn shape[let rows: UInt64, let inner: UInt64, let columns: UInt64](left: [[Float32; inner]; rows], right: [[Float32; columns]; inner], name: Str, repetitions: UInt64, verify_only: Bool) -> Result[UInt8, io.IoError] {
    let column_left = transpose(left)
    let column_right = transpose(right)
    // Each residue of the timed iteration changes a vector or a matrix.
    // Check every logical component before reducing results to a cheap sum.
    for iteration in UInt64(0)..17 {
        let delta = Float32(iteration) / 16.0
        let varied = shifted(left, delta)
        let varied_column = shifted(column_left, delta)
        for row in 0..left.length() {
            for column in 0..left[row].length() {
                let bits = (left[row][column] + delta).to_bits()
                if varied[row][column].to_bits() != bits || varied_column[column][row].to_bits() != bits {
                    return .Ok(6)
                }
            }
        }
        let expected = reference_product(varied, right)
        let row_product = matmul_row(varied, right)
        let column_product = matmul_column(varied_column, column_right)
        let implemented = num.matrix(varied) * num.matrix(right)
        for row in 0..expected.length() {
            for column in 0..expected[row].length() {
                let bits = expected[row][column].to_bits()
                if bits != row_product[row][column].to_bits() || bits != column_product[column][row].to_bits() || bits != implemented[row, column].to_bits() {
                    return .Ok(3)
                }
            }
        }
        let vector: [Float32; inner] = input(iteration)
        let mv_row = matvec_row(left, vector)
        let mv_column = matvec_column(column_left, vector)
        let mv_actual = num.matrix(left) * vector
        for lane in 0..mv_row.length() {
            var reference = Float32(0.0)
            for k in 0..vector.length() {
                reference += left[lane][k] * vector[k]
            }
            let bits = reference.to_bits()
            if bits != mv_row[lane].to_bits() || bits != mv_column[lane].to_bits() || bits != mv_actual[lane].to_bits() {
                return .Ok(4)
            }
        }
        let vector_left: [Float32; rows] = input(iteration)
        let vm_row = vecmat_row(vector_left, left)
        let vm_column = vecmat_column(vector_left, column_left)
        let vm_actual = vector_left * num.matrix(left)
        for lane in 0..vm_row.length() {
            var reference = Float32(0.0)
            for k in 0..vector_left.length() {
                reference += vector_left[k] * left[k][lane]
            }
            let bits = reference.to_bits()
            if bits != vm_row[lane].to_bits() || bits != vm_column[lane].to_bits() || bits != vm_actual[lane].to_bits() {
                return .Ok(5)
            }
        }
    }
    if verify_only {
        return .Ok(0)
    }
    io.println("shape,{name}")?
    let mv = compare(
        "matvec",
        [left] |iteration: UInt64| {
            let vector: [Float32; inner] = input(iteration)
            hash(matvec_row(left, vector))
        },
        [column_left] |iteration: UInt64| {
            let vector: [Float32; inner] = input(iteration)
            hash(matvec_column(column_left, vector))
        },
        repetitions,
    )?
    if mv != 0 {
        return .Ok(mv)
    }
    let vm = compare(
        "vecmat",
        [left] |iteration: UInt64| {
            let vector: [Float32; rows] = input(iteration)
            hash(vecmat_row(vector, left))
        },
        [column_left] |iteration: UInt64| {
            let vector: [Float32; rows] = input(iteration)
            hash(vecmat_column(vector, column_left))
        },
        repetitions,
    )?
    if vm != 0 {
        return .Ok(vm)
    }
    let mm = compare(
        "matmul",
        [left, right] |iteration: UInt64| {
            let varied = shifted(left, Float32(iteration % 17) / 16.0)
            hash_matrix(matmul_row(varied, right))
        },
        [column_left, column_right] |iteration: UInt64| {
            let varied = shifted(column_left, Float32(iteration % 17) / 16.0)
            hash_matrix(matmul_column(varied, column_right))
        },
        repetitions,
    )?
    if mm != 0 {
        return .Ok(mm)
    }
    let ew = compare(
        "elementwise",
        [left] |iteration: UInt64| {
            hash_matrix(shifted(left, Float32(iteration % 17) / 16.0))
        },
        [column_left] |iteration: UInt64| {
            hash_matrix(shifted(column_left, Float32(iteration % 17) / 16.0))
        },
        repetitions,
    )?
    if ew != 0 {
        return .Ok(ew)
    }
    // The final two columns compare the row prototype with the real operator.
    compare(
        "row_vs_operator",
        [left, right] |iteration: UInt64| {
            let varied = shifted(left, Float32(iteration % 17) / 16.0)
            hash_matrix(matmul_row(varied, right))
        },
        [left, right] |iteration: UInt64| {
            let varied = shifted(left, Float32(iteration % 17) / 16.0)
            let product = num.matrix(varied) * num.matrix(right)
            var total = UInt64(0)
            for row in 0..left.length() {
                for column in 0..right[0].length() {
                    total += UInt64(product[row, column].to_bits())
                }
            }
            total
        },
        repetitions,
    )
}

fn usage() -> UInt8 {
    io.eprintln("usage: matrix_layout SEED [--verify-only]")
    64
}

fn main() -> Result[UInt8, io.IoError] {
    let arguments = env.args()
    let spelling = arguments.at(1) else {
        return .Ok(usage())
    }
    let seed: UInt64 = match spelling.parse[UInt64]() {
        Ok(value) => value,
        Err(_) => return .Ok(usage()),
    }
    let verify_only = arguments.at(2).unwrap_or("") == "--verify-only"
    if arguments.count() != (if verify_only {
        UInt64(3)
    } else {
        UInt64(2)
    }) {
        return .Ok(usage())
    }
    io.println("seed,{seed}")?
    if !verify_only {
        io.println("workload,round,repetitions,row_ns,column_ns,checksum")?
    }
    let status_3 = shape(fixture[3, 4](seed), fixture[4, 5](seed % 23 + 7), "3x4x5", 1000000, verify_only)?
    if status_3 != 0 {
        return .Ok(status_3)
    }
    let status_4 = shape(fixture[4, 4](seed), fixture[4, 4](seed % 23 + 7), "4x4x4", 1000000, verify_only)?
    if status_4 != 0 {
        return .Ok(status_4)
    }
    let status_8 = shape(fixture[8, 8](seed), fixture[8, 8](seed % 23 + 7), "8x8x8", 100000, verify_only)?
    if status_8 != 0 {
        return .Ok(status_8)
    }
    let status_16 = shape(fixture[16, 16](seed), fixture[16, 16](seed % 23 + 7), "16x16x16", 10000, verify_only)?
    if status_16 != 0 {
        return .Ok(status_16)
    }
    let status_32 = shape(fixture[32, 64](seed), fixture[64, 16](seed % 23 + 7), "32x64x16", 2000, verify_only)?
    if status_32 != 0 {
        return .Ok(status_32)
    }
    let status_128 = shape(fixture[128, 128](seed), fixture[128, 128](seed % 23 + 7), "128x128x128", 200, verify_only)?
    if status_128 != 0 {
        return .Ok(status_128)
    }
    .Ok(0)
}
