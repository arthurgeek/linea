// `Tray.held` is a `Board.Elem`, the linear `Ticket`, so `Tray` cannot be
// discarded and `Chooser[Tray]` does not implement `Pick`.
trait Counter {
    type Item
}

trait Pick {
    type Out
}

@linear
struct Ticket {
    number: UInt8,
}

struct Tray {
    held: Board.Elem,
}

struct Board {
    values: [Ticket; 2],
}

impl Index[UInt64] for Board via values

struct Chooser[T] {
    t: T,
}

impl[T: Discardable] Pick for Chooser[T] {
    type Out = UInt8
}

struct Mirror {}

impl Counter for Mirror {
    type Item = Chooser[Tray].Out
}

fn main() -> UInt8 {
    let item: Mirror.Item = 4
    item
}
