    }
}

pub fn std.mem;Vec[UInt8,std.mem.SystemAllocator].reserve(inout self: std.mem.Vec[UInt8,std.mem.SystemAllocator], additional: UInt64) -> std.result.Result[(),std.mem.Oom] where carries() {
    let shape: std.mem.SlotType[UInt8] = .Type
    let stride = slot_stride(shape)
    let limit = UInt64.max / stride
    if additional > limit - self.len {
        return .Err(Oom.Exhausted)
    }
    let required = self.len + additional
    let capacity = self.storage.len / stride
    if required <= capacity {
        return .Ok(())
    }
    // Start with four element slots, then double capacity to avoid an
    // allocation per push. Clamp both choices to the byte-size limit.
    let doubled = if capacity == 0 {
        if limit < 4 {
            limit
        } else {
            4
        }
    } else {
        if capacity > limit / 2 {
            limit
        } else {
            capacity * 2
        }
    }
    let grown = if required > doubled {
        required
    } else {
        doubled
    }
    let acquired = std.mem.SystemAllocator;std.mem;Allocator.acquire(self.storage.allocator, grown * stride)?
    let Vec { storage: previous, len: length } = self
    var storage = previous
    var next: std.mem.Storage[UInt8,std.mem.SystemAllocator] = std.mem;Storage[UInt8,std.mem.SystemAllocator].from_buffer(acquired)
    let at = next.at
    let extent = next.len
    let previous_at = storage.at
    let previous_extent = storage.len
    for i in 0..length {
        let element: UInt8 = slot_take(&storage, previous_at, previous_extent, i * stride)
        slot_put(&next, at, extent, i * stride, element)
    }
    std.mem;Storage[UInt8,std.mem.SystemAllocator].dispose(storage)
    self = .{ storage = next, len = length }
    .Ok(())
}

fn std.mem.Slice[UInt8];std.iter;Sequence.iterate(sink self: std.mem.Slice[UInt8]) -> std.mem.SliceIter[UInt8] {
    .{ view = self, at = 0 }
}

fn std.mem.SliceIter[UInt8];std.iter;Iterator.next(inout self: std.mem.SliceIter[UInt8]) -> std.option.Option[borrow(UInt8)] {
    if self.at == std.mem;Slice[UInt8].length(self.view) {
        return .None
    }
    let index = self.at
    self.at += 1
    std.mem;Slice[UInt8].get(self.view, index)
}

fn std.mem.Buffer[std.mem.SystemAllocator];std.release;Release.release(sink self: std.mem.Buffer[std.mem.SystemAllocator]) {
    std.mem.SystemAllocator;std.mem;Allocator.dispose(self)
}

fn std.fmt;format_signed[std.io.core.Gathered](value: Int64, inout w: std.io.core.Gathered) -> std.result.Result[(),std.io.core.IoError] where carries(.Err: w) {
    if value < 0 {
        std.io.core.Gathered;std.io.core;Writer.write_str(&w, "-")?
    }
    var p = std.fmt;scale(value)
    var leading = true
    while p > 0 {
        let whole = value / p
        // A remainder modulo 100 selects one pair from decimal_pairs.
        let d = whole % 100
        // Only the two-digit remainder is negated; Int64.min itself
        // cannot be made positive in Int64.
        let shown = if d < 0 {
            0 - d
        } else {
            d
        }
        std.io.core.Gathered;std.io.core;Writer.write_str(&w, std.fmt;digits(shown, leading))?
        leading = false
        p = p / 100
    }
    .Ok(())
}

fn std.fmt;format_unsigned[std.io.core.Gathered](value: UInt64, inout w: std.io.core.Gathered) -> std.result.Result[(),std.io.core.IoError] where carries(.Err: w) {
    var p = std.fmt;scale_unsigned(value)
    var leading = true
    while p > 0 {
        let whole = value / p
        // A remainder modulo 100 selects one pair from decimal_pairs.
        let d = whole % 100
        std.io.core.Gathered;std.io.core;Writer.write_str(&w, std.fmt;digits(Int64(d), leading))?
        leading = false
        p = p / 100
    }
    .Ok(())
}

fn std.mem.SystemAllocator;std.mem;Allocator.acquire(self: std.mem.SystemAllocator, size: UInt64) -> std.result.Result[std.mem.Buffer[std.mem.SystemAllocator],std.mem.Oom] where carries() {
    match read self {
        System => {
            let at = linea_alloc(size, Buffer.alignment)
            if at == 0 {
                .Err(Oom.Exhausted)
            } else {
                // Empty buffers reserve one byte. Retain that size for disposal,
                // while reporting the requested length to callers.
                let reserved = if size == 0 {
                    1
                } else {
                    size
                }
                std.result.Result[std.mem.Buffer[std.mem.SystemAllocator],std.mem.Oom].Ok(.{ at = at, len = size, allocated = reserved, allocator = self, obligation = .{} })
            }
        },
    }
}

fn std.mem;Storage[UInt8,std.mem.SystemAllocator].from_buffer(sink buffer: std.mem.Buffer[std.mem.SystemAllocator]) -> std.mem.Storage[UInt8,std.mem.SystemAllocator] where carries(buffer) {
    let allocator = copy(buffer.allocator)
    let at = buffer.at
    let length = buffer.len
    .{ buffer = .Some(buffer), allocator, at, len = length }
}

fn std.range.Range[UInt64];std.iter;Sequence.iterate(sink self: std.range.Range[UInt64]) -> std.range.Range[UInt64] where carries(self) {
    self
}

fn std.range.Range[UInt64];std.iter;Iterator.next(inout self: std.range.Range[UInt64]) -> std.option.Option[UInt64] {
    // lo < hi guarantees that a forward step cannot exceed the maximum.
    if self.lo.less(self.hi) {
        let out = copy(self.lo)
        self.lo = self.lo.forward()
        return .Some(out)
    }

    // lo > hi guarantees that a backward step cannot pass the minimum.
    if self.hi.less(self.lo) {
        let out = copy(self.lo)
        self.lo = self.lo.backward()
        return .Some(out)
    }

    // Yield the included endpoint once, then leave an empty range.
    if self.inclusive && self.lo.equals(self.hi) {
        self.inclusive = false
        return .Some(copy(self.lo))
    }

    .None
}

pub fn std.mem;Slice[UInt8].get(self: std.mem.Slice[UInt8], i: UInt64) -> std.option.Option[borrow(UInt8)] where carries(self) {
    if i >= self.len {
        .None
    } else {
        .Some(borrow self[i])
    }
}

fn std.mem.SystemAllocator;std.mem;Allocator.dispose(sink b: std.mem.Buffer[std.mem.SystemAllocator]) {
    let Buffer { at: at, len: _length, allocated: allocated, allocator: allocator, obligation: SystemAllocation {} } = b
    match allocator {
        System => linea_free(at, allocated, Buffer.alignment),
    }
}

fn std.fmt;scale(n: Int64) -> Int64 {
    var p = 1
    while (n / p) / 100 != 0 {
        p = p * 100
    }
    p
}

fn std.fmt;digits(d: Int64, leading: Bool) -> std.text.Str {
    let start = UInt64(d) * 2
    let first = if leading && d < 10 {
        start + 1
    } else {
        start
    }
    std.option;Option[std.text.Str].unwrap_or(std.text;Str.slice(decimal_pairs, first, start + 2), "0")
}

fn std.fmt;scale_unsigned(n: UInt64) -> UInt64 {
    var p: UInt64 = 1
    while (n / p) / 100 != 0 {
        p = p * 100
    }
    p
}

extern fn linea_alloc(size: UInt64, align: UInt64) -> UInt64

extern fn linea_free(at: UInt64, size: UInt64, align: UInt64)

pub fn std.text;Str.slice(self: std.text.Str, from: UInt64, to: UInt64) -> std.option.Option[std.text.Str] where carries(.Some: self) {
    if from > to || to > std.text;Str.length(self) {
        .None
    } else if !std.text;starts_a_character(self, from) || !std.text;starts_a_character(self, to) {
        .None
    } else {
        .Some(.{ bytes = std.option;Option[std.mem.Slice[UInt8]].unwrap(std.mem;Slice[UInt8].subspan(self.bytes, start: from, count: to - from)) })
    }
}

pub fn std.option;Option[std.text.Str].unwrap_or(sink self: std.option.Option[std.text.Str], sink fallback: std.text.Str) -> std.text.Str where
    carries(self, fallback),
    std.text.Str: Discardable
{
    match self {
        Some(value) => value,
        None => fallback,
    }
}

pub fn std.text;Str.length(self: std.text.Str) -> UInt64 {
    std.mem;Slice[UInt8].length(self.bytes)
}

fn std.text;starts_a_character(s: std.text.Str, at: UInt64) -> Bool {
    if at >= std.text;Str.length(s) {
        at == std.text;Str.length(s)
    } else {
        match std.text;Str.byte(s, at) {
            Some(b) => b < 128 || b > 191,
            // This arm never runs, because the offset is below the length.
            None => false,
        }
    }
}

pub fn std.text;Str.byte(self: std.text.Str, i: UInt64) -> std.option.Option[UInt8] where carries() {
    if i >= std.text;Str.length(self) {
        .None
    } else {
        .Some(self.bytes[i])
    }
}
