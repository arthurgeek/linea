import std.io
import std.mem
import std.testing
import std.time

use io.ByteWriter
use io.Reader

let nanoseconds_per_millisecond: UInt64 = 1000000

// The runtime connects to a packed address, by a deadline on the monotonic
// clock in nanoseconds (0 waits forever), reports a peer's packed address, shuts
// down writing, and resets a connection. Each returns its answer, or a negated
// errno.
extern fn linea_net_connect(address: UInt64, deadline_ns: UInt64) -> Int64

extern fn linea_net_peer_address(fd: Int32) -> Int64

extern fn linea_net_shutdown_write(fd: Int32) -> Int64

extern fn linea_net_reset(fd: Int32) -> Int64

// Connection owns one connected stream socket. Explicit close reports failure
// and consumes it; release makes one best-effort close and never flushes
// buffered output.
@(opaque, linear)
struct Connection {
    fd: Int32,
    // The per-operation timeouts `set_timeouts` configured, in milliseconds.
    read_ms: UInt64,
    write_ms: UInt64,
    deadline: Option[Deadline],
}

// A deadline ends every read once `budget_ms` milliseconds have passed since
// `started`.
@copyable
struct Deadline {
    started: time.Instant,
    budget_ms: UInt64,
}

// Wrap a connected descriptor with no timeouts and no deadline.
fn adopt(fd: Int32) -> Connection {
    Connection { fd, read_ms = 0, write_ms = 0, deadline = .None }
}

// Open a connection and wait until the peer accepts it or refuses it, or
// until `within_ms` milliseconds have passed, which fails as timed out. Zero
// waits as long as the handshake takes.
pub fn connect(address: Address, within_ms: UInt64 = 0) -> Result[Connection, NetError] {
    var deadline: UInt64 = 0
    if within_ms != 0 {
        deadline = deadline_after(time.Instant.now().monotonic_nanoseconds(), within_ms)
    }
    let answer = linea_net_connect(address.packed(), deadline)
    if answer < 0 {
        return .Err(failure(.Connect, answer))
    }
    .Ok(adopt(Int32(answer)))
}

test fn a_connection_to_a_closed_port_is_refused() {
    let listener = listen(loopback(0)).unwrap()
    let bound = listener.local_address().unwrap()
    let listener_closed = listener.close().is_ok()
    let refused = match connect(bound) {
        Ok(connection) => {
            let _closed = connection.close()
            false
        },
        Err(Io(reason)) => match read reason.category { ConnectionRefused => true, _ => false },
        Err(_) => false,
    }
    testing.assert(listener_closed, "closing the listener failed")?
    testing.assert(refused, "a connection to a closed port was not refused")?
    .Ok(())
}

test fn a_connect_whose_handshake_ends_at_its_deadline_connects() {
    // Every delivery takes 15 ms of virtual time, so the handshake, a SYN
    // out and a SYN-ACK back, takes 30 ms.
    let network = io.Network { latency_ms = 15, ..io.Network.default() }
    var sim = io.Simulation.open(seed: 1, network: network).unwrap()
    let (early, on_time) = &sim.run(
        |inout _world| {
            let listener = listen(loopback(80)).unwrap()
            let early = match connect(loopback(80), within_ms: 29) {
                Ok(connection) => {
                    connection.close().unwrap()
                    false
                },
                Err(Io(reason)) => match read reason.category { TimedOut => true, _ => false },
                Err(_) => false,
            }
            let on_time = match connect(loopback(80), within_ms: 30) {
                Ok(connection) => {
                    connection.close().unwrap()
                    true
                },
                Err(_) => false,
            }
            listener.close().unwrap()
            (early, on_time)
        },
    )
    sim.close()
    testing.assert(early, "a connect ended a millisecond before its handshake did not time out")?
    testing.assert(on_time, "a connect whose handshake ended at its deadline was not connected")?
}

test fn a_connect_with_no_bound_waits_for_the_handshake() {
    let listener = listen(loopback(0)).unwrap()
    let connected = match connect(listener.local_address().unwrap(), within_ms: 0) {
        Ok(connection) => connection.close().is_ok(),
        Err(_) => false,
    }
    listener.close().unwrap()
    testing.assert(connected, "a connect with no bound did not connect")?
}

test fn a_simulated_connection_kept_past_its_simulation_closes() {
    var sim = io.Simulation.open(seed: 1).unwrap()
    let made = &sim.run(
        |inout _world| {
            let listener = listen(loopback(80)).unwrap()
            let client = connect(loopback(80)).unwrap()
            listener.close().unwrap()
            client
        },
    )
    sim.close()
    testing.assert(made.close().is_ok(), "closing a connection its simulation outlived failed")?
}

// The moment `ms` milliseconds after `base`, on the monotonic clock in
// nanoseconds. A sum too large to represent is the same as waiting forever, and
// answers the runtime's 0, no deadline.
fn deadline_after(base: UInt64, ms: UInt64) -> UInt64 {
    if ms > (UInt64.max - base) / nanoseconds_per_millisecond {
        return 0
    }
    base + ms * nanoseconds_per_millisecond
}

test fn a_deadline_too_far_ahead_means_no_deadline() {
    testing.assert_eq(deadline_after(5, 2), UInt64(2000005), "a deadline was not 2 ms after its base")?
    testing.assert_eq(deadline_after(5, UInt64.max), UInt64(0), "an overflowing deadline did not answer none")?
}

impl Connection {
    // Bound each later read and send attempt separately, in milliseconds, and end
    // any deadline. Zero waits forever.
    pub fn set_timeouts(inout self: Self, read_ms: UInt64, write_ms: UInt64) {
        self.read_ms = read_ms
        self.write_ms = write_ms
        self.deadline = .None
    }

    test fn a_silent_peer_times_out_the_read() {
        var sim = io.Simulation.open(seed: 1).unwrap()
        let (expired, waited) = &sim.run(
            |inout _world| {
                var listener = listen(loopback(80)).unwrap()
                let client = connect(loopback(80)).unwrap()
                let Accepted { connection: accepted, address: _ } = &listener.accept().unwrap()
                var server = accepted
                &server.set_timeouts(read_ms: 50, write_ms: 50)
                defer var buffer = mem.system().acquire(8).unwrap()
                let started = time.Instant.now()
                let expired = match &server.read_some(&buffer, offset: 0, count: 8) {
                    Ok(_) => false,
                    Err(error) => match read error.category { TimedOut => true, _ => false },
                }
                let waited = started.elapsed()
                server.close().unwrap()
                client.close().unwrap()
                listener.close().unwrap()
                (expired, waited)
            },
        )
        sim.close()
        testing.assert(expired, "a read from a silent peer did not time out")?
        testing.assert_eq(waited, time.Duration.from_milliseconds(50), "the read waited other than its 50 ms")?
    }

    test fn a_read_whose_bytes_arrive_at_its_deadline_reads_them() {
        // A byte sent takes 200 ms of virtual time to arrive. A read bound to
        // 199 ms times out; the next, bound to 1 ms, ends as the byte
        // arrives, and reads it.
        let network = io.Network { latency_ms = 200, ..io.Network.default() }
        var sim = io.Simulation.open(seed: 1, network: network).unwrap()
        let (early, received) = &sim.run(
            |inout _world| {
                var listener = listen(loopback(80)).unwrap()
                var client = connect(loopback(80)).unwrap()
                let Accepted { connection: accepted, address: _ } = &listener.accept().unwrap()
                var server = accepted
                let _sent = io.write_all(&client, "x".as_bytes()).unwrap()
                defer var buffer = mem.system().acquire(8).unwrap()
                &server.set_timeouts(read_ms: 199, write_ms: 0)
                let early = match &server.read_some(&buffer, offset: 0, count: 8) {
                    Ok(_) => false,
                    Err(error) => match read error.category { TimedOut => true, _ => false },
                }
                &server.set_timeouts(read_ms: 1, write_ms: 0)
                let received = match &server.read_some(&buffer, offset: 0, count: 8) {
                    Ok(count) => count,
                    Err(_) => 0,
                }
                server.close().unwrap()
                client.close().unwrap()
                listener.close().unwrap()
                (early, received)
            },
        )
        sim.close()
        testing.assert(early, "a read ended a millisecond before its byte did not time out")?
        testing.assert_eq(received, UInt64(1), "a read whose byte arrived at its deadline did not read it")?
    }

    // Bound all later reads together: once `within_ms` milliseconds have passed
    // since `started`, every read fails as timed out, even one whose bytes have
    // arrived, and a read that would wait past that moment is cut short at it.
    // Each read also keeps its own `set_timeouts` bound. A client that sends
    // a byte at a time therefore cannot keep a reader waiting beyond the
    // deadline, as it can with per-read timeouts alone. Zero sets no deadline.
    // `set_timeouts` ends the deadline.
    pub fn set_deadline(inout self: Self, started: time.Instant, within_ms: UInt64) {
        if within_ms == 0 {
            self.deadline = .None
        } else {
            self.deadline = .Some(Deadline { started = copy(started), budget_ms = within_ms })
        }
    }

    test fn a_deadline_ends_reads_that_each_arrive_in_time() {
        var sim = io.Simulation.open(seed: 1).unwrap()
        let (expired, arrived) = &sim.run(
            |inout world| {
                var listener = listen(loopback(80)).unwrap()
                var client = connect(loopback(80)).unwrap()
                let Accepted { connection: accepted, address: _ } = &listener.accept().unwrap()
                var server = accepted
                // A byte is sent every 80 ms and arrives 1 ms later, inside the
                // 150 ms a single read may wait, yet the third read starts after
                // the 200 ms deadline, which spans them all.
                &server.set_timeouts(read_ms: 150, write_ms: 150)
                &server.set_deadline(time.Instant.now(), within_ms: 200)
                defer var buffer = mem.system().acquire(8).unwrap()
                var arrived: UInt64 = 0
                var expired = false
                var round: UInt64 = 0
                while round < 4 && !expired {
                    round += 1
                    &world.advance(time.Duration.from_milliseconds(80))
                    let _sent = io.write_all(&client, "x".as_bytes()).unwrap()
                    match &server.read_some(&buffer, offset: 0, count: 8) {
                        Ok(count) => arrived += count,
                        Err(error) => expired = match read error.category { TimedOut => true, _ => false },
                    }
                }
                server.close().unwrap()
                client.close().unwrap()
                listener.close().unwrap()
                (expired, arrived)
            },
        )
        sim.close()
        testing.assert(expired, "reads that each arrived in time outlasted the deadline")?
        testing.assert_eq(arrived, UInt64(2), "the deadline did not end the reads after the second byte")?
    }

    test fn a_deadline_of_zero_leaves_reads_unbounded() {
        var sim = io.Simulation.open(seed: 1).unwrap()
        let received = &sim.run(
            |inout world| {
                var listener = listen(loopback(80)).unwrap()
                var client = connect(loopback(80)).unwrap()
                let Accepted { connection: accepted, address: _ } = &listener.accept().unwrap()
                var server = accepted
                &server.set_deadline(time.Instant.now(), within_ms: 0)
                &world.advance(time.Duration.from_seconds(30))
                let _sent = io.write_all(&client, "x".as_bytes()).unwrap()
                defer var buffer = mem.system().acquire(8).unwrap()
                let received = match &server.read_some(&buffer, offset: 0, count: 8) {
                    Ok(count) => count,
                    Err(_) => 0,
                }
                server.close().unwrap()
                client.close().unwrap()
                listener.close().unwrap()
                received
            },
        )
        sim.close()
        testing.assert_eq(received, UInt64(1), "a zero deadline bounded the read")?
    }

    // Report the address of the peer at the other end of the connection.
    pub fn peer_address(self: Self) -> Result[Address, NetError] {
        let answer = linea_net_peer_address(self.fd)
        if answer < 0 {
            return .Err(failure(.Metadata, answer))
        }
        .Ok(Address.unpacked(answer))
    }

    test fn a_client_reports_the_listener_as_its_peer() {
        var listener = listen(loopback(0)).unwrap()
        let bound = listener.local_address().unwrap()
        let client = connect(bound).unwrap()
        let peer = client.peer_address()
        let Accepted { connection: server, address: _ } = &listener.accept().unwrap()
        let server_closed = server.close().is_ok()
        let client_closed = client.close().is_ok()
        let listener_closed = listener.close().is_ok()
        testing.assert_ok_eq(peer, bound, "the client's peer is not the listener")?
        testing.assert(server_closed && client_closed && listener_closed, "a close failed")?
        .Ok(())
    }

    // Tell the peer no more bytes follow, while reads remain open.
    pub fn shutdown_write(inout self: Self) -> Result[(), io.IoError] {
        let answer = linea_net_shutdown_write(self.fd)
        if answer < 0 {
            return .Err(io.IoError.from_os(.Close, Int32(-answer)))
        }
        .Ok(())
    }

    test fn a_shut_down_writer_ends_the_peer_input() {
        var listener = listen(loopback(0)).unwrap()
        var client = connect(listener.local_address().unwrap()).unwrap()
        let shut = &client.shutdown_write().is_ok()
        let Accepted { connection: accepted, address: _ } = &listener.accept().unwrap()
        var server = accepted
        defer var buffer = mem.system().acquire(8).unwrap()
        let ended = match &server.read_some(&buffer, offset: 0, count: 8) {
            Ok(count) => count == 0,
            Err(_) => false,
        }
        let server_closed = server.close().is_ok()
        let client_closed = client.close().is_ok()
        let listener_closed = listener.close().is_ok()
        testing.assert(shut, "shutting down the client's writes failed")?
        testing.assert(ended, "the server read past the client's shutdown")?
        testing.assert(server_closed && client_closed && listener_closed, "a close failed")?
        .Ok(())
    }

    // Close the connection, reporting a failed close, which `Release` ignores.
    pub fn close(sink self: Self) -> Result[(), io.IoError] where carries() {
        let Connection { fd: fd, read_ms: _, write_ms: _, deadline: _ } = self
        close_descriptor(fd)
    }

    test fn a_connection_close_reports_success() {
        var listener = listen(loopback(0)).unwrap()
        let client = connect(listener.local_address().unwrap()).unwrap()
        let Accepted { connection: server, address: _ } = &listener.accept().unwrap()
        let client_closed = client.close()
        let server_closed = server.close().is_ok()
        let listener_closed = listener.close().is_ok()
        testing.assert_ok_eq(client_closed, (), "closing the client failed")?
        testing.assert(server_closed && listener_closed, "a close failed")?
        .Ok(())
    }

    // Close so the peer receives a reset rather than an orderly end of input,
    // discarding what is unsent. The descriptor is closed even when the reset
    // cannot be arranged, and that failure is the one reported.
    pub fn reset(sink self: Self) -> Result[(), io.IoError] {
        let Connection { fd: fd, read_ms: _, write_ms: _, deadline: _ } = self
        let answer = linea_net_reset(fd)
        if answer < 0 {
            return .Err(io.IoError.from_os(.Close, Int32(-answer)))
        }
        .Ok(())
    }

    test fn a_reset_connection_is_reset_at_its_peer() {
        var listener = listen(loopback(0)).unwrap()
        var client = connect(listener.local_address().unwrap()).unwrap()
        let _sent = io.write_all(&client, "GET".as_bytes()).unwrap()
        let Accepted { connection: accepted, address: _ } = &listener.accept().unwrap()
        var server = accepted
        let reset = client.reset()
        defer var buffer = mem.system().acquire(8).unwrap()
        // The bytes sent before the reset may or may not arrive; the reset ends
        // the input either way.
        var received = &server.read_some(&buffer, offset: 0, count: 8)
        while match read received { Ok(count) => count > 0, Err(_) => false } {
            received = &server.read_some(&buffer, offset: 0, count: 8)
        }
        let category = match read received {
            Ok(_) => io.IoCategory.Other,
            Err(error) => error.category,
        }
        server.close().unwrap()
        listener.close().unwrap()
        testing.assert_ok_eq(reset, (), "resetting failed")?
        testing.assert_eq(category, io.IoCategory.ConnectionReset, "the peer did not see a reset")?
        .Ok(())
    }

    // The monotonic moment the next read must finish by: its own per-read
    // bound or the session's deadline, whichever comes first, 0 for neither.
    fn read_deadline(self: Self) -> UInt64 {
        var ends: UInt64 = 0
        if self.read_ms != 0 {
            ends = deadline_after(time.Instant.now().monotonic_nanoseconds(), self.read_ms)
        }
        match read self.deadline {
            Some(deadline) => {
                let session = deadline_after(deadline.started.monotonic_nanoseconds(), deadline.budget_ms)
                if session != 0 && (ends == 0 || session < ends) {
                    ends = session
                }
            },
            None => {},
        }
        ends
    }

    test fn a_read_deadline_is_the_nearer_of_the_read_bound_and_the_session() {
        var listener = listen(loopback(0)).unwrap()
        var server_side = connect(listener.local_address().unwrap()).unwrap()
        let Accepted { connection: peer, address: _ } = &listener.accept().unwrap()
        var client = peer
        let unbounded = client.read_deadline()
        &client.set_timeouts(read_ms: 1000, write_ms: 0)
        let before = time.Instant.now().monotonic_nanoseconds()
        let bound = client.read_deadline()
        &client.set_deadline(time.Instant.now(), within_ms: 5)
        let nearer = client.read_deadline()
        let client_closed = client.close().is_ok()
        let server_closed = server_side.close().is_ok()
        let listener_closed = listener.close().is_ok()
        testing.assert_eq(unbounded, UInt64(0), "no bound was a deadline")?
        testing.assert(bound >= before + 1000 * nanoseconds_per_millisecond, "the per-read bound was not applied")?
        testing.assert(nearer < bound, "the nearer deadline did not win")?
        testing.assert(client_closed && server_closed && listener_closed, "a close failed")?
        .Ok(())
    }

    // The monotonic moment one send attempt must finish by, 0 for no bound. A
    // send that makes progress answers at once, so each attempt gets a fresh bound.
    fn write_deadline(self: Self) -> UInt64 {
        if self.write_ms == 0 {
            return 0
        }
        deadline_after(time.Instant.now().monotonic_nanoseconds(), self.write_ms)
    }

    // Owning and borrowed writers use the same timeout and error policy.
    fn write_bytes(self: Self, bytes: mem.Slice[UInt8]) -> Result[UInt64, io.WriteFailure[io.IoError]] where carries() {
        if bytes.length() == 0 {
            return .Ok(0)
        }
        let answer = mem.write_slice_socket(bytes, self.fd, self.write_deadline())
        if answer < 0 {
            let error = io.IoError.from_os(.Write, Int32(0 - answer))
            return .Err(.{ kind = .Underlying, reason = .Some(error), written = 0 })
        }
        .Ok(UInt64(answer))
    }

    test fn a_write_times_out_when_the_peer_reads_nothing() {
        // The network holds 4 KiB each way, so a peer that never reads lets
        // the first write send 4 KiB and leaves the second nowhere to put
        // bytes, and it ends at its deadline.
        for borrowed in [false, true] {
            let network = io.Network { buffer_bytes = 4096, ..io.Network.default() }
            var sim = io.Simulation.open(seed: 1, network: network).unwrap()
            let (first, expired, waited) = &sim.run(
                [borrowed] |inout _world| {
                    var listener = listen(loopback(80)).unwrap()
                    var client = connect(loopback(80)).unwrap()
                    let Accepted { connection: accepted, address: _ } = &listener.accept().unwrap()
                    var server = accepted
                    &server.set_timeouts(read_ms: 0, write_ms: 50)
                    defer var bytes = mem.system().acquire(65536).unwrap()
                    let first = match if borrowed {
                        var writer = server.writer()
                        &writer.write_some(bytes.as_slice())
                    } else {
                        &server.write_some(bytes.as_slice())
                    } {
                        Ok(count) => count,
                        Err(_) => 0,
                    }
                    let started = time.Instant.now()
                    let expired = match if borrowed {
                        var writer = server.writer()
                        &writer.write_some(bytes.as_slice())
                    } else {
                        &server.write_some(bytes.as_slice())
                    } {
                        Ok(_) => false,
                        Err(WriteFailure { kind: _, reason: reason, written: _ }) => match reason {
                            Some(error) => match read error.category { TimedOut => true, _ => false },
                            None => false,
                        },
                    }
                    let waited = started.elapsed()
                    client.close().unwrap()
                    server.close().unwrap()
                    listener.close().unwrap()
                    (first, expired, waited)
                },
            )
            sim.close()
            testing.assert_eq(first, UInt64(4096), "the first write did not fill the network")?
            testing.assert(expired, "a write to a peer that reads nothing did not time out")?
            testing.assert_eq(waited, time.Duration.from_milliseconds(50), "the write waited other than its 50 ms")?
        }
    }
}

// A connection is ready to read once bytes, its end or an error can be read
// without waiting, and ready to write once its send buffer has room.
impl io.Pollable for Connection {
    fn readiness(self: Self, _interest: io.Interest) -> io.Readiness[Self] where borrows(self) {
        .Wait(io.source(self, self.fd))
    }
}

// Generic code closes a connection through `io.Close`; this forwards to
// `Connection.close`.
impl io.Close for Connection {
    type CloseError = io.IoError

    fn close(sink self: Self) -> Result[(), io.IoError] where carries() {
        Connection.close(self)
    }
}

impl Release for Connection {
    fn release(sink self: Self) {
        let Connection { fd: fd, read_ms: _, write_ms: _, deadline: _ } = self
        let _closed = close_descriptor(fd)
    }
}

// A read waits until its bytes arrive or the nearer of the per-read timeout and
// the deadline passes, which reports TimedOut; a deadline already past is
// reported without reading.
impl io.Reader for Connection {
    type Error = io.IoError

    fn read_some[A: Allocator](inout self: Self, inout buffer: mem.Buffer[A], offset: UInt64, count: UInt64) -> Result[UInt64, io.IoError] where carries() {
        let answer = mem.read_socket(&buffer, self.fd, offset, count, self.read_deadline())
        if answer < 0 {
            return .Err(io.IoError.from_os(.Read, Int32(0 - answer)))
        }
        .Ok(UInt64(answer))
    }
}

impl io.ByteWriter for Connection {
    type Error = io.IoError

    // A connection buffers nothing, so no bytes are ever pending.
    fn pending_bytes(_self: Self) -> UInt64 {
        0
    }

    fn write_some(inout self: Self, bytes: mem.Slice[UInt8]) -> Result[UInt64, io.WriteFailure[io.IoError]] where carries() {
        self.write_bytes(bytes)
    }

    fn flush(inout _self: Self) -> Result[UInt64, io.WriteFailure[io.IoError]] where carries() {
        .Ok(0)
    }
}

impl Writer for Connection {
    type Error = io.IoError

    fn write_str(inout self: Self, s: Str) -> Result[(), io.IoError] where carries() {
        let _written = io.write_all(&self, s.as_bytes())?
        .Ok(())
    }
}

// A ConnectionWriter borrows a connected socket for output. It cannot close
// the socket, and keeps the connection's configured write timeout.
@(opaque, copyable, derive(Release))
struct ConnectionWriter {
    owner: borrow Connection,
}

impl Connection {
    // Lend output access while retaining ownership of the connected socket.
    pub fn writer(self: Self) -> ConnectionWriter where borrows(self) {
        .{ owner = borrow self }
    }
}

impl io.ByteWriter for ConnectionWriter {
    type Error = io.IoError

    fn pending_bytes(_self: Self) -> UInt64 {
        0
    }

    fn write_some(inout self: Self, bytes: mem.Slice[UInt8]) -> Result[UInt64, io.WriteFailure[io.IoError]] where carries() {
        self.owner.write_bytes(bytes)
    }

    fn flush(inout _self: Self) -> Result[UInt64, io.WriteFailure[io.IoError]] where carries() {
        .Ok(0)
    }
}

test fn a_borrowed_connection_writer_keeps_the_connection_open() {
    defer var listener = listen(loopback(0)).unwrap()
    defer var client = connect(listener.local_address().unwrap()).unwrap()
    let Accepted { connection: server, address: _ } = &listener.accept().unwrap()
    var writer = server.writer()
    let written = io.write_all(&writer, "hello".as_bytes()).unwrap()
    defer var bytes = mem.system().acquire(8).unwrap()
    let count = &client.read_some(&bytes, offset: 0, count: 8).unwrap()
    let matched = bytes.as_slice().subspan(start: 0, count: count).unwrap() == "hello".as_bytes()
    server.close().unwrap()
    testing.assert_eq(written, UInt64(5), "the borrowed writer changed its output length")?
    testing.assert(matched, "the borrowed writer did not write to its live connection")?
    .Ok(())
}
