// `map` is lent its transform, so `&grow` passes `grow` to the first call and
// `grow` is still there for the second.
fn main() -> UInt8 {
    let step: UInt8 = 2
    var grow = [step] |sink value: UInt8| value + step
    let first: Option[UInt8] = .Some(1)
    let second: Option[UInt8] = .Some(5)
    let grown = first.map(&grow)
    let also = second.map(&grow)
    grown.unwrap_or(0) + also.unwrap_or(0)
}
