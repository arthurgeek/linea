    testing.assert(probe(&router, "/s6", "Sixth", "400 Sixth refused", [UInt64(0), 5, 4, 3, 2, 1].as_slice()), "a refusal at probe 6 of 6 did not stop and release what was read")?
    testing.assert(probe(&router, "/t1", "", "200 called", [UInt64(0), 1].as_slice()), "1 probes were not released last first")?
    testing.assert(probe(&router, "/t1", "First", "400 First refused", [UInt64(0)].as_slice()), "a refusal at probe 1 of 1 did not stop and release what was read")?
    testing.assert(probe(&router, "/t2", "", "200 called", [UInt64(0), 2, 1].as_slice()), "2 probes were not released last first")?
    testing.assert(probe(&router, "/t2", "First", "400 First refused", [UInt64(0)].as_slice()), "a refusal at probe 1 of 2 did not stop and release what was read")?
    testing.assert(probe(&router, "/t2", "Second", "400 Second refused", [UInt64(0), 1].as_slice()), "a refusal at probe 2 of 2 did not stop and release what was read")?
    testing.assert(probe(&router, "/t3", "", "200 called", [UInt64(0), 3, 2, 1].as_slice()), "3 probes were not released last first")?
    testing.assert(probe(&router, "/t3", "First", "400 First refused", [UInt64(0)].as_slice()), "a refusal at probe 1 of 3 did not stop and release what was read")?
    testing.assert(probe(&router, "/t3", "Second", "400 Second refused", [UInt64(0), 1].as_slice()), "a refusal at probe 2 of 3 did not stop and release what was read")?
    testing.assert(probe(&router, "/t3", "Third", "400 Third refused", [UInt64(0), 2, 1].as_slice()), "a refusal at probe 3 of 3 did not stop and release what was read")?
    testing.assert(probe(&router, "/t4", "", "200 called", [UInt64(0), 4, 3, 2, 1].as_slice()), "4 probes were not released last first")?
    testing.assert(probe(&router, "/t4", "First", "400 First refused", [UInt64(0)].as_slice()), "a refusal at probe 1 of 4 did not stop and release what was read")?
    testing.assert(probe(&router, "/t4", "Second", "400 Second refused", [UInt64(0), 1].as_slice()), "a refusal at probe 2 of 4 did not stop and release what was read")?
    testing.assert(probe(&router, "/t4", "Third", "400 Third refused", [UInt64(0), 2, 1].as_slice()), "a refusal at probe 3 of 4 did not stop and release what was read")?
    testing.assert(probe(&router, "/t4", "Fourth", "400 Fourth refused", [UInt64(0), 3, 2, 1].as_slice()), "a refusal at probe 4 of 4 did not stop and release what was read")?
    testing.assert(probe(&router, "/t5", "", "200 called", [UInt64(0), 5, 4, 3, 2, 1].as_slice()), "5 probes were not released last first")?
    testing.assert(probe(&router, "/t5", "First", "400 First refused", [UInt64(0)].as_slice()), "a refusal at probe 1 of 5 did not stop and release what was read")?
    testing.assert(probe(&router, "/t5", "Second", "400 Second refused", [UInt64(0), 1].as_slice()), "a refusal at probe 2 of 5 did not stop and release what was read")?
    testing.assert(probe(&router, "/t5", "Third", "400 Third refused", [UInt64(0), 2, 1].as_slice()), "a refusal at probe 3 of 5 did not stop and release what was read")?
    testing.assert(probe(&router, "/t5", "Fourth", "400 Fourth refused", [UInt64(0), 3, 2, 1].as_slice()), "a refusal at probe 4 of 5 did not stop and release what was read")?
    testing.assert(probe(&router, "/t5", "Fifth", "400 Fifth refused", [UInt64(0), 4, 3, 2, 1].as_slice()), "a refusal at probe 5 of 5 did not stop and release what was read")?
    testing.assert(probe(&router, "/t6", "", "200 called", [UInt64(0), 6, 5, 4, 3, 2, 1].as_slice()), "6 probes were not released last first")?
    testing.assert(probe(&router, "/t6", "First", "400 First refused", [UInt64(0)].as_slice()), "a refusal at probe 1 of 6 did not stop and release what was read")?
    testing.assert(probe(&router, "/t6", "Second", "400 Second refused", [UInt64(0), 1].as_slice()), "a refusal at probe 2 of 6 did not stop and release what was read")?
    testing.assert(probe(&router, "/t6", "Third", "400 Third refused", [UInt64(0), 2, 1].as_slice()), "a refusal at probe 3 of 6 did not stop and release what was read")?
