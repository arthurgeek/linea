impl[R: Reader, A: Allocator] BufferedReader[R, A] {
    // A failed line can resume when it did not end, nothing was taken from it
    // or discarded, and it was read in the same mode, text or raw.
    fn can_resume(self: Self, raw: Bool) -> Bool {
        self.blocked && !self.complete && !self.resume_blocked && self.raw == raw
    }

    // Move the record out as a vector of its first `length` bytes.
    fn take_bytes(inout self: Self, length: UInt64) -> Vec[UInt8, A] where carries(self.record) {
        let empty: Option[mem.Buffer[A]] = .None
        let buffer = replace_pending_buffer(&self.record, empty).unwrap()
        mem.vector_from_buffer(buffer, length)
    }

    // Forget the record, so the next line starts fresh.
    fn clear_record(inout self: Self) {
        self.length = 0
        self.blocked = false
        self.complete = false
        self.resume_blocked = false
    }

    // Start a new record for a line read in `raw` mode. A record larger than
    // this read's bound is released first.
    fn begin(inout self: Self, raw: Bool, max_bytes: UInt64) {
        let bound = record_storage_bound(max_bytes, raw)
        let oversized = match read self.record {
            Some(bytes) => bytes.length() > bound,
            None => false,
        }
        if oversized {
            let empty: Option[mem.Buffer[A]] = .None
            let previous = replace_pending_buffer(&self.record, empty)
            previous.release()
        }
        self.length = 0
        self.record_start = self.position
        self.blocked = true
        self.complete = false
        self.resume_blocked = false
        self.raw = raw
    }

    // Looking ahead never advances the logical stream position. Allocation can
    // fail before consuming a byte without losing it from the read-ahead buffer.
    fn peek(inout self: Self) -> Result[Option[UInt8], LineError[R.Error]] where carries(.Err.Input.reason: self.reader) {
        if self.cursor == self.available {
            if self.eof {
                return .Ok(.None)
            }
            let capacity = self.ahead.length()
            let count = &self.reader.read_some(&self.ahead, offset: 0, count: capacity) else |error| {
                return .Err(.Input(.{ reason = error, stream_offset = self.position }))
            }
            if count > capacity {
                return .Err(.InvalidProgress)
            }
            self.cursor = 0
            self.available = count
            if count == 0 {
                self.eof = true
                return .Ok(.None)
            }
        }
        .Ok(.Some(self.ahead.load_byte(self.cursor)))
    }

    // Grow geometrically up to the explicit record bound. Allocate and copy
    // before replacing the old owner, preserving all pending bytes on refusal.
    fn reserve(inout self: Self, bound: UInt64) -> Result[(), mem.Oom] where carries(), retains(self.record: self.allocator) {
        let capacity = match read self.record {
            Some(bytes) => bytes.length(),
            None => UInt64(0),
        }
        if self.length < capacity {
            return .Ok(())
        }
        // Start a pending record at 64 bytes before doubling its capacity.
        let doubled = if capacity == 0 {
            UInt64(64)
        } else {
            if capacity > UInt64.max / 2 {
                UInt64.max
            } else {
                capacity * 2
            }
        }
        let grown = if doubled > bound {
            bound
        } else {
            doubled
        }
        &self.resize_record(grown)
    }

    // Preserve the prefix before replacing storage, for growth and smaller-limit
    // recovery alike. Refusal leaves the previous record and allocation intact.
    fn resize_record(inout self: Self, capacity: UInt64) -> Result[(), mem.Oom] where carries(), retains(self.record: self.allocator) {
        var next = self.allocator.acquire(capacity)?
        match read self.record {
            Some(previous) => {
                for index in 0..self.length {
                    &next.store_byte(index, previous.load_byte(index))
                }
            },
            None => {},
        }
        let replacement: Option[mem.Buffer[A]] = .Some(next)
        let previous = replace_pending_buffer(&self.record, replacement)
        previous.release()
        .Ok(())
    }

    // Consume one byte from the read-ahead into the record.
    fn append(inout self: Self, byte: UInt8, bound: UInt64) -> Result[(), LineError[R.Error]] where carries(), retains(self.record: self.allocator) {
        if self.position == UInt64.max {
            return .Err(.PositionOverflow)
        }
        &self.reserve(bound)?
        store_pending_byte(&self.record, self.length, byte)
        self.length += 1
        self.cursor += 1
        self.position += 1
        .Ok(())
    }

    // Return the record's length without its line terminator.
    fn payload_length(self: Self) -> UInt64 {
        var length = self.length
        let bytes = self.pending()
        // Strip LF (10), and CR (13) only when it immediately precedes LF.
        if length != 0 && bytes[length - 1] == 10 {
            length -= 1
            if length != 0 && bytes[length - 1] == 13 {
                length -= 1
            }
        }
        length
    }

    // Collect bytes into the record until the line ends or the input does.
    // Return false at EOF when nothing was collected.
    fn fill(inout self: Self, max_bytes: UInt64) -> Result[Bool, LineError[R.Error]] where carries(.Err.Input.reason: self.reader), retains(self.record: self.allocator) {
        let bound = record_storage_bound(max_bytes, self.raw)
        let capacity = match read self.record {
            Some(bytes) => bytes.length(),
            None => UInt64(0),
        }
        if capacity > bound {
            if self.length > bound {
                return .Err(.Limit)
            }
            &self.resize_record(bound)?
        }
        loop {
            let byte = &self.peek()? else {
                self.complete = true
                if self.length > max_bytes {
                    return .Err(.Limit)
                }
                self.blocked = false
                return .Ok(self.length != 0)
            }
            // CR (13) after a full payload fits only when followed by LF (10).
            if self.length > max_bytes && (self.raw || byte != 10 || self.length - max_bytes != 1) {
                return .Err(.Limit)
            }
            &self.append(byte, bound)?
            if byte == 10 {
                self.complete = true
                let length = if self.raw {
                    self.length
                } else {
                    self.payload_length()
                }
                if length > max_bytes {
                    return .Err(.Limit)
                }
                self.blocked = false
                return .Ok(true)
            }
            if self.length > max_bytes && (self.raw || byte != 13) {
                return .Err(.Limit)
            }
        }
    }

    // Borrow the record's payload as text, or block the reader on invalid
    // UTF-8 so the line must be recovered.
    fn text_view(inout self: Self) -> Result[Option[Str], LineError[R.Error]] where borrows(.Ok: self) {
        let length = self.payload_length()
        let bytes = self.pending().subspan(start: 0, count: length).unwrap()
        match Str.from_bytes(bytes) {
            Err(error) => {
                self.blocked = true
                return .Err(.Encoding(.{ offset = error.offset, stream_offset = self.record_start + error.offset }))
            },
            Ok(line) => return .Ok(.Some(line)),
        }
    }

    // Move the record's payload out as owned text. Invalid UTF-8 puts the raw
    // record back and blocks the reader, so the line can still be recovered.
    fn owned_text(inout self: Self) -> Result[Option[String[A]], LineError[R.Error]] where carries(.Ok: self.record) {
        let length = self.payload_length()
        let bytes = &self.take_bytes(length)
        match String.from_bytes(bytes) {
            Ok(line) => return .Ok(.Some(line)),
            Err(Utf8Failure { bytes: bytes, error: error }) => {
                let replacement = mem.vector_into_buffer(bytes)
                let empty = replace_pending_buffer(&self.record, replacement)
                empty.release()
                self.blocked = true
                return .Err(.Encoding(.{ offset = error.offset, stream_offset = self.record_start + error.offset }))
            },
        }
    }
}

// Return how many bytes a record may hold: a raw line needs one byte past
// `max_bytes` to detect overflow, and a text line room for a CRLF after its
// payload.
fn record_storage_bound(max_bytes: UInt64, raw: Bool) -> UInt64 {
    let extra: UInt64 = if raw {
        1
    } else {
        2
    }
    if max_bytes > UInt64.max - extra {
        UInt64.max
    } else {
        max_bytes + extra
    }
}

// peek only ever fails with an input error or a reader that reported more
// bytes than its destination held; every other reason belongs to framing
// state read_exact never sets and so can never observe.
fn exact_error_from_peek[E](sink error: LineError[E]) -> ExactError[E] {
    match error {
        Input(failure) => .Input(failure),
        Allocation(_reason) => .RecoveryRequired,
        Limit => .RecoveryRequired,
        Encoding(_problem) => .RecoveryRequired,
        RecoveryRequired => .RecoveryRequired,
        ResumeUnavailable => .RecoveryRequired,
        InvalidProgress => .InvalidProgress,
        PositionOverflow => .RecoveryRequired,
    }
}

// Replace the complete optional owner and return its previous contents.
fn replace_pending_buffer[A: Allocator](inout storage: Option[mem.Buffer[A]], sink next: Option[mem.Buffer[A]]) -> Option[mem.Buffer[A]] where carries(storage), retains(storage: next) {
    let previous = storage
    storage = next
    previous
}

// Store `byte` at `offset` in the record.
fn store_pending_byte[A: Allocator](inout storage: Option[mem.Buffer[A]], offset: UInt64, byte: UInt8) {
    var bytes = storage.unwrap()
    &bytes.store_byte(offset, byte)
    storage = .Some(bytes)
}
