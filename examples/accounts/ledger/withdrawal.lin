// Files in ledger share a namespace, so this file can name Account and access
// its fields without importing the file that declares it.
import std.testing

@derive(Equatable, Debug)
pub enum WithdrawalError {
    InsufficientFunds,
}

impl Account {
    // `inout` changes the caller's account; the call marks it with `&`.
    // Only read parameters may have defaults. `read` is implicit for amount
    // and fee, and omitting fee uses zero. Success returns the new balance.
    pub fn withdraw(inout self: Self, amount: UInt64, fee: UInt64 = 0) -> Result[UInt64, WithdrawalError] {
        if amount > self.balance {
            return .Err(.InsufficientFunds)
        }
        // Check the fee against the remainder without overflowing amount + fee.
        if fee > self.balance - amount {
            return .Err(.InsufficientFunds)
        }
        self.balance = self.balance - amount - fee
        .Ok(self.balance)
    }

    // `testing.assert_eq` compares whole `Result` values, so a wrong variant and a
    // wrong balance both fail the test.
    test fn withdrawal_deducts_the_amount_and_fee() {
        var account = Account.open(10000)
        let result = &account.withdraw(amount: 2500, fee: 100)
        let balance = account.close()
        let expected: Result[UInt64, WithdrawalError] = .Ok(7400)
        testing.assert_eq(result, expected, "withdrawal returns the new balance")?
        testing.assert_eq(balance, 7400, "balance after amount and fee")?
    }

    test fn declined_withdrawals_leave_the_balance_unchanged() {
        var account = Account.open(100)
        let too_much = &account.withdraw(amount: 101)
        let fee_too_large = &account.withdraw(amount: 100, fee: 1)
        let balance = account.close()
        let expected: Result[UInt64, WithdrawalError] = .Err(.InsufficientFunds)
        testing.assert_eq(too_much, expected, "amount exceeds balance")?
        testing.assert_eq(fee_too_large, expected, "fee exceeds remainder")?
        testing.assert_eq(balance, 100, "declined withdrawals preserve funds")?
    }

    test fn withdrawing_the_full_balance_leaves_zero() {
        var account = Account.open(100)
        let result = &account.withdraw(amount: 100)
        let balance = account.close()
        let expected: Result[UInt64, WithdrawalError] = .Ok(0)
        testing.assert_eq(result, expected, "full withdrawal uses the default zero fee")?
        testing.assert_eq(balance, 0, "account can be emptied")?
    }

    test fn a_large_fee_is_declined_without_overflow() {
        // 2^64 - 1 is the largest balance; adding the fee directly would overflow.
        let maximum: UInt64 = 18446744073709551615
        var account = Account.open(maximum)
        let result = &account.withdraw(amount: maximum, fee: 1)
        let balance = account.close()
        let expected: Result[UInt64, WithdrawalError] = .Err(.InsufficientFunds)
        testing.assert_eq(result, expected, "fee exceeds all remaining funds")?
        testing.assert_eq(balance, maximum, "funds are preserved")?
    }
}
