// `Of[Desk]` is `Option[Desk.Item]`, and `Desk.Item` is itself `Of[Other]`,
// so `Sample.x` is an `Option[Option[UInt8]]`.
trait Counter {
    type Item
}

struct Sample {
    x: Of[Desk],
}

alias Of[T: Counter] = Option[T.Item]

struct Desk {}

impl Counter for Desk {
    type Item = Of[Other]
}

struct Other {}

impl Counter for Other {
    type Item = UInt8
}

fn main() -> UInt8 {
    let sample = Sample { x = .Some(.Some(3)) }
    match read sample.x {
        Some(inner) => match read inner {
            Some(value) => value,
            None => 0,
        },
        None => 0,
    }
}
