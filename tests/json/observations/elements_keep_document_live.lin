import std.json

fn main() -> UInt8 {
    var document = json.Value.array()
    json.Value.append(&document, json.Value.boolean(true)).unwrap()
    let elements = document.elements().unwrap()
    document.release()
    if elements[UInt64(0)].as_bool().unwrap() {
        0
    } else {
        1
    }
}
