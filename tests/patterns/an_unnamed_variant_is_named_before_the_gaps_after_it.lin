// A variant no arm names is listed where the enum declares it, ahead of the
// gaps the arms leave in the variants after it, however many those are.
enum Dial {
    Unset,
    One(UInt8),
    Two(UInt8),
    Three(UInt8),
    Four(UInt8),
    Five(UInt8),
    Six(UInt8),
    Seven(UInt8),
    Eight(UInt8),
    Nine(UInt8),
    Ten(UInt8),
}

fn reading(sink dial: Dial) -> UInt8 {
    match dial {
        One(0) => 1,
        Two(0) => 2,
        Three(0) => 3,
        Four(0) => 4,
        Five(0) => 5,
        Six(0) => 6,
        Seven(0) => 7,
        Eight(0) => 8,
        Nine(0) => 9,
        Ten(0) => 10,
    }
}

fn main() -> UInt8 {
    reading(.One(0)) - 1
}
