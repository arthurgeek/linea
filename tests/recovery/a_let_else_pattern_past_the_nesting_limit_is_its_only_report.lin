// A `let … else` whose own pattern stands past the nesting limit is
// refused once. The refusal steps over that pattern alone and leaves the
// `=` to the `let`. The value and the `else` block stand at the same level,
// so they are refused under the same report, and nothing else is reported.
// The blocks below put the inner `let` at the limit.
fn split(code: UInt8) -> Option[(UInt8, UInt8)] {
    if code > 99 {
        return .None
    }
    .Some((code / 10, code % 10))
}

fn main() -> UInt8 {
    let (tens, ones) = split(37) else {
        return 1
    }
