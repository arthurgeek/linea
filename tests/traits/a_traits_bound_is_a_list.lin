// Every entry of a trait's bound is a demand, not only the first.
trait Same {
    fn alike(self: Self, other: Self) -> Bool
}

trait Marked {
    fn mark(self: Self) -> UInt8
}

trait Ranked: Same + Marked {
    fn under(self: Self, other: Self) -> Bool
}

struct Mark {
    n: UInt8,
}

impl Same for Mark {
    fn alike(self: Mark, other: Mark) -> Bool {
        self.n == other.n
    }
}

impl Ranked for Mark {
    fn under(self: Mark, other: Mark) -> Bool {
        self.n < other.n
    }
}

fn main() -> UInt8 {
    0
}
