import std.testing

// Release consumes a value without extra arguments or a policy choice. Linear
// types must be consumed, but need not provide this operation.
pub trait Release {
    fn release(sink self: Self) -> ()
}

// Settle applies to a failure that hands back an owned value: settling it
// releases the value and returns only why the operation failed. `Release`
// drops the whole failure, reason included; `Settle` drops the owned part and
// keeps the reason, so the caller can still report or propagate it.
// `Result.settled` applies it to a result's failure, which lets `?` propagate
// the reason.
//
// When releasing the owned part can itself fail, as closing a file can, the
// reason carries that failure beside the original one. A failure that holds a
// stream settles by closing it through `std.io`'s `Close` trait. `Release` never
// returns a value, so it may drop a failed close; `Settle` may not. Like
// `Release`, `Settle` is never scheduled: it runs only where it is called. It is
// not in the prelude, so a direct `failure.settle()` needs `use release.Settle`,
// while `Result.settled` needs nothing.
pub trait Settle: Release {
    type Reason

    fn settle(sink self: Self) -> Self.Reason where carries(self)
}

// Unit, the integers, Bool, Float64 and Str own no resource, so releasing one
// runs nothing.
impl Release for () {
    fn release(sink _self: ()) -> () {}
}

impl Release for Int8 {
    fn release(sink _self: Self) -> () {}
}

impl Release for Int16 {
    fn release(sink _self: Self) -> () {}
}

impl Release for Int32 {
    fn release(sink _self: Self) -> () {}
}

impl Release for Int64 {
    fn release(sink _self: Self) -> () {}
}

impl Release for UInt8 {
    fn release(sink _self: Self) -> () {}
}

impl Release for UInt16 {
    fn release(sink _self: Self) -> () {}
}

impl Release for UInt32 {
    fn release(sink _self: Self) -> () {}
}

impl Release for UInt64 {
    fn release(sink _self: Self) -> () {}
}

impl Release for Bool {
    fn release(sink _self: Self) -> () {}
}

impl Release for Float64 {
    fn release(sink _self: Self) -> () {}
}

impl Release for Str {
    fn release(sink _self: Self) -> () {}
}

test fn str_release_preserves_shared_literal_storage() {
    let text = "Linea λ"
    Release.release(copy(text))
    testing.assert_eq(text, "Linea λ", "release changed shared text storage")?
    text.release()
    .Ok(())
}

// Never has no values, so its release can never run.
impl Release for Never {
    fn release(sink self: Self) -> () {
        match self {}
    }
}

test fn never_release_is_available_to_an_uninhabited_payload() {
    let empty: Option[Never] = .None
    empty.release()
    .Ok(())
}

// Drop a value that may be dropped, running nothing. A derived `Release`
// settles a component this way when the component is discardable and does not
// implement `Release`.
pub fn discard[T: Discardable](sink _value: T) -> () {}

test fn discarding_a_copyable_value_runs_nothing() {
    let octets = [UInt8(10), 0, 0, 1]
    discard(copy(octets))
    testing.assert_eq(octets, [10, 0, 0, 1], "discarding a copy changed the original")?
    .Ok(())
}

// A derived `Release` settles components last first. A component that
// implements `Release` is released; one that is discardable without it is
// discarded; any other one must implement `Release` for the derive to apply.
template impl Release where reflect.components: Release {
    fn release(sink self: Self) -> () {
        match self {
            reflect.case => {
                for component in reflect.components.reversed {
                    Release.release(component.of(self))
                }
            },
        }
    }
}

// ObservedWithoutRelease is a linear value without Release, so only an
// observation of it can be released.
@linear
struct ObservedWithoutRelease {
    number: UInt64,
}

// Releasing an observation discards only the observation; the observed value
// stays with its owner.
impl[T] Release for borrow T {
    fn release(sink _self: Self) -> () {}
}

test fn releasing_an_observation_leaves_its_owner_available() {
    let owner = ObservedWithoutRelease { number = 7 }
    let observation = borrow owner
    observation.release()
    let ObservedWithoutRelease { number: number } = owner
    testing.assert_eq(number, UInt64(7), "observation release consumed its referent")?
    .Ok(())
}
