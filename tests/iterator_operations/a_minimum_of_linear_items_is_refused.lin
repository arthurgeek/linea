// `min` keeps one item and drops every other, and a linear ticket cannot be
// dropped.
@linear
struct Ticket { seat: UInt8 }

impl Equatable for Ticket {
    fn equals(self: Self, other: Self) -> Bool {
        self.seat == other.seat
    }
}

impl Equivalent for Ticket {}

impl Comparable for Ticket {
    fn less(self: Self, other: Self) -> Bool {
        self.seat < other.seat
    }
}

impl Ordered for Ticket {}

struct Tickets { next_seat: UInt8 }

impl Iterator for Tickets {
    type Item = Ticket

    fn next(inout self: Self) -> Option[Ticket] {
        if self.next_seat == 3 {
            return .None
        }
        self.next_seat += 1
        .Some(Ticket { seat = self.next_seat })
    }
}

fn main() -> UInt8 {
    match (Tickets { next_seat = 0 }).min() {
        Some(ticket) => {
            let Ticket { seat } = ticket
            seat
        },
        None => 0,
    }
}
