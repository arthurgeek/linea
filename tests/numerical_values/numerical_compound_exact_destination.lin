import std.num

fn main() -> UInt8 {
    var vector = [Int16(1), 2]
    vector += 1
    vector += [Int16(3), 4]
    vector *= num.matrix([[Int16(1), 2], [0, 1]])
    var matrix = num.matrix([[Int16(1), 2, 3], [4, 5, 6]])
    matrix *= num.matrix([[Int16(1), 0, 0], [0, 2, 0], [0, 0, 3]])
    if vector[0] != 5 || vector[1] != 17 || matrix[0, 1] != 4 || matrix[1, 2] != 18 {
        return 1
    }
    0
}
