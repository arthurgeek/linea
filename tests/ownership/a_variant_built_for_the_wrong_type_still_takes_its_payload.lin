// `Box.Held(key)` builds a `Box` whatever the annotation says, and building it
// takes `key`, so the second `Box.Held(key)` uses a key already taken.
@linear
struct Key {
    id: UInt8,
}

enum Box {
    Held(Key),
}

fn main() -> UInt8 {
    let key = Key { id = 1 }
    let _wrong: Bool = Box.Held(key)
    let _again = Box.Held(key)
    0
}
