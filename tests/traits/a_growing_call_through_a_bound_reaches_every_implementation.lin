// `count` hands `Show.show` an array of the value it was given, a larger type,
// at a receiver it knows only by its bound, so the call may reach every
// implementation of `Show`. `Echo`'s implementation calls `count` again, so
// each lap would need a body at a larger type, and the call is refused.
trait Show {
    fn show[U: Copyable](self: Self, depth: UInt8, value: U) -> UInt8
}

struct Plain {
    size: UInt8,
}

struct Echo {
    size: UInt8,
}

impl Show for Plain {
    fn show[U: Copyable](self: Plain, _depth: UInt8, _value: U) -> UInt8 {
        self.size
    }
}

impl Show for Echo {
    fn show[U: Copyable](self: Echo, depth: UInt8, value: U) -> UInt8 {
        count(Plain { size = self.size }, depth, value)
    }
}

fn count[R: Show, U: Copyable](receiver: R, depth: UInt8, value: U) -> UInt8 {
    if depth == 0 {
        0
    } else {
        Show.show(receiver, depth - 1, [copy(value)])
    }
}

fn main() -> UInt8 {
    count(Echo { size = 2 }, 2, UInt8(1))
}
