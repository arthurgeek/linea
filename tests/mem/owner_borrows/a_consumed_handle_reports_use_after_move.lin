import std.mem

use mem.Arena
use mem.Lender
use mem.system

fn consume(sink handle: mem.Handle[mem.SystemAllocator]) {
    let bytes = handle.acquire(8).unwrap()
    bytes.release()
}

fn main() -> UInt8 {
    let owner = Arena.open(system(), 64)
    let handle = owner.handle()
    consume(handle)
    let bytes = handle.acquire(8).unwrap()
    bytes.release()
    owner.release()
    0
}
