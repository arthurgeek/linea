import std.json
import std.mem

struct FailingWriter { error: Str }

impl Writer for FailingWriter {
    type Error = Str

    fn write_str(inout self: Self, s: Str) -> Result[(), Str] where carries(.Err: self) {
        if s.length() == 0 {
            return .Ok({})
        }
        return .Err(copy(self.error))
    }
}

fn main() -> UInt8 {
    let message = "stopped".to_owned(mem.system()).unwrap()
    var writer: FailingWriter = .{ error = message.view() }
    let result = json.encode(&writer, true)
    message.release()
    result.release()
    return 0
}
