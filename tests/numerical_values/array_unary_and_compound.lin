fn main() -> UInt8 {
    var a = [Int32(2), -6, 12]
    let negative = -a
    if negative[0] != -2 || negative[1] != 6 || negative[2] != -12 {
        return 1
    }
    a += [Int32(1), 2, 3]
    if a[0] != 3 || a[1] != -4 || a[2] != 15 {
        return 2
    }
    a *= 2
    a -= 1
    a /= [Int32(1), 3, 29]
    if a[0] != 5 || a[1] != -3 || a[2] != 1 {
        return 3
    }
    a %= [Int32(2), 2, 1]
    if a[0] != 1 || a[1] != -1 || a[2] != 0 {
        return 4
    }
    0
}
