fn held[T: Copyable](ring: Ring1[T]) -> T {
    copy(ring.x)
}

fn main() -> UInt8 {
    let ring: Ring0[UInt8] = .{ x = 40, next = .{}, skip = .{} }
    let next: Ring1[UInt8] = .{ x = 2, next = .{}, skip = .{} }
    ring.x + held(next)
}
