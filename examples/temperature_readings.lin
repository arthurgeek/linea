// Calibrate five daily greenhouse temperature readings, then report the
// average and the first reading that reaches the ventilation threshold.
//
// `for read` looks at each reading and `for inout` changes it in place; both
// leave the week whole for the next step.
import std.testing
import std.io

use io.IoError
use io.println

// The struct holds the data; the `impl` blocks below add indexing and
// traversal over its five readings.
struct Week {
    readings: [UInt64; 5],
}

// `via readings` forwards indexing to the stored array: `w[i]` is
// `w.readings[i]`. The traversal below walks the week by these indexes.
impl Index[Int64] for Week via readings

// `trav positions via readings` lets `for read` and `for inout` walk the
// week's readings in order.
impl Week {
    trav positions via readings
}

// Return the first reading at or above `limit`, or `None` if none qualifies.
fn first_at_least(w: Week, limit: UInt64) -> Option[UInt64] {
    for read r in w {
        if r >= limit {
            break r
        }
    }
}

test fn the_first_temperature_at_the_threshold_triggers_ventilation() {
    let w = Week { readings = [12, 19, 23, 17, 30] }

    testing.assert_eq(first_at_least(w, 20), .Some(23), "the first reading above twenty is 23")?
    testing.assert_eq(first_at_least(w, 23), .Some(23), "a reading equal to the threshold must qualify")?
    testing.assert_eq(first_at_least(w, 100), .None, "no reading reaches one hundred")?
}

// `inout w` lets `calibrate` change the caller's week, and `for inout` lends
// each reading to the loop, so `r += shift` changes it in place.
fn calibrate(inout w: Week, shift: UInt64) -> () {
    for inout r in w {
        r += shift
    }
}

test fn calibration_adjusts_each_daily_temperature() {
    var w = Week { readings = [1, 2, 3, 4, 5] }
    calibrate(&w, 10)
    testing.assert_eq(w.readings, [11, 12, 13, 14, 15], "every reading moves up by the shift")?
    testing.assert_eq(w[0], 11, "indexing the week reads Monday's calibrated reading")?
}

fn main() -> Result[UInt8, IoError] {
    var week = Week { readings = [12, 19, 23, 17, 30] }

    // The sensor reads two degrees low. `&week` marks the mutable argument.
    calibrate(&week, 2)

    // `zip` pairs each day name with that day's reading and stops when
    // either side ends. The pattern `(day, reading)` takes the pair apart.
    let days = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"]
    for (day, reading) in days.as_slice().zip(week.readings.as_slice()) {
        println("{day}: {reading} degrees")?
    }

    var total: UInt64 = 0
    for read reading in week {
        total += reading
    }
    // Average five readings; multiplying the remainder by 10 extracts tenths.
    let whole = total / 5
    let tenths = (total % 5) * 10 / 5
    println("calibrated greenhouse average: {whole}.{tenths} degrees")?

    // `Some` carries the first temperature found; `None` means the loop
    // visited every reading without reaching the threshold.
    match first_at_least(week, 25) {
        Some(temperature) => println("ventilation needed: first reading at least 25 degrees is {temperature}")?,
        None => println("all readings stay below the ventilation threshold")?,
    }

    .Ok(0)
}
