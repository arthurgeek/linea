// A function without a clause that takes one carrier has the type that
// writes `where carries(carrier)`, in both directions, and not the type that
// carries another parameter.
@carrier
struct Session {
    user: Str,
}

fn plain(session: Session, tag: Str) -> Str {
    if tag.length() > 0 {
        copy(session.user)
    } else {
        copy(session.user)
    }
}

fn written(session: Session, tag: Str) -> Str where carries(session) {
    if tag.length() > 0 {
        copy(session.user)
    } else {
        copy(session.user)
    }
}

fn through_tag(session: Session, tag: Str) -> Str where carries(tag) {
    if session.user.length() > 0 {
        copy(tag)
    } else {
        copy(tag)
    }
}

fn run(call: fn(session: Session, tag: Str) -> Str where carries(session), session: Session) -> Str {
    call(session, "x")
}

fn run_plain(call: fn(session: Session, tag: Str) -> Str, session: Session) -> Str {
    call(session, "x")
}

fn main() -> UInt8 {
    let session = Session { user = "ada" }
    let a = run(plain, session)
    let b = run_plain(written, session)
    let c = run(through_tag, session)
    let d = run_plain(through_tag, session)
    if a.length() + b.length() + c.length() + d.length() > 0 {
        0
    } else {
        1
    }
}
