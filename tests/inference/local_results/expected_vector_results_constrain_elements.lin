import std.mem

fn unsigned(value: UInt64) -> Bool {
    value == 0
}

fn signed(value: Int64) -> Bool {
    value == 0
}

fn main() -> Result[UInt8, mem.Oom] {
    let opened: Result[Vec[UInt64, mem.SystemAllocator], mem.Oom] = Vec.filled(mem.system(), count: 3, value: 0)
    let vector = opened?
    defer vector.release()
    let defaulted = Vec.filled(mem.system(), count: 3, value: 0)?
    defer defaulted.release()
    return .Ok(
        if unsigned(vector[0]) && signed(defaulted[0]) {
            0
        } else {
            1
        },
    )
}
