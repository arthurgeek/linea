// The same hole one construct over. A `break` leaves the loop, and the state
// it leaves into holds `d`, which `use2` was given and never received.
//
// The key is minted inside the body so that [O-Loop] has nothing to say: what
// this case is about is the transfer, not how many times the move runs.
@linear
struct Key {
    n: UInt8,
}

fn use2(sink a: Key, sink b: Key) -> UInt8 {
    let Key { n: x } = a
    let Key { n: y } = b
    x + y
}

fn key() -> Key {
    .{ n = 2 }
}

fn go() -> UInt8 {
    var n: UInt8 = 0
    while n < 1 {
        let d: Key = .{ n = 1 }
        n = use2(
            d,
            {
                break
                key()
            },
        )
    }
    n
}

fn main() -> UInt8 {
    go()
}
