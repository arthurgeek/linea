import std.io
import std.net
import std.session
import std.task
import std.time
import owner_resource

use net.Acceptor
use net.Accepted
use session.Chan
use session.End

fn main() -> UInt8 {
    var listener = net.listen(net.loopback(0)).unwrap()
    let owner = owner_resource.open(listener.local_address().unwrap())
    let Accepted { connection, address: _ } = &listener.accept().unwrap()
    var peer = connection
    listener.release()
    let client = owner.client()
    let execution = io.Loop.open(carriers: 2).unwrap()
    var entries = UInt64(0)
    var passed = false
    let body = sink [client, inout entries, inout passed] |sink me: Chan[End]| {
        entries += 1
        let (byte, system_owner) = client.read_byte()
        if byte != 120 || !system_owner {
            panic("the restricted client ran its resource on a fiber carrier")
        }
        let original = task.current_carrier().unwrap()
        var suspensions = UInt64(0)
        var moved = false
        while suspensions < 65536 && !moved {
            time.sleep(time.Duration.from_nanoseconds(0))
            suspensions += 1
            moved = original != task.current_carrier().unwrap()
        }
        if !moved {
            panic("a restricted client pinned its calling continuation")
        }
        let (next_byte, still_system_owner) = client.read_byte()
        if next_byte != 121 || !still_system_owner {
            panic("the migrated client's next job escaped the system owner")
        }
        passed = true
        me.close()
    }
    let running = task.start(body, on: execution).unwrap()
    let _sent = io.write_all(&peer, "xy".as_bytes()).unwrap()
    running.close()
    peer.release()
    let (calls, lifecycle_on_system) = owner.close()
    if passed && entries == 1 && calls == 2 && lifecycle_on_system {
        0
    } else {
        1
    }
}
