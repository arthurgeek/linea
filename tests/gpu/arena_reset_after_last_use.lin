import std.gpu
import std.tensor

fn main() -> UInt8 {
    let device = match gpu.Device.open() {
        Ok(device) => device,
        Err(error) => return if error == .Unavailable {
            0
        } else {
            1
        },
    }
    var arena = gpu.Arena.open(device, 65536).unwrap()
    device.release()
    let value = tensor.matrix_in(arena.handle(), [[Float32(1.0)]]).unwrap()
    let _dimensions = value.dimensions()
    &arena.reset().unwrap()
    arena.release()
    0
}
