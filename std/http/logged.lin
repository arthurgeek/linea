import std.io
import std.log
import std.mem
import std.net
import std.testing
import std.time

// `Logged` is a middleware: a handler holding another handler. It passes each
// request to `handler`, times the exchange from before `handler` runs until
// the answer has been written, and then writes one line to `logger`:
//
//     2026-09-25T09:31:02Z INFO request method=GET path=/health status=200 bytes=2 duration=41µs
//
// The line is at `Info` for a 2xx or 3xx status, `Warn` for a 4xx, and
// `Error` for a 5xx or an answer that failed, with an `error` field saying
// why. A request that `with_request_ids` numbered, which therefore wraps this
// middleware, adds a `request_id` field after the path, read from the request's
// own number rather than from any header. A request that could
// not be read has no method or path, and one the handler never saw has no
// duration. A failed accept serving will retry is
// logged at `Warn`, and the address `listen_and_serve` bound is logged at
// `Info` as `listening address=127.0.0.1:8080`. Every call reaches `handler` too, so middleware inside
// this one sees each request and event.
@opaque
struct Logged[H, S: log.Sink, A: Allocator] {
    handler: H,
    logger: log.Logger[S, A],
    // `started` records when the handler was given the request whose exchange
    // is under way.
    started: Option[time.Instant],
}

// Releasing a `Logged` releases the handler and the logger it holds.
derive[H: Release, S: log.Sink + Release, A: Allocator] Release for Logged[H, S, A]

// `Logged` takes the state its handler takes and passes it on.
impl[P: Allocator, T, H: Handler[T, P], S: log.Sink, A: Allocator] Handler[T, P] for Logged[H, S, A] {
    fn serve_http(inout self: Self, inout state: T, request: Request[P]) -> Result[Response[P], Error[P]] {
        self.started = .Some(time.Instant.now())
        &self.handler.serve_http(&state, request)
    }
}

// `Logged` implements `Observer` itself: it logs each event and passes it on
// to the handler it holds.
impl[H: Observer, S: log.Sink, A: Allocator] Observer for Logged[H, S, A] where S.Error: Discardable {
    fn observe[P: Allocator](inout self: Self, event: Event[P]) {
        match read event {
            Exchanged(exchange) => {
                let duration: Option[time.Duration] = match mem.take(&self.started) {
                    Some(start) => .Some(start.elapsed()),
                    None => .None,
                }
                let fields: Access[P] = .{ exchange = copy(exchange), duration }
                let _dropped = self.logger.log(level_of(exchange), "request", fields)
            },
            AcceptRetried(retry) => self.logger.warn("accepting a connection failed", log.field("error", retry.error).and("retry_in", retry.pause)),
            Listening(address) => self.logger.info("listening", log.field("address", address)),
        }
        &self.handler.observe(event)
    }
}

// `level_of` chooses the level of an exchange's line from its status, unless
// the answer failed, which is an error whatever its status.
fn level_of[P: Allocator](exchange: Exchange[P]) -> log.Level {
    let answered = match read exchange.failure {
        None => true,
        Some(Refused(_)) => true,
        Some(Unread(_)) => true,
        Some(_) => false,
    }
    let code = match read exchange.status {
        Some(status) => status.code(),
        None => return .Error,
    }
    if !answered || code >= 500 {
        return .Error
    }
    if code >= 400 {
        return .Warn
    }
    .Info
}

// `Access` is the fields of an exchange's line: the method and path when the
// request was read, its `request_id` when `with_request_ids` numbered it, the
// status, the body bytes, the duration when the handler ran, and the failure
// when there was one.
struct Access[P: Allocator] {
    exchange: Exchange[P],
    duration: Option[time.Duration],
}

impl[P: Allocator] log.Fields for Access[P] {
    fn visit[V: log.Visitor](self: Self, inout visitor: V) -> Result[(), V.Error] where carries(.Err: visitor) {
        match read self.exchange.request {
            Some(request) => {
                &visitor.field("method", request.method_text())?
                &visitor.field("path", request.path())?
                match read request.request_id {
                    Some(number) => &visitor.field("request_id", number)?,
                    None => {},
                }
            },
            None => {},
        }
        match read self.exchange.status {
            Some(status) => &visitor.field("status", status.code())?,
            None => {},
        }
        &visitor.field("bytes", self.exchange.body_bytes)?
        match read self.duration {
            Some(duration) => &visitor.field("duration", duration)?,
            None => {},
        }
        match read self.exchange.failure {
            Some(failure) => &visitor.field("error", failure)?,
            None => {},
        }
        .Ok(())
    }
}

// `logged` wraps `handler`, which may be a whole `Router`, so that every
// exchange it answers is logged to `logger`. Pass `copy(logger)` to keep
// logging through the same logger elsewhere, which a logger to standard
// error allows.
pub fn logged[H, S: log.Sink, A: Allocator](sink logger: log.Logger[S, A], sink handler: H) -> Logged[H, S, A] where carries(logger, handler) {
    .{ handler, logger, started = .None }
}

test fn an_exchange_is_logged_at_the_level_its_status_calls_for() {
    defer let arena = mem.Arena.open(mem.system(), size: 4096)
    let sent = new_request(arena.handle(), "GET", "/items/7?full=1", body: "").unwrap()
    let request = sent.request()
    let broken = io.IoError { operation = .Write, category = .BrokenPipe, code = .None, progress = 0 }
    let file = log.capture()
    var served = logged(file.logger(minimum: .Info), Counting { observed = 0 })
    let event1: Event = .Exchanged(.{ request = .Some(copy(request)), status = .Some(.Ok), body_bytes = 12, failure = .None })
    &served.observe(event1)
    let event2: Event = .Exchanged(.{ request = .Some(copy(request)), status = .Some(.NotFound), body_bytes = 10, failure = .Some(.Refused(.Some("not found"))) })
    &served.observe(event2)
    let event3: Event = .Exchanged(.{ request = .Some(request), status = .Some(.Ok), body_bytes = 4096, failure = .Some(.Write(broken)) })
    &served.observe(event3)
    let event4: Event = .Exchanged(.{ request = .None, status = .Some(.BadRequest), body_bytes = 0, failure = .Some(.Unread(.Status(.BadRequest))) })
    &served.observe(event4)
    let event5: Event = .Exchanged(.{ request = .None, status = .Some(.ServiceUnavailable), body_bytes = 0, failure = .Some(.Memory) })
    &served.observe(event5)
    let Logged { handler, logger, started: _ } = served
    logger.release()
    defer let lines = file.finish()
    let expected =
        \\INFO request method=GET path=/items/7 status=200 bytes=12
        \\WARN request method=GET path=/items/7 status=404 bytes=10 error="the handler refused the request: not found"
        \\ERROR request method=GET path=/items/7 status=200 bytes=4096 error="writing the response failed: Write failed (BrokenPipe) after 0 bytes"
        \\WARN request status=400 bytes=0 error="reading the request failed: the request was refused with 400 Bad Request"
        \\ERROR request status=503 bytes=0 error="there was no memory to answer the request"
        \\
    testing.assert_eq(lines.view(), expected, "the lines changed")?
    testing.assert_eq(handler.observed, UInt64(5), "the held handler did not see every event")?
    .Ok(())
}

test fn a_retried_accept_is_logged_as_a_warning() {
    let file = log.capture()
    var served = logged(file.logger(minimum: .Info), Counting { observed = 0 })
    let exhausted = io.IoError { operation = .Accept, category = .ResourceExhausted, code = .None, progress = 0 }
    let event: Event = .AcceptRetried(.{ error = .Io(exhausted), pause = time.Duration.from_nanoseconds(5000000) })
    &served.observe(event)
    let Logged { handler, logger, started: _ } = served
    logger.release()
    defer let lines = file.finish()
    testing.assert_eq(lines.view(), "WARN accepting a connection failed error=\"Accept failed (ResourceExhausted) after 0 bytes\" retry_in=5ms\n", "the retry line changed")?
    testing.assert_eq(handler.observed, UInt64(1), "the held handler did not see the event")?
    .Ok(())
}

test fn the_bound_address_is_logged_as_listening() {
    let file = log.capture()
    var served = logged(file.logger(minimum: .Info), Counting { observed = 0 })
    let event: Event = .Listening(net.loopback(8080))
    &served.observe(event)
    let Logged { handler, logger, started: _ } = served
    logger.release()
    defer let lines = file.finish()
    testing.assert_eq(lines.view(), "INFO listening address=127.0.0.1:8080\n", "the listening line changed")?
    testing.assert_eq(handler.observed, UInt64(1), "the held handler did not see the event")?
    .Ok(())
}

// A logged router answers as the router does, and each exchange is one line
// with the time the handler took to answer.
test fn a_logged_router_logs_each_exchange_it_serves() {
    let listener = net.listen(net.loopback(0)).unwrap()
    let bound = listener.local_address().unwrap()
    let found = send(bound, "GET /health HTTP/1.1\r\nHost: loopback\r\n\r\n")
    let missing = send(bound, "GET /nowhere HTTP/1.1\r\nHost: loopback\r\n\r\n")
    let malformed = send(bound, "garbage\r\n\r\n")
    let file = log.capture()
    var served = logged(file.logger(minimum: .Info), health_router())
    let serving = serve(listener, &served, limits: serving(3))
    defer let health = read_to_end(found)
    defer let absent = read_to_end(missing)
    defer let refused = read_to_end(malformed)
    let Logged { handler, logger, started: _ } = served
    handler.release()
    logger.release()
    defer let lines = file.finish()
    let expected =
        \\INFO request method=GET path=/health status=200 bytes=2 duration=D
        \\WARN request method=GET path=/nowhere status=404 bytes=10 duration=D error="the handler refused the request: not found"
        \\WARN request status=400 bytes=0 error="reading the request failed: the request was refused with 400 Bad Request"
        \\
    testing.assert_ok_eq(serving, (), "serving failed")?
    testing.assert_eq(health.view(), health_answer, "the logged router answered differently")?
    testing.assert_eq(lines.view(), expected, "the logged lines changed")?
    .Ok(())
}

// `Counting` answers every request with "ok" and counts the events it is told
// of, so a test can see that a middleware passes each one on.
struct Counting {
    observed: UInt64,
}

impl[P: Allocator, T] Handler[T, P] for Counting {
    fn serve_http(inout _self: Self, inout _state: T, request: Request[P]) -> Result[Response[P], Error[P]] {
        text(request, "ok")
    }
}

impl Observer for Counting {
    fn observe[P: Allocator](inout self: Self, _event: Event[P]) {
        self.observed += 1
    }
}
