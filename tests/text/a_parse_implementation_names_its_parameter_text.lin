import std.io
import std.text

@(copyable, derive(Debug))
struct Time {
    hours: UInt8,
    minutes: UInt8,
}

// With `Parse`, `text.parse[Time]()` reads a `Time` the way it reads a number.
// A `ParseError` says which byte is wrong.
impl text.Parse for Time {
    fn parse(text: Str) -> Result[Time, text.ParseError] where carries() {
        let (hours_text, minutes_text) = text.split_once(":") else {
            return .Err(.Syntax(text.length()))
        }
        let hours = hours_text.parse[UInt8]()?
        let minutes = minutes_text.parse[UInt8]()?
        if hours > 23 {
            return .Err(.Syntax(0))
        }
        if minutes > 59 {
            return .Err(.Syntax(hours_text.length() + 1))
        }
        return .Ok(.{ hours, minutes })
    }
}

fn main() -> Result[UInt8, io.IoError] {
    let written = ["07:30", "7h30", "25:00"]
    for text in written {
        match text.parse[Time]() {
            Ok(time) => io.println("{text}: {time:?}")?,
            Err(error) => io.println("{text}: {error:?}")?,
        }
    }
    return .Ok(0)
}
