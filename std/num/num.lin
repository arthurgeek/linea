    }
}

// Add up `values` from zero through the trait alone, as a generic sum does.
fn total_of[T: Additive](sink values: (T, T, T)) -> T {
    let (a, b, c) = values
    T.zero().add(a).add(b).add(c)
}

// Multiply `values` from one through the trait alone, as a generic product
// does.
fn product_of[T: Multiplicative](sink values: (T, T, T)) -> T {
    let (a, b, c) = values
    T.one().multiply(a).multiply(b).multiply(c)
}

test fn every_integer_type_adds_from_zero_and_multiplies_from_one() {
    testing.assert_eq(total_of((UInt8(1), 2, 3)), UInt8(6), "UInt8 addition")?
    testing.assert_eq(total_of((UInt16(1), 2, 3)), UInt16(6), "UInt16 addition")?
    testing.assert_eq(total_of((UInt32(1), 2, 3)), UInt32(6), "UInt32 addition")?
    testing.assert_eq(total_of((UInt64(1), 2, 3)), UInt64(6), "UInt64 addition")?
    testing.assert_eq(total_of((Int8(1), -2, 3)), Int8(2), "Int8 addition")?
    testing.assert_eq(total_of((Int16(1), -2, 3)), Int16(2), "Int16 addition")?
    testing.assert_eq(total_of((Int32(1), -2, 3)), Int32(2), "Int32 addition")?
    testing.assert_eq(total_of((Int64(1), -2, 3)), Int64(2), "Int64 addition")?
    testing.assert_eq(product_of((UInt8(2), 3, 4)), UInt8(24), "UInt8 multiplication")?
    testing.assert_eq(product_of((UInt16(2), 3, 4)), UInt16(24), "UInt16 multiplication")?
    testing.assert_eq(product_of((UInt32(2), 3, 4)), UInt32(24), "UInt32 multiplication")?
    testing.assert_eq(product_of((UInt64(2), 3, 4)), UInt64(24), "UInt64 multiplication")?
    testing.assert_eq(product_of((Int8(2), -3, 4)), Int8(-24), "Int8 multiplication")?
    testing.assert_eq(product_of((Int16(2), -3, 4)), Int16(-24), "Int16 multiplication")?
    testing.assert_eq(product_of((Int32(2), -3, 4)), Int32(-24), "Int32 multiplication")?
    testing.assert_eq(product_of((Int64(2), -3, 4)), Int64(-24), "Int64 multiplication")?
}

test fn both_float_types_add_from_zero_and_multiply_from_one() {
    testing.assert_eq(total_of((Float32(0.5), 0.25, 2.0)), Float32(2.75), "Float32 addition")?
    testing.assert_eq(total_of((Float64(0.5), 0.25, 2.0)), Float64(2.75), "Float64 addition")?
    testing.assert_eq(product_of((Float32(0.5), 0.25, 2.0)), Float32(0.25), "Float32 multiplication")?
    testing.assert_eq(product_of((Float64(0.5), 0.25, 2.0)), Float64(0.25), "Float64 multiplication")?
}
