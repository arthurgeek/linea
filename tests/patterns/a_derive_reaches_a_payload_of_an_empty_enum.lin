// Derived `Debug` and `Equatable` take every variant apart, the one whose
// payload is an enum with no variants included.
@copyable
@derive(Debug, Equatable)
enum Uninhabited {}

@copyable
@derive(Debug, Equatable)
enum Wrap {
    Never(Uninhabited),
    Plain(UInt8),
}

fn main() -> UInt8 {
    let a: Wrap = .Plain(1)
    let b: Wrap = .Plain(1)
    if a == b {
        0
    } else {
        1
    }
}
