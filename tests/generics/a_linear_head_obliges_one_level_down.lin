// An explicitly linear component remains an obligation through two
// ordinary wrappers; duplicating the outer value is rejected.
@linear
struct Cell[T] {
    v: T,
}

struct Box[T] {
    v: T,
}

struct Outer[T] {
    b: Box[Cell[T]],
}

fn look[T: Copyable](_o: Outer[T]) -> UInt8 {
    7
}

fn f[T: Copyable](x: T) -> UInt8 {
    let o: Outer[T] = .{ b = .{ v = .{ v = copy(x) } } }
    let p: Outer[T] = copy(o)
    look(o) + look(p)
}

fn main() -> UInt8 {
    let n: UInt8 = 1
    f(n)
}
