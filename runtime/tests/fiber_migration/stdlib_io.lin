import std.io
import std.mem
import std.net
import std.session
import std.task
import std.time

use io.Reader
use net.Acceptor
use net.Accepted
use session.Chan
use session.End

fn changed_carrier(before: task.Carrier, failure: Str) {
    var attempts = UInt64(0)
    while attempts < 65536 && before == task.current_carrier().unwrap() {
        time.sleep(time.Duration.from_nanoseconds(0))
        attempts += 1
    }
    if before == task.current_carrier().unwrap() {
        panic(failure)
    }
}

fn main() -> UInt8 {
    var listener = net.listen(net.loopback(0)).unwrap()
    let address = listener.local_address().unwrap()
    let first_client = net.connect(address).unwrap()
    let second_client = net.connect(address).unwrap()
    let execution = io.Loop.open(carriers: 2).unwrap()
    let body = sink [inout listener] |sink me: Chan[End]| {
        let before_descriptor = task.current_carrier().unwrap()
        var bad = io.descriptor(-1)
        var buffer = mem.system().acquire(1).unwrap()
        let failed_read = match &bad.read_some(&buffer, offset: 0, count: 1) {
            Ok(_) => false,
            Err(error) => error.category == .InvalidDescriptor,
        }
        let failed_write = io.write_all(&bad, "nowhere".as_bytes()).is_err()
        buffer.release()
        if !failed_read || !failed_write {
            panic("descriptor I/O lost its recoverable error")
        }
        changed_carrier(before_descriptor, "descriptor I/O pinned its calling continuation")

        let before_socket = task.current_carrier().unwrap()
        let temporary = net.listen(net.loopback(0)).unwrap()
        let _bound = temporary.local_address().unwrap()
        temporary.close().unwrap()
        let Accepted { connection: accepted, address: _ } = &listener.accept().unwrap()
        var connection = accepted
        &connection.shutdown_write().unwrap()
        connection.close().unwrap()
        let Accepted { connection: reset, address: _ } = &listener.accept().unwrap()
        reset.reset().unwrap()
        changed_carrier(before_socket, "socket lifecycle operations pinned their calling continuation")
        me.close()
    }
    task.start(body, on: execution).unwrap().close()
    first_client.release()
    second_client.release()
    listener.release()
    0
}
