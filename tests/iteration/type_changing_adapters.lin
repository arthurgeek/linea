import std.text

// A thousand exceeds UInt8 and makes narrowing an observable error.
fn widen(sink item: UInt8) -> UInt64 {
    UInt64(item) * 1000
}

fn widen_odd(sink item: UInt8) -> Option[UInt64] {
    if item % 2 == 0 {
        .None
    } else {
        .Some(UInt64(item) * 1000)
    }
}

fn parse_number(sink item: Str) -> Option[UInt64] where carries(item) {
    let parsed: Result[UInt64, text.ParseError] = item.parse()
    match parsed {
        Ok(number) => .Some(number),
        Err(_) => .None,
    }
}

fn main() -> UInt8 {
    let mapped = (UInt8(1)..3).map(widen)
    let selected = (UInt8(0)..4).filter_map(widen_odd)
    let all_total = mapped.fold(UInt64(0), |sink accumulator, sink item| accumulator + item)
    let odd_total = selected.fold(UInt64(0), |sink accumulator, sink item| accumulator + item)
    let fields = Str.split("10,invalid,20", ",").unwrap()
    let numbers = fields.filter_map(parse_number)
    let parsed_total = numbers.fold(UInt64(0), |sink accumulator, sink item| accumulator + item)
    if all_total == 3000 && odd_total == 4000 && parsed_total == 30 {
        0
    } else {
        1
    }
}
