import std.mem
import std.testing

// Return whether the byte at `at` is an ASCII digit, 0 (48) through 9 (57).
fn number_digit(input: Str, at: UInt64) -> Bool where carries() {
    match input.byte(at) {
        Some(byte) => byte >= 48 && byte <= 57,
        None => false,
    }
}

// Each consumed byte is in bounds; subtraction avoids start + limit overflow.
fn number_advance(inout at: UInt64, start: UInt64, max_bytes: UInt64) -> Result[(), ParseError] where carries() {
    if at - start >= max_bytes {
        return .Err(.{ kind = .NumberLimit, offset = at })
    }
    at += 1
    .Ok(())
}

// Scan one JSON number starting at `start`: an optional minus sign (45), an
// integer part with no leading zero (48), an optional fraction after a point
// (46), and an optional exponent after `e` (101) or `E` (69) with an optional
// sign, `+` (43) or `-`. Return the first byte after the token; the parser
// checks its delimiter.
fn scan_number(input: Str, start: UInt64, max_bytes: UInt64) -> Result[UInt64, ParseError] where carries() {
    var at = start
    let length = input.length()
    if at >= length {
        return .Err(.{ kind = .Syntax, offset = length })
    }
    if input.byte(at).unwrap() == 45 {
        number_advance(&at, start, max_bytes)?
    }
    if !number_digit(input, at) {
        return .Err(.{ kind = .Syntax, offset = at })
    }
    if input.byte(at).unwrap() == 48 {
        number_advance(&at, start, max_bytes)?
        if number_digit(input, at) {
            return .Err(.{ kind = .Syntax, offset = at })
        }
    } else {
        while number_digit(input, at) {
            number_advance(&at, start, max_bytes)?
        }
    }
    if at < length && input.byte(at).unwrap() == 46 {
        number_advance(&at, start, max_bytes)?
        if !number_digit(input, at) {
            return .Err(.{ kind = .Syntax, offset = at })
        }
        while number_digit(input, at) {
            number_advance(&at, start, max_bytes)?
        }
    }
    if at < length {
        let next = input.byte(at).unwrap()
        if next == 101 || next == 69 {
            number_advance(&at, start, max_bytes)?
            if at < length {
                let sign = input.byte(at).unwrap()
                if sign == 43 || sign == 45 {
                    number_advance(&at, start, max_bytes)?
                }
            }
            if !number_digit(input, at) {
                return .Err(.{ kind = .Syntax, offset = at })
            }
            while number_digit(input, at) {
                number_advance(&at, start, max_bytes)?
            }
        }
    }
    .Ok(at)
}

test fn number_scanning_stops_before_delimiters_and_reports_absolute_offsets() {
    testing.assert_eq(scan_number("x-12.5e+2,", 1, 8).unwrap(), UInt64(9), "number scanner consumed a delimiter")?
    let cases = ["01", "-01", "1.", "1e", "1e+", "+1", "--1"]
    for input in cases {
        testing.assert(match scan_number(input, 0, 16) { Err(error) => error.kind == ParseErrorKind.Syntax, _ => false }, "malformed number was accepted")?
    }
    testing.assert(match scan_number("x1e+", 1, 16) { Err(error) => error.offset == 4, _ => false }, "number EOF offset was not absolute")?
    testing.assert(match scan_number("123,", 0, 2) { Err(error) => error.kind == ParseErrorKind.NumberLimit && error.offset == 2, _ => false }, "number limit lost the first excess byte")?
    testing.assert(match scan_number("0", 0, 0) { Err(error) => error.kind == ParseErrorKind.NumberLimit && error.offset == 0, _ => false }, "zero number limit admitted a token")?
    .Ok(())
}

test fn number_scanning_classifies_every_prefix_of_a_number() {
    let input = "-12.34e+56"
    for end in UInt64(0)..input.length() + 1 {
        let prefix = input.slice(from: 0, to: end).unwrap()
        let complete = end == 2 || end == 3 || end == 5 || end == 6 || end == 9 || end == 10
        testing.assert_eq(scan_number(prefix, 0, 16).is_ok(), complete, "number prefix accepted the wrong grammar state")?
    }
    .Ok(())
}

// Append one decoded byte, refusing a string past `max_bytes` decoded bytes.
fn decoded_byte[A: Allocator](inout bytes: Vec[UInt8, A], value: UInt8, source: UInt64, max_bytes: UInt64) -> Result[(), ParseError] where carries() {
    if bytes.length() >= max_bytes {
        return .Err(.{ kind = .StringLimit, offset = source })
    }
    match &bytes.push(value) {
        Ok(_) => .Ok(()),
        Err(_) => .Err(.{ kind = .Allocation, offset = source }),
    }
}

// Append `scalar` encoded as UTF-8. A decoded escape is one Unicode scalar,
// never a surrogate code unit. The lead byte is 0xxxxxxx for one byte, or
// 110xxxxx (192), 1110xxxx (224) or 11110xxx (240) for two to four, and each
// continuation byte 10xxxxxx (128) carries six more bits.
fn decoded_scalar[A: Allocator](inout bytes: Vec[UInt8, A], scalar: UInt32, source: UInt64, max_bytes: UInt64) -> Result[(), ParseError] where carries() {
    let width: UInt64 = if scalar < 128 {
        1
    } else if scalar < 2048 {
        2
    } else if scalar < 65536 {
        3
    } else {
        4
    }
    if width > max_bytes - bytes.length() {
        return .Err(.{ kind = .StringLimit, offset = source })
    }
    if width == 1 {
        decoded_byte(&bytes, UInt8(scalar), source, max_bytes)?
    } else if width == 2 {
        decoded_byte(&bytes, UInt8(UInt32(192) + scalar / 64), source, max_bytes)?
        decoded_byte(&bytes, UInt8(UInt32(128) + scalar % 64), source, max_bytes)?
    } else if width == 3 {
        decoded_byte(&bytes, UInt8(UInt32(224) + scalar / 4096), source, max_bytes)?
        decoded_byte(&bytes, UInt8(UInt32(128) + scalar / 64 % 64), source, max_bytes)?
        decoded_byte(&bytes, UInt8(UInt32(128) + scalar % 64), source, max_bytes)?
    } else {
        decoded_byte(&bytes, UInt8(UInt32(240) + scalar / 262144), source, max_bytes)?
        decoded_byte(&bytes, UInt8(UInt32(128) + scalar / 4096 % 64), source, max_bytes)?
        decoded_byte(&bytes, UInt8(UInt32(128) + scalar / 64 % 64), source, max_bytes)?
        decoded_byte(&bytes, UInt8(UInt32(128) + scalar % 64), source, max_bytes)?
    }
    .Ok(())
}

// Read the four hexadecimal digits of a \u escape as one UTF-16 code unit.
fn unicode_unit(input: Str, inout at: UInt64) -> Result[UInt32, ParseError] where carries() {
    var unit: UInt32 = 0
    for _digit in UInt64(0)..4 {
        let byte = input.byte(at) else {
            return .Err(.{ kind = .InvalidEscape, offset = input.length() })
        }
        let digit: UInt32 = if byte >= 48 && byte <= 57 {
            UInt32(byte - 48)
        } else if byte >= 65 && byte <= 70 {
            UInt32(byte - 65) + 10
        } else if byte >= 97 && byte <= 102 {
            UInt32(byte - 97) + 10
        } else {
            return .Err(.{ kind = .InvalidEscape, offset = at })
        }
        unit = unit * 16 + digit
        at += 1
    }
    .Ok(unit)
}

// Read a \u escape as one Unicode scalar, combining a high surrogate with the
// low surrogate escape that must follow it.
fn unicode_scalar(input: Str, inout at: UInt64, source: UInt64) -> Result[UInt32, ParseError] where carries() {
    let first = unicode_unit(input, &at)?
    // UTF-16 reserves D800..DBFF for high and DC00..DFFF for low surrogates.
    let high_start = 55296
    let low_start = 56320
    let surrogate_end = 57343
    if first >= low_start && first <= surrogate_end {
        return .Err(.{ kind = .InvalidSurrogate, offset = source })
    }
    if first < high_start || first >= low_start {
        return .Ok(first)
    }
    if at == input.length() {
        return .Err(.{ kind = .InvalidSurrogate, offset = at })
    }
    if input.byte(at).unwrap() != 92 {
        return .Err(.{ kind = .InvalidSurrogate, offset = source })
    }
    at += 1
    if at == input.length() {
        return .Err(.{ kind = .InvalidSurrogate, offset = at })
    }
    if input.byte(at).unwrap() != 117 {
        return .Err(.{ kind = .InvalidSurrogate, offset = source })
    }
    at += 1
    let second = unicode_unit(input, &at)?
    if second < low_start || second > surrogate_end {
        return .Err(.{ kind = .InvalidSurrogate, offset = source })
    }
    // A surrogate pair stores two ten-bit parts above the BMP's 65,536 scalars.
    .Ok(65536 + (first - high_start) * 1024 + second - low_start)
}

// Decode string contents up to the closing quote (34), refusing a raw control
// byte below 32 and an unknown escape after a backslash (92).
fn string_contents[A: Allocator](input: Str, inout at: UInt64, inout bytes: Vec[UInt8, A], max_bytes: UInt64) -> Result[(), ParseError] where carries() {
    while at < input.length() {
        let source = at
        let byte = input.byte(at).unwrap()
        at += 1
        if byte == 34 {
            return .Ok(())
        }
        if byte < 32 {
            return .Err(.{ kind = .Syntax, offset = source })
        }
        if byte != 92 {
            decoded_byte(&bytes, byte, source, max_bytes)?
            continue
        }
        let escape = input.byte(at) else {
            return .Err(.{ kind = .InvalidEscape, offset = input.length() })
        }
        let escape_at = at
        at += 1
        // JSON has single-letter escapes for quote, backslash, slash, b, f, n,
        // r, t and u.
        let scalar: UInt32 = match read escape {
            34 => 34,
            92 => 92,
            47 => 47,
            98 => 8,
            102 => 12,
            110 => 10,
            114 => 13,
            116 => 9,
            117 => unicode_scalar(input, &at, source)?,
            _ => return .Err(.{ kind = .InvalidEscape, offset = escape_at }),
        }
        decoded_scalar(&bytes, scalar, source, max_bytes)?
    }
    .Err(.{ kind = .Syntax, offset = input.length() })
}

// Input is validated UTF-8; only decoded escapes introduce new byte sequences.
// Keep the caller's offset unchanged until a complete owned string is available.
fn scan_string[A: Allocator](allocator: A, input: Str, inout offset: UInt64, max_bytes: UInt64) -> Result[String[A], ParseError] where carries(.Ok: allocator) {
    if offset >= input.length() {
        return .Err(.{ kind = .Syntax, offset = input.length() })
    }
    if input.byte(offset).unwrap() != 34 {
        return .Err(.{ kind = .Syntax, offset = offset })
    }
    var at = offset + 1
    var bytes: Vec[UInt8, A] = Vec.new_in(allocator)
    match string_contents(input, &at, &bytes, max_bytes) {
        Err(error) => {
            bytes.release()
            return .Err(error)
        },
        Ok(_) => {},
    }
    // `settled()` releases the bytes of a string that is not UTF-8.
    let value = String.from_bytes(bytes).settled() else |_| {
        panic("JSON string decoding produced invalid UTF-8")
    }
    offset = at
    .Ok(value)
}

test fn string_scanning_decodes_all_short_escapes() {
    var at: UInt64 = 1
    defer let value = scan_string(mem.system(), r#"x"\"\\\/\b\f\n\r\t","#, &at, 8).unwrap()
    let expected: [UInt8; _] = [34, 92, 47, 8, 12, 10, 13, 9]
    testing.assert_eq(value.length(), expected.length(), "escaped byte count changed")?
    for i in 0..expected.length() {
        testing.assert_eq(value.byte(i).unwrap(), expected[i], "short escape decoded incorrectly")?
    }
    testing.assert_eq(at, UInt64(19), "string scanner consumed the delimiter")?
    .Ok(())
}

test fn string_scanning_preserves_unicode_and_decodes_surrogate_pairs() {
    var at: UInt64 = 0
    defer let value = scan_string(mem.system(), r#""olá\u0000\uD7FF\uE000\uD83D\uDE00\uDBFF\uDFFF""#, &at, 64).unwrap()
    testing.assert_eq(value.view(), "olá\u{0}\u{d7ff}\u{e000}😀\u{10ffff}", "Unicode scalar decoding changed bytes")?
    var raw_at: UInt64 = 0
    defer let raw = scan_string(mem.system(), r#""olá 😀""#, &raw_at, 9).unwrap()
    testing.assert_eq(raw.view(), "olá 😀", "raw Unicode changed")?
    .Ok(())
}

test fn unicode_escapes_cover_each_utf8_width_boundary() {
    var at: UInt64 = 0
    defer let value = scan_string(mem.system(), r#""\u007f\u0080\u07ff\u0800\uffff\ud800\udc00""#, &at, 64).unwrap()
    testing.assert_eq(value.view(), "\u{7f}\u{80}\u{7ff}\u{800}\u{ffff}\u{10000}", "UTF-8 width boundary changed")?
    .Ok(())
}

test fn string_scanning_rejects_raw_controls_and_accepts_their_unicode_escapes() {
    let hex = "0123456789abcdef"
    for code in UInt64(0)..32 {
        var raw_bytes = Vec.filled(count: 3, value: UInt8(34)).unwrap()
        raw_bytes[1] = UInt8(code)
        defer let raw = String.from_bytes(raw_bytes).unwrap()
        var raw_at: UInt64 = 0
        match scan_string(mem.system(), raw.view(), &raw_at, 1) {
            Ok(value) => {
                value.release()
                testing.assert(false, "raw control byte was accepted")?
            },
            Err(error) => {
                let expected: ParseError = .{ kind = .Syntax, offset = 1 }
                testing.assert_eq(error, expected, "raw control error changed")?
            },
        }
        var escaped_bytes = Vec.filled(count: 8, value: UInt8(48)).unwrap()
        escaped_bytes[0] = 34
        escaped_bytes[1] = 92
        escaped_bytes[2] = 117
        escaped_bytes[5] = hex.byte(code / 16).unwrap()
        escaped_bytes[6] = hex.byte(code % 16).unwrap()
        escaped_bytes[7] = 34
        defer let escaped = String.from_bytes(escaped_bytes).unwrap()
        var escaped_at: UInt64 = 0
        defer let value = scan_string(mem.system(), escaped.view(), &escaped_at, 1).unwrap()
        testing.assert_eq(value.byte(0).unwrap(), UInt8(code), "escaped control decoded incorrectly")?
    }
    .Ok(())
}

test fn string_scanning_rejects_bad_escapes_surrogates_and_truncated_prefixes() {
    let invalid = [r#""\x""#, r#""\u00xz""#, r#""\uD800""#, r#""\uDC00""#, r#""\uD800\u0041""#, r#""\uD800\uD800""#, r#""\uD800x""#]
    for input in invalid {
        var at: UInt64 = 0
        match scan_string(mem.system(), input, &at, 64) {
            Ok(value) => {
                value.release()
                testing.assert(false, "invalid escape or surrogate was accepted")?
            },
            Err(error) => testing.assert(error.kind == ParseErrorKind.InvalidEscape || error.kind == ParseErrorKind.InvalidSurrogate, "invalid escape had the wrong kind")?,
        }
        testing.assert_eq(at, UInt64(0), "failed scanning advanced caller offset")?
    }
    let complete = r#""a\uD83D\uDE00z""#
    for end in UInt64(0)..complete.length() {
        let prefix = complete.slice(from: 0, to: end).unwrap()
        var at: UInt64 = 0
        match scan_string(mem.system(), prefix, &at, 64) {
            Ok(value) => {
                value.release()
                testing.assert(false, "unfinished string was accepted")?
            },
            Err(error) => testing.assert_eq(error.offset, end, "truncated string did not report EOF")?,
        }
    }
    .Ok(())
}

test fn string_escape_errors_keep_absolute_offsets_after_input_release() {
    let inputs = [r#"x"\q""#, r#"x"\u0x00""#, r#"x"\uD800""#, r#"x"\uDC00""#, r#"x"\uD800\u0041""#]
    let kinds = [ParseErrorKind.InvalidEscape, ParseErrorKind.InvalidEscape, ParseErrorKind.InvalidSurrogate, ParseErrorKind.InvalidSurrogate, ParseErrorKind.InvalidSurrogate]
    let offsets: [UInt64; _] = [3, 5, 2, 2, 2]
    for index in 0..inputs.length() {
        let owned = inputs[index].to_owned().unwrap()
        var at: UInt64 = 1
        let result = scan_string(mem.system(), owned.view(), &at, 64)
        owned.release()
        match result {
            Ok(value) => {
                value.release()
                testing.assert(false, "invalid escape was accepted")?
            },
            Err(error) => {
                testing.assert_eq(error.kind, kinds[index], "escape error kind changed")?
                testing.assert_eq(error.offset, offsets[index], "escape error lost its absolute byte offset")?
            },
        }
        testing.assert_eq(at, UInt64(1), "invalid escape advanced the caller offset")?
    }
    .Ok(())
}

test fn a_bom_inside_a_string_is_preserved() {
    let input = "x\"a\u{feff}\""
    var at: UInt64 = 1
    defer let value = scan_string(mem.system(), input, &at, 4).unwrap()
    testing.assert_eq(value.view(), "a\u{feff}", "a string's BOM scalar was removed")?
    testing.assert_eq(at, input.length(), "a string's BOM changed the source offset")?
    .Ok(())
}

test fn string_limits_count_decoded_bytes_and_allow_empty_text() {
    var at: UInt64 = 0
    let empty = scan_string(mem.system(), r#""""#, &at, 0).unwrap()
    empty.release()
    testing.assert_eq(at, UInt64(2), "empty string did not finish")?
    var escaped_at: UInt64 = 0
    let escaped = scan_string(mem.system(), r#""\uD83D\uDE00""#, &escaped_at, 4).unwrap()
    escaped.release()
    var refused_at: UInt64 = 0
    match scan_string(mem.system(), r#""\uD83D\uDE00""#, &refused_at, 3) {
        Ok(value) => {
            value.release()
            testing.assert(false, "four decoded bytes fit a three-byte limit")?
        },
        Err(error) => {
            let expected: ParseError = .{ kind = .StringLimit, offset = 1 }
            testing.assert_eq(error, expected, "decoded limit lost its escape offset")?
        },
    }
    var raw_at: UInt64 = 0
    match scan_string(mem.system(), r#""ab""#, &raw_at, 1) {
        Ok(value) => {
            value.release()
            testing.assert(false, "raw string exceeded its byte limit")?
        },
        Err(error) => {
            let expected: ParseError = .{ kind = .StringLimit, offset = 2 }
            testing.assert_eq(error, expected, "raw limit lost its byte offset")?
        },
    }
    var zero_at: UInt64 = 0
    match scan_string(mem.system(), r#""a""#, &zero_at, 0) {
        Ok(value) => {
            value.release()
            testing.assert(false, "zero string limit admitted a byte")?
        },
        Err(error) => {
            let expected: ParseError = .{ kind = .StringLimit, offset = 1 }
            testing.assert_eq(error, expected, "zero string limit changed offset")?
        },
    }
    var unicode_at: UInt64 = 0
    match scan_string(mem.system(), r#""á""#, &unicode_at, 1) {
        Ok(value) => {
            value.release()
            testing.assert(false, "raw Unicode exceeded its byte limit")?
        },
        Err(error) => {
            let expected: ParseError = .{ kind = .StringLimit, offset = 2 }
            testing.assert_eq(error, expected, "raw Unicode limit did not identify the excess byte")?
        },
    }
    .Ok(())
}

test fn decoded_string_owns_storage_and_settles_allocation_failure() {
    defer let decoded = {
        let input = r#""name\u0000😀""#.to_owned().unwrap()
        var at: UInt64 = 0
        let value = scan_string(mem.system(), input.view(), &at, 64).unwrap()
        input.release()
        value
    }
    testing.assert_eq(decoded.view(), "name\u{0}😀", "decoded text retained its input")?
    defer let arena = mem.Arena.open(mem.system(), 16)
    var at: UInt64 = 0
    match scan_string(arena.handle(), r#""abcde""#, &at, 5) {
        Ok(value) => {
            value.release()
            testing.assert(false, "arena grew beyond its remaining capacity")?
        },
        Err(error) => {
            let expected: ParseError = .{ kind = .Allocation, offset = 5 }
            testing.assert_eq(error, expected, "partial string allocation failure changed")?
        },
    }
    testing.assert_eq(at, UInt64(0), "allocation failure advanced the caller offset")?
    .Ok(())
}
