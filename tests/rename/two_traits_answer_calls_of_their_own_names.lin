// Two traits each give `P` an operation of its own name, so each call is
// answered by exactly one of them.
trait A {
    fn foo(self: Self) -> UInt8
}

trait B {
    fn bar(self: Self) -> UInt8
}

struct P { x: UInt8 }

impl A for P {
    fn foo(self: Self) -> UInt8 {
        self.x
    }
}

impl B for P {
    fn bar(self: Self) -> UInt8 {
        self.x + 1
    }
}

fn main() -> UInt8 {
    let p = P { x = 3 }
    let q = P { x = 4 }
    p.foo() + q.bar()
}
