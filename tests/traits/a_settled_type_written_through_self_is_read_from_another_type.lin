// `Item` is written as `Self.Other`, the `UInt8` this implementation settles
// `Other` to, so `Holder` reading `Desk.Item` holds a `UInt8`.
trait Counter {
    type Item
    type Other
}

struct Holder {
    v: Desk.Item,
}

struct Desk {}

impl Counter for Desk {
    type Item = Self.Other
    type Other = UInt8
}

fn main() -> UInt8 {
    let holder = Holder { v = 1 }
    holder.v
}
