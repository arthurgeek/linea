// The closure borrows `list` `inout` for its calls, and `list` is the walk's
// one path to the element, so the walk reads the element again after the
// closure grew it, as it would after an `inout` call.
fn main() -> UInt8 {
    var held: [Vec[UInt8]; 1] = [Vec.new()]
    var total: UInt64 = 0
    for inout list in held {
        var grow = inout [inout list] || {
            for _ in 0..100 {
                let _q = &list.push(1)
            }
        }
        &grow()
        total += list.as_slice().length()
    }
    for list in held {
        list.release()
    }
    UInt8(total) - 100
}
