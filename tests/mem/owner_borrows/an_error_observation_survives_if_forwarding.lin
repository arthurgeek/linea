@linear
struct Token { number: UInt8 }

@linear
struct Failure { view: borrow UInt64 }

impl Token {
    fn close(sink self: Token) {
        let Token { number: _number } = self
    }
}

fn fail(sink failure: Failure) -> Result[Token, Failure] where carries(.Err: failure) {
    .Err(failure)
}

fn work(sink failure: Failure, flag: Bool) -> Result[UInt8, Failure] where carries(.Err: failure) {
    let answer = if flag {
        fail(failure)
    } else {
        fail(failure)
    }
    let token = answer?
    token.close()
    return .Ok(0)
}

fn main() -> UInt8 {
    let owner: UInt64 = 7
    match work(.{ view = borrow owner }, false) {
        Ok(value) => value,
        Err(failure) => {
            let Failure { view: view } = failure
            UInt8(*view)
        },
    }
}
