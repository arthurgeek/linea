// A bound on `Fancy` carries `Lookup` at the argument `Fancy` requires it
// at, so the parameter discharges a bound written at that same argument.
trait Lookup[I] {
    fn at(self: Self, i: I) -> UInt8
}

trait Fancy: Lookup[UInt64] {
    fn tag(self: Self) -> UInt8
}

struct Board {
    cells: [UInt8; 4],
}

impl Lookup[UInt64] for Board {
    fn at(self: Board, i: UInt64) -> UInt8 {
        self.cells[i]
    }
}

impl Fancy for Board {
    fn tag(_self: Board) -> UInt8 {
        7
    }
}

fn index[C: Lookup[UInt64]](c: C) -> UInt8 {
    let i: UInt64 = 2
    Lookup.at(c, i)
}

fn reach[T: Fancy](t: T) -> UInt8 {
    index(t)
}

fn main() -> UInt8 {
    let b: Board = .{ cells = [1, 2, 3, 4] }
    reach(b)
}
