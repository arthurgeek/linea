import std.mem

fn twice[F: fn(value: UInt64) -> UInt64](step: F, value: UInt64) -> UInt64 {
    step(step(value))
}

// A kept closure is not itself a callable a bound accepts, but a lambda that
// calls it is, and that lambda can be kept in another closure.
fn main() -> Result[UInt8, mem.Oom] {
    let bump: UInt64 = 3
    let add = mem.Closure.open(
        mem.system(),
        [sink bump] |value: UInt64| -> UInt64 {
            value + bump
        },
    )?
    let applied = twice([add] |value| add(value), 1)
    let kept = mem.Closure.open(
        mem.system(),
        [sink add] |value: UInt64| -> UInt64 {
            add(value) + 1
        },
    )?
    let again = kept(applied)
    kept.release()
    return .Ok(UInt8(again))
}
