// Sample the in-phase (cosine) and quadrature (sine) components of a signal.
import std.io
import std.testing

use io.IoError
use io.println

struct Signal { in_phase: Float64, quadrature: Float64 }

fn sample(time_seconds: Float64, frequency_hz: Float64) -> Signal {
    let radians_per_turn = 6.283185307179586
    let angle = radians_per_turn * frequency_hz * time_seconds
    Signal { in_phase = angle.cos(), quadrature = angle.sin() }
}

test fn a_quarter_cycle_advances_the_two_components() {
    let start = sample(time_seconds: 0.0, frequency_hz: 1.0)
    let quarter = sample(time_seconds: 0.25, frequency_hz: 1.0)
    testing.assert_eq(start.in_phase, 1.0, "the in-phase component starts at one")?
    testing.assert_eq(start.quadrature, 0.0, "the quadrature component starts at zero")?
    testing.assert(quarter.in_phase.abs() < 1e-12, "the in-phase component crosses zero")?
    testing.assert((quarter.quadrature - 1.0).abs() < 1e-12, "a quarter cycle reaches unit quadrature")?
}

test fn frequency_sets_the_period() {
    let cycle = sample(time_seconds: 0.5, frequency_hz: 2.0)
    testing.assert(cycle.quadrature.abs() < 1e-12, "two hertz completes a cycle in half a second")?
    testing.assert((cycle.in_phase - 1.0).abs() < 1e-12, "the in-phase component returns to its starting amplitude")?
}

fn main() -> Result[UInt8, IoError] {
    let times: [Float64; _] = [0.0, 0.125, 0.25]
    for time in times {
        let signal = sample(time_seconds: time, frequency_hz: 1.0)
        // `{time}` prints the shortest decimal that reads back as the same
        // Float64, and `:.3` rounds each amplitude to thousandths of full scale.
        println("{time} s: in-phase {signal.in_phase:.3}, quadrature {signal.quadrature:.3}")?
    }
    .Ok(0)
}
