// A handler's state outlives each request, while the request's text lives
// only until its response is written, so the state cannot keep a view of it.
import std.http

struct LastPath {
    path: Str,
}

impl[P: Allocator] http.Handler[(), P] for LastPath {
    fn serve_http(inout self: Self, inout _state: (), request: http.Request[P], inout _body: http.RequestBody[P]) -> Result[http.Response[P], http.Error[P]] where borrows(self, _body), retains(_body: _body), carries(request) {
        self.path = request.path()
        http.text(request, "ok")
    }
}

fn main() -> UInt8 {
    var handler = LastPath { path = "" }
    let exchange = http.TestExchange.open()
    var sent = exchange.request("GET", "/a").unwrap()
    var nothing = {}
    let status = match &sent.send_to(&handler, &nothing) {
        Ok(response) => response.status().code(),
        Err(_) => 0,
    }
    sent.release()
    exchange.release()
    if status == 200 {
        0
    } else {
        1
    }
}
