// A trait requiring Copyable admits an explicitly copyable record.
trait Duplicable: Copyable {
    fn tag(self: Self) -> UInt8
}

@copyable
struct Loose {
    n: UInt8,
}

impl Duplicable for Loose {
    fn tag(self: Loose) -> UInt8 {
        self.n
    }
}

fn main() -> UInt8 {
    let l: Loose = .{ n = 3 }
    Duplicable.tag(l)
}
