// `Holder`'s default is `Chooser[Tray].Out`, which exists only if `Tray` can
// be discarded, and `Tray` holds a `Holder`: `Tray`'s parts depend on that
// answer even though it would be consistent.
trait Pick {
    type Out
}

struct Chooser[T] {
    t: T,
}

impl[T: Discardable] Pick for Chooser[T] {
    type Out = UInt8
}

struct Holder[T = Chooser[Tray].Out] {
    v: T,
}

struct Tray {
    held: Holder,
}

fn main() -> UInt8 {
    let tray = Tray { held = .{ v = 4 } }
    tray.held.v
}
