import std.collections
import std.mem

fn main() -> UInt8 {
    var owner: UInt8 = 7
    var values: collections.Map[UInt8, borrow UInt8, mem.SystemAllocator] = collections.Map.new()
    collections.Map.insert(&values, 1, borrow owner).unwrap().release()
    owner = 9
    let observed = **values.get(1).unwrap()
    values.release()
    observed
}
