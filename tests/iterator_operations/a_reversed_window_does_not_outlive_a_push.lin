// A window keeps viewing the vector's storage however many adapters it comes
// through, so one taken from the far end cannot be used after a push either.
fn main() -> UInt8 {
    var readings: Vec[UInt8] = Vec.new()
    &readings.push(3).unwrap()
    &readings.push(5).unwrap()
    var pairs = readings.as_slice().windows(2).rev().peekable()
    let last = &pairs.next().unwrap()
    &readings.push(8).unwrap()
    let rise = last[1] - last[0]
    readings.release()
    rise
}
