// A member whose bound does not hold is not implemented, and that is reported
// where it is used rather than where the implementation is written. `Plain`
// does not carry `Show`, so `Holder[Plain]` is not one of the members this
// implementation answers for.
trait Show {}

struct Holder[T] {
    v: T,
}

struct Plain {
    _n: UInt8,
}

impl Show for UInt8 {}

impl[T: Show] Show for Holder[T] {}

fn shown[S: Show](_s: S) -> UInt8 {
    5
}

fn main() -> UInt8 {
    let h: Holder[Plain] = .{ v = .{ _n = 1 } }
    shown(h)
}
