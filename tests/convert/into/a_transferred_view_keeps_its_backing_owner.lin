struct Label { text: Str }

struct LabelView { text: Str }

impl From[Label] for LabelView {
    fn from(sink source: Label) -> LabelView where carries(source) {
        let Label { text } = source
        return .{ text }
    }
}

fn main() -> UInt8 {
    let owner = "shipment".to_owned().unwrap()
    let label: Label = .{ text = owner.view() }
    let view: LabelView = label.into()
    owner.release()
    UInt8(view.text.length())
}
