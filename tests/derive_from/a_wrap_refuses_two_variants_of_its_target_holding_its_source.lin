// `Count` and `Other` both hold a `UInt8`, so the wrap could build either
// variant of `R`, whatever the member promises to return.
trait Lift[T] {
    fn lift(sink value: T) -> Option[T]
}

template impl[S] Lift[S] where reflect.target: enum {
    fn lift(sink value: S) -> Option[S] {
        reflect.wrap(value)
    }
}

@derive(Lift[UInt8])
enum R {
    Count(UInt8),
    Other(UInt8),
    Third,
}

fn main() -> UInt8 {
    match R.lift(UInt8(7)) {
        Some(v) => v,
        None => 1,
    }
}
