import std.json
import std.mem

use mem.Owner

fn main() -> UInt8 {
    let empty = mem.Arena.open(mem.system(), 0)
    let storage = mem.Arena.open(mem.system(), 1024)
    var document = json.Value.array(empty.handle())
    let incoming = json.Value.string(storage.handle(), "kept").unwrap()
    let failure = match json.Value.append(&document, incoming) {
        Err(failure) => failure,
        Ok(_) => panic("an exhausted allocator accepted a child"),
    }
    document.release()
    empty.release()
    let correct = failure.value.as_str().unwrap() == "kept"
    failure.release()
    storage.release()
    if correct {
        0
    } else {
        1
    }
}
