fn UInt64;std.fmt;Display.fmt[std.io.core.Gathered](self: UInt64, inout w: std.io.core.Gathered) -> std.result.Result[(),std.io.core.IoError] {
    if self < T(0) {
        std.fmt;format_signed[std.io.core.Gathered](Int64(self), &w)
    } else {
        std.fmt;format_unsigned[std.io.core.Gathered](UInt64(self), &w)
    }
}

