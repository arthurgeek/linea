import std.io
import std.mem
import std.net
import std.session
import std.task
import std.time

use io.Reader
use net.Acceptor
use net.Accepted
use session.Chan
use session.End

pub fn run(mode: UInt8) -> UInt8 {
    let timeout = mode == 0
    var listener = net.listen(net.loopback(0)).unwrap()
    var peer = net.connect(listener.local_address().unwrap()).unwrap()
    let Accepted { connection, address: _ } = &listener.accept().unwrap()
    listener.release()
    let execution = io.Loop.open(carriers: 2).unwrap()
    var entries = UInt64(0)
    var passed = false
    let body = sink [sink connection, sink timed = timeout, sink expected_mode = mode, inout entries, inout passed] |sink me: Chan[End]| {
        entries += 1
        var stream = connection
        var buffer = mem.system().acquire(1).unwrap()
        let first = task.current_carrier().unwrap()
        if timed {
            // Start the deadline inside the already-running continuation.
            &stream.set_deadline(time.Instant.now(), within_ms: 5000)
        }
        let expected = match &stream.read_some(&buffer, offset: 0, count: 1) {
            Ok(count) => expected_mode == 3 && count == 0,
            Err(error) => if timed {
                error.category == .TimedOut
            } else if expected_mode == 1 {
                error.category == .ConnectionReset
            } else {
                error.category == .InvalidDescriptor
            },
        }
        if !expected {
            panic("the resumed I/O operation reported the wrong result")
        }
        if first == task.current_carrier().unwrap() {
            panic("a failed I/O operation did not migrate its continuation")
        }
        time.sleep(time.Duration.from_nanoseconds(0))
        if first != task.current_carrier().unwrap() {
            panic("error translation pinned the resumed I/O continuation")
        }
        buffer.release()
        stream.release()
        passed = true
        me.close()
    }
    let running = task.prepare(body, on: execution).unwrap().start()
    if timeout {
        // Keep the peer open and silent while the parked read expires.
        running.close()
        peer.release()
    } else if mode == 1 {
        peer.reset().unwrap()
        running.close()
    } else if mode == 3 {
        peer.release()
        running.close()
    } else {
        let _sent = io.write_all(&peer, "x".as_bytes()).unwrap()
        running.close()
        peer.release()
    }
    if passed && entries == 1 {
        0
    } else {
        1
    }
}
