// A `break` leaves the statements it is written in, and their temporaries end
// with them, so a loop cannot yield a value that borrows one.
struct Reading {
    value: borrow Int64,
}

fn reading(value: Int64) -> Reading where borrows(.value: value) {
    .{ value = borrow value }
}

fn main() -> UInt8 {
    let base = 40
    let found = loop {
        break reading(base + 2)
    }
    UInt8(*found.value)
}
