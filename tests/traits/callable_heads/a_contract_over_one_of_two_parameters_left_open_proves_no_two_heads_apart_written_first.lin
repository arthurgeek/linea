// One head settles its second parameter and the other leaves it open. With
// both first parameters at `UInt8` the contract over the first no longer
// stands, and both heads are `fn(a: UInt8, b: UInt8) -> Str`.
trait Run {
    fn go(self: Self) -> UInt8
}

impl[T] Run for fn(a: T, b: UInt8) -> Str where carries(a) {
    fn go(_self: Self) -> UInt8 {
        1
    }
}

impl[U, V] Run for fn(a: U, b: V) -> Str where carries() {
    fn go(_self: Self) -> UInt8 {
        2
    }
}

fn ask[H: Run](h: H) -> UInt8 {
    h.go()
}

fn lit(_a: UInt8, _b: UInt8) -> Str where carries() {
    "k"
}

fn main() -> UInt8 {
    ask(lit)
}
