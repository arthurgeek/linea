// A value given away on one path and held on the other, under one `defer`.
// The schedule is cancelled where the value went and fires where it did not,
// so every path disposes of it exactly once. This is the program a language
// with implicit destruction needs a run-time flag for, and nothing here stores
// one: which paths took the value is what the ownership lattice already knows.
//
// The path that gives it away leaves, which is what makes the two answers
// expressible. A decision belongs to an exit, so paths that rejoin have to
// agree about the value by the time they do -- [O-Merge] is that rule, and
// leaving is how a path keeps an answer of its own.
//
// The counters say which disposal ran on which path, so the status would move
// if either fired in the wrong place.
@linear
struct Key {
    n: UInt8,
}

fn take(sink k: Key, inout freed: UInt8) {
    let Key { n: _n } = k
    freed = freed + 1
}

fn give(sink k: Key, inout moved: UInt8) {
    let Key { n: _n } = k
    moved = moved + 1
}

fn go(c: Bool, inout freed: UInt8, inout moved: UInt8) -> UInt8 {
    let k: Key = .{ n = 5 }
    defer take(k, &freed)
    if c {
        give(k, &moved)
        return 0
    }
    0
}

fn main() -> UInt8 {
    var f: UInt8 = 0
    var m: UInt8 = 0
    let _a = go(true, &f, &m)

    var f2: UInt8 = 0
    var m2: UInt8 = 0
    let _b = go(false, &f2, &m2)

    f + m * 2 + f2 * 4 + m2 * 8
}
