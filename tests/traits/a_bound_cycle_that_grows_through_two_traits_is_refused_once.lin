// `Grow[T]` requires `Shrink[Option[T]]` and `Shrink[T]` requires
// `Grow[Vec[T]]`, so the arguments grow at each turn of the cycle. The bound
// that closes the cycle is the one report: the implementations and the
// function bounded on `Grow` are read as if it were not written.
trait Grow[T]: Shrink[Option[T]] {
    fn grow(self: Self, by: T) -> UInt8
}

trait Shrink[T]: Grow[Vec[T]] {
    fn shrink(self: Self, by: T) -> UInt8
}

struct Seed {
    size: UInt8,
}

impl Grow[UInt8] for Seed {
    fn grow(self: Self, by: UInt8) -> UInt8 {
        self.size + by
    }
}

impl Shrink[Option[UInt8]] for Seed {
    fn shrink(self: Self, _by: Option[UInt8]) -> UInt8 {
        self.size
    }
}

fn sprout[S: Grow[UInt8]](seed: S) -> UInt8 {
    seed.grow(1)
}

fn main() -> UInt8 {
    sprout(Seed { size = 1 })
}
