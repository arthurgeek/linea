struct Word { value: Str }

fn wrap(sink item: Str) -> Option[Word] where carries(item) {
    .Some(.{ value = item })
}

fn main() -> UInt8 {
    let owner = "word".to_owned().unwrap()
    let parts = Str.split(owner.view(), ",").unwrap()
    var mapped = parts.filter_map(wrap)
    let word = Iterator.next(&mapped).unwrap()
    owner.release()
    if word.value == "word" {
        0
    } else {
        1
    }
}
