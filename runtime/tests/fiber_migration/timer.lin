import std.io
import std.session
import std.task
import std.time

use session.Chan
use session.End

fn main() -> UInt8 {
    let execution = io.Loop.open(carriers: 2).unwrap()
    let seed = if io.current() == io.system() {
        UInt64(91)
    } else {
        UInt64(92)
    }
    var entries = UInt64(0)
    var result = UInt64(0)
    let body = sink [seed, inout entries, inout result] |sink me: Chan[End]| {
        entries += 1
        let original = task.current_carrier().unwrap()
        let began = time.Instant.now()
        var value = seed
        time.sleep(time.Duration.from_milliseconds(500))
        if began.elapsed().nanoseconds() < 500000000 {
            panic("the timer resumed before its deadline")
        }
        if original == task.current_carrier().unwrap() {
            panic("the completed timer did not migrate its continuation")
        }
        value = value * 3 + 7
        time.sleep(time.Duration.from_nanoseconds(0))
        if original != task.current_carrier().unwrap() {
            panic("the timer continuation did not return to its first carrier")
        }
        result = value + 11
        me.close()
    }
    task.start(body, on: execution).unwrap().close()
    if entries == 1 && result == seed * 3 + 18 {
        0
    } else {
        1
    }
}
