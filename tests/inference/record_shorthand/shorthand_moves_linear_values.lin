@linear
struct Ticket { code: UInt8 }

@linear
struct Envelope { ticket: Ticket }

fn main() -> UInt8 {
    let ticket: Ticket = .{ code = 9 }
    let envelope: Envelope = .{ ticket }
    let Envelope { ticket } = envelope
    let Ticket { code } = ticket
    if code == 9 {
        0
    } else {
        1
    }
}
