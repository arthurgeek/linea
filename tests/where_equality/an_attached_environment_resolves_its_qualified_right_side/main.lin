import bytes

trait Source {
    type Item
}

struct Provider {}

impl Source for Provider {
    type Item = UInt8
}

trait Label {
    fn label(_self: Self) -> UInt8
}

template impl Label where reflect.target: struct {
    fn label(_self: Self) -> UInt8 {
        7
    }
}

@derive(Label where I.Item == bytes.Byte)
struct Product[I: Source] {
    value: I.Item,
}

fn main() -> UInt8 {
    let product: Product[Provider] = .{ value = 1 }
    if product.label() == 7 {
        0
    } else {
        1
    }
}
