// `B.values` holds `M.Item`, which is `B.Elem`, the element of `B.values`.
trait Counter {
    type Item
}

struct M {}

impl Counter for M {
    type Item = B.Elem
}

struct B {
    values: [M.Item; 2],
}

impl Index[UInt64] for B via values

fn main() -> UInt8 {
    let board = B { values = [1, 2] }
    let item: M.Item = board[0]
    let byte: UInt8 = item
    byte
}
