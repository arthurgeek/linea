import std.mem

// `any` drops its predicate when it returns, and this predicate owns a vector
// that must be released.
fn main() -> UInt8 {
    let seen = mem.Vec.filled(2, UInt64(7)) else |_| {
        return 1
    }
    let heavy = [sink seen] |sink weight: UInt64| weight > seen.length()
    let found = (UInt64(1)..10).any(heavy)
    if found {
        0
    } else {
        3
    }
}
