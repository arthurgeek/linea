// A binder is a parameter of every implementation its attribute requests, so
// each trait's arguments must name it: `Count[A]` does, and `Marker` cannot
// say which `A` it is implemented at.
trait Marker {}

template impl Marker {}

trait Count[A] {
    fn count(_self: Self, _context: A) -> UInt64
}

template impl[A] Count[A] {
    fn count(_self: Self, _context: A) -> UInt64 {
        0
    }
}

@derive[A](Marker, Count[A])
struct Holder[T] { value: T }

fn main() -> UInt8 {
    let value: Holder[UInt64] = .{ value = 1 }
    UInt8(Count.count(value, false))
}
