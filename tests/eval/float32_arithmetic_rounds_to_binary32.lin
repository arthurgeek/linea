fn add(left: Float32, right: Float32) -> Float32 {
    left + right
}

fn divide(left: Float32, right: Float32) -> Float32 {
    left / right
}

fn main() -> UInt8 {
    // 2^24 + 1 is not a binary32 value, so the sum rounds to the even 2^24.
    let rounded = add(16777216.0, 1.0) == 16777216.0
    let infinite = divide(1.0, 0.0) > 3.4028235e38
    let nan = divide(0.0, 0.0)
    let unordered = !(nan < 1.0) && !(nan >= 1.0) && nan != nan
    let zeros = add(-0.0, -0.0) == 0.0
    let third = divide(1.0, 3.0) == 0.33333334
    if rounded && infinite && unordered && zeros && third {
        0
    } else {
        1
    }
}
