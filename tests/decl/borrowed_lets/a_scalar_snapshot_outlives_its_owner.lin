@linear
struct Owner { value: UInt8 }

fn close(sink owner: Owner) -> () {
    let Owner { value: _ } = owner
}

fn main() -> UInt8 {
    let owner = Owner { value = 23 }
    let read Owner { value } = owner
    let snapshot = value
    close(owner)
    if snapshot == 23 {
        0
    } else {
        1
    }
}
