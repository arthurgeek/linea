import std.mem
import std.release
import std.testing

use mem.Lender
use mem.PushFailure
use release.Settle

// Append every item of `iterator` to `values`, in source order. On refusal, the
// vector keeps its accepted prefix and the error owns the next item; the
// iterator has advanced past that item.
pub fn extend[I: Iterator, A: Allocator](
    inout values: Vec[I.Item, A],
    inout iterator: I,
) -> Result[(), mem.PushFailure[I.Item]] where retains(values: iterator), carries(.Err.value: iterator) {
    while true {
        match &iterator.next() {
            None => break,
            Some(value) => &values.push(value)?,
        }
    }
    .Ok(())
}

test "extend appends items in source order" {
    defer var values = Vec.filled(count: 1, value: UInt64(9)).unwrap()
    var source = UInt64(1)..4
    match extend(&values, &source) {
        Ok(_) => {},
        Err(_) => return testing.assert(false, "extending the vector failed"),
    }
    testing.assert_eq(values.length(), UInt64(4), "extension lost the existing prefix")?
    testing.assert_eq(values[0], UInt64(9), "extension replaced the existing item")?
    for index in UInt64(1)..4 {
        testing.assert_eq(values[index], index, "extension changed source order")?
    }
    testing.assert(&source.next().is_none(), "extension left an item unread")?
}

test "extend at exact capacity does not allocate after exhaustion" {
    // Eight cursor bytes and four UInt64 slots leave no room for another allocation.
    defer let arena = mem.Arena.open(mem.system(), size: 40)
    var values = Vec.filled_in(arena.handle(), count: 4, value: UInt64(7)).unwrap()
    var source = UInt64(0)..0
    testing.assert(extend(&values, &source).is_ok(), "empty extension attempted growth")?
    testing.assert_eq(values.length(), UInt64(4), "empty extension changed the prefix")?
}

test "extend fills exact remaining capacity before exhaustion" {
    defer let arena = mem.Arena.open(mem.system(), size: 40)
    var values: Vec[UInt64, mem.Handle] = Vec.new_in(arena.handle())
    &values.reserve(4).unwrap()
    &values.push(UInt64(0)).unwrap()
    &values.push(UInt64(1)).unwrap()
    var source = UInt64(2)..4
    testing.assert(extend(&values, &source).is_ok(), "exact-capacity extension attempted growth")?
    testing.assert_eq(values.length(), UInt64(4), "extension did not fill remaining capacity")?
    for index in UInt64(0)..4 {
        testing.assert_eq(values[index], index, "extension changed the prefix or appended order")?
    }
    testing.assert(&source.next().is_none(), "extension left its final item unread")?
}

test "extend returns the rejected item and resumes without recomputing" {
    // The cursor and four UInt64 slots consume all 40 bytes.
    defer let arena = mem.Arena.open(mem.system(), size: 40)
    var values: Vec[UInt64, mem.Handle] = Vec.new_in(arena.handle())
    var source = (UInt64(0)..7).map(
        inout [sink produced = UInt64(0)] |sink item| {
            produced += 1
            item
        },
    )
    let rejected = match extend(&values, &source) {
        Ok(_) => return testing.assert(false, "bounded vector unexpectedly grew"),
        Err(failure) => failure.value,
    }
    testing.assert_eq(rejected, UInt64(4), "extension returned the wrong rejected item")?
    testing.assert_eq(values.length(), UInt64(4), "refused insertion changed the prefix")?
    for index in UInt64(0)..4 {
        testing.assert_eq(values[index], index, "refused insertion changed a stored item")?
    }
    // Process the oldest item, then retry the already-produced value in its freed slot.
    testing.assert_eq(&values.remove(0).unwrap(), UInt64(0), "removal changed source order")?
    &values.push(rejected).unwrap()
    testing.assert_eq(&values.remove(0).unwrap(), UInt64(1), "removal changed the second item")?
    testing.assert_eq(&values.remove(0).unwrap(), UInt64(2), "removal changed the third item")?
    testing.assert(extend(&values, &source).is_ok(), "resuming the unread suffix attempted growth")?
    let (_remaining, callback) = source.into_parts()
    let { produced } = callback.into_captures()
    testing.assert_eq(produced, UInt64(7), "retry recomputed or skipped an item")?
    for index in UInt64(0)..4 {
        testing.assert_eq(values[index], index + 3, "retry lost or duplicated an item")?
    }
}

test "each allocation failure covers every growth step of an extension" -> Result[(), testing.Failure] {
    let checked = testing.each_allocation_failure(
        mem.system(),
        |allocator| -> Result[(), mem.PushFailure[UInt64]] {
            defer var values: Vec[UInt64, testing.TestHandle[mem.SystemAllocator]] = Vec.new_in(allocator)
            var source = UInt64(0)..40
            extend(&values, &source)?
            return .Ok(())
        },
        mem.PushFailure.is_refusal,
    )
    testing.assert(checked.is_ok(), "a growing extension was reported as failing")?
    .Ok(())
}

// Append every item of `iterator` to `values`, in source order, when the items
// are Owned. A copied byte or number carries nothing, so the vector keeps
// nothing of the iterator or of what it walks, which `extend` cannot promise
// for items that may borrow. On refusal, the vector keeps its accepted prefix
// and the error owns the next item.
pub fn extend_owned[I: Iterator, A: Allocator](
    inout values: Vec[I.Item, A],
    inout iterator: I,
) -> Result[(), mem.PushFailure[I.Item]] where I.Item: Owned {
    while true {
        match &iterator.next() {
            None => break,
            Some(value) => &values.push(value)?,
        }
    }
    .Ok(())
}

// The vector lives in an arena, so it carries the arena's borrow; it still
// keeps nothing of `readings`, which changes while the vector is live.
test "extend_owned keeps nothing of what the iterator walks" {
    defer let arena = mem.Arena.open(mem.system(), 128)
    var values: Vec[UInt8, mem.Handle] = Vec.new_in(arena.handle())
    var readings = [UInt8(3), 5, 8]
    var doubled = readings.as_slice().map(|sink reading| *reading * 2)
    testing.assert(extend_owned(&values, &doubled).is_ok(), "extending the vector failed")?
    readings[0] = 0
    testing.assert_eq(values.as_slice(), [UInt8(6), 10, 16].as_slice(), "the items did not arrive in source order")?
}

test "extend_owned returns the refused item and keeps the prefix" {
    // The cursor and four UInt64 slots consume all 40 bytes.
    defer let arena = mem.Arena.open(mem.system(), size: 40)
    var values: Vec[UInt64, mem.Handle] = Vec.new_in(arena.handle())
    var source = UInt64(0)..7
    let rejected = match extend_owned(&values, &source) {
        Ok(_) => return testing.assert(false, "bounded vector unexpectedly grew"),
        Err(failure) => failure.value,
    }
    testing.assert_eq(rejected, UInt64(4), "extension returned the wrong refused item")?
    testing.assert_eq(values.length(), UInt64(4), "the refusal changed the prefix")?
}

// A Collected holds the collected values and the iterator they came from,
// which may still hold state the caller must settle. `T` is the iterator's
// item type: `collect` always builds a
// `Collected[I, A, I.Item]`, and no other instantiation is produced. Naming
// it as its own parameter, rather than as `I.Item`, lets a release of the
// collected values stay within the finite instantiations [T-PolyRec] admits.
pub struct Collected[I: Iterator, A: Allocator, T] {
    values: Vec[T, A],
    iterator: I,
}

// CollectionTicket is a linear item with no Release implementation.
@linear
struct CollectionTicket { number: UInt64 }

// A CollectFailure holds what was collected before an item was refused, and
// the refusal, which owns that item.
pub struct CollectFailure[I: Iterator, A: Allocator, T] {
    collected: Collected[I, A, T],
    failure: mem.PushFailure[T],
}

// Display renders the refused insertion and borrows the collected prefix.
impl[I: Iterator, A: Allocator, T] Display for CollectFailure[I, A, T] {
    fn fmt[W: Writer](self: Self, inout w: W) -> Result[(), W.Error] {
        self.failure.fmt(&w)
    }
}

// Releasing a failed collection settles it, then releases the allocation
// reason.
impl[I: Iterator + Release, A: Allocator, T: Release] Release for CollectFailure[I, A, T] {
    fn release(sink self: Self) {
        self.settle().release()
    }
}

test "a failed collection can be released whole" {
    // The arena's cursor fills all eight bytes, so the first item is refused.
    defer let arena = mem.Arena.open(mem.system(), size: 8)
    let released = match (UInt64(0)..3).collect_in(arena.handle()) {
        Ok(Collected { values, iterator: _ }) => {
            values.release()
            false
        },
        Err(failure) => {
            failure.release()
            true
        },
    }
    testing.assert(released, "an exhausted arena accepted an item")?
}

// Settling a failed collection releases the collected prefix, the iterator
// and the refused item, and keeps the allocation reason.
impl[I: Iterator + Release, A: Allocator, T: Release] release.Settle for CollectFailure[I, A, T] {
    type Reason = mem.Oom

    fn settle(sink self: Self) -> mem.Oom where carries(self) {
        let CollectFailure { collected: Collected { values, iterator }, failure } = self
        let reason = failure.settle()
        iterator.release()
        values.release()
        reason
    }
}

test "settling a failed collection keeps the allocation reason" {
    // The arena's cursor fills all eight bytes, so the first item is refused.
    defer let arena = mem.Arena.open(mem.system(), size: 8)
    let settled = (UInt64(0)..3).collect_in(arena.handle()).settled()
    let refused = match settled {
        Ok(Collected { values, iterator: _ }) => {
            values.release()
            false
        },
        Err(reason) => reason == mem.Oom.Exhausted,
    }
    testing.assert(refused, "settling a failed collection lost its reason")?
}

// Push the halves of every pair `iterator` yields onto `lefts` and `rights`,
// in source order. On refusal the error owns the pair whose half was refused
// and the allocator's reason, and both vectors hold the halves of the pairs
// before it: a right half refused takes its left half back off `lefts`.
fn unzip_into[I: Iterator, A: Allocator, L, R](
    inout lefts: Vec[L, A],
    inout rights: Vec[R, A],
    inout iterator: I,
) -> Result[(), ((L, R), mem.Oom)] where
    I.Item == (L, R),
    retains(lefts: iterator),
    retains(rights: iterator),
    carries(.Err: iterator, lefts)
{
    while true {
        match &iterator.next() {
            None => break,
            Some(pair) => {
                let (left, right) = pair
                match &lefts.push(left) {
                    Ok(_) => {},
                    Err(PushFailure { reason, value }) => return .Err(((value, right), reason)),
                }
                match &rights.push(right) {
                    Ok(_) => {},
                    Err(PushFailure { reason, value }) => {
                        let taken_back = &lefts.pop().unwrap()
                        return .Err(((taken_back, value), reason))
                    },
                }
            },
        }
    }
    .Ok(())
}

test "unzip splits pairs into two vectors in order" {
    let Unzipped { lefts, rights, iterator: _ } = (UInt16(1)..4).zip(UInt8(10)..13).unzip().settled().unwrap()
    let lengths = (lefts.length(), rights.length())
    let ends = (lefts[0], lefts[2], rights[0], rights[2])
    lefts.release()
    rights.release()
    testing.assert_eq(lengths, (UInt64(3), UInt64(3)), "unzip lost a half")?
    testing.assert_eq(ends, (UInt16(1), UInt16(3), UInt8(10), UInt8(12)), "unzip changed a half or the order of the halves")?
}

test "unzip hands back the refused pair and the pairs before it" {
    // Eight cursor bytes, then room for four UInt64 halves: the left vector
    // takes the first two, the right vector is refused its second.
    defer let arena = mem.Arena.open(mem.system(), size: 40)
    let failed = (UInt64(1)..9).zip(UInt64(11)..19).unzip_in(arena.handle())
    let report: Option[((UInt64, UInt64), (UInt64, UInt64), mem.Oom)] = match failed {
        Ok(Unzipped { lefts, rights, iterator: _ }) => {
            lefts.release()
            rights.release()
            .None
        },
        Err(UnzipFailure { unzipped: Unzipped { lefts, rights, iterator: _ }, refused, reason }) => {
            let held = (lefts.length(), rights.length())
            lefts.release()
            rights.release()
            .Some((held, refused, reason))
        },
    }
    testing.assert(report.is_some(), "an arena too small for every half accepted them all")?
    let (held, refused, reason) = report.unwrap()
    testing.assert_eq(held._0, held._1, "the vectors hold different numbers of halves after a refusal")?
    testing.assert_eq(refused, (held._0 + 1, held._0 + 11), "the failure holds a pair other than the refused one")?
    testing.assert_eq(reason, mem.Oom.Exhausted, "the failure lost the allocator's reason")?
}

// An Unzipped holds the left halves and the right halves of a sequence of
// pairs, in source order, and the iterator they came from, which may still
// hold state the caller must settle. `L` and `R` are the halves' types.
pub struct Unzipped[I: Iterator, A: Allocator, L, R] {
    lefts: Vec[L, A],
    rights: Vec[R, A],
    iterator: I,
}

// An UnzipFailure holds what was unzipped before a vector refused a half, the
// pair that half came from, and the allocator's reason. Both vectors hold the
// halves of the pairs before the refused one.
pub struct UnzipFailure[I: Iterator, A: Allocator, L, R] {
    unzipped: Unzipped[I, A, L, R],
    refused: (L, R),
    reason: mem.Oom,
}

// Display renders the allocation refusal.
impl[I: Iterator, A: Allocator, L, R] Display for UnzipFailure[I, A, L, R] {
    fn fmt[W: Writer](self: Self, inout w: W) -> Result[(), W.Error] {
        &w.write_str("could not grow the vector: ")?
        self.reason.fmt(&w)
    }
}

// Releasing a failed unzip settles it, then releases the allocation reason.
impl[I: Iterator + Release, A: Allocator, L: Release, R: Release] Release for UnzipFailure[I, A, L, R] {
    fn release(sink self: Self) {
        self.settle().release()
    }
}

// Settling a failed unzip releases both vectors, the iterator and the refused
// pair, and keeps the allocation reason.
impl[I: Iterator + Release, A: Allocator, L: Release, R: Release] release.Settle for UnzipFailure[I, A, L, R] {
    type Reason = mem.Oom

    fn settle(sink self: Self) -> mem.Oom where carries(self) {
        let UnzipFailure { unzipped: Unzipped { lefts, rights, iterator }, refused, reason } = self
        let (left, right) = refused
        right.release()
        left.release()
        iterator.release()
        rights.release()
        lefts.release()
        reason
    }
}

test "settling a failed unzip keeps the allocation reason" {
    // The arena's cursor fills all eight bytes, so the first half is refused.
    defer let arena = mem.Arena.open(mem.system(), size: 8)
    let refused = match (UInt64(0)..3).zip(UInt64(5)..8).unzip_in(arena.handle()).settled() {
        Ok(Unzipped { lefts, rights, iterator: _ }) => {
            lefts.release()
            rights.release()
            false
        },
        Err(reason) => reason == mem.Oom.Exhausted,
    }
    testing.assert(refused, "settling a failed unzip lost its reason")?
}

test "a failed unzip displays its reason" {
    // The arena's cursor fills all eight bytes, so the first half is refused.
    defer let arena = mem.Arena.open(mem.system(), size: 8)
    let explained = match (UInt64(0)..3).zip(UInt64(5)..8).unzip_in(arena.handle()) {
        Ok(Unzipped { lefts, rights, iterator: _ }) => {
            lefts.release()
            rights.release()
            false
        },
        Err(failure) => {
            // The 64-byte recorder holds the growth refusal.
            var writer = testing.Recorder.of(64).unwrap()
            let said = failure.fmt(&writer).is_ok() && writer.holds("could not grow the vector: Exhausted")
            writer.release()
            failure.release()
            said
        },
    }
    testing.assert(explained, "a failed unzip did not say why")?
}
