trait Selected {
    fn selected(self: Self) -> UInt8
}

default impl[T] Selected for T {
    fn selected(_self: T) -> UInt8 {
        1
    }
}

impl Selected for Bool {
    fn selected(_self: Bool) -> UInt8 {
        2
    }
}

fn main() -> UInt8 {
    let flag = false
    if Selected.selected(borrow flag) == 2 && Selected.selected(UInt8(4)) == 1 {
        0
    } else {
        1
    }
}
