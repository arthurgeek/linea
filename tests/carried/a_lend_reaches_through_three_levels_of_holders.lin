import std.mem

// A Ticket keeps the dependencies of the callback it was issued for. The
// callback runs once when the ticket is issued; the `mem.Carried[F]` field
// keeps every place it lent or read reserved until the ticket's last use.
struct Ticket[F] {
    number: UInt64,
    held: mem.Carried[F],
}

fn issue[F: sink fn()](sink body: F) -> Ticket[F] where carries(body) {
    body()
    .{ number = 1, held = .{} }
}

fn redeem[F](sink ticket: Ticket[F]) -> UInt64 {
    let Ticket { number, held: _ } = ticket
    number
}

// A Booth holds a Counter, which holds a Ticket, so the booth keeps the
// ticket's lend of `seen` until the booth's last use.
struct Counter[F] {
    ticket: Ticket[F],
}

struct Booth[F] {
    counter: Counter[F],
    queue: UInt64,
}

fn open_booth[F](sink ticket: Ticket[F], queue: UInt64) -> Booth[F] where carries(ticket) {
    .{ counter = .{ ticket }, queue }
}

fn close_booth[F](sink booth: Booth[F]) -> UInt64 {
    let Booth { counter, queue } = booth
    let Counter { ticket } = counter
    redeem(ticket) + queue
}

fn main() -> UInt8 {
    var seen = UInt64(0)
    let booth = open_booth(
        issue(
            sink [inout seen] || {
                seen += 1
            },
        ),
        queue: 2,
    )
    seen = 5
    UInt8(close_booth(booth) + seen)
}
