import vault

trait Build {
    fn build() -> Self
}

template impl Build where reflect.target: struct {
    fn build() -> Self {
        reflect.construct(
            reflect.product,
            |component| {
                let field: component.Type = .{ value = 7 }
                field
            },
            {},
        )
    }
}

struct Holder { token: vault.Token }

derive Build for Holder

fn main() -> UInt8 {
    let _holder: Holder = Build.build()
    0
}
