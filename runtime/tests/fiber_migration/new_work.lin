import std.env
import std.io
import std.session
import std.task
import std.time

use session.Chan
use session.End

fn main() -> UInt8 {
    time.sleep(time.Duration.from_nanoseconds(0))
    let execution = io.Loop.open(carriers: 4).unwrap()
    var worker_entries = UInt64(0)
    var worker_value = UInt64(0)
    let worker = sink [inout worker_entries, inout worker_value] |sink me: Chan[End]| {
        worker_entries += 1
        let first = task.current_carrier().unwrap()
        var value = UInt64(91)
        for _index in 0..32768 {
            value += 3
        }
        if first != task.current_carrier().unwrap() {
            panic("new work moved without a suspension")
        }
        worker_value = value
        me.close()
    }
    let waiting = task.prepare(worker, on: execution).unwrap()
    for _index in 0..3 {
        let unused = task.prepare(
            sink [] |sink me: Chan[End]| {
                me.close()
            },
            on: execution,
        ).unwrap()
        let _unrun = unused.cancel()
    }
    var busy_entries = UInt64(0)
    var iterations = UInt64(0)
    let busy = sink [inout busy_entries, inout iterations] |sink me: Chan[End]| {
        busy_entries += 1
        let original = task.current_carrier().unwrap()
        if env.args().count() == 0 {
            panic("process has no argument zero")
        }
        if original != task.current_carrier().unwrap() {
            panic("the busy source moved")
        }
        let began = time.Instant.now()
        while began.elapsed().nanoseconds() < 5000000000 {
            iterations += 1
        }
        me.close()
    }
    let running_busy = task.prepare(busy, on: execution).unwrap().start()
    waiting.start().close()
    running_busy.close()
    if worker_entries == 1 && busy_entries == 1 && worker_value == 91 + 32768 * 3 && iterations > 0 {
        0
    } else {
        1
    }
}
