fn closure.0[Bool][Crate](read m: UInt8) -> UInt8 {
    let step = [self] |k: UInt8| self.weight() + k
    ;twice[closure1[Bool]$3aimpl[]$3aCrate](step, m) + closure.1[Bool][Crate](m)
