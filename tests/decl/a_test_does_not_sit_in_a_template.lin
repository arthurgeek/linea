// A template is instantiated for every type that satisfies it, and the compiler
// writes the one call to a test, so a test does not sit in a template. Refused
// there, it is refused once.
import std.testing

trait Named {
    fn name() -> UInt8
}

template impl Named where reflect.target: struct {
    fn name() -> UInt8 {
        0
    }

    test fn a_template_names_zero() {
        testing.assert(Self.name() == 0, "a template holds no test")?
    }
}

fn main() -> UInt8 {
    0
}
