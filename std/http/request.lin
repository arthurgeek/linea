import std.env
import std.io
import std.mem
import std.testing
import std.text as strings
import std.time

use mem.Lender

// A `Span` is a byte range of a request's stored text: `start` inclusive, `end`
// exclusive.
@(copyable, derive(Release))
struct Span {
    start: UInt64,
    end: UInt64,
}

// A `Field` pairs a name with its value, both ranges of a request's stored text.
@(copyable, derive(Release))
struct Field {
    name: Span,
    value: Span,
}

// A `Header` is one header as it arrived, borrowed from its request.
@(copyable, derive(Equatable, Debug))
pub struct Header {
    name: Str,
    value: Str,
}

// A `Message` holds a request read in full, body included, in the arena it was
// read into. The method token, target and header names and values are stored
// once in `head`, and each field records its byte ranges there. The query's
// names and values are stored decoded in `query_text`, with their ranges in
// `query_fields`, which is `None` when the query is not percent-encoded UTF-8.
// A body sent with `Content-Type: application/x-www-form-urlencoded` is
// decoded the same way into `body_text`, with its ranges in `body_fields`,
// which is `None` when the body does not name that type or is not
// percent-encoded UTF-8. A message holds seven allocations however many
// headers, query values and form values it carries. A handler reads it
// through `request`.
@opaque
struct Message[P: Allocator = mem.SystemAllocator] {
    memory: mem.Handle[P],
    known_method: Method,
    is_http_11: Bool,
    head: String[mem.Handle[P]],
    method_token: Span,
    target: Span,
    header_fields: Vec[Field, mem.Handle[P]],
    query_text: Vec[UInt8, mem.Handle[P]],
    query_fields: Option[Vec[Field, mem.Handle[P]]],
    payload: Vec[UInt8, mem.Handle[P]],
    body_text: Vec[UInt8, mem.Handle[P]],
    body_fields: Option[Vec[Field, mem.Handle[P]]],
}

// Append `part` to `stored` and return the range it occupies.
fn store_part[A: Allocator](inout stored: String[A], part: Str) -> Result[Span, mem.Oom] where carries() {
    let start = stored.length()
    &stored.append(part)?
    .Ok(.{ start = start, end = stored.length() })
}

// Return the text `span` covers in `stored`.
fn stored_part(stored: Str, span: Span) -> Str where carries(stored) {
    stored.slice(span.start, span.end).unwrap()
}

// `header_value` returns the first value of the header `name` among
// `fields`, stored in `head`, compared under ASCII case folding. It answers
// `Request.header` and, before a `Message` exists to ask, the construction
// that decides whether a body is a form.
fn header_value(head: Str, fields: mem.Slice[Field], name: Str) -> Option[Str] where carries(.Some: head) {
    for field in copy(fields) {
        if stored_part(head, field.name).equals_ascii_folded(name) {
            return .Some(stored_part(head, field.value))
        }
    }
    .None
}

test "a header_value is found by its folded name" {
    defer let arena = mem.Arena.open(mem.system(), size: 4096)
    var head = String.new_in(arena.handle())
    let name = store_part(&head, "Content-Type").unwrap()
    let value = store_part(&head, "application/json").unwrap()
    let fields = [Field { name, value }]
    testing.assert_eq(header_value(head.view(), fields.as_slice(), "content-type"), Option.Some("application/json"), "the value was not found")?
    testing.assert_eq(header_value(head.view(), fields.as_slice(), "accept"), .None, "an absent header was found")?
    .Ok(())
}

// `media_type` returns the media type a `Content-Type` value names: the text
// before any `;`, without the parameters, trimmed of whitespace. A request
// without the header names none.
fn media_type(content_type: Option[Str]) -> Option[Str] {
    let named = copy(content_type)?
    let (media, _) = named.split_once(";") else {
        (named, "")
    }
    .Some(media.trim_ascii())
}

test "a media_type is the value without its parameters" {
    testing.assert_eq(media_type(.Some("text/html")), Option.Some("text/html"), "a bare type changed")?
    testing.assert_eq(media_type(.Some(" text/html ; charset=utf-8")), Option.Some("text/html"), "a type with a parameter kept its parameter or its spaces")?
    testing.assert_eq(media_type(.Some("")), Option.Some(""), "an empty value changed")?
    testing.assert_eq(media_type(.None), .None, "a missing header named a type")?
    .Ok(())
}

// `is_form_content_type` says whether `content_type` names an HTML form's
// encoding, `application/x-www-form-urlencoded`, compared under ASCII case
// folding, with any parameters after `;` ignored.
fn is_form_content_type(content_type: Option[Str]) -> Bool {
    let media = media_type(content_type) else {
        return false
    }
    media.equals_ascii_folded("application/x-www-form-urlencoded")
}

test "a form content type is named exactly" {
    testing.assert(is_form_content_type(.Some("application/x-www-form-urlencoded")), "the form type was not named")?
    testing.assert(is_form_content_type(.Some("Application/X-WWW-Form-URLEncoded; charset=utf-8")), "a folded type with a parameter was not named")?
    testing.assert(!is_form_content_type(.Some("application/json")), "JSON was a form")?
    testing.assert(!is_form_content_type(.Some("multipart/form-data")), "a multipart body was a form")?
    testing.assert(!is_form_content_type(.None), "a body without a type was a form")?
    .Ok(())
}

// `query_of` decodes the query of `target`, the text after its first `?`,
// into `stored` with `decode_encoded_pairs`. A query of more than `max_pairs`
// pairs is refused with 414, as a target longer than the server reads, before
// anything is decoded. Running out of memory answers 500.
fn query_of[P: Allocator](inout stored: Vec[UInt8, mem.Handle[P]], target: Str, memory: mem.Handle[P], max_pairs: UInt64) -> Result[Option[Vec[Field, mem.Handle[P]]], RequestError] where carries(.Ok: memory) {
    let (_, query) = target.split_once("?") else {
        ("", "")
    }
    if pair_count(query) > max_pairs {
        return .Err(.Status(.UriTooLong))
    }
    match decode_encoded_pairs(&stored, query, memory) {
        Ok(fields) => .Ok(fields),
        Err(_) => .Err(.Status(.InternalServerError)),
    }
}

// `form_of` decodes `body` into `stored` with `decode_encoded_pairs`, exactly
// as `query_of` decodes a query, when `is_form` says the request's
// `Content-Type` names `application/x-www-form-urlencoded`. Otherwise it
// answers `None` without reading `body`, since bytes sent as another type are
// not name-value pairs. A body of more than `max_pairs` pairs is refused with
// 413, as a body longer than `Limits.max_body_bytes` is, before anything is
// decoded; a body that is not UTF-8 answers `None`, as a query that is not
// is. Running out of memory answers 500.
fn form_of[P: Allocator](inout stored: Vec[UInt8, mem.Handle[P]], is_form: Bool, body: mem.Slice[UInt8], memory: mem.Handle[P], max_pairs: UInt64) -> Result[Option[Vec[Field, mem.Handle[P]]], RequestError] where carries(.Ok: memory) {
    if !is_form {
        return .Ok(.None)
    }
    let text = Str.from_bytes(body) else |_| {
        return .Ok(.None)
    }
    if pair_count(text) > max_pairs {
        return .Err(.Status(.ContentTooLarge))
    }
    match decode_encoded_pairs(&stored, text, memory) {
        Ok(fields) => .Ok(fields),
        Err(_) => .Err(.Status(.InternalServerError)),
    }
}

test "a form body is read only when the content type names one" {
    defer let arena = mem.Arena.open(mem.system(), size: 4096)
    var not_form: Vec[UInt8, mem.Handle] = Vec.new_in(arena.handle())
    let skipped = form_of(&not_form, false, "name=Ada".as_bytes(), arena.handle(), 100).unwrap()
    var as_form: Vec[UInt8, mem.Handle] = Vec.new_in(arena.handle())
    let decoded = form_of(&as_form, true, "name=Ada+L%C3%B3pez".as_bytes(), arena.handle(), 100).unwrap().unwrap()
    var over: Vec[UInt8, mem.Handle] = Vec.new_in(arena.handle())
    let refused = match form_of(&over, true, "a=1&b=2".as_bytes(), arena.handle(), 1) {
        Ok(_) => Option.None,
        Err(error) => Option.Some(error),
    }
    testing.assert(skipped.is_none(), "a body sent as another type was decoded")?
    testing.assert_eq(decoded.length(), UInt64(1), "a form body was not decoded")?
    testing.assert_eq(refused, Option.Some(RequestError.Status(.ContentTooLarge)), "a form of too many pairs was accepted")?
    .Ok(())
}

// `decode_encoded_pairs` decodes the `name=value` pairs of `source`,
// separated by `&`, into `stored`, and returns their ranges there. `source`
// is a query's text or a form body's, encoded the same way: `+` stands for a
// space and `%XX` for the byte it spells. A pair without `=` has an empty
// value, and an empty pair is skipped. Text holding an escape that is not two
// hexadecimal digits, or a pair that does not decode to UTF-8, answers
// `None`.
//
// Decoding never lengthens text, and the pairs are counted first, so the text
// and the ranges are each reserved once, at their final size, and nothing
// else is allocated.
fn decode_encoded_pairs[A: Allocator](inout stored: Vec[UInt8, A], source: Str, allocator: A) -> Result[Option[Vec[Field, A]], mem.Oom] where carries(.Ok: allocator) {
    var fields: Vec[Field, A] = Vec.new_in(allocator)
    let pairs = pair_count(source)
    if pairs == 0 {
        return .Ok(.Some(fields))
    }
    let reserved = &stored.reserve(source.length()).is_ok() && &fields.reserve(pairs).is_ok()
    if !reserved {
        fields.release()
        return .Err(.Exhausted)
    }
    var outcome: Result[(), PercentError] = .Ok(())
    var start: UInt64 = 0
    while outcome.is_ok() && start < source.length() {
        let end = source.find("&", start: start).unwrap_or(source.length())
        let pair = source.slice(start, end).unwrap()
        start = end + 1
        if pair.length() > 0 {
            outcome = decode_pair(&stored, &fields, pair)
        }
    }
    match outcome {
        Ok(_) => .Ok(.Some(fields)),
        Err(error) => {
            fields.release()
            return match error {
                Allocation(_) => .Err(.Exhausted),
                _ => .Ok(.None),
            }
        },
    }
}

test "a query that is not percent encoded utf8 has no pairs" {
    defer let arena = mem.Arena.open(mem.system(), size: 4096)
    var stored: Vec[UInt8, mem.Handle] = Vec.new_in(arena.handle())
    let short = decode_encoded_pairs(&stored, "a=%4", arena.handle()).unwrap()
    let letters = decode_encoded_pairs(&stored, "a=%zz", arena.handle()).unwrap()
    let invalid = decode_encoded_pairs(&stored, "a=%FF", arena.handle()).unwrap()
    testing.assert(short.is_none(), "an incomplete escape was decoded")?
    testing.assert(letters.is_none(), "an escape of letters was decoded")?
    testing.assert(invalid.is_none(), "a byte that is not UTF-8 was decoded")?
    .Ok(())
}

// `pair_count` counts the pairs of `source` that are not empty. `split`
// refuses only an empty separator, so splitting at `&` cannot fail.
fn pair_count(source: Str) -> UInt64 {
    source.split("&").unwrap().filter(|pair| pair.length() > 0).count()
}

// `decode_pair` decodes one `name=value` pair into `stored` and records its
// ranges in `fields`.
fn decode_pair[A: Allocator](inout stored: Vec[UInt8, A], inout fields: Vec[Field, A], pair: Str) -> Result[(), PercentError] {
    let (raw_name, raw_value) = pair.split_once("=") else {
        (copy(pair), "")
    }
    let name = append_decoded(&stored, raw_name, plus_is_space: true)?
    let value = append_decoded(&stored, raw_value, plus_is_space: true)?
    match &fields.push(.{ name, value }) {
        Ok(_) => .Ok(()),
        Err(_) => .Err(.Allocation(.Exhausted)),
    }
}

test "a query decodes into its pairs" {
    defer let arena = mem.Arena.open(mem.system(), size: 4096)
    var stored: Vec[UInt8, mem.Handle] = Vec.new_in(arena.handle())
    let fields = decode_encoded_pairs(&stored, "a=1&&name=Ada+L%C3%B3pez&flag&=x&b=", arena.handle()).unwrap().unwrap()
    let text = Str.from_bytes(stored.as_slice()).unwrap()
    var decoded = String.new_in(arena.handle())
    for field in fields.as_slice() {
        let name = stored_part(text, field.name)
        let value = stored_part(text, field.value)
        "{name}={value};".fmt(&decoded).unwrap()
    }
    testing.assert_eq(decoded.view(), "a=1;name=Ada López;flag=;=x;b=;", "the pairs changed")?
    .Ok(())
}

impl[P: Allocator] Message[P] {
    // `request` returns the view a handler reads: this message's parts and the
    // arena they are stored in.
    pub fn request(self: Self) -> Request[P] where borrows(self) {
        .{
            memory = copy(self.memory),
            known_method = self.known_method,
            is_http_11 = self.is_http_11,
            head = self.head.view(),
            method_token = copy(self.method_token),
            target = copy(self.target),
            header_fields = self.header_fields.as_slice(),
            // Every name and value was checked to be UTF-8 as it was
            // decoded, so the whole is.
            query_text = Str.from_bytes(self.query_text.as_slice()).unwrap(),
            query_fields = match read self.query_fields {
                Some(fields) => .Some(fields.as_slice()),
                None => .None,
            },
            payload = self.payload.as_slice(),
            // Every name and value was checked to be UTF-8 as it was
            // decoded, so the whole is.
            body_text = Str.from_bytes(self.body_text.as_slice()).unwrap(),
            body_fields = match read self.body_fields {
                Some(fields) => .Some(fields.as_slice()),
                None => .None,
            },
            matched = "",
            path_values = .None,
            request_id = .None,
            deadline = time.never,
        }
    }

    test "a message is read through its request" {
        defer let arena = mem.Arena.open(mem.system(), size: 4096)
        let sent = read_in_steps(arena.handle(), "GET /a HTTP/1.1\r\nHost: b\r\n\r\n".as_bytes(), 16, Limits.default()).unwrap()
        let request = sent.request()
        testing.assert_eq(request.path(), "/a", "the path changed")?
        testing.assert_eq(request.header("host"), Option.Some("b"), "the header changed")?
        testing.assert_eq(request.path_value("a"), .None, "a request no router matched had a path value")?
        .Ok(())
    }

    // `added_header` adds the header `name: value` after the headers this
    // message has, as a client sends one, held to `limits`. A name that is not
    // a token, or a value holding a control byte, is refused with 400, as a
    // header line holding them is. The headers it already has count toward
    // `max_headers`, and a `Content-Length` disagreeing with an earlier one or a
    // second `Host` is refused with 400, as in a request read whole.
    fn added_header(inout self: Self, name: Str, value: Str, limits: Limits) -> Result[(), RequestError] where carries() {
        // Every `Content-Length` already held agrees with the first, which
        // was checked to be digits when it was added.
        let length: Option[UInt64] = match header_value(self.head.view(), self.header_fields.as_slice(), "Content-Length") {
            Some(earlier) => .Some(content_length(earlier, .None)?),
            None => .None,
        }
        var host_count: UInt64 = 0
        for field in self.header_fields.as_slice() {
            if stored_part(self.head.view(), field.name).equals_ascii_folded("Host") {
                host_count += 1
            }
        }
        var tally = HeaderTally { count = self.header_fields.length(), length, transfer_coded = false, host_count }
        add_header_field(&self.head, &self.header_fields, &tally, name, trim_optional_whitespace(value), limits)
    }
}

// `Headers` walks a request's headers in arrival order.
@opaque
struct Headers {
    stored: Str,
    fields: mem.Slice[Field],
    index: UInt64,
}

impl Iterator for Headers {
    type Item = Header

    fn next(inout self: Self) -> Option[Header] where carries(.Some: self.stored) {
        if self.index == self.fields.length() {
            return .None
        }
        let field = copy(self.fields[self.index])
        self.index += 1
        .Some(.{ name = stored_part(self.stored, field.name), value = stored_part(self.stored, field.value) })
    }
}

// Policy for trusting reverse-proxy transport headers when determining scheme.
// - `None`: do not trust client-supplied forwarded headers (the default).
// - `XForwardedProto`: trust the immediate hop from `X-Forwarded-Proto`.
// - `Forwarded`: trust the immediate hop from RFC 7239 `Forwarded`.
// - `All`: trust either `Forwarded` or `X-Forwarded-Proto`.
@(copyable, derive(Equatable, Debug, Release))
pub enum ProxyTrust {
    None,
    XForwardedProto,
    Forwarded,
    All,
}

// RFC 7239 separates the elements of a `Forwarded` value with `,`, the
// parameters of an element with `;`, and quotes a value with `"`, inside which
// `\` escapes the byte after it.
let ascii_quote: UInt8 = 34

let ascii_comma: UInt8 = 44

let ascii_semicolon: UInt8 = 59

let ascii_backslash: UInt8 = 92

// `separator_at` returns the offset of the first `separator` byte at or after
// `from` that sits outside a quoted string, or `text.length()` when there is
// none. It returns `.None` when a quoted string is still open at the end of
// `text`, which makes the whole value malformed.
fn separator_at(text: Str, from: UInt64, separator: UInt8) -> Option[UInt64] {
    var quoted = false
    var at = from
    while at < text.length() {
        let byte = text.byte(at).unwrap()
        if quoted {
            if byte == ascii_backslash {
                at += 1
            } else if byte == ascii_quote {
                quoted = false
            }
        } else if byte == ascii_quote {
            quoted = true
        } else if byte == separator {
            return .Some(at)
        }
        at += 1
    }
    if quoted {
        return .None
    }
    .Some(text.length())
}

// Determine whether the immediate reverse-proxy hop indicates HTTPS from RFC 7239 `Forwarded`.
// Inspects the last comma-separated element across all `Forwarded` header lines.
// Separators inside a quoted value belong to the value. A malformed value, or
// a hop naming `proto` twice with different values, reads as not HTTPS. A
// quoted `proto` value is compared as written, so one holding an escape never
// reads as `https`.
fn forwarded_proto_is_https(stored: Str, sink fields: mem.Slice[Field]) -> Option[Bool] {
    var last_element: Option[Str] = .None
    for field in fields {
        if stored_part(stored, field.name).equals_ascii_folded("Forwarded") {
            let val = stored_part(stored, field.value)
            var at: UInt64 = 0
            while at <= val.length() {
                let end = separator_at(val, at, ascii_comma) else {
                    return .Some(false)
                }
                let trimmed = val.slice(at, end).unwrap().trim_ascii()
                if trimmed.length() > 0 {
                    last_element = .Some(trimmed)
                }
                at = end + 1
            }
        }
    }
    let target_hop = last_element?
    var found_proto: Option[Str] = .None
    var at: UInt64 = 0
    while at <= target_hop.length() {
        let end = separator_at(target_hop, at, ascii_semicolon) else {
            return .Some(false)
        }
        let param = target_hop.slice(at, end).unwrap()
        at = end + 1
        let (name, raw_value) = param.split_once("=") else {
            continue
        }
        if !name.trim_ascii().equals_ascii_folded("proto") {
            continue
        }
        let value = raw_value.trim_ascii()
        let unquoted = if value.length() >= 2 && value.starts_with("\"") && value.ends_with("\"") {
            value.slice(1, value.length() - 1).unwrap()
        } else {
            value
        }
        match read found_proto {
            Some(earlier) => {
                if !earlier.equals_ascii_folded(unquoted) {
                    return .Some(false)
                }
            },
            None => found_proto = .Some(unquoted),
        }
    }
    let proto = found_proto?
    .Some(proto.equals_ascii_folded("https"))
}

// Determine whether the immediate reverse-proxy hop indicates HTTPS from `X-Forwarded-Proto`.
// Inspects the last comma-separated entry across all `X-Forwarded-Proto` header lines.
fn x_forwarded_proto_is_https(stored: Str, sink fields: mem.Slice[Field]) -> Option[Bool] {
    var last_proto: Option[Str] = .None
    for field in fields {
        if stored_part(stored, field.name).equals_ascii_folded("X-Forwarded-Proto") {
            let val = stored_part(stored, field.value)
            let parts = match val.split(",") {
                Ok(p) => p,
                Err(_) => return .Some(false),
            }
            for part in parts {
                let trimmed = part.trim_ascii()
                if trimmed.length() > 0 {
                    last_proto = .Some(trimmed)
                }
            }
        }
    }
    match last_proto {
        Some(proto) => .Some(proto.equals_ascii_folded("https")),
        None => .None,
    }
}

fn env_https_is_set() -> Option[Bool] {
    match env.variable("HTTPS") {
        Some(val) => {
            if val == "on" || val == "1" || val.equals_ascii_folded("true") {
                .Some(true)
            } else if val == "off" || val == "0" || val.equals_ascii_folded("false") {
                .Some(false)
            } else {
                .None
            }
        },
        None => .None,
    }
}

// A handler reads the request through this view. It views the text, decoded
// query for this exchange and, after body materialization, its payload,
// together with the path values its
// router matched, and it holds a handle to the exchange's arena. It is copied
// freely and holds nothing to release. What it views lives until the
// response has been written, so a handler may return views of it, and values
// built in its arena, in its response. It is a carrier: a handler taking it
// writes no `where carries(request)`, since its response lives as long as the
// request does.
@(opaque, copyable, carrier)
struct Request[P: Allocator = mem.SystemAllocator] {
    memory: mem.Handle[P],
    known_method: Method,
    is_http_11: Bool,
    head: Str,
    method_token: Span,
    target: Span,
    header_fields: mem.Slice[Field],
    query_text: Str,
    query_fields: Option[mem.Slice[Field]],
    payload: mem.Slice[UInt8],
    body_text: Str,
    body_fields: Option[mem.Slice[Field]],
    // `matched` holds the names and decoded values of the path values, and
    // `path_values` their ranges there; `path_values` is `None` until a router
    // matches the request.
    matched: Str,
    path_values: Option[mem.Slice[Field]],
    // `request_id` is the id `with_request_ids` gave the request. Only that
    // middleware sets it, so a client's header reaches it only when the
    // middleware kept it as well formed.
    request_id: Option[Str],
    // `deadline` is when the server stops reading the request, head and body.
    deadline: time.Deadline,
}

impl[P: Allocator] Request[P] {
    // `allocator` returns the exchange's arena. What a handler allocates here
    // lives until the response has been written and is then released with the
    // arena, so it is never released one value at a time.
    pub fn allocator(self: Self) -> mem.Handle[P] {
        copy(self.memory)
    }

    test "a request allocates in its arena" {
        defer let exchange = TestExchange.open(limits: Limits { request_arena_bytes = 4096, ..Limits.default() })
        defer var sent = exchange.request("GET", "/").unwrap()
        // The arena can hold 4088 bytes; the message already holds some.
        let fits = "x".to_owned_in(sent.request().allocator()).is_ok()
        let past = match sent.request().allocator().acquire(4096) {
            Ok(_) => false,
            Err(_) => true,
        }
        testing.assert(fits, "the arena refused one byte")?
        testing.assert(past, "the arena handed out more than it holds")?
        .Ok(())
    }

    // `deadline` returns when the server stops reading this request, head and
    // body: its read timeout after the request began to arrive, or `time.never`
    // for a request no server reads, such as one a test builds. A handler that
    // waits on something else for the request, such as another service, passes
    // it on, or the earlier of it and a deadline of its own, so the whole
    // exchange shares one budget.
    pub fn deadline(self: Self) -> time.Deadline {
        copy(self.deadline)
    }

    test "a request no server reads has no deadline" {
        defer let arena = mem.Arena.open(mem.system(), size: 4096)
        let sent = new_request(arena.handle(), "GET", "/", body: "").unwrap()
        testing.assert_eq(sent.request().deadline(), time.never, "a test request had a deadline")?
    }

    // `method` returns the request's method, or `Other` for a token `Method`
    // does not name.
    pub fn method(self: Self) -> Method {
        self.known_method
    }

    test "a request names its method" {
        defer let arena = mem.Arena.open(mem.system(), size: 4096)
        let request = read_in_steps(arena.handle(), "PATCH /x HTTP/1.1\r\nHost: b\r\n\r\n".as_bytes(), 16, Limits.default()).unwrap()
        let method = request.request().method()
        testing.assert_eq(method, Method.Patch, "the method changed")?
        let other = read_in_steps(arena.handle(), "BREW /pot HTTP/1.1\r\nHost: b\r\n\r\n".as_bytes(), 16, Limits.default()).unwrap()
        let unknown = other.request().method()
        testing.assert_eq(unknown, Method.Other, "an unknown method was named")?
        .Ok(())
    }

    // Return whether this request was made with HTTP/1.1 (otherwise HTTP/1.0).
    pub fn is_http_11(self: Self) -> Bool {
        self.is_http_11
    }

    // HTTP/1.0 and any Connection: close token end the connection.
    pub fn closes_connection(self: Self) -> Bool {
        if !self.is_http_11 {
            return true
        }
        for field in copy(self.header_fields) {
            if !stored_part(self.head, field.name).equals_ascii_folded("Connection") {
                continue
            }
            let value = stored_part(self.head, field.value)
            let parts = value.split(",") else |_| {
                continue
            }
            for part in parts {
                if part.trim_ascii().equals_ascii_folded("close") {
                    return true
                }
            }
        }
        false
    }

    // Return the request HTTP version string: "HTTP/1.1" or "HTTP/1.0".
    pub fn version(self: Self) -> Str {
        if self.is_http_11 {
            "HTTP/1.1"
        } else {
            "HTTP/1.0"
        }
    }

    // Return whether this request was made securely (HTTPS).
    //
    // By default (`ProxyTrust.None`), proxy headers and the environment are
    // untrusted, and direct transport is assumed cleartext.
    //
    // When proxy trust is explicitly configured:
    // - `ProxyTrust.XForwardedProto`: inspects the immediate reverse-proxy hop
    //   (the last comma-separated entry across all `X-Forwarded-Proto` header lines).
    // - `ProxyTrust.Forwarded`: inspects the immediate reverse-proxy hop (the last
    //   element across all RFC 7239 `Forwarded` header lines) for its `proto` parameter.
    //   Conflicting or non-HTTPS values evaluate to `false`.
    // - `ProxyTrust.All`: inspects `Forwarded`, `X-Forwarded-Proto`, and the
    //   process environment `HTTPS` variable. If any present signal is non-HTTPS,
    //   or if signals disagree, evaluates to `false`.
    pub fn is_https(self: Self, trust: ProxyTrust = .None) -> Bool {
        if trust == .None {
            return false
        }
        if trust == .Forwarded {
            return forwarded_proto_is_https(self.head, copy(self.header_fields)).unwrap_or(false)
        }
        if trust == .XForwardedProto {
            return x_forwarded_proto_is_https(self.head, copy(self.header_fields)).unwrap_or(false)
        }
        if trust == .All {
            let fwd = forwarded_proto_is_https(self.head, copy(self.header_fields))
            let xfp = x_forwarded_proto_is_https(self.head, copy(self.header_fields))
            let env_https = env_https_is_set()

            var saw_https = false
            match fwd {
                Some(is_secure) => {
                    if !is_secure {
                        return false
                    }
                    saw_https = true
                },
                None => {},
            }
            match xfp {
                Some(is_secure) => {
                    if !is_secure {
                        return false
                    }
                    saw_https = true
                },
                None => {},
            }
            match env_https {
                Some(is_secure) => {
                    if !is_secure {
                        return false
                    }
                    saw_https = true
                },
                None => {},
            }
            return saw_https
        }
        false
    }

    test "request is_https checks forwarded headers and env" {
        defer let exchange = TestExchange.open()

        // Untrusted by default: client-supplied headers do not make request HTTPS.
        defer var untrusted = exchange.request("GET", "/").unwrap()
        &untrusted.add_header("X-Forwarded-Proto", "https").unwrap()
        &untrusted.add_header("Forwarded", "proto=https").unwrap()
        testing.assert(!untrusted.request().is_https(), "untrusted proxy headers made request HTTPS by default")?
        testing.assert(!untrusted.request().is_https(trust: .None), "ProxyTrust.None trusted proxy headers")?

        // Multi-hop X-Forwarded-Proto: immediate proxy is the last comma-separated entry.
        defer var xfp_https = exchange.request("GET", "/").unwrap()
        &xfp_https.add_header("X-Forwarded-Proto", "http, https").unwrap()
        testing.assert(xfp_https.request().is_https(trust: .XForwardedProto), "immediate https hop in X-Forwarded-Proto was refused")?

        defer var xfp_http = exchange.request("GET", "/").unwrap()
        &xfp_http.add_header("X-Forwarded-Proto", "https, http").unwrap()
        testing.assert(!xfp_http.request().is_https(trust: .XForwardedProto), "immediate http hop was treated as https")?

        // Forwarded RFC 7239: immediate proxy is the last comma-separated element.
        defer var fwd_https = exchange.request("GET", "/").unwrap()
        &fwd_https.add_header("Forwarded", "for=1.2.3.4;proto=http, for=5.6.7.8;proto=\"HTTPS\"").unwrap()
        testing.assert(fwd_https.request().is_https(trust: .Forwarded), "immediate https hop in Forwarded was refused")?

        defer var fwd_http = exchange.request("GET", "/").unwrap()
        &fwd_http.add_header("Forwarded", "for=1.2.3.4;proto=https, for=5.6.7.8;proto=http").unwrap()
        testing.assert(!fwd_http.request().is_https(trust: .Forwarded), "earlier https hop overrode immediate http hop")?

        // Conflicting proto parameters in same hop are refused.
        defer var fwd_conflict = exchange.request("GET", "/").unwrap()
        &fwd_conflict.add_header("Forwarded", "for=1.2.3.4;proto=http;proto=https").unwrap()
        testing.assert(!fwd_conflict.request().is_https(trust: .Forwarded), "conflicting proto parameters were accepted")?

        // Multi-line X-Forwarded-Proto: immediate proxy is the last occurrence across lines.
        defer var xfp_multiline = exchange.request("GET", "/").unwrap()
        &xfp_multiline.add_header("X-Forwarded-Proto", "https").unwrap()
        &xfp_multiline.add_header("X-Forwarded-Proto", "http").unwrap()
        testing.assert(!xfp_multiline.request().is_https(trust: .XForwardedProto), "multi-line X-Forwarded-Proto used first line instead of last")?

        // Multi-line Forwarded: immediate proxy is the last element across lines.
        defer var fwd_multiline = exchange.request("GET", "/").unwrap()
        &fwd_multiline.add_header("Forwarded", "proto=https").unwrap()
        &fwd_multiline.add_header("Forwarded", "for=proxy;proto=http").unwrap()
        testing.assert(!fwd_multiline.request().is_https(trust: .Forwarded), "multi-line Forwarded used first line instead of last")?

        // ProxyTrust.All refuses conflicting proxy headers.
        defer var conflicting = exchange.request("GET", "/").unwrap()
        &conflicting.add_header("Forwarded", "proto=https").unwrap()
        &conflicting.add_header("X-Forwarded-Proto", "http").unwrap()
        testing.assert(!conflicting.request().is_https(trust: .All), "ProxyTrust.All accepted conflicting Forwarded and X-Forwarded-Proto")?

        // Mismatched trust policy ignores other headers.
        testing.assert(!xfp_https.request().is_https(trust: .Forwarded), "Forwarded trust policy accepted X-Forwarded-Proto")?
        testing.assert(!fwd_https.request().is_https(trust: .XForwardedProto), "XForwardedProto trust policy accepted Forwarded")?
        .Ok(())
    }

    test "request is_https reads a quoted Forwarded value whole" {
        defer let exchange = TestExchange.open()

        // A `;` inside a quoted value does not start a parameter.
        defer var semicolon = exchange.request("GET", "/").unwrap()
        &semicolon.add_header("Forwarded", "for=\"a;proto=https;b\"").unwrap()
        testing.assert(!semicolon.request().is_https(trust: .Forwarded), "a proto inside a quoted value was read")?

        // A `,` inside a quoted value does not start an element.
        defer var comma = exchange.request("GET", "/").unwrap()
        &comma.add_header("Forwarded", "for=1;proto=http, for=\"x,proto=https;y\"").unwrap()
        testing.assert(!comma.request().is_https(trust: .Forwarded), "a quoted comma split the immediate hop")?

        // A quoted value holding both separators still ends at its closing quote.
        defer var whole = exchange.request("GET", "/").unwrap()
        &whole.add_header("Forwarded", "for=1;proto=http, for=\"[2001:db8::1]:4711;a,b\";proto=https").unwrap()
        testing.assert(whole.request().is_https(trust: .Forwarded), "a proto after a quoted value was refused")?

        // An escaped quote does not end a quoted value.
        defer var escaped = exchange.request("GET", "/").unwrap()
        &escaped.add_header("Forwarded", "for=\"a\\\";proto=https\"").unwrap()
        testing.assert(!escaped.request().is_https(trust: .Forwarded), "an escaped quote ended the quoted value")?

        // An unterminated quoted value is malformed and makes no claim.
        defer var open_quote = exchange.request("GET", "/").unwrap()
        &open_quote.add_header("Forwarded", "proto=https;for=\"a").unwrap()
        testing.assert(!open_quote.request().is_https(trust: .Forwarded), "an unterminated quoted value was accepted")?

        // A parameter named only like `proto` is not `proto`.
        defer var other_name = exchange.request("GET", "/").unwrap()
        &other_name.add_header("Forwarded", "xproto=https").unwrap()
        testing.assert(!other_name.request().is_https(trust: .Forwarded), "a longer parameter name was read as proto")?
        .Ok(())
    }

    // `method_text` returns the method token exactly as the client sent it.
    pub fn method_text(self: Self) -> Str where carries(self) {
        stored_part(self.head, self.method_token)
    }

    test "a request keeps its method token as sent" {
        defer let arena = mem.Arena.open(mem.system(), size: 4096)
        let sent = read_in_steps(arena.handle(), "BREW /pot HTTP/1.1\r\nHost: b\r\n\r\n".as_bytes(), 16, Limits.default()).unwrap()
        testing.assert_eq(sent.request().method_text(), "BREW", "the method token changed")?
        .Ok(())
    }

    // `path` returns the target up to its `?`, not percent-decoded.
    pub fn path(self: Self) -> Str where carries(self) {
        let target = stored_part(self.head, self.target)
        let (path, _) = target.split_once("?") else {
            (target, "")
        }
        path
    }

    test "a path ends at the query" {
        defer let arena = mem.Arena.open(mem.system(), size: 4096)
        let sent = read_in_steps(arena.handle(), "GET /a/b%20c?x=1 HTTP/1.1\r\nHost: b\r\n\r\n".as_bytes(), 16, Limits.default()).unwrap()
        testing.assert_eq(sent.request().path(), "/a/b%20c", "the path changed")?
        let bare = read_in_steps(arena.handle(), "GET /a/b HTTP/1.1\r\nHost: b\r\n\r\n".as_bytes(), 16, Limits.default()).unwrap()
        testing.assert_eq(bare.request().path(), "/a/b", "a path without a query changed")?
        .Ok(())
    }

    // `query` returns the target after its first `?`, not percent-decoded.
    pub fn query(self: Self) -> Option[Str] where carries(.Some: self) {
        let target = stored_part(self.head, self.target)
        let (_, query) = target.split_once("?")?
        .Some(query)
    }

    test "a query follows the first question mark" {
        defer let arena = mem.Arena.open(mem.system(), size: 4096)
        let sent = read_in_steps(arena.handle(), "GET /a?x=1?y HTTP/1.1\r\nHost: b\r\n\r\n".as_bytes(), 16, Limits.default()).unwrap()
        testing.assert_eq(sent.request().query(), Option.Some("x=1?y"), "the query changed")?
        let empty = read_in_steps(arena.handle(), "GET /a? HTTP/1.1\r\nHost: b\r\n\r\n".as_bytes(), 16, Limits.default()).unwrap()
        testing.assert_eq(empty.request().query(), Option.Some(""), "an empty query was absent")?
        let none = read_in_steps(arena.handle(), "GET /a HTTP/1.1\r\nHost: b\r\n\r\n".as_bytes(), 16, Limits.default()).unwrap()
        testing.assert_eq(none.request().query(), .None, "a target without a query had one")?
        .Ok(())
    }

    // `header` returns the first value of the header `name`, compared under ASCII
    // case folding. The scan is bounded by the request's header count, which the
    // parser holds to `Limits.max_headers`.
    pub fn header(self: Self, name: Str) -> Option[Str] where carries(.Some: self) {
        header_value(self.head, self.header_fields, name)
    }

    test "a header is found by its folded name" {
        defer let arena = mem.Arena.open(mem.system(), size: 4096)
        let input = "GET / HTTP/1.1\r\nHost: b\r\nAccept: text/plain\r\naccept: text/html\r\nX-Empty:\r\n\r\n"
        let sent = read_in_steps(arena.handle(), input.as_bytes(), 16, Limits.default()).unwrap()
        let request = sent.request()
        testing.assert_eq(request.header("ACCEPT"), Option.Some("text/plain"), "the first value was not found")?
        testing.assert_eq(request.header("x-empty"), Option.Some(""), "an empty value was absent")?
        testing.assert_eq(request.header("Accept-Language"), .None, "an absent header was found")?
        .Ok(())
    }

    // `headers` walks the request's headers in the order they arrived.
    pub fn headers(self: Self) -> Headers where carries(self) {
        .{ stored = copy(self.head), fields = copy(self.header_fields), index = 0 }
    }

    test "headers walk in arrival order" {
        defer let arena = mem.Arena.open(mem.system(), size: 4096)
        let input = "GET / HTTP/1.1\r\nHost:  example.com \r\nAccept: */*\r\nAccept: text/plain\r\n\r\n"
        let sent = read_in_steps(arena.handle(), input.as_bytes(), 16, Limits.default()).unwrap()
        var walk = sent.request().headers()
        let first = &walk.next()
        let second = &walk.next()
        let third = &walk.next()
        let fourth = &walk.next()
        testing.assert_eq(first, Option.Some(Header { name = "Host", value = "example.com" }), "the first header changed")?
        testing.assert_eq(second, Option.Some(Header { name = "Accept", value = "*/*" }), "the second header changed")?
        testing.assert_eq(third, Option.Some(Header { name = "Accept", value = "text/plain" }), "the third header changed")?
        testing.assert_eq(fourth, .None, "the walk continued past the last header")?
        .Ok(())
    }

    // Return the bytes of a request read whole, as a CGI request is, or of a
    // materialized one; a served request's are empty until its body is
    // materialized. Raw serving
    // handlers read their explicit RequestBody, or materialize it first.
    pub fn body(self: Self) -> mem.Slice[UInt8] where carries(self) {
        copy(self.payload)
    }

    test "a body holds exactly its length" {
        defer let arena = mem.Arena.open(mem.system(), size: 4096)
        let input = "POST / HTTP/1.1\r\nHost: loopback\r\nContent-Length: 3\r\n\r\nabcdef"
        let source = Fragments { bytes = input.as_bytes(), position = 0, step = 4, failure = .None }
        var reader = io.BufferedReader.open_in(arena.handle(), capacity: 16, reader: source).unwrap()
        let sent = read_request(&reader, arena.handle(), Limits.default()).unwrap()
        let rest = &reader.read_exact_in(allocator: arena.handle(), count: 3, max_bytes: 3).unwrap()
        let ended = match &reader.read_raw_line_borrowed(1) {
            Ok(line) => line.is_none(),
            Err(_) => false,
        }
        let _source = reader.abandon()
        testing.assert_ok_eq(sent.request().text(), "abc", "the body changed")?
        testing.assert_ok_eq(Str.from_bytes(rest.as_slice()), "def", "the bytes after the body left the reader")?
        testing.assert(ended, "the reader held more than the bytes after the body")?
        .Ok(())
    }

    // `text` returns the body as text, or the offset of its first byte that
    // does not begin valid UTF-8.
    pub fn text(self: Self) -> Result[Str, strings.Utf8Error] where carries(.Ok: self) {
        Str.from_bytes(self.payload)
    }

    test "a body is text only when it is utf8" {
        defer let arena = mem.Arena.open(mem.system(), size: 4096)
        let whole = read_in_steps(arena.handle(), "POST / HTTP/1.1\r\nHost: b\r\nContent-Length: 3\r\n\r\nhé".as_bytes(), 16, Limits.default()).unwrap()
        testing.assert_ok_eq(whole.request().text(), "hé", "UTF-8 text changed")?
        // Two bytes end inside `é`, so the scalar starting at byte 1 is incomplete.
        let cut = read_in_steps(arena.handle(), "POST / HTTP/1.1\r\nHost: b\r\nContent-Length: 2\r\n\r\nhé".as_bytes(), 16, Limits.default()).unwrap()
        let invalid_at: Option[UInt64] = match cut.request().text() {
            Ok(_) => .None,
            Err(error) => .Some(error.offset),
        }
        testing.assert_eq(invalid_at, .Some(1), "an incomplete scalar was text")?
        .Ok(())
    }

    // `routed` returns this request with the path values a router matched, whose
    // ranges `fields` gives in `matched`.
    fn routed(self: Self, matched: Str, fields: mem.Slice[Field]) -> Request[P] where carries(self, matched, fields) {
        Self { matched = copy(matched), path_values = .Some(copy(fields)), ..copy(self) }
    }

    // `path_value` returns the value the router matched for `{name}`, already
    // percent-decoded.
    pub fn path_value(self: Self, name: Str) -> Option[Str] where carries(.Some: self) {
        let fields = copy(self.path_values) else {
            return .None
        }
        for field in fields {
            if stored_part(self.matched, field.name) == name {
                return .Some(stored_part(self.matched, field.value))
            }
        }
        .None
    }

    test "a path_value is found by its exact name" {
        defer let exchange = TestExchange.open()
        defer var sent = exchange.request("GET", "/items/42").unwrap()
        var matched = String.new_in(sent.request().allocator())
        let id_name = store_part(&matched, "id").unwrap()
        let id_value = store_part(&matched, "42").unwrap()
        let rest_name = store_part(&matched, "rest").unwrap()
        let rest_value = store_part(&matched, "a b").unwrap()
        let id = Field { name = id_name, value = id_value }
        let rest = Field { name = rest_name, value = rest_value }
        let fields = [id, rest]
        let request = sent.request().routed(matched.view(), fields.as_slice())
        testing.assert_eq(request.path_value("id"), Option.Some("42"), "the value changed")?
        testing.assert_eq(request.path_value("rest"), Option.Some("a b"), "the second value changed")?
        testing.assert_eq(request.path_value("ID"), .None, "a path value matched a folded name")?
        testing.assert_eq(request.method_text(), "GET", "routing disturbed the method")?
        .Ok(())
    }

    // `path_params` returns the path values the router matched, which
    // `http.Params` reads a struct from, or `None` when no router matched the
    // request.
    pub fn path_params(self: Self) -> Option[ParamValues] where carries(.Some: self) {
        match copy(self.path_values) {
            Some(fields) => .Some(.{ stored = copy(self.matched), fields }),
            None => .None,
        }
    }

    test "a request gives its path_params once a router matched it" {
        defer let exchange = TestExchange.open()
        defer var sent = exchange.request("GET", "/items/42").unwrap()
        var matched = String.new_in(sent.request().allocator())
        let id_name = store_part(&matched, "id").unwrap()
        let id_value = store_part(&matched, "42").unwrap()
        let fields = [Field { name = id_name, value = id_value }]
        let routed = sent.request().routed(matched.view(), fields.as_slice())
        testing.assert_eq(sent.request().path_params().is_none(), true, "an unrouted request had path values")?
        testing.assert_eq(routed.path_params().unwrap().get("id"), .Ok(.Some("42")), "the path value was lost")?
        .Ok(())
    }

    // `query_params` returns the query's names and values, decoded as an HTML
    // form encodes them, or `None` when the query is not percent-encoded
    // UTF-8.
    pub fn query_params(self: Self) -> Option[ParamValues] where carries(.Some: self) {
        match copy(self.query_fields) {
            Some(fields) => .Some(.{ stored = copy(self.query_text), fields }),
            None => .None,
        }
    }

    test "a request gives its query_params decoded" {
        defer let exchange = TestExchange.open()
        defer var sent = exchange.request("GET", "/items?sort=new+first").unwrap()
        defer var broken = exchange.request("GET", "/items?sort=%zz").unwrap()
        testing.assert_eq(sent.request().query_params().unwrap().get("sort"), .Ok(.Some("new first")), "the query was not decoded")?
        testing.assert_eq(broken.request().query_params().is_none(), true, "a broken query had values")?
        .Ok(())
    }

    // `form_params` returns the body's names and values, decoded as an HTML
    // form encodes them, or `None` when the body is not percent-encoded UTF-8.
    // It is also `None` when `Content-Type` does not name
    // `application/x-www-form-urlencoded`, so a body of another type is
    // never read as pairs; `http.Form[T]` answers that mistake with 415
    // before asking for these. A program builds its own body extractor the
    // same way `http.Form` does: `request.header("Content-Type")` for the
    // 415 check and this for the pairs, since `http.Params` reads a struct
    // from either one.
    pub fn form_params(self: Self) -> Option[ParamValues] where carries(.Some: self) {
        match copy(self.body_fields) {
            Some(fields) => .Some(.{ stored = copy(self.body_text), fields }),
            None => .None,
        }
    }

    test "a request gives its form_params only when the body is one" {
        defer let exchange = TestExchange.open()
        defer var sent = exchange.request("POST", "/signup", body: "name=Ada+L%C3%B3pez&age=30", content_type: "application/x-www-form-urlencoded").unwrap()
        defer var untyped = exchange.request("POST", "/signup", body: "name=Ada").unwrap()
        defer var json = exchange.request("POST", "/signup", body: r#"{"name":"Ada"}"#, content_type: "application/json").unwrap()
        defer var broken = exchange.request("POST", "/signup", body: "name=%zz", content_type: "application/x-www-form-urlencoded").unwrap()
        // A served request reads its body once the handler materializes it.
        testing.assert_eq(sent.request().form_params().is_none(), true, "a body was read before it was materialized")?
        let form = &sent.body.materialize(sent.message.request()).unwrap()
        let plain = &untyped.body.materialize(untyped.message.request()).unwrap()
        let object = &json.body.materialize(json.message.request()).unwrap()
        let garbled = &broken.body.materialize(broken.message.request()).unwrap()
        testing.assert_eq(form.form_params().unwrap().get("name"), .Ok(.Some("Ada López")), "the form was not decoded")?
        testing.assert_eq(plain.form_params().is_none(), true, "a body sent without a type was read as a form")?
        testing.assert_eq(object.form_params().is_none(), true, "a JSON body was read as a form")?
        testing.assert_eq(garbled.form_params().is_none(), true, "a broken form body had values")?
        .Ok(())
    }

    // `origin` parses the request's `Host` header as an `Origin` with the
    // given scheme.
    pub fn origin(self: Self, is_https: Bool) -> Result[Origin, OriginError] where carries(.Ok: self) {
        let host = self.header("Host") else {
            return .Err(.InvalidAuthority)
        }
        Origin.from_authority(host.trim_ascii(), is_https)
    }

    test "a request gives its origin from the host header" {
        defer let exchange = TestExchange.open()
        defer var req = exchange.request("GET", "/").unwrap()
        &req.add_header("Host", "example.test:8080").unwrap()
        let origin = req.request().origin(false).unwrap()
        testing.assert_eq(origin.is_https, false, "scheme changed")?
        testing.assert_eq(origin.host, "example.test", "host changed")?
        testing.assert_eq(origin.port, UInt16(8080), "port changed")?

        defer var no_host = exchange.request("GET", "/").unwrap()
        testing.assert_eq(no_host.request().origin(false), .Err(OriginError.InvalidAuthority), "missing host header succeeded")?
        .Ok(())
    }
}

test "every connection header can request close" {
    defer let exchange = TestExchange.open()
    defer var message = exchange.request("GET", "/").unwrap()
    &message.add_header("Connection", "keep-alive").unwrap()
    &message.add_header("connection", "upgrade, CLOSE").unwrap()
    testing.assert(message.request().closes_connection(), "a later close token was ignored")
}
