// `Early` reads `Mirror.Item` before `Tray` is declared. `Tray` holds the
// linear `Ticket`, so `Chooser[Tray]` does not implement `Pick`, and neither
// `Pick.Out` nor `take` is available for it.
trait Counter {
    type Item
}

trait Pick {
    type Out

    fn take(sink self: Self) -> UInt8
}

struct Early {
    x: Mirror.Item,
}

@linear
struct Ticket {
    number: UInt8,
}

struct Desk {}

impl Counter for Desk {
    type Item = Ticket
}

struct Tray {
    held: Desk.Item,
}

struct Chooser[T] {
    t: T,
}

impl[T: Discardable] Pick for Chooser[T] {
    type Out = UInt8

    fn take(sink self: Chooser[T]) -> UInt8 {
        let _gone = self
        4
    }
}

struct Mirror {}

impl Counter for Mirror {
    type Item = Chooser[Tray].Out
}

fn main() -> UInt8 {
    let early = Early { x = 4 }
    let chooser = Chooser[Tray] { t = Tray { held = Ticket { number = 9 } } }
    early.x + chooser.take()
}
