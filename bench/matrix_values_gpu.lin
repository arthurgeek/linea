// Compare small fixed numerical values inside ordinary GPU map functions.
// Wall times include output allocation, pipeline creation, waiting and release.
import std.bench
import std.env
import std.gpu
import std.io
import std.mem
import std.num
import std.tensor
import std.testing

test "component verification rejects missing extra and reordered answers" {
    let empty: [Float32; 0] = []
    testing.assert(!components_match(empty.as_slice(), 4, 0), "empty output passed a nonempty component check")?
    testing.assert(!components_match([Float32(30), 70.0, 110.0].as_slice(), 4, 0), "truncated output passed a component check")?
    testing.assert(components_match([Float32(30), 70.0, 110.0, 150.0].as_slice(), 4, 0), "complete component answers were refused")?
    testing.assert(!components_match([Float32(30), 70.0, 110.0, 150.0, 0.0].as_slice(), 4, 0), "extra component output was ignored")?
    testing.assert(!components_match([Float32(70), 30.0, 110.0, 150.0].as_slice(), 4, 0), "a checksum-preserving permutation passed")?
}

test "map verification requires exactly one answer for every input" {
    let values = [Float32(0), 1.0]
    let empty: [Float32; 0] = []
    testing.assert(!mapped_answers_match(values.as_slice(), [Float32(360), 400.0, 440.0].as_slice(), matvec_row), "extra mapped output was ignored")?
    testing.assert(!mapped_answers_match(values.as_slice(), empty.as_slice(), matvec_row), "empty mapped output passed")?
    testing.assert(!mapped_answers_match(values.as_slice(), [Float32(360)].as_slice(), matvec_row), "truncated mapped output passed")?
    testing.assert(mapped_answers_match(values.as_slice(), [Float32(360), 400.0].as_slice(), matvec_row), "complete mapped output was refused")?
}

test "matrix reference retains independent contraction and cancellation known answers" {
    // These literals distinguish reverse-k accumulation and FMA contraction.
    testing.assert_eq(reference(2, 0, Float32.from_bits(1036831949)).to_bits(), UInt32(1119527895), "matrix contraction order changed")?
    testing.assert_eq(reference(2, 1, Float32.from_bits(1036831949)).to_bits(), UInt32(1120891044), "matrix multiply and add were contracted")?
    testing.assert_eq(reference(2, 0, Float32.from_bits(3238107546)).to_bits(), UInt32(3258470892), "cancellation order changed")?
}

@derive(Display, Release, From[gpu.GpuError], From[io.IoError], From[mem.Oom])
enum BenchError {
    Gpu(gpu.GpuError),
    Output(io.IoError),
    Allocation(mem.Oom),
    Mismatch,
}

fn rows(value: Float32) -> [[Float32; 4]; 4] {
    [
        [value + 1.0, value + 2.0, value + 3.0, value + 4.0],
        [value + 5.0, value + 6.0, value + 7.0, value + 8.0],
        [value + 9.0, value + 10.0, value + 11.0, value + 12.0],
        [value + 13.0, value + 14.0, value + 15.0, value + 16.0],
    ]
}

fn columns(value: Float32) -> [[Float32; 4]; 4] {
    [
        [value + 1.0, value + 5.0, value + 9.0, value + 13.0],
        [value + 2.0, value + 6.0, value + 10.0, value + 14.0],
        [value + 3.0, value + 7.0, value + 11.0, value + 15.0],
        [value + 4.0, value + 8.0, value + 12.0, value + 16.0],
    ]
}

fn sum4(values: [Float32; 4]) -> Float32 {
    (((0.0 + values.x) + values.y) + values.z) + values.w
}

fn dot4(left: [Float32; 4], right: [Float32; 4]) -> Float32 {
    sum4(left * right)
}

fn checksum_rows(values: [[Float32; 4]; 4]) -> Float32 {
    sum4([sum4(values[0]), sum4(values[1]), sum4(values[2]), sum4(values[3])])
}

fn checksum_columns(values: [[Float32; 4]; 4]) -> Float32 {
    sum4([
        sum4([values[0][0], values[1][0], values[2][0], values[3][0]]),
        sum4([values[0][1], values[1][1], values[2][1], values[3][1]]),
        sum4([values[0][2], values[1][2], values[2][2], values[3][2]]),
        sum4([values[0][3], values[1][3], values[2][3], values[3][3]]),
    ])
}

fn matvec_row_values(value: Float32) -> [Float32; 4] {
    let a = rows(value)
    let v: [Float32; 4] = [1.0, 2.0, 3.0, 4.0]
    [dot4(a[0], v), dot4(a[1], v), dot4(a[2], v), dot4(a[3], v)]
}

fn matvec_row(value: Float32) -> Float32 {
    sum4(matvec_row_values(value))
}

fn matvec_row_component(packed: Float32) -> Float32 {
    lane(matvec_row_values(component_input(packed)), packed)
}

fn matvec_column_values(value: Float32) -> [Float32; 4] {
    let a = columns(value)
    var result: [Float32; 4] = [0.0, 0.0, 0.0, 0.0]
    result += a[0] * 1.0
    result += a[1] * 2.0
    result += a[2] * 3.0
    result += a[3] * 4.0
    result
}

fn matvec_column(value: Float32) -> Float32 {
    sum4(matvec_column_values(value))
}

fn matvec_column_component(packed: Float32) -> Float32 {
    lane(matvec_column_values(component_input(packed)), packed)
}

fn matvec_operator_values(value: Float32) -> [Float32; 4] {
    num.matrix(rows(value)) * [1.0, 2.0, 3.0, 4.0]
}

fn matvec_operator(value: Float32) -> Float32 {
    sum4(matvec_operator_values(value))
}

fn matvec_operator_component(packed: Float32) -> Float32 {
    lane(matvec_operator_values(component_input(packed)), packed)
}

fn vecmat_row_values(value: Float32) -> [Float32; 4] {
    let a = rows(value)
    var result: [Float32; 4] = [0.0, 0.0, 0.0, 0.0]
    result += a[0] * 1.0
    result += a[1] * 2.0
    result += a[2] * 3.0
    result += a[3] * 4.0
    result
}

fn vecmat_row(value: Float32) -> Float32 {
    sum4(vecmat_row_values(value))
}

fn vecmat_row_component(packed: Float32) -> Float32 {
    lane(vecmat_row_values(component_input(packed)), packed)
}

fn vecmat_column_values(value: Float32) -> [Float32; 4] {
    let a = columns(value)
    let v: [Float32; 4] = [1.0, 2.0, 3.0, 4.0]
    [dot4(v, a[0]), dot4(v, a[1]), dot4(v, a[2]), dot4(v, a[3])]
}

fn vecmat_column(value: Float32) -> Float32 {
    sum4(vecmat_column_values(value))
}

fn vecmat_column_component(packed: Float32) -> Float32 {
    lane(vecmat_column_values(component_input(packed)), packed)
}

fn vecmat_operator_values(value: Float32) -> [Float32; 4] {
    [Float32(1.0), 2.0, 3.0, 4.0] * num.matrix(rows(value))
}

fn vecmat_operator(value: Float32) -> Float32 {
    sum4(vecmat_operator_values(value))
}

fn vecmat_operator_component(packed: Float32) -> Float32 {
    lane(vecmat_operator_values(component_input(packed)), packed)
}

fn matmul_row_values(value: Float32) -> [[Float32; 4]; 4] {
    let a = rows(value)
    let b = rows(value * 0.5)
    [
        [dot4(a[0], [b[0][0], b[1][0], b[2][0], b[3][0]]), dot4(a[0], [b[0][1], b[1][1], b[2][1], b[3][1]]), dot4(a[0], [b[0][2], b[1][2], b[2][2], b[3][2]]), dot4(a[0], [b[0][3], b[1][3], b[2][3], b[3][3]])],
        [dot4(a[1], [b[0][0], b[1][0], b[2][0], b[3][0]]), dot4(a[1], [b[0][1], b[1][1], b[2][1], b[3][1]]), dot4(a[1], [b[0][2], b[1][2], b[2][2], b[3][2]]), dot4(a[1], [b[0][3], b[1][3], b[2][3], b[3][3]])],
        [dot4(a[2], [b[0][0], b[1][0], b[2][0], b[3][0]]), dot4(a[2], [b[0][1], b[1][1], b[2][1], b[3][1]]), dot4(a[2], [b[0][2], b[1][2], b[2][2], b[3][2]]), dot4(a[2], [b[0][3], b[1][3], b[2][3], b[3][3]])],
        [dot4(a[3], [b[0][0], b[1][0], b[2][0], b[3][0]]), dot4(a[3], [b[0][1], b[1][1], b[2][1], b[3][1]]), dot4(a[3], [b[0][2], b[1][2], b[2][2], b[3][2]]), dot4(a[3], [b[0][3], b[1][3], b[2][3], b[3][3]])],
    ]
}

fn matmul_row(value: Float32) -> Float32 {
    checksum_rows(matmul_row_values(value))
}

fn matmul_row_component(packed: Float32) -> Float32 {
    row_cell(matmul_row_values(component_input(packed)), packed)
}

fn matmul_column_values(value: Float32) -> [[Float32; 4]; 4] {
    let a = columns(value)
    let b = columns(value * 0.5)
    [
        [dot4([a[0][0], a[1][0], a[2][0], a[3][0]], b[0]), dot4([a[0][1], a[1][1], a[2][1], a[3][1]], b[0]), dot4([a[0][2], a[1][2], a[2][2], a[3][2]], b[0]), dot4([a[0][3], a[1][3], a[2][3], a[3][3]], b[0])],
        [dot4([a[0][0], a[1][0], a[2][0], a[3][0]], b[1]), dot4([a[0][1], a[1][1], a[2][1], a[3][1]], b[1]), dot4([a[0][2], a[1][2], a[2][2], a[3][2]], b[1]), dot4([a[0][3], a[1][3], a[2][3], a[3][3]], b[1])],
        [dot4([a[0][0], a[1][0], a[2][0], a[3][0]], b[2]), dot4([a[0][1], a[1][1], a[2][1], a[3][1]], b[2]), dot4([a[0][2], a[1][2], a[2][2], a[3][2]], b[2]), dot4([a[0][3], a[1][3], a[2][3], a[3][3]], b[2])],
        [dot4([a[0][0], a[1][0], a[2][0], a[3][0]], b[3]), dot4([a[0][1], a[1][1], a[2][1], a[3][1]], b[3]), dot4([a[0][2], a[1][2], a[2][2], a[3][2]], b[3]), dot4([a[0][3], a[1][3], a[2][3], a[3][3]], b[3])],
    ]
}

fn matmul_column(value: Float32) -> Float32 {
    checksum_columns(matmul_column_values(value))
}

fn matmul_column_component(packed: Float32) -> Float32 {
    column_cell(matmul_column_values(component_input(packed)), packed)
}

fn matmul_operator_values(value: Float32) -> [[Float32; 4]; 4] {
    let product = num.matrix(rows(value)) * num.matrix(rows(value * 0.5))
    [
        [product[0, 0], product[0, 1], product[0, 2], product[0, 3]],
        [product[1, 0], product[1, 1], product[1, 2], product[1, 3]],
        [product[2, 0], product[2, 1], product[2, 2], product[2, 3]],
        [product[3, 0], product[3, 1], product[3, 2], product[3, 3]],
    ]
}

fn matmul_operator(value: Float32) -> Float32 {
    checksum_rows(matmul_operator_values(value))
}

fn matmul_operator_component(packed: Float32) -> Float32 {
    row_cell(matmul_operator_values(component_input(packed)), packed)
}

fn elementwise_row_values(value: Float32) -> [[Float32; 4]; 4] {
    let a = rows(value)
    [a[0] * 0.5, a[1] * 0.5, a[2] * 0.5, a[3] * 0.5]
}

fn elementwise_row(value: Float32) -> Float32 {
    checksum_rows(elementwise_row_values(value))
}

fn elementwise_row_component(packed: Float32) -> Float32 {
    row_cell(elementwise_row_values(component_input(packed)), packed)
}

fn elementwise_column_values(value: Float32) -> [[Float32; 4]; 4] {
    let a = columns(value)
    [a[0] * 0.5, a[1] * 0.5, a[2] * 0.5, a[3] * 0.5]
}

fn elementwise_column(value: Float32) -> Float32 {
    checksum_columns(elementwise_column_values(value))
}

fn elementwise_column_component(packed: Float32) -> Float32 {
    column_cell(elementwise_column_values(component_input(packed)), packed)
}

fn elementwise_operator_values(value: Float32) -> [[Float32; 4]; 4] {
    let product = num.matrix(rows(value)) * 0.5
    [
        [product[0, 0], product[0, 1], product[0, 2], product[0, 3]],
        [product[1, 0], product[1, 1], product[1, 2], product[1, 3]],
        [product[2, 0], product[2, 1], product[2, 2], product[2, 3]],
        [product[3, 0], product[3, 1], product[3, 2], product[3, 3]],
    ]
}

fn elementwise_operator(value: Float32) -> Float32 {
    checksum_rows(elementwise_operator_values(value))
}

fn elementwise_operator_component(packed: Float32) -> Float32 {
    row_cell(elementwise_operator_values(component_input(packed)), packed)
}

// A separate validation corpus; timed rows/columns and performance seeds do
// not use these inputs. The host oracle indexes a fixed raw-bit table.
fn validation_word(index: UInt64) -> UInt32 {
    let words: [UInt32; 23] = [0, 2147483648, 1, 2147483649, 8388607, 2155872255, 8388608, 2155872256, 1051372203, 3198855851, 1036831949, 3238107546, 1065353217, 3212836865, 1621981420, 3769465068, 2139095039, 4286578687, 2139095040, 4286578688, 2139095041, 4286578689, 2143363909]
    words[index]
}

fn matvec_row_diverse_component(value: Float32, selected: Float32) -> Float32 {
    lane(matvec_row_values(value), selected)
}

fn matvec_column_diverse_component(value: Float32, selected: Float32) -> Float32 {
    lane(matvec_column_values(value), selected)
}

fn matvec_operator_diverse_component(value: Float32, selected: Float32) -> Float32 {
    lane(matvec_operator_values(value), selected)
}

fn vecmat_row_diverse_component(value: Float32, selected: Float32) -> Float32 {
    lane(vecmat_row_values(value), selected)
}

fn vecmat_column_diverse_component(value: Float32, selected: Float32) -> Float32 {
    lane(vecmat_column_values(value), selected)
}

fn vecmat_operator_diverse_component(value: Float32, selected: Float32) -> Float32 {
    lane(vecmat_operator_values(value), selected)
}

fn matmul_row_diverse_component(value: Float32, selected: Float32) -> Float32 {
    row_cell(matmul_row_values(value), selected)
}

fn matmul_column_diverse_component(value: Float32, selected: Float32) -> Float32 {
    column_cell(matmul_column_values(value), selected)
}

fn matmul_operator_diverse_component(value: Float32, selected: Float32) -> Float32 {
    row_cell(matmul_operator_values(value), selected)
}

fn elementwise_row_diverse_component(value: Float32, selected: Float32) -> Float32 {
    row_cell(elementwise_row_values(value), selected)
}

fn elementwise_column_diverse_component(value: Float32, selected: Float32) -> Float32 {
    column_cell(elementwise_column_values(value), selected)
}

fn elementwise_operator_diverse_component(value: Float32, selected: Float32) -> Float32 {
    row_cell(elementwise_operator_values(value), selected)
}

fn validation_input_bits(value: Float32, _selected: Float32) -> Float32 {
    value
}

// The integral part selects a component and the fractional part encodes
// the input. Every encoded value is exact in Float32. Static lane reads
// allow the device to expose components without a float-to-index cast.
fn component_input(packed: Float32) -> Float32 {
    let a = if packed >= 8.0 {
        packed - 8.0
    } else {
        packed
    }
    let b = if a >= 4.0 {
        a - 4.0
    } else {
        a
    }
    let c = if b >= 2.0 {
        b - 2.0
    } else {
        b
    }
    (if c >= 1.0 {
        c - 1.0
    } else {
        c
    }) * 2.0
}

fn lane(values: [Float32; 4], selected: Float32) -> Float32 {
    if selected < 1.0 {
        values.x
    } else if selected < 2.0 {
        values.y
    } else if selected < 3.0 {
        values.z
    } else {
        values.w
    }
}

fn row_cell(values: [[Float32; 4]; 4], selected: Float32) -> Float32 {
    if selected < 4.0 {
        lane(values[0], selected)
    } else if selected < 8.0 {
        lane(values[1], selected - 4.0)
    } else if selected < 12.0 {
        lane(values[2], selected - 8.0)
    } else {
        lane(values[3], selected - 12.0)
    }
}

fn column_cell(values: [[Float32; 4]; 4], selected: Float32) -> Float32 {
    row_cell([
        [values[0][0], values[1][0], values[2][0], values[3][0]],
        [values[0][1], values[1][1], values[2][1], values[3][1]],
        [values[0][2], values[1][2], values[2][2], values[3][2]],
        [values[0][3], values[1][3], values[2][3], values[3][3]],
    ], selected)
}

// Compute each result directly from its logical coordinates. The host
// reference shares no matrix, vector, swizzle or reduction helper with the
// timed kernels.
fn reference(operation: UInt64, component: UInt64, value: Float32) -> Float32 {
    let row = component / 4
    let column = component % 4
    if operation == 3 {
        return (value + Float32(component + 1)) * 0.5
    }
    var total = Float32(0.0)
    for k in UInt64(0)..4 {
        if operation == 0 {
            total += (value + Float32(component * 4 + k + 1)) * Float32(k + 1)
        } else if operation == 1 {
            total += Float32(k + 1) * (value + Float32(k * 4 + component + 1))
        } else {
            total += (value + Float32(row * 4 + k + 1)) * (value * 0.5 + Float32(k * 4 + column + 1))
        }
    }
    total
}

fn components_match(answers: mem.Slice[Float32], expected_length: UInt64, operation: UInt64, diverse: Bool = false) -> Bool {
    if answers.length() != expected_length {
        return false
    }
    let lanes: UInt64 = if operation < 2 {
        4
    } else {
        16
    }
    for index in 0..answers.length() {
        let value = if diverse {
            Float32.from_bits(validation_word(index / lanes))
        } else {
            Float32(index / lanes) / 16.0
        }
        let expected = reference(operation, index % lanes, value)
        if answers[index].to_bits() != expected.to_bits() {
            return false
        }
    }
    true
}

fn mapped_answers_match(values: mem.Slice[Float32], answers: mem.Slice[Float32], reference: fn(value: Float32) -> Float32) -> Bool {
    if answers.length() != values.length() {
        return false
    }
    for index in UInt64(0)..values.length() {
        if answers[index].to_bits() != reference(values[index]).to_bits() {
            return false
        }
    }
    true
}

fn check_components(device: gpu.Device, operation: UInt64, row: fn(value: Float32) -> Float32, column: fn(value: Float32) -> Float32, actual: fn(value: Float32) -> Float32) -> Result[(), BenchError] {
    let lanes: UInt64 = if operation < 2 {
        4
    } else {
        16
    }
    defer var encoded: mem.Vec[Float32] = mem.Vec.new()
    for n in UInt64(0)..23 {
        for component in 0..lanes {
            &encoded.push(Float32(component) + Float32(n) / 32.0).settled()?
        }
    }
    defer let input = device.upload(encoded.as_slice(), [encoded.length()])?
    for body in [copy(row), copy(column), copy(actual)] {
        defer let resident = input.map(body)?
        defer let answers = gpu.download(resident)?
        if !components_match(answers.as_slice(), encoded.length(), operation) {
            return .Err(.Mismatch)
        }
    }
    .Ok(())
}

// Two input tensors keep raw corpus values separate from component selectors.
// This uses existing binary device bodies; no integer/bitcast device extension.
fn check_diverse_components(device: gpu.Device, operation: UInt64, row: fn(value: Float32, selected: Float32) -> Float32, column: fn(value: Float32, selected: Float32) -> Float32, actual: fn(value: Float32, selected: Float32) -> Float32) -> Result[(), BenchError] {
    let lanes: UInt64 = if operation < 2 {
        4
    } else {
        16
    }
    defer var values: mem.Vec[Float32] = mem.Vec.new()
    defer var selectors: mem.Vec[Float32] = mem.Vec.new()
    for n in UInt64(0)..23 {
        for component in UInt64(0)..lanes {
            &values.push(Float32.from_bits(validation_word(n))).settled()?
            &selectors.push(Float32(component)).settled()?
        }
    }
    defer let input = device.upload(values.as_slice(), [values.length()])?
    defer let selected = device.upload(selectors.as_slice(), [selectors.length()])?
    // Observe values before arithmetic can hide a tiny input in value+1.
    defer let copied = input.zip_with(selected, validation_input_bits)?
    defer let raw = gpu.download(copied)?
    if raw.length() != values.length() {
        return .Err(.Mismatch)
    }
    for index in UInt64(0)..values.length() {
        if raw[index].to_bits() != values[index].to_bits() {
            return .Err(.Mismatch)
        }
    }
    for body in [copy(row), copy(column), copy(actual)] {
        defer let resident = input.zip_with(selected, body)?
        defer let answers = gpu.download(resident)?
        if !components_match(answers.as_slice(), values.length(), operation, true) {
            return .Err(.Mismatch)
        }
    }
    .Ok(())
}

fn measure(schedule: bench.Schedule, input: tensor.Vector[Float32, gpu.Storage], body: fn(value: Float32) -> Float32) -> Result[UInt64, gpu.GpuError] {
    schedule.try_measure(
        [input, body] |_iteration| -> Result[(), gpu.GpuError] {
            defer let _result = input.map(body)?
            .Ok(())
        },
    )
}

fn verify(input: tensor.Vector[Float32, gpu.Storage], values: mem.Vec[Float32], body: fn(value: Float32) -> Float32, reference: fn(value: Float32) -> Float32) -> Result[Bool, gpu.GpuError] {
    defer let resident = input.map(body)?
    defer let host = gpu.download(resident)?
    .Ok(mapped_answers_match(values.as_slice(), host.as_slice(), reference))
}

fn compare(name: Str, input: tensor.Vector[Float32, gpu.Storage], values: mem.Vec[Float32], row: fn(value: Float32) -> Float32, column: fn(value: Float32) -> Float32, actual: fn(value: Float32) -> Float32) -> Result[(), BenchError] {
    if !verify(input, values, row, row)? || !verify(input, values, column, row)? || !verify(input, values, actual, row)? {
        return .Err(.Mismatch)
    }
    let schedule = bench.Schedule.new(warmups: 0, repetitions: 3, samples: 9, cases: 3).unwrap()
    io.println("config,{name},warmups,{schedule.warmups()},samples,{schedule.samples()},cases,{schedule.cases()},repetitions,{schedule.repetitions()}")?
    for round in 0..schedule.rounds() {
        var times: [UInt64; 3] = [0, 0, 0]
        for turn in 0..schedule.cases() {
            let which = schedule.case_at(round, turn).unwrap()
            times[which] = match which {
                0 => measure(schedule, input, row)?,
                1 => measure(schedule, input, column)?,
                _ => measure(schedule, input, actual)?,
            }
        }
        io.println("{name},{round},{schedule.repetitions()},{times[0]},{times[1]},{times[2]}")?
    }
    .Ok(())
}

fn usage() -> UInt8 {
    io.eprintln("usage: matrix_values_gpu SEED [--verify-only]")
    64
}

fn main() -> Result[UInt8, BenchError] {
    let arguments = env.args()
    let spelling = arguments.at(1) else {
        return .Ok(usage())
    }
    let seed = match spelling.parse[UInt64]() {
        Ok(value) => value,
        Err(_) => return .Ok(usage()),
    }
    let verify_only = arguments.at(2).unwrap_or("") == "--verify-only"
    if arguments.count() != (if verify_only {
        UInt64(3)
    } else {
        UInt64(2)
    }) {
        return .Ok(usage())
    }
    io.println("schema,matrix_values_gpu,2")?
    io.println("seed,{seed}")?
    defer var values: mem.Vec[Float32] = mem.Vec.new()
    &values.reserve(65536)?
    for index in UInt64(0)..65536 {
        &values.push(Float32((index + seed % 23) % 23) / 16.0).settled()?
    }
    defer let device = gpu.Device.open()?
    check_components(device, 0, matvec_row_component, matvec_column_component, matvec_operator_component)?
    check_components(device, 1, vecmat_row_component, vecmat_column_component, vecmat_operator_component)?
    check_components(device, 2, matmul_row_component, matmul_column_component, matmul_operator_component)?
    check_components(device, 3, elementwise_row_component, elementwise_column_component, elementwise_operator_component)?
    check_diverse_components(device, 0, matvec_row_diverse_component, matvec_column_diverse_component, matvec_operator_diverse_component)?
    check_diverse_components(device, 1, vecmat_row_diverse_component, vecmat_column_diverse_component, vecmat_operator_diverse_component)?
    check_diverse_components(device, 2, matmul_row_diverse_component, matmul_column_diverse_component, matmul_operator_diverse_component)?
    check_diverse_components(device, 3, elementwise_row_diverse_component, elementwise_column_diverse_component, elementwise_operator_diverse_component)?
    io.println("validation,component_raw_bits_v2,pass")?
    if verify_only {
        return .Ok(0)
    }
    defer let input = device.upload(values.as_slice(), [values.length()])?
    io.println("workload,round,repetitions,row_map_ns,column_map_ns,operator_map_ns")?
    compare("matvec4", input, values, matvec_row, matvec_column, matvec_operator)?
    compare("vecmat4", input, values, vecmat_row, vecmat_column, vecmat_operator)?
    compare("matmul4", input, values, matmul_row, matmul_column, matmul_operator)?
    compare("elementwise4", input, values, elementwise_row, elementwise_column, elementwise_operator)?
    .Ok(0)
}
