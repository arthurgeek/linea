struct Chain2[A, B] {
    first: A,
    second: B,
}

impl[A: Iterator, B: Iterator] Iterator for Chain2[A, B] where B.Item == A.Item {
    type Item = A.Item

    fn next(inout self: Self) -> Option[A.Item] where carries(.Some: self) {
        &self.second.next()
    }
}

fn main() -> UInt8 {
    var north: Chain2[Range[UInt8], Range[UInt16]] = .{ first = UInt8(1)..3, second = UInt16(5)..9 }
    var south: Chain2[Range[UInt8], Range[UInt16]] = .{ first = UInt8(2)..4, second = UInt16(6)..8 }
    let _one = &north.next()
    let _other = &south.next()
    0
}
