// [O-Merge]. A `defer` of an affine value fires on the path that kept it and
// not on the path that gave it away, and after the branches meet there is one
// exit for both. The disagreement is reported at the join; the schedule is not
// also reported as dead, because it runs on the path that did not take the value.
struct Key {
    n: UInt8,
}

fn open(sink k: Key) -> UInt8 {
    let Key { n } = k
    n
}

fn lock(sink k: Key) {
    let Key { n: _n } = k
}

fn go(flag: Bool) -> UInt8 {
    let k: Key = .{ n = 7 }
    defer lock(k)
    if flag {
        open(k)
    } else {
        0
    }
}

fn main() -> UInt8 {
    go(true)
}
