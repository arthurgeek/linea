test fn int32_parse_checks_limits() {
    let minimum = "-2147483648".parse[Int32]()
    match minimum { Ok(value) => testing.assert_eq(value, Int32.min, "minimum changed")?, Err(_) => testing.assert(false, "minimum was rejected")? }
    let maximum = "+2147483647".parse[Int32]()
    match maximum { Ok(value) => testing.assert_eq(value, Int32.max, "maximum changed")?, Err(_) => testing.assert(false, "maximum was rejected")? }
    let over = "2147483648".parse[Int32]()
    testing.assert_eq(over, .Err(.Overflow(9)), "overflow did not report its digit")?
    let under = "-2147483649".parse[Int32]()
    testing.assert_eq(under, .Err(.Overflow(10)), "negative overflow did not report its digit")?
    .Ok(())
}

