import std.io

use io.IoError

trait Marker {}

struct Box {
    x: UInt8,
}

// A trait implementation declares only what the trait requires, and the
// compiler calls a test. Refused there, it is refused once.
impl Marker for Box {
    test fn a_thing_holds() -> Result[(), IoError] {
        let _box: Self = Box { x = 0 }
        return .Ok({})
    }
}

fn main() -> UInt8 {
    0
}
