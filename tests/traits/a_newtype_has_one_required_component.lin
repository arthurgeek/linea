trait Measure {
    fn measure(self: Self) -> UInt8
}

template impl Measure where reflect.components: Measure {
    fn measure(_self: Self) -> UInt8 {
        match read _self {
            reflect.case => {
                for component in reflect.components {
                    component.of(_self).measure()
                }
            },
        }
    }
}

type Count = UInt8

impl Measure for UInt8 {
    fn measure(self: UInt8) -> UInt8 {
        self
    }
}

derive Measure for Count

fn main() -> UInt8 {
    let count: Count = Count(7)
    count.measure()
}
