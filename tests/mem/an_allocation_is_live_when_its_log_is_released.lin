import std.mem
import std.testing

use testing.TestAllocator

fn main() -> UInt8 {
    let log = TestAllocator.open(mem.system()).unwrap()
    let buffer = log.handle().acquire(64).unwrap()
    // Disposing the buffer counts into the test allocator, so it must still be live.
    log.release()
    buffer.release()
    0
}
