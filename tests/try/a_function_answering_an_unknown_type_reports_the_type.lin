// `helper` answers with `Missing`, which is not declared. What it answers
// with is then unknown, so its `?` is not judged against it and only the
// type is reported.
enum Bad {
    Broken,
}

fn parse() -> Result[UInt8, Bad] {
    .Ok(4)
}

fn helper() -> Missing {
    let n = parse()?
    n
}

fn main() -> UInt8 {
    let _ = helper()
    0
}
