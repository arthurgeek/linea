// The operator is a call on a trait, and a primitive's implementation is the
// compiler's: a loop over an integer is the comparison instruction it always
// was, with no call anywhere in what is emitted.
fn main() -> UInt8 {
    var i: UInt8 = 0
    var total: UInt8 = 0
    while i < 5 {
        if i <= 2 {
            total = total + 1
        }
        i = i + 1
    }
    total
}
