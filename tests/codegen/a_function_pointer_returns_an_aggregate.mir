function ;main
local $0 fn(read UInt8, read UInt8) -> Pair value storage=ptr
local $1 Pair value storage=bytes
@0:
  %0 = function_addr @f1 : fn(read UInt8, read UInt8) -> Pair
  store fn(read UInt8, read UInt8) -> Pair $0 %0
  %2 = addr_of Pair managed-address $1
  %3 = load fn(read UInt8, read UInt8) -> Pair value computation=ptr $0
  %4 = constant UInt8 value computation=i64 4
  %5 = constant UInt8 value computation=i64 5
  %6 = call_indirect %3(%4, %5) : Pair
  move_value Pair %2, %6
  %8 = addr_of Pair managed-address $1
  %9 = constant UInt64 value computation=i64 0
  %10 = field_addr UInt8 managed-address %8, %9
  %11 = load_indirect UInt8 value computation=i64 %10
  %12 = addr_of Pair managed-address $1
  %13 = constant UInt64 value computation=i64 1
  %14 = field_addr UInt8 managed-address %12, %13
  %15 = load_indirect UInt8 value computation=i64 %14
  %16 = add UInt8 value computation=i64 %11, %15
  %17 = check UInt8 value computation=i64 %16 (overflow)
  ret %17
function closure.0
local $0 UInt8 value storage=i8
local $1 UInt8 value storage=i8
local $2 Pair value storage=bytes
@0:
  %0 = addr_of Pair managed-address $2
  %1 = constant UInt64 value computation=i64 0
  %2 = field_addr UInt8 managed-address %0, %1
  %3 = load UInt8 value computation=i64 $0
  store_indirect UInt8 %2, %3
  %5 = constant UInt64 value computation=i64 1
  %6 = field_addr UInt8 managed-address %0, %5
  %7 = load UInt8 value computation=i64 $1
  store_indirect UInt8 %6, %7
  ret %0
