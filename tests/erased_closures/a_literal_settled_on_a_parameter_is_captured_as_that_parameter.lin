import std.mem

// Each `step` settles on `T` through `x + step`, so the closures capture a `T`.
// `Integer` does not promise `Release`, so neither closure can be kept.
fn offset[T: Integer](start: T) -> Result[T, mem.Oom] {
    let step = 3
    let add = mem.Closure.open([sink step] |x: T| x + step)?
    defer add.release()
    return .Ok(add(start))
}

fn shifted[T: Integer](start: T) -> Result[T, mem.Oom] {
    let step = 5
    let shift = [sink step] |x: T| x + step
    let kept = mem.Closure.open(shift)?
    defer kept.release()
    return .Ok(kept(start))
}

fn main() -> Result[UInt8, mem.Oom] {
    let start: UInt8 = 4
    let first = offset(start)?
    let second = shifted(first)?
    return .Ok(second - 12)
}
