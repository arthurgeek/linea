// [S-Defer]. What leaves need not be the whole of what is scheduled: an
// operand buried in the deferred expression leaves the same scope exit.
//
// The `return` below runs the schedules on its way out, and the schedule it
// runs leaves from underneath it. Whatever the rule says, the frontend walks
// the whole tree first and may not fall over doing it.
fn take(sink _a: UInt8, _b: UInt8) -> () {
    let _n = _a
}

fn go() -> UInt8 {
    defer take(1, return 0)
    return 2
}

fn main() -> UInt8 {
    go()
}
