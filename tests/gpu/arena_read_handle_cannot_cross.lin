import std.gpu
import std.tensor
import std.session
import std.task

use session.Chan
use session.End

fn main() -> UInt8 {
    defer let device = gpu.Device.open().unwrap()
    defer let arena = gpu.Arena.open(device, 65536).unwrap()
    let handle = arena.handle()
    let body = sink [read handle] |sink me: Chan[End]| {
        let _value = tensor.matrix_in(handle, [[Float32(1.0)]]).unwrap()
        me.close()
    }
    let slot = task.prepare(body).unwrap()
    slot.start().close()
    0
}
