// `Marker` discards its argument, so every type here has a size and no type
// reaches itself through an inline part: [T-InfiniteLayout] has nothing to
// report, and running it earlier would not help. The chain still never closes,
// because the growth is in the argument rather than in what is held -- which
// is why this is a measure on arguments rather than a question about layout.
struct Cell[T] {
    v: T,
}

struct Marker[phantom X] {
    v: UInt8,
}

struct S[T] {
    a: T,
    b: Marker[S[Cell[T]]],
}

fn main() -> UInt8 {
    0
}
