// `ticket` is still owned on both paths out of `admit`: the `?` leaves early
// when there is no seat, and the `return` leaves after one is found. One value
// is left behind, so it is one report: the first exit written is where it
// points, and the `return` is named beside it.
@linear
struct Ticket {
    seat: UInt8,
}

fn seat_for(row: UInt8) -> Option[UInt8] {
    if row > 3 {
        .Some(row)
    } else {
        .None
    }
}

fn admit(row: UInt8) -> Option[UInt8] {
    let ticket = Ticket { seat = 14 }
    let seat = seat_for(row)?
    return .Some(seat + ticket.seat)
}

fn main() -> UInt8 {
    match admit(5) {
        Some(seat) => seat,
        None => 0,
    }
}
