import std.env
import std.fs
import std.io
import std.json

fn main() -> UInt8 {
    let args = env.args()
    if args.count() != 2 {
        return 64
    }
    let path = match fs.Path.from_arg(args, 1).unwrap() {
        Ok(path) => path,
        Err(_) => return 64,
    }
    let parsed = json.read_file(path)
    match parsed {
        Ok(document) => {
            document.release()
            0
        },
        Err(error) => {
            io.eprintln("{error}")
            match read error {
                Read(_) => 70,
                Parse(_) => 1,
            }
        },
    }
}
