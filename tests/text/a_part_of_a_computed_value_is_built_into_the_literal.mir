function ;main
local $0 Entry value storage=bytes
local $1 {interpolation Word, Word} value storage=bytes
local $2 {interpolation Word} value storage=bytes
@0:
  %0 = addr_of Entry managed-address $0
  %1 = call Entry managed-address @f1()
  move_value Entry %0, %1
  %3 = addr_of {interpolation Word, Word} managed-address $1
  %4 = constant UInt64 value computation=i64 0
  %5 = field_addr Str managed-address %3, %4
  %6 = bytes_addr UInt64 value computation=i64 bytes0
  %7 = constant UInt64 value computation=i64 0
  %8 = field_addr UInt64 managed-address %5, %7
  store_indirect UInt64 %8, %6
  %10 = constant UInt64 value computation=i64 0
  %11 = constant UInt64 value computation=i64 8
  %12 = field_addr UInt64 managed-address %5, %11
  store_indirect UInt64 %12, %10
  %14 = constant UInt64 value computation=i64 16
  %15 = field_addr Word managed-address %3, %14
  %16 = call Entry managed-address @f1()
  %17 = constant UInt64 value computation=i64 0
  %18 = field_addr Word managed-address %16, %17
  move_value Word %15, %18
  %20 = constant UInt64 value computation=i64 24
  %21 = field_addr Str managed-address %3, %20
  %22 = bytes_addr UInt64 value computation=i64 bytes1
  %23 = constant UInt64 value computation=i64 0
  %24 = field_addr UInt64 managed-address %21, %23
  store_indirect UInt64 %24, %22
  %26 = constant UInt64 value computation=i64 1
  %27 = constant UInt64 value computation=i64 8
  %28 = field_addr UInt64 managed-address %21, %27
  store_indirect UInt64 %28, %26
  %30 = constant UInt64 value computation=i64 40
  %31 = field_addr Word managed-address %3, %30
  %32 = addr_of Entry managed-address $0
  %33 = constant UInt64 value computation=i64 0
  %34 = field_addr Word managed-address %32, %33
  copy_value Word %31, %34
  %36 = constant UInt64 value computation=i64 48
  %37 = field_addr Str managed-address %3, %36
  %38 = bytes_addr UInt64 value computation=i64 bytes0
  %39 = constant UInt64 value computation=i64 0
  %40 = field_addr UInt64 managed-address %37, %39
  store_indirect UInt64 %40, %38
  %42 = constant UInt64 value computation=i64 0
  %43 = constant UInt64 value computation=i64 8
  %44 = field_addr UInt64 managed-address %37, %43
  store_indirect UInt64 %44, %42
  %46 = addr_of {interpolation Word} managed-address $2
  %47 = constant UInt64 value computation=i64 0
  %48 = field_addr Str managed-address %46, %47
  %49 = bytes_addr UInt64 value computation=i64 bytes0
  %50 = constant UInt64 value computation=i64 0
  %51 = field_addr UInt64 managed-address %48, %50
  store_indirect UInt64 %51, %49
  %53 = constant UInt64 value computation=i64 0
  %54 = constant UInt64 value computation=i64 8
  %55 = field_addr UInt64 managed-address %48, %54
  store_indirect UInt64 %55, %53
  %57 = constant UInt64 value computation=i64 16
  %58 = field_addr Word managed-address %46, %57
  %59 = addr_of Entry managed-address $0
  %60 = constant UInt64 value computation=i64 0
  %61 = field_addr Word managed-address %59, %60
  copy_value Word %58, %61
  %63 = constant UInt64 value computation=i64 24
  %64 = field_addr Str managed-address %46, %63
  %65 = bytes_addr UInt64 value computation=i64 bytes0
  %66 = constant UInt64 value computation=i64 0
  %67 = field_addr UInt64 managed-address %64, %66
  store_indirect UInt64 %67, %65
  %69 = constant UInt64 value computation=i64 0
  %70 = constant UInt64 value computation=i64 8
  %71 = field_addr UInt64 managed-address %64, %70
  store_indirect UInt64 %71, %69
  %73 = addr_of Entry managed-address $0
  %74 = constant UInt64 value computation=i64 2
  %75 = field_addr UInt8 managed-address %73, %74
  %76 = load_indirect UInt8 value computation=i64 %75
  %77 = addr_of Entry managed-address $0
  %78 = constant UInt64 value computation=i64 0
  %79 = field_addr Word managed-address %77, %78
  %80 = constant UInt64 value computation=i64 1
  %81 = field_addr UInt8 managed-address %79, %80
  %82 = load_indirect UInt8 value computation=i64 %81
  %83 = add UInt8 value computation=i64 %76, %82
  %84 = check UInt8 value computation=i64 %83 (overflow)
  ret %84
function ;make
local $0 Entry value storage=bytes
@0:
  %0 = addr_of Entry managed-address $0
  %1 = constant UInt64 value computation=i64 0
  %2 = field_addr Word managed-address %0, %1
  %3 = constant UInt64 value computation=i64 0
  %4 = field_addr UInt8 managed-address %2, %3
  %5 = constant UInt8 value computation=i64 3
  store_indirect UInt8 %4, %5
  %7 = constant UInt64 value computation=i64 1
  %8 = field_addr UInt8 managed-address %2, %7
  %9 = constant UInt8 value computation=i64 4
  store_indirect UInt8 %8, %9
  %11 = constant UInt64 value computation=i64 2
  %12 = field_addr UInt8 managed-address %0, %11
  %13 = constant UInt8 value computation=i64 1
  store_indirect UInt8 %12, %13
  ret %0
