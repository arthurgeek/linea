// A result that carries from a parameter carries nothing once the result is
// settled to a type that can hold no dependency, whatever the parameter is.
// With both settled to `UInt8`, both heads below are `fn(a: UInt8) -> UInt8`.
trait Run {
    fn go(self: Self) -> UInt8
}

impl[V, X] Run for fn(a: V) -> X where carries() {
    fn go(_self: Self) -> UInt8 {
        1
    }
}

impl[T, U] Run for fn(a: T) -> U where carries(a) {
    fn go(_self: Self) -> UInt8 {
        2
    }
}

fn ask[H: Run](h: H) -> UInt8 {
    h.go()
}

fn one(a: UInt8) -> UInt8 {
    a
}

fn main() -> UInt8 {
    ask(one)
}
