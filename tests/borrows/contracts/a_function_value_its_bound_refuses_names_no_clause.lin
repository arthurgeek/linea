// The bound on `apply` refuses `second` and fixes its signature all the same.
fn apply[F: fn(read a: String, read b: String) -> Str where borrows(a)](a: String, b: String, f: F) -> UInt8 {
    UInt8(f(a, b).length())
}

fn second(_a: String, b: String) -> Str {
    b.view()
}

fn main() -> UInt8 {
    defer let a = String.new()
    defer let b = String.new()
    apply(a, b, second)
}
