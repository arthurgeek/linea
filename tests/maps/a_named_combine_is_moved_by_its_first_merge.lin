import std.collections
import std.mem

// `merge` consumes its combine, so the first call moves `add` and the second
// cannot pass it again.
fn main() -> UInt8 {
    var totals: collections.Map[UInt64, UInt64, mem.SystemAllocator] = collections.Map.new()
    let add = |sink current: UInt64, sink incoming: UInt64| current + incoming
    &totals.merge(7, 5, add).unwrap()
    &totals.merge(7, 3, add).unwrap()
    let total = *totals.get(7).unwrap()
    totals.release()
    UInt8(total)
}
