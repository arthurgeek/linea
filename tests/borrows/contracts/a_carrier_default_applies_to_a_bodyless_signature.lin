// A trait signature has no body to infer from, and the carrier default still
// decides its contract; an implementation that writes no clause adopts it.
import std.io

@carrier
struct Session {
    user: Str,
}

trait Greet {
    fn greet(self: Self, session: Session, tag: Str) -> Str
}

struct Plain {}

impl Greet for Plain {
    fn greet(_self: Self, session: Session, tag: Str) -> Str {
        if tag.length() > 0 {
            copy(session.user)
        } else {
            copy(session.user)
        }
    }
}

fn run[G: Greet](greeter: G, session: Session, tag: Str) -> Str where carries(session) {
    greeter.greet(session, tag)
}

fn main() -> UInt8 {
    let session = Session { user = "ada" }
    let _printed = io.println(run(Plain {}, session, "x"))
    0
}
