import std.mem

// `seen` observes `scores` without taking it, so the closure is released
// before `scores` is.
fn main() -> UInt8 {
    var scores: Vec[UInt64, mem.SystemAllocator] = Vec.new()
    let pushed = &scores.push(40).is_ok()
    let counted = mem.Closure.open(
        [seen = scores] || -> UInt64 {
            seen.length()
        },
    ).unwrap()
    let count = counted()
    counted.release()
    scores.release()
    if pushed {
        UInt8(count)
    } else {
        0
    }
}
