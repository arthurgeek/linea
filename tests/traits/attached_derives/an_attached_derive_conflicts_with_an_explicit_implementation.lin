trait Score {
    fn score(self: Self) -> UInt8
}

template impl Score {
    fn score(_self: Self) -> UInt8 {
        1
    }
}

@derive(Score)
struct Mark { value: UInt8 }

impl Score for Mark {
    fn score(self: Mark) -> UInt8 {
        self.value
    }
}

fn main() -> UInt8 {
    let mark = Mark { value = 7 }
    mark.score() - 7
}
