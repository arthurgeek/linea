impl[R: Reader, A: Allocator] BufferedReader[R, A] {
    // Continue a raw line whose read failed before the line ended, keeping the
    // prefix already collected, and borrow its bytes.
    pub fn resume_raw_line_borrowed(inout self: Self, max_bytes: UInt64) -> Result[Option[mem.Slice[UInt8]], LineError[R.Error]] where borrows(.Ok: self), carries(.Err.Input.reason: self.reader), retains(self.record: self.allocator) {
        if !self.can_resume(true) {
            return .Err(.ResumeUnavailable)
        }
        let filled = &self.fill(max_bytes)?
        if !filled {
            return .Ok(.None)
        }
        .Ok(.Some(self.pending()))
    }
}

test fn a_borrowed_raw_line_resumes_with_its_retained_prefix() {
    let input = "ab\r\ncd\n"
    let source = FragmentReader { bytes = input.as_bytes(), position = 0, step = 1, fail_at = 2 }
    var reader = BufferedReader.open(capacity: 1, reader: source) else |_| {
        return testing.assert(false, "reader allocation failed")
    }
    let failed = match &reader.read_raw_line_borrowed(max_bytes: 4) {
        Err(Input(failure)) => failure.reason == 9 && failure.stream_offset == 2,
        _ => false,
    }
    reader.reader.fail_at = UInt64.max
    // A line read raw resumes only as a raw line.
    let as_text = match &reader.resume_line_borrowed(max_bytes: 4) {
        Err(ResumeUnavailable) => true,
        _ => false,
    }
    let resumed = match &reader.resume_raw_line_borrowed(max_bytes: 4) {
        Ok(Some(bytes)) => bytes == "ab\r\n".as_bytes(),
        Ok(None) => false,
        Err(_) => false,
    }
    let next = match &reader.read_raw_line_borrowed(max_bytes: 3) {
        Ok(Some(bytes)) => bytes == "cd\n".as_bytes(),
        Ok(None) => false,
        Err(_) => false,
    }
    let again = match &reader.resume_raw_line_borrowed(max_bytes: 4) {
        Err(ResumeUnavailable) => true,
        _ => false,
    }
    let _source = reader.abandon()
    testing.assert(failed, "the input failure was not reported at its stream byte")?
    testing.assert(as_text, "a raw line resumed as text")?
    testing.assert(resumed, "resuming lost the prefix or the terminator")?
    testing.assert(next, "resuming disturbed the next line")?
    testing.assert(again, "a completed line resumed a second time")?
    .Ok(())
}

