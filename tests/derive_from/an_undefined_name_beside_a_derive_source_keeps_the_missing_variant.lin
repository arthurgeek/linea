// A name nothing declares, written in an argument the template does not
// wrap, is its own report and leaves the source as written, so a source no
// variant holds is still reported.
trait Conv[phantom A, B] {
    fn conv(sink value: B) -> Self
}

template impl[A, B] Conv[A, B] where reflect.target: enum {
    fn conv(sink value: B) -> Self {
        reflect.wrap(value)
    }
}

@derive(Conv[Missing, UInt32])
enum Choice {
    Only(UInt8),
    Unknown,
}

fn main() -> UInt8 {
    match Choice.Unknown {
        Only(code) => code,
        Unknown => 0,
    }
}
