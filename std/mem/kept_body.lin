// A task's body waits for its thread in bytes the task owns. The bytes hold
// the body, then the buffer that owns them, so whichever thread releases them
// needs only their address and length. The body starts at the first byte and
// the buffer at the next multiple of eight after it, the largest alignment a
// value has.

// The offset of the buffer in the bytes a body of `body_stride` bytes is kept
// in.
fn kept_buffer_offset(body_stride: UInt64) -> UInt64 {
    (body_stride + 7) / 8 * 8
}

// The bytes a task whose body is `body` keeps when they come from `allocator`.
internal fn kept_bytes[F, A: Allocator](_body: F, _allocator: A) -> UInt64 {
    let body_shape: SlotType[F] = .Type
    let buffer_shape: SlotType[Buffer[A]] = .Type
    kept_buffer_offset(slot_stride(body_shape)) + slot_stride(buffer_shape)
}

// Move `body` into the bytes `storage` owns, then move `storage` in after it,
// and answer the bytes' address. Whoever holds the address owns both.
internal fn keep_body[F, A: Allocator](sink storage: Buffer[A], sink body: F) -> UInt64 {
    let at = storage.at
    let len = storage.len
    let body_shape: SlotType[F] = .Type
    let offset = kept_buffer_offset(slot_stride(body_shape))
    var body_slot: Storage[F, SystemAllocator] = .{ buffer = .None, allocator = system(), at, len = offset }
    slot_put(&body_slot, at, offset, 0, body)
    body_slot.dispose()
    var buffer_slot: Storage[Buffer[A], SystemAllocator] = .{ buffer = .None, allocator = system(), at = at + offset, len = len - offset }
    slot_put(&buffer_slot, at + offset, len - offset, 0, storage)
    buffer_slot.dispose()
    at
}

// Move the body out of the bytes at `at`, which `keep_body` filled. The
// buffer stays in them.
internal fn take_kept_body[F](at: UInt64) -> F {
    let body_shape: SlotType[F] = .Type
    let offset = kept_buffer_offset(slot_stride(body_shape))
    var body_slot: Storage[F, SystemAllocator] = .{ buffer = .None, allocator = system(), at, len = offset }
    let body: F = slot_take(&body_slot, at, offset, 0)
    body_slot.dispose()
    body
}

// Move the buffer out of the `len` bytes at `at`, which `keep_body` filled
// with a body of type `_F` and a buffer from an `_A`, and whose body was
// taken, and release it, which returns the bytes. Neither type is named by a
// parameter, since the runtime calls this with the address alone; the caller
// names both.
internal fn release_kept_bytes[_F, _A: Allocator](at: UInt64, len: UInt64) {
    let body_shape: SlotType[_F] = .Type
    let buffer_shape: SlotType[Buffer[_A]] = .Type
    let offset = kept_buffer_offset(slot_stride(body_shape))
    let actual_len = if len == 0 {
        offset + slot_stride(buffer_shape)
    } else {
        len
    }
    var buffer_slot: Storage[Buffer[_A], SystemAllocator] = .{ buffer = .None, allocator = system(), at = at + offset, len = actual_len - offset }
    let storage: Buffer[_A] = slot_take(&buffer_slot, at + offset, actual_len - offset, 0)
    buffer_slot.dispose()
    storage.release()
}
