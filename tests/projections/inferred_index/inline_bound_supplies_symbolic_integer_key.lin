struct Board[I] { values: [UInt8; 2], key: I }

impl[I: Integer] Index[I] for Board[I] via values

fn first[I: Integer, C: Index[I]](container: C, _key: I) -> borrow C.Elem where borrows(container) {
    borrow container[0]
}

fn main() -> UInt8 {
    let board = Board[Int16] { values = [7, 9], key = 0 }
    let value = first(board, Int16(0))
    if *value == 7 && board[0] == 7 {
        0
    } else {
        1
    }
}
