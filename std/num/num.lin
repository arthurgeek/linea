import std.testing

// Additive is a number type with a zero and an addition, which is what
// `Sequence.sum` needs: the sum of no items is `zero()`, and each item is
// added to the running total with `add`. Integer addition is checked, so a sum
// past the type's greatest value traps as `+` does. Floating-point addition
// rounds as `+` does, so the order of the items can change a float sum.
pub trait Additive {
    fn zero() -> Self

    fn add(sink self: Self, sink other: Self) -> Self where carries(self, other)
}

// Multiplicative is a number type with a one and a multiplication, which is
// what `Sequence.product` needs: the product of no items is `one()`, and each
// item multiplies the running product with `multiply`. Integer multiplication
// is checked, so a product past the type's greatest value traps as `*` does.
pub trait Multiplicative {
    fn one() -> Self

    fn multiply(sink self: Self, sink other: Self) -> Self where carries(self, other)
}

impl Additive for UInt8 {
    fn zero() -> UInt8 {
        0
    }

    fn add(sink self: Self, sink other: Self) -> UInt8 {
        self + other
    }
}

impl Multiplicative for UInt8 {
    fn one() -> UInt8 {
        1
    }

    fn multiply(sink self: Self, sink other: Self) -> UInt8 {
        self * other
    }
}

impl Additive for UInt16 {
    fn zero() -> UInt16 {
        0
    }

    fn add(sink self: Self, sink other: Self) -> UInt16 {
        self + other
    }
}

impl Multiplicative for UInt16 {
    fn one() -> UInt16 {
        1
    }

    fn multiply(sink self: Self, sink other: Self) -> UInt16 {
        self * other
    }
}

